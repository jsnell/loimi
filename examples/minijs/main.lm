// MiniJS: a JavaScript subset, implemented in Loimi.
//
//   loimi build examples/minijs/main.lm --release -o minijs
//   ./minijs program.js          (a second argument turns on GC stress)

import std.io;
import std.os;
import std.gc;
import std.text;
import value;
import value.{V, Fn};
import rt.{Ctx};
import rt;
import vm.{JS};
import compile;
import builtins;
import prelude;

fn run(ctx: *Ctx, src: str) -> bool uses gc {
    let proto = compile.compile(ctx, src);
    let f = new(&ctx.heap, Fn { proto: proto, props: None, home: V.Undef, parent: V.Undef, native: 0, hint: proto.hint, ctor_proto: None, ctor_shape: None }, 0);
    JS.run(ctx, f);
    !ctx.failed
}

extern "C" fn getenv(name: *u8) -> ?*u8;

fn stats(c: *Ctx) {
    if getenv("MINIJS_STATS\0".ptr).is_none() { return; }
    var b = text.StrBuf.new();
    b.fmt4("shapes created {} ({} under a kept id), poly sites {}, add sites {}",
        c.m.shapes.created, c.m.shapes.reborn, c.m.ic.poly.len, c.m.shapes.adds.len);
    b.fmt3(", validity cells {}, keys {}, collections {}",
        c.m.shapes.cvalid.len - 1, c.keys.names.len, c.heap.collections);
    io.eprintln(b.as_str());
}

fn main() -> i32 uses gc {
    let Some(path) = os.arg(1) else {
        io.eprintln("usage: minijs <program.js> [stress|verify]");
        return 2;
    };
    let Some(src) = io.read_file(path) else {
        io.eprint("cannot read ");
        io.eprintln(path);
        return 1;
    };
    var ctx = Ctx.new();
    ctx.init();
    builtins.install(&ctx);
    // `stress`: collect at every safepoint; `verify`: the same with a
    // generational heap, checking the write barriers at each collection.
    if let Some(mode) = os.arg(2) {
        ctx.heap.set_stress(true);
        if mode.eq("verify") {
            ctx.heap.set_generational(true);
            ctx.heap.set_verify(true);
        }
    }
    if !run(&ctx, prelude.source()) { return 1; }
    // The prelude's methods are not enumerable, like the natives.
    ctx.hide_all(ctx.arr_proto());
    if run(&ctx, src) {
        ctx.flush();
        stats(&ctx);
        return 0;
    }
    ctx.flush();
    var b = text.StrBuf.new();
    b.push_str("Uncaught ");
    ctx.write(&b, ctx.error);
    io.eprintln(b.as_str());
    1
}
