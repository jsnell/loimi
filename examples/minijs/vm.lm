// The MiniJS virtual machine: a register machine. Each activation owns a
// window of registers: R0 is `this`, R1.. the parameters, then locals and
// temporaries. A call puts the callee in R[base], `this` in R[base+1] and
// the arguments above it; the callee's window starts at R[base+1], so
// `this` and the arguments arrive in place, and the result is stored back
// into the caller's R[base].
//
// Property access sites carry inline caches (std.obj shapes); the
// families quicken a site to the member for what it has seen.

import std.gc;
import std.mem;
import std.math;
import std.text;
import std.obj;
import value;
import value.{V, Str, Obj, Vals, Arr, Fn, Box, Proto};
import rt;
import rt.{Ctx, Frame};
import builtins;

extern "C" fn pow(a: f64, b: f64) -> f64;

// ── slow paths ──────────────────────────────────────────────────────

/// Arithmetic outside the fast paths: op 0 add, 1 sub, 2 mul, 3 div,
/// 4 mod, 5 pow.
fn arith(c: *Ctx, op: i64, a: V, b: V) -> Result<V, V> {
    if op == 0 {
        let an = value.is_number(a);
        let bn = value.is_number(b);
        if !(an and bn) {
            let sa = a is S | R | O | A | F;
            let sb = b is S | R | O | A | F;
            if sa or sb { return Ok(c.concat(a, b)); }
        }
    }
    let x = value.to_number(a);
    let y = value.to_number(b);
    let r = match op {
        0 => x + y,
        1 => x - y,
        2 => x * y,
        3 => x / y,
        4 => value.js_mod(x, y),
        _ => js_pow(x, y),
    };
    Ok(value.number(r))
}

/// ADD/SUB/MUL outside their fast paths: Int overflow, then `arith`.
fn arith_cold(c: *Ctx, op: i64, a: V, b: V) -> Result<V, V> {
    if let (Int(x), Int(y)) = (a, b) {
        let (fx, fy) = (x as f64, y as f64);
        return Ok(V.Num(if op == 0 { fx + fy } else if op == 1 { fx - fy } else { fx * fy }));
    }
    arith(c, op, a, b)
}

/// Fuse superinstructions in a function again after one of its sites was
/// quickened (fusion compares words by the op they stand for, so supers
/// of specialized members form too).
/// Accumulator variants are selected first (`vacc`): the float members
/// exist only once a site has run, and selection splits supers. It may
/// run in the handler of the op that quickened, which leaves its result
/// in `vacc` (language.md §7.4).
fn refuse(cl: Gc<Fn>) {
    JS.accumulate(cl.proto.code.words(), 0);
    JS.optimize(cl.proto.code);
}

fn js_pow(x: f64, y: f64) -> f64 {
    // pow(1, NaN) and pow(-1, ±Infinity) are 1 in C but NaN in JS.
    if y != y { return 0.0 / 0.0; }
    if (x == 1.0 or x == -1.0) and (y == 1.0 / 0.0 or y == -1.0 / 0.0) { return 0.0 / 0.0; }
    pow(x, y)
}

fn less(c: *Ctx, a0: V, b0: V, or_equal: bool) -> bool {
    let a = value.flat(a0);
    let b = value.flat(b0);
    if let (S(x), S(y)) = (a, b) {
        let r = value.str_cmp(x, y);
        return if or_equal { r <= 0 } else { r < 0 };
    }
    let x = value.to_number(a);
    let y = value.to_number(b);
    if or_equal { x <= y } else { x < y }
}

/// `==` (out of the subset beyond the obvious cases).
fn loose_eq(a: V, b: V) -> bool {
    if value.strict_eq(a, b) { return true; }
    let an = a == V.Undef or a == V.Null;
    let bn = b == V.Undef or b == V.Null;
    if an or bn { return an and bn; }
    let ap = match a { O(_) | A(_) | F(_) => false, _ => true };
    let bp = match b { O(_) | A(_) | F(_) => false, _ => true };
    if ap and bp { return value.to_number(a) == value.to_number(b); }
    false
}

/// `===` for values with different bits.
fn eq_slow(a: V, b: V) -> bool {
    match (a, b) {
        (Num(x), Num(y)) => x == y,
        (Int(x), Num(y)) => x as f64 == y,
        (Num(x), Int(y)) => x == y as f64,
        (S(_), _) | (R(_), _) => value.strict_eq(a, b),
        _ => false,
    }
}

#[inline(always)]
fn is_str(v: V) -> bool {
    v is S | R
}

#[inline(always)]
fn int32(v: V) -> i32 {
    match v {
        Int(i) => i,
        Num(x) => if x >= -2147483648.0 and x <= 2147483647.0 { x as i32 } else { value.to_int32(x) },
        _ => value.to_int32(value.to_number(v)),
    }
}

/// x / y for two Ints: integral quotients stay Int (no -0: a zero
/// quotient of a nonzero divisor with x == 0 needs y > 0).
#[inline(always)]
fn int_div(x: i32, y: i32) -> V {
    let r = x as f64 / y as f64;
    if r >= -2147483648.0 and r <= 2147483647.0 {
        let q = r as i32;
        if q as f64 == r and (q != 0 or y > 0) { return V.Int(q); }
    }
    V.Num(r)
}

/// ToInt32 of a number without a call: (value, true) for Ints and for
/// doubles below 2^63 in magnitude (NaN gives 0, as ToInt32 does).
#[inline(always)]
fn i32_of(v: V) -> (i32, bool) {
    match v {
        Int(i) => (i, true),
        Num(x) => if x > -9.2e18 and x < 9.2e18 or x != x { ((x as i64) as i32, true) } else { (0, false) },
        _ => (0, false),
    }
}

/// Bitwise ops: 0 and, 1 or, 2 xor, 3 shl, 4 shr, 5 ushr.
#[inline(always)]
fn bitop(op: i64, a: V, b: V) -> V {
    let x = int32(a);
    let y = int32(b);
    match op {
        0 => V.Int(x & y),
        1 => V.Int(x | y),
        2 => V.Int(x ^ y),
        3 => V.Int(((x as u32) << ((y & 31) as u32)) as i32),
        4 => V.Int(x >> (y & 31)),
        _ => value.number((((x as u32) >> ((y & 31) as u32)) as f64)),
    }
}

fn neg(a: V) -> V {
    match a {
        Int(x) => if x == 0 or x == -2147483648 { V.Num(-(x as f64)) } else { V.Int(0 - x) },
        _ => V.Num(-value.to_number(a)),
    }
}

fn type_of(c: *Ctx, v: V) -> V { V.S(c.key_str(c.key(value.type_of(v)))) }

fn key_of_const(c: *Ctx, k: V) -> u64 {
    let S(s) = k else { return c.key_of(k); };
    c.str_key(s)
}

/// GETPROP/GETMETHOD miss on an object receiver: std.obj's cache state
/// machine reads the property and updates the site (the six cache
/// words, an obj.Site) for state `st`, the member that missed.
fn read_miss(c: *Ctx, o: Gc<Obj>, kv: V, site: *obj.Site, st: obj.IcState) -> (V, obj.IcState) {
    let (v, ns) = c.m.read_miss(site, st, o, key_of_const(c, kv));
    (v ?? V.Undef, ns)
}

/// GETPROP/GETMETHOD on another receiver. Methods of arrays and strings
/// found on their builtin prototype are cached as (prototype shape, slot
/// index); returns the value and true if the site should become the
/// array (or string) prototype member.
fn prim_get(c: *Ctx, v: V, kv: V, site: *obj.Site) -> Result<(V, bool), V> {
    let key = key_of_const(c, kv);
    let is_arr = v is A;
    let is_str = v is S;
    if (is_arr or is_str) and key != c.k_length {
        let p = if is_arr { c.arr_proto() } else { c.str_proto() };
        if c.key_index(key) < 0 and p.dict.is_none() {
            if let Some(i) = c.m.find(p, key) {
                site.sid = p.shape.id;
                site.slot = i;
                return Ok((c.m.load(p, i), true));
            }
        }
    }
    Ok((c.get(v, key)?, false))
}

/// SETPROP miss in state `st`: store, and update the site (an obj.Site).
/// Other receivers than objects keep Poly and Mega sites as they are.
fn write_miss(c: *Ctx, v: V, kv: V, x: V, site: *obj.Site, st: obj.IcState) -> Result<obj.IcState, V> {
    let key = key_of_const(c, kv);
    let O(o) = v else {
        c.set(v, key, x)?;
        return Ok(if st == obj.IcState.Poly or st == obj.IcState.Mega { st } else { obj.IcState.Generic });
    };
    Ok(c.m.write_miss_in(site, st, o, key, x))
}

/// Create a closure of child prototype `i` of the running function.
fn make_closure(c: *Ctx, parent: Gc<Fn>, regs: *V, i: u64) -> Gc<Fn> {
    let p = parent.proto.protos.data[i];
    let n = p.nfree as u64;
    var home = V.Undef;
    var par = V.Undef;
    if p.flags & value.PF_ARROW != 0 {
        home = parent.home;
        par = parent.parent;
    }
    let f = new(&c.heap, Fn { proto: p, props: None, home: home, parent: par, native: 0, hint: p.hint, ctor_proto: None, ctor_shape: None }, n);
    for j in 0..n {
        let d = p.desc.data[j];
        f.free[j] = if d >= 256 { regs[(d & 255) as u64] } else { parent.free[d as u64] };
    }
    f
}

/// `class C extends P`: set up C.prototype (inheriting from P.prototype),
/// static inheritance and the `super(...)` target.
fn make_class(c: *Ctx, ctor: V, parent: V, has_parent: bool) -> Result<(), V> {
    let F(f) = ctor else { return Ok(()); };
    var pproto: ?Gc<Obj> = c.objproto;
    if has_parent {
        match parent {
            F(pf) => {
                let pb = c.fn_props(pf);
                match c.m.get(pb, c.k_prototype) ?? V.Undef {
                    O(po) => { pproto = Some(po); }
                    Null => { pproto = None; }
                    _ => return Err(c.type_error("Class extends value does not have valid prototype property")),
                }
                // Static members are inherited: C's own properties sit on
                // top of P's.
                c.mark_proto(pb);
                let bag = c.new_object_with(Some(pb), 4);
                c.define_hidden(bag, c.k_prototype, V.Undef);
                f.props = Some(bag);
                f.parent = parent;
                // Room for the parent constructor's properties too.
                f.hint = f.hint + pf.hint;
                if f.hint < 4 { f.hint = 4; }
                if f.hint > 32 { f.hint = 32; }
            }
            Null => { pproto = None; }
            _ => return Err(c.type_error("Class extends value is not a constructor or null")),
        }
    }
    if let Some(pp) = pproto { c.mark_proto(pp); }
    let po = c.new_object_with(pproto, 4);
    c.mark_proto(po);
    c.define_hidden(po, c.k_constructor, ctor);
    let bag = c.fn_props(f);
    c.define_hidden(bag, c.k_prototype, V.O(po));
    f.home = V.O(po);
    Ok(())
}

fn define_method(c: *Ctx, cls: V, kv: V, m: V, is_static: bool) {
    let (F(f), F(mf)) = (cls, m) else { return; };
    let key = key_of_const(c, kv);
    if is_static {
        let bag = c.fn_props(f);
        mf.home = V.O(bag);
        c.define_hidden(bag, key, m);
        return;
    }
    let O(po) = f.home else { return; };
    mf.home = f.home;
    c.define_hidden(po, key, m);
}

/// `super.key`: look it up above the method's home object.
fn super_get(c: *Ctx, cl: Gc<Fn>, kv: V) -> Result<V, V> {
    let key = key_of_const(c, kv);
    let O(h) = cl.home else { return Err(c.type_error("'super' keyword unexpected here")); };
    let Some(p) = h.proto else { return Ok(V.Undef); };
    Ok(c.m.get_chain(p, key) ?? V.Undef)
}

/// The object `new f` initializes: its prototype is f.prototype, and it
/// starts with as many inline slots as f's objects ended up with.
fn construct_this(c: *Ctx, f: Gc<Fn>) -> V {
    let bag = c.fn_props(f);
    var proto = c.objproto;
    if bag.dict.is_none() and bag.shape.count >= 1 {
        if let O(po) = bag.inline[0] { proto = Some(po); }
    } else if let Some(O(po)) = c.m.get(bag, c.k_prototype) {
        proto = Some(po);
    }
    let Some(p) = proto else { return V.O(c.new_object_with(None, f.hint)); };
    var sh: ?Gc<obj.Shape> = None;
    if let Some(cp) = f.ctor_proto and (cp as u64) == (p as u64) { sh = f.ctor_shape; }
    let shape = match sh {
        Some(s) => s,
        None => {
            c.mark_proto(p);
            let s = c.m.root_for(Some(p), f.hint);
            f.ctor_proto = Some(p);
            f.ctor_shape = Some(s);
            s
        }
    };
    V.O(new(&c.heap, Obj { shape: shape, dict: None, overflow: None, proto: Some(p) }, f.hint as u64))
}

/// After `new f` returned object `o`: learn its size for later objects.
#[inline(always)]
fn observe(f: Gc<Fn>, o: Gc<Obj>) {
    let n = o.shape.count;
    if o.dict.is_none() and n > f.hint {
        f.hint = if n > 32 { 32 } else { n };
        f.ctor_shape = None;
    }
}

fn not_function(c: *Ctx, v: V) -> V {
    var b = text.StrBuf.new();
    c.write(&b, if let S(_) = v { v } else { V.S(c.key_str(c.key(value.type_of(v)))) });
    b.push_str(" is not a function");
    let e = c.type_error(b.as_str());
    b.free();
    e
}

fn ref_error(c: *Ctx, name: V) -> V {
    var b = text.StrBuf.new();
    c.write(&b, name);
    b.push_str(" is not defined");
    let e = c.new_error(c.err_proto(), b.as_str());
    b.free();
    e
}

fn delete_prop(c: *Ctx, v: V, key: V) -> Result<V, V> {
    match v {
        O(o) => { c.m.delete(o, c.key_of(key)); }
        A(a) => {
            let i = c.index_of(key);
            if i >= 0 and (i as u64) < a.len { a.ptr[i as u64] = V.Undef; }
        }
        F(f) => { c.m.delete(c.fn_props(f), c.key_of(key)); }
        Undef | Null => return Err(c.type_error("Cannot convert undefined or null to object")),
        _ => {}
    }
    Ok(V.Bool(true))
}

/// The handler for an exception at `at` in `p`, if any: (target, register).
fn find_handler(p: Gc<Proto>, at: *u32) -> ?(u64, u64) {
    let off = p.code.index_of(at);
    let h = p.handlers.data;
    var i: u64 = 0;
    while i + 3 < h.len {
        if (h[i] as u64) <= off and off < (h[i + 1] as u64) { return Some((h[i + 2] as u64, h[i + 3] as u64)); }
        i += 4;
    }
    None
}

#[require_verified]
#[profile("minijs.vmprofile")]
pub vm JS {
    context ctx: *Ctx;
    state { pc: *u32, regs: *V, k: *V, fp: *Frame }
    // A value accumulator (language.md §7.4): a float result passes to the
    // next op in xmm0, written through to its register too.
    accumulator vacc: f64 for reg;
    accumulate ADD_F, SUB_F, MUL_F, DIV_F, JLT, JLE, JLTK, JLEK, JGTK, JGEK, SETPROP_IN;

    // The generated verifier checks these against the prototype that
    // holds the code: JS.build_verified (compile.lm, `finish`) creates
    // the Proto, copies the words into its `code` and verifies them
    // there, with the Proto itself as `proto`.
    verify_context owner proto: Gc<Proto>;
    operand reg = regs[it] verify (it as u32) < proto.nregs;
    operand kst = k[it] const proto.consts.data.ptr verify (it as u64) < proto.consts.data.len;
    operand imm = it;
    operand simm = it;
    operand gl = it;
    operand fv = it verify (it as u32) < proto.nfree;
    operand child = it verify (it as u64) < proto.protos.data.len;
    operand callbase = it verify (it as u32) < proto.nregs;
    operand label = pc + it verify is_insn_boundary(pc + it);
    /// SWITCHI's case count n: it jumps to `pc + 1 + i` for some i <= n,
    /// so the n + 1 words after it must be JMP instructions.
    operand ncases = it verify {
        var ok = true;
        var j: u64 = 0;
        while ok and j <= it {
            ok = is_insn_boundary(pc + 1 + j) and JS.opcode(*(pc + 1 + j)) == JS.OP_JMP;
            j += 1;
        }
        ok
    };

    /// The exception handler table (compile.lm, `add_handlers`): entries
    /// of four words, [start, end) of the protected code, the handler's
    /// target and the register that receives the exception. `on raise`
    /// jumps to `code.start() + target` and writes `regs[reg]`: the
    /// target must start an instruction and the register be in the frame.
    verify handlers {
        let t = proto.handlers.data;
        var ok = t.len % 4 == 0;
        var i: u64 = 0;
        while ok and i < t.len {
            ok = is_insn_boundary(code.ptr + t[i + 2]) and t[i + 3] < proto.nregs;
            i += 4;
        }
        ok
    }

    encoding fixed(u32) {
        format ABC { op: 8, a: 8, b: 8, c: 8 }
        format ABsC { op: 8, a: 8, b: 8, sc: s8 }
        format ABx { op: 8, a: 8, bx: 16 }
        format AsBx { op: 8, a: 8, sbx: s16 }
        format sJ { op: 8, sj: s24 }
    }

    // The collector scans frames and registers up to ctx.fp.
    sync { ctx.fp = fp; }

    op LOADK(dst: reg, c: kst) : ABx { dst = c; next }
    op LOADI(dst: reg, v: simm) : AsBx { dst = Int(v as i32); next }
    op LOADU(dst: reg) : ABC { dst = Undef; next }
    op LOADNULL(dst: reg) : ABC { dst = Null; next }
    op LOADBOOL(dst: reg, b: imm) : ABC { dst = Bool(b != 0); next }
    op MOVE(dst: reg, src: reg) : ABC { dst = src; next }

    op GETGLOBAL(dst: reg, g: gl) : ABx { dst = ctx.gvals.ptr[g]; next }
    op SETGLOBAL(src: reg, g: gl) : ABx { ctx.gvals.ptr[g] = src; next }
    /// Reading an undeclared variable (k[name] is its name).
    op THROWREF(pad: imm, name: kst) : ABx { cold { raise ref_error(ctx, name) } }

    /// R[dst] = the running function (named function expressions).
    op SELF(dst: reg) : ABC { dst = F(fp.cl); next }
    op GETFREE(dst: reg, i: fv) : ABC { dst = fp.cl.free.ptr[i]; next }
    /// Patch free slot `i` of the closure in R[c] (hoisted functions that
    /// capture each other).
    op SETFREE(c: reg, i: imm, src: reg) : ABC {
        if let F(f) = c { f.free.ptr[i] = src; }
        next
    }
    /// `#[poll(gc)]`: collect at the start of an op that allocates, then
    /// run it again; `gc_fall` goes on with the op instead.
    poll gc { if ctx.heap.allocated > ctx.heap.threshold { cold { gc.collect(&ctx.heap); redo } } }
    poll gc_fall { if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } } }

    /// Put R[r] in a new box (a captured variable that is assigned).
    #[poll(gc)] op BOXNEW(r: reg) : ABC {
        let v = r;
        let b = new(&ctx.heap, Box { v: v });
        r = B(b);
        next
    }
    /// A fresh box holding the value of the box in R[r] (per-iteration
    /// bindings of `for (let ...)`).
    #[poll(gc)] op REBOX(r: reg) : ABC {
        if let B(b) = r {
            let nb = new(&ctx.heap, Box { v: b.v });
            r = B(nb);
        }
        next
    }
    op BOXGET(dst: reg, b: reg) : ABC {
        if let B(x) = b { dst = x.v; }
        next
    }
    op BOXSET(b: reg, src: reg) : ABC {
        if let B(x) = b { x.v = src; }
        next
    }
    #[poll(gc_fall)] op CLOSURE(dst: reg, i: child) : ABx {
        dst = F(make_closure(ctx, fp.cl, regs, i as u64));
        next
    }

    #[poll(gc_fall)] op NEWOBJ(dst: reg, n: imm) : ABC {
        dst = O(ctx.new_literal(n as u32));
        next
    }
    /// R[dst] = [R[base] .. R[base+n-1]].
    #[poll(gc_fall)] op NEWARR(dst: reg, base: callbase, n: imm) : ABC {
        let a = ctx.new_array(n as u64, n as u64);
        for i in 0..n as u64 { a.ptr[i] = regs[base + i]; }
        dst = A(a);
        next
    }
    /// Append R[base] .. R[base+n-1] to the array in R[arr].
    op ARRPUSH(arr: reg, base: callbase, n: imm) : ABC {
        if let A(a) = arr {
            for i in 0..n as u64 { ctx.arr_push(a, regs[base + i]); }
        }
        next
    }

    // Property sites: the words of a std.obj Site, which holds in the
    // monomorphic members the receiver's shape id, a SlotRef and, for
    // prototype hits, the validity cell and depth; the index of the
    // site's polymorphic entry or add target; and its miss count. std.obj
    // runs the state machine (`read_miss`, `write_miss`); the members
    // here are its states, plus array and string methods (`_AP`, `_SP`:
    // the builtin prototype's shape id and slot index).
    cache PropIC = obj.Site;

    inline for (fam, own_in, own_out, protom, aprotom, sprotom, polym, megam, missm, dkind, pre) in [
        ("GETPROP", "GETPROP_IN", "GETPROP_OUT", "GETPROP_P", "GETPROP_AP", "GETPROP_SP", "GETPROP_POLY", "GETPROP_MEGA", "GETPROP_MISS", reg, {}),
        ("GETMETHOD", "GETMETHOD_IN", "GETMETHOD_OUT", "GETMETHOD_P", "GETMETHOD_AP", "GETMETHOD_SP", "GETMETHOD_POLY", "GETMETHOD_MEGA", "GETMETHOD_MISS", callbase, { regs[dst + 1] = obj; }),
    ] {
        family #fam(dst: dkind, obj: reg, key: kst) : ABC + PropIC {
            generic {
                if let R(r) = obj { obj = S(value.flatten(r)); }
                pre
                if let O(o) = obj {
                    let (v, st) = read_miss(ctx, o, key, &cache, obj.IcState.Generic);
                    regs[dst.raw] = v;
                    become match st {
                        OwnIn => #own_in,
                        OwnOut => #own_out,
                        Proto => #protom,
                        Poly => #polym,
                    }
                    next
                }
                let (v, p) = prim_get(ctx, obj, key, &cache)?;
                regs[dst.raw] = v;
                if p {
                    if let A(_) = obj { become #aprotom; } else { become #sprotom; }
                }
                next
            }
            #own_in {
                if let O(o) = obj and o.shape.id == cache.sid {
                    pre
                    regs[dst.raw] = o.inline.ptr[cache.slot];
                    next
                }
                become #missm; redo
            }
            #own_out {
                if let O(o) = obj and o.shape.id == cache.sid {
                    pre
                    regs[dst.raw] = ctx.m.load_out(o, cache.slot & !obj.OUT);
                    next
                }
                become #missm; redo
            }
            #protom {
                if let O(o) = obj and o.shape.id == cache.sid and let Some(v) = ctx.m.proto_load(o, cache.slot, cache.cell, cache.depth) {
                    pre
                    regs[dst.raw] = v;
                    next
                }
                become #missm; redo
            }
            // A monomorphic member missed: std.obj refills the site or
            // makes it polymorphic.
            #missm {
                cold {
                    if let O(o) = obj {
                        pre
                        let (v, st) = read_miss(ctx, o, key, &cache, obj.IcState.OwnIn);
                        regs[dst.raw] = v;
                        become match st {
                            OwnIn => #own_in,
                            OwnOut => #own_out,
                            Proto => #protom,
                            Poly => #polym,
                            Generic => #fam,
                        }
                        next
                    }
                    become #fam;
                    redo
                }
            }
            #aprotom {
                if let A(_) = obj {
                    let p = ctx.arr_proto();
                    if p.shape.id == cache.sid {
                        pre
                        regs[dst.raw] = ctx.m.load(p, cache.slot);
                        next
                    }
                }
                become #fam; redo
            }
            // A rope receiver is replaced by its flat string in its
            // register (so a loop calling `s.charCodeAt(i)` on a rope
            // flattens once) and the site stays.
            #sprotom {
                if let S(_) = obj {
                    let p = ctx.str_proto();
                    if p.shape.id == cache.sid {
                        pre
                        regs[dst.raw] = ctx.m.load(p, cache.slot);
                        next
                    }
                }
                // A rope already flattened (`const t = this.text` in each
                // method of json's lexer): no cold call.
                if let R(r) = obj and let Some(f) = r.flat { obj = S(f); redo }
                if let R(r) = obj { cold { obj = S(value.flatten(r)); redo } }
                cold { become #fam; redo }
            }
            // Up to eight (shape, own slot or prototype hit) pairs.
            #polym {
                if let O(o) = obj and let Some(v) = ctx.m.poly_get(o, cache.ent) {
                    pre
                    regs[dst.raw] = v;
                    next
                }
                cold {
                    if let R(r) = obj { obj = S(value.flatten(r)); }
                    pre
                    if let O(o) = obj {
                        let (v, st) = read_miss(ctx, o, key, &cache, obj.IcState.Poly);
                        regs[dst.raw] = v;
                        if st == obj.IcState.Mega { become #megam; }
                        next
                    }
                    regs[dst.raw] = ctx.get(obj, key_of_const(ctx, key))?;
                    next
                }
            }
            // Megamorphic: std.obj's shared MegaCache, own and prototype hits.
            #megam {
                if let (O(o), S(ks)) = (obj, key) and let Some(v) = ctx.m.mega_get(o, ks.key as u64) {
                    pre
                    regs[dst.raw] = v;
                    next
                }
                cold {
                    if let R(r) = obj { obj = S(value.flatten(r)); }
                    pre
                    if let O(o) = obj {
                        let (v, _) = read_miss(ctx, o, key, &cache, obj.IcState.Mega);
                        regs[dst.raw] = v;
                        next
                    }
                    regs[dst.raw] = ctx.get(obj, key_of_const(ctx, key))?;
                    next
                }
            }
        }
    }

    // Store sites: std.obj's write state machine (write_miss_in). A
    // monomorphic member that keeps missing becomes _POLY (up to eight
    // own-slot entries), and a Poly entry that keeps filling up makes the
    // site _MEGA (the slow path, without refilling).
    family SETPROP(tgt: reg, key: kst, val: reg) : ABC + PropIC {
        generic {
            if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
            let st = write_miss(ctx, tgt, key, val, &cache, obj.IcState.Generic)?;
            become match st {
                OwnIn => SETPROP_IN,
                OwnOut => SETPROP_OUT,
                Add => SETPROP_ADD,
                Poly => SETPROP_POLY,
            }
            next
        }
        SETPROP_IN {
            if let O(o) = tgt and o.shape.id == cache.sid {
                o.inline.ptr[cache.slot] = val;
                next
            }
            cold {
                if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                let st = write_miss(ctx, tgt, key, val, &cache, obj.IcState.OwnIn)?;
                become match st {
                    OwnOut => SETPROP_OUT,
                    Add => SETPROP_ADD,
                    Poly => SETPROP_POLY,
                    Generic => SETPROP,
                }
                next
            }
        }
        SETPROP_OUT {
            if let O(o) = tgt and o.shape.id == cache.sid {
                let Some(s) = o.overflow else { unreachable };
                s.data.ptr[cache.slot & !obj.OUT] = val;
                next
            }
            cold {
                if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                let st = write_miss(ctx, tgt, key, val, &cache, obj.IcState.OwnOut)?;
                become match st {
                    OwnIn => SETPROP_IN,
                    Add => SETPROP_ADD,
                    Poly => SETPROP_POLY,
                    Generic => SETPROP,
                }
                next
            }
        }
        // A cached add: the shape check proves the object is not a
        // prototype (std.tgt gives those other shapes).
        SETPROP_ADD {
            if let O(o) = tgt and o.shape.id == cache.sid {
                ctx.m.add_hit(o, cache.ent, cache.slot, val);
                next
            }
            become SETPROP; redo
        }
        SETPROP_POLY {
            if let O(o) = tgt and ctx.m.poly_set(o, cache.ent, val) { next }
            cold {
                if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                let st = write_miss(ctx, tgt, key, val, &cache, obj.IcState.Poly)?;
                if st == obj.IcState.Mega { become SETPROP_MEGA; }
                next
            }
        }
        SETPROP_MEGA {
            if let (O(o), S(ks)) = (tgt, key) and ctx.m.mega_set(o, ks.key as u64, val) { next }
            cold {
                if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                write_miss(ctx, tgt, key, val, &cache, obj.IcState.Mega)?;
                next
            }
        }
    }

    op GETINDEX(dst: reg, tgt: reg, key: reg) : ABC {
        if let (A(a), Int(i)) = (tgt, key) and (i as u32 as u64) < a.len {
            dst = a.ptr[i as u32 as u64];
            next
        }
        if let (S(s), Int(i)) = (tgt, key) and (i as u32 as u64) < s.data.len {
            // One-character strings of ASCII bytes are made at startup.
            if let Some(c) = ctx.ascii_str(s.data.ptr[i as u32 as u64]) { dst = S(c); next }
        }
        cold {
            if let R(r) = tgt { tgt = S(value.flatten(r)); redo }
            dst = ctx.get_index(tgt, key)?;
            next
        }
    }
    op SETINDEX(tgt: reg, key: reg, val: reg) : ABC {
        if let (A(a), Int(i)) = (tgt, key) and (i as u32 as u64) < a.len {
            a.ptr[i as u32 as u64] = val;
            value.abar(a);
            next
        }
        cold {
            if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
            ctx.set_index(tgt, key, val)?;
            next
        }
    }
    op GETLEN(dst: reg, tgt: reg) : ABC {
        if let A(a) = tgt { dst = Int(a.len as i32); next }
        if let S(s) = tgt { dst = Int(s.data.len as i32); next }
        if let R(r) = tgt { dst = Int(r.len as i32); next }
        cold { dst = ctx.get(tgt, ctx.k_length)?; next }
    }
    op DELPROP(dst: reg, tgt: reg, key: reg) : ABC {
        cold { dst = delete_prop(ctx, tgt, key)?; next }
    }
    op IN(dst: reg, key: reg, tgt: reg) : ABC {
        cold { dst = Bool(ctx.has(tgt, ctx.key_of(key))?); next }
    }
    /// R[dst] = the keys `for (k in R[tgt])` visits.
    op KEYS(dst: reg, tgt: reg) : ABC {
        cold {
            if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
            dst = A(ctx.for_in_keys(tgt));
            next
        }
    }

    // Arithmetic: ADD, SUB and MUL are families. The generic member tests
    // (Int, Int) first; the first time a site sees two floats it becomes
    // the _F member, which adds the raw words as doubles (a tagged word is
    // a NaN as a double, so a result that is not a NaN means both
    // operands were numbers). A site that first sees an Int and a Num
    // becomes _IF or _FI, which only handle that case inline and make
    // the site float-first otherwise. Members handle every type, so a
    // site never switches back.
    inline for (name, fname, ifname, finame, checked, sym, code) in [
        ("ADD", "ADD_F", "ADD_IF", "ADD_FI", "add_checked", +, 0),
        ("SUB", "SUB_F", "SUB_IF", "SUB_FI", "sub_checked", -, 1),
        ("MUL", "MUL_F", "MUL_IF", "MUL_FI", "mul_checked", *, 2),
    ] {
        family #name(dst: reg, a: reg, b: reg) : ABC {
            generic {
                // Two Ints: an Int, or the double result on overflow (and
                // for MUL's -0) without leaving the fast path.
                if let (Int(x), Int(y)) = (a, b) {
                    if let Some(r) = x.#checked(y) and (code != 2 or r != 0 or (x | y) >= 0) { dst = Int(r); next }
                    dst = Num(x as f64 sym y as f64);
                    next
                }
                cold {
                    // String concatenation (either operand a string or
                    // rope): straight to concat.
                    if code == 0 and (is_str(a) or is_str(b)) {
                        if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                        dst = ctx.concat(a, b);
                        next
                    }
                    match (a, b) {
                        (Num(x), Num(y)) => { dst = Num(x sym y); become #fname; refuse(fp.cl); next }
                        (Int(x), Num(y)) => { dst = Num(x as f64 sym y); become #ifname; refuse(fp.cl); next }
                        (Num(x), Int(y)) => { dst = Num(x sym y as f64); become #finame; refuse(fp.cl); next }
                        _ => {}
                    }
                    if code == 0 and ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                    dst = arith_cold(ctx, code, a, b)?;
                    next
                }
            }
            #fname {
                let r = f64.from_bits(a as u64) sym f64.from_bits(b as u64);
                if likely(r == r) { dst = r.to_bits() as V; next }
                cold {
                    match (a, b) {
                        (Num(x), Num(y)) => { dst = Num(x sym y); next }
                        (Int(x), Num(y)) => { dst = Num(x as f64 sym y); next }
                        (Num(x), Int(y)) => { dst = Num(x sym y as f64); next }
                        (Int(x), Int(y)) => if let Some(r) = x.#checked(y) and (code != 2 or r != 0 or (x | y) >= 0) { dst = Int(r); next },
                        _ => {}
                    }
                    if code == 0 and ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                    dst = arith_cold(ctx, code, a, b)?;
                    next
                }
            }
            #ifname {
                if let Int(x) = a {
                    let r = x as f64 sym f64.from_bits(b as u64);
                    if likely(r == r) { dst = r.to_bits() as V; next }
                }
                become #fname; refuse(fp.cl); redo
            }
            #finame {
                if let Int(y) = b {
                    let r = f64.from_bits(a as u64) sym y as f64;
                    if likely(r == r) { dst = r.to_bits() as V; next }
                }
                become #fname; refuse(fp.cl); redo
            }
        }
    }
    /// `/`: the generic member divides two Ints first (spectral_norm's
    /// `n / 2` and `1 / n`); a site that sees two floats becomes DIV_F,
    /// which divides the raw words first.
    family DIV(dst: reg, a: reg, b: reg) : ABC {
        generic {
            if let (Int(x), Int(y)) = (a, b) { dst = int_div(x, y); next }
            if let (Int(x), Num(y)) = (a, b) { dst = Num(x as f64 / y); next }
            if let (Num(x), Int(y)) = (a, b) { dst = Num(x / y as f64); next }
            if let (Num(x), Num(y)) = (a, b) { become DIV_F; refuse(fp.cl); redo }
            cold { dst = arith(ctx, 3, a, b)?; next }
        }
        DIV_F {
            let r = f64.from_bits(a as u64) / f64.from_bits(b as u64);
            if likely(r == r) { dst = r.to_bits() as V; next }
            match (a, b) {
                (Int(x), Int(y)) => { dst = int_div(x, y); next }
                (Int(x), Num(y)) => { dst = Num(x as f64 / y); next }
                (Num(x), Int(y)) => { dst = Num(x / y as f64); next }
                _ => {}
            }
            cold { dst = arith(ctx, 3, a, b)?; next }
        }
    }
    /// `%` with a positive Int divisor is exact in integers when the
    /// dividend is integral (an Int, or a Num below 2^53).
    /// MODK's constant divisor is also a std.math.Divisor in its cache,
    /// filled by the emitter (compile.lm): a multiply, not an `idiv`.
    cache ModK = math.Divisor;
    op MODK(dst: reg, a: reg, b: kst) : ABC + ModK {
        if let Int(y) = b and y > 0 and (y as u32) == cache.d {
            if let Int(x) = a and x >= 0 { dst = Int((&cache).urem(x as u64) as i32); next }
            var xi: i64 = 0;
            var ok = false;
            if let Int(x) = a { xi = x as i64; ok = true; }
            if let Num(x) = a and x >= -9007199254740992.0 and x <= 9007199254740992.0 {
                xi = x as i64;
                ok = xi as f64 == x;
            }
            if ok {
                let r = (&cache).rem_trunc(xi);
                if r != 0 or xi > 0 { dst = Int(r as i32); next }
            }
        }
        cold {
            if let (Num(x), Num(y)) = (a, b) { dst = Num(value.js_mod(x, y)); next }
            dst = arith(ctx, 4, a, b)?;
            next
        }
    }
    inline for (name, bkind) in [("MOD", reg)] {
    op #name(dst: reg, a: reg, b: bkind) : ABC {
        if let Int(y) = b and y > 0 {
            if let Int(x) = a and x >= 0 { dst = Int(x % y); next }
            var xi: i64 = 0;
            var ok = false;
            if let Int(x) = a { xi = x as i64; ok = true; }
            if let Num(x) = a and x >= -9007199254740992.0 and x <= 9007199254740992.0 {
                xi = x as i64;
                ok = xi as f64 == x;
            }
            if ok {
                let r = xi % (y as i64);
                if r != 0 or xi > 0 { dst = Int(r as i32); next }
            }
        }
        cold {
            if let (Num(x), Num(y)) = (a, b) { dst = Num(value.js_mod(x, y)); next }
            dst = arith(ctx, 4, a, b)?;
            next
        }
    }
    }
    op POW(dst: reg, a: reg, b: reg) : ABC {
        cold { dst = arith(ctx, 5, a, b)?; next }
    }
    /// R[dst] = R[a] + sc (a small signed constant).
    op ADDI(dst: reg, a: reg, sc: simm) : ABsC {
        if let Int(x) = a and let Some(r) = x.add_checked(sc as i32) { dst = Int(r); next }
        if let Num(x) = a { dst = Num(x + sc as f64); next }
        cold { dst = arith(ctx, 0, a, Int(sc as i32))?; next }
    }
    op NEG(dst: reg, a: reg) : ABC {
        if let Num(x) = a { dst = Num(-x); next }
        dst = neg(a);
        next
    }
    /// Unary + (ToNumber).
    op TONUM(dst: reg, a: reg) : ABC {
        match a {
            Int(_) | Num(_) => { dst = a; next }
            _ => {}
        }
        cold { dst = value.number(value.to_number(a)); next }
    }
    op NOT(dst: reg, a: reg) : ABC { dst = Bool(!value.truthy(a)); next }
    op TYPEOF(dst: reg, a: reg) : ABC { dst = type_of(ctx, a); next }
    op BNOT(dst: reg, a: reg) : ABC {
        if let Int(x) = a { dst = Int(!x); next }
        dst = Int(!int32(a));
        next
    }
    // The K forms take an Int constant (`h << 5`, `x | 0`, `i & 255`).
    inline for (name, code, bkind) in [
        ("BAND", 0, reg), ("BOR", 1, reg), ("BXOR", 2, reg), ("SHL", 3, reg), ("SHR", 4, reg), ("USHR", 5, reg),
        ("BANDK", 0, kst), ("BORK", 1, kst), ("BXORK", 2, kst), ("SHLK", 3, kst), ("SHRK", 4, kst), ("USHRK", 5, kst),
    ] {
        op #name(dst: reg, a: reg, b: bkind) : ABC {
            if let (Int(x), Int(y)) = (a, b) {
                if code == 0 { dst = Int(x & y); next }
                if code == 1 { dst = Int(x | y); next }
                if code == 2 { dst = Int(x ^ y); next }
                if code == 3 { dst = Int(((x as u32) << ((y & 31) as u32)) as i32); next }
                if code == 4 { dst = Int(x >> (y & 31)); next }
                if x >= 0 { dst = Int(((x as u32) >> ((y & 31) as u32)) as i32); next }
            }
            let (x, okx) = i32_of(a);
            let (y, oky) = i32_of(b);
            if okx and oky {
                if code == 0 { dst = Int(x & y); next }
                if code == 1 { dst = Int(x | y); next }
                if code == 2 { dst = Int(x ^ y); next }
                if code == 3 { dst = Int(((x as u32) << ((y & 31) as u32)) as i32); next }
                if code == 4 { dst = Int(x >> (y & 31)); next }
                let u = (x as u32) >> ((y & 31) as u32);
                if u <= 2147483647 { dst = Int(u as i32); next }
                dst = Num(u as f64);
                next
            }
            cold { dst = bitop(code, a, b); next }
        }
    }

    // Comparisons producing booleans.
    // `===` and `!==` producing booleans; the K forms compare with a
    // constant (`return x === 0`, `t = s !== "x"`).
    inline for (name, neg, bkind) in [("EQ", false, reg), ("NE", true, reg), ("EQK", false, kst), ("NEK", true, kst)] {
    op #name(dst: reg, a: reg, b: bkind) : ABC {
        if a == b {
            if let Num(x) = a { dst = Bool((x == x) != neg); next }
            dst = Bool(!neg);
            next
        }
        if let (Int(_), Int(_)) = (a, b) { dst = Bool(neg); next }
        match (a, b) {
            (Num(x), Num(y)) => { dst = Bool((x == y) != neg); next }
            (Int(x), Num(y)) => { dst = Bool((x as f64 == y) != neg); next }
            (Num(x), Int(y)) => { dst = Bool((x == y as f64) != neg); next }
            _ => {}
        }
        cold { dst = Bool(eq_slow(a, b) != neg); next }
    }
    }
    op LOOSEEQ(dst: reg, a: reg, b: reg) : ABC { dst = Bool(loose_eq(a, b)); next }
    op LT(dst: reg, a: reg, b: reg) : ABC {
        match (a, b) {
            (Int(x), Int(y)) => { dst = Bool(x < y); next }
            (Num(x), Num(y)) => { dst = Bool(x < y); next }
            _ => {}
        }
        cold { dst = Bool(less(ctx, a, b, false)); next }
    }
    op LE(dst: reg, a: reg, b: reg) : ABC {
        match (a, b) {
            (Int(x), Int(y)) => { dst = Bool(x <= y); next }
            (Num(x), Num(y)) => { dst = Bool(x <= y); next }
            _ => {}
        }
        cold { dst = Bool(less(ctx, a, b, true)); next }
    }

    /// The end of a compare-and-branch: jump to the following JMP's
    /// target, or skip the JMP.
    fn branch(take: bool, target: *u32) -> never {
        if take { jump target }
        jump pc + 2
    }

    // Compare and branch: the next word is a JMP holding the offset.
    // Jump if the comparison equals `pol`.
    op JLT(pol: imm, a: reg, b: reg) : ABC then JMP {
        let want = pol != 0;
        match (a, b) {
            (Int(x), Int(y)) => branch((x < y) == want, then.target),
            (Num(x), Num(y)) => branch((x < y) == want, then.target),
            _ => {}
        }
        cold { branch(less(ctx, a, b, false) == want, then.target) }
    }
    op JLE(pol: imm, a: reg, b: reg) : ABC then JMP {
        let want = pol != 0;
        match (a, b) {
            (Int(x), Int(y)) => branch((x <= y) == want, then.target),
            (Num(x), Num(y)) => branch((x <= y) == want, then.target),
            _ => {}
        }
        cold { branch(less(ctx, a, b, true) == want, then.target) }
    }
    op JEQ(pol: imm, a: reg, b: reg) : ABC then JMP {
        let want = pol != 0;
        if a == b {
            var eq = true;
            if let Num(x) = a { eq = x == x; }
            branch(eq == want, then.target)
        }
        // Different words: two Ints (the usual case) are not equal.
        if let (Int(_), Int(_)) = (a, b) { branch(!want, then.target) }
        match (a, b) {
            (Num(x), Num(y)) => branch((x == y) == want, then.target),
            (Int(x), Num(y)) => branch((x as f64 == y) == want, then.target),
            (Num(x), Int(y)) => branch((x == y as f64) == want, then.target),
            _ => {}
        }
        cold { branch(eq_slow(a, b) == want, then.target) }
    }

    /// Compare against a small integer constant and branch: R[a] < sc,
    /// <= sc, > sc, >= sc.
    inline for (name, icmp, fcmp, swap, oreq) in [
        ("JLTI", xi < c, xf < c as f64, false, false), ("JLEI", xi <= c, xf <= c as f64, false, true),
        ("JGTI", xi > c, xf > c as f64, true, false), ("JGEI", xi >= c, xf >= c as f64, true, true),
    ] {
        op #name(pol: imm, a: reg, sc: simm) : ABsC then JMP {
            let want = pol != 0;
            let c = sc as i32;
            if let Int(xi) = a { branch(icmp == want, then.target) }
            if let Num(xf) = a { branch(fcmp == want, then.target) }
            cold {
                let r = if swap { less(ctx, Int(c), a, oreq) } else { less(ctx, a, Int(c), oreq) };
                branch(r == want, then.target)
            }
        }
    }

    /// Compare against a number constant k[kc] (`i <= 5000`, `x < N` with
    /// N a folded `const`, `d < 0.5`) and branch.
    inline for (name, swap, oreq) in [
        ("JLTK", false, false), ("JLEK", false, true), ("JGTK", true, false), ("JGEK", true, true),
    ] {
        op #name(pol: imm, a: reg, kc: kst) : ABC then JMP {
            let want = pol != 0;
            if let (Int(xi), Int(c)) = (a, kc) {
                let t = if swap { if oreq { xi >= c } else { xi > c } } else { if oreq { xi <= c } else { xi < c } };
                branch(t == want, then.target)
            }
            if let Num(xf) = a {
                var c = 0.0;
                var ok = true;
                match kc {
                    Int(ci) => { c = ci as f64; }
                    Num(cf) => { c = cf; }
                    _ => { ok = false; }
                }
                if ok {
                    let t = if swap { if oreq { xf >= c } else { xf > c } } else { if oreq { xf <= c } else { xf < c } };
                    branch(t == want, then.target)
                }
            }
            cold {
                let r = if swap { less(ctx, kc, a, oreq) } else { less(ctx, a, kc, oreq) };
                branch(r == want, then.target)
            }
        }
    }

    /// JEQ against a constant.
    op JEQK(pol: imm, a: reg, b: kst) : ABC then JMP {
        let want = pol != 0;
        if a == b {
            var eq = true;
            if let Num(x) = a { eq = x == x; }
            branch(eq == want, then.target)
        }
        // Different words: two Ints (the usual case) are not equal.
        if let (Int(_), Int(_)) = (a, b) { branch(!want, then.target) }
        match (a, b) {
            (Num(x), Num(y)) => branch((x == y) == want, then.target),
            (Int(x), Num(y)) => branch((x as f64 == y) == want, then.target),
            (Num(x), Int(y)) => branch((x == y as f64) == want, then.target),
            _ => {}
        }
        cold { branch(eq_slow(a, b) == want, then.target) }
    }

    /// `switch` on Int cases lo .. lo+n-1: followed by n JMPs (one per
    /// value) and the JMP for every other value.
    op SWITCHI(r: reg, lo: kst, n: ncases) : ABC {
        var i = n as u64;
        if let (Int(x), Int(l)) = (r, lo) and ((x as i64 - l as i64) as u64) < n as u64 { i = (x as i64 - l as i64) as u64; }
        if let (Num(x), Int(l)) = (r, lo) and x >= l as f64 and x < (l as f64) + (n as f64) and (x as i64) as f64 == x {
            i = (x as i64 - l as i64) as u64;
        }
        jump pc + 1 + i
    }
    op JMP(target: label) : sJ { jump target }
    /// Jump if falsy.
    op TEST(a: reg, target: label) : AsBx {
        if a == V.Bool(false) { jump target }
        if a == V.Bool(true) { next }
        if !value.truthy(a) { jump target }
        next
    }
    /// Jump if truthy.
    op TESTT(a: reg, target: label) : AsBx {
        if a == V.Bool(true) { jump target }
        if a == V.Bool(false) { next }
        if value.truthy(a) { jump target }
        next
    }
    /// Jump unless null or undefined.
    op TESTNN(a: reg, target: label) : AsBx {
        if a != V.Undef and a != V.Null { jump target }
        next
    }

    /// Calls that CALL's fast path does not take: natives, argument
    /// count mismatches, non-functions.
    fn call_slow(base: u64, nargs: u64, flags: u32) -> never {
        let f = regs[base];
        let F(cl) = f else { raise not_function(ctx, f) };
        let p = cl.proto;
        if cl.native != 0 {
            let v = builtins.call(ctx, cl.native, regs[base + 1], regs + base + 2, nargs)?;
            regs[base] = v;
            next
        }
        if p.flags & value.PF_CLASS != 0 and flags & rt.FR_NEW == 0 and regs[base + 1] == V.Undef {
            raise ctx.type_error("Class constructor cannot be invoked without 'new'")
        }
        let callee = regs + base + 1;
        let n = p.nregs as u64;
        if !ctx.vs.ensure(callee + n + 1) or fp + 1 >= ctx.frames_end {
            raise ctx.new_error(ctx.err_proto(), "Maximum call stack size exceeded")
        }
        let np = p.nparams as u64 + 1;
        var i = nargs + 1;
        if i > np { i = np; }
        while i < n {
            callee[i] = Undef;
            i += 1;
        }
        fp.resume = pc + 1;
        fp = fp + 1;
        fp.cl = cl;
        fp.base = callee;
        fp.flags = flags;
        k = p.consts.data.ptr;
        fp.k = k;
        regs = callee;
        jump p.code
    }

    /// CALL's window reaches the stack's high-water mark: check for
    /// overflow, raise the mark, and run the op again. (Not for NEW, whose
    /// collection check before allocating would run again: under GC stress
    /// that collection lowers the mark every time.)
    fn grow_stack(end: *V) -> never {
        cold {
            if !ctx.vs.raise(end + 1) { raise ctx.new_error(ctx.err_proto(), "Maximum call stack size exceeded") }
            redo
        }
    }

    /// A native call from CALL's members (their callee is the native
    /// they expected, the arguments are not what their inline path takes).
    fn call_native(base: u64, nargs: u64) -> never {
        if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
        let F(cl) = regs[base] else { unreachable };
        regs[base] = builtins.call(ctx, cl.native, regs[base + 1], regs + base + 2, nargs)?;
        next
    }

    /// R[base] = R[base](R[base+2] .. R[base+1+nargs]) with this = R[base+1].
    /// Sites that call certain natives (`s.charCodeAt(i)`, `a.push(x)`,
    /// `Math.floor(x)`, ...) become members that run them inline while
    /// the callee is that native.
    family CALL(base: callbase, nargs: imm) : ABC {
        generic {
            if let F(cl) = regs[base] {
                let p = cl.proto;
                if likely(p.fixed <= 255) {
                    let callee = regs + base + 1;
                    let n = p.nregs as u64;
                    // The callee's registers past its parameters keep what
                    // they held (the compiler writes every register before
                    // reading it). They are valid values: the collector
                    // clears the stack above the innermost window up to
                    // the high-water mark ctx.vs.hw (rt.scan_roots), so a
                    // stale register never refers to a freed object.
                    if !ctx.vs.fits(callee + n + 2) { grow_stack(callee + n + 1) }
                    if fp + 1 >= ctx.frames_end {
                        raise ctx.new_error(ctx.err_proto(), "Maximum call stack size exceeded")
                    }
                    // Missing arguments are undefined; extra ones are the
                    // callee's locals.
                    let fx = p.fixed as u64;
                    if (nargs as u64) < fx {
                        cold {
                            var i = nargs as u64 + 1;
                            while i <= fx { callee[i] = Undef; i += 1; }
                        }
                    }
                    fp.resume = pc + 1;
                    fp = fp + 1;
                    fp.cl = cl;
                    fp.base = callee;
                    fp.flags = 0;
                    k = p.consts.data.ptr;
                    fp.k = k;
                    regs = callee;
                    jump p.code
                }
                // Natives: out of line, so that the bytecode path needs
                // no stack frame.
                if cl.native != 0 {
                    if nargs == 1 {
                        let f = regs[base];
                        if f == ctx.f_cca { become CALL_CCA; }
                        if f == ctx.f_charat { become CALL_CHARAT; }
                        if f == ctx.f_push { become CALL_PUSH; }
                        if f == ctx.f_floor { become CALL_FLOOR; }
                        if f == ctx.f_sqrt { become CALL_SQRT; }
                    }
                    cold { call_native(base as u64, nargs as u64) }
                }
            }
            cold {
                if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                call_slow(base as u64, nargs as u64, 0)
            }
        }
        /// s.charCodeAt(i)
        CALL_CCA {
            if regs[base] == ctx.f_cca and let S(s) = regs[base + 1] and let Int(i) = regs[base + 2]
                    and (i as u32 as u64) < s.data.len {
                regs[base] = Int(s.data[i as u32 as u64] as i32);
                next
            }
            cold {
                if regs[base] != ctx.f_cca { become CALL; redo }
                call_native(base as u64, 1)
            }
        }
        /// s.charAt(i)
        CALL_CHARAT {
            if regs[base] == ctx.f_charat and let S(s) = regs[base + 1] and let Int(i) = regs[base + 2]
                    and (i as u32 as u64) < s.data.len {
                if let Some(c) = ctx.ascii_str(s.data.ptr[i as u32 as u64]) { regs[base] = S(c); next }
            }
            cold {
                if regs[base] != ctx.f_charat { become CALL; redo }
                call_native(base as u64, 1)
            }
        }
        /// a.push(x) with room in the store.
        CALL_PUSH {
            if regs[base] == ctx.f_push and let A(a) = regs[base + 1] and let Some(st) = a.store
                    and a.len < st.data.len {
                a.ptr[a.len] = regs[base + 2];
                gc.barrier(st as *u8);
                a.len += 1;
                regs[base] = Int(a.len as i32);
                next
            }
            cold {
                if regs[base] != ctx.f_push { become CALL; redo }
                call_native(base as u64, 1)
            }
        }
        /// Math.floor(x)
        CALL_FLOOR {
            if regs[base] == ctx.f_floor {
                let x = regs[base + 2];
                if let Int(_) = x { regs[base] = x; next }
                // floor of a double in Int range, without a libm call.
                if let Num(d) = x and d > -2147483648.0 and d < 2147483647.0 {
                    var i = d as i64;
                    if (i as f64) > d { i -= 1; }
                    if i != 0 or d > 0.0 { regs[base] = Int(i as i32); next }
                }
            }
            cold {
                if regs[base] != ctx.f_floor { become CALL; redo }
                call_native(base as u64, 1)
            }
        }
        /// Math.sqrt(x)
        CALL_SQRT {
            if regs[base] == ctx.f_sqrt {
                let x = regs[base + 2];
                if let Num(d) = x and d >= 0.0 { regs[base] = value.number(d.sqrt()); next }
                if let Int(i) = x and i >= 0 { regs[base] = value.number((i as f64).sqrt()); next }
            }
            cold {
                if regs[base] != ctx.f_sqrt { become CALL; redo }
                call_native(base as u64, 1)
            }
        }
    }

    /// Push a frame for bytecode function `cl` called at `base` and jump to it.
    fn enter(cl: Gc<Fn>, base: u64, nargs: u64, flags: u32) -> never {
        let p = cl.proto;
        let callee = regs + base + 1;
        let n = p.nregs as u64;
        // As in CALL.
        if !ctx.vs.ensure(callee + n + 2) { raise ctx.new_error(ctx.err_proto(), "Maximum call stack size exceeded") }
        if fp + 1 >= ctx.frames_end {
            raise ctx.new_error(ctx.err_proto(), "Maximum call stack size exceeded")
        }
        let np = p.nparams as u64;
        if nargs < np {
            cold {
                var i = nargs + 1;
                while i <= np { callee[i] = Undef; i += 1; }
            }
        }
        fp.resume = pc + 1;
        fp = fp + 1;
        fp.cl = cl;
        fp.base = callee;
        fp.flags = flags;
        k = p.consts.data.ptr;
        fp.k = k;
        regs = callee;
        jump p.code
    }

    /// A `new` object with `n` (at most 8) inline slots, if the
    /// allocator's current run has room; constant lengths, so the zeroing
    /// is inline.
    fn try_obj(sh: Gc<obj.Shape>, cp: Gc<Obj>, n: u64) -> ?Gc<Obj> {
        inline for i in [0, 1, 2, 3, 4, 5, 6, 7, 8] {
            if n == i { return try_new(&ctx.heap, Obj { shape: sh, dict: None, overflow: None, proto: Some(cp) }, i); }
        }
        None
    }

    /// R[base] = new R[base](R[base+2] ..).
    op NEW(base: callbase, nargs: imm) : ABC {
        // A constructor whose objects' root shape is cached for its
        // current prototype: allocate here and enter it.
        if let F(cl) = regs[base] and cl.native == 0 and let Some(sh) = cl.ctor_shape and let Some(cp) = cl.ctor_proto
                and let Some(bag) = cl.props and bag.dict.is_none() and bag.shape.count >= 1 and bag.inline.ptr[0] == V.O(cp) {
            poll gc;
            // Up to 8 inline slots: the allocator's inline path with a
            // constant size (no call, so no stack frame).
            let n = cl.hint as u64;
            if n <= 8 {
                let Some(o) = try_obj(sh, cp, n) else cold { gc.make_room(&ctx.heap, size_of<Obj>() + n * 8); redo };
                regs[base + 1] = O(o);
                enter(cl, base as u64, nargs as u64, rt.FR_NEW)
            }
            cold {
                let o = new(&ctx.heap, Obj { shape: sh, dict: None, overflow: None, proto: Some(cp) }, n);
                regs[base + 1] = O(o);
                enter(cl, base as u64, nargs as u64, rt.FR_NEW)
            }
        }
        cold {
            if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
            let f = regs[base];
            let F(cl) = f else { raise not_function(ctx, f) };
            if cl.native != 0 {
                regs[base + 1] = Undef;
                call_slow(base as u64, nargs as u64, rt.FR_NEW)
            }
            if cl.proto.flags & (value.PF_ARROW | value.PF_METHOD) != 0 {
                raise not_function(ctx, f)
            }
            regs[base + 1] = construct_this(ctx, cl);
            call_slow(base as u64, nargs as u64, rt.FR_NEW)
        }
    }
    // The bottom frame is flagged FR_BOTTOM, so one test of the flags
    // finds both `new` frames and the end of the run.
    op RET(src: reg) : ABC {
        var v = src;
        if fp.flags != 0 {
            cold {
                if fp.flags & rt.FR_NEW != 0 {
                    match v {
                        O(_) | A(_) | F(_) => {}
                        _ => { v = regs[0]; }
                    }
                    if v == V.Undef { raise ctx.new_error(ctx.err_proto(), "Must call super constructor in derived class before accessing 'this' or returning from derived constructor") }
                    if let O(o) = regs[0] { observe(fp.cl, o); }
                }
                if fp == ctx.frames { exit v }
                *(regs - 1) = v;
                fp = fp - 1;
                regs = fp.base;
                k = fp.k;
                jump fp.resume
            }
        }
        *(regs - 1) = v;
        fp = fp - 1;
        regs = fp.base;
        k = fp.k;
        jump fp.resume
    }
    op RETU() : ABC {
        // A constructor returning normally (`new` frames are common).
        if fp.flags == rt.FR_NEW {
            let O(o) = regs[0] else { raise ctx.new_error(ctx.err_proto(), "Must call super constructor in derived class before accessing 'this' or returning from derived constructor") };
            observe(fp.cl, o);
            *(regs - 1) = regs[0];
            fp = fp - 1;
            regs = fp.base;
            k = fp.k;
            jump fp.resume
        }
        if fp.flags != 0 {
            cold {
                var v = V.Undef;
                if fp.flags & rt.FR_NEW != 0 {
                    v = regs[0];
                    if v == V.Undef { raise ctx.new_error(ctx.err_proto(), "Must call super constructor in derived class before accessing 'this' or returning from derived constructor") }
                    if let O(o) = v { observe(fp.cl, o); }
                }
                if fp == ctx.frames { exit v }
                *(regs - 1) = v;
                fp = fp - 1;
                regs = fp.base;
                k = fp.k;
                jump fp.resume
            }
        }
        *(regs - 1) = Undef;
        fp = fp - 1;
        regs = fp.base;
        k = fp.k;
        jump fp.resume
    }
    op THROW(src: reg) : ABC {
        cold { raise src }
    }

    /// R[dst] = the constructor `super(...)` calls.
    op GETPARENT(dst: reg) : ABC {
        let p = fp.cl.parent;
        if let F(_) = p { dst = p; next }
        raise ctx.type_error("'super' keyword unexpected here")
    }
    /// R[dst] = super[k[key]].
    op GETSUPER(dst: reg, key: kst) : ABC {
        cold { dst = super_get(ctx, fp.cl, key)?; next }
    }
    /// Make the closure in R[ctor] a class, extending R[parent] if `has`.
    op CLASS(ctor: reg, parent: reg, has: imm) : ABC {
        cold {
            if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
            make_class(ctx, ctor, parent, has != 0)?;
            next
        }
    }
    /// Define method R[m] as k[key] on class R[cls]'s prototype (or, for
    /// SMETHOD, on the class itself).
    op METHOD(cls: reg, key: kst, m: reg) : ABC {
        cold { define_method(ctx, cls, key, m, false); next }
    }
    op SMETHOD(cls: reg, key: kst, m: reg) : ABC {
        cold { define_method(ctx, cls, key, m, true); next }
    }
    /// Methods with a computed name R[key].
    op METHODC(cls: reg, key: reg, m: reg) : ABC {
        cold { define_method(ctx, cls, key, m, false); next }
    }
    op SMETHODC(cls: reg, key: reg, m: reg) : ABC {
        cold { define_method(ctx, cls, key, m, true); next }
    }
    /// Reading `this` in a derived constructor before super().
    op CHECKTHIS(r: reg) : ABC {
        if r != V.Undef { next }
        raise ctx.new_error(ctx.err_proto(), "Must call super constructor in derived class before accessing 'this' or returning from derived constructor")
    }
    /// After super(...) returned: `this` becomes R[h].
    op SUPERDONE(h: reg) : ABC {
        if regs[0] != V.Undef { raise ctx.new_error(ctx.err_proto(), "Super constructor may only be called once") }
        regs[0] = h;
        next
    }

    // Superinstructions for common pairs.
    // All `#[forward]`: where a part reads the register the previous part
    // wrote, `optimize` picks a variant that keeps the value in a machine
    // register (no run-time test; it costs opcodes and code size).
    #[forward] supers {
        MOVE, MOVE;
        GETPROP_IN, GETPROP_IN;
        GETLEN, JLT;
        ADDI, JLT;
        // Overlaps another super, but runs outside MOVE; MOVE: 5% of binary_trees' ops, 4% of deltablue's.
        #[allow(super_overlap)] MOVE, CALL;
        GETMETHOD_P, CALL;
        GETGLOBAL, LOADU;
        // Overlaps another super, but runs outside the MOVE pairs: 6.6% of closures' ops.
        #[allow(super_overlap)] LOADU, MOVE;
        GETINDEX, SETINDEX;
        // Overlaps another super, but runs outside GETPROP_IN; GETPROP_IN: 1.7% of raytrace's ops.
        #[allow(super_overlap)] GETPROP_IN, GETMETHOD_P;
        MUL_F, ADD_F;
        // Overlaps another super, but runs where no ADD_F follows: 14% of nbody's ops.
        #[allow(super_overlap)] MUL_F, MUL_F;
        // Loop tails against constants (JLTK/JLEK) and `if (a[i])`; supers
        // for returns, constructors' adds and POLY calls measured within
        // noise and were not kept.
        ADDI, JLTK;
        ADDI, JLEK;
        GETINDEX, TEST;
    }
    // Over accumulator variants (nbody's `b.vx -= dx * b2.mass * mag`): a
    // variant breaks up the supers over its op (MUL_F; MUL_F).
    #[forward] #[allow(super_overlap)] supers {
        MUL_F, MUL_F__RAR, SUB_F__RRA, SETPROP_IN__RA;
        MUL_F, MUL_F__RAR, ADD_F__RRA, SETPROP_IN__RA;
        MUL_F, MUL_F__RAR;
        ADD_F__RRA, SETPROP_IN__RA;
    }

    entry run(c: *Ctx, cl: Gc<Fn>) -> V uses gc {
        ctx = c;
        let p = cl.proto;
        c.vs.base[0] = Undef;
        regs = c.vs.base + 1;
        for i in 0..p.nregs as u64 { regs[i] = Undef; }
        if !c.vs.ensure(regs + p.nregs as u64 + 1) { exit Undef }
        fp = c.frames;
        fp.cl = cl;
        fp.base = regs;
        fp.flags = rt.FR_BOTTOM;
        k = p.consts.data.ptr;
        fp.k = k;
        c.fp = fp;
        jump p.code
    }

    on raise(e: V) {
        var f = fp;
        var at = pc;
        loop {
            let p = f.cl.proto;
            if let Some((target, r)) = find_handler(p, at) {
                // `verify handlers` checked that `target` starts an
                // instruction of `p.code` and that `r` is in the frame.
                fp = f;
                regs = f.base;
                k = f.k;
                regs[r] = e;
                jump p.code.start() + target
            }
            if f == ctx.frames { break; }
            f = f - 1;
            at = f.resume - 1;
        }
        ctx.error = e;
        ctx.failed = true;
        ctx.fp = fp;
        exit Undef
    }
}
