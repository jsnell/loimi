// A Lox interpreter: a register-based bytecode vm in Loimi.
//
//   lox FILE.lox [--disasm] [--disasm-after] [--gc-stress]
//
// Exit status as clox: 65 for a compile error, 70 for a run-time error.

import std.io;
import std.os;
import std.gc;
import std.mem;
import std.obj;
import std.text;
import parser;
import compile;
import value;
import value.{Value, Proto, Closure, Native};
import vm;
import vm.{Lox, Machine, Globals, Frame};

const STACK: u64 = 1 << 20;
const FRAMES: u64 = 1 << 16;

fn disassemble(protos: *mem.Vec<*Proto>) {
    var out = text.StrBuf.new();
    for i in 0..protos.len {
        let p = protos.at(i);
        out.push_str("fn ");
        out.push_str(p.name);
        out.push_str(":\n");
        Lox.disasm(p.words, &out);
    }
    io.print(out.as_str());
    out.free();
}

fn main() -> i32 uses gc {
    let Some(path) = os.arg(1) else { io.eprintln("usage: lox FILE.lox [--disasm] [--disasm-after] [--gc-stress]"); return 64; };
    let Some(src) = io.read_file(path) else { io.eprintln("cannot read the file"); return 74; };
    var disasm = false;
    var disasm_after = false;
    var stress = false;
    for i in 2..os.arg_count() {
        let a = os.arg(i) ?? "";
        if a.eq("--disasm") { disasm = true; }
        if a.eq("--disasm-after") { disasm_after = true; }
        if a.eq("--gc-stress") { stress = true; }
    }
    var arena = mem.Arena.new();
    defer arena.free();
    let Some(prog) = parser.parse_program(src, &arena) else { return 65; };

    var names = text.Interner.new();
    var natives: [Native; 1] = [Native { name: "clock", arity: 0, f: vm.clock_native }];
    var m = Machine {
        stack: mem.alloc(STACK), stack_end: 0 as *Value,
        frames: mem.alloc(FRAMES), frames_end: 0 as *Frame, fp: 0 as *Frame,
        globals: Globals.new(), names: &names, heap: gc.Heap.new(),
        m: obj.Model.new(value.new_slots, Value.Nil), strings: value.Strings.new(),
        natives: &natives[0], init_str: None, protos: 0 as *mem.Vec<*Proto>,
        out: text.StrBuf.new(), msg: text.StrBuf.new(), tmp: text.StrBuf.new(), keys: mem.Vec.new(),
        stress: stress,
    };
    m.stack_end = m.stack + STACK;
    m.frames_end = m.frames + FRAMES;
    m.fp = m.frames;
    m.init_str = Some(m.strings.intern(&m.heap, "init"));
    m.globals.define(names.intern("clock") + 1, Value.Native(0));

    // Nothing collects until the program runs, so the constants the
    // compiler allocates need no rooting until `m.protos` is set.
    let (main, protos) = match compile.compile(&prog, &m, &names) {
        Ok(r) => r,
        Err((msg, line)) => {
            var b = text.StrBuf.new();
            b.fmt2("[line {}] Error: {}", line, msg);
            io.eprintln(b.as_str());
            return 65;
        }
    };
    var all = protos;
    m.protos = &all;
    m.m.attach(&m.heap);
    m.heap.add_scanner(&m as *u8, vm.scan_roots);
    m.heap.add_sweeper(&m.strings as *u8, value.sweep_strings);
    if stress { m.heap.set_stress(true); }

    for i in 0..all.len {
        let p = all.at(i);
        match Lox.verify(p.words, p, names.names.len as u32) {
            Ok(v) => p.code = Lox.optimize(v),
            Err(e) => {
                var b = text.StrBuf.new();
                b.push_str("bytecode failed verification: ");
                e.write(&b);
                io.eprintln(b.as_str());
                return 70;
            }
        }
    }
    if disasm { disassemble(&all); }

    let cl = new(&m.heap, Closure { proto: main }, 0);
    let status: i32 = match Lox.run(&m, cl) {
        Ok(_) => 0,
        Err(_) => 70,
    };
    if disasm_after { disassemble(&all); }
    status
}
