// The register vm that wasm code is translated to (compile.lm), and the
// runtime structures it works on.
//
// A wasm function's frame is a window of untyped 64-bit slots:
// [params and locals][operand stack homes][scratch]. Every value is
// stored in one slot but v128, which takes two consecutive ones; i32 and
// f32 values occupy a slot's low 4 bytes, and the
// operand kinds below read and write a slot as the type the op needs.
// The wasm validator has proved the types, so an op never reads a slot
// as a type that was not written there; the vm verifier proves that
// every slot index is inside the frame.
import std.io;
import std.mem;
import decode;

pub enum Trap {
    Unreachable,
    MemOOB,
    DivZero,
    IntOverflow,
    InvalidConv,
    UndefElem,
    UninitElem,
    SigMismatch,
    Exhausted,
    Host,
    TableOOB,
    Exit,
}

pub fn trap_message(t: Trap) -> str {
    match t {
        Unreachable => "unreachable",
        MemOOB => "out of bounds memory access",
        DivZero => "integer divide by zero",
        IntOverflow => "integer overflow",
        InvalidConv => "invalid conversion to integer",
        UndefElem => "undefined element",
        UninitElem => "uninitialized element",
        SigMismatch => "indirect call type mismatch",
        Exhausted => "call stack exhausted",
        Host => "host error",
        TableOOB => "out of bounds table access",
        Exit => "exit",
    }
}

/// A host function: arguments in `args[0..nparams]`, results written to
/// `args[0..nresults]`. Returns false to trap (the trap is in m.host_trap).
pub type HostFn = fn(*Machine, *u64) -> bool;

pub struct Func {
    code: Verified<W>,
    nparams: u32,
    /// Parameters and locals; calls zero the slots from nparams to
    /// nzero (the locals that may be read before they are written).
    nzero: u32,
    nlocals: u32,
    /// The whole frame: locals, constant slots, operand stack, scratch.
    nslots: u32,
    /// Constant slots, after the locals: calls copy `consts` there.
    nconsts: u32,
    consts: *u64,
    nresults: u32,
    /// Canonical signature id: equal ids mean equal function types.
    sig: u32,
    inst: *Inst,
    host: ?HostFn,
    /// Host functions: an argument for the host function's use.
    host_data: u64,
    /// The result types (the script protocol prints results by type).
    results: []u8,
}

pub struct Memory { data: *u8, size: u64, max_pages: u64 }

/// Elements are references: a `*Func` as an address for funcref, the
/// host's value for externref; 0 is null.
pub struct Table { elems: *u64, size: u64, max: u64, reftype: u8 }

pub struct Inst {
    funcs: mem.Vec<*Func>,
    /// Pointers to global cells (imported ones are shared).
    globals: mem.Vec<*u64>,
    global_types: mem.Vec<u8>,
    global_muts: mem.Vec<bool>,
    memory: ?*Memory,
    tables: mem.Vec<*Table>,
    /// Canonical signature id per type index.
    sigs: mem.Vec<u32>,
    module: *decode.Module,
    /// Dropped passive segments.
    elem_dropped: mem.Vec<bool>,
    data_dropped: mem.Vec<bool>,
    /// The evaluated references of every element segment.
    elem_vals: mem.Vec<[]u64>,
}

/// One activation record: where the caller continues and its window.
/// `inst` is used only by the records cross-instance calls push.
pub struct Frame { ret: *u64, regs: *u64, inst: *Inst }

pub struct Machine {
    inst: *Inst,
    // Caches of the current instance, read by the handlers.
    funcs: **Func,
    globals: **u64,
    sigs: *u32,
    table: *Table,
    memory: *Memory,
    mem_size: u64,

    stack: *u64,
    stack_end: *u64,
    frames: *Frame,
    frames_end: *Frame,
    /// Verified one-op stubs: HALT ends a run, RESTORE returns from a
    /// call into another instance.
    halt_pc: *u64,
    restore_pc: *u64,
    host_trap: Trap,
    empty_table: Table,
    empty_memory: Memory,
    exit_code: i32,
}

pub fn Machine.switch_to(m: *Machine, i: *Inst) {
    m.inst = i;
    m.funcs = unsafe { i.funcs.ptr }; // unsafe: an instance's vectors are complete
    m.globals = unsafe { i.globals.ptr }; // (`instantiate`) before any switch to it,
    m.sigs = unsafe { i.sigs.ptr }; // so they do not move while cached here
    m.table = if i.tables.len > 0 { i.tables.at(0) } else { &m.empty_table };
    m.memory = i.memory ?? &m.empty_memory;
    m.mem_size = m.memory.size;
}

#[inline(always)]
fn b2i(c: bool) -> i32 { if c { 1 } else { 0 } }

extern "C" fn realloc(p: *u8, n: u64) -> ?*u8;
extern "C" fn memset(p: *u8, c: i32, n: u64) -> *u8;
extern "C" fn memmove(d: *u8, s: *u8, n: u64) -> *u8;

// Saturating truncations (0xFC 0..7).
fn sat_i32(x: f64) -> i32 {
    if x != x { return 0; }
    if x <= -2147483648.0 { return -2147483648; }
    if x >= 2147483647.0 { return 2147483647; }
    x as i32
}
fn sat_u32(x: f64) -> u32 {
    if x != x or x <= 0.0 { return 0; }
    if x >= 4294967295.0 { return 4294967295; }
    x as u32
}
fn sat_i64(x: f64) -> i64 {
    if x != x { return 0; }
    if x <= -9223372036854775808.0 { return -9223372036854775807 - 1; }
    if x >= 9223372036854775808.0 { return 9223372036854775807; }
    x as i64
}
fn sat_u64(x: f64) -> u64 {
    if x != x or x <= 0.0 { return 0; }
    if x >= 18446744073709551616.0 { return 0xFFFFFFFFFFFFFFFF; }
    x as u64
}

/// memory.grow: the old size in pages, or -1.
pub fn grow_memory(m: *Machine, delta: u32) -> i32 {
    let mem = m.memory;
    if mem == &m.empty_memory { return -1; }
    let old = mem.size >> 16;
    let new = old + (delta as u64);
    if new > mem.max_pages or new > 32768 { return -1; }
    if delta == 0 { return old as i32; }
    let Some(p) = realloc(mem.data, (new << 16) + 8) else { return -1; };
    memset(p + mem.size, 0, (delta as u64) << 16);
    mem.data = p;
    mem.size = new << 16;
    m.mem_size = mem.size;
    old as i32
}

// SIMD helpers: pairwise sums, the dot product and q15 rounding multiply.
#[inline(always)]
fn pairs_i8(a: i8x16) -> i16x8 {
    let lo = a.widen_low();
    let hi = a.widen_high();
    lo.shuffle(hi, [0, 2, 4, 6, 8, 10, 12, 14]) +% lo.shuffle(hi, [1, 3, 5, 7, 9, 11, 13, 15])
}
#[inline(always)]
fn pairs_u8(a: u8x16) -> u16x8 {
    let lo = a.widen_low();
    let hi = a.widen_high();
    lo.shuffle(hi, [0, 2, 4, 6, 8, 10, 12, 14]) +% lo.shuffle(hi, [1, 3, 5, 7, 9, 11, 13, 15])
}
#[inline(always)]
fn pairs_i16(a: i16x8) -> i32x4 {
    let lo = a.widen_low();
    let hi = a.widen_high();
    lo.shuffle(hi, [0, 2, 4, 6]) +% lo.shuffle(hi, [1, 3, 5, 7])
}
#[inline(always)]
fn pairs_u16(a: u16x8) -> u32x4 {
    let lo = a.widen_low();
    let hi = a.widen_high();
    lo.shuffle(hi, [0, 2, 4, 6]) +% lo.shuffle(hi, [1, 3, 5, 7])
}
#[inline(always)]
fn dot_s(a: i16x8, b: i16x8) -> i32x4 {
    let p = a.widen_low() *% b.widen_low();
    let q = a.widen_high() *% b.widen_high();
    p.shuffle(q, [0, 2, 4, 6]) +% p.shuffle(q, [1, 3, 5, 7])
}
/// (a * b + 0x4000) >> 15 per lane, saturated (only -32768 * -32768 needs it).
#[inline(always)]
fn q15mulr(a: i16x8, b: i16x8) -> i16x8 {
    let r = i32x4.splat(0x4000);
    let lo = ((a.widen_low() *% b.widen_low()) +% r) >> 15;
    let hi = ((a.widen_high() *% b.widen_high()) +% r) >> 15;
    i16x8.narrow_sat(lo, hi)
}

/// `cache` used as a 64-bit immediate after CONST64.
#[profile("wasm.vmprofile")]
pub vm W {
    context ctx: *Machine;
    state { pc: *u64, regs: *u64, fp: *Frame, mem: *u8, msize: u64 }
    verify_context f: *Func, inst: *Inst;

    // A slot, read and written as each wasm type. The six kinds are views
    // of one slot (they differ only in the type they cast to), so the
    // `#[forward]` supers below link across them (I32_ADDK's `d: ri` to
    // F64_LOAD's `a: ru`, F64_ADD's `d: rd` to F64_STORE's `v: rq`).
    operand ri = *((regs + it) as *i32) verify it < (f.nslots as u64) display "r{}";
    operand ru = *((regs + it) as *u32) verify it < (f.nslots as u64) display "r{}";
    operand rl = *((regs + it) as *i64) verify it < (f.nslots as u64) display "r{}";
    operand rq = *((regs + it) as *u64) verify it < (f.nslots as u64) display "r{}";
    operand rf = *((regs + it) as *f32) verify it < (f.nslots as u64) display "r{}";
    operand rd = *((regs + it) as *f64) verify it < (f.nslots as u64) display "r{}";
    operand imm = it;
    // A v128 takes two consecutive slots (`it` and `it + 1`), read and
    // written as each vector type. Vector loads and stores assume no
    // alignment, so the 8-byte slots are fine.
    operand vb = *((regs + it) as *i8x16) verify it + 1 < (f.nslots as u64) display "r{}";
    operand vub = *((regs + it) as *u8x16) verify it + 1 < (f.nslots as u64) display "r{}";
    operand vh = *((regs + it) as *i16x8) verify it + 1 < (f.nslots as u64) display "r{}";
    operand vuh = *((regs + it) as *u16x8) verify it + 1 < (f.nslots as u64) display "r{}";
    operand vi = *((regs + it) as *i32x4) verify it + 1 < (f.nslots as u64) display "r{}";
    operand vui = *((regs + it) as *u32x4) verify it + 1 < (f.nslots as u64) display "r{}";
    operand vl = *((regs + it) as *i64x2) verify it + 1 < (f.nslots as u64) display "r{}";
    operand vul = *((regs + it) as *u64x2) verify it + 1 < (f.nslots as u64) display "r{}";
    operand vf = *((regs + it) as *f32x4) verify it + 1 < (f.nslots as u64) display "r{}";
    operand vd = *((regs + it) as *f64x2) verify it + 1 < (f.nslots as u64) display "r{}";
    // Lane indices from the code (`lane_at`/`with_lane_at` take them at
    // run time).
    operand l16 = it verify it < 16;
    operand l8 = it verify it < 8;
    operand l4 = it verify it < 4;
    operand l2 = it verify it < 2;
    // The end of an access of 1..16 bytes: its offset plus its size
    // (compile.lm), so the bounds check is one compare and the address
    // a displacement (`mem + top - size`); at least the size, so the
    // access starts at or after `mem`.
    operand e1 = it verify it >= 1;
    operand e2 = it verify it >= 2;
    operand e4 = it verify it >= 4;
    operand e8 = it verify it >= 8;
    operand e16 = it verify it >= 16;
    // wasm3's r0 and fp0: a value that one op computes and the next alone
    // consumes stays in a register (the `accumulate` ops, `W.accumulate`
    // in compile.lm).
    accumulator iacc: u64 for ri, ru, rl, rq;
    accumulator facc: f64 for rd;
    // The ops that get variants (each variant is an opcode and a handler:
    // marking every op would about double the vm's code). The ones
    // executed by the benchmarks,
    // and their neighbours in the tables (`A..B`: the ops declared from A
    // to B; `BR_I32_*`: every op whose name matches).
    accumulate
        I32_ADD..I32_ROTL, I32_EQ..I32_LT_U, I64_ADD..I64_SHL, I64_SHR_U,
        F64_ADD..F64_DIV, F64_LT, F64_LE,
        I32_ADDK..I32_SHR_UK, I64_ADDK, I64_ANDK, I64_SHLK, I64_SHR_UK,
        I32_EQZ, I32_CLZ, F64_SQRT, F64_NEG, F64_ABS, F64_CONVERT_I32_S, F64_CONVERT_I32_U,
        I32_WRAP_I64..I64_EXTEND_I32_U, I32_DIV_U, I32_REM_U,
        I32_LOAD, I64_LOAD, F64_LOAD, I32_LOAD8_S..I32_LOAD16_U,
        I32_STORE, I64_STORE, F64_STORE, I32_STORE8, I32_STORE16,
        I32_LOADK, I64_LOADK, F64_LOADK, I32_LOAD8_SK..I32_LOAD16_UK,
        I32_STOREK, I64_STOREK, F64_STOREK, I32_STORE8K, I32_STORE16K,
        BR_I32_*, BR_F64_LT..BR_F64_GE, BRZ, BRNZ,
        I32_LOAD_TK, I64_LOAD_TK, F64_LOAD_TK, I32_LOAD8_U_TK, I32_LOAD16_U_TK,
        I32_LOAD_R..I64_LOAD_TR, F64_LOAD_R, F64_LOAD_TR, I32_LOAD8_U_R, I32_LOAD8_U_TR,
        I32_LOAD16_U_R, I32_LOAD16_U_TR;
    operand label = pc + it verify is_insn_boundary(pc + it);
    // The base of a callee's window: anywhere in the frame.
    operand base = it verify it <= (f.nslots as u64) display "r{}";
    operand fidx = it verify it < inst.funcs.len display "f{}";
    operand gidx = it verify it < inst.globals.len display "g{}";
    operand tidx = it verify it < inst.sigs.len display "t{}";

    encoding fixed(u64) {
        format RRR { op: 16, a: 16, b: 16, c: 16 }
        format RI  { op: 16, a: 16, imm: s32 }
        format RU  { op: 16, a: 16, x: 32 }
        format J   { op: 16, off: s32 }
        format RRK { op: 16, a: 16, b: 16, k: s16 }
        format R4  { op: 16, a: 12, b: 12, c: 12, d: 12 }
    }

    // Immediates wider than the word's fields, in `const` cache words:
    // the translator writes them, handlers only read them, and a table
    // index is checked once by the verifier.
    cache Imm64 { const v: u64 }
    cache Imm128 { const lo: u64, const hi: u64 }
    cache TableIx { const ti: u64 verify it < inst.tables.len }

    // ── constants and moves ───────────────────────────────────────────
    op CONST32(d: ru, v: imm) : RU { d = v as u32; next }
    op CONSTL(d: rl, v: imm) : RI { d = v; next }
    op CONST64(d: rq) : RU + Imm64 { d = cache.v; next }
    op MOV(d: rq, a: rq) : RRR { d = a; next }
    op MOV32(d: ru, a: ru) : RRR { d = a; next }
    // select: d = c != 0 ? d : b (d holds the first operand).
    op SELECT(d: rq, b: rq, c: ri) : RRR { if c == 0 { d = b; } next }
    // d = c != 0 ? a : b, for frames whose slots fit 12 bits.
    op SELECT4(d: rq, a: rq, b: rq, c: ri) : R4 { d = if c != 0 { a } else { b }; next }

    // ── i32 and i64 arithmetic ────────────────────────────────────────
    inline for (name, dk, ak, bk, expr) in [
        ("I32_ADD", ri, ri, ri, a +% b), ("I32_SUB", ri, ri, ri, a -% b), ("I32_MUL", ri, ri, ri, a *% b),
        ("I32_AND", ri, ri, ri, a & b), ("I32_OR", ri, ri, ri, a | b), ("I32_XOR", ri, ri, ri, a ^ b),
        ("I32_SHL", ri, ri, ri, a << b), ("I32_SHR_S", ri, ri, ri, a >> b), ("I32_SHR_U", ru, ru, ru, a >> b),
        ("I32_ROTL", ru, ru, ru, (a << b) | (a >> (32 - (b & 31)))),
        ("I32_ROTR", ru, ru, ru, (a >> b) | (a << (32 - (b & 31)))),
        ("I32_EQ", ri, ri, ri, b2i(a == b)), ("I32_NE", ri, ri, ri, b2i(a != b)),
        ("I32_LT_S", ri, ri, ri, b2i(a < b)), ("I32_LT_U", ri, ru, ru, b2i(a < b)),
        ("I32_GT_S", ri, ri, ri, b2i(a > b)), ("I32_GT_U", ri, ru, ru, b2i(a > b)),
        ("I32_LE_S", ri, ri, ri, b2i(a <= b)), ("I32_LE_U", ri, ru, ru, b2i(a <= b)),
        ("I32_GE_S", ri, ri, ri, b2i(a >= b)), ("I32_GE_U", ri, ru, ru, b2i(a >= b)),
        ("I64_ADD", rl, rl, rl, a +% b), ("I64_SUB", rl, rl, rl, a -% b), ("I64_MUL", rl, rl, rl, a *% b),
        ("I64_AND", rl, rl, rl, a & b), ("I64_OR", rl, rl, rl, a | b), ("I64_XOR", rl, rl, rl, a ^ b),
        ("I64_SHL", rl, rl, rl, a << b), ("I64_SHR_S", rl, rl, rl, a >> b), ("I64_SHR_U", rq, rq, rq, a >> b),
        ("I64_ROTL", rq, rq, rq, (a << b) | (a >> (64 - (b & 63)))),
        ("I64_ROTR", rq, rq, rq, (a >> b) | (a << (64 - (b & 63)))),
        ("I64_EQ", ri, rl, rl, b2i(a == b)), ("I64_NE", ri, rl, rl, b2i(a != b)),
        ("I64_LT_S", ri, rl, rl, b2i(a < b)), ("I64_LT_U", ri, rq, rq, b2i(a < b)),
        ("I64_GT_S", ri, rl, rl, b2i(a > b)), ("I64_GT_U", ri, rq, rq, b2i(a > b)),
        ("I64_LE_S", ri, rl, rl, b2i(a <= b)), ("I64_LE_U", ri, rq, rq, b2i(a <= b)),
        ("I64_GE_S", ri, rl, rl, b2i(a >= b)), ("I64_GE_U", ri, rq, rq, b2i(a >= b)),
        // floats
        ("F32_ADD", rf, rf, rf, a + b), ("F32_SUB", rf, rf, rf, a - b),
        ("F32_MUL", rf, rf, rf, a * b), ("F32_DIV", rf, rf, rf, a / b),
        ("F32_MIN", rf, rf, rf, a.minimum(b)), ("F32_MAX", rf, rf, rf, a.maximum(b)),
        ("F32_COPYSIGN", rf, rf, rf, a.copysign(b)),
        ("F32_EQ", ri, rf, rf, b2i(a == b)), ("F32_NE", ri, rf, rf, b2i(a != b)),
        ("F32_LT", ri, rf, rf, b2i(a < b)), ("F32_GT", ri, rf, rf, b2i(a > b)),
        ("F32_LE", ri, rf, rf, b2i(a <= b)), ("F32_GE", ri, rf, rf, b2i(a >= b)),
        ("F64_ADD", rd, rd, rd, a + b), ("F64_SUB", rd, rd, rd, a - b),
        ("F64_MUL", rd, rd, rd, a * b), ("F64_DIV", rd, rd, rd, a / b),
        ("F64_MIN", rd, rd, rd, a.minimum(b)), ("F64_MAX", rd, rd, rd, a.maximum(b)),
        ("F64_COPYSIGN", rd, rd, rd, a.copysign(b)),
        ("F64_EQ", ri, rd, rd, b2i(a == b)), ("F64_NE", ri, rd, rd, b2i(a != b)),
        ("F64_LT", ri, rd, rd, b2i(a < b)), ("F64_GT", ri, rd, rd, b2i(a > b)),
        ("F64_LE", ri, rd, rd, b2i(a <= b)), ("F64_GE", ri, rd, rd, b2i(a >= b)),
    ] {
        op #name(d: dk, a: ak, b: bk) : RRR { d = expr; next }
    }

    // Constant right operands (a 16-bit immediate, sign-extended): the K
    // form of each op, `W.kform(op)` (compile.lm), and whether a constant
    // left operand may use it too (`W.commutative(op)`). x - k is x + -k.
    data commutative: bool = false;
    inline for (name, dk, ak, cm, expr) in [
        ("I32_ADD", ri, ri, true, a +% (k as i32)), ("I32_MUL", ri, ri, true, a *% (k as i32)),
        ("I32_AND", ri, ri, true, a & (k as i32)), ("I32_OR", ri, ri, true, a | (k as i32)),
        ("I32_XOR", ri, ri, true, a ^ (k as i32)),
        ("I32_SHL", ri, ri, false, a << k), ("I32_SHR_S", ri, ri, false, a >> k), ("I32_SHR_U", ru, ru, false, a >> k),
        ("I32_EQ", ri, ri, true, b2i(a == (k as i32))), ("I32_NE", ri, ri, true, b2i(a != (k as i32))),
        ("I32_LT_S", ri, ri, false, b2i(a < (k as i32))), ("I32_LT_U", ri, ru, false, b2i(a < (k as u32))),
        ("I32_GT_S", ri, ri, false, b2i(a > (k as i32))), ("I32_GT_U", ri, ru, false, b2i(a > (k as u32))),
        ("I32_LE_S", ri, ri, false, b2i(a <= (k as i32))), ("I32_LE_U", ri, ru, false, b2i(a <= (k as u32))),
        ("I32_GE_S", ri, ri, false, b2i(a >= (k as i32))), ("I32_GE_U", ri, ru, false, b2i(a >= (k as u32))),
        ("I64_ADD", rl, rl, true, a +% k), ("I64_MUL", rl, rl, true, a *% k),
        ("I64_AND", rl, rl, true, a & k), ("I64_OR", rl, rl, true, a | k), ("I64_XOR", rl, rl, true, a ^ k),
        ("I64_SHL", rl, rl, false, a << k), ("I64_SHR_S", rl, rl, false, a >> k), ("I64_SHR_U", rq, rq, false, a >> k),
        ("I64_EQ", ri, rl, true, b2i(a == k)), ("I64_NE", ri, rl, true, b2i(a != k)),
        ("I64_LT_S", ri, rl, false, b2i(a < k)), ("I64_LT_U", ri, rq, false, b2i(a < (k as u64))),
        ("I64_GT_S", ri, rl, false, b2i(a > k)), ("I64_GT_U", ri, rq, false, b2i(a > (k as u64))),
        ("I64_LE_S", ri, rl, false, b2i(a <= k)), ("I64_LE_U", ri, rq, false, b2i(a <= (k as u64))),
        ("I64_GE_S", ri, rl, false, b2i(a >= k)), ("I64_GE_U", ri, rq, false, b2i(a >= (k as u64))),
    ] {
        op #(name ++ "K")(d: dk, a: ak, k: imm) : RRK { d = expr; next }
        rel kform(#name) = #(name ++ "K");
        data commutative(#name) = cm;
    }
    rel kform(I32_SUB) = I32_ADDK;
    rel kform(I64_SUB) = I64_ADDK;

    // Division: traps on a zero divisor and on MIN / -1; x rem -1 is 0.
    inline for (name, k, min) in [("I32_DIV_S", ri, (-2147483647 - 1)), ("I64_DIV_S", rl, (-9223372036854775807 - 1))] {
        op #name(d: k, a: k, b: k) : RRR {
            if b == 0 { raise Trap.DivZero }
            if b == -1 and a == min { raise Trap.IntOverflow }
            d = a / b;
            next
        }
    }
    inline for (name, k) in [("I32_REM_S", ri), ("I64_REM_S", rl)] {
        op #name(d: k, a: k, b: k) : RRR {
            if b == 0 { raise Trap.DivZero }
            if b == -1 { d = 0; next }
            d = a % b;
            next
        }
    }
    inline for (name, k, expr) in [
        ("I32_DIV_U", ru, a / b), ("I32_REM_U", ru, a % b),
        ("I64_DIV_U", rq, a / b), ("I64_REM_U", rq, a % b),
    ] {
        op #name(d: k, a: k, b: k) : RRR {
            if b == 0 { raise Trap.DivZero }
            d = expr; next
        }
    }

    // ── unary ops and conversions ─────────────────────────────────────
    inline for (name, dk, ak, expr) in [
        ("I32_EQZ", ri, ri, b2i(a == 0)), ("I64_EQZ", ri, rl, b2i(a == 0)),
        ("I32_CLZ", ri, ru, a.clz() as i32), ("I32_CTZ", ri, ru, a.ctz() as i32),
        ("I32_POPCNT", ri, ru, a.popcount() as i32),
        ("I64_CLZ", rl, rq, a.clz() as i64), ("I64_CTZ", rl, rq, a.ctz() as i64),
        ("I64_POPCNT", rl, rq, a.popcount() as i64),
        ("F32_ABS", rf, rf, a.abs()), ("F32_NEG", ru, ru, a ^ 0x80000000),
        ("F64_ABS", rd, rd, a.abs()), ("F64_NEG", rd, rd, -a),
        ("F32_SQRT", rf, rf, a.sqrt()), ("F32_CEIL", rf, rf, a.ceil()), ("F32_FLOOR", rf, rf, a.floor()),
        ("F32_TRUNC", rf, rf, a.trunc()), ("F32_NEAREST", rf, rf, a.nearest()),
        ("F64_SQRT", rd, rd, a.sqrt()), ("F64_CEIL", rd, rd, a.ceil()), ("F64_FLOOR", rd, rd, a.floor()),
        ("F64_TRUNC", rd, rd, a.trunc()), ("F64_NEAREST", rd, rd, a.nearest()),
        ("I32_WRAP_I64", ri, rl, a as i32),
        ("I64_EXTEND_I32_S", rl, ri, a as i64), ("I64_EXTEND_I32_U", rl, ru, a as i64),
        ("F32_CONVERT_I32_S", rf, ri, a as f32), ("F32_CONVERT_I32_U", rf, ru, a as f32),
        ("F32_CONVERT_I64_S", rf, rl, a as f32), ("F32_CONVERT_I64_U", rf, rq, a as f32),
        ("F64_CONVERT_I32_S", rd, ri, a as f64), ("F64_CONVERT_I32_U", rd, ru, a as f64),
        ("F64_CONVERT_I64_S", rd, rl, a as f64), ("F64_CONVERT_I64_U", rd, rq, a as f64),
        ("F32_DEMOTE_F64", rf, rd, a as f32), ("F64_PROMOTE_F32", rd, rf, a as f64),
        ("I32_EXTEND8_S", ri, ri, (a as i8) as i32), ("I32_EXTEND16_S", ri, ri, (a as i16) as i32),
        ("I64_EXTEND8_S", rl, rl, (a as i8) as i64), ("I64_EXTEND16_S", rl, rl, (a as i16) as i64),
        ("I64_EXTEND32_S", rl, rl, (a as i32) as i64),
        ("I32_TRUNC_SAT_F32_S", ri, rf, sat_i32(a as f64)), ("I32_TRUNC_SAT_F32_U", ru, rf, sat_u32(a as f64)),
        ("I32_TRUNC_SAT_F64_S", ri, rd, sat_i32(a)), ("I32_TRUNC_SAT_F64_U", ru, rd, sat_u32(a)),
        ("I64_TRUNC_SAT_F32_S", rl, rf, sat_i64(a as f64)), ("I64_TRUNC_SAT_F32_U", rq, rf, sat_u64(a as f64)),
        ("I64_TRUNC_SAT_F64_S", rl, rd, sat_i64(a)), ("I64_TRUNC_SAT_F64_U", rq, rd, sat_u64(a)),
    ] {
        op #name(d: dk, a: ak) : RRR { d = expr; next }
    }

    // Trapping float-to-int truncation: `lo < x < hi` must hold (the
    // bounds are exact in f64 for every case).
    inline for (name, dk, ak, lo, hi, ty) in [
        ("I32_TRUNC_F32_S", ri, rf, -2147483649.0, 2147483648.0, i32),
        ("I32_TRUNC_F32_U", ru, rf, -1.0, 4294967296.0, u32),
        ("I32_TRUNC_F64_S", ri, rd, -2147483649.0, 2147483648.0, i32),
        ("I32_TRUNC_F64_U", ru, rd, -1.0, 4294967296.0, u32),
        ("I64_TRUNC_F32_S", rl, rf, -9223372036854777856.0, 9223372036854775808.0, i64),
        ("I64_TRUNC_F32_U", rq, rf, -1.0, 18446744073709551616.0, u64),
        ("I64_TRUNC_F64_S", rl, rd, -9223372036854777856.0, 9223372036854775808.0, i64),
        ("I64_TRUNC_F64_U", rq, rd, -1.0, 18446744073709551616.0, u64),
    ] {
        op #name(d: dk, a: ak) : RRR {
            let x = a as f64;
            if x > lo and x < hi { d = x as ty; next }
            cold {
                if x != x { raise Trap.InvalidConv }
                raise Trap.IntOverflow
            }
        }
    }

    // ── memory ────────────────────────────────────────────────────────
    // d = load(a + offset): the end of the access (`end`: offset plus size,
    // in the code) is computed in 64 bits, so it cannot wrap, and checked
    // against the memory's size. Guest addresses need not be aligned:
    // `read_unaligned` (LLVM `align 1`).
    inline for (name, dk, ty, conv, size, ek) in [
        ("I32_LOAD", ri, i32, x, 4, e4), ("I64_LOAD", rl, i64, x, 8, e8),
        ("F32_LOAD", rf, f32, x, 4, e4), ("F64_LOAD", rd, f64, x, 8, e8),
        ("I32_LOAD8_S", ri, i8, x as i32, 1, e1), ("I32_LOAD8_U", ri, u8, x as i32, 1, e1),
        ("I32_LOAD16_S", ri, i16, x as i32, 2, e2), ("I32_LOAD16_U", ri, u16, x as i32, 2, e2),
        ("I64_LOAD8_S", rl, i8, x as i64, 1, e1), ("I64_LOAD8_U", rl, u8, x as i64, 1, e1),
        ("I64_LOAD16_S", rl, i16, x as i64, 2, e2), ("I64_LOAD16_U", rl, u16, x as i64, 2, e2),
        ("I64_LOAD32_S", rl, i32, x as i64, 4, e4), ("I64_LOAD32_U", rl, u32, x as i64, 4, e4),
    ] {
        op #name(d: dk, a: ru, end: ek) : RRR {
            let top = (a as u64) + end;
            if top > msize { raise Trap.MemOOB }
            let x = ((mem + top - size) as *ty).read_unaligned();
            d = conv;
            next
        }
    }
    inline for (name, vk, ty, conv, size, ek) in [
        ("I32_STORE", ri, i32, v, 4, e4), ("I64_STORE", rl, i64, v, 8, e8),
        ("F32_STORE", ru, u32, v, 4, e4), ("F64_STORE", rd, f64, v, 8, e8),
        ("I32_STORE8", ri, u8, v as u8, 1, e1), ("I32_STORE16", ri, u16, v as u16, 2, e2),
        ("I64_STORE8", rl, u8, v as u8, 1, e1), ("I64_STORE16", rl, u16, v as u16, 2, e2),
        ("I64_STORE32", rl, u32, v as u32, 4, e4),
    ] {
        op #name(a: ru, v: vk, end: ek) : RRR {
            let top = (a as u64) + end;
            if top > msize { raise Trap.MemOOB }
            ((mem + top - size) as *ty).write_unaligned(conv);
            next
        }
    }
    // An offset that does not fit 16 bits: add it first, in 64 bits.
    // d (a scratch slot) = a + off, read by the access as a 64-bit address.
    op ADDR(d: rq, a: ru) : RRR + Imm64 { d = (a as u64) + cache.v; next }
    inline for (name, dk, ty, conv, size) in [
        ("I32_LOAD", ri, i32, x, 4), ("I64_LOAD", rl, i64, x, 8),
        ("F32_LOAD", rf, f32, x, 4), ("F64_LOAD", rd, f64, x, 8),
        ("I32_LOAD8_S", ri, i8, x as i32, 1), ("I32_LOAD8_U", ri, u8, x as i32, 1),
        ("I32_LOAD16_S", ri, i16, x as i32, 2), ("I32_LOAD16_U", ri, u16, x as i32, 2),
        ("I64_LOAD8_S", rl, i8, x as i64, 1), ("I64_LOAD8_U", rl, u8, x as i64, 1),
        ("I64_LOAD16_S", rl, i16, x as i64, 2), ("I64_LOAD16_U", rl, u16, x as i64, 2),
        ("I64_LOAD32_S", rl, i32, x as i64, 4), ("I64_LOAD32_U", rl, u32, x as i64, 4),
    ] {
        op #(name ++ "_X")(d: dk, a: rq) : RRR {
            let ea = a;
            if ea + size > msize { raise Trap.MemOOB }
            let x = ((mem + ea) as *ty).read_unaligned();
            d = conv;
            next
        }
        rel xform(#name) = #(name ++ "_X");
    }
    inline for (name, vk, ty, conv, size) in [
        ("I32_STORE", ri, i32, v, 4), ("I64_STORE", rl, i64, v, 8),
        ("F32_STORE", ru, u32, v, 4), ("F64_STORE", rq, u64, v, 8),
        ("I32_STORE8", ri, u8, v as u8, 1), ("I32_STORE16", ri, u16, v as u16, 2),
        ("I64_STORE8", rl, u8, v as u8, 1), ("I64_STORE16", rl, u16, v as u16, 2),
        ("I64_STORE32", rl, u32, v as u32, 4),
    ] {
        op #(name ++ "_X")(a: rq, v: vk) : RRR {
            let ea = a;
            if ea + size > msize { raise Trap.MemOOB }
            ((mem + ea) as *ty).write_unaligned(conv);
            next
        }
        rel xform(#name) = #(name ++ "_X");
    }

    op MEM_SIZE(d: ri) : RRR { d = (msize >> 16) as i32; next }
    op MEM_GROW(d: ri, n: ru) : RRR {
        d = grow_memory(ctx, n);
        mem = ctx.memory.data; msize = ctx.mem_size;
        next
    }
    op MEM_FILL(dst: ru, v: ri, n: ru) : RRR {
        if (dst as u64) + (n as u64) > msize { raise Trap.MemOOB }
        memset(mem + (dst as u64), v, n as u64);
        next
    }
    op MEM_COPY(dst: ru, src: ru, n: ru) : RRR {
        if (dst as u64) + (n as u64) > msize or (src as u64) + (n as u64) > msize {
            raise Trap.MemOOB
        }
        memmove(mem + (dst as u64), mem + (src as u64), n as u64);
        next
    }

    // ── globals ───────────────────────────────────────────────────────
    op GLOBAL_GET(d: rq, g: gidx) : RU { d = *ctx.globals[g]; next }
    op GLOBAL_SET(a: rq, g: gidx) : RU { *ctx.globals[g] = a; next }

    // ── control ───────────────────────────────────────────────────────
    op JMP(t: label) : J { jump t }
    op BRZ(a: ri, t: label) : RI { if a == 0 { jump t } next }
    op BRNZ(a: ri, t: label) : RI { if a != 0 { jump t } next }
    // Compare and branch: a fused compare and br_if/if. The JMP after it
    // holds the target (`then JMP`): taken if the comparison holds. A
    // compare followed by a branch fuses into the op that branches if it
    // holds, `W.br(cmp)`, or into the one that branches if it does not,
    // `W.br_not(cmp)` (compile.lm); each row names its two compares (`_`:
    // none).
    inline for (name, k, test, of, not_of) in [
        ("BR_I32_EQ", ri, a == b, I32_EQ, I32_NE), ("BR_I32_NE", ri, a != b, I32_NE, I32_EQ),
        ("BR_I32_LT_S", ri, a < b, I32_LT_S, I32_GE_S), ("BR_I32_LT_U", ru, a < b, I32_LT_U, I32_GE_U),
        ("BR_I32_GT_S", ri, a > b, I32_GT_S, I32_LE_S), ("BR_I32_GT_U", ru, a > b, I32_GT_U, I32_LE_U),
        ("BR_I32_LE_S", ri, a <= b, I32_LE_S, I32_GT_S), ("BR_I32_LE_U", ru, a <= b, I32_LE_U, I32_GT_U),
        ("BR_I32_GE_S", ri, a >= b, I32_GE_S, I32_LT_S), ("BR_I32_GE_U", ru, a >= b, I32_GE_U, I32_LT_U),
        ("BR_I64_EQ", rl, a == b, I64_EQ, I64_NE), ("BR_I64_NE", rl, a != b, I64_NE, I64_EQ),
        ("BR_I64_LT_S", rl, a < b, I64_LT_S, I64_GE_S), ("BR_I64_LT_U", rq, a < b, I64_LT_U, I64_GE_U),
        ("BR_I64_GT_S", rl, a > b, I64_GT_S, I64_LE_S), ("BR_I64_GT_U", rq, a > b, I64_GT_U, I64_LE_U),
        ("BR_I64_LE_S", rl, a <= b, I64_LE_S, I64_GT_S), ("BR_I64_LE_U", rq, a <= b, I64_LE_U, I64_GT_U),
        ("BR_I64_GE_S", rl, a >= b, I64_GE_S, I64_LT_S), ("BR_I64_GE_U", rq, a >= b, I64_GE_U, I64_LT_U),
        // floats: the negated forms are separate ops (NaN compares false)
        ("BR_F32_EQ", rf, a == b, F32_EQ, F32_NE), ("BR_F32_NE", rf, a != b, F32_NE, F32_EQ),
        ("BR_F32_LT", rf, a < b, F32_LT, _), ("BR_F32_GT", rf, a > b, F32_GT, _),
        ("BR_F32_LE", rf, a <= b, F32_LE, _), ("BR_F32_GE", rf, a >= b, F32_GE, _),
        ("BR_F32_NLT", rf, !(a < b), _, F32_LT), ("BR_F32_NGT", rf, !(a > b), _, F32_GT),
        ("BR_F32_NLE", rf, !(a <= b), _, F32_LE), ("BR_F32_NGE", rf, !(a >= b), _, F32_GE),
        ("BR_F64_EQ", rd, a == b, F64_EQ, F64_NE), ("BR_F64_NE", rd, a != b, F64_NE, F64_EQ),
        ("BR_F64_LT", rd, a < b, F64_LT, _), ("BR_F64_GT", rd, a > b, F64_GT, _),
        ("BR_F64_LE", rd, a <= b, F64_LE, _), ("BR_F64_GE", rd, a >= b, F64_GE, _),
        ("BR_F64_NLT", rd, !(a < b), _, F64_LT), ("BR_F64_NGT", rd, !(a > b), _, F64_GT),
        ("BR_F64_NLE", rd, !(a <= b), _, F64_LE), ("BR_F64_NGE", rd, !(a >= b), _, F64_GE),
    ] {
        op #name(a: k, b: k) : RRR then JMP {
            if test { jump then.t }
            jump pc + 2
        }
        rel br(#of) = #name;
        rel br_not(#not_of) = #name;
    }
    // The same for the K compares (`W.brk`, `W.brk_not`).
    inline for (cmp, not_cmp, k, test) in [
        ("I32_EQK", I32_NEK, ri, a == (c as i32)), ("I32_NEK", I32_EQK, ri, a != (c as i32)),
        ("I32_LT_SK", I32_GE_SK, ri, a < (c as i32)), ("I32_LT_UK", I32_GE_UK, ru, a < (c as u32)),
        ("I32_GT_SK", I32_LE_SK, ri, a > (c as i32)), ("I32_GT_UK", I32_LE_UK, ru, a > (c as u32)),
        ("I32_LE_SK", I32_GT_SK, ri, a <= (c as i32)), ("I32_LE_UK", I32_GT_UK, ru, a <= (c as u32)),
        ("I32_GE_SK", I32_LT_SK, ri, a >= (c as i32)), ("I32_GE_UK", I32_LT_UK, ru, a >= (c as u32)),
        ("I64_EQK", I64_NEK, rl, a == c), ("I64_NEK", I64_EQK, rl, a != c),
        ("I64_LT_SK", I64_GE_SK, rl, a < c), ("I64_LT_UK", I64_GE_UK, rq, a < (c as u64)),
        ("I64_GT_SK", I64_LE_SK, rl, a > c), ("I64_GT_UK", I64_LE_UK, rq, a > (c as u64)),
        ("I64_LE_SK", I64_GT_SK, rl, a <= c), ("I64_LE_UK", I64_GT_UK, rq, a <= (c as u64)),
        ("I64_GE_SK", I64_LT_SK, rl, a >= c), ("I64_GE_UK", I64_LT_UK, rq, a >= (c as u64)),
    ] {
        op #("BR_" ++ cmp)(a: k, c: imm) : RI then JMP {
            if test { jump then.t }
            jump pc + 2
        }
        rel brk(#cmp) = #("BR_" ++ cmp);
        rel brk_not(not_cmp) = #("BR_" ++ cmp);
    }
    // Followed by n + 1 JMPs (checked by `verify brtable` below).
    op BR_TABLE(a: ru, n: imm) : RU {
        let i = if (a as u64) < n { a as u64 } else { n };
        jump pc + 1 + i
    }
    op UNREACHABLE() : RRR { raise Trap.Unreachable }

    // The caller continues at `next_pc`, after the calling op whatever
    // its size (CALL_INDIRECT_X has a cache word).
    // `local`: f is a function of the running instance (a direct call
    // of one the module defines), so neither a host function nor another
    // instance's.
    fn do_call(f: *Func, b: u64, local: bool) -> never {
        if !local and (f.inst != ctx.inst or f.host.is_some()) { cold { call_slow(f, b) } }
        let nr = regs + b;
        if nr + (f.nslots as u64) > ctx.stack_end or fp + 2 >= ctx.frames_end {
            raise Trap.Exhausted
        }
        // Zero the non-parameter locals. (The loop stays a loop: LLVM does
        // not turn loops in handlers into memset calls, which would give
        // CALL a stack frame.)
        var i = f.nparams as u64;
        let z = f.nzero as u64;
        while i < z { nr[i] = 0; i += 1; }
        let n = f.nlocals as u64;
        // Constant slots (the pointer read once: the stores could alias f).
        let ks = f.consts;
        let nk = f.nconsts as u64;
        var j: u64 = 0;
        while j < nk { nr[n + j] = ks[j]; j += 1; }
        fp = fp + 1;
        fp.ret = next_pc;
        fp.regs = regs;
        regs = nr;
        jump f.code
    }

    // Calls of host functions and of functions of other instances.
    fn call_slow(f: *Func, b: u64) -> never {
        let nr = regs + b;
        if let Some(h) = f.host {
            if !h(ctx, nr) { raise ctx.host_trap }
            next
        }
        if nr + (f.nslots as u64) > ctx.stack_end or fp + 3 >= ctx.frames_end {
            raise Trap.Exhausted
        }
        var i = f.nparams as u64;
        let z = f.nzero as u64;
        while i < z { nr[i] = 0; i += 1; }
        let n = f.nlocals as u64;
        // Constant slots (the pointer read once: the stores could alias f).
        let ks = f.consts;
        let nk = f.nconsts as u64;
        var j: u64 = 0;
        while j < nk { nr[n + j] = ks[j]; j += 1; }
        // A record that RESTORE pops: the caller's instance and return.
        fp = fp + 1;
        fp.ret = next_pc;
        fp.regs = regs;
        fp.inst = ctx.inst;
        fp = fp + 1;
        fp.ret = ctx.restore_pc;
        fp.regs = regs;
        regs = nr;
        ctx.switch_to(f.inst);
        mem = ctx.memory.data; msize = ctx.mem_size;
        jump f.code
    }

    op CALL(b: base, fi: fidx) : RU { do_call(ctx.funcs[fi], b.raw, false) }

    op CALL_INDIRECT(b: base, t: tidx, i: ru) : RRR {
        let tab = ctx.table;
        if (i as u64) >= tab.size { raise Trap.UndefElem }
        let fv = tab.elems[i as u64];
        if fv == 0 { raise Trap.UninitElem }
        let f = fv as *Func;
        if f.sig != ctx.sigs[t.raw] { raise Trap.SigMismatch }
        do_call(f, b.raw, false)
    }
    // call_indirect through a table other than 0: the table index in the
    // cache word, checked by the verifier (`ctx.inst` is the instance the
    // code was verified against).
    op CALL_INDIRECT_X(b: base, t: tidx, i: ru) : RRR + TableIx {
        let tab = ctx.inst.tables.ptr[cache.ti];
        if (i as u64) >= tab.size { raise Trap.UndefElem }
        let fv = tab.elems[i as u64];
        if fv == 0 { raise Trap.UninitElem }
        let f = fv as *Func;
        if f.sig != ctx.sigs[t.raw] { raise Trap.SigMismatch }
        do_call(f, b.raw, false)
    }

    // ── reference types and bulk memory ─────────────────────────────
    op REF_IS_NULL(d: ri, a: rq) : RRR { d = b2i(a == 0); next }
    op REF_FUNC(d: rq, fi: fidx) : RU { d = ctx.funcs[fi] as u64; next }
    // Rare ops: indices (table, segment) in the cache word, operands in
    // slots; a plain function does the work and checks every bound.
    inline for (name, which) in [
        ("TABLE_GET", 0), ("TABLE_SET", 1), ("TABLE_SIZE", 2), ("TABLE_GROW", 3), ("TABLE_FILL", 4),
        ("TABLE_COPY", 5), ("TABLE_INIT", 6), ("ELEM_DROP", 7), ("MEM_INIT", 8), ("DATA_DROP", 9),
    ] {
        op #name(a: rq, b: rq, c: rq) : RRR + Imm64 {
            if !bulk(ctx, which, regs, a.raw, b.raw, c.raw, cache.v) { raise ctx.host_trap }
            next
        }
    }

    op RET() : J {
        regs = fp.regs;
        let r = fp.ret;
        fp = fp - 1;
        jump r
    }
    op RET1(a: rq) : RRR {
        regs[0] = a;
        regs = fp.regs;
        let r = fp.ret;
        fp = fp - 1;
        jump r
    }
    // Back from another instance's function (see call_slow).
    op RESTORE() : J {
        ctx.switch_to(fp.inst);
        mem = ctx.memory.data; msize = ctx.mem_size;
        regs = fp.regs;
        let r = fp.ret;
        fp = fp - 1;
        jump r
    }
    op HALT() : J { exit Ok(()) }

    // ── SIMD ──────────────────────────────────────────────────────────
    // v128 values take two slots; the vector operand kinds view them as
    // each lane type. Lane-wise arithmetic is Loimi's vector operators
    // and methods; ops with a lane index from the code go through memory.
    op CONSTV(d: vul) : RU + Imm128 { d = u64x2.new(cache.lo, cache.hi); next }
    op MOVV(d: vul, a: vul) : RRR { d = a; next }
    // select: d = c != 0 ? d : b (d holds the first operand).
    op SELECTV(d: vul, b: vul, c: ri) : RRR { if c == 0 { d = b; } next }
    // bitselect: d = (d & c) | (b & ~c) (d holds the first operand).
    op V128_BITSELECT(d: vul, b: vul, c: vul) : RRR { d = (d & c) | (b & ~c); next }
    op GLOBAL_GETV(d: vul, g: gidx) : RU { d = *(ctx.globals[g] as *u64x2); next }
    op GLOBAL_SETV(a: vul, g: gidx) : RU { *(ctx.globals[g] as *u64x2) = a; next }
    op RETV(a: vul) : RRR {
        *(regs as *u64x2) = a;
        regs = fp.regs;
        let r = fp.ret;
        fp = fp - 1;
        jump r
    }

    inline for (name, dk, ak, bk, expr) in [
        ("V128_AND", vul, vul, vul, a & b), ("V128_ANDNOT", vul, vul, vul, a & ~b),
        ("V128_OR", vul, vul, vul, a | b), ("V128_XOR", vul, vul, vul, a ^ b),
        ("I8X16_SWIZZLE", vub, vub, vub, a.swizzle(b)),
        ("I8X16_EQ", vb, vb, vb, a == b), ("I8X16_NE", vb, vb, vb, a != b),
        ("I8X16_LT_S", vb, vb, vb, a < b), ("I8X16_LT_U", vb, vub, vub, a < b),
        ("I8X16_GT_S", vb, vb, vb, a > b), ("I8X16_GT_U", vb, vub, vub, a > b),
        ("I8X16_LE_S", vb, vb, vb, a <= b), ("I8X16_LE_U", vb, vub, vub, a <= b),
        ("I8X16_GE_S", vb, vb, vb, a >= b), ("I8X16_GE_U", vb, vub, vub, a >= b),
        ("I16X8_EQ", vh, vh, vh, a == b), ("I16X8_NE", vh, vh, vh, a != b),
        ("I16X8_LT_S", vh, vh, vh, a < b), ("I16X8_LT_U", vh, vuh, vuh, a < b),
        ("I16X8_GT_S", vh, vh, vh, a > b), ("I16X8_GT_U", vh, vuh, vuh, a > b),
        ("I16X8_LE_S", vh, vh, vh, a <= b), ("I16X8_LE_U", vh, vuh, vuh, a <= b),
        ("I16X8_GE_S", vh, vh, vh, a >= b), ("I16X8_GE_U", vh, vuh, vuh, a >= b),
        ("I32X4_EQ", vi, vi, vi, a == b), ("I32X4_NE", vi, vi, vi, a != b),
        ("I32X4_LT_S", vi, vi, vi, a < b), ("I32X4_LT_U", vi, vui, vui, a < b),
        ("I32X4_GT_S", vi, vi, vi, a > b), ("I32X4_GT_U", vi, vui, vui, a > b),
        ("I32X4_LE_S", vi, vi, vi, a <= b), ("I32X4_LE_U", vi, vui, vui, a <= b),
        ("I32X4_GE_S", vi, vi, vi, a >= b), ("I32X4_GE_U", vi, vui, vui, a >= b),
        ("I64X2_EQ", vl, vl, vl, a == b), ("I64X2_NE", vl, vl, vl, a != b),
        ("I64X2_LT_S", vl, vl, vl, a < b), ("I64X2_GT_S", vl, vl, vl, a > b),
        ("I64X2_LE_S", vl, vl, vl, a <= b), ("I64X2_GE_S", vl, vl, vl, a >= b),
        ("F32X4_EQ", vi, vf, vf, a == b), ("F32X4_NE", vi, vf, vf, a != b),
        ("F32X4_LT", vi, vf, vf, a < b), ("F32X4_GT", vi, vf, vf, a > b),
        ("F32X4_LE", vi, vf, vf, a <= b), ("F32X4_GE", vi, vf, vf, a >= b),
        ("F64X2_EQ", vl, vd, vd, a == b), ("F64X2_NE", vl, vd, vd, a != b),
        ("F64X2_LT", vl, vd, vd, a < b), ("F64X2_GT", vl, vd, vd, a > b),
        ("F64X2_LE", vl, vd, vd, a <= b), ("F64X2_GE", vl, vd, vd, a >= b),
        ("I8X16_NARROW_I16X8_S", vb, vh, vh, i8x16.narrow_sat(a, b)),
        ("I8X16_NARROW_I16X8_U", vub, vh, vh, u8x16.narrow_sat(a, b)),
        ("I16X8_NARROW_I32X4_S", vh, vi, vi, i16x8.narrow_sat(a, b)),
        ("I16X8_NARROW_I32X4_U", vuh, vi, vi, u16x8.narrow_sat(a, b)),
        ("I8X16_ADD", vb, vb, vb, a +% b), ("I8X16_SUB", vb, vb, vb, a -% b),
        ("I8X16_ADD_SAT_S", vb, vb, vb, a.add_sat(b)), ("I8X16_ADD_SAT_U", vub, vub, vub, a.add_sat(b)),
        ("I8X16_SUB_SAT_S", vb, vb, vb, a.sub_sat(b)), ("I8X16_SUB_SAT_U", vub, vub, vub, a.sub_sat(b)),
        ("I8X16_MIN_S", vb, vb, vb, a.min(b)), ("I8X16_MIN_U", vub, vub, vub, a.min(b)),
        ("I8X16_MAX_S", vb, vb, vb, a.max(b)), ("I8X16_MAX_U", vub, vub, vub, a.max(b)),
        ("I8X16_AVGR_U", vub, vub, vub, a.avgr(b)),
        ("I16X8_ADD", vh, vh, vh, a +% b), ("I16X8_SUB", vh, vh, vh, a -% b), ("I16X8_MUL", vh, vh, vh, a *% b),
        ("I16X8_ADD_SAT_S", vh, vh, vh, a.add_sat(b)), ("I16X8_ADD_SAT_U", vuh, vuh, vuh, a.add_sat(b)),
        ("I16X8_SUB_SAT_S", vh, vh, vh, a.sub_sat(b)), ("I16X8_SUB_SAT_U", vuh, vuh, vuh, a.sub_sat(b)),
        ("I16X8_MIN_S", vh, vh, vh, a.min(b)), ("I16X8_MIN_U", vuh, vuh, vuh, a.min(b)),
        ("I16X8_MAX_S", vh, vh, vh, a.max(b)), ("I16X8_MAX_U", vuh, vuh, vuh, a.max(b)),
        ("I16X8_AVGR_U", vuh, vuh, vuh, a.avgr(b)),
        ("I16X8_Q15MULR_SAT_S", vh, vh, vh, q15mulr(a, b)),
        ("I16X8_EXTMUL_LOW_I8X16_S", vh, vb, vb, a.widen_low() *% b.widen_low()),
        ("I16X8_EXTMUL_HIGH_I8X16_S", vh, vb, vb, a.widen_high() *% b.widen_high()),
        ("I16X8_EXTMUL_LOW_I8X16_U", vuh, vub, vub, a.widen_low() *% b.widen_low()),
        ("I16X8_EXTMUL_HIGH_I8X16_U", vuh, vub, vub, a.widen_high() *% b.widen_high()),
        ("I32X4_ADD", vi, vi, vi, a +% b), ("I32X4_SUB", vi, vi, vi, a -% b), ("I32X4_MUL", vi, vi, vi, a *% b),
        ("I32X4_MIN_S", vi, vi, vi, a.min(b)), ("I32X4_MIN_U", vui, vui, vui, a.min(b)),
        ("I32X4_MAX_S", vi, vi, vi, a.max(b)), ("I32X4_MAX_U", vui, vui, vui, a.max(b)),
        ("I32X4_DOT_I16X8_S", vi, vh, vh, dot_s(a, b)),
        ("I32X4_EXTMUL_LOW_I16X8_S", vi, vh, vh, a.widen_low() *% b.widen_low()),
        ("I32X4_EXTMUL_HIGH_I16X8_S", vi, vh, vh, a.widen_high() *% b.widen_high()),
        ("I32X4_EXTMUL_LOW_I16X8_U", vui, vuh, vuh, a.widen_low() *% b.widen_low()),
        ("I32X4_EXTMUL_HIGH_I16X8_U", vui, vuh, vuh, a.widen_high() *% b.widen_high()),
        ("I64X2_ADD", vl, vl, vl, a +% b), ("I64X2_SUB", vl, vl, vl, a -% b), ("I64X2_MUL", vl, vl, vl, a *% b),
        ("I64X2_EXTMUL_LOW_I32X4_S", vl, vi, vi, a.widen_low() *% b.widen_low()),
        ("I64X2_EXTMUL_HIGH_I32X4_S", vl, vi, vi, a.widen_high() *% b.widen_high()),
        ("I64X2_EXTMUL_LOW_I32X4_U", vul, vui, vui, a.widen_low() *% b.widen_low()),
        ("I64X2_EXTMUL_HIGH_I32X4_U", vul, vui, vui, a.widen_high() *% b.widen_high()),
        ("F32X4_ADD", vf, vf, vf, a + b), ("F32X4_SUB", vf, vf, vf, a - b),
        ("F32X4_MUL", vf, vf, vf, a * b), ("F32X4_DIV", vf, vf, vf, a / b),
        ("F32X4_MIN", vf, vf, vf, a.minimum(b)), ("F32X4_MAX", vf, vf, vf, a.maximum(b)),
        ("F32X4_PMIN", vf, vf, vf, (b < a).select(b, a)), ("F32X4_PMAX", vf, vf, vf, (a < b).select(b, a)),
        ("F64X2_ADD", vd, vd, vd, a + b), ("F64X2_SUB", vd, vd, vd, a - b),
        ("F64X2_MUL", vd, vd, vd, a * b), ("F64X2_DIV", vd, vd, vd, a / b),
        ("F64X2_MIN", vd, vd, vd, a.minimum(b)), ("F64X2_MAX", vd, vd, vd, a.maximum(b)),
        ("F64X2_PMIN", vd, vd, vd, (b < a).select(b, a)), ("F64X2_PMAX", vd, vd, vd, (a < b).select(b, a)),
    ] {
        op #name(d: dk, a: ak, b: bk) : RRR { d = expr; next }
    }

    inline for (name, dk, ak, expr) in [
        ("V128_NOT", vul, vul, ~a),
        ("V128_ANY_TRUE", ri, vul, b2i((a == u64x2.splat(0)).bitmask() != 3)),
        ("I8X16_ABS", vb, vb, a.abs()), ("I8X16_NEG", vb, vb, -a), ("I8X16_POPCNT", vub, vub, a.popcount()),
        ("I8X16_ALL_TRUE", ri, vb, b2i((a == i8x16.splat(0)).bitmask() == 0)),
        ("I8X16_BITMASK", ri, vb, a.bitmask() as i32),
        ("I16X8_ABS", vh, vh, a.abs()), ("I16X8_NEG", vh, vh, -a),
        ("I16X8_ALL_TRUE", ri, vh, b2i((a == i16x8.splat(0)).bitmask() == 0)),
        ("I16X8_BITMASK", ri, vh, a.bitmask() as i32),
        ("I16X8_EXTEND_LOW_I8X16_S", vh, vb, a.widen_low()), ("I16X8_EXTEND_HIGH_I8X16_S", vh, vb, a.widen_high()),
        ("I16X8_EXTEND_LOW_I8X16_U", vuh, vub, a.widen_low()), ("I16X8_EXTEND_HIGH_I8X16_U", vuh, vub, a.widen_high()),
        ("I16X8_EXTADD_PAIRWISE_I8X16_S", vh, vb, pairs_i8(a)), ("I16X8_EXTADD_PAIRWISE_I8X16_U", vuh, vub, pairs_u8(a)),
        ("I32X4_ABS", vi, vi, a.abs()), ("I32X4_NEG", vi, vi, -a),
        ("I32X4_ALL_TRUE", ri, vi, b2i((a == i32x4.splat(0)).bitmask() == 0)),
        ("I32X4_BITMASK", ri, vi, a.bitmask() as i32),
        ("I32X4_EXTEND_LOW_I16X8_S", vi, vh, a.widen_low()), ("I32X4_EXTEND_HIGH_I16X8_S", vi, vh, a.widen_high()),
        ("I32X4_EXTEND_LOW_I16X8_U", vui, vuh, a.widen_low()), ("I32X4_EXTEND_HIGH_I16X8_U", vui, vuh, a.widen_high()),
        ("I32X4_EXTADD_PAIRWISE_I16X8_S", vi, vh, pairs_i16(a)), ("I32X4_EXTADD_PAIRWISE_I16X8_U", vui, vuh, pairs_u16(a)),
        ("I64X2_ABS", vl, vl, a.abs()), ("I64X2_NEG", vl, vl, -a),
        ("I64X2_ALL_TRUE", ri, vl, b2i((a == i64x2.splat(0)).bitmask() == 0)),
        ("I64X2_BITMASK", ri, vl, a.bitmask() as i32),
        ("I64X2_EXTEND_LOW_I32X4_S", vl, vi, a.widen_low()), ("I64X2_EXTEND_HIGH_I32X4_S", vl, vi, a.widen_high()),
        ("I64X2_EXTEND_LOW_I32X4_U", vul, vui, a.widen_low()), ("I64X2_EXTEND_HIGH_I32X4_U", vul, vui, a.widen_high()),
        ("F32X4_ABS", vf, vf, a.abs()), ("F32X4_NEG", vf, vf, -a), ("F32X4_SQRT", vf, vf, a.sqrt()),
        ("F32X4_CEIL", vf, vf, a.ceil()), ("F32X4_FLOOR", vf, vf, a.floor()),
        ("F32X4_TRUNC", vf, vf, a.trunc()), ("F32X4_NEAREST", vf, vf, a.nearest()),
        ("F64X2_ABS", vd, vd, a.abs()), ("F64X2_NEG", vd, vd, -a), ("F64X2_SQRT", vd, vd, a.sqrt()),
        ("F64X2_CEIL", vd, vd, a.ceil()), ("F64X2_FLOOR", vd, vd, a.floor()),
        ("F64X2_TRUNC", vd, vd, a.trunc()), ("F64X2_NEAREST", vd, vd, a.nearest()),
        ("I32X4_TRUNC_SAT_F32X4_S", vi, vf, a as i32x4), ("I32X4_TRUNC_SAT_F32X4_U", vui, vf, a as u32x4),
        ("F32X4_CONVERT_I32X4_S", vf, vi, a as f32x4), ("F32X4_CONVERT_I32X4_U", vf, vui, a as f32x4),
        ("I32X4_TRUNC_SAT_F64X2_S_ZERO", vi, vd, i32x4.narrow_sat(a as i64x2, i64x2.splat(0))),
        ("I32X4_TRUNC_SAT_F64X2_U_ZERO", vui, vd, u32x4.narrow_sat(a as u64x2, u64x2.splat(0))),
        ("F64X2_CONVERT_LOW_I32X4_S", vd, vi, a.widen_low() as f64x2),
        ("F64X2_CONVERT_LOW_I32X4_U", vd, vui, a.widen_low() as f64x2),
        ("F32X4_DEMOTE_F64X2_ZERO", vf, vd, f32x4.new(a.lane(0) as f32, a.lane(1) as f32, 0.0, 0.0)),
        ("F64X2_PROMOTE_LOW_F32X4", vd, vf, a.widen_low()),
        ("I8X16_SPLAT", vb, ri, i8x16.splat(a as i8)), ("I16X8_SPLAT", vh, ri, i16x8.splat(a as i16)),
        ("I32X4_SPLAT", vi, ri, i32x4.splat(a)), ("I64X2_SPLAT", vl, rl, i64x2.splat(a)),
        ("F32X4_SPLAT", vf, rf, f32x4.splat(a)), ("F64X2_SPLAT", vd, rd, f64x2.splat(a)),
    ] {
        op #name(d: dk, a: ak) : RRR { d = expr; next }
    }

    // Shifts: the amount is taken modulo the lane width, as in wasm.
    inline for (name, k, expr) in [
        ("I8X16_SHL", vb, a << b), ("I8X16_SHR_S", vb, a >> b), ("I8X16_SHR_U", vub, a >> b),
        ("I16X8_SHL", vh, a << b), ("I16X8_SHR_S", vh, a >> b), ("I16X8_SHR_U", vuh, a >> b),
        ("I32X4_SHL", vi, a << b), ("I32X4_SHR_S", vi, a >> b), ("I32X4_SHR_U", vui, a >> b),
        ("I64X2_SHL", vl, a << b), ("I64X2_SHR_S", vl, a >> b), ("I64X2_SHR_U", vul, a >> b),
    ] {
        op #name(d: k, a: k, b: ri) : RRR { d = expr; next }
    }

    // Lanes: d = lane `l` of a (`l` checked by the verifier).
    inline for (name, dk, vk, lk, conv) in [
        ("I8X16_EXTRACT_LANE_S", ri, vb, l16, x as i32), ("I8X16_EXTRACT_LANE_U", ri, vub, l16, x as i32),
        ("I16X8_EXTRACT_LANE_S", ri, vh, l8, x as i32), ("I16X8_EXTRACT_LANE_U", ri, vuh, l8, x as i32),
        ("I32X4_EXTRACT_LANE", ri, vi, l4, x), ("I64X2_EXTRACT_LANE", rl, vl, l2, x),
        ("F32X4_EXTRACT_LANE", rf, vf, l4, x), ("F64X2_EXTRACT_LANE", rd, vd, l2, x),
    ] {
        op #name(d: dk, a: vk, l: lk) : RRR {
            let x = a.lane_at(l);
            d = conv;
            next
        }
    }
    // d = a with lane `cache.v` (masked by `with_lane_at`) replaced by x.
    inline for (name, vk, xk, conv) in [
        ("I8X16_REPLACE_LANE", vb, ri, x as i8), ("I16X8_REPLACE_LANE", vh, ri, x as i16),
        ("I32X4_REPLACE_LANE", vi, ri, x), ("I64X2_REPLACE_LANE", vl, rl, x),
        ("F32X4_REPLACE_LANE", vf, rf, x), ("F64X2_REPLACE_LANE", vd, rd, x),
    ] {
        op #name(d: vk, a: vk, x: xk) : RRR + Imm64 {
            d = a.with_lane_at(cache.v, conv);
            next
        }
    }
    // The 16 lane indices (< 32, checked by the validator) in the cache.
    op I8X16_SHUFFLE(d: vub, a: vub, b: vub) : RRR + Imm128 {
        let idx = u8x16.from_bits(u64x2.new(cache.lo, cache.hi));
        d = a.swizzle(idx) | b.swizzle(idx -% u8x16.splat(16));
        next
    }

    // Memory: as the scalar loads (`_X`: a 64-bit address from ADDR).
    inline for (name, dk, ty, conv, size, ek) in [
        ("V128_LOAD", vul, u64x2, x, 16, e16),
        ("V128_LOAD8X8_S", vh, u64, i8x16.from_bits(u64x2.new(x, 0)).widen_low(), 8, e8),
        ("V128_LOAD8X8_U", vuh, u64, u8x16.from_bits(u64x2.new(x, 0)).widen_low(), 8, e8),
        ("V128_LOAD16X4_S", vi, u64, i16x8.from_bits(u64x2.new(x, 0)).widen_low(), 8, e8),
        ("V128_LOAD16X4_U", vui, u64, u16x8.from_bits(u64x2.new(x, 0)).widen_low(), 8, e8),
        ("V128_LOAD32X2_S", vl, u64, i32x4.from_bits(u64x2.new(x, 0)).widen_low(), 8, e8),
        ("V128_LOAD32X2_U", vul, u64, u32x4.from_bits(u64x2.new(x, 0)).widen_low(), 8, e8),
        ("V128_LOAD8_SPLAT", vb, i8, i8x16.splat(x), 1, e1),
        ("V128_LOAD16_SPLAT", vh, i16, i16x8.splat(x), 2, e2),
        ("V128_LOAD32_SPLAT", vi, i32, i32x4.splat(x), 4, e4),
        ("V128_LOAD64_SPLAT", vl, i64, i64x2.splat(x), 8, e8),
        ("V128_LOAD32_ZERO", vui, u32, u32x4.new(x, 0, 0, 0), 4, e4),
        ("V128_LOAD64_ZERO", vul, u64, u64x2.new(x, 0), 8, e8),
    ] {
        op #name(d: dk, a: ru, end: ek) : RRR {
            let top = (a as u64) + end;
            if top > msize { raise Trap.MemOOB }
            let x = ((mem + top - size) as *ty).read_unaligned();
            d = conv;
            next
        }
        op #(name ++ "_X")(d: dk, a: rq) : RRR {
            let ea = a;
            if ea + size > msize { raise Trap.MemOOB }
            let x = ((mem + ea) as *ty).read_unaligned();
            d = conv;
            next
        }
        rel xform(#name) = #(name ++ "_X");
    }
    op V128_STORE(a: ru, v: vul, end: e16) : RRR {
        let top = (a as u64) + end;
        if top > msize { raise Trap.MemOOB }
        ((mem + top - 16) as *u64x2).write_unaligned(v);
        next
    }
    rel xform(V128_STORE) = V128_STORE_X;
    op V128_STORE_X(a: rq, v: vul) : RRR {
        let ea = a;
        if ea + 16 > msize { raise Trap.MemOOB }
        ((mem + ea) as *u64x2).write_unaligned(v);
        next
    }
    // Lane loads and stores: offset | lane << 32 in the cache word (the
    // lane masked by `with_lane_at`/`lane_at`).
    inline for (name, vk, ty, size) in [
        ("V128_LOAD8_LANE", vub, u8, 1), ("V128_LOAD16_LANE", vuh, u16, 2),
        ("V128_LOAD32_LANE", vui, u32, 4), ("V128_LOAD64_LANE", vul, u64, 8),
    ] {
        op #name(d: vk, a: ru, v: vk) : RRR + Imm64 {
            let ea = (a as u64) + (cache.v & 0xFFFFFFFF);
            if ea + size > msize { raise Trap.MemOOB }
            let x = ((mem + ea) as *ty).read_unaligned();
            d = v.with_lane_at(cache.v >> 32, x);
            next
        }
    }
    inline for (name, vk, ty, size) in [
        ("V128_STORE8_LANE", vub, u8, 1), ("V128_STORE16_LANE", vuh, u16, 2),
        ("V128_STORE32_LANE", vui, u32, 4), ("V128_STORE64_LANE", vul, u64, 8),
    ] {
        op #name(a: ru, v: vk, z: imm) : RRR + Imm64 {
            let ea = (a as u64) + (cache.v & 0xFFFFFFFF);
            if ea + size > msize { raise Trap.MemOOB }
            ((mem + ea) as *ty).write_unaligned(v.lane_at(cache.v >> 32));
            next
        }
    }

    // ── accesses at an address plus a constant ───────────────────────
    // `local.get p; i32.const 8; i32.add; f64.load` (C code compiled to
    // wasm adds a constant to a pointer where it cannot use the offset,
    // which does not wrap): the add and the access in one op, with offset
    // 0. The add wraps at 32 bits as i32.add does.
    inline for (name, dk, ty, conv, size) in [
        ("I32_LOAD", ri, i32, x, 4), ("I64_LOAD", rl, i64, x, 8),
        ("F32_LOAD", rf, f32, x, 4), ("F64_LOAD", rd, f64, x, 8),
        ("I32_LOAD8_S", ri, i8, x as i32, 1), ("I32_LOAD8_U", ri, u8, x as i32, 1),
        ("I32_LOAD16_S", ri, i16, x as i32, 2), ("I32_LOAD16_U", ri, u16, x as i32, 2),
        ("I64_LOAD8_S", rl, i8, x as i64, 1), ("I64_LOAD8_U", rl, u8, x as i64, 1),
        ("I64_LOAD16_S", rl, i16, x as i64, 2), ("I64_LOAD16_U", rl, u16, x as i64, 2),
        ("I64_LOAD32_S", rl, i32, x as i64, 4), ("I64_LOAD32_U", rl, u32, x as i64, 4),
    ] {
        op #(name ++ "K")(d: dk, a: ru, k: imm) : RRK {
            let ea = (a +% (k as u32)) as u64;
            if ea + size > msize { raise Trap.MemOOB }
            let x = ((mem + ea) as *ty).read_unaligned();
            d = conv;
            next
        }
        rel kmem(#name) = #(name ++ "K");
    }
    inline for (name, vk, ty, conv, size) in [
        ("I32_STORE", ri, i32, v, 4), ("I64_STORE", rl, i64, v, 8),
        ("F32_STORE", ru, u32, v, 4), ("F64_STORE", rd, f64, v, 8),
        ("I32_STORE8", ri, u8, v as u8, 1), ("I32_STORE16", ri, u16, v as u16, 2),
        ("I64_STORE8", rl, u8, v as u8, 1), ("I64_STORE16", rl, u16, v as u16, 2),
        ("I64_STORE32", rl, u32, v as u32, 4),
    ] {
        op #(name ++ "K")(a: ru, v: vk, k: imm) : RRK {
            let ea = (a +% (k as u32)) as u64;
            if ea + size > msize { raise Trap.MemOOB }
            ((mem + ea) as *ty).write_unaligned(conv);
            next
        }
        rel kmem(#name) = #(name ++ "K");
    }

    // A call of a function the module defines (compile.lm).
    op CALL_LOCAL(b: base, fi: fidx) : RU { do_call(ctx.funcs[fi], b.raw, true) }

    // select(a, b, a OP b) (C's min and max, `x < y ? x : y`): the
    // compare and the select in one op (compile.lm). Exactly select's
    // result, NaNs included, since it is the same expression.
    // `W.sel(cmp)` for select(a, b, cmp(a, b)), `W.sel_swapped(cmp)` for
    // select(a, b, cmp(b, a)) (the op of the mirrored compare).
    inline for (cmp, mirror, k, test) in [
        ("I32_LT_S", I32_GT_S, ri, a < b), ("I32_GT_S", I32_LT_S, ri, a > b),
        ("I32_LE_S", I32_GE_S, ri, a <= b), ("I32_GE_S", I32_LE_S, ri, a >= b),
        ("I32_LT_U", I32_GT_U, ru, a < b), ("I32_GT_U", I32_LT_U, ru, a > b),
        ("I32_LE_U", I32_GE_U, ru, a <= b), ("I32_GE_U", I32_LE_U, ru, a >= b),
        ("F64_LT", F64_GT, rd, a < b), ("F64_GT", F64_LT, rd, a > b),
        ("F64_LE", F64_GE, rd, a <= b), ("F64_GE", F64_LE, rd, a >= b),
    ] {
        op #("SEL_" ++ cmp)(d: k, a: k, b: k) : RRR { d = if test { a } else { b }; next }
        rel sel(#cmp) = #("SEL_" ++ cmp);
        rel sel_swapped(mirror) = #("SEL_" ++ cmp);
    }

    // `local.get p; i32.const 4; i32.add; local.tee q; i32.load`: the add
    // (t = a + k, wrapping) and the load at t, offset 0, in one op (12-bit
    // fields; compile.lm: `W.tkload(load)`). `W.tee(op)`: the op also
    // writes a second slot (field b), here and in `_TR` below.
    data tee: bool = false;
    inline for (name, dk, ty, conv, size) in [
        ("I32_LOAD", ri, i32, x, 4), ("I64_LOAD", rl, i64, x, 8),
        ("F32_LOAD", rf, f32, x, 4), ("F64_LOAD", rd, f64, x, 8),
        ("I32_LOAD8_U", ri, u8, x as i32, 1), ("I32_LOAD8_S", ri, i8, x as i32, 1),
        ("I32_LOAD16_U", ri, u16, x as i32, 2), ("I32_LOAD16_S", ri, i16, x as i32, 2),
    ] {
        op #(name ++ "_TK")(d: dk, t: ru, a: ru, k: imm) : R4 {
            let v = a +% (((k << 52) as i64 >> 52) as u32);
            t = v;
            let ea = v as u64;
            if ea + size > msize { raise Trap.MemOOB }
            let x = ((mem + ea) as *ty).read_unaligned();
            d = conv;
            next
        }
        rel tkload(#name) = #(name ++ "_TK");
        data tee(#(name ++ "_TK")) = true;
    }

    // `local.get p; local.get i; i32.add; f64.load` (an array element at a
    // base plus a scaled index): the add (wrapping, as i32.add) and the
    // load at offset 0 in one op; `_TR` also writes the sum to t
    // (`local.tee`, 12-bit fields). compile.lm.
    inline for (name, dk, ty, conv, size) in [
        ("I32_LOAD", ri, i32, x, 4), ("I64_LOAD", rl, i64, x, 8),
        ("F32_LOAD", rf, f32, x, 4), ("F64_LOAD", rd, f64, x, 8),
        ("I32_LOAD8_U", ri, u8, x as i32, 1), ("I32_LOAD8_S", ri, i8, x as i32, 1),
        ("I32_LOAD16_U", ri, u16, x as i32, 2), ("I32_LOAD16_S", ri, i16, x as i32, 2),
    ] {
        op #(name ++ "_R")(d: dk, a: ru, b: ru) : RRR {
            let ea = (a +% b) as u64;
            if ea + size > msize { raise Trap.MemOOB }
            let x = ((mem + ea) as *ty).read_unaligned();
            d = conv;
            next
        }
        op #(name ++ "_TR")(d: dk, t: ru, a: ru, b: ru) : R4 {
            let v = a +% b;
            t = v;
            let ea = v as u64;
            if ea + size > msize { raise Trap.MemOOB }
            let x = ((mem + ea) as *ty).read_unaligned();
            d = conv;
            next
        }
        rel rload(#name) = #(name ++ "_R");
        rel trload(#name) = #(name ++ "_TR");
        data tee(#(name ++ "_TR")) = true;
    }

    // ── more compare-and-branch ──────────────────────────────────────
    // A bit test (`x & k; br_if`) and a test of a loaded word against
    // zero (`p->next != 0`, `i32.load; local.tee; br_if`), which also
    // stores the word to d. The JMP after them holds the target.
    op BR_I32_ANDK_NZ(a: ri, c: imm) : RI then JMP {
        if (a & (c as i32)) != 0 { jump then.t }
        jump pc + 2
    }
    op BR_I32_ANDK_Z(a: ri, c: imm) : RI then JMP {
        if (a & (c as i32)) == 0 { jump then.t }
        jump pc + 2
    }
    inline for (name, nz) in [("BR_I32_LOAD_NZ", true), ("BR_I32_LOAD_Z", false)] {
        op #name(d: ri, a: ru, end: e4) : RRR then JMP {
            let top = (a as u64) + end;
            if top > msize { raise Trap.MemOOB }
            let x = ((mem + top - 4) as *i32).read_unaligned();
            d = x;
            if (x != 0) == nz { jump then.t }
            jump pc + 2
        }
    }

    verify brtable {
        var ok = true;
        var i: u64 = 0;
        while ok and i < code.len {
            let w = code[i];
            if W.opcode(w) == W.OP_BR_TABLE {
                let n = W.RU_x(w);
                if i + 2 + n > code.len {
                    ok = false;
                } else {
                    for j in 0..n + 1 {
                        if W.opcode(code[i + 1 + j]) != W.OP_JMP { ok = false; }
                    }
                }
            }
            i += W.op_size(w);
        }
        ok
    }

    // ── superinstructions ─────────────────────────────────────────────
    // From `--vm-stats` on the float benchmarks (FRICTION.md, "Float
    // benchmarks against wasm3"). `#[forward]`: where a part reads the slot
    // the previous part wrote, the value stays in a machine register (the
    // job wasm3's `fp0` does); `W.optimize` picks them after verification.
    // Each is named by its parts joined with `_` (F64_MUL_F64_ADD).
    #[forward] #[allow(super_overlap)] supers {
        F64_MUL, F64_ADD;  F64_MUL, F64_SUB;  F64_MUL, F64_MUL;  F64_SUB, F64_MUL;  F64_ADD, F64_ADD;
        F64_LOAD, F64_MUL;  F64_LOAD, F64_ADD;  F64_LOAD, F64_SUB;
        F64_ADD, F64_STORE;  F64_SUB, F64_STORE;  F64_MUL, F64_DIV;
        I32_ADDK, F64_LOAD;  CONST64, F64_DIV;  F64_DIV, F64_MUL;  F64_LOAD, F64_MUL, F64_ADD;
        I32_ADD, I32_ADDK;  I32_ADDK, BR_I32_NE;  I32_ADDK, BRNZ;
        // Two counters or pointers stepped together (loops, unrolled ones).
        I32_ADDK, I32_ADDK;
    }

    on raise(t: Trap) { fail t }

    entry run(m: *Machine, f: *Func, args: *u64) -> Result<(), Trap> {
        ctx = m;
        regs = args;
        fp = m.frames;
        fp.ret = m.halt_pc;
        fp.regs = args;
        fp.inst = m.inst;
        mem = m.memory.data; msize = m.mem_size;
        var i = f.nparams as u64;
        let z = f.nzero as u64;
        while i < z { args[i] = 0; i += 1; }
        let n = f.nlocals as u64;
        // Constant slots (the pointer read once: the stores could alias f).
        let ks = f.consts;
        let nk = f.nconsts as u64;
        var j: u64 = 0;
        while j < nk { args[n + j] = ks[j]; j += 1; }
        jump f.code
    }
}

fn table_of(m: *Machine, i: u64) -> ?*Table {
    if i >= m.inst.tables.len { return None; }
    Some(m.inst.tables.at(i))
}

/// Table and bulk memory operations. `x`, `y`, `z` are slot numbers (of
/// the frame `r`), `imm` packs the static indices (low and high 32 bits).
/// Returns false with m.host_trap set to trap.
fn bulk(m: *Machine, which: u32, r: *u64, x: u64, y: u64, z: u64, imm: u64) -> bool {
    let i0 = imm & 0xFFFFFFFF;
    let i1 = imm >> 32;
    let a = r[x];
    let b = r[y];
    let c = r[z];
    m.host_trap = Trap.TableOOB;
    match which {
        0 => {  // table.get: r[x] = t[r[y]]
            let Some(t) = table_of(m, i0) else { return false; };
            let i = b & 0xFFFFFFFF;
            if i >= t.size { return false; }
            r[x] = t.elems[i];
        }
        1 => {  // table.set t[r[x]] = r[y]
            let Some(t) = table_of(m, i0) else { return false; };
            let i = a & 0xFFFFFFFF;
            if i >= t.size { return false; }
            t.elems[i] = b;
        }
        2 => {
            let Some(t) = table_of(m, i0) else { return false; };
            r[x] = t.size;
        }
        3 => {  // r[x] = table.grow(init r[y], n r[z])
            let Some(t) = table_of(m, i0) else { return false; };
            let n = c & 0xFFFFFFFF;
            let old = t.size;
            if old + n > t.max or old + n > 10000000 {
                r[x] = 0xFFFFFFFF;
            } else {
                let Some(p) = realloc(t.elems as *u8, (old + n) * 8 + 8) else { r[x] = 0xFFFFFFFF; return true; };
                t.elems = p as *u64;
                for k in old..old + n { t.elems[k] = b; }
                t.size = old + n;
                r[x] = old;
            }
        }
        4 => {  // table.fill(i r[x], v r[y], n r[z])
            let Some(t) = table_of(m, i0) else { return false; };
            let i = a & 0xFFFFFFFF;
            let n = c & 0xFFFFFFFF;
            if i + n > t.size { return false; }
            for k in i..i + n { t.elems[k] = b; }
        }
        5 => {  // table.copy dst i0, src i1
            let Some(td) = table_of(m, i0) else { return false; };
            let Some(ts) = table_of(m, i1) else { return false; };
            let d = a & 0xFFFFFFFF;
            let s = b & 0xFFFFFFFF;
            let n = c & 0xFFFFFFFF;
            if d + n > td.size or s + n > ts.size { return false; }
            memmove(td.elems as *u8 + d * 8, ts.elems as *u8 + s * 8, n * 8);
        }
        6 => {  // table.init seg i0 into table i1
            let Some(t) = table_of(m, i1) else { return false; };
            if i0 >= m.inst.elem_vals.len { return false; }
            let seg = m.inst.elem_vals.at(i0);
            let len = if m.inst.elem_dropped.at(i0) { 0 } else { seg.len };
            let d = a & 0xFFFFFFFF;
            let s = b & 0xFFFFFFFF;
            let n = c & 0xFFFFFFFF;
            if d + n > t.size or s + n > len { return false; }
            for k in 0..n { t.elems[d + k] = seg[s + k]; }
        }
        7 => {
            if i0 >= m.inst.elem_dropped.len { return false; }
            m.inst.elem_dropped.set(i0, true);
        }
        8 => {  // memory.init seg i0
            m.host_trap = Trap.MemOOB;
            let datas = &m.inst.module.datas;
            if i0 >= datas.len { return false; }
            let bytes = datas.at(i0).bytes;
            let len = if m.inst.data_dropped.at(i0) { 0 } else { bytes.len };
            let d = a & 0xFFFFFFFF;
            let s = b & 0xFFFFFFFF;
            let n = c & 0xFFFFFFFF;
            if d + n > m.mem_size or s + n > len { return false; }
            if n > 0 { memmove(m.memory.data + d, bytes.ptr + s, n); }
        }
        _ => {
            if i0 >= m.inst.data_dropped.len { return false; }
            m.inst.data_dropped.set(i0, true);
        }
    }
    true
}
