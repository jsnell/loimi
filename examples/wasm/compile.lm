// Validator and translator: one pass over a function body that type
// checks it (the spec's validation algorithm, with a control stack and
// an operand stack of types) and, at the same time, emits code for the
// register vm in vm.lm.
//
// Every operand stack position has a home slot: nlocals + the slots of
// the values below it (a v128 takes two slots, everything else one;
// locals are laid out the same way, and `Val.s` records it). A value on
// the translator's stack is either in its home slot, or still pending:
// a local (`local.get` emits nothing until the value is used, so
// `local.get a; local.get b; i32.add` is one ADD reading the locals'
// slots) or a constant. Pending values are written to their home slots
// ("flushed") wherever control flow merges, before a local they read is
// assigned, and for calls. Structured control flow becomes jumps to
// labels of std.bc; a branch that carries values moves them to the
// target's home slots first.
import std.mem;
import std.bc;
import std.text;
import decode;
import decode.{T_I32, T_I64, T_F32, T_F64, T_V128, T_FUNCREF, T_EXTERNREF};
import vm;
import vm.{W, Func, Inst};
#![lifetimes]
// Where a stack value is. (u8 consts at first; a const name in a pattern
// then bound a new variable, so every value took the first arm. Constants
// in patterns now match their value, but an enum is checked exhaustively.)
enum Loc { Home, Local, Const, AddK }

/// An operand stack entry: its type (0 = unknown, in unreachable code),
/// where its value is (`x`: a local's slot, or a constant's bits, or for
/// `AddK`, an i32 that is a slot's value plus a 16-bit constant, the slot
/// in the low 16 bits and the constant above: `addk_slot`, `addk_k`), and
/// its home slot, `s` slots above the first home (a v128 takes two
/// slots, so homes are not simply nlocals + position). `push` sets `s`.
struct Val { ty: u8, loc: Loc, x: u64, s: u64 }

fn addk_slot(v: Val) -> u64 { v.x & 0xFFFF }
fn addk_k(v: Val) -> i64 { (((v.x >> 16) as u16) as i16) as i64 }
fn addk(slot: u64, k: i64) -> u64 { slot | (((k as u16) as u64) << 16) }
fn addk_op(d: u64, v: Val) -> u64 { W.encode.RRK(W.OP_I32_ADDK, d as u16, addk_slot(v) as u16, addk_k(v) as i16) }

/// Slots a value of type `ty` takes: 2 for v128, else 1.
fn width(ty: u8) -> u64 { if ty == T_V128 { 2 } else { 1 } }

const K_BLOCK: u8 = 0;
const K_LOOP: u8 = 1;
const K_IF: u8 = 2;
const K_ELSE: u8 = 3;
const K_FUNC: u8 = 4;

struct Ctl {
    kind: u8,
    params: []u8,
    results: []u8,
    /// Operand stack height at the start (below the params).
    height: u64,
    /// Validation: the rest of the block is unreachable (stack polymorphic).
    unreachable: bool,
    /// Emission: the code of this block is not emitted.
    dead: bool,
    /// Branch target: the end (block, if) or the head (loop).
    label: bc.Label,
    else_label: bc.Label,
}

pub struct T {
    m: *decode.Module,
    code: bc.Code<u64>,
    vals: mem.Vec<Val>,
    ctls: mem.Vec<Ctl>,
    locals: mem.Vec<u8>,
    /// The slot of each local (a v128 one takes two).
    lslots: mem.Vec<u64>,
    nlocals: u64,
    max_height: u64,
    last_def_pc: u64,
    last_def_slot: u64,
    has_def: bool,
    ret_label: bc.Label,
    ret_used: bool,
    results: []u8,
    r: decode.Reader,
    /// Functions that may be referenced by ref.func (declared).
    declared: *mem.Vec<bool>,
    /// Constant slots: the values (64-bit, 32-bit ones zero-extended) of
    /// slots nlocals0..nlocals0 + kvals.len, which calls initialize.
    kvals: mem.Vec<u64>,
    nlocals0: u64,
}

fn rrr(op: u64, a: u64, b: u64, c: u64) -> u64 {
    W.encode.RRR(op, a as u16, b as u16, c as u16)
}

pub fn T.new(m: *decode.Module, declared: *mem.Vec<bool>) -> T {
    T {
        m: m,
        code: bc.Code.new(W.op_size, W.set_label),
        vals: mem.Vec.new(), ctls: mem.Vec.new(), locals: mem.Vec.new(), lslots: mem.Vec.new(),
        nlocals: 0, max_height: 0, last_def_pc: 0, last_def_slot: 0, has_def: false,
        ret_label: bc.Label { id: 0 }, ret_used: false, results: [],
        r: decode.Reader.new([]), declared: declared,
        kvals: mem.Vec.new(), nlocals0: 0,
    }
}

fn T.free(t: *T) {
    t.code.free(); t.vals.free(); t.ctls.free(); t.locals.free(); t.lslots.free(); t.kvals.free();
}

fn T.top(t: *T) -> *Ctl { t.ctls.ptr_at(t.ctls.len - 1) }
fn T.dead(t: *T) -> bool { t.top().dead }
/// Slots used by the operand stack (the next home, relative to nlocals).
fn T.top_slot(t: *T) -> u64 {
    if t.vals.len == 0 { return 0; }
    let v = t.vals.at(t.vals.len - 1);
    v.s + width(v.ty)
}
/// The home slot of stack position `pos` (at most the stack height).
fn T.home(t: *T, pos: u64) -> u64 {
    if pos < t.vals.len { t.nlocals + t.vals.at(pos).s } else { t.nlocals + t.top_slot() }
}

fn T.emit(t: *T, w: u64) -> u64 {
    t.has_def = false;
    t.code.op(w)
}
/// Emits an op whose first operand is the slot it writes.
fn T.emit_def(t: *T, w: u64, slot: u64) {
    let pc = t.code.op(w);
    t.last_def_pc = pc;
    t.last_def_slot = slot;
    t.has_def = true;
}

fn T.push(t: *T, v: Val) {
    let s = t.top_slot();
    t.vals.push(Val { ty: v.ty, loc: v.loc, x: v.x, s: s });
    if s + width(v.ty) > t.max_height { t.max_height = s + width(v.ty); }
}
fn T.push_home(t: *T, ty: u8) { t.push(Val { ty: ty, loc: Loc.Home, x: 0, s: 0 }); }

fn T.pop_any(t: *T) -> Result<Val, str> {
    let c = t.top();
    if t.vals.len == c.height {
        if c.unreachable { return Ok(Val { ty: 0, loc: Loc.Home, x: 0, s: t.top_slot() }); }
        return Err("type mismatch");
    }
    Ok(t.vals.pop().unwrap())
}

fn T.pop(t: *T, want: u8) -> Result<Val, str> {
    let v = t.pop_any()?;
    if v.ty != want and v.ty != 0 and want != 0 { return Err("type mismatch"); }
    if v.ty == 0 { return Ok(Val { ty: want, loc: v.loc, x: v.x, s: v.s }); }
    Ok(v)
}

/// The slot holding the value `v` (just popped), materializing a
/// constant into its home slot.
fn T.reg(t: *T, v: Val) -> u64 {
    match v.loc {
        Local => v.x,
        Const => {
            if let Some(k) = t.kslot(v.x) { return k; }
            let h = t.nlocals + v.s; t.write_const(h, v.ty, v.x); h
        }
        AddK => { let h = t.nlocals + v.s; t.emit_def(addk_op(h, v), h); h }
        _ => t.nlocals + v.s,
    }
}

/// A move of a value of type `ty` between slots.
fn mov(ty: u8, d: u64, a: u64) -> u64 {
    if ty == T_V128 { W.MOVV(d as u16, a as u16) } else { W.MOV(d as u16, a as u16) }
}

/// The constant slot holding `bits`, if there is one.
fn T.kslot(t: *T, bits: u64) -> ?u64 {
    for i in 0..t.kvals.len { if t.kvals.at(i) == bits { return Some(t.nlocals0 + i); } }
    None
}

/// The most constant slots a function gets: each costs a copy per call.
const MAX_KSLOTS: u64 = 32;

/// Finds the constants that appear inside loops of the body (before
/// translation, with its own reader), and gives each distinct value (but
/// small integers) a constant slot, so that ops read them in place instead of running
/// CONST32/CONST64 on every iteration (wasm3's constant slots).
fn T.scan_consts(t: *T, code: []u8) -> Result<(), str> {
    var r = decode.Reader.new(code);
    var loops: mem.Vec<bool> = mem.Vec.new();
    defer loops.free();
    var depth: u64 = 0;
    while !r.at_end() {
        let op = code[r.pos];
        var bits: u64 = 0;
        var is_const = true;
        match op {
            // Integers that fit a K form's 16 bits are mostly used by one
            // (I32_ADDK, BR_I32_LT_SK): only 0 (an absolute address's
            // base, a stored zero) gets a slot among them.
            0x41 => {
                r.pos += 1;
                let v = r.sleb(32)?;
                bits = (v as u64) & 0xFFFFFFFF;
                is_const = v == 0 or !fits16(v);
            }
            0x42 => {
                r.pos += 1;
                let v = r.sleb(64)?;
                bits = v as u64;
                is_const = v == 0 or !fits16(v);
            }
            0x43 => { r.pos += 1; bits = r.fixed32()? as u64; }
            0x44 => { r.pos += 1; bits = r.fixed64()?; }
            _ => {
                is_const = false;
                let o = r.skip_instr()?;
                if o == 0x02 or o == 0x03 or o == 0x04 {
                    loops.push(o == 0x03);
                    if o == 0x03 { depth += 1; }
                } else if o == 0x0B {
                    if let Some(l) = loops.pop() { if l { depth -= 1; } }
                }
            }
        }
        if is_const and depth > 0 and t.kvals.len < MAX_KSLOTS and t.kslot(bits).is_none() {
            t.kvals.push(bits);
        }
    }
    Ok(())
}

fn T.write_const(t: *T, slot: u64, ty: u8, bits: u64) {
    let s = slot as u16;
    if ty == T_I32 or ty == T_F32 {
        t.emit_def(W.CONST32(s, bits as u32), slot);
    } else if ty == T_I64 and (bits as i64) >= -2147483648 and (bits as i64) <= 2147483647 {
        t.emit_def(W.CONSTL(s, bits as i32), slot);
    } else {
        let pc = t.code.op(W.CONST64(s));
        t.code.set(pc + 1, bits);
        t.last_def_pc = pc; t.last_def_slot = slot; t.has_def = true;
    }
}

/// Moves stack entry `i` to its home slot.
fn T.flush_at(t: *T, i: u64) {
    let v = t.vals.at(i);
    if v.loc == Loc.Home { return; }
    let h = t.home(i);
    if !t.dead() {
        if v.loc == Loc.Local { t.emit_def(mov(v.ty, h, v.x), h); }
        else if v.loc == Loc.AddK { t.emit_def(addk_op(h, v), h); }
        else { t.write_const(h, v.ty, v.x); }
    }
    t.vals.set(i, Val { ty: v.ty, loc: Loc.Home, x: 0, s: v.s });
}
fn T.flush_all(t: *T) {
    for i in 0..t.vals.len { t.flush_at(i); }
}
fn T.flush_local(t: *T, x: u64) {
    for i in 0..t.vals.len {
        let v = t.vals.at(i);
        if (v.loc == Loc.Local and v.x == x) or (v.loc == Loc.AddK and addk_slot(v) == x) { t.flush_at(i); }
    }
}

fn T.label_types(t: *T, c: *Ctl) -> []u8 { if c.kind == K_LOOP { c.params } else { c.results } }

fn T.ctl_at(t: *T, depth: u64) -> Result<*Ctl, str> {
    if depth >= t.ctls.len { return Err("unknown label"); }
    Ok(t.ctls.ptr_at(t.ctls.len - 1 - depth))
}

/// Type checks the top `types.len` values against `types` (without
/// popping them for good).
fn T.check_top(t: *T, types: []u8) -> Result<(), str> {
    var popped: mem.Vec<Val> = mem.Vec.new();
    defer popped.free();
    var i = types.len;
    while i > 0 {
        i -= 1;
        let v = t.pop_any()?;
        if v.ty != 0 and v.ty != types[i] { return Err("type mismatch"); }
        popped.push(v);
    }
    while let Some(v) = popped.pop() { t.push(v); }
    Ok(())
}

/// Copies the top `n` stack values to the home slots of positions
/// `dst..dst + n` (code only; the stack is unchanged).
fn T.move_top(t: *T, n: u64, dst: u64) {
    let src = t.vals.len - n;
    if n == 0 { return; }
    let base = t.home(dst);
    let s0 = t.vals.at(src).s;
    for j in 0..n {
        let i = src + j;
        let v = t.vals.at(i);
        let d = base + (v.s - s0);
        match v.loc {
            Local => { t.emit(mov(v.ty, d, v.x)); }
            Const => { t.write_const(d, v.ty, v.x); }
            AddK => { t.emit(addk_op(d, v)); }
            _ => if t.home(i) != d { t.emit(mov(v.ty, d, t.home(i))); },
        }
    }
}

fn T.needs_move(t: *T, n: u64, dst: u64) -> bool {
    let src = t.vals.len - n;
    if src != dst { return n > 0; }
    for j in 0..n { if t.vals.at(src + j).loc != Loc.Home { return true; } }
    false
}

/// The return sequence for values at the top of the stack. It does not
/// change the translator's stack (it is also emitted in br_table stubs).
fn T.emit_return(t: *T) {
    let n = t.results.len;
    if n == 0 { t.emit(W.RET()); return; }
    let p = t.vals.len - n;
    if n == 1 {
        let v = t.vals.at(p);
        let r = t.reg(v);
        if v.ty == T_V128 { t.emit(W.RETV(r as u16)); } else { t.emit(W.RET1(r as u16)); }
        return;
    }
    // Into the home slots first (a pending local may be one of the
    // result slots 0..n), then down to 0..n in order (home slots are at
    // or above their destinations).
    t.move_top(n, p);
    let s0 = t.vals.at(p).s;
    for j in 0..n {
        let v = t.vals.at(p + j);
        t.emit(mov(v.ty, v.s - s0, t.home(p + j)));
    }
    t.emit(W.RET());
}

/// Code for a branch to `c` with its values on top of the stack.
fn T.emit_branch(t: *T, c: *Ctl) {
    if c.kind == K_FUNC { t.emit_return(); return; }
    let n = t.label_types(c).len as u64;
    t.move_top(n, c.height);
    t.code.jump(W.JMP(0), c.label);
}

fn T.set_unreachable(t: *T) {
    let c = t.top();
    t.vals.truncate(c.height);
    c.unreachable = true;
    c.dead = true;
}

fn T.block_type(t: *T, bt: i64) -> Result<([]u8, []u8), str> {
    if bt == -64 { return Ok(([], [])); }
    if bt < 0 {
        let p = t.m.arena.alloc_bytes(1, 1);
        *p = (-bt) as u8;
        return Ok(([], p.slice(1)));
    }
    if (bt as u64) >= t.m.types.len { return Err("unknown type"); }
    let ft = t.m.types.at(bt as u64);
    Ok((ft.params, ft.results))
}

fn T.push_ctl(t: *T, kind: u8, params: []u8, results: []u8) -> *Ctl {
    let parent_dead = if t.ctls.len > 0 { t.dead() } else { false };
    t.ctls.push(Ctl {
        kind: kind, params: params, results: results,
        height: t.vals.len - params.len,
        unreachable: false, dead: parent_dead,
        label: t.code.label(), else_label: bc.Label { id: 0 },
    });
    t.top()
}

pub struct Numeric { op: u64, a: u8, b: u8, r: u8 }

fn num(op: u64, a: u8, b: u8, r: u8) -> ?Numeric { Some(Numeric { op: op, a: a, b: b, r: r }) }

/// Plain numeric instructions: vm op, operand types (b = 0 for unary)
/// and result type.
fn numeric(op: u32) -> ?Numeric {
    let (i, l, f, d) = (T_I32, T_I64, T_F32, T_F64);
    match op {
        0x45 => num(W.OP_I32_EQZ, i, 0, i),
        0x46 => num(W.OP_I32_EQ, i, i, i), 0x47 => num(W.OP_I32_NE, i, i, i),
        0x48 => num(W.OP_I32_LT_S, i, i, i), 0x49 => num(W.OP_I32_LT_U, i, i, i),
        0x4A => num(W.OP_I32_GT_S, i, i, i), 0x4B => num(W.OP_I32_GT_U, i, i, i),
        0x4C => num(W.OP_I32_LE_S, i, i, i), 0x4D => num(W.OP_I32_LE_U, i, i, i),
        0x4E => num(W.OP_I32_GE_S, i, i, i), 0x4F => num(W.OP_I32_GE_U, i, i, i),
        0x50 => num(W.OP_I64_EQZ, l, 0, i),
        0x51 => num(W.OP_I64_EQ, l, l, i), 0x52 => num(W.OP_I64_NE, l, l, i),
        0x53 => num(W.OP_I64_LT_S, l, l, i), 0x54 => num(W.OP_I64_LT_U, l, l, i),
        0x55 => num(W.OP_I64_GT_S, l, l, i), 0x56 => num(W.OP_I64_GT_U, l, l, i),
        0x57 => num(W.OP_I64_LE_S, l, l, i), 0x58 => num(W.OP_I64_LE_U, l, l, i),
        0x59 => num(W.OP_I64_GE_S, l, l, i), 0x5A => num(W.OP_I64_GE_U, l, l, i),
        0x5B => num(W.OP_F32_EQ, f, f, i), 0x5C => num(W.OP_F32_NE, f, f, i),
        0x5D => num(W.OP_F32_LT, f, f, i), 0x5E => num(W.OP_F32_GT, f, f, i),
        0x5F => num(W.OP_F32_LE, f, f, i), 0x60 => num(W.OP_F32_GE, f, f, i),
        0x61 => num(W.OP_F64_EQ, d, d, i), 0x62 => num(W.OP_F64_NE, d, d, i),
        0x63 => num(W.OP_F64_LT, d, d, i), 0x64 => num(W.OP_F64_GT, d, d, i),
        0x65 => num(W.OP_F64_LE, d, d, i), 0x66 => num(W.OP_F64_GE, d, d, i),
        0x67 => num(W.OP_I32_CLZ, i, 0, i), 0x68 => num(W.OP_I32_CTZ, i, 0, i),
        0x69 => num(W.OP_I32_POPCNT, i, 0, i),
        0x6A => num(W.OP_I32_ADD, i, i, i), 0x6B => num(W.OP_I32_SUB, i, i, i),
        0x6C => num(W.OP_I32_MUL, i, i, i), 0x6D => num(W.OP_I32_DIV_S, i, i, i),
        0x6E => num(W.OP_I32_DIV_U, i, i, i), 0x6F => num(W.OP_I32_REM_S, i, i, i),
        0x70 => num(W.OP_I32_REM_U, i, i, i), 0x71 => num(W.OP_I32_AND, i, i, i),
        0x72 => num(W.OP_I32_OR, i, i, i), 0x73 => num(W.OP_I32_XOR, i, i, i),
        0x74 => num(W.OP_I32_SHL, i, i, i), 0x75 => num(W.OP_I32_SHR_S, i, i, i),
        0x76 => num(W.OP_I32_SHR_U, i, i, i), 0x77 => num(W.OP_I32_ROTL, i, i, i),
        0x78 => num(W.OP_I32_ROTR, i, i, i),
        0x79 => num(W.OP_I64_CLZ, l, 0, l), 0x7A => num(W.OP_I64_CTZ, l, 0, l),
        0x7B => num(W.OP_I64_POPCNT, l, 0, l),
        0x7C => num(W.OP_I64_ADD, l, l, l), 0x7D => num(W.OP_I64_SUB, l, l, l),
        0x7E => num(W.OP_I64_MUL, l, l, l), 0x7F => num(W.OP_I64_DIV_S, l, l, l),
        0x80 => num(W.OP_I64_DIV_U, l, l, l), 0x81 => num(W.OP_I64_REM_S, l, l, l),
        0x82 => num(W.OP_I64_REM_U, l, l, l), 0x83 => num(W.OP_I64_AND, l, l, l),
        0x84 => num(W.OP_I64_OR, l, l, l), 0x85 => num(W.OP_I64_XOR, l, l, l),
        0x86 => num(W.OP_I64_SHL, l, l, l), 0x87 => num(W.OP_I64_SHR_S, l, l, l),
        0x88 => num(W.OP_I64_SHR_U, l, l, l), 0x89 => num(W.OP_I64_ROTL, l, l, l),
        0x8A => num(W.OP_I64_ROTR, l, l, l),
        0x8B => num(W.OP_F32_ABS, f, 0, f), 0x8C => num(W.OP_F32_NEG, f, 0, f),
        0x8D => num(W.OP_F32_CEIL, f, 0, f), 0x8E => num(W.OP_F32_FLOOR, f, 0, f),
        0x8F => num(W.OP_F32_TRUNC, f, 0, f), 0x90 => num(W.OP_F32_NEAREST, f, 0, f),
        0x91 => num(W.OP_F32_SQRT, f, 0, f),
        0x92 => num(W.OP_F32_ADD, f, f, f), 0x93 => num(W.OP_F32_SUB, f, f, f),
        0x94 => num(W.OP_F32_MUL, f, f, f), 0x95 => num(W.OP_F32_DIV, f, f, f),
        0x96 => num(W.OP_F32_MIN, f, f, f), 0x97 => num(W.OP_F32_MAX, f, f, f),
        0x98 => num(W.OP_F32_COPYSIGN, f, f, f),
        0x99 => num(W.OP_F64_ABS, d, 0, d), 0x9A => num(W.OP_F64_NEG, d, 0, d),
        0x9B => num(W.OP_F64_CEIL, d, 0, d), 0x9C => num(W.OP_F64_FLOOR, d, 0, d),
        0x9D => num(W.OP_F64_TRUNC, d, 0, d), 0x9E => num(W.OP_F64_NEAREST, d, 0, d),
        0x9F => num(W.OP_F64_SQRT, d, 0, d),
        0xA0 => num(W.OP_F64_ADD, d, d, d), 0xA1 => num(W.OP_F64_SUB, d, d, d),
        0xA2 => num(W.OP_F64_MUL, d, d, d), 0xA3 => num(W.OP_F64_DIV, d, d, d),
        0xA4 => num(W.OP_F64_MIN, d, d, d), 0xA5 => num(W.OP_F64_MAX, d, d, d),
        0xA6 => num(W.OP_F64_COPYSIGN, d, d, d),
        0xA7 => num(W.OP_I32_WRAP_I64, l, 0, i),
        0xA8 => num(W.OP_I32_TRUNC_F32_S, f, 0, i), 0xA9 => num(W.OP_I32_TRUNC_F32_U, f, 0, i),
        0xAA => num(W.OP_I32_TRUNC_F64_S, d, 0, i), 0xAB => num(W.OP_I32_TRUNC_F64_U, d, 0, i),
        0xAC => num(W.OP_I64_EXTEND_I32_S, i, 0, l), 0xAD => num(W.OP_I64_EXTEND_I32_U, i, 0, l),
        0xAE => num(W.OP_I64_TRUNC_F32_S, f, 0, l), 0xAF => num(W.OP_I64_TRUNC_F32_U, f, 0, l),
        0xB0 => num(W.OP_I64_TRUNC_F64_S, d, 0, l), 0xB1 => num(W.OP_I64_TRUNC_F64_U, d, 0, l),
        0xB2 => num(W.OP_F32_CONVERT_I32_S, i, 0, f), 0xB3 => num(W.OP_F32_CONVERT_I32_U, i, 0, f),
        0xB4 => num(W.OP_F32_CONVERT_I64_S, l, 0, f), 0xB5 => num(W.OP_F32_CONVERT_I64_U, l, 0, f),
        0xB6 => num(W.OP_F32_DEMOTE_F64, d, 0, f),
        0xB7 => num(W.OP_F64_CONVERT_I32_S, i, 0, d), 0xB8 => num(W.OP_F64_CONVERT_I32_U, i, 0, d),
        0xB9 => num(W.OP_F64_CONVERT_I64_S, l, 0, d), 0xBA => num(W.OP_F64_CONVERT_I64_U, l, 0, d),
        0xBB => num(W.OP_F64_PROMOTE_F32, f, 0, d),
        0xC0 => num(W.OP_I32_EXTEND8_S, i, 0, i), 0xC1 => num(W.OP_I32_EXTEND16_S, i, 0, i),
        0xC2 => num(W.OP_I64_EXTEND8_S, l, 0, l), 0xC3 => num(W.OP_I64_EXTEND16_S, l, 0, l),
        0xC4 => num(W.OP_I64_EXTEND32_S, l, 0, l),
        0xFC00 => num(W.OP_I32_TRUNC_SAT_F32_S, f, 0, i), 0xFC01 => num(W.OP_I32_TRUNC_SAT_F32_U, f, 0, i),
        0xFC02 => num(W.OP_I32_TRUNC_SAT_F64_S, d, 0, i), 0xFC03 => num(W.OP_I32_TRUNC_SAT_F64_U, d, 0, i),
        0xFC04 => num(W.OP_I64_TRUNC_SAT_F32_S, f, 0, l), 0xFC05 => num(W.OP_I64_TRUNC_SAT_F32_U, f, 0, l),
        0xFC06 => num(W.OP_I64_TRUNC_SAT_F64_S, d, 0, l), 0xFC07 => num(W.OP_I64_TRUNC_SAT_F64_U, d, 0, l),
        _ => simd_numeric(op),
    }
}

/// SIMD instructions without immediates (0xFD prefix): v = v128.
fn simd_numeric(op: u32) -> ?Numeric {
    let (i, l, f, d, v) = (T_I32, T_I64, T_F32, T_F64, T_V128);
    match op {
        0xFD0F => num(W.OP_I8X16_SPLAT, i, 0, v),
        0xFD10 => num(W.OP_I16X8_SPLAT, i, 0, v),
        0xFD11 => num(W.OP_I32X4_SPLAT, i, 0, v),
        0xFD12 => num(W.OP_I64X2_SPLAT, l, 0, v),
        0xFD13 => num(W.OP_F32X4_SPLAT, f, 0, v),
        0xFD14 => num(W.OP_F64X2_SPLAT, d, 0, v),
        0xFD0E => num(W.OP_I8X16_SWIZZLE, v, v, v),
        0xFD23 => num(W.OP_I8X16_EQ, v, v, v),
        0xFD24 => num(W.OP_I8X16_NE, v, v, v),
        0xFD25 => num(W.OP_I8X16_LT_S, v, v, v),
        0xFD26 => num(W.OP_I8X16_LT_U, v, v, v),
        0xFD27 => num(W.OP_I8X16_GT_S, v, v, v),
        0xFD28 => num(W.OP_I8X16_GT_U, v, v, v),
        0xFD29 => num(W.OP_I8X16_LE_S, v, v, v),
        0xFD2A => num(W.OP_I8X16_LE_U, v, v, v),
        0xFD2B => num(W.OP_I8X16_GE_S, v, v, v),
        0xFD2C => num(W.OP_I8X16_GE_U, v, v, v),
        0xFD2D => num(W.OP_I16X8_EQ, v, v, v),
        0xFD2E => num(W.OP_I16X8_NE, v, v, v),
        0xFD2F => num(W.OP_I16X8_LT_S, v, v, v),
        0xFD30 => num(W.OP_I16X8_LT_U, v, v, v),
        0xFD31 => num(W.OP_I16X8_GT_S, v, v, v),
        0xFD32 => num(W.OP_I16X8_GT_U, v, v, v),
        0xFD33 => num(W.OP_I16X8_LE_S, v, v, v),
        0xFD34 => num(W.OP_I16X8_LE_U, v, v, v),
