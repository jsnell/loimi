        }
        0xFC08 => {
            let seg = r.u32()? as u64;
            r.byte()?;
            t.need_memory()?;
            if t.m.data_count.is_none() or seg >= t.m.datas.len { return Err("unknown data segment"); }
            t.bulk3(W.OP_MEM_INIT, T_I32, T_I32, T_I32, seg)?;
        }
        0xFC09 => {
            let seg = r.u32()? as u64;
            if t.m.data_count.is_none() or seg >= t.m.datas.len { return Err("unknown data segment"); }
            if !t.dead() { t.bulk(W.OP_DATA_DROP, 0, 0, 0, seg); }
