        }
        0xFC0F => {
            let ti = r.u32()? as u64;
            let ty = t.table_type(ti)?;
            let n = t.pop(T_I32)?;
            let v = t.pop(ty)?;
            let p = t.vals.len;
            if !t.dead() {
                let rv = t.reg(v);
                let rn = t.reg(n);
                t.bulk(W.OP_TABLE_GROW, t.home(p), rv, rn, ti);
            }
            t.push_home(T_I32);
        }
        0xFC10 => {
            let ti = r.u32()? as u64;
            t.table_type(ti)?;
            let p = t.vals.len;
            if !t.dead() { t.bulk(W.OP_TABLE_SIZE, t.home(p), 0, 0, ti); }
            t.push_home(T_I32);
        }
        0xFC11 => {
            let ti = r.u32()? as u64;
            let ty = t.table_type(ti)?;
            t.bulk3(W.OP_TABLE_FILL, T_I32, ty, T_I32, ti)?;
        }
        0xFC0A => {
            r.byte()?; r.byte()?;
            t.need_memory()?;
            t.ternary_mem(W.OP_MEM_COPY)?;
        }
        0xFC0B => {
            r.byte()?;
            t.need_memory()?;
            t.ternary_mem(W.OP_MEM_FILL)?;
        }
        0xFD0C => {
            let lo = r.fixed64()?;
            let hi = r.fixed64()?;
            let p = t.vals.len;
            if !t.dead() {
                let h = t.home(p);
                let pc = t.code.op(W.CONSTV(h as u16));
                t.code.set(pc + 1, lo);
                t.code.set(pc + 2, hi);
                t.last_def_pc = pc; t.last_def_slot = h; t.has_def = true;
