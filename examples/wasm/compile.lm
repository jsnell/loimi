                0xFD15 => (W.OP_I8X16_EXTRACT_LANE_S, 16, T_I32, false),
                0xFD16 => (W.OP_I8X16_EXTRACT_LANE_U, 16, T_I32, false),
                0xFD17 => (W.OP_I8X16_REPLACE_LANE, 16, T_I32, true),
                0xFD18 => (W.OP_I16X8_EXTRACT_LANE_S, 8, T_I32, false),
                0xFD19 => (W.OP_I16X8_EXTRACT_LANE_U, 8, T_I32, false),
                0xFD1A => (W.OP_I16X8_REPLACE_LANE, 8, T_I32, true),
                0xFD1B => (W.OP_I32X4_EXTRACT_LANE, 4, T_I32, false),
                0xFD1C => (W.OP_I32X4_REPLACE_LANE, 4, T_I32, true),
                0xFD1D => (W.OP_I64X2_EXTRACT_LANE, 2, T_I64, false),
                0xFD1E => (W.OP_I64X2_REPLACE_LANE, 2, T_I64, true),
                0xFD1F => (W.OP_F32X4_EXTRACT_LANE, 4, T_F32, false),
                0xFD20 => (W.OP_F32X4_REPLACE_LANE, 4, T_F32, true),
                0xFD21 => (W.OP_F64X2_EXTRACT_LANE, 2, T_F64, false),
                _ => (W.OP_F64X2_REPLACE_LANE, 2, T_F64, true),
            };
            if lane >= (n as u64) { return Err("invalid lane index"); }
            if repl {
                let x = t.pop(ty)?;
                let v = t.pop(T_V128)?;
                let p = t.vals.len;
                if !t.dead() {
                    let rv = t.reg(v);
                    let rx = t.reg(x);
                    let h = t.home(p);
                    let pc = t.code.op(rrr(vop, h, rv, rx));
                    t.code.set(pc + 1, lane);
                    t.last_def_pc = pc; t.last_def_slot = h; t.has_def = true;
                }
                t.push_home(T_V128);
            } else {
                let v = t.pop(T_V128)?;
                let p = t.vals.len;
                if !t.dead() {
                    let rv = t.reg(v);
                    let h = t.home(p);
                    t.emit_def(rrr(vop, h, rv, lane), h);
                }
                t.push_home(ty);
            }
        }
        0xFD52 => {
            let c = t.pop(T_V128)?;
            let b = t.pop(T_V128)?;
            let a = t.pop(T_V128)?;
            let p = t.vals.len;
            if !t.dead() {
                let rb = t.reg(b);
                let rc = t.reg(c);
                let h = t.home(p);
                // In place: the first operand's home holds the result.
                if a.loc == Loc.Local { t.emit(W.MOVV(h as u16, a.x as u16)); }
                t.emit(W.V128_BITSELECT(h as u16, rb as u16, rc as u16));
            }
            t.push_home(T_V128);
        }
        0xFD54..=0xFD5B => {
            let align = r.u32()?;
            let offset = r.u32()? as u64;
            let lane = r.byte()? as u64;
            t.need_memory()?;
            let k = (op - 0xFD54) & 3;   // log2 of the lane size
            if (align as u64) > (k as u64) { return Err("alignment must not be larger than natural"); }
            if lane >= (16 >> k) as u64 { return Err("invalid lane index"); }
            let store = op >= 0xFD58;
            let vop = match op {
                0xFD54 => W.OP_V128_LOAD8_LANE, 0xFD55 => W.OP_V128_LOAD16_LANE,
                0xFD56 => W.OP_V128_LOAD32_LANE, 0xFD57 => W.OP_V128_LOAD64_LANE,
                0xFD58 => W.OP_V128_STORE8_LANE, 0xFD59 => W.OP_V128_STORE16_LANE,
                0xFD5A => W.OP_V128_STORE32_LANE, _ => W.OP_V128_STORE64_LANE,
            };
            let v = t.pop(T_V128)?;
            let a = t.pop(T_I32)?;
            let p = t.vals.len;
            if !t.dead() {
                let ra = t.reg(a);
                let rv = t.reg(v);
                let imm = offset | (lane << 32);
                if store {
                    let pc = t.emit(rrr(vop, ra, rv, 0));
                    t.code.set(pc + 1, imm);
                } else {
                    let h = t.home(p);
                    let pc = t.code.op(rrr(vop, h, ra, rv));
                    t.code.set(pc + 1, imm);
                    t.last_def_pc = pc; t.last_def_slot = h; t.has_def = true;
                }
            }
            if !store { t.push_home(T_V128); }
        }
        _ => return Err("unsupported instruction"),
    }
    Ok(true)
}

fn is_ref(t: u8) -> bool { t == T_FUNCREF or t == T_EXTERNREF }

fn T.table_type(t: *T, ti: u64) -> Result<u8, str> {
    if ti >= t.m.tables.len { return Err("unknown table"); }
    Ok(t.m.tables.at(ti).reftype)
}

/// A table or bulk-memory op: slots x, y, z and the static indices in
/// the cache word after it.
fn T.bulk(t: *T, vop: u64, x: u64, y: u64, z: u64, imm: u64) {
    let pc = t.emit(rrr(vop, x, y, z));
    t.code.set(pc + 1, imm);
}

/// One with three operands from the stack and no result.
fn T.bulk3(t: *T, vop: u64, ta: u8, tb: u8, tc: u8, imm: u64) -> Result<(), str> {
    let c = t.pop(tc)?;
    let b = t.pop(tb)?;
    let a = t.pop(ta)?;
    let p = t.vals.len;
    if !t.dead() {
        let ra = t.reg(a);
        let rb = t.reg(b);
        let rc = t.reg(c);
        t.bulk(vop, ra, rb, rc, imm);
    }
    Ok(())
}

fn T.ternary_mem(t: *T, vop: u64) -> Result<(), str> {
    let n = t.pop(T_I32)?;
    let b = t.pop(T_I32)?;
    let a = t.pop(T_I32)?;
    let p = t.vals.len;
    if !t.dead() {
        let ra = t.reg(a);
        let rb = t.reg(b);
        let rn = t.reg(n);
        t.emit(rrr(vop, ra, rb, rn));
    }
    Ok(())
}

fn T.branch_to(t: *T, depth: u64) {
    let c = t.ctls.ptr_at(t.ctls.len - 1 - depth);
    t.emit_branch(c);
}

/// A call: arguments are the top values, moved to consecutive home slots;
/// the callee's window starts at the first one, and its results come
/// back there.
/// (`w`: the CALL word, or for call_indirect the table; `ri`: the slot
/// of the table index.)
fn T.call(t: *T, ft: decode.FuncType, w: u64, ti: u64, indirect: bool, ri: u64) -> Result<(), str> {
    t.check_top(ft.params)?;
    let np = ft.params.len;
    let p = t.vals.len - np;
    if !t.dead() {
        for i in p..t.vals.len { t.flush_at(i); }
        let base = t.home(p);
        if indirect {
            if w == 0 {
                t.emit(W.CALL_INDIRECT(base as u16, ti as u16, ri as u16));
            } else {
                let pc = t.emit(W.CALL_INDIRECT_X(base as u16, ti as u16, ri as u16));
                t.code.set(pc + 1, w);
            }
        } else {
            t.emit(W.set_RU_a(w, base).unwrap());
        }
    }
    t.vals.truncate(p);
    for j in 0..ft.results.len { t.push_home(ft.results[j]); }
    Ok(())
}

/// Which locals (indices from `nparams` on) a `local.get` may read
/// before any write, so that they need the zero a call gives them: a
/// forward pass over the structured code with the set of locals written
/// on every path so far. At a construct's `end` that set is what every
/// way of reaching it has: each branch to it (not to a loop, whose
/// branches go to its head), the fall-through of its last instruction
/// and of an `if`'s then arm, and for an `if` without `else` the path
/// around it, which writes nothing. Code after `br`, `br_table`,
/// `return` and `unreachable` is not reached that way and adds nothing;
/// a read in it may still count, which is only conservative.
fn needs_zero(code: []u8, nlocals: u64, nparams: u64, need: *mem.Vec<bool>) -> Result<(), str> {
    var assigned: mem.Vec<bool> = mem.Vec.new();
    defer assigned.free();
    // First writes, in order: what a construct wrote is log[start..].
    var log: mem.Vec<u64> = mem.Vec.new();
    defer log.free();
    // Per open construct: where its writes start in the log, its opcode
    // (0x05 after `else`), and the locals that every path reaching its end
    // so far has written (`m_has`: there was such a path).
    var m_at: mem.Vec<u64> = mem.Vec.new();
    defer m_at.free();
    var m_kind: mem.Vec<u8> = mem.Vec.new();
    defer m_kind.free();
    var m_has: mem.Vec<bool> = mem.Vec.new();
    defer m_has.free();
    var m_acc: mem.Vec<mem.Vec<u64>> = mem.Vec.new();
    defer { for i in 0..m_acc.len { m_acc.ptr_at(i).free(); } m_acc.free(); }
    var depth: u64 = 0;
    var dead = false;
    for i in 0..nlocals { assigned.push(i < nparams); need.push(false); }
    var r = decode.Reader.new(code);
    while !r.at_end() {
        let op = code[r.pos];
        if op == 0x20 or op == 0x21 or op == 0x22 {
            r.pos += 1;
            let x = r.u32()? as u64;
            if x >= nlocals { return Err("unknown local"); }
            if op == 0x20 {
                if !assigned.at(x) { need.set(x, true); }
            } else if !assigned.at(x) {
                assigned.set(x, true);
                log.push(x);
            }
            continue;
        }
        if op == 0x0C or op == 0x0D or op == 0x0E {
            r.pos += 1;
            var n: u64 = 1;
            if op == 0x0E { n = (r.u32()? as u64) + 1; }
            for i in 0..n {
                let d = r.u32()? as u64;
                if !dead and d < depth and m_kind.at(depth - 1 - d) != 0x03 {
                    contribute(depth - 1 - d, &m_at, &m_has, &m_acc, &log, &assigned);
                }
            }
            if op != 0x0D { dead = true; }
            continue;
        }
        let o = r.skip_instr()?;
        if o == 0x00 or o == 0x0F {
            dead = true;
        } else if o == 0x02 or o == 0x03 or o == 0x04 {
            if m_acc.len == depth { m_acc.push(mem.Vec.new()); }
            m_acc.ptr_at(depth).truncate(0);
            m_at.push(log.len); m_kind.push(o as u8); m_has.push(false);
            depth += 1;
        } else if o == 0x05 {
            if depth == 0 { return Err("else without if"); }
            let c = depth - 1;
            if !dead { contribute(c, &m_at, &m_has, &m_acc, &log, &assigned); }
            m_kind.set(c, 0x05);
            while log.len > m_at.at(c) { assigned.set(log.pop().unwrap(), false); }
            dead = false;
        } else if o == 0x0B {
            if depth == 0 { break; }
            let c = depth - 1;
            let kind = m_kind.at(c);
            if kind == 0x03 {
                // A loop's writes stand: its end follows its last instruction.
                m_has.set(c, true);
                let acc = m_acc.ptr_at(c);
                acc.truncate(0);
                for j in m_at.at(c)..log.len { acc.push(log.at(j)); }
            } else if kind == 0x04 {
                m_has.set(c, true);
                m_acc.ptr_at(c).truncate(0);
            } else if !dead {
                contribute(c, &m_at, &m_has, &m_acc, &log, &assigned);
            }
            while log.len > m_at.at(c) { assigned.set(log.pop().unwrap(), false); }
            if m_has.at(c) {
                let acc = m_acc.ptr_at(c);
                for j in 0..acc.len {
                    let x = acc.at(j);
                    if !assigned.at(x) { assigned.set(x, true); log.push(x); }
                }
            }
            m_at.pop(); m_kind.pop(); m_has.pop();
            depth -= 1;
            dead = false;
        }
    }
    Ok(())
}

/// A path reaches the end of construct `c` with the current writes.
fn contribute(c: u64, m_at: *mem.Vec<u64>, m_has: *mem.Vec<bool>, m_acc: *mem.Vec<mem.Vec<u64>>, log: *mem.Vec<u64>, assigned: *mem.Vec<bool>) {
    let acc = m_acc.ptr_at(c);
    if !m_has.at(c) {
        m_has.set(c, true);
        acc.truncate(0);
        for j in m_at.at(c)..log.len { acc.push(log.at(j)); }
        return;
    }
    var k: u64 = 0;
    for j in 0..acc.len {
        let x = acc.at(j);
        if assigned.at(x) { acc.set(k, x); k += 1; }
    }
    acc.truncate(k);
}

/// `consts`: the values of the constant slots, which follow the locals.
/// Calls zero the slots from `nparams` to `nzero` (the locals that may be
/// read before they are written, laid out first).
pub struct Compiled { words: []u64, nslots: u32, nparams: u32, nzero: u32, nlocals: u32, nconsts: u32, consts: *u64 }

/// Validates and translates the body of function `fidx` (a defined one).
pub fn compile(m: *decode.Module, fidx: u64, declared: *mem.Vec<bool>) -> Result<Compiled, str> {
    let body = m.bodies.ptr_at(fidx - (m.nfunc_imports as u64));
    let ft = m.types.at(m.funcs.at(fidx) as u64);
    var t = T.new(m, declared);
    defer t.free();
    var ns: u64 = 0;
    for i in 0..ft.params.len { t.locals.push(ft.params[i]); t.lslots.push(ns); ns += width(ft.params[i]); }
    let nparams = ns;
    let np = ft.params.len;
    var nzero = nparams;
    for i in 0..body.locals.len { t.locals.push(body.locals.at(i)); t.lslots.push(0); }
    // The locals a read may see unwritten first: calls zero only them.
    var need: mem.Vec<bool> = mem.Vec.new();
    defer need.free();
    if let Err(_) = needs_zero(body.code, t.locals.len, np, &need) {
        need.truncate(0);
        for i in 0..t.locals.len { need.push(true); }
    }
    for pass in 0..2 {
        for i in np..t.locals.len {
            if need.at(i) == (pass == 0) { t.lslots.set(i, ns); ns += width(t.locals.at(i)); }
        }
        if pass == 0 { nzero = ns; }
    }
    t.nlocals0 = ns;
    // Constant slots follow the locals; a malformed body is reported by
    // the translation proper.
    if let Err(_) = t.scan_consts(body.code) { t.kvals.truncate(0); }
    t.nlocals = t.nlocals0 + t.kvals.len;
    t.results = ft.results;
    t.r = decode.Reader.new(body.code);
    t.ret_label = t.code.label();
    let c = t.push_ctl(K_FUNC, [], ft.results);
    c.label = t.ret_label;
    while t.instr()? {}
    if !t.r.at_end() { return Err("operators remaining after end of function"); }
    if let Some(e) = t.code.check() { return Err(e.message()); }
    let nslots = t.nlocals + t.max_height + 1;
    if nslots > 65535 { return Err("function too large"); }
    let n = t.code.len();
    let words = mem.alloc<u64>(n);
    t.code.copy_into(words.slice(n));
    // Operand stack homes (slots from nlocals on) are popped once.
    W.accumulate(words.slice(n), t.nlocals);
    let ks = mem.alloc<u64>(t.kvals.len + 1);
    for i in 0..t.kvals.len { ks[i] = t.kvals.at(i); }
    Ok(Compiled {
        words: words.slice(n), nslots: nslots as u32, nparams: nparams as u32, nzero: nzero as u32, nlocals: t.nlocals0 as u32,
        nconsts: t.kvals.len as u32, consts: ks,
    })
}
