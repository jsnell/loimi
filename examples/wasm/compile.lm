/// Loads and stores: (vm op, vm op with a 64-bit address, value type,
/// natural alignment as a power of two, is a store).
fn memop(op: u32) -> ?(u64, u64, u8, u32, bool) {
    let (i, l, f, d) = (T_I32, T_I64, T_F32, T_F64);
    match op {
        0x28 => Some((W.OP_I32_LOAD, W.OP_I32_LOAD_X, i, 2, false)),
        0x29 => Some((W.OP_I64_LOAD, W.OP_I64_LOAD_X, l, 3, false)),
        0x2A => Some((W.OP_F32_LOAD, W.OP_F32_LOAD_X, f, 2, false)),
        0x2B => Some((W.OP_F64_LOAD, W.OP_F64_LOAD_X, d, 3, false)),
        0x2C => Some((W.OP_I32_LOAD8_S, W.OP_I32_LOAD8_S_X, i, 0, false)),
        0x2D => Some((W.OP_I32_LOAD8_U, W.OP_I32_LOAD8_U_X, i, 0, false)),
        0x2E => Some((W.OP_I32_LOAD16_S, W.OP_I32_LOAD16_S_X, i, 1, false)),
        0x2F => Some((W.OP_I32_LOAD16_U, W.OP_I32_LOAD16_U_X, i, 1, false)),
        0x30 => Some((W.OP_I64_LOAD8_S, W.OP_I64_LOAD8_S_X, l, 0, false)),
        0x31 => Some((W.OP_I64_LOAD8_U, W.OP_I64_LOAD8_U_X, l, 0, false)),
        0x32 => Some((W.OP_I64_LOAD16_S, W.OP_I64_LOAD16_S_X, l, 1, false)),
        0x33 => Some((W.OP_I64_LOAD16_U, W.OP_I64_LOAD16_U_X, l, 1, false)),
        0x34 => Some((W.OP_I64_LOAD32_S, W.OP_I64_LOAD32_S_X, l, 2, false)),
        0x35 => Some((W.OP_I64_LOAD32_U, W.OP_I64_LOAD32_U_X, l, 2, false)),
        0x36 => Some((W.OP_I32_STORE, W.OP_I32_STORE_X, i, 2, true)),
        0x37 => Some((W.OP_I64_STORE, W.OP_I64_STORE_X, l, 3, true)),
        0x38 => Some((W.OP_F32_STORE, W.OP_F32_STORE_X, f, 2, true)),
        0x39 => Some((W.OP_F64_STORE, W.OP_F64_STORE_X, d, 3, true)),
        0x3A => Some((W.OP_I32_STORE8, W.OP_I32_STORE8_X, i, 0, true)),
        0x3B => Some((W.OP_I32_STORE16, W.OP_I32_STORE16_X, i, 1, true)),
        0x3C => Some((W.OP_I64_STORE8, W.OP_I64_STORE8_X, l, 0, true)),
        0x3D => Some((W.OP_I64_STORE16, W.OP_I64_STORE16_X, l, 1, true)),
        0x3E => Some((W.OP_I64_STORE32, W.OP_I64_STORE32_X, l, 2, true)),
        0xFD00 => Some((W.OP_V128_LOAD, W.OP_V128_LOAD_X, T_V128, 4, false)),
        0xFD01 => Some((W.OP_V128_LOAD8X8_S, W.OP_V128_LOAD8X8_S_X, T_V128, 3, false)),
        0xFD02 => Some((W.OP_V128_LOAD8X8_U, W.OP_V128_LOAD8X8_U_X, T_V128, 3, false)),
        0xFD03 => Some((W.OP_V128_LOAD16X4_S, W.OP_V128_LOAD16X4_S_X, T_V128, 3, false)),
        0xFD04 => Some((W.OP_V128_LOAD16X4_U, W.OP_V128_LOAD16X4_U_X, T_V128, 3, false)),
        0xFD05 => Some((W.OP_V128_LOAD32X2_S, W.OP_V128_LOAD32X2_S_X, T_V128, 3, false)),
        0xFD06 => Some((W.OP_V128_LOAD32X2_U, W.OP_V128_LOAD32X2_U_X, T_V128, 3, false)),
        0xFD07 => Some((W.OP_V128_LOAD8_SPLAT, W.OP_V128_LOAD8_SPLAT_X, T_V128, 0, false)),
        0xFD08 => Some((W.OP_V128_LOAD16_SPLAT, W.OP_V128_LOAD16_SPLAT_X, T_V128, 1, false)),
        0xFD09 => Some((W.OP_V128_LOAD32_SPLAT, W.OP_V128_LOAD32_SPLAT_X, T_V128, 2, false)),
        0xFD0A => Some((W.OP_V128_LOAD64_SPLAT, W.OP_V128_LOAD64_SPLAT_X, T_V128, 3, false)),
        0xFD0B => Some((W.OP_V128_STORE, W.OP_V128_STORE_X, T_V128, 4, true)),
        0xFD5C => Some((W.OP_V128_LOAD32_ZERO, W.OP_V128_LOAD32_ZERO_X, T_V128, 2, false)),
        0xFD5D => Some((W.OP_V128_LOAD64_ZERO, W.OP_V128_LOAD64_ZERO_X, T_V128, 3, false)),
        _ => None,
    }
}

/// The form of a scalar load or store that adds a 16-bit constant to the
/// address (i32.add, wrapping) instead of an offset: (op, K op).
fn kmems() -> [(u64, u64); 23] {
    [
        (W.OP_I32_LOAD, W.OP_I32_LOADK), (W.OP_I64_LOAD, W.OP_I64_LOADK),
        (W.OP_F32_LOAD, W.OP_F32_LOADK), (W.OP_F64_LOAD, W.OP_F64_LOADK),
        (W.OP_I32_LOAD8_S, W.OP_I32_LOAD8_SK), (W.OP_I32_LOAD8_U, W.OP_I32_LOAD8_UK),
        (W.OP_I32_LOAD16_S, W.OP_I32_LOAD16_SK), (W.OP_I32_LOAD16_U, W.OP_I32_LOAD16_UK),
        (W.OP_I64_LOAD8_S, W.OP_I64_LOAD8_SK), (W.OP_I64_LOAD8_U, W.OP_I64_LOAD8_UK),
        (W.OP_I64_LOAD16_S, W.OP_I64_LOAD16_SK), (W.OP_I64_LOAD16_U, W.OP_I64_LOAD16_UK),
        (W.OP_I64_LOAD32_S, W.OP_I64_LOAD32_SK), (W.OP_I64_LOAD32_U, W.OP_I64_LOAD32_UK),
        (W.OP_I32_STORE, W.OP_I32_STOREK), (W.OP_I64_STORE, W.OP_I64_STOREK),
        (W.OP_F32_STORE, W.OP_F32_STOREK), (W.OP_F64_STORE, W.OP_F64_STOREK),
        (W.OP_I32_STORE8, W.OP_I32_STORE8K), (W.OP_I32_STORE16, W.OP_I32_STORE16K),
        (W.OP_I64_STORE8, W.OP_I64_STORE8K), (W.OP_I64_STORE16, W.OP_I64_STORE16K),
        (W.OP_I64_STORE32, W.OP_I64_STORE32K),
    ]
}

/// The K form of memory op `vop` for an address `a` pending as an AddK
/// and offset 0.
fn kmem(vop: u64, a: Val, offset: u64) -> ?u64 {
    if a.loc != Loc.AddK or offset != 0 { return None; }
    for row in kmems() { let (o, k) = row; if o == vop { return Some(k); } }
    None
}

fn is_num(t: u8) -> bool { t == T_I32 or t == T_I64 or t == T_F32 or t == T_F64 }

fn T.global_type(t: *T, g: u64) -> Result<(u8, bool), str> {
    if g >= t.m.globals.len { return Err("unknown global"); }
    let gd = t.m.globals.at(g);
    Ok((gd.ty, gd.mutable))
}

fn T.need_memory(t: *T) -> Result<(), str> {
    if t.m.mems.len == 0 { return Err("unknown memory"); }
    Ok(())
}


/// The signed value of a constant of an integer type.
fn const_value(v: Val) -> i64 {
    if v.ty == T_I32 { ((v.x as u32) as i32) as i64 } else { v.x as i64 }
}

fn fits16(x: i64) -> bool { x >= -32768 and x <= 32767 }

/// (reg op, K op, commutative)
fn kforms() -> [(u64, u64, bool); 38] {
    [
        (W.OP_I32_ADD, W.OP_I32_ADDK, true), (W.OP_I32_MUL, W.OP_I32_MULK, true),
        (W.OP_I32_AND, W.OP_I32_ANDK, true), (W.OP_I32_OR, W.OP_I32_ORK, true),
        (W.OP_I32_XOR, W.OP_I32_XORK, true), (W.OP_I32_SHL, W.OP_I32_SHLK, false),
        (W.OP_I32_SHR_S, W.OP_I32_SHR_SK, false), (W.OP_I32_SHR_U, W.OP_I32_SHR_UK, false),
        (W.OP_I32_EQ, W.OP_I32_EQK, true), (W.OP_I32_NE, W.OP_I32_NEK, true),
        (W.OP_I32_LT_S, W.OP_I32_LT_SK, false), (W.OP_I32_LT_U, W.OP_I32_LT_UK, false),
        (W.OP_I32_GT_S, W.OP_I32_GT_SK, false), (W.OP_I32_GT_U, W.OP_I32_GT_UK, false),
        (W.OP_I32_LE_S, W.OP_I32_LE_SK, false), (W.OP_I32_LE_U, W.OP_I32_LE_UK, false),
        (W.OP_I32_GE_S, W.OP_I32_GE_SK, false), (W.OP_I32_GE_U, W.OP_I32_GE_UK, false),
        (W.OP_I64_ADD, W.OP_I64_ADDK, true), (W.OP_I64_MUL, W.OP_I64_MULK, true),
        (W.OP_I64_AND, W.OP_I64_ANDK, true), (W.OP_I64_OR, W.OP_I64_ORK, true),
        (W.OP_I64_XOR, W.OP_I64_XORK, true), (W.OP_I64_SHL, W.OP_I64_SHLK, false),
        (W.OP_I64_SHR_S, W.OP_I64_SHR_SK, false), (W.OP_I64_SHR_U, W.OP_I64_SHR_UK, false),
        (W.OP_I64_EQ, W.OP_I64_EQK, true), (W.OP_I64_NE, W.OP_I64_NEK, true),
        (W.OP_I64_LT_S, W.OP_I64_LT_SK, false), (W.OP_I64_LT_U, W.OP_I64_LT_UK, false),
        (W.OP_I64_GT_S, W.OP_I64_GT_SK, false), (W.OP_I64_GT_U, W.OP_I64_GT_UK, false),
        (W.OP_I64_LE_S, W.OP_I64_LE_SK, false), (W.OP_I64_LE_U, W.OP_I64_LE_UK, false),
        (W.OP_I64_GE_S, W.OP_I64_GE_SK, false), (W.OP_I64_GE_U, W.OP_I64_GE_UK, false),
        (W.OP_I32_SUB, W.OP_I32_ADDK, false), (W.OP_I64_SUB, W.OP_I64_ADDK, false),
    ]
}

/// `x + k` (or `x - k`) for an i32 `x` in a local or in the home slot of
/// position `p` (where the sum goes) and a constant `k` of 16 bits stays
/// pending, as an AddK: a load or store at offset 0 then adds it itself
/// (I32_LOADK), anything else materializes it as an I32_ADDK.
fn T.pending_add(t: *T, op: u64, a: Val, b: Val, p: u64) -> ?u64 {
    if op != W.OP_I32_ADD and op != W.OP_I32_SUB { return None; }
    var x = a;
    var c = b;
    if op == W.OP_I32_ADD and a.loc == Loc.Const and b.loc == Loc.Local { x = b; c = a; }
    if c.loc != Loc.Const { return None; }
    var k = const_value(c);
    if op == W.OP_I32_SUB { k = 0 - k; }
    match x.loc {
        Local => if fits16(k) { Some(addk(x.x, k)) } else { None },
        Home => if fits16(k) { Some(addk(t.home(p), k)) } else { None },
        AddK => {
            let k2 = addk_k(x) + k;
            if fits16(k2) { Some(addk(addk_slot(x), k2)) } else { None }
        }
        _ => None,
    }
}

fn T.binop(t: *T, op: u64, a: Val, b: Val, p: u64) {
    let h = t.home(p);
    for row in kforms() {
        let (rop, kop, comm) = row;
        if rop != op { continue; }
        let sub = op == W.OP_I32_SUB or op == W.OP_I64_SUB;
        if b.loc == Loc.Const {
            var k = const_value(b);
            if sub { k = 0 - k; }
            if fits16(k) {
                let ra = t.reg(a);
                t.emit_def(W.encode.RRK(kop, h as u16, ra as u16, k as i16), h);
                return;
            }
        }
        if comm and a.loc == Loc.Const and fits16(const_value(a)) {
            let rb = t.reg(b);
            t.emit_def(W.encode.RRK(kop, h as u16, rb as u16, const_value(a) as i16), h);
            return;
        }
        break;
    }
    let ra = t.reg(a);
    let rb = t.reg(b);
    t.emit_def(rrr(op, h, ra, rb), h);
}

/// Compare ops that fuse with a following branch:
/// (compare op, branch if true, branch if false, compare is a K form).
fn fusions() -> [(u64, u64, u64, bool); 52] {
    [
        (W.OP_F32_EQ, W.OP_BR_F32_EQ, W.OP_BR_F32_NE, false), (W.OP_F32_NE, W.OP_BR_F32_NE, W.OP_BR_F32_EQ, false),
        (W.OP_F32_LT, W.OP_BR_F32_LT, W.OP_BR_F32_NLT, false), (W.OP_F32_GT, W.OP_BR_F32_GT, W.OP_BR_F32_NGT, false),
        (W.OP_F32_LE, W.OP_BR_F32_LE, W.OP_BR_F32_NLE, false), (W.OP_F32_GE, W.OP_BR_F32_GE, W.OP_BR_F32_NGE, false),
        (W.OP_F64_EQ, W.OP_BR_F64_EQ, W.OP_BR_F64_NE, false), (W.OP_F64_NE, W.OP_BR_F64_NE, W.OP_BR_F64_EQ, false),
        (W.OP_F64_LT, W.OP_BR_F64_LT, W.OP_BR_F64_NLT, false), (W.OP_F64_GT, W.OP_BR_F64_GT, W.OP_BR_F64_NGT, false),
        (W.OP_F64_LE, W.OP_BR_F64_LE, W.OP_BR_F64_NLE, false), (W.OP_F64_GE, W.OP_BR_F64_GE, W.OP_BR_F64_NGE, false),
        (W.OP_I32_EQ, W.OP_BR_I32_EQ, W.OP_BR_I32_NE, false), (W.OP_I32_NE, W.OP_BR_I32_NE, W.OP_BR_I32_EQ, false),
        (W.OP_I32_LT_S, W.OP_BR_I32_LT_S, W.OP_BR_I32_GE_S, false), (W.OP_I32_GE_S, W.OP_BR_I32_GE_S, W.OP_BR_I32_LT_S, false),
        (W.OP_I32_GT_S, W.OP_BR_I32_GT_S, W.OP_BR_I32_LE_S, false), (W.OP_I32_LE_S, W.OP_BR_I32_LE_S, W.OP_BR_I32_GT_S, false),
        (W.OP_I32_LT_U, W.OP_BR_I32_LT_U, W.OP_BR_I32_GE_U, false), (W.OP_I32_GE_U, W.OP_BR_I32_GE_U, W.OP_BR_I32_LT_U, false),
        (W.OP_I32_GT_U, W.OP_BR_I32_GT_U, W.OP_BR_I32_LE_U, false), (W.OP_I32_LE_U, W.OP_BR_I32_LE_U, W.OP_BR_I32_GT_U, false),
        (W.OP_I64_EQ, W.OP_BR_I64_EQ, W.OP_BR_I64_NE, false), (W.OP_I64_NE, W.OP_BR_I64_NE, W.OP_BR_I64_EQ, false),
        (W.OP_I64_LT_S, W.OP_BR_I64_LT_S, W.OP_BR_I64_GE_S, false), (W.OP_I64_GE_S, W.OP_BR_I64_GE_S, W.OP_BR_I64_LT_S, false),
        (W.OP_I64_GT_S, W.OP_BR_I64_GT_S, W.OP_BR_I64_LE_S, false), (W.OP_I64_LE_S, W.OP_BR_I64_LE_S, W.OP_BR_I64_GT_S, false),
        (W.OP_I64_LT_U, W.OP_BR_I64_LT_U, W.OP_BR_I64_GE_U, false), (W.OP_I64_GE_U, W.OP_BR_I64_GE_U, W.OP_BR_I64_LT_U, false),
        (W.OP_I64_GT_U, W.OP_BR_I64_GT_U, W.OP_BR_I64_LE_U, false), (W.OP_I64_LE_U, W.OP_BR_I64_LE_U, W.OP_BR_I64_GT_U, false),
        (W.OP_I32_EQK, W.OP_BR_I32_EQK, W.OP_BR_I32_NEK, true), (W.OP_I32_NEK, W.OP_BR_I32_NEK, W.OP_BR_I32_EQK, true),
        (W.OP_I32_LT_SK, W.OP_BR_I32_LT_SK, W.OP_BR_I32_GE_SK, true), (W.OP_I32_GE_SK, W.OP_BR_I32_GE_SK, W.OP_BR_I32_LT_SK, true),
        (W.OP_I32_GT_SK, W.OP_BR_I32_GT_SK, W.OP_BR_I32_LE_SK, true), (W.OP_I32_LE_SK, W.OP_BR_I32_LE_SK, W.OP_BR_I32_GT_SK, true),
        (W.OP_I32_LT_UK, W.OP_BR_I32_LT_UK, W.OP_BR_I32_GE_UK, true), (W.OP_I32_GE_UK, W.OP_BR_I32_GE_UK, W.OP_BR_I32_LT_UK, true),
        (W.OP_I32_GT_UK, W.OP_BR_I32_GT_UK, W.OP_BR_I32_LE_UK, true), (W.OP_I32_LE_UK, W.OP_BR_I32_LE_UK, W.OP_BR_I32_GT_UK, true),
        (W.OP_I64_EQK, W.OP_BR_I64_EQK, W.OP_BR_I64_NEK, true), (W.OP_I64_NEK, W.OP_BR_I64_NEK, W.OP_BR_I64_EQK, true),
        (W.OP_I64_LT_SK, W.OP_BR_I64_LT_SK, W.OP_BR_I64_GE_SK, true), (W.OP_I64_GE_SK, W.OP_BR_I64_GE_SK, W.OP_BR_I64_LT_SK, true),
        (W.OP_I64_GT_SK, W.OP_BR_I64_GT_SK, W.OP_BR_I64_LE_SK, true), (W.OP_I64_LE_SK, W.OP_BR_I64_LE_SK, W.OP_BR_I64_GT_SK, true),
        (W.OP_I64_LT_UK, W.OP_BR_I64_LT_UK, W.OP_BR_I64_GE_UK, true), (W.OP_I64_GE_UK, W.OP_BR_I64_GE_UK, W.OP_BR_I64_LT_UK, true),
        (W.OP_I64_GT_UK, W.OP_BR_I64_GT_UK, W.OP_BR_I64_LE_UK, true), (W.OP_I64_LE_UK, W.OP_BR_I64_LE_UK, W.OP_BR_I64_GT_UK, true),
    ]
}

/// Jumps to `l` if `cond` (just popped, at position p) is nonzero
/// (`when` true) or zero. A comparison emitted just before is fused
/// into a compare-and-branch followed by its JMP.
fn T.cond_jump(t: *T, cond: Val, p: u64, when: bool, l: bc.Label) {
    if cond.loc == Loc.Home and t.has_def and t.last_def_slot == t.home(p) {
        if let Some(last) = t.code.last() {
            if last == t.last_def_pc {
                let w = t.code.at(last);
                let op = W.opcode(w);
                if op == W.OP_I32_EQZ {
                    t.code.truncate(last);
                    let x = W.RRR_b(w);
                    t.code.jump(if when { W.BRZ(x as u16, 0) } else { W.BRNZ(x as u16, 0) }, l);
                    t.has_def = false;
                    return;
                }
                if op == W.OP_I32_ANDK {
                    t.code.truncate(last);
                    let bop = if when { W.OP_BR_I32_ANDK_NZ } else { W.OP_BR_I32_ANDK_Z };
                    t.code.op(W.encode.RI(bop, W.RRK_b(w) as u16, W.RRK_k(w) as i32));
                    t.code.jump(W.JMP(0), l);
                    t.has_def = false;
                    return;
                }
                if op == W.OP_I32_LOAD {
                    t.fuse_load_branch(last, w, when, l);
                    return;
                }
                for row in fusions() {
                    let (cop, bt, bf, k) = row;
                    if cop != op { continue; }
                    t.code.truncate(last);
                    let bop = if when { bt } else { bf };
                    let x = W.RRR_b(w);
                    if k {
                        let kv = W.RRK_k(w);
                        t.code.op(W.encode.RI(bop, x as u16, kv as i32));
                    } else {
                        let y = W.RRR_c(w);
                        t.code.op(W.encode.RRR(bop, x as u16, y as u16, 0));
                    }
                    t.code.jump(W.JMP(0), l);
                    t.has_def = false;
                    return;
                }
            }
        }
    }
    // `i32.load; local.tee x; br_if`: the load was retargeted to x.
    if cond.loc == Loc.Local {
        if let Some(last) = t.code.last() {
            let w = t.code.at(last);
            if W.opcode(w) == W.OP_I32_LOAD and W.RRR_a(w) == cond.x {
                t.fuse_load_branch(last, w, when, l);
                return;
            }
        }
    }
    let rc = t.reg(cond);
    t.code.jump(if when { W.BRNZ(rc as u16, 0) } else { W.BRZ(rc as u16, 0) }, l);
    t.has_def = false;
}

/// Replaces the I32_LOAD `w` at `last` (the last op) by a load that also
/// branches to `l` on the loaded word being nonzero (`when`) or zero.
fn T.fuse_load_branch(t: *T, last: u64, w: u64, when: bool, l: bc.Label) {
    t.code.truncate(last);
    let bop = if when { W.OP_BR_I32_LOAD_NZ } else { W.OP_BR_I32_LOAD_Z };
    t.code.op(rrr(bop, W.RRR_a(w), W.RRR_b(w), W.RRR_c(w)));
    t.code.jump(W.JMP(0), l);
    t.has_def = false;
}

/// Translates one instruction. Returns false after the function's final `end`.
fn T.instr(t: *T) -> Result<bool, str> {
    let r = &t.r;
    let op = r.byte()? as u32;
    let op = if op == 0xFC { 0xFC00 + r.u32()? } else if op == 0xFD { 0xFD00 + r.u32()? } else { op };
    if let Some(n) = numeric(op) {
        if n.b == 0 {
            let a = t.pop(n.a)?;
            let p = t.vals.len;
            if !t.dead() {
                let ra = t.reg(a);
                let h = t.home(p);
                t.emit_def(rrr(n.op, h, ra, 0), h);
            }
        } else {
            let b = t.pop(n.b)?;
            let a = t.pop(n.a)?;
            let p = t.vals.len;
            if let Some(x) = t.pending_add(n.op, a, b, p) {
                t.push(Val { ty: T_I32, loc: Loc.AddK, x: x, s: 0 });
                return Ok(true);
            }
            if !t.dead() { t.binop(n.op, a, b, p); }
        }
        t.push_home(n.r);
        return Ok(true);
    }
    if let Some((vop, xop, ty, natural, store)) = memop(op) {
        let align = r.u32()?;
        let offset = r.u32()? as u64;
        t.need_memory()?;
        if align > natural { return Err("alignment must not be larger than natural"); }
        if store {
            let v = t.pop(ty)?;
            let a = t.pop(T_I32)?;
            let p = t.vals.len;
            if !t.dead() {
                if let Some(kop) = kmem(vop, a, offset) {
                    let rv = t.reg(v);
                    t.emit(W.encode.RRK(kop, addk_slot(a) as u16, rv as u16, addk_k(a) as i16));
                    return Ok(true);
                }
                let ra = t.reg(a);
                let rv = t.reg(v);
                if offset < 65536 {
                    t.emit(rrr(vop, ra, rv, offset));
                } else {
                    let h = t.home(p);
                    let pc = t.emit(W.ADDR(h as u16, ra as u16));
                    t.code.set(pc + 1, offset);
                    t.emit(rrr(xop, h, rv, 0));
                }
            }
        } else {
            let a = t.pop(T_I32)?;
            let p = t.vals.len;
            if !t.dead() {
                if let Some(kop) = kmem(vop, a, offset) {
                    let h = t.home(p);
                    t.emit_def(W.encode.RRK(kop, h as u16, addk_slot(a) as u16, addk_k(a) as i16), h);
                    t.push_home(ty);
                    return Ok(true);
                }
                let ra = t.reg(a);
                let h = t.home(p);
                if offset < 65536 {
                    t.emit_def(rrr(vop, h, ra, offset), h);
                } else {
                    let pc = t.emit(W.ADDR(h as u16, ra as u16));
                    t.code.set(pc + 1, offset);
                    t.emit_def(rrr(xop, h, h, 0), h);
                }
            }
            t.push_home(ty);
        }
        return Ok(true);
    }
    match op {
        0x00 => {
            if !t.dead() { t.emit(W.UNREACHABLE()); }
            t.set_unreachable();
        }
        0x01 => {}
        0x02 | 0x03 => {
            let bt = r.blocktype()?;
            let (params, results) = t.block_type(bt)?;
            t.check_top(params)?;
            t.flush_all();
            let c = t.push_ctl(if op == 0x02 { K_BLOCK } else { K_LOOP }, params, results);
            if op == 0x03 {
                let l = c.label;
                t.code.bind(l);
                t.has_def = false;
            }
        }
        0x04 => {
            let bt = r.blocktype()?;
            let (params, results) = t.block_type(bt)?;
            let cond = t.pop(T_I32)?;
            t.check_top(params)?;
            let p = t.vals.len;
            t.flush_all();
            let else_label = t.code.label();
            if !t.dead() { t.cond_jump(cond, p, false, else_label); }
            let c = t.push_ctl(K_IF, params, results);
            c.else_label = else_label;
        }
        0x05 => {
            let c = t.top();
            if c.kind != K_IF { return Err("else without if"); }
            let results = c.results;
            t.check_top(results)?;
            let c = t.top();
            if t.vals.len != c.height + results.len { return Err("type mismatch"); }
            if !c.dead {
                for i in c.height..t.vals.len { t.flush_at(i); }
                t.code.jump(W.JMP(0), c.label);
            }
            let c = t.top();
            t.code.bind(c.else_label);
            t.has_def = false;
            t.vals.truncate(c.height);
            c.kind = K_ELSE;
            c.unreachable = false;
            c.dead = if t.ctls.len > 1 { let pc = t.ctls.ptr_at(t.ctls.len - 2); pc.dead or pc.unreachable } else { false };
            // The else branch is reached only from the BRZ at the `if`, so
            // the params are still in their home slots.
            for j in 0..c.params.len { t.push_home(c.params[j]); }
        }
        0x0B => {
            let c = t.top();
            let results = c.results;
            t.check_top(results)?;
            let c = t.top();
            if t.vals.len != c.height + results.len { return Err("type mismatch"); }
            if c.kind == K_IF {
                // No else: the params pass through as the results.
                if c.params.len != results.len { return Err("type mismatch"); }
                for j in 0..results.len { if c.params[j] != results[j] { return Err("type mismatch"); } }
            }
            if c.kind == K_FUNC {
                // Branches to the return label leave the results in their
                // home slots; without any, RET1 reads a pending local or
                // constant where it is.
                if !c.dead and t.ret_used {
                    for i in c.height..t.vals.len { t.flush_at(i); }
                }
                if t.ret_used { t.code.bind(t.ret_label); }
                if !c.dead or t.ret_used { t.emit_return(); }
                t.ctls.pop();
                return Ok(false);
            }
            if !c.dead {
                for i in c.height..t.vals.len { t.flush_at(i); }
            }
            let c = t.top();
            if c.kind != K_LOOP { t.code.bind(c.label); }
            if c.kind == K_IF { t.code.bind(c.else_label); }
            t.has_def = false;
            let h = c.height;
            t.ctls.pop();
            t.vals.truncate(h);
            for j in 0..results.len { t.push_home(results[j]); }
        }
        0x0C => {
            let depth = r.u32()? as u64;
            let c = t.ctl_at(depth)?;
            let types = t.label_types(c);
            t.check_top(types)?;
            if !t.dead() { t.branch_to(depth); }
            t.set_unreachable();
        }
        0x0D => {
            let depth = r.u32()? as u64;
            let cond = t.pop(T_I32)?;
            let c = t.ctl_at(depth)?;
            let types = t.label_types(c);
            t.check_top(types)?;
            // The values stay, with the label's types (also unknown ones).
            let base = t.vals.len - types.len;
            for j in 0..types.len {
                let v = t.vals.at(base + j);
                t.vals.set(base + j, Val { ty: types[j], loc: v.loc, x: v.x, s: v.s });
            }
            if !t.dead() {
                let p = t.vals.len;
                let c = t.ctl_at(depth)?;
                let n = types.len as u64;
                if c.kind != K_FUNC and !t.needs_move(n, c.height) {
                    t.cond_jump(cond, p, true, c.label);
                } else {
                    let skip = t.code.label();
                    t.cond_jump(cond, p, false, skip);
                    t.branch_to(depth);
                    t.code.bind(skip);
                }
                t.has_def = false;
            }
        }
        0x0E => {
            let n = r.u32()? as u64;
            var targets: mem.Vec<u64> = mem.Vec.new();
            defer targets.free();
            for i in 0..n + 1 { targets.push(r.u32()? as u64); }
            let idx = t.pop(T_I32)?;
            let def = t.ctl_at(targets.at(n))?;
            let arity = t.label_types(def).len;
            for i in 0..n + 1 {
                let c = t.ctl_at(targets.at(i))?;
                let types = t.label_types(c);
                if types.len != arity { return Err("type mismatch"); }
                t.check_top(types)?;
            }
            if !t.dead() {
                let p = t.vals.len;
                let ri = t.reg(idx);
                t.emit(W.BR_TABLE(ri as u16, n as u32));
                // One JMP per target; targets that need moves go
                // through a stub after the table.
                var stubs: mem.Vec<(bc.Label, u64)> = mem.Vec.new();
                defer stubs.free();
                for i in 0..n + 1 {
                    let depth = targets.at(i);
                    let c = t.ctl_at(depth)?;
                    if c.kind != K_FUNC and !t.needs_move(arity as u64, c.height) {
                        t.code.jump(W.JMP(0), c.label);
                    } else {
                        let s = t.code.label();
                        t.code.jump(W.JMP(0), s);
                        stubs.push((s, depth));
                    }
                }
                for i in 0..stubs.len {
                    let (s, depth) = stubs.at(i);
                    t.code.bind(s);
                    t.branch_to(depth);
                }
            }
            t.set_unreachable();
        }
        0x0F => {
            let results = t.results;
            t.check_top(results)?;
            if !t.dead() { t.emit_return(); }
            t.set_unreachable();
        }
        0x10 => {
            let fi = r.u32()? as u64;
            if fi >= t.m.funcs.len { return Err("unknown function"); }
            let ft = t.m.types.at(t.m.funcs.at(fi) as u64);
            let w = if fi >= (t.m.nfunc_imports as u64) { W.CALL_LOCAL(0, fi as u32) } else { W.CALL(0, fi as u32) };
            t.call(ft, w, 0, false, 0)?;
        }
        0x11 => {
            let ti = r.u32()? as u64;
            let tab = r.u32()? as u64;
            if tab >= t.m.tables.len { return Err("unknown table"); }
            if ti >= t.m.types.len { return Err("unknown type"); }
            if t.m.tables.at(tab).reftype != T_FUNCREF { return Err("type mismatch"); }
            let ft = t.m.types.at(ti);
            let idx = t.pop(T_I32)?;
            let p = t.vals.len;
            var ri: u64 = 0;
            if !t.dead() { ri = t.reg(idx); }
            t.call(ft, tab, ti, true, ri)?;
        }
        0x1A => { t.pop_any()?; }
        0x1B | 0x1C => {
            var want: u8 = 0;
            if op == 0x1C {
                let n = r.u32()?;
                if n != 1 { return Err("invalid result arity"); }
                want = r.valtype()?;
            }
            let c = t.pop(T_I32)?;
            let b = t.pop(want)?;
            let a = t.pop(want)?;
            if op == 0x1B {
                if (a.ty != 0 and !is_num(a.ty) and a.ty != T_V128) or (b.ty != 0 and !is_num(b.ty) and b.ty != T_V128) {
                    return Err("type mismatch");
                }
            }
            if a.ty != 0 and b.ty != 0 and a.ty != b.ty { return Err("type mismatch"); }
            let ty = if a.ty != 0 { a.ty } else { b.ty };
            let p = t.vals.len;
            if !t.dead() {
                let rb = t.reg(b);
                let rc = t.reg(c);
                let h = t.home(p);
                if ty == T_V128 {
                    // In place, like SELECT: the result is the first operand's home.
                    if a.loc == Loc.Local { t.emit(W.MOVV(h as u16, a.x as u16)); }
                    t.emit(W.SELECTV(h as u16, rb as u16, rc as u16));
                    t.push_home(ty);
                    return Ok(true);
                }
                if h < 4096 and rb < 4096 and rc < 4096 and (a.loc != Loc.Local or a.x < 4096) {
                    let ra = t.reg(a);
                    t.emit_def(W.SELECT4(h as u16, ra as u16, rb as u16, rc as u16), h);
                    t.push_home(ty);
                    return Ok(true);
                }
                // The result goes where the first operand is.
                match a.loc {
                    Local => { t.emit(W.MOV(h as u16, a.x as u16)); }
                    Const => { t.write_const(h, a.ty, a.x); }
                    AddK => { t.emit(addk_op(h, a)); }
                    _ => {}
                }
                t.emit(W.SELECT(h as u16, rb as u16, rc as u16));
            }
            t.push_home(ty);
        }
        0x20 => {
            let x = r.u32()? as u64;
            if x >= t.locals.len { return Err("unknown local"); }
            let xs = t.lslots.at(x);
            t.push(Val { ty: t.locals.at(x), loc: Loc.Local, x: xs, s: 0 });
        }
        0x21 | 0x22 => {
            let x = r.u32()? as u64;
            if x >= t.locals.len { return Err("unknown local"); }
            let ty = t.locals.at(x);
            let x = t.lslots.at(x);
            let xs = x;
            let v = t.pop(ty)?;
            let p = t.vals.len;
            if !t.dead() {
                t.flush_local(x);
                let mut_ok = v.loc == Loc.Home and t.has_def and t.last_def_slot == t.home(p);
                var retargeted = false;
                if mut_ok {
                    if let Some(last) = t.code.last() {
                        if last == t.last_def_pc {
                            let w = t.code.at(last);
                            // The destination is field `a`: 12 bits in SELECT4's
                            // format, 16 in the others.
                            if W.opcode(w) == W.OP_SELECT4 {
                                match W.set_R4_a(w, x) {
                                    Some(w2) => t.code.set(last, w2),
                                    None => { t.emit(mov(ty, x, t.home(p))); }
                                }
                            } else {
