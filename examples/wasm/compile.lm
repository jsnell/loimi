                        }
                    }
                }
                if !retargeted {
                    match v.loc {
                        Const => { t.write_const(x, ty, v.x); }
                        Local => { if v.x != x { t.emit(mov(ty, x, v.x)); } }
                        AddK => { t.emit(addk_op(x, v)); }
                        _ => { t.emit(mov(ty, x, t.home(p))); }
                    }
                }
