        }
        0x23 => {
            let g = r.u32()? as u64;
            let (ty, _) = t.global_type(g)?;
            let p = t.vals.len;
            if !t.dead() {
                let h = t.home(p);
                if ty == T_V128 { t.emit_def(W.GLOBAL_GETV(h as u16, g as u32), h); }
                else { t.emit_def(W.GLOBAL_GET(h as u16, g as u32), h); }
            }
            t.push_home(ty);
        }
        0x24 => {
            let g = r.u32()? as u64;
            let (ty, mutable) = t.global_type(g)?;
            if !mutable { return Err("global is immutable"); }
            let v = t.pop(ty)?;
            let p = t.vals.len;
            if !t.dead() {
                let rv = t.reg(v);
                if ty == T_V128 { t.emit(W.GLOBAL_SETV(rv as u16, g as u32)); }
                else { t.emit(W.GLOBAL_SET(rv as u16, g as u32)); }
            }
        }
        0x3F => {
            r.byte()?;
            t.need_memory()?;
            let p = t.vals.len;
            if !t.dead() { let h = t.home(p); t.emit_def(W.MEM_SIZE(h as u16), h); }
            t.push_home(T_I32);
        }
        0x40 => {
            r.byte()?;
            t.need_memory()?;
            let n = t.pop(T_I32)?;
            let p = t.vals.len;
            if !t.dead() {
                let rn = t.reg(n);
                let h = t.home(p);
