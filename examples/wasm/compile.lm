                if ((lo >> (k * 8)) & 0xFF) >= 32 or ((hi >> (k * 8)) & 0xFF) >= 32 { return Err("invalid lane index"); }
            }
            let b = t.pop(T_V128)?;
            let a = t.pop(T_V128)?;
            let p = t.vals.len;
            if !t.dead() {
                let ra = t.reg(a);
                let rb = t.reg(b);
                let h = t.home(p);
                let pc = t.code.op(rrr(W.OP_I8X16_SHUFFLE, h, ra, rb));
                t.code.set(pc + 1, lo);
                t.code.set(pc + 2, hi);
                t.last_def_pc = pc; t.last_def_slot = h; t.has_def = true;
            }
            t.push_home(T_V128);
        }
        0xFD15..=0xFD22 => {
