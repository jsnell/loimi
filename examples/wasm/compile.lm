        0x41 => { let v = r.sleb(32)?; t.push(Val { ty: T_I32, loc: Loc.Const, x: (v as u64) & 0xFFFFFFFF, s: 0 }); }
        0x42 => { let v = r.sleb(64)?; t.push(Val { ty: T_I64, loc: Loc.Const, x: v as u64, s: 0 }); }
        0x43 => { let v = r.fixed32()?; t.push(Val { ty: T_F32, loc: Loc.Const, x: v as u64, s: 0 }); }
        0x44 => { let v = r.fixed64()?; t.push(Val { ty: T_F64, loc: Loc.Const, x: v, s: 0 }); }
        0xBC | 0xBD | 0xBE | 0xBF => {
            // Reinterpretations: same bits, new type.
            let (from, to) = match op {
                0xBC => (T_F32, T_I32), 0xBD => (T_F64, T_I64),
                0xBE => (T_I32, T_F32), _ => (T_I64, T_F64),
            };
            let v = t.pop(from)?;
            if v.loc == Loc.AddK {
                if !t.dead() { t.reg(v); }
                t.push_home(to);
                return Ok(true);
            }
            t.push(Val { ty: to, loc: v.loc, x: v.x, s: v.s });
        }
        0xD0 => {
            let ty = r.byte()?;
            t.push(Val { ty: ty, loc: Loc.Const, x: 0, s: 0 });
        }
        0xD1 => {
            let v = t.pop_any()?;
            if v.ty != 0 and !is_ref(v.ty) { return Err("type mismatch"); }
            let p = t.vals.len;
            if !t.dead() {
                let rv = t.reg(v);
                let h = t.home(p);
                t.emit_def(W.REF_IS_NULL(h as u16, rv as u16), h);
            }
            t.push_home(T_I32);
        }
        0xD2 => {
            let x = r.u32()? as u64;
            if x >= t.m.funcs.len { return Err("unknown function"); }
            if x >= t.declared.len or !t.declared.at(x) { return Err("undeclared function reference"); }
            let p = t.vals.len;
            if !t.dead() { let h = t.home(p); t.emit_def(W.REF_FUNC(h as u16, x as u32), h); }
            t.push_home(T_FUNCREF);
        }
        0x25 => {
            let ti = r.u32()? as u64;
            let ty = t.table_type(ti)?;
            let i = t.pop(T_I32)?;
            let p = t.vals.len;
            if !t.dead() {
                let ri = t.reg(i);
                let h = t.home(p);
                t.bulk(W.OP_TABLE_GET, h, ri, 0, ti);
            }
            t.push_home(ty);
        }
        0x26 => {
            let ti = r.u32()? as u64;
            let ty = t.table_type(ti)?;
            let v = t.pop(ty)?;
            let i = t.pop(T_I32)?;
            let p = t.vals.len;
            if !t.dead() {
