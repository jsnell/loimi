(module
  ;; Calls zero only the locals that a read may see unwritten
  ;; (`needs_zero` in compile.lm). Each $X returns local 1 or 2, which one
  ;; path to the read leaves unwritten for the argument 1, so it must be 0
  ;; ($ok writes it on every path); `$dirty` first leaves 99s in the slots
  ;; of the same frame.
  (import "env" "print_i32" (func $print (param i32)))
  (func $brif (param i32) (result i32) (local i32)
    (block (br_if 0 (local.get 0)) (local.set 1 (i32.const 5)))
    (local.get 1))
  (func $ifnoelse (param i32) (result i32) (local i32)
    (if (i32.eqz (local.get 0)) (then (local.set 1 (i32.const 5))))
    (local.get 1))
  (func $ifelse_br (param i32) (result i32) (local i32)
    (if (local.get 0)
      (then (br_if 0 (local.get 0)) (local.set 1 (i32.const 5)))
      (else (local.set 1 (i32.const 6))))
    (local.get 1))
  (func $loop (param i32) (result i32) (local i32 i32)
    (loop
      (local.set 2 (i32.add (local.get 2) (local.get 1)))
      (local.set 1 (i32.const 7))
      (br_if 0 (i32.eqz (local.get 0))))
    (local.get 2))
  (func $brtable (param i32) (result i32) (local i32)
    (block (block (br_table 0 1 (local.get 0)) ) (local.set 1 (i32.const 5)))
    (local.get 1))
  (func $nested (param i32) (result i32) (local i32)
    (block (br_if 0 (local.get 0)) (block (local.set 1 (i32.const 5)) (br 1)))
    (local.get 1))
  (func $deadfall (param i32) (result i32) (local i32)
    (block (br_if 0 (local.get 0)) (br 0) (local.set 1 (i32.const 5)))
    (local.get 1))
  (func $ok (param i32) (result i32) (local i32)
    (block (local.set 1 (i32.const 5)) (br_if 0 (local.get 0)))
    (local.get 1))
  (func $dirty (param i32) (local i32 i32 i32 i32)
    (local.set 1 (i32.const 99)) (local.set 2 (i32.const 99)) (local.set 3 (i32.const 99)) (local.set 4 (i32.const 99)))
  (func (export "main") (result i32)
    (call $dirty (i32.const 1)) (call $print (call $brif (i32.const 1)))
    (call $dirty (i32.const 1)) (call $print (call $ifnoelse (i32.const 1)))
    (call $dirty (i32.const 1)) (call $print (call $ifelse_br (i32.const 1)))
    (call $dirty (i32.const 1)) (call $print (call $loop (i32.const 1)))
    (call $dirty (i32.const 1)) (call $print (call $brtable (i32.const 1)))
    (call $dirty (i32.const 1)) (call $print (call $nested (i32.const 1)))
    (call $dirty (i32.const 1)) (call $print (call $deadfall (i32.const 1)))
    (call $dirty (i32.const 1)) (call $print (call $ok (i32.const 1)))
    (i32.const 0)))
