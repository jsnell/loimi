// Builtin procedures. Each is a native function identified by a small
// integer (a procedure value is `Imm(PRIM_BASE + id)`). Natives allocate
// but never collect: the CALL that invokes them runs the collector first
// if needed. Hot builtins (car, +, <, ...) are also compiled inline as
// ops when the program does not redefine them (see compile.lm); the
// natives here serve every other call, e.g. `(map car l)`.
//
// `apply` is handled by the VM's call path, since it calls a procedure.

import std.gc;
import std.io;
import std.os;
import std.mem;
import std.text;
import std.map;
import value;
import value.{V, Pair, Str, Sym, Vect};
import rt.{Ctx};
import rt;
import read;
import bignum;

extern "C" fn pow(a: f64, b: f64) -> f64;
extern "C" fn ceil(a: f64) -> f64;
extern "C" fn trunc(a: f64) -> f64;
extern "C" fn rint(a: f64) -> f64;
extern "C" fn fmod(a: f64, b: f64) -> f64;
extern "C" fn gettimeofday(tv: *i64, tz: *u8) -> i32;
extern "C" fn exp(x: f64) -> f64;
extern "C" fn log(x: f64) -> f64;
extern "C" fn sin(x: f64) -> f64;
extern "C" fn cos(x: f64) -> f64;
extern "C" fn tan(x: f64) -> f64;
extern "C" fn asin(x: f64) -> f64;
extern "C" fn acos(x: f64) -> f64;
extern "C" fn atan(x: f64) -> f64;
extern "C" fn atan2(y: f64, x: f64) -> f64;

/// Wall-clock time in microseconds.
fn now_us() -> i64 {
    var tv: [i64; 2];
    gettimeofday(&tv[0], 0 as *u8);
    tv[0] * 1000000 + tv[1]
}

/// The time of the first current-jiffy call (jiffies count from there, so
/// they stay fixnums for half an hour).
var JIFFY0: i64 = -1;
extern "C" fn fdopen(fd: i32, mode: *u8) -> *u8;
extern "C" fn fread(buf: *u8, size: u64, n: u64, f: *u8) -> u64;
extern "C" fn malloc(n: u64) -> *u8;
extern "C" fn realloc(p: *u8, n: u64) -> *u8;

/// All of standard input (read once, on the first `read`).
fn stdin_text(c: *Ctx) -> str {
    if let Some(s) = c.input { return s; }
    let f = fdopen(0, "rb\0".ptr);
    var cap: u64 = 65536;
    var len: u64 = 0;
    var buf = malloc(cap);
    if (f as u64) != 0 {
        loop {
            if len == cap { cap *= 2; buf = realloc(buf, cap); }
            let got = fread(buf + len, 1, cap - len, f);
            if got == 0 { break; }
            len += got;
        }
    }
    let s = buf.slice(len);
    c.input = Some(s);
    s
}

pub fn record_err(c: *Ctx, rtd: V, v: V) -> V {
    c.tmp.clear();
    c.tmp.push_str("record accessor: expected a record of type ");
    if let P(t) = rtd { value.print(&c.tmp, t.car, false); }
    c.tmp.push_str(", got ");
    value.print(&c.tmp, v, true);
    V.S(value.new_str(&c.heap, c.tmp.as_str()))
}

/// (read): the next datum from standard input, or the eof object.
fn read_stdin(c: *Ctx) -> V {
    let all = stdin_text(c);
    var lines: map.HashMap<u64, u32> = map.HashMap.new();
    var r = read.Reader.new(all[c.input_pos..all.len], &c.heap, &c.syms, &lines, false);
    let v = r.read();
    c.input_pos += r.cur.pos;
    match v {
        Some(x) => x,
        None => V.Imm(value.IMM_EOF),
    }
}

/// Ops for builtins compiled inline (`Prim.op`), with the number of
/// arguments they take inline. Vector, Record, RRef, RSet and RecP are
/// only generated by the compiler.
#[data(arity: i64 = 1)]
pub enum PO {
    #[data(2)] Add, #[data(2)] Sub, #[data(2)] Mul, #[data(2)] Div,
    #[data(2)] Quo, #[data(2)] Rem, #[data(2)] Mod, #[data(2)] NumEq,
    #[data(2)] Lt, #[data(2)] Gt, #[data(2)] Le, #[data(2)] Ge,
    #[data(2)] Eq, #[data(2)] Eqv, #[data(2)] Cons, #[data(2)] Vref,
    ZeroP, Not, NullP, PairP, Car, Cdr, #[data(2)] SetCar,
    #[data(2)] SetCdr, #[data(3)] Vset, SymP, NumP, FixP, StrP, VecP,
    Vector, Record, #[data(2)] Memq, #[data(2)] Assq, RRef, RSet, RecP,
    Length, OddP, EvenP, PosP, NegP, VLen, Reverse, #[data(2)] Append,
    #[data(2)] SRef,
}

/// The builtins, by the id a `value.prim` holds (the discriminant): the
/// Scheme name, the argument counts, minimum and maximum (-1: any), and
/// the op that compiles it inline, if any.
#[data(min: i32 = 1, max: i32 = 1, op: ?PO = None)]
pub enum Prim: i32 {
    #[name("+"), data(0, -1, op = Some(PO.Add))] Add,
    #[name("-"), data(1, -1, op = Some(PO.Sub))] Sub,
    #[name("*"), data(0, -1, op = Some(PO.Mul))] Mul,
    #[name("/"), data(1, -1, op = Some(PO.Div))] Div,
    #[name("="), data(1, -1, op = Some(PO.NumEq))] NumEq,
    #[name("<"), data(1, -1, op = Some(PO.Lt))] Lt,
    #[name(">"), data(1, -1, op = Some(PO.Gt))] Gt,
    #[name("<="), data(1, -1, op = Some(PO.Le))] Le,
    #[name(">="), data(1, -1, op = Some(PO.Ge))] Ge,
    #[name("quotient"), data(2, 2, op = Some(PO.Quo))] Quotient,
    #[name("remainder"), data(2, 2, op = Some(PO.Rem))] Remainder,
    #[name("modulo"), data(2, 2, op = Some(PO.Mod))] Modulo,
    #[name("zero?"), data(op = Some(PO.ZeroP))] ZeroP,
    #[name("number?"), data(op = Some(PO.NumP))] NumberP,
    #[name("integer?")] IntegerP,
    #[name("abs")] Abs,
    #[name("min"), data(1, -1)] Min,
    #[name("max"), data(1, -1)] Max,
    #[name("sqrt")] Sqrt,
    #[name("exact->inexact")] ExactToInexact,
    #[name("inexact->exact")] InexactToExact,
    #[name("exact")] Exact,
    #[name("inexact")] Inexact,
    #[name("floor")] Floor,
    #[name("ceiling")] Ceiling,
    #[name("round")] Round,
    #[name("truncate")] Truncate,
    #[name("expt"), data(2, 2)] Expt,
    #[name("even?"), data(op = Some(PO.EvenP))] EvenP,
    #[name("odd?"), data(op = Some(PO.OddP))] OddP,
    #[name("positive?"), data(op = Some(PO.PosP))] PositiveP,
    #[name("negative?"), data(op = Some(PO.NegP))] NegativeP,
    #[name("number->string"), data(1, 2)] NumberToString,
    #[name("string->number"), data(1, 2)] StringToNumber,
    #[name("gcd"), data(0, -1)] Gcd,
    #[name("lcm"), data(0, -1)] Lcm,
    #[name("exact?")] ExactP,
    #[name("inexact?")] InexactP,
    #[name("cons"), data(2, 2, op = Some(PO.Cons))] Cons,
    #[name("car"), data(op = Some(PO.Car))] Car,
    #[name("cdr"), data(op = Some(PO.Cdr))] Cdr,
    #[name("set-car!"), data(2, 2, op = Some(PO.SetCar))] SetCar,
    #[name("set-cdr!"), data(2, 2, op = Some(PO.SetCdr))] SetCdr,
    #[name("list"), data(0, -1)] List,
    #[name("length"), data(op = Some(PO.Length))] Length,
    #[name("append"), data(0, -1, op = Some(PO.Append))] Append,
    #[name("reverse"), data(op = Some(PO.Reverse))] Reverse,
    #[name("list-tail"), data(2, 2)] ListTail,
    #[name("list-ref"), data(2, 2)] ListRef,
    #[name("memq"), data(2, 2, op = Some(PO.Memq))] Memq,
    #[name("memv"), data(2, 2)] Memv,
    #[name("member"), data(2, 2)] Member,
    #[name("assq"), data(2, 2, op = Some(PO.Assq))] Assq,
    #[name("assv"), data(2, 2)] Assv,
    #[name("assoc"), data(2, 2)] Assoc,
    #[name("apply"), data(1, -1)] Apply,
    #[name("caar")] Caar,
    #[name("cadr")] Cadr,
    #[name("cdar")] Cdar,
    #[name("cddr")] Cddr,
    #[name("caddr")] Caddr,
    #[name("cdddr")] Cdddr,
    #[name("null?"), data(op = Some(PO.NullP))] NullP,
    #[name("pair?"), data(op = Some(PO.PairP))] PairP,
    #[name("list?")] ListP,
    #[name("eq?"), data(2, 2, op = Some(PO.Eq))] EqP,
    #[name("eqv?"), data(2, 2, op = Some(PO.Eqv))] EqvP,
    #[name("equal?"), data(2, 2)] EqualP,
    #[name("not"), data(op = Some(PO.Not))] Not,
    #[name("symbol?"), data(op = Some(PO.SymP))] SymbolP,
    #[name("string?"), data(op = Some(PO.StrP))] StringP,
    #[name("procedure?")] ProcedureP,
    #[name("vector?"), data(op = Some(PO.VecP))] VectorP,
    #[name("boolean?")] BooleanP,
    #[name("char?")] CharP,
    #[name("make-vector"), data(1, 2)] MakeVector,
    #[name("vector"), data(0, -1)] Vector,
    #[name("vector-ref"), data(2, 2, op = Some(PO.Vref))] VectorRef,
    #[name("vector-set!"), data(3, 3, op = Some(PO.Vset))] VectorSet,
    #[name("vector-length"), data(op = Some(PO.VLen))] VectorLength,
    #[name("vector->list")] VectorToList,
    #[name("list->vector")] ListToVector,
    #[name("vector-fill!"), data(2, 2)] VectorFill,
    #[name("string-length")] StringLength,
    #[name("string-ref"), data(2, 2, op = Some(PO.SRef))] StringRef,
    #[name("substring"), data(2, 3)] Substring,
    #[name("string-append"), data(0, -1)] StringAppend,
    #[name("string=?"), data(2, 2)] StringEqP,
    #[name("string<?"), data(2, 2)] StringLtP,
    #[name("string>?"), data(2, 2)] StringGtP,
    #[name("string-copy")] StringCopy,
    #[name("string->list")] StringToList,
    #[name("list->string")] ListToString,
    #[name("make-string"), data(1, 2)] MakeString,
    #[name("string"), data(0, -1)] String,
    #[name("symbol->string")] SymbolToString,
    #[name("string->symbol")] StringToSymbol,
    #[name("char->integer")] CharToInteger,
    #[name("integer->char")] IntegerToChar,
    #[name("char=?"), data(2, 2)] CharEqP,
    #[name("char<?"), data(2, 2)] CharLtP,
    #[name("char>?"), data(2, 2)] CharGtP,
    #[name("char-upcase")] CharUpcase,
    #[name("char-downcase")] CharDowncase,
    #[name("char-alphabetic?")] CharAlphabeticP,
    #[name("char-numeric?")] CharNumericP,
    #[name("char-whitespace?")] CharWhitespaceP,
    #[name("string-set!"), data(3, 3)] StringSet,
    #[name("display"), data(1, 2)] Display,
    #[name("write"), data(1, 2)] Write,
    #[name("newline"), data(0)] Newline,
    #[name("error"), data(0, -1)] Error,
    #[name("exit"), data(0)] Exit,
    #[name("last-pair")] LastPair,
    #[name("list-copy")] ListCopy,
    #[name("cadddr")] Cadddr,
    #[name("eof-object"), data(0, 0)] EofObject,
    #[name("symbol=?"), data(2, 2)] SymbolEqP,
    #[name("char<=?"), data(2, 2)] CharLeP,
    #[name("char>=?"), data(2, 2)] CharGeP,
    #[name("string<=?"), data(2, 2)] StringLeP,
    #[name("string>=?"), data(2, 2)] StringGeP,
    #[name("boolean=?"), data(2, 2)] BooleanEqP,
    #[name("write-string"), data(1, 2)] WriteString,
    #[name("write-char"), data(1, 2)] WriteChar,
    #[name("square")] Square,
    #[name("read"), data(0)] Read,
    #[name("current-output-port"), data(0, 0)] CurrentOutputPort,
    #[name("flush-output-port"), data(0)] FlushOutputPort,
    #[name("current-second"), data(0, 0)] CurrentSecond,
    #[name("current-jiffy"), data(0, 0)] CurrentJiffy,
    #[name("jiffies-per-second"), data(0, 0)] JiffiesPerSecond,
    #[name("call-with-current-continuation")] CallCc,
    #[name("eof-object?")] EofObjectP,
    #[name("exp")] Exp,
    #[name("log"), data(1, 2)] Log,
    #[name("sin")] Sin,
    #[name("cos")] Cos,
    #[name("tan")] Tan,
    #[name("asin")] Asin,
    #[name("acos")] Acos,
    #[name("atan"), data(1, 2)] Atan,
    #[name("exact-integer?"), data(op = Some(PO.FixP))] ExactIntegerP,
    #[name("%record"), data(1, -1)] Record,
    #[name("%record?"), data(2, 2)] RecordP,
    #[name("%record-ref"), data(3, 3)] RecordRef,
    #[name("%record-set!"), data(4, 4)] RecordSet,
    #[name("floor-quotient"), data(2, 2)] FloorQuotient,
    #[name("%exact-integer-sqrt")] ExactIntegerSqrt,
}

// ── numbers ─────────────────────────────────────────────────────────

/// Binary arithmetic: op 0 +, 1 -, 2 *, 3 /. Fixnum results that overflow
/// become bignums; `/` of exact integers is exact when the division is
/// (there are no rationals: otherwise it is a flonum).
pub fn arith(c: *Ctx, op: i32, a: V, b: V) -> Result<V, V> {
    if let (Int(x), Int(y)) = (a, b) {
        match op {
            0 => { if let Some(r) = x.add_checked(y) { return Ok(V.Int(r)); } }
            1 => { if let Some(r) = x.sub_checked(y) { return Ok(V.Int(r)); } }
            2 => { if let Some(r) = x.mul_checked(y) { return Ok(V.Int(r)); } }
            _ => {
                if y == 0 { return Err(rt.err_msg(c, "/: division by zero")); }
                let (i, j) = (x as i64, y as i64);
                if i % j == 0 { return Ok(bignum.of_i64(&c.heap, i / j)); }
                return Ok(V.Num((i as f64) / (j as f64)));
            }
        }
        let (i, j) = (x as i64, y as i64);
        return Ok(bignum.of_i64(&c.heap, match op { 0 => i + j, 1 => i - j, _ => i * j }));
    }
    let name = match op { 0 => "+", 1 => "-", 2 => "*", _ => "/" };
    if bignum.is_exact(a) and bignum.is_exact(b) {
        let h = &c.heap;
        match op {
            0 => return Ok(bignum.add(h, a, b)),
            1 => return Ok(bignum.sub(h, a, b)),
            2 => return Ok(bignum.mul(h, a, b)),
            _ => {
                let Some((q, r)) = bignum.divmod(h, a, b, false) else { return Err(rt.err_msg(c, "/: division by zero")); };
                if r == V.Int(0) { return Ok(q); }
            }
        }
    }
    let Some(x) = value.to_num(a) else { return Err(rt.type_err(c, name, "number", a)); };
    let Some(y) = value.to_num(b) else { return Err(rt.type_err(c, name, "number", b)); };
    Ok(V.Num(match op { 0 => x + y, 1 => x - y, 2 => x * y, _ => x / y }))
}

/// `arith` for the ops' cold paths, which are safepoints: a bignum
/// result is allocated here, so collect if due (the result is a traced
/// local, the operands are in the vm's registers).
#[cold]
pub fn arith_gc(c: *Ctx, op: i32, a: V, b: V) -> Result<V, V> uses gc {
    let r = arith(c, op, a, b)?;
    if c.heap.allocated > c.heap.threshold { gc.collect(&c.heap); }
    Ok(r)
}

/// `intdiv` for the ops' cold paths (see `arith_gc`).
#[cold]
pub fn intdiv_gc(c: *Ctx, op: i32, a: V, b: V) -> Result<V, V> uses gc {
    let r = intdiv(c, op, a, b)?;
    if c.heap.allocated > c.heap.threshold { gc.collect(&c.heap); }
    Ok(r)
}

/// Comparison: op 0 =, 1 <, 2 >, 3 <=, 4 >=. Exact: a bignum and a
/// flonum compare by their values, not after rounding the bignum.
pub fn compare(c: *Ctx, op: i32, a: V, b: V) -> Result<bool, V> {
    if let (Int(x), Int(y)) = (a, b) {
        return Ok(match op { 0 => x == y, 1 => x < y, 2 => x > y, 3 => x <= y, _ => x >= y });
    }
    let name = match op { 0 => "=", 1 => "<", 2 => ">", 3 => "<=", _ => ">=" };
    let Some(x) = value.to_num(a) else { return Err(rt.type_err(c, name, "number", a)); };
    let Some(y) = value.to_num(b) else { return Err(rt.type_err(c, name, "number", b)); };
    var r: i32 = 0;
    match (a, b) {
        (Big(_), Big(_)) | (Big(_), Int(_)) | (Int(_), Big(_)) => r = bignum.cmp(a, b),
        (Big(_), Num(f)) => { if f != f { return Ok(false); } r = bignum.cmp_float(a, f); }
        (Num(f), Big(_)) => { if f != f { return Ok(false); } r = 0 - bignum.cmp_float(b, f); }
        _ => return Ok(match op { 0 => x == y, 1 => x < y, 2 => x > y, 3 => x <= y, _ => x >= y }),
    }
    Ok(match op { 0 => r == 0, 1 => r < 0, 2 => r > 0, 3 => r <= 0, _ => r >= 0 })
}

fn num_arg(c: *Ctx, who: str, v: V) -> Result<f64, V> {
    match value.to_num(v) {
        Some(x) => Ok(x),
        None => Err(rt.type_err(c, who, "number", v)),
    }
}

/// An integer argument: exact, or a flonum with an integral value.
fn int_check(c: *Ctx, who: str, v: V) -> Result<(), V> {
    match v {
        Int(_) | Big(_) => Ok(()),
        Num(x) => {
            if x == x.floor() and x - x == 0.0 { return Ok(()); }
            Err(rt.type_err(c, who, "integer", v))
        }
        _ => Err(rt.type_err(c, who, "integer", v)),
    }
}

/// An integer argument as an exact integer (an integral flonum is
/// converted exactly).
fn exact_arg(c: *Ctx, who: str, v: V) -> Result<V, V> {
    int_check(c, who, v)?;
    match v {
        Num(x) => Ok(bignum.of_f64(&c.heap, x).unwrap()),
        _ => Ok(v),
    }
}

/// Integer division: op 0 quotient (truncate-quotient), 1 remainder
/// (truncate-remainder), 2 modulo (floor-remainder), 3 floor-quotient.
/// Exact for exact arguments; with a flonum argument, the result is a
/// flonum.
pub fn intdiv(c: *Ctx, op: i32, a: V, b: V) -> Result<V, V> {
    let who = match op { 0 => "quotient", 1 => "remainder", 2 => "modulo", _ => "floor-quotient" };
    if let (Int(x0), Int(y0)) = (a, b) {
        let (x, y) = (x0 as i64, y0 as i64);
        if y == 0 { return Err(rt.err_msg(c, "integer division by zero")); }
        let q = x / y;
        let r = x % y;
        let fix = r != 0 and (r < 0) != (y < 0);
        let v = match op {
            0 => q,
            1 => r,
            2 => if fix { r + y } else { r },
            _ => if fix { q - 1 } else { q },
        };
        return Ok(bignum.of_i64(&c.heap, v));
    }
    int_check(c, who, a)?;
    int_check(c, who, b)?;
    if bignum.is_exact(a) and bignum.is_exact(b) {
        let floor = op >= 2;
        let Some((q, r)) = bignum.divmod(&c.heap, a, b, floor) else {
            return Err(rt.err_msg(c, "integer division by zero"));
        };
        return Ok(if op == 0 or op == 3 { q } else { r });
    }
    let x = num_arg(c, who, a)?;
    let y = num_arg(c, who, b)?;
    if y == 0.0 { return Err(rt.err_msg(c, "integer division by zero")); }
    let r = fmod(x, y);
    let fix = r != 0.0 and (r < 0.0) != (y < 0.0);
    Ok(V.Num(match op {
        0 => (x - r) / y,
        1 => r,
        2 => if fix { r + y } else { r },
        _ => { let q = (x - r) / y; if fix { q - 1.0 } else { q } }
    }))
}

fn round_like(c: *Ctx, op: i32, v: V) -> Result<V, V> {
    if bignum.is_exact(v) { return Ok(v); }
    let x = num_arg(c, "round", v)?;
    Ok(V.Num(match op { 0 => x.floor(), 1 => ceil(x), 2 => rint(x), _ => trunc(x) }))
}

fn expt(c: *Ctx, a: V, b: V) -> Result<V, V> {
    if bignum.is_exact(a) and bignum.is_exact(b) and bignum.sign(b) >= 0 {
        // 0, 1 and -1 to any power are small; otherwise the exponent
        // must be a fixnum for the result to fit in memory.
        if a == V.Int(0) or a == V.Int(1) {
            return Ok(if b == V.Int(0) { V.Int(1) } else { a });
        }
        if a == V.Int(-1) { return Ok(if bignum.is_odd(b) { a } else { V.Int(1) }); }
        if let (Int(x), Int(y)) = (a, b) {
            // |x| >= 2: a fixnum result takes at most 31 steps.
            var r: i64 = 1;
            var ok = true;
            for _ in 0..y as u64 {
                r = r * x as i64;
                if r > 2147483647 or r < -2147483648 { ok = false; break; }
            }
            if ok { return Ok(V.Int(r as i32)); }
        }
        if let Int(e) = b and let Some(r) = bignum.pow(&c.heap, a, e as u64) { return Ok(r); }
        return Err(rt.err(c, "expt: result too large, exponent", b));
    }
    let x = num_arg(c, "expt", a)?;
    let y = num_arg(c, "expt", b)?;
    Ok(V.Num(pow(x, y)))
}

/// sqrt: exact for an exact perfect square, else a flonum.
fn sqrt(c: *Ctx, a: V) -> Result<V, V> {
    if let Int(x) = a and x >= 0 {
        let r = (x as f64).sqrt() as i64;
        if r * r == x as i64 { return Ok(V.Int(r as i32)); }
    }
    if let Big(_) = a and bignum.sign(a) > 0 {
        let s = bignum.isqrt(&c.heap, a).unwrap();
        if bignum.cmp(bignum.mul(&c.heap, s, s), a) == 0 { return Ok(s); }
        let f = bignum.to_f64(a);
        // Beyond the flonum range, the root of the integer part is as close.
        if f - f != 0.0 { return Ok(V.Num(bignum.to_f64(s))); }
        return Ok(V.Num(f.sqrt()));
    }
    let x = num_arg(c, "sqrt", a)?;
    Ok(V.Num(x.sqrt()))
}

/// exact-integer-sqrt's root (the prelude computes the remainder).
fn isqrt(c: *Ctx, a: V) -> Result<V, V> {
    if bignum.is_exact(a) and bignum.sign(a) >= 0 {
        if let Int(x) = a {
            var r = (x as f64).sqrt() as i64;
            while r * r > x as i64 { r -= 1; }
            while (r + 1) * (r + 1) <= x as i64 { r += 1; }
            return Ok(V.Int(r as i32));
        }
        return Ok(bignum.isqrt(&c.heap, a).unwrap());
    }
    Err(rt.type_err(c, "exact-integer-sqrt", "non-negative exact integer", a))
}

/// A radix argument of number->string or string->number.
fn radix_arg(c: *Ctx, who: str, v: V) -> Result<u32, V> {
    if let Int(r) = v and (r == 2 or r == 8 or r == 10 or r == 16) { return Ok(r as u32); }
    Err(rt.type_err(c, who, "radix (2, 8, 10 or 16)", v))
}

// ── argument helpers ────────────────────────────────────────────────

fn pair_arg(c: *Ctx, who: str, v: V) -> Result<Gc<Pair>, V> {
    match v {
        P(p) => Ok(p),
        _ => Err(rt.type_err(c, who, "pair", v)),
    }
}

fn str_arg(c: *Ctx, who: str, v: V) -> Result<Gc<Str>, V> {
    match v {
        S(s) => Ok(s),
        _ => Err(rt.type_err(c, who, "string", v)),
    }
}

fn vec_arg(c: *Ctx, who: str, v: V) -> Result<Gc<Vect>, V> {
    match v {
        Vec(x) => Ok(x),
        _ => Err(rt.type_err(c, who, "vector", v)),
    }
}

fn char_arg(c: *Ctx, who: str, v: V) -> Result<i32, V> {
    match value.char_of(v) {
        Some(x) => Ok(x),
        None => Err(rt.type_err(c, who, "char", v)),
    }
}

fn index_arg(c: *Ctx, who: str, v: V, len: u64) -> Result<u64, V> {
    if let Int(i) = v and i >= 0 and (i as u64) < len { return Ok(i as u64); }
    if let Int(_) = v { return Err(rt.err(c, "index out of range", v)); }
    Err(rt.type_err(c, who, "index", v))
}

/// cXr: `path` is read right to left ('a' car, 'd' cdr).
fn cxr(c: *Ctx, who: str, path: str, v: V) -> Result<V, V> {
    var x = v;
    var i = path.len;
    while i > 0 {
        i -= 1;
        let p = pair_arg(c, who, x)?;
        x = if path[i] == 'a' { p.car } else { p.cdr };
    }
    Ok(x)
}

fn list_len(l: V) -> ?u64 {
    var n: u64 = 0;
    var cur = l;
    loop {
        match cur {
            P(p) => { n += 1; cur = p.cdr; }
            _ => break,
        }
    }
    if cur != value.nil() { return None; }
    Some(n)
}

/// A string as a list of chars.
fn str_to_list(h: *gc.Heap, s: Gc<Str>) -> V {
    var l = value.nil();
    var i = s.data.len;
    while i > 0 {
        i -= 1;
        l = value.cons(h, value.chr(s.data[i] as i32), l);
    }
    l
}

fn str_cmp(a: Gc<Str>, b: Gc<Str>) -> i32 {
    let n = if a.data.len < b.data.len { a.data.len } else { b.data.len };
    for i in 0..n {
        if a.data[i] != b.data[i] { return if a.data[i] < b.data[i] { -1 } else { 1 }; }
    }
    if a.data.len < b.data.len { -1 } else if a.data.len > b.data.len { 1 } else { 0 }
}

fn chars_to_str(c: *Ctx, l: V) -> Result<V, V> {
    c.tmp.clear();
    var cur = l;
    while let P(p) = cur {
        let ch = char_arg(c, "list->string", p.car)?;
        value.push_utf8(&c.tmp, ch);
        cur = p.cdr;
    }
    Ok(V.S(value.new_str(&c.heap, c.tmp.as_str())))
}

fn mem_search(c: *Ctx, kind: i32, x: V, l: V) -> V {
    let _ = c;
    var cur = l;
    while let P(p) = cur {
        let hit = match kind { 0 => p.car == x, 1 => value.eqv(p.car, x), _ => value.equal(p.car, x) };
        if hit { return cur; }
        cur = p.cdr;
    }
    value.f()
}

fn ass_search(c: *Ctx, kind: i32, x: V, l: V) -> Result<V, V> {
    var cur = l;
    while let P(p) = cur {
        let e = pair_arg(c, "assoc", p.car)?;
        let hit = match kind { 0 => e.car == x, 1 => value.eqv(e.car, x), _ => value.equal(e.car, x) };
        if hit { return Ok(p.car); }
        cur = p.cdr;
    }
    Ok(value.f())
}

pub fn emit(c: *Ctx, v: V, write: bool) {
    value.print(&c.out, v, write);
    if c.out.bytes.len > 65536 { c.flush(); }
}

/// (error msg irritant ...) → "msg irritant ..."
fn error_value(c: *Ctx, args: *V, n: u64) -> V {
    var b = text.StrBuf.new();
    for i in 0..n {
        if i > 0 { b.push(' '); }
        value.print(&b, args[i], i > 0);
    }
    let s = value.new_str(&c.heap, b.as_str());
    b.free();
    V.S(s)
}

// ── dispatch ────────────────────────────────────────────────────────

/// Call builtin `p` with arguments args[0..n].
pub fn call_native(c: *Ctx, p: Prim, args: *V, n: u64) -> Result<V, V> {
    let id = p as i32;
    let (name, lo, hi) = (p.name(), p.min(), p.max());
    if (n as i32) < lo or (hi >= 0 and (n as i32) > hi) {
        c.tmp.clear();
        c.tmp.push_str(name);
        c.tmp.push_str(": wrong number of arguments (");
        c.tmp.push_int(n as i64);
        c.tmp.push_str(")");
        return Err(V.S(value.new_str(&c.heap, c.tmp.as_str())));
    }
    let h = &c.heap;
    let a = if n > 0 { args[0] } else { value.unspec() };
    let b = if n > 1 { args[1] } else { value.unspec() };
    match p {
        Prim.Add | Prim.Mul => {
            var acc = V.Int(if p == Prim.Add { 0 } else { 1 });
            for i in 0..n { acc = arith(c, id, acc, args[i])?; }
            Ok(acc)
        }
        Prim.Sub | Prim.Div => {
            if n == 1 { return arith(c, id, V.Int(if p == Prim.Sub { 0 } else { 1 }), a); }
            var acc = a;
            for i in 1..n { acc = arith(c, id, acc, args[i])?; }
            Ok(acc)
        }
        Prim.NumEq | Prim.Lt | Prim.Gt | Prim.Le | Prim.Ge => {
            var ok = true;
            if n == 1 { num_arg(c, name, a)?; }
            for i in 1..n {
                if !compare(c, id - 4, args[i - 1], args[i])? { ok = false; }
            }
            Ok(value.boolean(ok))
        }
        Prim.Quotient | Prim.Remainder | Prim.Modulo => intdiv(c, id - 9, a, b),
        Prim.ZeroP => Ok(value.boolean(num_arg(c, name, a)? == 0.0)),
        Prim.NumberP => Ok(value.boolean(value.is_number(a))),
        Prim.IntegerP => {
            match a {
                Int(_) | Big(_) => Ok(value.t()),
                Num(x) => Ok(value.boolean(x == x.floor())),
                _ => Ok(value.f()),
            }
        }
        Prim.Abs => {
            match a {
                Int(x) => Ok(if x < 0 { bignum.of_i64(h, 0 - (x as i64)) } else { a }),
                Big(_) => Ok(if bignum.sign(a) < 0 { bignum.neg(h, a) } else { a }),
                _ => { let x = num_arg(c, name, a)?; Ok(V.Num(if x < 0.0 { 0.0 - x } else { x })) }
            }
        }
        Prim.Min | Prim.Max => {
            var acc = a;
            num_arg(c, name, a)?;
            var inexact = false;
            for i in 0..n {
                if let Num(_) = args[i] { inexact = true; }
                if i == 0 { continue; }
                let less = compare(c, 1, args[i], acc)?;
                if (p == Prim.Min and less) or (p == Prim.Max and !less and !compare(c, 0, args[i], acc)?) { acc = args[i]; }
            }
            if inexact { acc = V.Num(value.to_num(acc).unwrap()); }
            Ok(acc)
        }
        Prim.Sqrt => sqrt(c, a),
        Prim.ExactToInexact | Prim.Inexact => Ok(V.Num(num_arg(c, name, a)?)),
        Prim.InexactToExact | Prim.Exact => {
            match a {
                Int(_) | Big(_) => Ok(a),
                Num(x) => {
                    if x == x.floor() and x - x == 0.0 { return Ok(bignum.of_f64(h, x).unwrap()); }
                    Err(rt.err(c, "inexact->exact: no exact representation for", a))
                }
                _ => Err(rt.type_err(c, name, "number", a)),
            }
        }
        Prim.Floor | Prim.Ceiling | Prim.Round | Prim.Truncate => round_like(c, id - 23, a),
        Prim.Expt => expt(c, a, b),
        Prim.EvenP | Prim.OddP => {
            int_check(c, name, a)?;
            let odd = match a { Num(x) => fmod(x, 2.0) != 0.0, _ => bignum.is_odd(a) };
            Ok(value.boolean(odd == (p == Prim.OddP)))
        }
        Prim.PositiveP => Ok(value.boolean(num_arg(c, name, a)? > 0.0)),
        Prim.NegativeP => Ok(value.boolean(num_arg(c, name, a)? < 0.0)),
        Prim.NumberToString => {
            num_arg(c, name, a)?;
            let radix = if n > 1 { radix_arg(c, name, b)? } else { 10 };
            c.tmp.clear();
            if bignum.is_exact(a) { bignum.write(&c.tmp, a, radix); } else { value.print(&c.tmp, a, false); }
            Ok(V.S(value.new_str(h, c.tmp.as_str())))
        }
        Prim.StringToNumber => {
            let s = str_arg(c, name, a)?;
            let radix = if n > 1 { radix_arg(c, name, b)? } else { 10 };
            match read.parse_number(h, s.data, radix) {
                Some(v) => Ok(v),
                None => Ok(value.f()),
            }
        }
        Prim.Gcd | Prim.Lcm => {
            var acc = V.Int(if p == Prim.Gcd { 0 } else { 1 });
            var inexact = false;
            for i in 0..n {
                if let Num(_) = args[i] { inexact = true; }
                let x = exact_arg(c, name, args[i])?;
                let g = bignum.gcd(h, acc, x);
                if p == Prim.Gcd {
                    acc = g;
                } else if g == V.Int(0) {
                    acc = g;
                } else {
                    let (q, _) = bignum.divmod(h, x, g, false).unwrap();
                    acc = bignum.mul(h, acc, q);
                    if bignum.sign(acc) < 0 { acc = bignum.neg(h, acc); }
                }
            }
            if inexact { return Ok(V.Num(bignum.to_f64(acc))); }
            Ok(acc)
        }
        Prim.ExactP => { num_arg(c, name, a)?; Ok(value.boolean(bignum.is_exact(a))) }
        Prim.InexactP => { num_arg(c, name, a)?; Ok(value.boolean(a is Num)) }
        Prim.Cons => Ok(value.cons(h, a, b)),
        Prim.Car => Ok(pair_arg(c, name, a)?.car),
        Prim.Cdr => Ok(pair_arg(c, name, a)?.cdr),
        Prim.SetCar => { pair_arg(c, name, a)?.car = b; Ok(value.unspec()) }
        Prim.SetCdr => { pair_arg(c, name, a)?.cdr = b; Ok(value.unspec()) }
        Prim.List => {
            var l = value.nil();
            var i = n;
            while i > 0 { i -= 1; l = value.cons(h, args[i], l); }
            Ok(l)
        }
        Prim.Length => {
            match list_len(a) {
                Some(k) => Ok(V.Int(k as i32)),
                None => Err(rt.type_err(c, name, "list", a)),
            }
        }
        Prim.Append => {
            if n == 0 { return Ok(value.nil()); }
            var result = args[n - 1];
            var i = n - 1;
            while i > 0 {
                i -= 1;
                // Copy args[i] in front of result.
                let l = args[i];
                if list_len(l).is_none() { return Err(rt.type_err(c, name, "list", l)); }
                var head = value.nil();
                var tail: ?Gc<Pair> = None;
                var cur = l;
                while let P(p) = cur {
                    let cell = new(h, Pair { car: p.car, cdr: value.nil() });
                    match tail {
                        Some(t) => t.cdr = V.P(cell),
                        None => head = V.P(cell),
                    }
                    tail = Some(cell);
                    cur = p.cdr;
                }
                if let Some(t) = tail { t.cdr = result; result = head; }
            }
            Ok(result)
        }
        Prim.Reverse => {
            var r = value.nil();
            var cur = a;
            while let P(p) = cur { r = value.cons(h, p.car, r); cur = p.cdr; }
            if cur != value.nil() { return Err(rt.type_err(c, name, "list", a)); }
            Ok(r)
        }
        Prim.ListTail | Prim.ListRef => {
            let Int(k) = b else { return Err(rt.type_err(c, name, "index", b)); };
            var cur = a;
            for _ in 0..k as u64 {
                cur = pair_arg(c, name, cur)?.cdr;
            }
            if p == Prim.ListTail { Ok(cur) } else { Ok(pair_arg(c, name, cur)?.car) }
        }
        Prim.Memq | Prim.Memv | Prim.Member => Ok(mem_search(c, id - 49, a, b)),
        Prim.Assq | Prim.Assv | Prim.Assoc => ass_search(c, id - 52, a, b),
        Prim.Caar => cxr(c, name, "aa", a),
        Prim.Cadr => cxr(c, name, "ad", a),
        Prim.Cdar => cxr(c, name, "da", a),
        Prim.Cddr => cxr(c, name, "dd", a),
        Prim.Caddr => cxr(c, name, "add", a),
        Prim.Cdddr => cxr(c, name, "ddd", a),
        Prim.Cadddr => cxr(c, name, "addd", a),
        Prim.NullP => Ok(value.boolean(a == value.nil())),
        Prim.PairP => Ok(value.boolean(a is P)),
        Prim.ListP => Ok(value.boolean(list_len(a).is_some())),
        Prim.EqP => Ok(value.boolean(a == b)),
        Prim.EqvP => Ok(value.boolean(value.eqv(a, b))),
        Prim.EqualP => Ok(value.boolean(value.equal(a, b))),
        Prim.Not => Ok(value.boolean(a == value.f())),
        Prim.SymbolP => Ok(value.boolean(a is Sym)),
        Prim.StringP => Ok(value.boolean(a is S)),
        Prim.ProcedureP => Ok(value.boolean(value.is_procedure(a))),
        Prim.VectorP => Ok(value.boolean(match a { Vec(x) => x.rtd == value.nil(), _ => false })),
        Prim.BooleanP => Ok(value.boolean(a == value.t() or a == value.f())),
        Prim.CharP => Ok(value.boolean(value.char_of(a).is_some())),
        Prim.MakeVector => {
            let Int(k) = a else { return Err(rt.type_err(c, name, "length", a)); };
            if k < 0 { return Err(rt.type_err(c, name, "length", a)); }
            let fill = if n > 1 { b } else { value.unspec() };
            Ok(V.Vec(value.new_vect(h, k as u64, fill)))
        }
        Prim.Vector => {
            let v = value.new_vect(h, n, value.unspec());
            for i in 0..n { v.data.ptr[i] = args[i]; }
            Ok(V.Vec(v))
        }
        Prim.VectorRef => {
            let v = vec_arg(c, name, a)?;
            let i = index_arg(c, name, b, v.data.len)?;
            Ok(v.data.ptr[i])
        }
        Prim.VectorSet => {
            let v = vec_arg(c, name, a)?;
            let i = index_arg(c, name, b, v.data.len)?;
            v.data.ptr[i] = args[2];
            Ok(value.unspec())
        }
        Prim.VectorLength => Ok(V.Int(vec_arg(c, name, a)?.data.len as i32)),
        Prim.VectorToList => {
            let v = vec_arg(c, name, a)?;
            var l = value.nil();
            var i = v.data.len;
            while i > 0 { i -= 1; l = value.cons(h, v.data.ptr[i], l); }
            Ok(l)
        }
        Prim.ListToVector => {
            if list_len(a).is_none() { return Err(rt.type_err(c, name, "list", a)); }
            Ok(V.Vec(read.list_to_vect(h, a)))
        }
        Prim.VectorFill => {
            let v = vec_arg(c, name, a)?;
            for i in 0..v.data.len { v.data.ptr[i] = b; }
            Ok(value.unspec())
        }
        Prim.StringLength => Ok(V.Int(str_arg(c, name, a)?.data.len as i32)),
        Prim.StringRef => {
            let s = str_arg(c, name, a)?;
            let i = index_arg(c, name, b, s.data.len)?;
            Ok(value.chr(s.data[i] as i32))
        }
        Prim.Substring => {
            let s = str_arg(c, name, a)?;
            let len = s.data.len;
            let start = index_arg(c, name, b, len + 1)?;
            let end = if n > 2 { index_arg(c, name, args[2], len + 1)? } else { len };
            if end < start { return Err(rt.err(c, "substring: end before start", args[2])); }
            Ok(V.S(value.new_str(h, s.data[start..end])))
        }
        Prim.StringAppend => {
            // One copy: size the result first.
            var len: u64 = 0;
            for i in 0..n { len += str_arg(c, name, args[i])?.data.len; }
            let r = new_uninit(h, Str {}, len);
            var at: u64 = 0;
            for i in 0..n {
                let Ok(s) = str_arg(c, name, args[i]) else { break; };
                mem.memcpy(r.data.ptr + at, s.data.ptr, s.data.len);
                at += s.data.len;
            }
            Ok(V.S(r))
        }
        Prim.StringEqP | Prim.StringLtP | Prim.StringGtP | Prim.StringLeP | Prim.StringGeP => {
            let x = str_arg(c, name, a)?;
            let y = str_arg(c, name, b)?;
            let r = str_cmp(x, y);
            Ok(value.boolean(match id { 87 => r == 0, 88 => r < 0, 89 => r > 0, 120 => r <= 0, _ => r >= 0 }))
        }
        Prim.StringCopy => Ok(V.S(value.new_str(h, str_arg(c, name, a)?.data))),
        Prim.StringToList => Ok(str_to_list(h, str_arg(c, name, a)?)),
        Prim.ListToString => chars_to_str(c, a),
        Prim.MakeString => {
            let Int(k) = a else { return Err(rt.type_err(c, name, "length", a)); };
            if k < 0 { return Err(rt.type_err(c, name, "length", a)); }
            let ch = if n > 1 { char_arg(c, name, b)? } else { 32 };
            let s = new_uninit(h, Str {}, k as u64);
            for i in 0..k as u64 { s.data[i] = ch as u8; }
            Ok(V.S(s))
        }
        Prim.String => {
            c.tmp.clear();
            for i in 0..n {
                let ch = char_arg(c, name, args[i])?;
                value.push_utf8(&c.tmp, ch);
            }
            Ok(V.S(value.new_str(h, c.tmp.as_str())))
        }
        Prim.SymbolToString => {
            let Sym(s) = a else { return Err(rt.type_err(c, name, "symbol", a)); };
            if let S(_) = s.sname { return Ok(s.sname); }
            let r = V.S(value.new_str(h, s.name));
            s.sname = r;
            Ok(r)
        }
        Prim.StringToSymbol => {
            let s = str_arg(c, name, a)?;
            Ok(V.Sym(c.syms.intern(h, s.data)))
        }
        Prim.CharToInteger => Ok(V.Int(char_arg(c, name, a)?)),
        Prim.IntegerToChar => {
            let Int(k) = a else { return Err(rt.type_err(c, name, "integer", a)); };
            if k < 0 or k > 0x10FFFF { return Err(rt.err(c, "integer->char: out of range", a)); }
            Ok(value.chr(k))
        }
        Prim.CharEqP | Prim.CharLtP | Prim.CharGtP | Prim.CharLeP | Prim.CharGeP => {
            let x = char_arg(c, name, a)?;
            let y = char_arg(c, name, b)?;
            Ok(value.boolean(match id { 99 => x == y, 100 => x < y, 101 => x > y, 118 => x <= y, _ => x >= y }))
        }
        Prim.CharUpcase => {
            let x = char_arg(c, name, a)?;
            Ok(value.chr(if x >= 'a' as i32 and x <= 'z' as i32 { x - 32 } else { x }))
        }
        Prim.CharDowncase => {
            let x = char_arg(c, name, a)?;
            Ok(value.chr(if x >= 'A' as i32 and x <= 'Z' as i32 { x + 32 } else { x }))
        }
        Prim.CharAlphabeticP => {
            let x = char_arg(c, name, a)?;
            Ok(value.boolean((x >= 'a' as i32 and x <= 'z' as i32) or (x >= 'A' as i32 and x <= 'Z' as i32)))
        }
        Prim.CharNumericP => {
            let x = char_arg(c, name, a)?;
            Ok(value.boolean(x >= '0' as i32 and x <= '9' as i32))
        }
        Prim.CharWhitespaceP => {
            let x = char_arg(c, name, a)?;
            Ok(value.boolean(x == 32 or x == 9 or x == 10 or x == 13 or x == 12))
        }
        Prim.StringSet => {
            let s = str_arg(c, name, a)?;
            let i = index_arg(c, name, b, s.data.len)?;
            let ch = char_arg(c, name, args[2])?;
            s.data[i] = ch as u8;
            Ok(value.unspec())
        }
        Prim.Display | Prim.WriteString | Prim.WriteChar => { emit(c, a, false); Ok(value.unspec()) }
        Prim.Write => { emit(c, a, true); Ok(value.unspec()) }
        Prim.Newline => {
            c.out.push('\n');
            if c.out.bytes.len > 65536 { c.flush(); }
            Ok(value.unspec())
        }
        Prim.Error => Err(error_value(c, args, n)),
        Prim.Exit => {
            c.flush();
            var code: i32 = 0;
            if let Int(k) = a { code = k; }
            if a == value.f() { code = 1; }
            os.quit(code)
        }
        Prim.LastPair => {
            var p = pair_arg(c, name, a)?;
            while let P(q) = p.cdr { p = q; }
            Ok(V.P(p))
        }
        Prim.ListCopy => {
            var head = value.nil();
            var tail: ?Gc<Pair> = None;
            var cur = a;
            while let P(p) = cur {
                let cell = new(h, Pair { car: p.car, cdr: value.nil() });
                match tail {
                    Some(t) => t.cdr = V.P(cell),
                    None => head = V.P(cell),
                }
                tail = Some(cell);
                cur = p.cdr;
            }
            if let Some(t) = tail { t.cdr = cur; }
            Ok(head)
        }
        Prim.EofObject => Ok(V.Imm(value.IMM_EOF)),
        Prim.SymbolEqP => Ok(value.boolean(a == b)),
        Prim.BooleanEqP => Ok(value.boolean(a == b)),
        Prim.Square => arith(c, 2, a, a),
        Prim.Read => Ok(read_stdin(c)),
        Prim.CurrentOutputPort => Ok(value.unspec()),
        Prim.FlushOutputPort => { c.flush(); Ok(value.unspec()) }
        Prim.CurrentSecond => Ok(V.Num((now_us() as f64) / 1000000.0)),
        Prim.CurrentJiffy => {
            let t = now_us();
            if JIFFY0 < 0 { JIFFY0 = t; }
            let d = t - JIFFY0;
            Ok(bignum.of_i64(h, d))
        }
        Prim.JiffiesPerSecond => Ok(V.Int(1000000)),
        Prim.EofObjectP => Ok(value.boolean(a == V.Imm(value.IMM_EOF))),
        Prim.Exp => { if a == V.Int(0) { return Ok(V.Int(1)); } Ok(V.Num(exp(num_arg(c, name, a)?))) }
        Prim.Log => {
            if a == V.Int(1) and n == 1 { return Ok(V.Int(0)); }
            let x = log(num_arg(c, name, a)?);
            if n == 2 { return Ok(V.Num(x / log(num_arg(c, name, b)?))); }
            Ok(V.Num(x))
        }
        Prim.Sin | Prim.Cos | Prim.Tan | Prim.Asin | Prim.Acos => {
            let x = num_arg(c, name, a)?;
            if a == V.Int(0) and id != 137 and id != 140 { return Ok(a); }
            Ok(V.Num(match id { 136 => sin(x), 137 => cos(x), 138 => tan(x), 139 => asin(x), _ => acos(x) }))
        }
        Prim.Atan => {
            let y = num_arg(c, name, a)?;
            if n == 2 { return Ok(V.Num(atan2(y, num_arg(c, name, b)?))); }
            if a == V.Int(0) { return Ok(a); }
            Ok(V.Num(atan(y)))
        }
        Prim.ExactIntegerP => Ok(value.boolean(bignum.is_exact(a))),
        Prim.FloorQuotient => intdiv(c, 3, a, b),
        Prim.ExactIntegerSqrt => isqrt(c, a),
        // Records (define-record-type expands into these; see compile.lm).
        Prim.Record => {
            let r = value.new_vect(h, n - 1, value.f());
            r.rtd = a;
            for i in 1..n { r.data.ptr[i - 1] = args[i]; }
            Ok(V.Vec(r))
        }
        Prim.RecordP => Ok(value.boolean(match b { Vec(x) => x.rtd == a, _ => false })),
        Prim.RecordRef | Prim.RecordSet => {
            let Vec(r) = b else { return Err(record_err(c, a, b)); };
            if r.rtd != a { return Err(record_err(c, a, b)); }
            let Int(i) = args[2] else { return Err(rt.err_msg(c, "record: internal error")); };
            if p == Prim.RecordRef { return Ok(r.data.ptr[i as u64]); }
            r.data.ptr[i as u64] = args[3];
            Ok(value.unspec())
        }
        _ => Err(rt.err_msg(c, "apply: internal error")),
    }
}
