// The Scheme virtual machine: a register machine. Each procedure
// activation owns a window of registers; a call puts the procedure in
// R[base] and the arguments in R[base+1..], and the callee's window
// starts at R[base+1], so arguments arrive in place. The result is stored
// back into the caller's R[base]. Tail calls reuse the current frame.

import std.gc;
import std.io;
import std.text;
import std.os;
import value;
import value.{V, Pair, Vect, Proto, Closure, Lines, Protos, Descs};
import rt.{Ctx, Frame};
import rt;
import builtins;
import builtins.{Prim};

fn arity_err(c: *Ctx, cl: Gc<Closure>, n: u64) -> V {
    c.tmp.clear();
    c.tmp.push_str(cl.proto.name.data);
    c.tmp.push_str(": wrong number of arguments (expected ");
    c.tmp.push_int(cl.proto.nparams as i64);
    if cl.proto.rest != 0 { c.tmp.push_str(" or more"); }
    c.tmp.push_str(", got ");
    c.tmp.push_int(n as i64);
    c.tmp.push_str(")");
    V.S(value.new_str(&c.heap, c.tmp.as_str()))
}

fn unbound_err(c: *Ctx, g: u64) -> V {
    c.tmp.clear();
    c.tmp.push_str("unbound variable: ");
    c.tmp.push_str(c.gsyms.at(g).name);
    V.S(value.new_str(&c.heap, c.tmp.as_str()))
}

/// vector-ref / vector-set! failure: the vector or the index is bad.
fn index_err(c: *Ctx, who: str, v: V, i: V) -> V {
    let Vec(_) = v else { return rt.type_err(c, who, "vector", v); };
    let Int(_) = i else { return rt.type_err(c, who, "index", i); };
    rt.err(c, "index out of range", i)
}

fn zero_slow(c: *Ctx, a: V) -> Result<V, V> {
    match a {
        Num(x) => Ok(value.boolean(x == 0.0)),
        Big(_) => Ok(value.f()),
        _ => Err(rt.type_err(c, "zero?", "number", a)),
    }
}

fn eqv_slow(a: V, b: V) -> V { value.boolean(value.eqv(a, b)) }

/// A record access of field constant `f`, (rtd . i), on `x` that failed.
fn record_fail(c: *Ctx, f: V, x: V) -> V {
    let P(d) = f else { return rt.err_msg(c, "record: internal error"); };
    builtins.record_err(c, d.car, x)
}

/// Source line of the instruction at `at` in `p` (0: unknown, e.g. prelude code).
fn line_at(p: Gc<Proto>, at: *u32) -> u32 {
    let i = p.code.index_of(at);
    if i < p.lines.data.len { p.lines.data[i] } else { 0 }
}

/// The prototype of escape continuations. A continuation is a closure of
/// it whose one free slot is the depth of its frame. call/cc pushes that
/// frame with R0 = the procedure and R1 = the continuation and runs this
/// code, which calls the procedure (never as a tail call, so the frame
/// stays put) and returns its result. Invoking the continuation (call_slow)
/// checks that the frame at that depth still belongs to it and returns from
/// it. Its `fixed` keeps CALL off the fast path.
pub fn cont_proto(h: *gc.Heap) -> Gc<Proto> {
    let words: [u32; 2] = [Scheme.CALL(0, 1), Scheme.RET(0)];
    let init = Proto {
        name: value.new_str(h, "continuation"),
        nparams: 1,
        rest: 0,
        fixed: value.CONT_FIXED,
        nregs: 2,
        nfree: 1,
        consts: value.new_arr(h, 0),
        lines: new(h, Lines {}, 0),
        protos: new(h, Protos {}, 0),
        desc: new(h, Descs {}, 0),
    };
    match Scheme.build_verified(h, init, words[..]) {
        Ok(p) => p,
        Err(e) => {
            var b = text.StrBuf.new();
            b.push_str("error: internal error: continuation code fails verification: ");
            e.write(&b);
            io.eprintln(b.as_str());
            os.quit(1)
        }
    }
}

/// A closure of `p` with more than 4 free variables (CLOSURE's rare case).
#[cold]
fn big_closure(h: *gc.Heap, parent: Gc<Closure>, p: Gc<Proto>, regs: *V) -> Gc<Closure> {
    let n = p.nfree as u64;
    let c = new(h, Closure { proto: p }, n);
    for j in 0..n {
        let d = p.desc.data.ptr[j];
        if d >= 256 {
            c.free.ptr[j] = regs[(d & 255) as u64];
        } else {
            c.free.ptr[j] = parent.free.ptr[d as u64];
        }
    }
    c
}

/// A vector (or record, by `rtd`) of the `n` values at `src`.
#[cold]
fn big_vect(h: *gc.Heap, rtd: V, src: *V, n: u64) -> Gc<Vect> {
    let v = new(h, Vect { rtd: rtd }, n);
    for i in 0..n { v.data.ptr[i] = src[i]; }
    v
}

#[require_verified]
pub vm Scheme {
    context ctx: *Ctx;
    state { pc: *u32, regs: *V, k: *V, fp: *Frame }

    // The generated verifier checks these against the prototype that
    // holds the code: Scheme.build_verified (compile.lm, `finish`)
    // creates the Proto, copies the words into its `code` and verifies
    // them there, with the Proto itself as `proto`.
    verify_context owner proto: Gc<Proto>;
    operand reg = regs[it] verify (it as u32) < proto.nregs;
    operand kst = k[it] const proto.consts.data.ptr verify (it as u64) < proto.consts.data.len;
    operand imm = it;
    operand simm = it;
    /// A global slot (allocated by the compiler, so always in range).
    operand gl = it;
    operand fv = it verify (it as u32) < proto.nfree;
    operand child = it verify (it as u64) < proto.protos.data.len;
    operand callbase = it verify (it as u32) < proto.nregs;
    operand label = pc + it verify is_insn_boundary(pc + it);

    encoding fixed(u32) {
        format ABC { op: 8, a: 8, b: 8, c: 8 }
        format ABsC { op: 8, a: 8, b: 8, sc: s8 }
        format ABx { op: 8, a: 8, bx: 16 }
        format AsBx { op: 8, a: 8, sbx: s16 }
        format sJ { op: 8, sj: s24 }
    }

    // The collector scans frames and registers up to ctx.fp.
    sync { ctx.fp = fp; }

    /// `#[poll(gc)]`: collect at the start of an op that allocates, then
    /// run it again; `gc_fall` goes on with the op instead.
    poll gc { if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); redo } } }
    poll gc_fall { if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } } }

    op LOADK(dst: reg, c: kst) : ABx { dst = c; next }
    op LOADI(dst: reg, v: simm) : AsBx { dst = Int(v as i32); next }
    op MOVE(dst: reg, src: reg) : ABC { dst = src; next }

    // Globals live in a slot vector indexed by the symbol's slot number,
    // which the compiler resolves, so a read is a load and an "unbound"
    // check. Once a global is bound it stays bound (there is no undefine),
    // so the first successful read quickens the instruction into
    // GETGLOBAL_B, which skips the check.
    family GETGLOBAL(dst: reg, g: gl) : ABx {
        generic {
            let v = ctx.gvals.ptr[g];
            if v == V.Imm(value.IMM_UNDEF) { raise unbound_err(ctx, g as u64) }
            dst = v;
            become GETGLOBAL_B;
            next
        }
        GETGLOBAL_B {
            dst = ctx.gvals.ptr[g];
            next
        }
    }
    /// Check that a global is bound (the inlined body of a top-level
    /// procedure runs only once its definition has).
    family CHKGLOBAL(unused: imm, g: gl) : ABx {
        generic {
            if ctx.gvals.ptr[g] == V.Imm(value.IMM_UNDEF) { raise unbound_err(ctx, g as u64) }
            become CHKGLOBAL_B;
            next
        }
        CHKGLOBAL_B { next }
    }
    /// set! of a global: it must already be bound.
    op SETGLOBAL(src: reg, g: gl) : ABx {
        if ctx.gvals.ptr[g] == V.Imm(value.IMM_UNDEF) { raise unbound_err(ctx, g as u64) }
        ctx.gvals.ptr[g] = src;
        next
    }
    op DEFGLOBAL(src: reg, g: gl) : ABx {
        ctx.gvals.ptr[g] = src;
        next
    }

    op GETFREE(dst: reg, i: fv) : ABC { dst = fp.cl.free.ptr[i]; next }
    /// Patch free slot `i` of the closure in R[c] (letrec of lambdas).
    op SETFREE(c: reg, i: imm, src: reg) : ABC {
        if let Clo(cl) = c { cl.free.ptr[i] = src; }
        next
    }
    /// Box R[r] (an assigned variable that is captured by a closure).
    #[poll(gc)] op MKBOX(r: reg) : ABC {
        let v = r;
        let b = new(&ctx.heap, Vect { rtd: V.Imm(value.IMM_NIL) }, 1);
        b.data.ptr[0] = v;
        r = Vec(b);
        next
    }
    op BOXGET(dst: reg, b: reg) : ABC {
        if let Vec(x) = b { dst = x.data.ptr[0]; }
        next
    }
    op BOXSET(b: reg, src: reg) : ABC {
        if let Vec(x) = b { x.data.ptr[0] = src; }
        next
    }
    /// R[dst] = a new closure of child prototype `i`, capturing values as
    /// its descriptors say.
    #[poll(gc)] op CLOSURE(dst: reg, i: child) : ABx {
        let parent = fp.cl;
        let p = parent.proto.protos.data.ptr[i];
        let n = p.nfree as u64;
        if n > 4 { cold { dst = Clo(big_closure(&ctx.heap, parent, p, regs)); next } }
        let Some(c) = try_closure(p, n) else cold {
            gc.make_room(&ctx.heap, size_of<Closure>() + n * size_of<V>());
            redo
        };
        for j in 0..n {
            let d = p.desc.data.ptr[j];
            if d >= 256 {
                c.free.ptr[j] = regs[(d & 255) as u64];
            } else {
                c.free.ptr[j] = parent.free.ptr[d as u64];
            }
        }
        dst = Clo(c);
        next
    }

    op JMP(target: label) : sJ { jump target }
    /// Jump if R[a] is #f.
    op TEST(a: reg, target: label) : AsBx {
        if a == V.Imm(value.IMM_FALSE) { jump target }
        next
    }
    /// Jump unless R[a] is #f.
    op TESTT(a: reg, target: label) : AsBx {
        if a != V.Imm(value.IMM_FALSE) { jump target }
        next
    }

    // Arithmetic: fixnum and flonum fast paths; mixed operands, bignums
    // and fixnum overflow (which produces a bignum) go to the cold path.
    // A bignum result is allocated there, so the cold path is also a
    // safepoint (builtins.arith_gc): a loop of bignum arithmetic that
    // makes no call or pair still collects.
    inline for (name, checked, sym, code) in [
        ("ADD", "add_checked", +, 0),
        ("SUB", "sub_checked", -, 1),
        ("MUL", "mul_checked", *, 2),
    ] {
        op #name(dst: reg, a: reg, b: reg) : ABC {
            match (a, b) {
                (Int(x), Int(y)) => if let Some(r) = x.#checked(y) { dst = Int(r); next },
                (Num(x), Num(y)) => { dst = Num(x sym y); next }
                _ => {}
            }
            cold { dst = builtins.arith_gc(ctx, code, a, b)?; next }
        }
    }
    /// R[dst] = R[a] + sc (a small signed constant).
    op ADDI(dst: reg, a: reg, sc: simm) : ABsC {
        if let Int(x) = a and let Some(r) = x.add_checked(sc as i32) { dst = Int(r); next }
        cold { dst = builtins.arith_gc(ctx, 0, a, Int(sc as i32))?; next }
    }
    /// quotient, remainder, modulo: fixnums with a positive divisor inline.
    op QUO(dst: reg, a: reg, b: reg) : ABC {
        if let (Int(x), Int(y)) = (a, b) and y > 0 { dst = Int(x / y); next }
        cold { dst = builtins.intdiv_gc(ctx, 0, a, b)?; next }
    }
    op REM(dst: reg, a: reg, b: reg) : ABC {
        if let (Int(x), Int(y)) = (a, b) and y > 0 { dst = Int(x % y); next }
        cold { dst = builtins.intdiv_gc(ctx, 1, a, b)?; next }
    }
    op MOD(dst: reg, a: reg, b: reg) : ABC {
        if let (Int(x), Int(y)) = (a, b) and y > 0 {
            let r = x % y;
            dst = Int(if r < 0 { r + y } else { r });
            next
        }
        cold { dst = builtins.intdiv_gc(ctx, 2, a, b)?; next }
    }
    op DIV(dst: reg, a: reg, b: reg) : ABC {
        if let (Num(x), Num(y)) = (a, b) { dst = Num(x / y); next }
        cold { dst = builtins.arith_gc(ctx, 3, a, b)?; next }
    }
    inline for (name, sym, code) in [
        ("NUMEQ", ==, 0),
        ("LT", <, 1),
        ("GT", >, 2),
        ("LE", <=, 3),
        ("GE", >=, 4),
    ] {
        op #name(dst: reg, a: reg, b: reg) : ABC {
            match (a, b) {
                (Int(x), Int(y)) => { dst = value.boolean(x sym y); next }
                (Num(x), Num(y)) => { dst = value.boolean(x sym y); next }
                _ => {}
            }
            cold { dst = value.boolean(builtins.compare(ctx, code, a, b)?); next }
        }
    }
    // Comparison with a small constant: (< n 2).
    inline for (name, sym, code) in [
        ("NUMEQI", ==, 0),
        ("LTI", <, 1),
        ("GTI", >, 2),
        ("LEI", <=, 3),
        ("GEI", >=, 4),
    ] {
        op #name(dst: reg, a: reg, sc: simm) : ABsC {
            if let Int(x) = a { dst = value.boolean(x sym (sc as i32)); next }
            cold { dst = value.boolean(builtins.compare(ctx, code, a, Int(sc as i32))?); next }
        }
    }
    op ZEROP(dst: reg, a: reg) : ABC {
        if let Int(x) = a { dst = value.boolean(x == 0); next }
        cold { dst = zero_slow(ctx, a)?; next }
    }
    op EQ(dst: reg, a: reg, b: reg) : ABC { dst = value.boolean(a == b); next }
    op EQV(dst: reg, a: reg, b: reg) : ABC {
        if a == b { dst = Imm(value.IMM_TRUE); next }
        cold { dst = eqv_slow(a, b); next }
    }
    op NOT(dst: reg, a: reg) : ABC { dst = value.boolean(a == V.Imm(value.IMM_FALSE)); next }
    op NULLP(dst: reg, a: reg) : ABC { dst = value.boolean(a == V.Imm(value.IMM_NIL)); next }
    op PAIRP(dst: reg, a: reg) : ABC {
        if let P(_) = a { dst = Imm(value.IMM_TRUE); next }
        dst = Imm(value.IMM_FALSE);
        next
    }

    // Type predicates.
    op SYMBOLP(dst: reg, a: reg) : ABC {
        if let Sym(_) = a { dst = Imm(value.IMM_TRUE); next }
        dst = Imm(value.IMM_FALSE);
        next
    }
    op NUMBERP(dst: reg, a: reg) : ABC {
        match a {
            Int(_) | Num(_) | Big(_) => { dst = Imm(value.IMM_TRUE); next }
            _ => { dst = Imm(value.IMM_FALSE); next }
        }
    }
    /// exact-integer?
    op FIXNUMP(dst: reg, a: reg) : ABC {
        match a {
            Int(_) | Big(_) => { dst = Imm(value.IMM_TRUE); next }
            _ => { dst = Imm(value.IMM_FALSE); next }
        }
    }
    op STRINGP(dst: reg, a: reg) : ABC {
        if let S(_) = a { dst = Imm(value.IMM_TRUE); next }
        dst = Imm(value.IMM_FALSE);
        next
    }
    op VECTORP(dst: reg, a: reg) : ABC {
        if let Vec(x) = a and x.rtd == V.Imm(value.IMM_NIL) { dst = Imm(value.IMM_TRUE); next }
        dst = Imm(value.IMM_FALSE);
        next
    }

    op CAR(dst: reg, a: reg) : ABC {
        if let P(p) = a { dst = p.car; next }
        raise rt.type_err(ctx, "car", "pair", a)
    }
    op CDR(dst: reg, a: reg) : ABC {
        if let P(p) = a { dst = p.cdr; next }
        raise rt.type_err(ctx, "cdr", "pair", a)
    }
    #[poll(gc)] op CONS(dst: reg, a: reg, b: reg) : ABC {
        let c = new(&ctx.heap, Pair { car: a, cdr: b });
        dst = P(c);
        next
    }
    /// R[dst] = (vector R[base] .. R[base+n-1]).
    #[poll(gc)] op VECTOR(dst: reg, base: callbase, n: imm) : ABC {
        let cnt = n as u64;
        let src = regs + base as u64;
        if cnt > 8 or cnt == 0 { cold { dst = Vec(big_vect(&ctx.heap, V.Imm(value.IMM_NIL), src, cnt)); next } }
        let Some(v) = try_vect(V.Imm(value.IMM_NIL), cnt) else cold {
            gc.make_room(&ctx.heap, size_of<Vect>() + cnt * size_of<V>());
            redo
        };
        for i in 0..cnt { v.data.ptr[i] = src[i]; }
        dst = Vec(v);
        next
    }
    /// R[dst] = a record of type R[base] with fields R[base+1] .. R[base+n]
    /// (the constructor of a define-record-type).
    #[poll(gc)] op RECORD(dst: reg, base: callbase, n: imm) : ABC {
        let cnt = n as u64;
        let src = regs + base as u64;
        if cnt > 8 or cnt == 0 { cold { dst = Vec(big_vect(&ctx.heap, src[0], src + 1, cnt)); next } }
        let Some(v) = try_vect(src[0], cnt) else cold {
            gc.make_room(&ctx.heap, size_of<Vect>() + cnt * size_of<V>());
            redo
        };
        for i in 0..cnt { v.data.ptr[i] = src[i + 1]; }
        dst = Vec(v);
        next
    }
    /// A closure of 1 to 4 slots or a vector of 1 to 8 without the allocator's refill
    /// (constant lengths: the zeroing is inline, not a memset call).
    fn try_closure(p: Gc<Proto>, n: u64) -> ?Gc<Closure> {
        if n <= 2 {
            if n == 1 { try_new(&ctx.heap, Closure { proto: p }, 1) }
            else if n == 2 { try_new(&ctx.heap, Closure { proto: p }, 2) }
            else { try_new(&ctx.heap, Closure { proto: p }, 0) }
        } else {
            if n == 3 { try_new(&ctx.heap, Closure { proto: p }, 3) } else { try_new(&ctx.heap, Closure { proto: p }, 4) }
        }
    }
    fn try_vect(rtd: V, n: u64) -> ?Gc<Vect> {
        if n <= 4 {
            if n <= 2 {
                if n == 1 { try_new(&ctx.heap, Vect { rtd: rtd }, 1) } else { try_new(&ctx.heap, Vect { rtd: rtd }, 2) }
            } else {
                if n == 3 { try_new(&ctx.heap, Vect { rtd: rtd }, 3) } else { try_new(&ctx.heap, Vect { rtd: rtd }, 4) }
            }
        } else if n <= 6 {
            if n == 5 { try_new(&ctx.heap, Vect { rtd: rtd }, 5) } else { try_new(&ctx.heap, Vect { rtd: rtd }, 6) }
        } else {
            if n == 7 { try_new(&ctx.heap, Vect { rtd: rtd }, 7) } else { try_new(&ctx.heap, Vect { rtd: rtd }, 8) }
        }
    }
    /// (memq x l): a loop in the handler instead of a native call.
    op MEMQ(dst: reg, x: reg, l: reg) : ABC {
        let key = x;
        var cur = l;
        while let P(p) = cur {
            if p.car == key { dst = cur; next }
            cur = p.cdr;
        }
        dst = Imm(value.IMM_FALSE);
        next
    }
    /// (assq x l).
    op ASSQ(dst: reg, x: reg, l: reg) : ABC {
        let key = x;
        var cur = l;
        while let P(p) = cur {
            let e = p.car;
            let P(q) = e else { raise rt.type_err(ctx, "assoc", "pair", e) };
            if q.car == key { dst = e; next }
            cur = p.cdr;
        }
        dst = Imm(value.IMM_FALSE);
        next
    }
    op SETCAR(a: reg, b: reg) : ABC {
        if let P(p) = a { p.car = b; next }
        raise rt.type_err(ctx, "set-car!", "pair", a)
    }
    op SETCDR(a: reg, b: reg) : ABC {
        if let P(p) = a { p.cdr = b; next }
        raise rt.type_err(ctx, "set-cdr!", "pair", a)
    }
    op VREF(dst: reg, v: reg, i: reg) : ABC {
        if let (Vec(x), Int(j)) = (v, i) and (j as u32 as u64) < x.data.len {
            dst = x.data.ptr[j as u32 as u64];
            next
        }
        raise index_err(ctx, "vector-ref", v, i)
    }
    /// vector-ref with a constant index (record fields, small tuples).
    op VREFI(dst: reg, v: reg, i: imm) : ABC {
        if let Vec(x) = v and (i as u64) < x.data.len {
            dst = x.data.ptr[i as u64];
            next
        }
        raise index_err(ctx, "vector-ref", v, Int(i as i32))
    }
    op VSETI(v: reg, i: imm, src: reg) : ABC {
        if let Vec(x) = v and (i as u64) < x.data.len {
            x.data.ptr[i as u64] = src;
            next
        }
        raise index_err(ctx, "vector-set!", v, Int(i as i32))
    }
    op VSET(v: reg, i: reg, src: reg) : ABC {
        if let (Vec(x), Int(j)) = (v, i) and (j as u32 as u64) < x.data.len {
            x.data.ptr[j as u32 as u64] = src;
            next
        }
        raise index_err(ctx, "vector-set!", v, i)
    }

    // Builtins of one argument with an inline fast path; the rest (other
    // types, errors) is the native's, on the argument's register.
    op LENGTH(dst: reg, a: callbase) : ABC {
        var n: i32 = 0;
        var cur = regs[a as u64];
        while let P(p) = cur {
            n += 1;
            cur = p.cdr;
        }
        if cur == V.Imm(value.IMM_NIL) {
            dst = Int(n);
            next
        }
        cold { dst = builtins.call_native(ctx, Prim.Length, regs + a as u64, 1)?; next }
    }
    op ODDP(dst: reg, a: callbase) : ABC {
        if let Int(x) = regs[a as u64] {
            dst = value.boolean((x & 1) != 0);
            next
        }
        cold { dst = builtins.call_native(ctx, Prim.OddP, regs + a as u64, 1)?; next }
    }
    op EVENP(dst: reg, a: callbase) : ABC {
        if let Int(x) = regs[a as u64] {
            dst = value.boolean((x & 1) == 0);
            next
        }
        cold { dst = builtins.call_native(ctx, Prim.EvenP, regs + a as u64, 1)?; next }
    }
    op POSP(dst: reg, a: callbase) : ABC {
        if let Int(x) = regs[a as u64] {
            dst = value.boolean(x > 0);
            next
        }
        cold { dst = builtins.call_native(ctx, Prim.PositiveP, regs + a as u64, 1)?; next }
    }
    op NEGP(dst: reg, a: callbase) : ABC {
        if let Int(x) = regs[a as u64] {
            dst = value.boolean(x < 0);
            next
        }
        cold { dst = builtins.call_native(ctx, Prim.NegativeP, regs + a as u64, 1)?; next }
    }
    op VLEN(dst: reg, a: callbase) : ABC {
        if let Vec(v) = regs[a as u64] {
            dst = Int(v.data.len as i32);
            next
        }
        cold { dst = builtins.call_native(ctx, Prim.VectorLength, regs + a as u64, 1)?; next }
    }

    // (reverse l) and (append l m), allocating from the allocator's
    // current run of free memory; when it runs out (or on an improper
    // list), the native does the whole call (what was allocated is
    // garbage).
    #[poll(gc)] op REVERSE(dst: reg, a: callbase) : ABC {
        var r = V.Imm(value.IMM_NIL);
        var cur = regs[a as u64];
        while let P(p) = cur {
            let Some(c) = try_new(&ctx.heap, Pair { car: p.car, cdr: r }) else cold {
                dst = builtins.call_native(ctx, Prim.Reverse, regs + a as u64, 1)?;
                next
            };
            r = P(c);
            cur = p.cdr;
        }
        if cur != V.Imm(value.IMM_NIL) { cold { dst = builtins.call_native(ctx, Prim.Reverse, regs + a as u64, 1)?; next } }
        dst = r;
        next
    }
    /// (append R[base] R[base+1]).
    #[poll(gc)] op APPEND2(dst: reg, base: callbase) : ABC {
        let x = regs[base as u64];
        if x == V.Imm(value.IMM_NIL) {
            dst = regs[base as u64 + 1];
            next
        }
        if let P(p0) = x and let Some(h) = try_new(&ctx.heap, Pair { car: p0.car, cdr: V.Imm(value.IMM_NIL) }) {
            var last = h;
            var cur = p0.cdr;
            while let P(p) = cur {
                let Some(c) = try_new(&ctx.heap, Pair { car: p.car, cdr: V.Imm(value.IMM_NIL) }) else cold {
                    dst = builtins.call_native(ctx, Prim.Append, regs + base as u64, 2)?;
                    next
                };
                last.cdr = P(c);
                last = c;
                cur = p.cdr;
            }
            if cur == V.Imm(value.IMM_NIL) {
                last.cdr = regs[base as u64 + 1];
                dst = P(h);
                next
            }
        }
        cold { dst = builtins.call_native(ctx, Prim.Append, regs + base as u64, 2)?; next }
    }

    /// (string-ref R[base] R[base+1]).
    op SREF(dst: reg, base: callbase) : ABC {
        if let S(st) = regs[base as u64] and let Int(i) = regs[base as u64 + 1] and i >= 0 and (i as u64) < st.data.len {
            dst = value.chr(st.data.ptr[i as u64] as i32);
            next
        }
        cold { dst = builtins.call_native(ctx, Prim.StringRef, regs + base as u64, 2)?; next }
    }

    /// Records (define-record-type): `f` is the constant (rtd . i) of
    /// field i of record type rtd, `t` the rtd.
    op RREF(dst: reg, x: reg, f: kst) : ABC {
        if let Vec(r) = x and let P(d) = f and r.rtd == d.car and let Int(i) = d.cdr and (i as u64) < r.data.len {
            dst = r.data.ptr[i as u64];
            next
        }
        raise record_fail(ctx, f, x)
    }
    op RSET(x: reg, f: kst, src: reg) : ABC {
        if let Vec(r) = x and let P(d) = f and r.rtd == d.car and let Int(i) = d.cdr and (i as u64) < r.data.len {
            r.data.ptr[i as u64] = src;
            next
        }
        raise record_fail(ctx, f, x)
    }
    op RECP(dst: reg, x: reg, t: kst) : ABC {
        dst = value.boolean(match x { Vec(r) => r.rtd == t, _ => false });
        next
    }

    /// (call/cc R[base+1]): run the procedure with an escape continuation
    /// in a frame of the continuation prototype (see cont_proto).
    fn callcc(base: u64, tail: bool) -> never {
        let Some(cp) = ctx.cont_proto else { raise rt.err_msg(ctx, "call/cc: not initialized") };
        var dst = regs + base + 1;
        var nf = fp;
        if !tail {
            if fp + 1 >= ctx.frames_end { raise rt.err_msg(ctx, "stack overflow (too many nested calls)") }
            nf = fp + 1;
        }
        if tail { dst = regs; }
        if !ctx.vs.ensure(dst + 3 + 1) { raise rt.err_msg(ctx, "stack overflow") }
        let kc = new(&ctx.heap, Closure { proto: cp }, 1);
        kc.free.ptr[0] = Int((((nf as u64) - (ctx.frames as u64)) / size_of<Frame>()) as i32);
        dst[0] = regs[base + 1];
        dst[1] = Clo(kc);
        if !tail {
            fp.resume = pc + 1;
            fp = fp + 1;
        }
        fp.cl = kc;
        fp.base = dst;
        k = cp.consts.data.ptr;
        fp.k = k;
        regs = dst;
        jump cp.code
    }

    /// R[base] = (call/cc R[base+1]) of the builtin (never redefined);
    /// `tail`: return it.
    #[poll(gc_fall)] op CALLCC(base: callbase, tail: imm) : ABC {
        callcc(base as u64, tail != 0)
    }

    /// Everything but a call of a closure with exactly its number of
    /// (fixed) parameters: rest parameters, arity errors, builtins and
    /// `apply`. Sets up the state and continues there.
    fn call_slow(base: u64, nargs: u64, tail: bool) -> never {
        var n = nargs;
        var f = regs[base];
        while value.prim_of(f) == Some(Prim.Apply as i32) {
            // (apply proc arg ... list): spread the list into registers.
            if n < 2 { raise rt.err_msg(ctx, "apply: wrong number of arguments") }
            let lst = regs[base + n];
            for i in 0..n - 1 { regs[base + i] = regs[base + 1 + i]; }
            n -= 2;
            var cur = lst;
            while let P(p) = cur {
                if !ctx.vs.ensure(regs + base + n + 3) { raise rt.err_msg(ctx, "stack overflow") }
                regs[base + 1 + n] = p.car;
                n += 1;
                cur = p.cdr;
            }
            if cur != V.Imm(value.IMM_NIL) { raise rt.type_err(ctx, "apply", "list", lst) }
            f = regs[base];
        }
        if value.prim_of(f) == Some(Prim.CallCc as i32) {
            if n != 1 { raise rt.err_msg(ctx, "call-with-current-continuation: wrong number of arguments") }
            // (Inline: a call of another vm function here would make
            // CALL/TAILCALL look as if they could continue.)
            let Some(cp) = ctx.cont_proto else { raise rt.err_msg(ctx, "call/cc: not initialized") };
            var dst = regs + base + 1;
            var nf = fp;
            if !tail {
                if fp + 1 >= ctx.frames_end { raise rt.err_msg(ctx, "stack overflow (too many nested calls)") }
                nf = fp + 1;
            }
            if tail { dst = regs; }
            if !ctx.vs.ensure(dst + 3 + 1) { raise rt.err_msg(ctx, "stack overflow") }
            let kc = new(&ctx.heap, Closure { proto: cp }, 1);
            kc.free.ptr[0] = Int((((nf as u64) - (ctx.frames as u64)) / size_of<Frame>()) as i32);
            dst[0] = regs[base + 1];
            dst[1] = Clo(kc);
            if !tail {
                fp.resume = pc + 1;
                fp = fp + 1;
            }
            fp.cl = kc;
            fp.base = dst;
            k = cp.consts.data.ptr;
            fp.k = k;
            regs = dst;
            jump cp.code
        }
        if let Clo(cl) = f {
            let p = cl.proto;
            if p.fixed == value.CONT_FIXED {
                // An escape continuation: return the argument from the
                // continuation frame, if that activation is still live.
                if n > 1 { raise rt.err_msg(ctx, "continuation: multiple values are not supported") }
                let v = if n == 1 { regs[base + 1] } else { V.Imm(value.IMM_UNSPEC) };
                let Int(d) = cl.free.ptr[0] else { raise rt.err_msg(ctx, "continuation: internal error") };
                let target = ctx.frames + d as u64;
                if d < 1 or target > fp or (target.cl as u64) != (cl as u64) {
                    raise rt.err_msg(ctx, "continuation invoked after its extent ended (only escaping continuations are supported)")
                }
                *(target.base - 1) = v;
                fp = target - 1;
                regs = fp.base;
                k = fp.k;
                jump fp.resume
            }
            let np = p.nparams as u64;
            if n < np or (n > np and p.rest == 0) { raise arity_err(ctx, cl, n) }
            let args = regs + base + 1;
            var have = n;
            if p.rest != 0 {
                var lst = V.Imm(value.IMM_NIL);
                var i = n;
                while i > np {
                    i -= 1;
                    lst = value.cons(&ctx.heap, args[i], lst);
                }
                args[np] = lst;
                have = np + 1;
            }
            var dst = args;
            if tail {
                dst = regs;
                for i in 0..have { dst[i] = args[i]; }
            } else if fp + 1 >= ctx.frames_end {
                raise rt.err_msg(ctx, "stack overflow (too many nested calls)")
            }
            let nr = p.nregs as u64;
            if !ctx.vs.ensure(dst + nr + 1) { raise rt.err_msg(ctx, "stack overflow") }
            if !tail {
                fp.resume = pc + 1;
                fp = fp + 1;
            }
            fp.cl = cl;
            fp.base = dst;
            k = p.consts.data.ptr;
            fp.k = k;
            regs = dst;
            jump p.code
        }
        if let Some(id) = value.prim_of(f) {
            let v = builtins.call_native(ctx, id as Prim, regs + base + 1, n)?;
            if !tail {
                regs[base] = v;
                next
            }
            *(regs - 1) = v;
            fp = fp - 1;
            regs = fp.base;
            k = fp.k;
            jump fp.resume
        }
        raise rt.err(ctx, "not a procedure", f)
    }

    /// R[base] = builtin `id` (R[base+1] .. R[base+nargs]): a call of a
    /// builtin the program never redefines (not apply or call/cc).
    #[poll(gc_fall)] op PRIMCALL(base: callbase, nargs: imm, id: imm) : ABC {
        regs[base] = builtins.call_native(ctx, id as Prim, regs + base + 1, nargs as u64)?;
        next
    }

    /// R[base] = this procedure (R[base+1] .. R[base+nargs]): a recursive
    /// call, which the compiler emits only with the right number of
    /// arguments, so the callee needs no checks. R[base] is not read.
    op CALLSELF(base: callbase, nargs: imm) : ABC {
        let cl = fp.cl;
        let p = cl.proto;
        let callee = regs + base + 1;
        let n = p.nregs as u64;
        if !ctx.vs.fits(callee + n + 1) or fp + 1 >= ctx.frames_end {
            cold {
                if fp + 1 >= ctx.frames_end or !ctx.vs.raise(callee + n + 1) {
                    raise rt.err_msg(ctx, "stack overflow (too many nested calls)")
                }
                redo
            }
        }
        fp.resume = pc + 1;
        fp = fp + 1;
        fp.cl = cl;
        fp.base = callee;
        fp.k = k;
        regs = callee;
        jump p.code
    }

    /// R[base] = the known top-level procedure k[f] (R[base+1] ..
    /// R[base+nargs]): its closure is a constant, which the compiler emits
    /// only where the procedure's definition has run, with its number of
    /// parameters (a rest list made by the caller). R[base] is not read.
    op CALLK(base: callbase, nargs: imm, f: kst) : ABC {
        if let Clo(cl) = f {
            let p = cl.proto;
            let callee = regs + base + 1;
            let n = p.nregs as u64;
            if !ctx.vs.fits(callee + n + 1) or fp + 1 >= ctx.frames_end {
                cold {
                    if fp + 1 >= ctx.frames_end or !ctx.vs.raise(callee + n + 1) {
                        raise rt.err_msg(ctx, "stack overflow (too many nested calls)")
                    }
                    redo
                }
            }
            fp.resume = pc + 1;
            fp = fp + 1;
            fp.cl = cl;
            fp.base = callee;
            k = p.consts.data.ptr;
            fp.k = k;
            regs = callee;
            jump p.code
        }
        raise rt.err_msg(ctx, "internal error: CALLK of a non-procedure")
    }
    /// return k[f](R[base+1] .. R[base+nargs]) (as CALLK), reusing this frame.
    op TAILCALLK(base: callbase, nargs: imm, f: kst) : ABC {
        if let Clo(cl) = f {
            let p = cl.proto;
            let n = p.nregs as u64;
            if !ctx.vs.fits(regs + n + 1) {
                cold {
                    if !ctx.vs.raise(regs + n + 1) { raise rt.err_msg(ctx, "stack overflow") }
                    redo
                }
            }
            let args = regs + base + 1;
            let na = nargs as u64;
            for i in 0..na { regs[i] = args[i]; }
            fp.cl = cl;
            k = p.consts.data.ptr;
            fp.k = k;
            jump p.code
        }
        raise rt.err_msg(ctx, "internal error: CALLK of a non-procedure")
    }

    /// R[base] = R[base](R[base+1] .. R[base+nargs]).
    op CALL(base: callbase, nargs: imm) : ABC {
        if let Clo(cl) = regs[base] {
            let p = cl.proto;
            if likely(p.fixed == nargs as u32) {
                let callee = regs + base + 1;
                let n = p.nregs as u64;
                if !ctx.vs.fits(callee + n + 1) or fp + 1 >= ctx.frames_end {
                    cold {
                        if fp + 1 >= ctx.frames_end or !ctx.vs.raise(callee + n + 1) {
                            raise rt.err_msg(ctx, "stack overflow (too many nested calls)")
                        }
                        redo
                    }
                }
                fp.resume = pc + 1;
                fp = fp + 1;
                fp.cl = cl;
                fp.base = callee;
                k = p.consts.data.ptr;
                fp.k = k;
                regs = callee;
                jump p.code
            }
        }
        cold {
            if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
            call_slow(base as u64, nargs as u64, false)
        }
    }
    /// return R[base](R[base+1] .. R[base+nargs]), reusing this frame.
    op TAILCALL(base: callbase, nargs: imm) : ABC {
        if let Clo(cl) = regs[base] {
            let p = cl.proto;
            if likely(p.fixed == nargs as u32) {
                let n = p.nregs as u64;
                if !ctx.vs.fits(regs + n + 1) {
                    cold {
                        if !ctx.vs.raise(regs + n + 1) { raise rt.err_msg(ctx, "stack overflow") }
                        redo
                    }
                }
                let args = regs + base + 1;
                let na = nargs as u64;
                for i in 0..na { regs[i] = args[i]; }
                fp.cl = cl;
                k = p.consts.data.ptr;
                fp.k = k;
                jump p.code
            }
        }
        cold {
            if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
            call_slow(base as u64, nargs as u64, true)
        }
    }
    op RET(src: reg) : ABC {
        let v = src;
        if fp == ctx.frames { exit v }
        *(regs - 1) = v;
        fp = fp - 1;
        regs = fp.base;
        k = fp.k;
        jump fp.resume
    }

    // Superinstructions, chosen from `--vm-stats` over the benchmarks.
    // All `#[forward]`: where a part reads the register the previous part
    // wrote, `optimize` picks a variant that keeps the value in a machine
    // register (no run-time test; it costs opcodes and code size).
    // Compare-and-branch pairs produced by every `if`:
    #[forward] supers {
        LTI, TEST;
        LEI, TEST;
        GTI, TEST;
        GEI, TEST;
        NUMEQI, TEST;
        LT, TEST;
        LT, TESTT;
        LE, TEST;
        GT, TEST;
        GE, TEST;
        NUMEQ, TEST;
        NULLP, TEST;
        PAIRP, TEST;
        EQ, TEST;
        NOT, TEST;
        ZEROP, TEST;
        NUMEQ, TESTT;
        EQ, TESTT;
        EQV, TEST;
        // Overlaps another super, but runs outside TESTT; RET: 4% of nboyer's ops.
        #[allow(super_overlap)] PAIRP, TESTT;
    }
    // Returning a constant ('(), #t, #f): 13 of the programs.
    super LOADK_RET = LOADK; RET;
    #[forward] supers {
        CAR, CAR;
        // Overlaps CAR_CAR, but runs outside it: (cadr x), (caddr x).
        #[allow(super_overlap)] CDR, CAR;
        // Loops, argument set-up and list walking.
        MOVE, MOVE;
        // Overlaps another super, but runs outside MOVE; MOVE: 25% of sum's ops, 6.5% of diviter's.
        #[allow(super_overlap)] MOVE, JMP;
        ADDI, JMP;
        CDR, JMP;
        // Overlaps another super, but runs outside CDR; JMP: 13-18% of takl's and ntakl's ops.
        #[allow(super_overlap)] CDR, CDR;
        GETFREE, GETFREE;
        ADD, RET;
        CONS, RET;
        // Overlaps another super, but runs outside LT; TESTT: 2-2.8% of takl's, ntakl's and nboyer's ops.
        #[allow(super_overlap)] TESTT, RET;
        ADDI, CALL;
        // Overlaps another super, but runs outside MOVE; MOVE: 4.4% of conform's ops, 1-2% of several others.
        #[allow(super_overlap)] MOVE, CALL;
        // Overlaps another super, but runs outside MOVE; MOVE: 7% of fibc's ops, 4% of graphs'.
        #[allow(super_overlap)] MOVE, TAILCALL;
    }

    entry run(c: *Ctx, cl: Gc<Closure>) -> V uses gc {
        ctx = c;
        let p = cl.proto;
        c.vs.base[0] = Imm(value.IMM_UNSPEC);
        regs = c.vs.base + 1;
        for i in 0..p.nregs as u64 { regs[i] = Imm(value.IMM_UNSPEC); }
        if !c.vs.ensure(regs + p.nregs as u64 + 1) {
            c.error = rt.err_msg(c, "stack overflow");
            exit Imm(value.IMM_UNSPEC)
        }
        fp = c.frames;
        fp.cl = cl;
        fp.base = regs;
        k = p.consts.data.ptr;
        fp.k = k;
        c.fp = fp;
        jump p.code
    }

    on raise(e: V) {
        // Prefix the message with the line of the failing instruction, or
        // of the nearest caller with a known line (prelude code has none).
        var line = line_at(fp.cl.proto, pc);
        var f = fp;
        while line == 0 and f > ctx.frames {
            f = f - 1;
            line = line_at(f.cl.proto, f.resume - 1);
        }
        ctx.tmp.clear();
        if line > 0 {
            ctx.tmp.push_str("line ");
            ctx.tmp.push_int(line as i64);
            ctx.tmp.push_str(": ");
        }
        value.print(&ctx.tmp, e, false);
        ctx.error = S(value.new_str(&ctx.heap, ctx.tmp.as_str()));
        ctx.fp = fp;
        exit Imm(value.IMM_UNSPEC)
    }
}
