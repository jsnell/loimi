// Builtins written in Scheme: the ones that call procedures (map,
// for-each, ...). Compiled before the program, with no source lines.

#![lifetimes]
pub fn source() -> str {
"
(define (%map1 f l)
  (let loop ((l l) (acc '()))
    (if (pair? l)
        (loop (cdr l) (cons (f (car l)) acc))
        (reverse acc))))

(define (%for-each1 f l)
  (let loop ((l l))
    (if (pair? l) (begin (f (car l)) (loop (cdr l))))))

(define (%all-pairs? ls)
  (if (null? ls) #t (if (pair? (car ls)) (%all-pairs? (cdr ls)) #f)))

(define (map f l . ls)
  (if (null? ls)
      (%map1 f l)
      (let loop ((ls (cons l ls)) (acc '()))
        (if (%all-pairs? ls)
            (loop (%map1 cdr ls) (cons (apply f (%map1 car ls)) acc))
            (reverse acc)))))

(define (for-each f l . ls)
  (if (null? ls)
      (%for-each1 f l)
      (let loop ((ls (cons l ls)))
        (if (%all-pairs? ls)
            (begin (apply f (%map1 car ls)) (loop (%map1 cdr ls)))))))

(define (vector-map f v) (list->vector (map f (vector->list v))))
(define (vector-for-each f v) (for-each f (vector->list v)))
(define (string-for-each f s) (for-each f (string->list s)))
(define (string-map f s) (list->string (map f (string->list s))))

(define call/cc call-with-current-continuation)

; Multiple values: one value is itself; any other number is a list tagged
; with a unique pair, which call-with-values spreads.
(define %values-tag (list 'values))
(define (values . xs)
  (if (if (pair? xs) (null? (cdr xs)) #f)
      (car xs)
      (cons %values-tag xs)))
(define (call-with-values producer consumer)
  (let ((v (producer)))
    (if (if (pair? v) (eq? (car v) %values-tag) #f)
        (apply consumer (cdr v))
        (consumer v))))

(define (truncate-quotient n d) (quotient n d))
(define (truncate-remainder n d) (remainder n d))
(define (floor-remainder n d) (modulo n d))
(define (truncate/ n d) (values (quotient n d) (remainder n d)))
(define (floor/ n d) (values (floor-quotient n d) (modulo n d)))
(define (exact-integer-sqrt n)
  (let ((s (%exact-integer-sqrt n)))
    (values s (- n (* s s)))))
"
}
