// A small Scheme (an R7RS-small subset), implemented in Loimi.
//
//   loimi build examples/scheme/main.lm --release -o scheme
//   ./scheme program.scm          (a second argument turns on GC stress)

import std.io;
import std.os;
import std.gc;
import std.text;
import value;
import value.{V};
import rt.{Ctx};
import rt;
import vm.{Scheme};
import vm;
import compile;
import builtins;
import prelude;

/// Print the bytecode of `p` and of its nested prototypes (`scheme
/// prog.scm disasm`).
fn dump(p: Gc<value.Proto>) {
    var b = text.StrBuf.new();
    b.push_str("== ");
    b.push_str(p.name.data);
    b.push_str(" (nregs ");
    b.push_int(p.nregs as i64);
    b.push_str(")\n");
    Scheme.disasm(p.code, &b);
    io.print(b.as_str());
    for i in 0..p.protos.data.len { dump(p.protos.data[i]); }
}

fn main() -> i32 {
    let Some(path) = os.arg(1) else {
        io.eprintln("usage: scheme <program.scm> [stress | disasm]");
        return 2;
    };
    let Some(src) = io.read_file(path) else {
        io.eprint("cannot read ");
        io.eprintln(path);
        return 1;
    };
    var ctx = Ctx.new();
    ctx.cont_proto = Some(vm.cont_proto(&ctx.heap));
    // Collect after allocating 4 times the live data (at least 2 MiB, at
    // most 256 MiB): a quarter to a half fewer collections than the
    // default 100% on the allocation-heavy benchmarks (nboyer, earley,
    // mperm, paraffins, graphs 10-20% faster), and no slower elsewhere.
    ctx.heap.set_growth(400, 2 << 20);
    ctx.heap.set_max_budget(256 << 20);
    var disasm = false;
    if let Some(a) = os.arg(2) { disasm = a.eq("disasm"); }
    // `stress`: collect at every safepoint; `verify`: the same with a
    // generational heap, checking the write barriers at each collection.
    if let Some(mode) = os.arg(2) {
        if !disasm { ctx.heap.set_stress(true); }
        if mode.eq("verify") {
            ctx.heap.set_generational(true);
            ctx.heap.set_verify(true);
        }
    }
    for id in 0..builtins.NPRIMS {
        let (name, _, _) = builtins.prim_info(id);
        let s = ctx.syms.intern(&ctx.heap, name);
        let g = ctx.global(s);
        ctx.gvals.set(g as u64, value.prim(id));
    }
    let proto = compile.compile(&ctx, prelude.source(), src);
    if disasm {
        dump(proto);
        return 0;
    }
    let main_closure = value.new_closure(&ctx.heap, proto);
    ctx.heap.add_scanner(&ctx as *u8, rt.scan_roots);
    Scheme.run(&ctx, main_closure);
    ctx.flush();
    if ctx.error != value.unspec() {
        var b = text.StrBuf.new();
        b.push_str("error: ");
        value.print(&b, ctx.error, false);
        io.eprintln(b.as_str());
        return 1;
    }
    0
}
