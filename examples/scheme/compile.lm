// The Scheme compiler: data (as read) → AST → register bytecode.
//
// Pass 1 (`Comp`, "build") expands derived forms into a small core AST
// and resolves every variable to a `Var`. It records which variables are
// assigned (set!) and which are captured by nested lambdas, and gives
// each lambda its list of free variables.
//
// Pass 2 (`Gen`) allocates registers and emits code through the generated
// `Scheme.X` encoders into a std.bc code buffer (with its labels, jump
// lists, constant pool and register allocator). Closures are flat: a closure copies the values of
// its free variables when it is created. A variable that is both captured
// and assigned lives in a box (a one-slot vector), so all closures share it.
// letrec bindings of lambdas are not boxed: the closures are created first
// and their free slots for later siblings are patched (SETFREE) once those
// are initialized.
//
// The compiler allocates in the heap but never collects, so the data being
// compiled (and the line table keyed by pair addresses) stays valid.

import std.io;
import std.mem;
import std.text;
import std.gc;
import std.map;
import std.hash;
import std.bc;
import value;
import value.{V, Sym, Str, Arr, Proto, Closure, Lines, Protos, Descs};
import rt.{Ctx};
import read;
import read.{fail, Reader};
import builtins;
import builtins.{Prim, PO};
import vm.{Scheme};

// ── AST ─────────────────────────────────────────────────────────────

enum K { Const, Ref, GRef, Set, GSet, GDef, If, Lambda, Seq, Call, Prim, Let, Letrec, And, Or, GChk }

struct Var {
    name: Gc<Sym>,
    owner: *Lam,
    reg: u32,
    /// Target of a set!.
    assigned: bool,
    /// Referenced from a lambda other than its owner.
    captured: bool,
    /// Boxed regardless of assignment (a letrec variable that a closure
    /// captures before the variable is initialized).
    force_box: bool,
    /// Number of lambdas that capture it (to detect captures during an init).
    caps: u32,
    /// The lambda this (let or letrec) variable is bound to, or null.
    lam: *Lam,
    /// References (counted after the AST passes, by `reown`).
    refs: u32,
}

struct Lam {
    parent: *Lam,
    name: str,
    params: mem.Vec<*Var>,
    nparams: u32,
    rest: bool,
    free: mem.Vec<*Var>,
    body: *Node,
    /// Contified: every reference is a tail call from the same frame, so the
    /// body is compiled inline in the enclosing procedure (see `contify`).
    cont: bool,
    /// The start of a contified body.
    label: bc.Label,
}

/// One AST node; which fields matter depends on `kind`:
///   Const v | Ref var | GRef g | Set var a | GSet g a | GDef g a
///   If a b c | Lambda lam | Seq list | Call a list | Prim po list
///   Let vars list(inits) a(body) | Letrec vars list a | And list | Or list
///   GChk g (fails if global g is unbound; effect only)
/// A Call's `lam` is its callee when that is a known top-level procedure.
struct Node {
    kind: K,
    line: u32,
    v: V,
    vr: *Var,
    g: u32,
    po: PO,
    a: *Node,
    b: *Node,
    c: *Node,
    lam: *Lam,
    list: mem.Vec<*Node>,
    vars: mem.Vec<*Var>,
    /// A Call of a known top-level procedure whose definition has run
    /// whenever the call does (no guard needed): CALLK.
    direct: bool,
}

fn null_node() -> *Node { 0 as *Node }
fn is_null(n: *Node) -> bool { (n as u64) == 0 }

fn boxed(v: *Var) -> bool { v.force_box or (v.assigned and v.captured) }

// ── pass 1: build ───────────────────────────────────────────────────

struct Comp {
    ctx: *Ctx,
    heap: *gc.Heap,
    lines: map.HashMap<u64, u32>,
    /// Variables in scope, innermost last.
    env: mem.Vec<*Var>,
    lam: *Lam,
    /// Globals that the program defines or assigns (by symbol address):
    /// builtins among them are not compiled inline.
    redefined: map.HashMap<u64, bool>,
    line: u32,
    gensyms: u32,
    /// Top-level definitions per global slot: how many, and the lambda of
    /// a procedure definition; and the globals that are set!.
    gdefs: map.HashMap<u64, u32>,
    glams: map.HashMap<u64, *Lam>,
    /// The globals whose (one) definition is a lambda, not an alias.
    gprocs: map.HashMap<u64, bool>,
    gsets: map.HashMap<u64, bool>,
    /// The top-level form that defines each global, the form being
    /// inlined into, and the first form that may run program code.
    gform: map.HashMap<u64, u64>,
    /// Globals defined once (never set!) as another name for a builtin:
    /// (define make-node vector). Their calls call the builtin.
    galias: map.HashMap<u64, i32>,
    cur_form: u64,
    first_impure: u64,
    /// The known top-level procedure whose body is being inlined into
    /// (NO_PROC in other code), and per known procedure the first form
    /// that may run its body (absent: none can; see `reachability`).
    cur_proc: u64,
    reach: map.HashMap<u64, u64>,
}

const NO_PROC: u64 = 0xFFFFFFFFFFFFFFFF;

fn Comp.node(c: *Comp, kind: K) -> *Node {
    let n: *Node = mem.alloc(1);
    n.kind = kind;
    n.line = c.line;
    n.v = value.unspec();
    n.list = mem.Vec.new();
    n.vars = mem.Vec.new();
    n
}

fn Comp.konst(c: *Comp, v: V) -> *Node {
    let n = c.node(K.Const);
    n.v = v;
    n
}

fn Comp.new_var(c: *Comp, name: Gc<Sym>) -> *Var {
    let v: *Var = mem.alloc(1);
    v.name = name;
    v.owner = c.lam;
    v.lam = 0 as *Lam;
    v
}

/// An uninterned symbol (invisible to programs).
fn Comp.gensym(c: *Comp, s: str) -> Gc<Sym> {
    c.gensyms += 1;
    let o = new(c.heap, Sym { gidx: value.NO_GLOBAL, sname: value.f() }, s.len);
    mem.memcpy(o.name.ptr, s.ptr, s.len);
    o
}

fn Comp.sym(c: *Comp, s: str) -> V { V.Sym(c.ctx.syms.intern(c.heap, s)) }

fn Comp.lookup(c: *Comp, s: Gc<Sym>) -> ?*Var {
    var i = c.env.len;
    while i > 0 {
        i -= 1;
        let v = c.env.at(i);
        if (v.name as u64) == (s as u64) { return Some(v); }
    }
    None
}

/// Record a reference to `v` from the current lambda.
fn Comp.capture(c: *Comp, v: *Var) {
    var l = c.lam;
    while (l as u64) != (v.owner as u64) {
        var have = false;
        for i in 0..l.free.len {
            if (l.free.at(i) as u64) == (v as u64) { have = true; }
        }
        if !have {
            l.free.push(v);
            v.caps += 1;
        }
        v.captured = true;
        l = l.parent;
    }
}

fn Comp.ref_var(c: *Comp, v: *Var) -> *Node {
    c.capture(v);
    let n = c.node(K.Ref);
    n.vr = v;
    n
}

fn car(c: *Comp, x: V) -> V {
    let P(p) = x else { fail(c.line, "bad syntax") };
    p.car
}

fn cdr(c: *Comp, x: V) -> V {
    let P(p) = x else { fail(c.line, "bad syntax") };
    p.cdr
}

/// Length of a proper list, or -1.
fn list_len(x: V) -> i64 {
    var n: i64 = 0;
    var cur = x;
    while let P(p) = cur { n += 1; cur = p.cdr; }
    if cur != value.nil() { return -1; }
    n
}

fn sym_name(x: V) -> ?str {
    if let Sym(s) = x { return Some(s.name); }
    None
}

fn is_sym(x: V, name: str) -> bool {
    if let Sym(s) = x { return s.name.eq(name); }
    false
}

fn Comp.line_of(c: *Comp, x: V) -> u32 {
    if let P(p) = x and let Some(l) = c.lines.get(p as u64) { return l; }
    c.line
}

/// Is `x` a form whose head is the special-form keyword `name` (not shadowed)?
fn Comp.is_form(c: *Comp, x: V, name: str) -> bool {
    if let P(p) = x and let Sym(s) = p.car and s.name.eq(name) { return c.lookup(s).is_none(); }
    false
}

fn Comp.prim(c: *Comp, po: PO, args: mem.Vec<*Node>) -> *Node {
    let n = c.node(K.Prim);
    n.po = po;
    n.list = args;
    n
}

fn Comp.prim1(c: *Comp, po: PO, a: *Node) -> *Node {
    var l: mem.Vec<*Node> = mem.Vec.new();
    l.push(a);
    c.prim(po, l)
}

fn Comp.prim2(c: *Comp, po: PO, a: *Node, b: *Node) -> *Node {
    var l: mem.Vec<*Node> = mem.Vec.new();
    l.push(a);
    l.push(b);
    c.prim(po, l)
}

fn Comp.if_node(c: *Comp, a: *Node, b: *Node, e: *Node) -> *Node {
    let n = c.node(K.If);
    n.a = a;
    n.b = b;
    n.c = e;
    n
}

fn Comp.build(c: *Comp, x: V) -> *Node {
    let saved = c.line;
    c.line = c.line_of(x);
    let n = c.build_inner(x);
    c.line = saved;
    n
}

fn Comp.build_inner(c: *Comp, x: V) -> *Node {
    match x {
        Sym(s) => {
            if let Some(v) = c.lookup(s) { return c.ref_var(v); }
            let n = c.node(K.GRef);
            n.g = c.ctx.global(s);
            n
        }
        P(p) => {
            if let Sym(s) = p.car and c.lookup(s).is_none() {
                if let Some(n) = c.special(s.name, x) { return n; }
                // A builtin compiled inline?
                if !c.redefined.contains(s as u64) {
                    let argc = list_len(p.cdr);
                    if let Some(n) = c.inline_call(s.name, p.cdr, argc) { return n; }
                }
            }
            let n = c.node(K.Call);
            n.a = c.build(p.car);
            // (map f l) and (for-each f l) with one list use the prelude's
            // one-list versions, which can be inlined.
            if n.a.kind == K.GRef and let Sym(s) = p.car and !c.redefined.contains(s as u64)
                and list_len(p.cdr) == 2 and (s.name.eq("map") or s.name.eq("for-each")) {
                let one = c.ctx.syms.intern(c.heap, if s.name.eq("map") { "%map1" } else { "%for-each1" });
                n.a.g = c.ctx.global(one);
            }
            // A builtin that the program never redefines is called directly.
            if n.a.kind == K.GRef and let Sym(s) = p.car and !c.redefined.contains(s as u64)
                and let Some(id) = value.prim_of(c.ctx.gvals.at(n.a.g as u64))
                and id != Prim.Apply as i32 {
                n.a = c.konst(value.prim(id));
            }
            var cur = p.cdr;
            while let P(q) = cur {
                n.list.push(c.build(q.car));
                cur = q.cdr;
            }
            if cur != value.nil() { fail(c.line, "improper argument list"); }
            n
        }
        _ => {
            if x == value.nil() { fail(c.line, "empty combination ()"); }
            c.konst(x)
        }
    }
}

fn Comp.args(c: *Comp, x: V) -> mem.Vec<*Node> {
    var l: mem.Vec<*Node> = mem.Vec.new();
    var cur = x;
    while let P(q) = cur {
        l.push(c.build(q.car));
        cur = q.cdr;
    }
    l
}

fn Comp.inline_call(c: *Comp, name: str, args: V, argc: i64) -> ?*Node {
    // cXr compositions (up to four levels) become chains of car/cdr.
    if argc == 1 and name.len >= 4 and name.len <= 6 and name[0] == 'c' and name[name.len - 1] == 'r' {
        var ok = true;
        for i in 1..name.len - 1 {
            if name[i] != 'a' and name[i] != 'd' { ok = false; }
        }
        if ok {
            var n = c.build(car(c, args));
            var i = name.len - 1;
            while i > 1 {
                i -= 1;
                n = c.prim1(if name[i] == 'a' { PO.Car } else { PO.Cdr }, n);
            }
            return Some(n);
        }
    }
    // (list a b ...) is a chain of conses; (vector a b ...) and the
    // constructors of records allocate from consecutive registers.
    if name.eq("list") and argc <= 16 {
        var l = c.args(args);
        var n = c.konst(value.nil());
        var i = l.len;
        while i > 0 {
            i -= 1;
            n = c.prim2(PO.Cons, l.at(i), n);
        }
        l.free();
        return Some(n);
    }
    if name.eq("vector") and argc <= 64 { return Some(c.prim(PO.Vector, c.args(args))); }
    if name.eq("%record") and argc >= 1 and argc <= 64 { return Some(c.prim(PO.Record, c.args(args))); }
    // Record accessors, modifiers and predicates (record_defs): the
    // constant is the op's operand.
    if (name.eq("%record-ref") and argc == 2) or (name.eq("%record-set!") and argc == 3) or (name.eq("%record?") and argc == 2) {
        var l = c.args(args);
        let f = l.at(0);
        if f.kind == K.Const {
            var rest: mem.Vec<*Node> = mem.Vec.new();
            for i in 1..l.len { rest.push(l.at(i)); }
            l.free();
            let n = c.prim(if name.eq("%record-ref") { PO.RRef } else if name.eq("%record?") { PO.RecP } else { PO.RSet }, rest);
            n.v = f.v;
            return Some(n);
        }
        l.free();
    }
    let Some(prim) = Prim.from_name(name) else { return None; };
    let Some(po) = prim.op() else { return None; };
    if argc == po.arity() { return Some(c.prim(po, c.args(args))); }
    // Left-fold + and * over more operands; (- x) is (- 0 x).
    if (po == PO.Add or po == PO.Mul or po == PO.Sub) and argc > 2 {
        let l = c.args(args);
        var n = c.prim2(po, l.at(0), l.at(1));
        for i in 2..l.len { n = c.prim2(po, n, l.at(i)); }
        return Some(n);
    }
    if po == PO.Sub and argc == 1 {
        return Some(c.prim2(PO.Sub, c.konst(V.Int(0)), c.build(car(c, args))));
    }
    None
}

/// Special forms. None when `name` is not a keyword.
fn Comp.special(c: *Comp, name: str, x: V) -> ?*Node {
    let rest = cdr(c, x);
    if name.eq("quote") {
        if list_len(rest) != 1 { fail(c.line, "bad quote"); }
        return Some(c.konst(car(c, rest)));
    }
    if name.eq("quasiquote") {
        if list_len(rest) != 1 { fail(c.line, "bad quasiquote"); }
        return Some(c.qq(car(c, rest), 1));
    }
    if name.eq("lambda") {
        if list_len(rest) < 2 { fail(c.line, "bad lambda"); }
        let n = c.node(K.Lambda);
        n.lam = c.lambda(car(c, rest), cdr(c, rest), "lambda");
        return Some(n);
    }
    if name.eq("define") { fail(c.line, "define is only allowed at the start of a body or at top level"); }
    if name.eq("set!") {
        if list_len(rest) != 2 { fail(c.line, "bad set!"); }
        let Sym(s) = car(c, rest) else { fail(c.line, "set!: not a variable") };
        let val = c.build(car(c, cdr(c, rest)));
        if let Some(v) = c.lookup(s) {
            c.capture(v);
            v.assigned = true;
            let n = c.node(K.Set);
            n.vr = v;
            n.a = val;
            return Some(n);
        }
        let n = c.node(K.GSet);
        n.g = c.ctx.global(s);
        n.a = val;
        c.gsets.insert(n.g as u64, true);
        return Some(n);
    }
    if name.eq("if") {
        let len = list_len(rest);
        if len != 2 and len != 3 { fail(c.line, "bad if"); }
        let t = c.build(car(c, rest));
        let a = c.build(car(c, cdr(c, rest)));
        let e = if len == 3 { c.build(car(c, cdr(c, cdr(c, rest)))) } else { null_node() };
        return Some(c.if_node(t, a, e));
    }
    if name.eq("begin") {
        if rest == value.nil() { return Some(c.konst(value.unspec())); }
        return Some(c.seq(rest));
    }
    if name.eq("let") {
        if list_len(rest) < 2 { fail(c.line, "bad let"); }
        if let Sym(s) = car(c, rest) { return Some(c.named_let(s, cdr(c, rest))); }
        return Some(c.let_form(car(c, rest), cdr(c, rest)));
    }
    if name.eq("let*") {
        if list_len(rest) < 2 { fail(c.line, "bad let*"); }
        return Some(c.let_star(car(c, rest), cdr(c, rest)));
    }
    if name.eq("letrec") or name.eq("letrec*") {
        if list_len(rest) < 2 { fail(c.line, "bad letrec"); }
        return Some(c.letrec(car(c, rest), cdr(c, rest)));
    }
    if name.eq("and") or name.eq("or") {
        if rest == value.nil() { return Some(c.konst(value.boolean(name.eq("and")))); }
        if list_len(rest) == 1 { return Some(c.build(car(c, rest))); }
        let n = c.node(if name.eq("and") { K.And } else { K.Or });
        n.list = c.args(rest);
        return Some(n);
    }
    if name.eq("when") or name.eq("unless") {
        if list_len(rest) < 2 { fail(c.line, "bad when/unless"); }
        var t = c.build(car(c, rest));
        if name.eq("unless") { t = c.prim1(PO.Not, t); }
        return Some(c.if_node(t, c.seq(cdr(c, rest)), null_node()));
    }
    if name.eq("cond") { return Some(c.cond(rest)); }
    if name.eq("case") { return Some(c.case_form(rest)); }
    if name.eq("do") { return Some(c.do_form(rest)); }
    if name.eq("define-syntax") or name.eq("let-syntax") or name.eq("syntax-rules")
        or name.eq("dynamic-wind") {
        if !c.redefined.contains(c.ctx.syms.intern(c.heap, name) as u64) {
            var b = text.StrBuf.new();
            b.push_str(name);
            b.push_str(" is not supported (see examples/scheme/README.md)");
            fail(c.line, b.as_str());
        }
    }
    None
}

/// A sequence of expressions (no definitions).
fn Comp.seq(c: *Comp, body: V) -> *Node {
    if list_len(body) == 1 { return c.build(car(c, body)); }
    let n = c.node(K.Seq);
    n.list = c.args(body);
    if n.list.len == 0 { return c.konst(value.unspec()); }
    n
}

/// Parse a parameter list into variables of the current lambda.
fn Comp.params(c: *Comp, l: *Lam, ps: V) {
    var cur = ps;
    loop {
        match cur {
            P(p) => {
                let Sym(s) = p.car else { fail(c.line, "bad parameter list") };
                let v = c.new_var(s);
                l.params.push(v);
                l.nparams += 1;
                c.env.push(v);
                cur = p.cdr;
            }
            Sym(s) => {
                let v = c.new_var(s);
                l.params.push(v);
                l.rest = true;
                c.env.push(v);
                break;
            }
            _ => {
                if cur != value.nil() { fail(c.line, "bad parameter list"); }
                break;
            }
        }
    }
}

fn Comp.lambda(c: *Comp, ps: V, body: V, name: str) -> *Lam {
    let l: *Lam = mem.alloc(1);
    l.parent = c.lam;
    l.name = name;
    l.params = mem.Vec.new();
    l.free = mem.Vec.new();
    let mark = c.env.len;
    let saved = c.lam;
    c.lam = l;
    c.params(l, ps);
    if l.nparams > 200 { fail(c.line, "too many parameters"); }
    l.body = c.body(body);
    c.env.truncate(mark);
    c.lam = saved;
    l
}

/// Build a list from `items`.
fn Comp.list(c: *Comp, items: []V) -> V {
    var l = value.nil();
    var i = items.len;
    while i > 0 {
        i -= 1;
        l = value.cons(c.heap, items[i], l);
    }
    l
}

/// (define-record-type T (ctor field ...) pred (field acc [modifier]) ...)
/// → (begin (define T '(T))
///          (define (ctor a ...) (%record T <field value or #f> ...))
///          (define (pred x) (%record? 'rtd x))
///          (define (acc x) (%record-ref '(rtd . i) x))
///          (define (modifier x v) (%record-set! '(rtd . i) x v)) ...)
/// where rtd is T's value, the list (T).
/// A record is a Vect whose rtd is T, so vector? is false for it.
fn Comp.record_defs(c: *Comp, x: V) -> V {
    let rest = cdr(c, x);
    if list_len(rest) < 2 { fail(c.line, "bad define-record-type"); }
    let tname = car(c, rest);
    let Sym(_) = tname else { fail(c.line, "define-record-type: bad type name") };
    let ctor = car(c, cdr(c, rest));
    let pred = if list_len(rest) >= 3 { car(c, cdr(c, cdr(c, rest))) } else { value.f() };
    let specs = if list_len(rest) >= 3 { cdr(c, cdr(c, cdr(c, rest))) } else { value.nil() };
    let define = c.sym("define");
    let quote = c.sym("quote");
    var defs: mem.Vec<V> = mem.Vec.new();
    defs.push(c.sym("begin"));
    // The record type's value: accessors and the predicate name it as a
    // constant, (quote rtd), and accessors as (quote (rtd . i)).
    let rtd = value.cons(c.heap, tname, value.nil());
    let tq = c.list([quote, rtd][0..2]);
    defs.push(c.list([define, tname, tq][0..3]));
    // Field names, in order.
    var fields: mem.Vec<V> = mem.Vec.new();
    var cur = specs;
    while let P(p) = cur {
        let f = if let P(q) = p.car { q.car } else { p.car };
        let Sym(_) = f else { fail(c.line, "define-record-type: bad field") };
        fields.push(f);
        cur = p.cdr;
    }
    if let P(cp) = ctor {
        // Constructor parameters are fresh symbols, one per named field.
        var params: mem.Vec<V> = mem.Vec.new();
        var vals: mem.Vec<V> = mem.Vec.new();
        vals.push(c.sym("%record"));
        vals.push(tname);
        for i in 0..fields.len { vals.push(value.f()); }
        var a = cp.cdr;
        while let P(q) = a {
            let g = V.Sym(c.gensym("field"));
            params.push(g);
            var found = false;
            for i in 0..fields.len {
                if fields.at(i) == q.car { vals.items()[i + 2] = g; found = true; }
            }
            if !found { fail(c.line, "define-record-type: constructor argument is not a field"); }
            a = q.cdr;
        }
        let head = value.cons(c.heap, cp.car, c.list(params.items()));
        defs.push(c.list([define, head, c.list(vals.items())][0..3]));
        params.free();
        vals.free();
    } else if let Sym(_) = ctor {
        fail(c.line, "define-record-type: the constructor must list its fields");
    }
    let xs = V.Sym(c.gensym("record"));
    let vs = V.Sym(c.gensym("value"));
    if let Sym(_) = pred {
        let body = c.list([c.sym("%record?"), tq, xs][0..3]);
        defs.push(c.list([define, c.list([pred, xs][0..2]), body][0..3]));
    }
    cur = specs;
    var i: i32 = 0;
    while let P(p) = cur {
        if let P(q) = p.car {
            var r = q.cdr;
            if let P(acc) = r {
                let fq = c.list([quote, value.cons(c.heap, rtd, V.Int(i))][0..2]);
                let body = c.list([c.sym("%record-ref"), fq, xs][0..3]);
                defs.push(c.list([define, c.list([acc.car, xs][0..2]), body][0..3]));
                r = acc.cdr;
            }
            if let P(md) = r {
                let fq = c.list([quote, value.cons(c.heap, rtd, V.Int(i))][0..2]);
                let body = c.list([c.sym("%record-set!"), fq, xs, vs][0..4]);
                defs.push(c.list([define, c.list([md.car, xs, vs][0..3]), body][0..3]));
            }
        }
        i += 1;
        cur = p.cdr;
    }
    let out = c.list(defs.items());
    defs.free();
    fields.free();
    out
}

/// Flatten `begin`s in a body (they may contain definitions).
fn Comp.flatten(c: *Comp, forms: V, out: *mem.Vec<V>) {
    var cur = forms;
    while let P(p) = cur {
        if c.is_form(p.car, "begin") {
            c.flatten(cdr(c, p.car), out);
        } else if c.is_form(p.car, "define-record-type") {
            c.flatten(cdr(c, c.record_defs(p.car)), out);
        } else {
            out.push(p.car);
        }
        cur = p.cdr;
    }
}

/// (define name expr) / (define (name . params) body...) → (name, value form or lambda).
fn Comp.definition(c: *Comp, x: V) -> (Gc<Sym>, V, bool) {
    let rest = cdr(c, x);
    if list_len(rest) < 1 { fail(c.line, "bad define"); }
    let target = car(c, rest);
    if let Sym(s) = target {
        let e = cdr(c, rest);
        if e == value.nil() { return (s, value.unspec(), false); }
        if list_len(e) != 1 { fail(c.line, "bad define"); }
        return (s, car(c, e), false);
    }
    let P(p) = target else { fail(c.line, "bad define") };
    let Sym(s) = p.car else { fail(c.line, "bad define (curried defines are not supported)") };
    if list_len(cdr(c, rest)) < 1 { fail(c.line, "bad define: empty body"); }
    (s, target, true)
}

/// Build the value of a definition: a lambda for the procedure shorthand.
fn Comp.def_value(c: *Comp, s: Gc<Sym>, form: V, val: V, is_proc: bool) -> *Node {
    if is_proc {
        let n = c.node(K.Lambda);
        n.lam = c.lambda(cdr(c, val), cdr(c, cdr(c, form)), s.name);
        return n;
    }
    // (define f (lambda ...)) names the lambda too.
    if c.is_form(val, "lambda") {
        let saved = c.line;
        c.line = c.line_of(val);
        let rest = cdr(c, val);
        if list_len(rest) < 2 { fail(c.line, "bad lambda"); }
        let n = c.node(K.Lambda);
        n.lam = c.lambda(car(c, rest), cdr(c, rest), s.name);
        c.line = saved;
        return n;
    }
    c.build(val)
}

/// A body: internal definitions (letrec* semantics) followed by expressions.
fn Comp.body(c: *Comp, forms: V) -> *Node {
    var items: mem.Vec<V> = mem.Vec.new();
    c.flatten(forms, &items);
    var ndefs: u64 = 0;
    for i in 0..items.len {
        if c.is_form(items.at(i), "define") { ndefs += 1; }
    }
    if ndefs == 0 {
        let n = c.node(K.Seq);
        for i in 0..items.len { n.list.push(c.build(items.at(i))); }
        items.free();
        if n.list.len == 0 { fail(c.line, "empty body"); }
        if n.list.len == 1 { return n.list.at(0); }
        return n;
    }
    // Bind all names first, then build the inits in order. Expressions
    // between definitions run before the next definition's init.
    let mark = c.env.len;
    let n = c.node(K.Letrec);
    for i in 0..items.len {
        let x = items.at(i);
        if c.is_form(x, "define") {
            let saved = c.line;
            c.line = c.line_of(x);
            let (s, _, _) = c.definition(x);
            let v = c.new_var(s);
            n.vars.push(v);
            c.env.push(v);
            c.line = saved;
        }
    }
    var pending: mem.Vec<*Node> = mem.Vec.new();
    var j: u64 = 0;
    for i in 0..items.len {
        let x = items.at(i);
        if !c.is_form(x, "define") {
            pending.push(c.build(x));
            continue;
        }
        let saved = c.line;
        c.line = c.line_of(x);
        let (s, val, is_proc) = c.definition(x);
        var caps: mem.Vec<u32> = mem.Vec.new();
        for t in 0..n.vars.len { caps.push(n.vars.at(t).caps); }
        var init = c.def_value(s, x, val, is_proc);
        c.check_early_capture(n, j, init, &caps);
        caps.free();
        if pending.len > 0 {
            let sq = c.node(K.Seq);
            sq.list = pending;
            sq.list.push(init);
            init = sq;
            pending = mem.Vec.new();
        }
        n.list.push(init);
        c.line = saved;
        j += 1;
    }
    let body = c.node(K.Seq);
    body.list = pending;
    if body.list.len == 0 { body.list.push(c.konst(value.unspec())); }
    n.a = body;
    c.env.truncate(mark);
    items.free();
    n
}

/// letrec analysis after building init `j` of `n`: a variable (j or later)
/// captured by a closure made while evaluating a non-lambda init must be
/// boxed, since its value is not known yet when the closure copies it.
fn Comp.check_early_capture(c: *Comp, n: *Node, j: u64, init: *Node, caps: *mem.Vec<u32>) {
    let _ = c;
    let v = n.vars.at(j);
    if init.kind == K.Lambda {
        v.lam = init.lam;
        return;
    }
    for i in j..n.vars.len {
        if n.vars.at(i).caps != caps.at(i) { n.vars.at(i).force_box = true; }
    }
}

fn Comp.letrec(c: *Comp, bindings: V, body: V) -> *Node {
    let mark = c.env.len;
    let n = c.node(K.Letrec);
    var cur = bindings;
    while let P(p) = cur {
        let Sym(s) = car(c, p.car) else { fail(c.line, "bad letrec binding") };
        let v = c.new_var(s);
        n.vars.push(v);
        c.env.push(v);
        cur = p.cdr;
    }
    cur = bindings;
    var j: u64 = 0;
    while let P(p) = cur {
        if list_len(p.car) != 2 { fail(c.line, "bad letrec binding"); }
        var caps: mem.Vec<u32> = mem.Vec.new();
        for t in 0..n.vars.len { caps.push(n.vars.at(t).caps); }
        let init = c.def_value(n.vars.at(j).name, p.car, car(c, cdr(c, p.car)), false);
        c.check_early_capture(n, j, init, &caps);
        caps.free();
        n.list.push(init);
        j += 1;
        cur = p.cdr;
    }
    n.a = c.body(body);
    c.env.truncate(mark);
    n
}

fn Comp.let_form(c: *Comp, bindings: V, body: V) -> *Node {
    let n = c.node(K.Let);
    var names: mem.Vec<Gc<Sym> > = mem.Vec.new();
    var cur = bindings;
    while let P(p) = cur {
        let b = p.car;
        if let Sym(s) = b {
            // (let (x) ...): unspecified initial value (an extension).
            names.push(s);
            n.list.push(c.konst(value.unspec()));
        } else {
            let len = list_len(b);
            if len != 2 and len != 1 { fail(c.line, "bad let binding"); }
            let Sym(s) = car(c, b) else { fail(c.line, "bad let binding") };
            names.push(s);
            n.list.push(if len == 2 { c.build(car(c, cdr(c, b))) } else { c.konst(value.unspec()) });
        }
        cur = p.cdr;
    }
    if cur != value.nil() { fail(c.line, "bad let bindings"); }
    let mark = c.env.len;
    for i in 0..names.len {
        let v = c.new_var(names.at(i));
        let init = n.list.at(i);
        if init.kind == K.Lambda { v.lam = init.lam; }
        n.vars.push(v);
        c.env.push(v);
    }
    names.free();
    n.a = c.body(body);
    c.env.truncate(mark);
    n
}

fn Comp.let_star(c: *Comp, bindings: V, body: V) -> *Node {
    let P(p) = bindings else { return c.let_form(value.nil(), body); };
    if p.cdr == value.nil() { return c.let_form(bindings, body); }
    let h = c.heap;
    // (let (b0) (let* rest body...))
    let inner = value.cons(h, c.sym("let*"), value.cons(h, p.cdr, body));
    c.let_form(value.cons(h, p.car, value.nil()), value.cons(h, inner, value.nil()))
}

/// (let name ((v init) ...) body) → ((letrec ((name (lambda (v ...) body))) name) init ...)
fn Comp.named_let(c: *Comp, name: Gc<Sym>, rest: V) -> *Node {
    let bindings = car(c, rest);
    let body = cdr(c, rest);
    let h = c.heap;
    var params = value.nil();
    var inits: mem.Vec<*Node> = mem.Vec.new();
    var names: mem.Vec<V> = mem.Vec.new();
    var cur = bindings;
    while let P(p) = cur {
        if list_len(p.car) != 2 { fail(c.line, "bad named let binding"); }
        names.push(car(c, p.car));
        inits.push(c.build(car(c, cdr(c, p.car))));
        cur = p.cdr;
    }
    var i = names.len;
    while i > 0 { i -= 1; params = value.cons(h, names.at(i), params); }
    names.free();
    let mark = c.env.len;
    let n = c.node(K.Letrec);
    let v = c.new_var(name);
    n.vars.push(v);
    c.env.push(v);
    let lam = c.node(K.Lambda);
    lam.lam = c.lambda(params, body, name.name);
    v.lam = lam.lam;
    n.list.push(lam);
    let call = c.node(K.Call);
    call.a = c.ref_var(v);
    call.list = inits;
    n.a = call;
    c.env.truncate(mark);
    n
}

fn Comp.temp_var(c: *Comp, name: str) -> *Var {
    c.new_var(c.gensym(name))
}

fn Comp.cond(c: *Comp, clauses: V) -> *Node {
    let P(p) = clauses else { return c.konst(value.unspec()); };
    let cl = p.car;
    let saved = c.line;
    c.line = c.line_of(cl);
    if list_len(cl) < 1 { fail(c.line, "bad cond clause"); }
    let test = car(c, cl);
    let body = cdr(c, cl);
    var n = null_node();
    if is_sym(test, "else") and c.lookup(c.ctx.syms.intern(c.heap, "else")).is_none() {
        n = c.seq(body);
    } else if body == value.nil() {
        // (cond (test) rest...) → (or test (cond rest...))
        let o = c.node(K.Or);
        o.list.push(c.build(test));
        o.list.push(c.cond(p.cdr));
        n = o;
    } else if is_sym(car(c, body), "=>") {
        // (let ((t test)) (if t (f t) (cond rest...)))
        let t = c.temp_var("cond-tmp");
        let l = c.node(K.Let);
        l.list.push(c.build(test));
        l.vars.push(t);
        let call = c.node(K.Call);
        call.a = c.build(car(c, cdr(c, body)));
        let r1 = c.node(K.Ref);
        r1.vr = t;
        call.list.push(r1);
        let r2 = c.node(K.Ref);
        r2.vr = t;
        l.a = c.if_node(r2, call, c.cond(p.cdr));
        n = l;
    } else {
        let t = c.build(test);
        let a = c.seq(body);
        let e = if p.cdr == value.nil() { null_node() } else { c.cond(p.cdr) };
        n = c.if_node(t, a, e);
    }
    c.line = saved;
    n
}

fn Comp.case_form(c: *Comp, rest: V) -> *Node {
    if list_len(rest) < 1 { fail(c.line, "bad case"); }
    let t = c.temp_var("case-key");
    let l = c.node(K.Let);
    l.list.push(c.build(car(c, rest)));
    l.vars.push(t);
    l.a = c.case_clauses(t, cdr(c, rest));
    l
}

fn Comp.case_clauses(c: *Comp, t: *Var, clauses: V) -> *Node {
    let P(p) = clauses else { return c.konst(value.unspec()); };
    let cl = p.car;
    if list_len(cl) < 2 { fail(c.line, "bad case clause"); }
    let data = car(c, cl);
    let body = cdr(c, cl);
    var result = null_node();
    if is_sym(car(c, body), "=>") {
        let call = c.node(K.Call);
        call.a = c.build(car(c, cdr(c, body)));
        let r = c.node(K.Ref);
        r.vr = t;
        call.list.push(r);
        result = call;
    } else {
        result = c.seq(body);
    }
    if is_sym(data, "else") { return result; }
    let test = c.node(K.Or);
    var cur = data;
    while let P(d) = cur {
        let r = c.node(K.Ref);
        r.vr = t;
        test.list.push(c.prim2(PO.Eqv, r, c.konst(d.car)));
        cur = d.cdr;
    }
    if test.list.len == 0 { test.list.push(c.konst(value.f())); }
    let e = if p.cdr == value.nil() { null_node() } else { c.case_clauses(t, p.cdr) };
    c.if_node(test, result, e)
}

/// (do ((var init step) ...) (test expr ...) body ...) →
/// (let loop ((var init) ...) (if test (begin expr ...) (begin body ... (loop step ...))))
fn Comp.do_form(c: *Comp, rest: V) -> *Node {
    if list_len(rest) < 2 { fail(c.line, "bad do"); }
    let h = c.heap;
    let specs = car(c, rest);
    let exit = car(c, cdr(c, rest));
    let body = cdr(c, cdr(c, rest));
    if list_len(exit) < 1 { fail(c.line, "bad do exit clause"); }
    let loop_name = c.gensym("do-loop");
    var bindings = value.nil();
    var steps = value.nil();
    var specs_rev = value.nil();
    var cur = specs;
    while let P(p) = cur { specs_rev = value.cons(h, p.car, specs_rev); cur = p.cdr; }
    cur = specs_rev;
    while let P(p) = cur {
        let s = p.car;
        let len = list_len(s);
        if len != 2 and len != 3 { fail(c.line, "bad do variable"); }
        let var_ = car(c, s);
        bindings = value.cons(h, value.cons(h, var_, value.cons(h, car(c, cdr(c, s)), value.nil())), bindings);
        let step = if len == 3 { car(c, cdr(c, cdr(c, s))) } else { var_ };
        steps = value.cons(h, step, steps);
        cur = p.cdr;
    }
    let again = value.cons(h, V.Sym(loop_name), steps);
    // (begin body ... again)
    var seq = value.cons(h, again, value.nil());
    var items: mem.Vec<V> = mem.Vec.new();
    cur = body;
    while let P(p) = cur { items.push(p.car); cur = p.cdr; }
    var i = items.len;
    while i > 0 { i -= 1; seq = value.cons(h, items.at(i), seq); }
    items.free();
    let loop_body = value.cons(h, c.sym("begin"), seq);
    let result = if cdr(c, exit) == value.nil() {
        value.cons(h, c.sym("begin"), value.cons(h, value.unspec(), value.nil()))
    } else {
        value.cons(h, c.sym("begin"), cdr(c, exit))
    };
    let iff = value.cons(h, c.sym("if"), value.cons(h, car(c, exit), value.cons(h, result, value.cons(h, loop_body, value.nil()))));
    c.named_let(loop_name, value.cons(h, bindings, value.cons(h, iff, value.nil())))
}

fn Comp.qq_list2(c: *Comp, name: str, x: *Node) -> *Node {
    // (list 'name x) built from cons.
    c.prim2(PO.Cons, c.konst(c.sym(name)), c.prim2(PO.Cons, x, c.konst(value.nil())))
}

fn has_unquote(x: V) -> bool {
    match x {
        P(p) => {
            if is_sym(p.car, "unquote") or is_sym(p.car, "unquote-splicing") { return true; }
            has_unquote(p.car) or has_unquote(p.cdr)
        }
        Vec(v) => {
            for i in 0..v.data.len {
                if has_unquote(v.data.ptr[i]) { return true; }
            }
            false
        }
        _ => false,
    }
}

/// Call builtin `id` directly (immune to redefinition).
fn Comp.native(c: *Comp, id: i32, args: mem.Vec<*Node>) -> *Node {
    let n = c.node(K.Call);
    n.a = c.konst(value.prim(id));
    n.list = args;
    n
}

fn Comp.qq(c: *Comp, x: V, depth: i32) -> *Node {
    if !has_unquote(x) { return c.konst(x); }
    match x {
        P(p) => {
            if is_sym(p.car, "unquote") {
                if list_len(x) != 2 { fail(c.line, "bad unquote"); }
                if depth == 1 { return c.build(car(c, p.cdr)); }
                return c.qq_list2("unquote", c.qq(car(c, p.cdr), depth - 1));
            }
            if is_sym(p.car, "quasiquote") {
                if list_len(x) != 2 { fail(c.line, "bad quasiquote"); }
                return c.qq_list2("quasiquote", c.qq(car(c, p.cdr), depth + 1));
            }
            if let P(item) = p.car and is_sym(item.car, "unquote-splicing") and depth == 1 {
                if list_len(p.car) != 2 { fail(c.line, "bad unquote-splicing"); }
                var args: mem.Vec<*Node> = mem.Vec.new();
                args.push(c.build(car(c, item.cdr)));
                args.push(c.qq(p.cdr, depth));
                return c.native(45, args);   // append
            }
            c.prim2(PO.Cons, c.qq(p.car, depth), c.qq(p.cdr, depth))
        }
        Vec(v) => {
            var l = value.nil();
            var i = v.data.len;
            while i > 0 { i -= 1; l = value.cons(c.heap, v.data.ptr[i], l); }
            var args: mem.Vec<*Node> = mem.Vec.new();
            args.push(c.qq(l, depth));
            c.native(81, args)   // list->vector
        }
        _ => c.konst(x),
    }
}

/// A top-level form: definitions are globals; `begin` splices.
fn Comp.top(c: *Comp, x: V, out: *mem.Vec<*Node>) {
    let saved = c.line;
    c.line = c.line_of(x);
    if c.is_form(x, "begin") {
        var cur = cdr(c, x);
        while let P(p) = cur { c.top(p.car, out); cur = p.cdr; }
    } else if c.is_form(x, "define-record-type") {
        c.top(c.record_defs(x), out);
    } else if c.is_form(x, "import") {
        // R7RS programs start with (import ...); every library name we
        // know is built in, so there is nothing to do.
    } else if c.is_form(x, "define") {
        let (s, val, is_proc) = c.definition(x);
        let n = c.node(K.GDef);
        n.g = c.ctx.global(s);
        n.a = c.def_value(s, x, val, is_proc);
        let k = n.g as u64;
        c.gdefs.insert(k, (c.gdefs.get(k) ?? 0) + 1);
        if n.a.kind == K.Lambda {
            c.glams.insert(k, n.a.lam);
            c.gprocs.insert(k, true);
        }
        out.push(n);
    } else {
        out.push(c.build(x));
    }
    c.line = saved;
}

/// Note every global the program defines or assigns.
fn Comp.scan_defs(c: *Comp, x: V) {
    var cur = x;
    while let P(p) = cur {
        if is_sym(p.car, "define") or is_sym(p.car, "set!") {
            if let P(q) = p.cdr {
                var t = q.car;
                if let P(tp) = t { t = tp.car; }
                if let Sym(s) = t { c.redefined.insert(s as u64, true); }
            }
        }
        c.scan_defs(p.car);
        cur = p.cdr;
    }
}


// ── inlining ────────────────────────────────────────────────────────
//
// A call of a small known procedure is replaced by its body, with the
// parameters bound by a `let` (or replaced by the argument, when that is a
// constant or an unassigned local). Known procedures are top-level
// `(define (f ...) ...)`s that are the only definition of `f` and are
// never set!, and unassigned letrec-bound lambdas. Bodies with lambdas
// (or letrecs) in them and recursive bodies are not inlined. A call that
// runs before the top-level definition would have failed with "unbound
// variable" (or would have called a builtin of the same name) runs the
// procedure instead; R7RS makes both an error.

const INLINE_SIZE: u32 = 12;
/// The limit when an argument is a lambda: the body is copied with the
/// lambda in place, so calls of it become known (and are inlined in turn).
const INLINE_SIZE_HO: u32 = 40;
const INLINE_DEPTH: u32 = 3;
const TOO_BIG: u32 = 1000000;

/// The size of `n` in nodes, or TOO_BIG if it cannot be inlined (it has
/// lambdas or refers to `self_g` / `self_v`).
fn inline_size(n: *Node, self_g: u64, self_v: *Var) -> u32 {
    if is_null(n) { return 0; }
    match n.kind {
        Lambda => {
            let b = inline_size(n.lam.body, self_g, self_v);
            return if b >= TOO_BIG { TOO_BIG } else { b + 1 };
        }
        GRef => { if n.g as u64 == self_g { return TOO_BIG; } }
        Ref | Set => { if (n.vr as u64) == (self_v as u64) { return TOO_BIG; } }
        _ => {}
    }
    var size: u32 = 1;
    size += inline_size(n.a, self_g, self_v);
    size += inline_size(n.b, self_g, self_v);
    size += inline_size(n.c, self_g, self_v);
    for i in 0..n.list.len {
        size += inline_size(n.list.at(i), self_g, self_v);
        if size >= TOO_BIG { return TOO_BIG; }
    }
    if size >= TOO_BIG { TOO_BIG } else { size }
}

/// Variable substitution while copying: `from` → a node to clone.
struct Subst { from: mem.Vec<*Var>, to: mem.Vec<*Node> }

fn Subst.find(s: *Subst, v: *Var) -> ?*Node {
    for i in 0..s.from.len {
        if (s.from.at(i) as u64) == (v as u64) { return Some(s.to.at(i)); }
    }
    None
}

fn clone_node(n: *Node) -> *Node {
    let m: *Node = mem.alloc(1);
    *m = *n;
    m.list = mem.Vec.new();
    m.vars = mem.Vec.new();
    m
}

fn Comp.fresh_var(c: *Comp, v: *Var) -> *Var {
    let w = c.new_var(v.name);
    w.assigned = v.assigned;
    w
}

/// A copy of `n` with fresh variables for its binders.
fn Comp.copy(c: *Comp, n: *Node, s: *Subst) -> *Node {
    if is_null(n) { return n; }
    if n.kind == K.Ref {
        if let Some(t) = s.find(n.vr) {
            let m = clone_node(t);
            m.line = n.line;
            return m;
        }
        return clone_node(n);
    }
    let m = clone_node(n);
    if n.kind == K.Set and let Some(t) = s.find(n.vr) { m.vr = t.vr; }
    if n.kind == K.Lambda {
        m.lam = c.copy_lam(n.lam, s);
        return m;
    }
    if n.kind == K.Letrec {
        for i in 0..n.vars.len {
            let v = n.vars.at(i);
            let w = c.fresh_var(v);
            w.force_box = v.force_box;
            let r = c.node(K.Ref);
            r.vr = w;
            s.from.push(v);
            s.to.push(r);
            m.vars.push(w);
        }
        for i in 0..n.list.len {
            let init = c.copy(n.list.at(i), s);
            if init.kind == K.Lambda and !is_null_lam(n.vars.at(i).lam) { m.vars.at(i).lam = init.lam; }
            m.list.push(init);
        }
        m.a = c.copy(n.a, s);
        return m;
    }
    if n.kind == K.Let {
        for i in 0..n.list.len { m.list.push(c.copy(n.list.at(i), s)); }
        for i in 0..n.vars.len {
            let w = c.fresh_var(n.vars.at(i));
            if m.list.at(i).kind == K.Lambda { w.lam = m.list.at(i).lam; }
            let r = c.node(K.Ref);
            r.vr = w;
            s.from.push(n.vars.at(i));
            s.to.push(r);
            m.vars.push(w);
        }
        m.a = c.copy(n.a, s);
        return m;
    }
    m.a = c.copy(n.a, s);
    m.b = c.copy(n.b, s);
    m.c = c.copy(n.c, s);
    for i in 0..n.list.len { m.list.push(c.copy(n.list.at(i), s)); }
    m
}

fn Comp.copy_lam(c: *Comp, l: *Lam, s: *Subst) -> *Lam {
    let m: *Lam = mem.alloc(1);
    m.parent = l.parent;
    m.name = l.name;
    m.params = mem.Vec.new();
    m.nparams = l.nparams;
    m.rest = l.rest;
    m.free = mem.Vec.new();
    for i in 0..l.params.len {
        let p = l.params.at(i);
        let w = c.fresh_var(p);
        let r = c.node(K.Ref);
        r.vr = w;
        s.from.push(p);
        s.to.push(r);
        m.params.push(w);
    }
    m.body = c.copy(l.body, s);
    m
}

/// The known procedure called by `f`, if any, with what it may not refer
/// to (itself).
fn Comp.known(c: *Comp, f: *Node) -> ?(*Lam, u64, *Var) {
    if f.kind == K.GRef {
        let g = f.g as u64;
        if (c.gdefs.get(g) ?? 0) != 1 or c.gsets.contains(g) { return None; }
        // Before its definition runs, a global named like a builtin is the builtin.
        if value.prim_of(c.ctx.gvals.at(g)).is_some() { return None; }
        let Some(l) = c.glams.get(g) else { return None; };
        return Some((l, g, 0 as *Var));
    }
    if f.kind == K.Ref {
        let v = f.vr;
        if is_null_lam(v.lam) or v.assigned or v.force_box { return None; }
        return Some((v.lam, 0xFFFFFFFFFFFFFFFF, v));
    }
    None
}

/// Can an inlined call of global `g` in the current top-level form run
/// before g's definition? Not if the definition is in an earlier form, or
/// if no form before it runs program code (they only define procedures
/// and constants, so nothing can call anything until g is bound).
///
/// In the body of a known procedure P, also not if no form before g's
/// can run P (P's first form in `reach` comes after g's definition).
fn Comp.needs_guard(c: *Comp, g: u64) -> bool {
    let Some(f) = c.gform.get(g) else { return true; };
    if f < c.cur_form or f < c.first_impure { return false; }
    if c.cur_proc != NO_PROC and f < (c.reach.get(c.cur_proc) ?? NO_PROC) { return false; }
    true
}

/// Is global `g` a known procedure (defined once, by a lambda, never set!)?
fn Comp.known_global(c: *Comp, g: u64) -> ?*Lam {
    if (c.gdefs.get(g) ?? 0) != 1 or c.gsets.contains(g) { return None; }
    c.glams.get(g)
}

/// Is global `g` a known procedure defined by a lambda (not an alias)?
fn Comp.known_proc(c: *Comp, g: u64) -> bool {
    c.known_global(g).is_some() and c.gprocs.contains(g)
}

/// The globals referenced anywhere in `n` (lambda bodies included).
fn grefs(n: *Node, out: *mem.Vec<u64>) {
    if is_null(n) { return; }
    if n.kind == K.GRef { out.push(n.g as u64); }
    if n.kind == K.Lambda { grefs(n.lam.body, out); return; }
    grefs(n.a, out);
    grefs(n.b, out);
    grefs(n.c, out);
    for i in 0..n.list.len { grefs(n.list.at(i), out); }
}

/// For each known procedure, the first top-level form that may run its
/// body: a procedure's body runs only once something calls it, and a call
/// needs a reference to it (by name, or a value that came from one).
/// Every form but a procedure definition runs at once, and so may run
/// whatever it references (or stores for later), and what those bodies
/// reference in turn. (Builtins never call procedures but through `apply`
/// and call/cc, whose arguments are such values.)
fn Comp.reachability(c: *Comp, nodes: *mem.Vec<*Node>) {
    var work: mem.Vec<u64> = mem.Vec.new();
    for i in 0..nodes.len {
        let n = nodes.at(i);
        if n.kind == K.GDef and n.a.kind == K.Lambda { continue; }
        grefs(n, &work);
        while let Some(g) = work.pop() {
            if c.reach.contains(g) { continue; }
            c.reach.insert(g, i);
            if let Some(l) = c.known_global(g) { grefs(l.body, &work); }
        }
    }
    work.free();
}

/// Is `n` a reference to a known top-level procedure that is certainly
/// bound here (so it can be substituted for a parameter)?
fn Comp.bound_known(c: *Comp, n: *Node) -> bool {
    n.kind == K.GRef and c.known(n).is_some() and !c.needs_guard(n.g as u64)
}

/// May evaluating `n` run program code (call anything but a builtin)?
/// Lambda bodies do not run when the closure is made.
fn may_call(n: *Node) -> bool {
    if is_null(n) { return false; }
    if n.kind == K.Lambda { return false; }
    if n.kind == K.Call {
        let f = n.a;
        if f.kind != K.Const { return true; }
        let Some(id) = value.prim_of(f.v) else { return true; };
        if id == Prim.Apply as i32 or id == Prim.CallCc as i32 { return true; }
    }
    if may_call(n.a) or may_call(n.b) or may_call(n.c) { return true; }
    for i in 0..n.list.len {
        if may_call(n.list.at(i)) { return true; }
    }
    false
}

/// Inline the small known procedures called in `n`; returns the new node.
fn Comp.inl(c: *Comp, n: *Node, depth: u32) -> *Node {
    if is_null(n) { return n; }
    if n.kind == K.Lambda {
        n.lam.body = c.inl(n.lam.body, depth);
        return n;
    }
    n.a = c.inl(n.a, depth);
    n.b = c.inl(n.b, depth);
    n.c = c.inl(n.c, depth);
    for i in 0..n.list.len { n.list.set(i, c.inl(n.list.at(i), depth)); }
    if n.kind != K.Call { return n; }
    if n.a.kind == K.GRef and let Some(id) = c.galias.get(n.a.g as u64) {
        let g = n.a.g;
        n.a = c.konst(value.prim(id));
        if c.needs_guard(g as u64) {
            let chk = c.node(K.GChk);
            chk.line = n.line;
            chk.g = g;
            let sq = c.node(K.Seq);
            sq.line = n.line;
            sq.list.push(chk);
            sq.list.push(c.inl(n, depth));
            return sq;
        }
    }
    // A builtin substituted for a parameter, as in (map car l): an op.
    if n.a.kind == K.Const and let Some(id) = value.prim_of(n.a.v) {
        if let Some(po) = (id as Prim).op() and po.arity() as u64 == n.list.len {
            n.kind = K.Prim;
            n.po = po;
            n.a = null_node();
            return n;
        }
    }
    let Some((l, g, self_v)) = c.known(n.a) else { return n; };
    if n.a.kind == K.GRef {
        n.lam = l;
        n.direct = !c.needs_guard(g);
    }
    if depth >= INLINE_DEPTH { return n; }
    if l.rest or l.nparams as u64 != n.list.len { return n; }
    var limit = INLINE_SIZE;
    for i in 0..n.list.len {
        let a = n.list.at(i);
        if a.kind == K.Lambda or c.bound_known(a)
            or (a.kind == K.Const and value.prim_of(a.v).is_some()) { limit = INLINE_SIZE_HO; }
    }
    if inline_size(l.body, g, self_v) > limit { return n; }
    // (let ((p arg) ...) body), substituting constants and unassigned
    // locals for unassigned parameters.
    var s = Subst { from: mem.Vec.new(), to: mem.Vec.new() };
    let lt = c.node(K.Let);
    lt.line = n.line;
    for i in 0..n.list.len {
        let p = l.params.at(i);
        let a = n.list.at(i);
        if !p.assigned and (a.kind == K.Const or (a.kind == K.Ref and !a.vr.assigned) or c.bound_known(a)) {
            s.from.push(p);
            s.to.push(a);
            continue;
        }
        let w = c.fresh_var(p);
        if a.kind == K.Lambda { w.lam = a.lam; }
        let r = c.node(K.Ref);
        r.vr = w;
        s.from.push(p);
        s.to.push(r);
        lt.vars.push(w);
        lt.list.push(a);
    }
    let body = c.copy(l.body, &s);
    s.from.free();
    s.to.free();
    var out = body;
    if lt.vars.len > 0 {
        lt.a = body;
        out = lt;
    }
    if n.a.kind == K.GRef and c.needs_guard(n.a.g as u64) {
        // (begin <check that f is bound> body)
        let chk = c.node(K.GChk);
        chk.line = n.line;
        chk.g = n.a.g;
        let sq = c.node(K.Seq);
        sq.line = n.line;
        sq.list.push(chk);
        sq.list.push(out);
        out = sq;
    }
    c.inl(out, depth + 1)
}

// ── contification ───────────────────────────────────────────────────
//
// A letrec-bound lambda whose every reference is a call in tail position
// of the letrec body or of another contified lambda of the same letrec
// (a named-let loop, mutually tail-recursive local procedures) never
// needs a closure: its body is compiled inline in the enclosing
// procedure, its parameters become registers there, and the calls become
// moves and jumps. Its "return" is the continuation of the letrec. Inner
// letrecs are decided first, so a contified inner body counts as part of
// the frame (and of the tail positions) of the procedure around it.

fn in_free(l: *Lam, v: *Var) -> bool {
    for i in 0..l.free.len {
        if (l.free.at(i) as u64) == (v as u64) { return true; }
    }
    false
}

/// Is every reference to `v` in `n` a call with `nargs` arguments in tail
/// position (when `tail`) and in the same frame?
fn tail_refs_only(n: *Node, v: *Var, tail: bool, nargs: u64) -> bool {
    if is_null(n) { return true; }
    match n.kind {
        Const | GRef | GChk => true,
        Ref => (n.vr as u64) != (v as u64),
        Set => (n.vr as u64) != (v as u64) and tail_refs_only(n.a, v, false, nargs),
        GSet | GDef => tail_refs_only(n.a, v, false, nargs),
        If => tail_refs_only(n.a, v, false, nargs) and tail_refs_only(n.b, v, tail, nargs)
            and tail_refs_only(n.c, v, tail, nargs),
        Lambda => !in_free(n.lam, v),
        Seq | And | Or => {
            for i in 0..n.list.len {
                if !tail_refs_only(n.list.at(i), v, tail and i + 1 == n.list.len, nargs) { return false; }
            }
            true
        }
        Prim => {
            for i in 0..n.list.len {
                if !tail_refs_only(n.list.at(i), v, false, nargs) { return false; }
            }
            true
        }
        Call => {
            let f = n.a;
            if f.kind == K.Ref and (f.vr as u64) == (v as u64) {
                if !tail or n.list.len != nargs { return false; }
            } else if !tail_refs_only(f, v, false, nargs) {
                return false;
            }
            for i in 0..n.list.len {
                if !tail_refs_only(n.list.at(i), v, false, nargs) { return false; }
            }
            true
        }
        Let => {
            for i in 0..n.list.len {
                if !tail_refs_only(n.list.at(i), v, false, nargs) { return false; }
            }
            tail_refs_only(n.a, v, tail, nargs)
        }
        Letrec => {
            for i in 0..n.list.len {
                let init = n.list.at(i);
                if init.kind == K.Lambda and init.lam.cont {
                    if !tail_refs_only(init.lam.body, v, tail, nargs) { return false; }
                } else if !tail_refs_only(init, v, false, nargs) {
                    return false;
                }
            }
            tail_refs_only(n.a, v, tail, nargs)
        }
    }
}

fn contify(n: *Node) {
    if is_null(n) { return; }
    if n.kind == K.Lambda { contify(n.lam.body); return; }
    contify(n.a);
    contify(n.b);
    contify(n.c);
    for i in 0..n.list.len { contify(n.list.at(i)); }
    if n.kind != K.Letrec { return; }
    // Candidates: unassigned, unboxed lambdas with fixed parameters.
    var cand: mem.Vec<bool> = mem.Vec.new();
    for i in 0..n.vars.len {
        let v = n.vars.at(i);
        let init = n.list.at(i);
        cand.push(init.kind == K.Lambda and !v.assigned and !boxed(v) and !init.lam.rest);
    }
    var changed = true;
    while changed {
        changed = false;
        for i in 0..n.vars.len {
            if !cand.at(i) { continue; }
            let v = n.vars.at(i);
            let np = n.list.at(i).lam.nparams as u64;
            var ok = tail_refs_only(n.a, v, true, np);
            for j in 0..n.list.len {
                if !ok { break; }
                let init = n.list.at(j);
                if cand.at(j) {
                    ok = tail_refs_only(init.lam.body, v, true, np);
                } else {
                    ok = tail_refs_only(init, v, false, np);
                }
            }
            if !ok {
                cand.set(i, false);
                changed = true;
            }
        }
    }
    for i in 0..n.vars.len {
        if cand.at(i) { n.list.at(i).lam.cont = true; }
    }
    cand.free();
}

/// After contification: give every variable its real owner (the procedure
/// whose frame holds it), re-parent the lambdas, and recompute `captured`
/// (a variable used only by contified code is no longer captured, so an
/// assigned one needs no box).
fn bind_here(v: *Var, real: *Lam) {
    v.owner = real;
    v.captured = false;
    v.refs = 0;
}

/// A reference to `v` from `real`: `v` is free in every lambda from
/// `real` out to its owner.
fn note_ref(v: *Var, real: *Lam) {
    v.refs += 1;
    var l = real;
    while (l as u64) != (v.owner as u64) {
        v.captured = true;
        if !in_free(l, v) { l.free.push(v); }
        l = l.parent;
    }
}

fn reown(n: *Node, real: *Lam) {
    if is_null(n) { return; }
    match n.kind {
        Ref => note_ref(n.vr, real),
        Set => {
            note_ref(n.vr, real);
            reown(n.a, real);
        }
        Lambda => reown_lambda(n.lam, real),
        Let => {
            for i in 0..n.list.len { reown(n.list.at(i), real); }
            for i in 0..n.vars.len { bind_here(n.vars.at(i), real); }
            reown(n.a, real);
        }
        Letrec => {
            for i in 0..n.vars.len { bind_here(n.vars.at(i), real); }
            for i in 0..n.list.len { reown(n.list.at(i), real); }
            reown(n.a, real);
        }
        _ => {
            reown(n.a, real);
            reown(n.b, real);
            reown(n.c, real);
            for i in 0..n.list.len { reown(n.list.at(i), real); }
        }
    }
}

fn reown_lambda(l: *Lam, real: *Lam) {
    if l.cont {
        for i in 0..l.params.len { bind_here(l.params.at(i), real); }
        reown(l.body, real);
        return;
    }
    l.parent = real;
    l.free.truncate(0);
    for i in 0..l.params.len { bind_here(l.params.at(i), l); }
    reown(l.body, l);
}

// ── pass 2: code generation ─────────────────────────────────────────

struct FS {
    lam: *Lam,
    code: bc.Code<u32>,
    consts: bc.Pool<V>,
    protos: mem.Vec<Gc<Proto> >,
    /// Scheme has no locals in the allocator's sense: every expression
    /// saves `regs.top` and restores it when done.
    regs: bc.Regs,
    line: u32,
    /// The pc of the last jump to a continuation's join, and its label.
    join_at: u64,
    join_id: u32,
    /// Per free slot of `lam`: 1 + the register that holds its value
    /// (loaded once on entry), or 0 (read with GETFREE at each use).
    fcache: mem.Vec<u32>,
}

struct Gen {
    ctx: *Ctx,
    heap: *gc.Heap,
    fs: *FS,
    comp: *Comp,
    /// The closures of known top-level procedures without free variables,
    /// made by the compiler (constants of CALLK and of their definitions),
    /// and how many were made for a call before their definition was
    /// compiled (their proto is a placeholder until then).
    kclos: map.HashMap<u64, Gc<Closure> >,
    kpending: u64,
}

/// The constant closure of known procedure `g` (see Gen.kclos).
fn Gen.known_closure(g: *Gen, gl: u64) -> Gc<Closure> {
    if let Some(cl) = g.kclos.get(gl) { return cl; }
    let Some(cp) = g.ctx.cont_proto else { fail(0, "internal error: no placeholder proto") };
    let cl = value.new_closure(g.heap, cp);
    g.kclos.insert(gl, cl);
    g.kpending += 1;
    cl
}

fn FS.new(l: *Lam) -> FS {
    FS {
        lam: l,
        code: bc.Code.new(Scheme.op_size, Scheme.set_label),
        consts: bc.Pool.new(65535),
        protos: mem.Vec.new(),
        regs: bc.Regs.new(250),
        line: 0,
        join_at: 0xFFFFFFFFFFFFFFFF,
        join_id: 0,
        fcache: mem.Vec.new(),
    }
}

fn Gen.emit(g: *Gen, w: u32) -> u64 {
    g.fs.code.set_loc(g.fs.line);
    g.fs.code.op(w)
}

/// Emit jump `w` to label `l`.
fn Gen.jump(g: *Gen, w: u32, l: bc.Label) {
    g.fs.code.set_loc(g.fs.line);
    g.fs.code.jump(w, l);
}

fn Gen.alloc(g: *Gen) -> u32 {
    g.fs.regs.try_alloc(1) ?? fail(g.fs.line, "procedure needs too many registers")
}

fn Gen.top(g: *Gen) -> u32 { g.fs.regs.top }
fn Gen.reset(g: *Gen, top: u32) { g.fs.regs.reset(top); }

/// Point the pending jumps `js` here (a jump that does not fit is
/// reported when the procedure ends).
fn Gen.patch_here(g: *Gen, js: mem.Vec<u64>) {
    var v = js;
    g.fs.code.patch_here(&v);
    v.free();
}

/// Constants are equal when their bits are (symbols are interned).
fn Gen.constant(g: *Gen, v: V) -> u32 {
    g.fs.consts.add(v) ?? fail(g.fs.line, "too many constants")
}

fn Gen.load_const(g: *Gen, v: V, dst: u32) {
    if let Int(i) = v and i >= -32768 and i <= 32767 {
        g.emit(Scheme.LOADI(dst as u8, i as i16));
        return;
    }
    let k = g.constant(v);
    g.emit(Scheme.LOADK(dst as u8, k as u16));
}

fn free_index(l: *Lam, v: *Var) -> u32 {
    for i in 0..l.free.len {
        if (l.free.at(i) as u64) == (v as u64) { return i as u32; }
    }
    fail(0, "internal error: free variable not found")
}

fn is_local(g: *Gen, v: *Var) -> bool { (v.owner as u64) == (g.fs.lam as u64) }

/// The register caching free variable `v` of the current procedure, if any.
fn Gen.cached(g: *Gen, v: *Var) -> ?u32 {
    if g.fs.fcache.len == 0 { return None; }
    let r = g.fs.fcache.at(free_index(g.fs.lam, v) as u64);
    if r == 0 { None } else { Some(r - 1) }
}

/// Static uses of the free variables of `l` in `n` (its frame's code:
/// contified bodies included, closures not), weighted 10 inside loops.
fn free_uses(l: *Lam, n: *Node, w: u32, uses: *mem.Vec<u32>) {
    if is_null(n) { return; }
    if (n.kind == K.Ref or n.kind == K.Set) and (n.vr.owner as u64) != (l as u64) {
        for i in 0..l.free.len {
            if (l.free.at(i) as u64) == (n.vr as u64) { uses.set(i, uses.at(i) + w); }
        }
    }
    if n.kind == K.Lambda {
        if n.lam.cont { free_uses(l, n.lam.body, 10, uses); }
        return;
    }
    free_uses(l, n.a, w, uses);
    free_uses(l, n.b, w, uses);
    free_uses(l, n.c, w, uses);
    for i in 0..n.list.len { free_uses(l, n.list.at(i), w, uses); }
}

/// A register holding the value of `n` (a local's own register if possible).
fn Gen.any(g: *Gen, n: *Node) -> u32 {
    if n.kind == K.Ref and is_local(g, n.vr) and !boxed(n.vr) { return n.vr.reg; }
    if n.kind == K.Ref and !is_local(g, n.vr) and !boxed(n.vr) and let Some(r) = g.cached(n.vr) { return r; }
    let r = g.alloc();
    g.to(n, r);
    r
}

fn Gen.set_line(g: *Gen, n: *Node) -> u32 {
    let saved = g.fs.line;
    if n.line != 0 { g.fs.line = n.line; }
    saved
}

/// Emit code leaving the value of `n` in register `dst`.
fn Gen.to(g: *Gen, n: *Node, dst: u32) {
    let saved_line = g.set_line(n);
    let save = g.top();
    let d = dst as u8;
    match n.kind {
        Const => g.load_const(n.v, dst),
        Ref => {
            let v = n.vr;
            if !is_null_lam(v.lam) and v.lam.cont { fail(g.fs.line, "internal error: contified procedure used as a value"); }
            if is_local(g, v) {
                if boxed(v) {
                    g.emit(Scheme.BOXGET(d, v.reg as u8));
                } else if v.reg != dst {
                    g.emit(Scheme.MOVE(d, v.reg as u8));
                }
            } else if let Some(r) = g.cached(v) {
                if boxed(v) {
                    g.emit(Scheme.BOXGET(d, r as u8));
                } else if r != dst {
                    g.emit(Scheme.MOVE(d, r as u8));
                }
            } else {
                g.emit(Scheme.GETFREE(d, free_index(g.fs.lam, v) as u8));
                if boxed(v) { g.emit(Scheme.BOXGET(d, d)); }
            }
        }
        GRef => { g.emit(Scheme.GETGLOBAL(d, n.g as u16)); }
        Set | GSet | GDef | GChk => {
            g.effect(n);
            g.load_const(value.unspec(), dst);
        }
        If => {
            let j = g.cond(n.a);
            g.to(n.b, dst);
            let done = g.fs.code.label();
            g.jump(Scheme.JMP(0), done);
            g.patch_here(j);
            if is_null(n.c) { g.load_const(value.unspec(), dst); } else { g.to(n.c, dst); }
            g.fs.code.bind(done);
        }
        Lambda => {
            let idx = g.lambda(n.lam);
            g.emit(Scheme.CLOSURE(d, idx as u16));
        }
        Seq => {
            for i in 0..n.list.len - 1 { g.effect(n.list.at(i)); }
            g.to(n.list.at(n.list.len - 1), dst);
        }
        Call => g.call(n, dst, false),
        Prim => g.prim(n, dst),
        Let => { g.bind_let(n); g.to(n.a, dst); }
        Letrec => {
            if has_cont(n) {
                let k = Cont { mode: REG, dst: dst, join: g.fs.code.label() };
                g.letrec_k(n, k);
                g.bind_join(k);
            } else {
                g.bind_letrec(n);
                g.to(n.a, dst);
            }
        }
        And | Or => {
            let done = g.fs.code.label();
            for i in 0..n.list.len {
                g.to(n.list.at(i), dst);
                if i + 1 < n.list.len {
                    g.jump(if n.kind == K.And { Scheme.TEST(d, 0) } else { Scheme.TESTT(d, 0) }, done);
                }
            }
            g.fs.code.bind(done);
        }
    }
    g.reset(save);
    g.fs.line = saved_line;
}

/// Evaluate `n` for its effects only.
fn Gen.effect(g: *Gen, n: *Node) {
    let saved_line = g.set_line(n);
    let save = g.top();
    match n.kind {
        Const | Ref | GRef | Lambda => {}
        GChk => { g.emit(Scheme.CHKGLOBAL(0, n.g as u16)); }
        Set => {
            let v = n.vr;
            let r = g.any(n.a);
            if is_local(g, v) {
                if boxed(v) {
                    g.emit(Scheme.BOXSET(v.reg as u8, r as u8));
                } else if r != v.reg {
                    g.emit(Scheme.MOVE(v.reg as u8, r as u8));
                }
            } else if let Some(b) = g.cached(v) {
                g.emit(Scheme.BOXSET(b as u8, r as u8));
            } else {
                let t = g.alloc();
                g.emit(Scheme.GETFREE(t as u8, free_index(g.fs.lam, v) as u8));
                g.emit(Scheme.BOXSET(t as u8, r as u8));
            }
        }
        GSet => {
            let r = g.any(n.a);
            g.emit(Scheme.SETGLOBAL(r as u8, n.g as u16));
        }
        GDef => {
            let gl = n.g as u64;
            if n.a.kind == K.Lambda and n.a.lam.free.len == 0 and g.comp.known_proc(gl) {
                // A known procedure: its closure is a constant.
                let idx = g.lambda(n.a.lam);
                let proto = g.fs.protos.at(idx as u64);
                let cl = if let Some(c0) = g.kclos.get(gl) {
                    g.kpending -= 1;
                    c0
                } else {
                    let c1 = value.new_closure(g.heap, proto);
                    g.kclos.insert(gl, c1);
                    c1
                };
                cl.proto = proto;
                let r = g.alloc();
                g.load_const(V.Clo(cl), r);
                g.emit(Scheme.DEFGLOBAL(r as u8, n.g as u16));
            } else {
                let r = g.any(n.a);
                g.emit(Scheme.DEFGLOBAL(r as u8, n.g as u16));
            }
        }
        If => {
            let j = g.cond(n.a);
            g.effect(n.b);
            if is_null(n.c) {
                g.patch_here(j);
            } else {
                let done = g.fs.code.label();
                g.jump(Scheme.JMP(0), done);
                g.patch_here(j);
                g.effect(n.c);
                g.fs.code.bind(done);
            }
        }
        Seq => {
            for i in 0..n.list.len { g.effect(n.list.at(i)); }
        }
        Let => { g.bind_let(n); g.effect(n.a); }
        Letrec => {
            if has_cont(n) {
                let k = Cont { mode: EFFECT, dst: 0, join: g.fs.code.label() };
                g.letrec_k(n, k);
                g.bind_join(k);
            } else {
                g.bind_letrec(n);
                g.effect(n.a);
            }
        }
        Prim => {
            // Mutators need no result.
            if n.po == PO.SetCar or n.po == PO.SetCdr or n.po == PO.Vset {
                if n.po == PO.Vset and let Some(k) = small_const(n.list.at(1)) and k >= 0 {
                    let a = g.any(n.list.at(0)) as u8;
                    let c = g.any(n.list.at(2)) as u8;
                    g.emit(Scheme.VSETI(a, k as u8, c));
                    g.reset(save);
                    g.fs.line = saved_line;
                    return;
                }
                let a = g.any(n.list.at(0)) as u8;
                let b = g.any(n.list.at(1)) as u8;
                if n.po == PO.Vset {
                    let c = g.any(n.list.at(2)) as u8;
                    g.emit(Scheme.VSET(a, b, c));
                } else if n.po == PO.SetCar {
                    g.emit(Scheme.SETCAR(a, b));
                } else {
                    g.emit(Scheme.SETCDR(a, b));
                }
            } else {
                let r = g.alloc();
                g.to(n, r);
            }
        }
        _ => {
            let r = g.alloc();
            g.to(n, r);
        }
    }
    g.reset(save);
    g.fs.line = saved_line;
}

/// Where the value of an expression in tail position goes: returned from
/// the procedure (RET), or, for the body of a letrec whose contified
/// lambdas return to the letrec's own continuation, into register `dst`
/// (REG) or nowhere (EFFECT), followed by a jump to `join`.
const RET: u32 = 0;
const REG: u32 = 1;
const EFFECT: u32 = 2;
struct Cont { mode: u32, dst: u32, join: bc.Label }

fn ret_cont() -> Cont { Cont { mode: RET, dst: 0, join: bc.Label { id: 0 } } }

/// Return the value of `n` from the current procedure.
fn Gen.tail(g: *Gen, n: *Node) { g.tailk(n, ret_cont()); }

/// Jump to the continuation's join point.
fn Gen.to_join(g: *Gen, k: Cont) {
    g.fs.join_at = g.fs.code.pc();
    g.fs.join_id = k.join.id;
    g.jump(Scheme.JMP(0), k.join);
}

/// Bind `k.join` here, dropping a jump to it just before.
fn Gen.bind_join(g: *Gen, k: Cont) {
    if let Some(at) = g.fs.code.last() and at == g.fs.join_at and k.join.id == g.fs.join_id {
        g.fs.code.truncate(at);
    }
    g.fs.code.bind(k.join);
}

/// Deliver the value of `n` to continuation `k`.
fn Gen.tailk(g: *Gen, n: *Node, k: Cont) {
    let saved_line = g.set_line(n);
    let save = g.top();
    match n.kind {
        If => {
            let j = g.cond(n.a);
            g.tailk(n.b, k);
            g.patch_here(j);
            if is_null(n.c) {
                g.value_k(n.c, k);
            } else {
                g.tailk(n.c, k);
            }
        }
        Seq => {
            for i in 0..n.list.len - 1 { g.effect(n.list.at(i)); }
            g.tailk(n.list.at(n.list.len - 1), k);
        }
        Call => g.call_k(n, k),
        Let => { g.bind_let(n); g.tailk(n.a, k); }
        Letrec => g.letrec_k(n, k),
        And | Or => {
            // Operands that are tested with jumps: every and operand (a
            // false one makes the value #f), and boolean-valued or
            // operands (a true one makes it #t).
            var exits: mem.Vec<u64> = mem.Vec.new();
            var start: u64 = 0;
            let sense = n.kind == K.Or;
            while start + 1 < n.list.len and (n.kind == K.And or is_boolean(n.list.at(start))) {
                g.branch(n.list.at(start), sense, &exits);
                start += 1;
            }
            if start + 1 == n.list.len {
                g.tailk(n.list.at(start), k);
                if exits.len > 0 {
                    g.patch_here(exits);
                    let c = g.konst_node(value.boolean(sense));
                    g.value_k(c, k);
                } else {
                    exits.free();
                }
            } else {
                // A non-boolean or operand: its value is the result.
                var rest = n.list;
                let r = if k.mode == REG { k.dst } else { g.alloc() };
                let done = if k.mode == RET { g.fs.code.label() } else { k.join };
                if exits.len > 0 {
                    // Each earlier operand jumped to a #t exit.
                    var skip: mem.Vec<u64> = mem.Vec.new();
                    skip.push(g.emit(Scheme.JMP(0)));
                    g.patch_here(exits);
                    g.load_const(value.t(), r);
                    g.jump(Scheme.JMP(0), done);
                    g.patch_here(skip);
                } else {
                    exits.free();
                }
                for i in start..rest.len - 1 {
                    g.to(rest.at(i), r);
                    g.jump(Scheme.TESTT(r as u8, 0), done);
                }
                g.tailk(rest.at(rest.len - 1), k);
                if k.mode == RET {
                    g.fs.code.bind(done);
                    g.emit(Scheme.RET(r as u8));
                }
            }
        }
        _ => g.value_k(n, k),
    }
    g.reset(save);
    g.fs.line = saved_line;
}

fn Gen.konst_node(g: *Gen, v: V) -> *Node {
    let _ = g;
    let n: *Node = mem.alloc(1);
    n.kind = K.Const;
    n.v = v;
    n.list = mem.Vec.new();
    n.vars = mem.Vec.new();
    n
}

/// Deliver the value of `n` (a non-tail form; null: unspecified) to `k`.
fn Gen.value_k(g: *Gen, n: *Node, k: Cont) {
    let save = g.top();
    if k.mode == RET {
        var r: u32 = 0;
        if is_null(n) {
            r = g.alloc();
            g.load_const(value.unspec(), r);
        } else {
            r = g.any(n);
        }
        g.emit(Scheme.RET(r as u8));
    } else {
        if k.mode == REG {
            if is_null(n) { g.load_const(value.unspec(), k.dst); } else { g.to(n, k.dst); }
        } else if !is_null(n) {
            g.effect(n);
        }
        g.to_join(k);
    }
    g.reset(save);
}

/// A call in tail position.
fn Gen.call_k(g: *Gen, n: *Node, k: Cont) {
    let f = n.a;
    if f.kind == K.Ref and !is_null_lam(f.vr.lam) and f.vr.lam.cont {
        let l = f.vr.lam;
        g.move_args(n, l);
        g.jump(Scheme.JMP(0), l.label);
        return;
    }
    if k.mode == RET {
        let r = g.top();
        g.call(n, r, true);
        return;
    }
    if k.mode == REG {
        g.call(n, k.dst, false);
    } else {
        let r = g.alloc();
        g.call(n, r, false);
    }
    g.to_join(k);
}

fn is_null_lam(l: *Lam) -> bool { (l as u64) == 0 }

/// A letrec in tail position: closures for the lambdas that are not
/// contified, registers for the parameters of those that are, then the
/// body, then the contified bodies, all delivering to `k`.
fn Gen.letrec_k(g: *Gen, n: *Node, k: Cont) {
    g.bind_letrec(n);
    var first = null_lam();
    for i in 0..n.list.len {
        let init = n.list.at(i);
        if init.kind != K.Lambda or !init.lam.cont { continue; }
        let l = init.lam;
        for j in 0..l.params.len { l.params.at(j).reg = g.alloc(); }
        l.label = g.fs.code.label();
    }
    // The free variables the loops use are loaded into registers before
    // entering them: closures are flat and their slots never change (an
    // assigned variable's slot holds its box).
    let fl = g.fs.lam;
    var hoisted: mem.Vec<u32> = mem.Vec.new();
    if fl.free.len > 0 {
        var uses: mem.Vec<u32> = mem.Vec.new();
        for i in 0..fl.free.len { uses.push(0); }
        for i in 0..n.list.len {
            let init = n.list.at(i);
            if init.kind == K.Lambda and init.lam.cont { free_uses(fl, init.lam.body, 1, &uses); }
        }
        for i in 0..fl.free.len {
            if uses.at(i) > 0 and g.fs.fcache.at(i) == 0 {
                let r = g.alloc();
                g.emit(Scheme.GETFREE(r as u8, i as u8));
                g.fs.fcache.set(i, r + 1);
                hoisted.push(i as u32);
            }
        }
        uses.free();
    }
    // A body that just enters a contified lambda (a named let) falls
    // through into it.
    let b = n.a;
    if b.kind == K.Call and b.a.kind == K.Ref and !is_null_lam(b.a.vr.lam) and b.a.vr.lam.cont {
        first = b.a.vr.lam;
        let saved_line = g.set_line(b);
        g.move_args(b, first);
        g.fs.line = saved_line;
        g.cont_body(first, k);
    } else {
        g.tailk(b, k);
    }
    for i in 0..n.list.len {
        let init = n.list.at(i);
        if init.kind != K.Lambda or !init.lam.cont or (init.lam as u64) == (first as u64) { continue; }
        g.cont_body(init.lam, k);
    }
    for i in 0..hoisted.len { g.fs.fcache.set(hoisted.at(i) as u64, 0); }
    hoisted.free();
}

fn null_lam() -> *Lam { 0 as *Lam }

fn Gen.cont_body(g: *Gen, l: *Lam, k: Cont) {
    g.fs.code.bind(l.label);
    for i in 0..l.params.len {
        let v = l.params.at(i);
        if boxed(v) { g.emit(Scheme.MKBOX(v.reg as u8)); }
    }
    g.tailk(l.body, k);
}

/// Store the arguments of call `n` into the parameters of `l` (a jump to
/// its start follows). Arguments that are their own parameter need
/// nothing. An argument that is a single op (and whose parameter no other
/// argument reads) is computed straight into its parameter; the rest go
/// to temporaries first, and are moved last.
fn Gen.move_args(g: *Gen, n: *Node, l: *Lam) {
    let nargs = n.list.len;
    let save = g.top();
    var mode: mem.Vec<u32> = mem.Vec.new();   // 0 same, 1 direct, 2 temp
    for i in 0..nargs {
        let a = n.list.at(i);
        let p = l.params.at(i);
        if a.kind == K.Ref and (a.vr as u64) == (p as u64) and !boxed(p) { mode.push(0); continue; }
        var direct = a.kind == K.Prim or a.kind == K.Const or a.kind == K.Ref or a.kind == K.GRef;
        for j in 0..nargs {
            if j != i and mentions(n.list.at(j), p) { direct = false; }
        }
        mode.push(if direct { 1 } else { 2 });
    }
    let base = g.top();
    for i in 0..nargs {
        let r = g.alloc();
        if mode.at(i) == 2 { g.to(n.list.at(i), r); }
    }
    for i in 0..nargs {
        if mode.at(i) == 1 { g.to(n.list.at(i), l.params.at(i).reg); }
    }
    for i in 0..nargs {
        if mode.at(i) == 2 { g.emit(Scheme.MOVE(l.params.at(i).reg as u8, (base + i as u32) as u8)); }
    }
    mode.free();
    g.reset(save);
}

/// Emit a test of `n`; returns the jumps to patch, taken when `n` is false.
/// `(not x)` tests x the other way round, and `(and a b ...)` tests each
/// operand in turn.
fn Gen.cond(g: *Gen, n: *Node) -> mem.Vec<u64> {
    var js: mem.Vec<u64> = mem.Vec.new();
    g.cond_into(n, &js);
    js
}

fn Gen.cond_into(g: *Gen, n: *Node, js: *mem.Vec<u64>) { g.branch(n, false, js); }

/// Emit code that jumps (adding the jumps to `js`) when the truth of `n`
/// is `sense`, and falls through otherwise. `not` flips the sense;
/// `and`/`or` branch on each operand in turn.
fn Gen.branch(g: *Gen, n: *Node, sense: bool, js: *mem.Vec<u64>) {
    let saved_line = g.set_line(n);
    let save = g.top();
    if n.kind == K.Prim and n.po == PO.Not {
        g.branch(n.list.at(0), !sense, js);
    } else if n.kind == K.And or n.kind == K.Or {
        // (and ...) is false when some operand is; (or ...) is true when
        // some operand is. The other way round, all but the last operand
        // must be tested the opposite way to skip the jump.
        let any_jumps = (n.kind == K.And) != sense;
        if any_jumps {
            for i in 0..n.list.len { g.branch(n.list.at(i), sense, js); }
        } else {
            var skip: mem.Vec<u64> = mem.Vec.new();
            for i in 0..n.list.len - 1 { g.branch(n.list.at(i), !sense, &skip); }
            g.branch(n.list.at(n.list.len - 1), sense, js);
            g.patch_here(skip);
        }
    } else if n.kind == K.Const {
        if value.truthy(n.v) == sense {
            g.fs.code.set_loc(g.fs.line);
            js.push(g.fs.code.op(Scheme.JMP(0)));
        }
    } else {
        let r = g.any(n);
        js.push(g.emit(if sense { Scheme.TESTT(r as u8, 0) } else { Scheme.TEST(r as u8, 0) }));
    }
    g.reset(save);
    g.fs.line = saved_line;
}

/// Is the value of `n` always #t or #f?
fn is_boolean(n: *Node) -> bool {
    match n.kind {
        Const => n.v == value.t() or n.v == value.f(),
        Prim => match n.po {
            NumEq | Lt | Gt | Le | Ge | Eq | Eqv | ZeroP | Not | NullP | PairP | SymP | NumP | FixP | StrP | VecP | RecP | OddP | EvenP | PosP | NegP => true,
            _ => false,
        },
        And | Or => {
            for i in 0..n.list.len {
                if !is_boolean(n.list.at(i)) { return false; }
            }
            true
        }
        _ => false,
    }
}

/// A call. `dst` is where the result goes (non-tail), or the first free
/// register (tail).
fn Gen.call(g: *Gen, n: *Node, dst: u32, tail: bool) {
    let nargs = n.list.len;
    if nargs > 200 { fail(g.fs.line, "too many arguments"); }
    // A tail call of the procedure's own letrec variable: a loop.
    let f = n.a;
    // ... or of the known top-level procedure being compiled (its closure
    // is running, so the global is bound to it).
    let self_global = f.kind == K.GRef and (n.lam as u64) == (g.fs.lam as u64);
    if tail and (self_global or (f.kind == K.Ref and (f.vr.lam as u64) == (g.fs.lam as u64) and !f.vr.assigned)) {
        let l = g.fs.lam;
        if !l.rest and l.nparams as u64 == nargs {
            g.move_args(n, l);
            g.fs.code.set_loc(g.fs.line);
            g.fs.code.jump_to(Scheme.JMP(0), 0);
            return;
        }
    }
    let base = if !tail and dst + 1 == g.top() { dst } else { g.alloc() };
    // A recursive call of the procedure being compiled (through its known
    // global or its own letrec variable) with the right arity.
    let l = g.fs.lam;
    if !tail and !l.rest and l.nparams as u64 == nargs
        and (self_global or (f.kind == K.Ref and (f.vr.lam as u64) == (l as u64) and !f.vr.assigned)) {
        for i in 0..nargs {
            let r = g.alloc();
            g.to(n.list.at(i), r);
        }
        g.emit(Scheme.CALLSELF(base as u8, nargs as u8));
        if base != dst { g.emit(Scheme.MOVE(dst as u8, base as u8)); }
        return;
    }
    if f.kind == K.Const and value.prim_of(f.v) == Some(Prim.CallCc as i32) and nargs == 1 {
        let r = g.alloc();
        g.to(n.list.at(0), r);
        g.emit(Scheme.CALLCC(base as u8, if tail { 1 } else { 0 }));
        // (A tail CALLCC never continues here; the RET is for the verifier.)
        if tail { g.emit(Scheme.RET(base as u8)); } else if base != dst { g.emit(Scheme.MOVE(dst as u8, base as u8)); }
        return;
    }
    if f.kind == K.Const and let Some(id) = value.prim_of(f.v)
        and id != Prim.Apply as i32 and id != Prim.CallCc as i32 {
        for i in 0..nargs {
            let r = g.alloc();
            g.to(n.list.at(i), r);
        }
        g.emit(Scheme.PRIMCALL(base as u8, nargs as u8, id as u8));
        if tail {
            g.emit(Scheme.RET(base as u8));
        } else if base != dst {
            g.emit(Scheme.MOVE(dst as u8, base as u8));
        }
        return;
    }
    // A known top-level procedure that is certainly defined here: its
    // closure is a constant and the arity is checked now (a rest list is
    // made here).
    if f.kind == K.GRef and n.direct and !is_null_lam(n.lam) and n.lam.free.len == 0
        and g.comp.known_proc(f.g as u64) {
        let l = n.lam;
        let np = l.nparams as u64;
        if nargs == np or (l.rest and nargs > np) {
            let kidx = g.constant(V.Clo(g.known_closure(f.g as u64)));
            if kidx < 256 {
                for i in 0..np {
                    let r = g.alloc();
                    g.to(n.list.at(i), r);
                }
                var na = np;
                if l.rest {
                    var lst = g.konst_node(value.nil());
                    var i = nargs;
                    while i > np {
                        i -= 1;
                        let c = g.konst_node(value.nil());
                        c.kind = K.Prim;
                        c.po = PO.Cons;
                        c.list.push(n.list.at(i));
                        c.list.push(lst);
                        lst = c;
                    }
                    let r = g.alloc();
                    g.to(lst, r);
                    na += 1;
                }
                if tail {
                    g.emit(Scheme.TAILCALLK(base as u8, na as u8, kidx as u8));
                } else {
                    g.emit(Scheme.CALLK(base as u8, na as u8, kidx as u8));
                    if base != dst { g.emit(Scheme.MOVE(dst as u8, base as u8)); }
                }
                return;
            }
        }
    }
    g.to(f, base);
    for i in 0..nargs {
        let r = g.alloc();
        if r != base + 1 + i as u32 { fail(g.fs.line, "internal error: misplaced argument"); }
        g.to(n.list.at(i), r);
    }
    if tail {
        g.emit(Scheme.TAILCALL(base as u8, nargs as u8));
    } else {
        g.emit(Scheme.CALL(base as u8, nargs as u8));
        if base != dst { g.emit(Scheme.MOVE(dst as u8, base as u8)); }
    }
}

/// Does `n` read or assign variable `v` (directly or through a closure)?
fn mentions(n: *Node, v: *Var) -> bool {
    if is_null(n) { return false; }
    if (n.kind == K.Ref or n.kind == K.Set) and (n.vr as u64) == (v as u64) { return true; }
    if n.kind == K.Lambda {
        let l = n.lam;
        for i in 0..l.free.len {
            if (l.free.at(i) as u64) == (v as u64) { return true; }
        }
        return false;
    }
    if mentions(n.a, v) or mentions(n.b, v) or mentions(n.c, v) { return true; }
    for i in 0..n.list.len {
        if mentions(n.list.at(i), v) { return true; }
    }
    false
}

fn small_const(n: *Node) -> ?i32 {
    if n.kind == K.Const and let Int(i) = n.v and i >= -128 and i <= 127 { return Some(i); }
    None
}

fn Gen.prim(g: *Gen, n: *Node, dst: u32) {
    let d = dst as u8;
    let po = n.po;
    var args = n.list;
    if po == PO.Vector or po == PO.Record {
        let base = g.top();
        for i in 0..args.len {
            let r = g.alloc();
            g.to(args.at(i), r);
        }
        if po == PO.Vector {
            g.emit(Scheme.VECTOR(d, base as u8, args.len as u8));
        } else {
            g.emit(Scheme.RECORD(d, base as u8, (args.len - 1) as u8));
        }
        return;
    }
    if po == PO.RRef or po == PO.RSet or po == PO.RecP {
        let k = g.constant(n.v);
        if k < 256 {
            let x = g.any(args.at(0)) as u8;
            if po == PO.RRef {
                g.emit(Scheme.RREF(d, x, k as u8));
            } else if po == PO.RecP {
                g.emit(Scheme.RECP(d, x, k as u8));
            } else {
                let v = g.any(args.at(1)) as u8;
                g.emit(Scheme.RSET(x, k as u8, v));
                g.load_const(value.unspec(), dst);
            }
            return;
        }
        // Too many constants for the operand: the native, with the
        // constant split back into its arguments.
        var ns: mem.Vec<*Node> = mem.Vec.new();
        let id = if po == PO.RRef { Prim.RecordRef as i32 } else if po == PO.RecP { Prim.RecordP as i32 } else { Prim.RecordSet as i32 };
        if po == PO.RecP {
            ns.push(g.konst_node(n.v));
            ns.push(args.at(0));
        } else {
            let P(d) = n.v else { fail(g.fs.line, "internal error: record field") };
            ns.push(g.konst_node(d.car));
            ns.push(args.at(0));
            ns.push(g.konst_node(d.cdr));
            if po == PO.RSet { ns.push(args.at(1)); }
        }
        g.prim_call(id, ns, dst);
        ns.free();
        return;
    }
    if po == PO.Append or po == PO.SRef {
        let base = g.top();
        for i: u64 in 0..2 {
            let r = g.alloc();
            g.to(args.at(i), r);
        }
        g.emit(if po == PO.Append { Scheme.APPEND2(d, base as u8) } else { Scheme.SREF(d, base as u8) });
        return;
    }
    if po == PO.Memq or po == PO.Assq {
        let a = g.any(args.at(0)) as u8;
        let b = g.any(args.at(1)) as u8;
        g.emit(if po == PO.Memq { Scheme.MEMQ(d, a, b) } else { Scheme.ASSQ(d, a, b) });
        return;
    }
    // x + c, c + x, x - c with a small constant c.
    if po == PO.Add or po == PO.Sub {
        if let Some(k) = small_const(args.at(1)) {
            let a = g.any(args.at(0));
            let kk = if po == PO.Sub { 0 - k } else { k };
            if kk >= -128 and kk <= 127 {
                g.emit(Scheme.ADDI(d, a as u8, kk as i8));
                return;
            }
        }
        if po == PO.Add and let Some(k) = small_const(args.at(0)) {
            let a = g.any(args.at(1));
            g.emit(Scheme.ADDI(d, a as u8, k as i8));
            return;
        }
    }
    // Comparisons with a small constant (on either side).
    if po == PO.NumEq or po == PO.Lt or po == PO.Gt or po == PO.Le or po == PO.Ge {
        var x = args.at(0);
        var k = small_const(args.at(1));
        var p = po;
        if k.is_none() and let Some(k0) = small_const(args.at(0)) {
            k = Some(k0);
            x = args.at(1);
            p = match po { Lt => PO.Gt, Gt => PO.Lt, Le => PO.Ge, Ge => PO.Le, _ => po };
        }
        if let Some(kk) = k {
            let a = g.any(x) as u8;
            let c = kk as i8;
            let w = match p {
                NumEq => Scheme.NUMEQI(d, a, c),
                Lt => Scheme.LTI(d, a, c),
                Gt => Scheme.GTI(d, a, c),
                Le => Scheme.LEI(d, a, c),
                _ => Scheme.GEI(d, a, c),
            };
            g.emit(w);
            return;
        }
    }
    if args.len == 1 {
        let a = g.any(args.at(0)) as u8;
        let w = match po {
            ZeroP => Scheme.ZEROP(d, a),
            Not => Scheme.NOT(d, a),
            NullP => Scheme.NULLP(d, a),
            PairP => Scheme.PAIRP(d, a),
            SymP => Scheme.SYMBOLP(d, a),
            NumP => Scheme.NUMBERP(d, a),
            FixP => Scheme.FIXNUMP(d, a),
            StrP => Scheme.STRINGP(d, a),
            VecP => Scheme.VECTORP(d, a),
            Car => Scheme.CAR(d, a),
            Length => Scheme.LENGTH(d, a),
            OddP => Scheme.ODDP(d, a),
            EvenP => Scheme.EVENP(d, a),
            PosP => Scheme.POSP(d, a),
            NegP => Scheme.NEGP(d, a),
            VLen => Scheme.VLEN(d, a),
            Reverse => Scheme.REVERSE(d, a),
            _ => Scheme.CDR(d, a),
        };
        g.emit(w);
        return;
    }
    if (po == PO.Vref or po == PO.Vset) and let Some(k) = small_const(args.at(1)) and k >= 0 {
        let a = g.any(args.at(0)) as u8;
        if po == PO.Vref {
            g.emit(Scheme.VREFI(d, a, k as u8));
        } else {
            let c = g.any(args.at(2)) as u8;
            g.emit(Scheme.VSETI(a, k as u8, c));
            g.load_const(value.unspec(), dst);
        }
        return;
    }
    let a = g.any(args.at(0)) as u8;
    let b = g.any(args.at(1)) as u8;
    if args.len == 3 {
        let c = g.any(args.at(2)) as u8;
        g.emit(Scheme.VSET(a, b, c));
        g.load_const(value.unspec(), dst);
        return;
    }
    let w = match po {
        Add => Scheme.ADD(d, a, b),
        Sub => Scheme.SUB(d, a, b),
        Mul => Scheme.MUL(d, a, b),
        Div => Scheme.DIV(d, a, b),
        Quo => Scheme.QUO(d, a, b),
        Rem => Scheme.REM(d, a, b),
        Mod => Scheme.MOD(d, a, b),
        NumEq => Scheme.NUMEQ(d, a, b),
        Lt => Scheme.LT(d, a, b),
        Gt => Scheme.GT(d, a, b),
        Le => Scheme.LE(d, a, b),
        Ge => Scheme.GE(d, a, b),
        Eq => Scheme.EQ(d, a, b),
        Eqv => Scheme.EQV(d, a, b),
        Cons => Scheme.CONS(d, a, b),
        Vref => Scheme.VREF(d, a, b),
        SetCar => Scheme.SETCAR(a, b),
        _ => Scheme.SETCDR(a, b),
    };
    g.emit(w);
    if po == PO.SetCar or po == PO.SetCdr { g.load_const(value.unspec(), dst); }
}

/// R[dst] = builtin `id` of `args`, a PRIMCALL.
fn Gen.prim_call(g: *Gen, id: i32, args: mem.Vec<*Node>, dst: u32) {
    let base = g.alloc();
    for i in 0..args.len {
        let r = g.alloc();
        g.to(args.at(i), r);
    }
    g.emit(Scheme.PRIMCALL(base as u8, args.len as u8, id as u8));
    if base != dst { g.emit(Scheme.MOVE(dst as u8, base as u8)); }
}

/// Evaluate a let's inits into fresh registers and bind its variables.
/// A lambda bound to a variable that is never used (all its calls were
/// inlined): no closure is made.
fn dead_lambda(v: *Var, init: *Node) -> bool {
    init.kind == K.Lambda and v.refs == 0 and !boxed(v)
}

fn Gen.bind_let(g: *Gen, n: *Node) {
    let base = g.top();
    for i in 0..n.list.len {
        let r = g.alloc();
        if dead_lambda(n.vars.at(i), n.list.at(i)) { continue; }
        g.to(n.list.at(i), r);
    }
    for i in 0..n.vars.len {
        let v = n.vars.at(i);
        v.reg = base + i as u32;
        if boxed(v) { g.emit(Scheme.MKBOX(v.reg as u8)); }
    }
}

fn is_cont(n: *Node) -> bool { n.kind == K.Lambda and n.lam.cont }

fn has_cont(n: *Node) -> bool {
    for i in 0..n.list.len {
        if is_cont(n.list.at(i)) { return true; }
    }
    false
}

fn Gen.bind_letrec(g: *Gen, n: *Node) {
    for i in 0..n.vars.len {
        let v = n.vars.at(i);
        if is_cont(n.list.at(i)) { continue; }
        v.reg = g.alloc();
        if boxed(v) {
            g.load_const(value.unspec(), v.reg);
            g.emit(Scheme.MKBOX(v.reg as u8));
        }
    }
    for j in 0..n.list.len {
        let v = n.vars.at(j);
        let init = n.list.at(j);
        if is_cont(init) or dead_lambda(v, init) { continue; }
        let save = g.top();
        if boxed(v) {
            let r = g.any(init);
            g.emit(Scheme.BOXSET(v.reg as u8, r as u8));
        } else {
            g.to(init, v.reg);
            // Patch the closures made so far (including this one) that
            // captured v before it had its value.
            for jj in 0..j + 1 {
                let w = n.vars.at(jj);
                let wi = n.list.at(jj);
                if boxed(w) or wi.kind != K.Lambda or wi.lam.cont or dead_lambda(w, wi) { continue; }
                let l = wi.lam;
                for fi in 0..l.free.len {
                    if (l.free.at(fi) as u64) == (v as u64) {
                        g.emit(Scheme.SETFREE(w.reg as u8, fi as u8, v.reg as u8));
                    }
                }
            }
        }
        g.reset(save);
    }
}

/// Compile a lambda into a child prototype of the current function.
fn Gen.lambda(g: *Gen, l: *Lam) -> u32 {
    let parent = g.fs;
    var fs = FS.new(l);
    fs.line = parent.line;
    g.fs = &fs;
    for i in 0..l.params.len {
        let v = l.params.at(i);
        v.reg = g.alloc();
    }
    for i in 0..l.params.len {
        let v = l.params.at(i);
        if boxed(v) { g.emit(Scheme.MKBOX(v.reg as u8)); }
    }
    for i in 0..l.free.len { fs.fcache.push(0); }
    g.tail(l.body);
    let proto = g.finish(&fs);
    g.fs = parent;
    parent.protos.push(proto);
    if parent.protos.len > 65535 { fail(parent.line, "too many procedures"); }
    (parent.protos.len - 1) as u32
}

fn Gen.finish(g: *Gen, fs: *FS) -> Gc<Proto> {
    if let Some(e) = fs.code.check() {
        fail(e.loc, match e.kind { JumpRange => "procedure too long", _ => e.message() });
    }
    let h = g.heap;
    let l = fs.lam;
    let consts = value.new_arr(h, fs.consts.len());
    for i in 0..fs.consts.len() { consts.data[i] = fs.consts.get(i as u32); }
    let lines = new(h, Lines {}, fs.code.len());
    fs.code.locs_into(lines.data);
    // unsafe: zero-filled (null `Gc`s), every element set on the next line.
    let protos = unsafe { new(h, Protos {}, fs.protos.len) };
    for i in 0..fs.protos.len { protos.data[i] = fs.protos.at(i); }
    if l.free.len > 255 { fail(fs.line, "too many free variables"); }
    let desc = new(h, Descs {}, l.free.len);
    for i in 0..l.free.len {
        let v = l.free.at(i);
        let p = l.parent;
        desc.data[i] = if (v.owner as u64) == (p as u64) { 256 | v.reg } else { free_index(p, v) };
    }
    let np = l.nparams;
    let rest: u32 = if l.rest { 1 } else { 0 };
    // The Proto is created with its code, verified against the counts
    // it holds: CALL jumps only to a Proto's verified `code`.
    let init = Proto {
        name: value.new_str(h, l.name),
        nparams: np,
        rest: rest,
        fixed: if l.rest { 0x10000 } else { np },
        nregs: fs.regs.frame_size(1),
        nfree: l.free.len as u32,
        consts: consts,
        lines: lines,
        protos: protos,
        desc: desc,
    };
    let proto = match Scheme.build_verified(h, init, fs.code.words()) {
        Ok(p) => p,
        Err(e) => {
            var b = text.StrBuf.new();
            b.push_str("internal error: generated code fails verification: ");
            e.write(&b);
            fail(0, b.as_str())
        }
    };
    Scheme.accumulate(proto.code.words(), 0);
    Scheme.optimize(proto.code);
    fs.code.free();
    fs.consts.free();
    fs.protos.free();
    proto
}

// ── driver ──────────────────────────────────────────────────────────

fn read_all(c: *Comp, src: str, track: bool, out: *mem.Vec<V>) {
    var r = Reader.new(src, c.heap, &c.ctx.syms, &c.lines, track);
    while let Some(x) = r.read() { out.push(x); }
}

/// Compile the prelude and the program into one top-level procedure.
/// Allocates in the heap but never collects.
pub fn compile(ctx: *Ctx, prelude: str, src: str) -> Gc<Proto> {
    let top: *Lam = mem.alloc(1);
    top.parent = 0 as *Lam;
    top.name = "toplevel";
    top.params = mem.Vec.new();
    top.free = mem.Vec.new();
    var c = Comp {
        ctx: ctx,
        heap: &ctx.heap,
        lines: map.HashMap.new(),
        env: mem.Vec.new(),
        lam: top,
        redefined: map.HashMap.new(),
        line: 0,
        gensyms: 0,
        gdefs: map.HashMap.new(),
        glams: map.HashMap.new(),
        gprocs: map.HashMap.new(),
        gsets: map.HashMap.new(),
        gform: map.HashMap.new(),
        galias: map.HashMap.new(),
        cur_form: 0,
        first_impure: 0,
        cur_proc: NO_PROC,
        reach: map.HashMap.new(),
    };
    var pre: mem.Vec<V> = mem.Vec.new();
    read_all(&c, prelude, false, &pre);
    var prog: mem.Vec<V> = mem.Vec.new();
    read_all(&c, src, true, &prog);
    var fs = FS.new(top);
    var g = Gen { ctx: ctx, heap: &ctx.heap, fs: &fs, comp: &c, kclos: map.HashMap.new(), kpending: 0 };
    var nodes: mem.Vec<*Node> = mem.Vec.new();
    for i in 0..pre.len { c.top(pre.at(i), &nodes); }
    for i in 0..prog.len { c.scan_defs(prog.at(i)); }
    for i in 0..prog.len { c.top(prog.at(i), &nodes); }
    c.first_impure = nodes.len;
    for i in 0..nodes.len {
        let n = nodes.at(i);
        if n.kind == K.GDef { c.gform.insert(n.g as u64, i); }
        if c.first_impure == nodes.len and may_call(n) { c.first_impure = i; }
    }
    // Aliases: (define g h) of a builtin or a known procedure h, where g
    // is defined once and never set!: calls of g are calls of h.
    for i in 0..nodes.len {
        let n = nodes.at(i);
        if n.kind != K.GDef or n.a.kind != K.GRef { continue; }
        let gk = n.g as u64;
        let h = n.a.g as u64;
        if (c.gdefs.get(gk) ?? 0) != 1 or c.gsets.contains(gk) { continue; }
        if value.prim_of(c.ctx.gvals.at(gk)).is_some() { continue; }
        if let Some(id) = c.galias.get(h) {
            c.galias.insert(gk, id);
        } else if let Some(id) = value.prim_of(c.ctx.gvals.at(h))
            and !c.redefined.contains(c.ctx.gsyms.at(h) as u64)
            and id != Prim.Apply as i32 {
            c.galias.insert(gk, id);
        } else if let Some((l, _, _)) = c.known(n.a) {
            c.glams.insert(gk, l);
        }
    }
    c.reachability(&nodes);
    for i in 0..nodes.len {
        c.cur_form = i;
        let n = nodes.at(i);
        c.cur_proc = NO_PROC;
        if n.kind == K.GDef and n.a.kind == K.Lambda and c.known_global(n.g as u64).is_some() { c.cur_proc = n.g as u64; }
        nodes.set(i, c.inl(n, 0));
    }
    c.cur_proc = NO_PROC;
    for i in 0..nodes.len { reown(nodes.at(i), top); }
    for i in 0..nodes.len { contify(nodes.at(i)); }
    for i in 0..nodes.len { reown(nodes.at(i), top); }
    for i in 0..nodes.len { g.effect(nodes.at(i)); }
    if g.kpending != 0 { fail(0, "internal error: a called procedure was never compiled"); }
    g.kclos.free();
    let r = g.alloc();
    g.load_const(value.unspec(), r);
    g.emit(Scheme.RET(r as u8));
    pre.free();
    prog.free();
    nodes.free();
    g.finish(&fs)
}
