// The reader: source text → Scheme data (pairs, symbols, ...), allocated in
// the GC heap. Reading allocates but never collects.
//
// Built on std.lex (a Cursor with line tracking, and whitespace and
// comment skipping configured for `;` and nested `#| |#`) and std.num
// (numerals). Scheme-specific: `#;` datum comments, string escapes
// (`\x41;`, line continuations), `#\` characters, and the rule that an
// atom is a number only if all of it parses as one (`1+` and `...` are
// symbols).
//
// The source line of every list is recorded in a side table keyed by the
// address of its first pair, so the compiler can attach lines to code
// (the heap does not move objects, and nothing is collected until the
// whole program has been compiled).

import std.gc;
import std.io;
import std.os;
import std.mem;
import std.map;
import std.text;
import std.lex;
import std.num;
import value;
import value.{V, Symtab, Pair, Vect};

pub struct Reader {
    cur: lex.Cursor,
    heap: *gc.Heap,
    syms: *Symtab,
    lines: *map.HashMap<u64, u32>,
    /// Record lines (false for the built-in prelude).
    track: bool,
}

/// Scheme's lexical conventions for std.lex.
fn syntax() -> lex.Syntax {
    var sy = lex.none();
    sy.line_comment = ";";
    sy.block_open = "#|";
    sy.block_close = "|#";
    sy.nested_comments = true;
    sy.multiline_strings = true;
    sy
}

pub fn Reader.new(src: str, heap: *gc.Heap, syms: *Symtab, lines: *map.HashMap<u64, u32>, track: bool) -> Reader {
    Reader { cur: lex.Cursor.new(src, 0, syntax()), heap: heap, syms: syms, lines: lines, track: track }
}

pub fn fail(line: u32, msg: str) -> never {
    var b = text.StrBuf.new();
    b.push_str("error: line ");
    b.push_int(line as i64);
    b.push_str(": ");
    b.push_str(msg);
    io.eprintln(b.as_str());
    os.quit(1)
}

fn Reader.peek(r: *Reader, off: u64) -> u8 { r.cur.peek_at(off) }

fn Reader.at_end(r: *Reader) -> bool { r.cur.at_end() }

fn delimiter(c: u8) -> bool {
    c == 0 or lex.is_space(c) or c == '(' or c == ')' or c == '[' or c == ']' or c == '"' or c == ';' or c == '\''
}

fn not_delimiter(c: u8) -> bool { !delimiter(c) }

/// Line of byte offset `pos` (for errors reported after the cursor moved on).
fn Reader.line_at(r: *Reader, pos: u64) -> u32 {
    var line: u32 = 1;
    for i in 0..pos {
        if r.cur.src[i] == '\n' { line += 1; }
    }
    line
}

/// Skip whitespace and comments, including `#;` datum comments.
fn Reader.skip(r: *Reader) {
    loop {
        if let Err(e) = r.cur.skip_trivia() { fail(r.line_at(e.span.lo as u64), e.msg); }
        if r.peek(0) == '#' and r.peek(1) == ';' {
            let line = r.cur.line;
            r.cur.advance(2);
            if r.read().is_none() { fail(line, "datum comment at end of input"); }
            continue;
        }
        return;
    }
}

fn Reader.sym(r: *Reader, s: str) -> V {
    V.Sym(r.syms.intern(r.heap, s))
}

/// (name datum)
fn Reader.wrap(r: *Reader, name: str, line: u32) -> V {
    let Some(d) = r.read() else { fail(line, "unexpected end of input after quote") };
    let h = r.heap;
    let x = value.cons(h, d, value.nil());
    let l = value.cons(h, r.sym(name), x);
    r.note(l, line);
    l
}

fn Reader.note(r: *Reader, v: V, line: u32) {
    if !r.track { return; }
    if let P(p) = v { r.lines.insert(p as u64, line); }
}

/// The next datum, or None at end of input.
pub fn Reader.read(r: *Reader) -> ?V {
    r.skip();
    if r.at_end() { return None; }
    let line = r.cur.line;
    let c = r.peek(0);
    if c == '(' or c == '[' {
        r.cur.bump();
        return Some(r.list(if c == '(' { ')' } else { ']' }, line));
    }
    if c == ')' or c == ']' { fail(line, "unexpected ')'"); }
    if c == '\'' { r.cur.bump(); return Some(r.wrap("quote", line)); }
    if c == '`' { r.cur.bump(); return Some(r.wrap("quasiquote", line)); }
    if c == ',' {
        r.cur.bump();
        if r.cur.eat('@') { return Some(r.wrap("unquote-splicing", line)); }
        return Some(r.wrap("unquote", line));
    }
    if c == '"' { return Some(r.string(line)); }
    if c == '#' {
        let d = r.peek(1);
        if d == '(' {
            r.cur.advance(2);
            let l = r.list(')', line);
            return Some(V.Vec(list_to_vect(r.heap, l)));
        }
        if d == '\\' {
            r.cur.advance(2);
            return Some(r.character(line));
        }
    }
    // An atom: number, boolean or symbol.
    let s = r.cur.eat_while(not_delimiter);
    if s.len == 0 { fail(line, "unexpected character"); }
    if s[0] == '#' {
        if s.eq("#t") or s.eq("#true") { return Some(value.t()); }
        if s.eq("#f") or s.eq("#false") { return Some(value.f()); }
        fail(line, "bad # syntax");
    }
    if let Some(n) = parse_number(s) { return Some(n); }
    if s.eq(".") { fail(line, "unexpected '.'"); }
    Some(r.sym(s))
}

pub fn list_to_vect(h: *gc.Heap, l: V) -> Gc<Vect> {
    var n: u64 = 0;
    var cur = l;
    while let P(p) = cur { n += 1; cur = p.cdr; }
    let v = value.new_vect(h, n, value.unspec());
    cur = l;
    var i: u64 = 0;
    while let P(p) = cur { v.data.ptr[i] = p.car; i += 1; cur = p.cdr; }
    v
}

/// A number literal (all of `s`): an exact integer, which is a flonum if
/// it does not fit in a fixnum, or a decimal flonum. Scheme writes hex as
/// `#x..`, so std.num's `0x` prefix is not accepted.
pub fn parse_number(s: str) -> ?V {
    var i: u64 = 0;
    if s.len > 0 and (s[0] == '+' or s[0] == '-') { i = 1; }
    if i + 1 < s.len and s[i] == '0' and (s[i + 1] == 'x' or s[i + 1] == 'X') { return None; }
    match num.parse_number(s) {
        Ok(Int(x)) => {
            if x >= -2147483648 and x <= 2147483647 { Some(V.Int(x as i32)) } else { Some(V.Num(x as f64)) }
        }
        Ok(Float(f)) => Some(V.Num(f)),
        Err(_) => None,
    }
}

fn Reader.list(r: *Reader, close: u8, line: u32) -> V {
    let h = r.heap;
    var head = value.nil();
    var tail: ?Gc<Pair> = None;
    loop {
        r.skip();
        if r.at_end() { fail(line, "unterminated list"); }
        let c = r.peek(0);
        if c == ')' or c == ']' {
            if c != close { fail(r.cur.line, "mismatched brackets"); }
            r.cur.bump();
            break;
        }
        if c == '.' and delimiter(r.peek(1)) {
            r.cur.bump();
            let Some(t) = tail else { fail(r.cur.line, "unexpected '.'") };
            let Some(d) = r.read() else { fail(line, "unterminated list") };
            t.cdr = d;
            r.skip();
            if r.peek(0) != close { fail(r.cur.line, "expected ')' after dotted tail"); }
            r.cur.bump();
            break;
        }
        let Some(d) = r.read() else { fail(line, "unterminated list") };
        let cell = new(h, Pair { car: d, cdr: value.nil() });
        match tail {
            Some(t) => t.cdr = V.P(cell),
            None => {
                head = V.P(cell);
            }
        }
        tail = Some(cell);
    }
    r.note(head, line);
    head
}

fn hex(c: u8) -> ?u32 {
    let d = num.digit_value(c);
    if d < 16 { Some(d) } else { None }
}

fn Reader.string(r: *Reader, line: u32) -> V {
    r.cur.bump();
    var b = text.StrBuf.new();
    loop {
        if r.at_end() { fail(line, "unterminated string"); }
        let c = r.cur.bump();
        if c == '"' { break; }
        if c != '\\' { b.push(c); continue; }
        let e = r.cur.bump();
        if e == 'n' { b.push('\n'); }
        else if e == 't' { b.push('\t'); }
        else if e == 'r' { b.push('\r'); }
        else if e == 'a' { b.push(7); }
        else if e == '0' { b.push(0); }
        else if e == '\\' { b.push('\\'); }
        else if e == '"' { b.push('"'); }
        else if e == 'x' {
            var v: u32 = 0;
            while let Some(d) = hex(r.peek(0)) { v = v * 16 + d; r.cur.bump(); }
            r.cur.eat(';');
            value.push_utf8(&b, v as i32);
        } else if e == '\n' or lex.is_space(e) {
            // Line continuation: \ <spaces> newline <spaces> produces nothing.
            var nl = e == '\n';
            while lex.is_space(r.peek(0)) {
                if r.peek(0) == '\n' {
                    if nl { break; }
                    nl = true;
                }
                r.cur.bump();
            }
        } else {
            fail(r.cur.line, "unknown string escape");
        }
    }
    let s = value.new_str(r.heap, b.as_str());
    b.free();
    V.S(s)
}

/// After `#\`.
fn Reader.character(r: *Reader, line: u32) -> V {
    let start = r.cur.pos;
    // The first character is always part of the char, even a delimiter.
    r.cur.bump();
    r.cur.eat_while(not_delimiter);
    let s = r.cur.since(start);
    if s.len == 1 { return value.chr(s[0] as i32); }
    if s.eq("space") { return value.chr(32); }
    if s.eq("newline") or s.eq("linefeed") { return value.chr(10); }
    if s.eq("tab") { return value.chr(9); }
    if s.eq("return") { return value.chr(13); }
    if s.eq("null") or s.eq("nul") { return value.chr(0); }
    if s.eq("alarm") { return value.chr(7); }
    if s.eq("backspace") { return value.chr(8); }
    if s.eq("delete") { return value.chr(127); }
    if s.eq("escape") { return value.chr(27); }
    if s[0] == 'x' and s.len > 1 {
        var v: u32 = 0;
        for i in 1..s.len {
            let Some(d) = hex(s[i]) else { fail(line, "bad character literal") };
            v = v * 16 + d;
        }
        return value.chr(v as i32);
    }
    // A multi-byte UTF-8 character.
    if s[0] >= 0x80 {
        var v: u32 = 0;
        let b0 = s[0] as u32;
        if b0 >= 0xF0 { v = b0 & 7; } else if b0 >= 0xE0 { v = b0 & 15; } else { v = b0 & 31; }
        for i in 1..s.len { v = (v << 6) | (s[i] as u32 & 63); }
        return value.chr(v as i32);
    }
    fail(line, "unknown character name")
}
