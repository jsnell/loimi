; Pairs and lists.

(define l (list 1 2 3 4 5))
(write l) (newline)
; expect: (1 2 3 4 5)
(write (cons 1 2)) (newline)
; expect: (1 . 2)
(write '(1 (2 3) . 4)) (newline)
; expect: (1 (2 3) . 4)
(write (list (car l) (cdr l) (cadr l) (cddr l) (caddr l))) (newline)
; expect: (1 (2 3 4 5) 2 (3 4 5) 3)
(write (list (length l) (length '()) (reverse l) (append '(1 2) '(3) '() '(4 5)))) (newline)
; expect: (5 0 (5 4 3 2 1) (1 2 3 4 5))
(write (append)) (write (append '() 5)) (write (append '(1) 2)) (newline)
; expect: ()5(1 . 2)
(write (list (list-tail l 2) (list-ref l 3))) (newline)
; expect: ((3 4 5) 4)
(write (list (memq 'c '(a b c d)) (memq 'x '(a b)) (member '(1) '((0) (1) (2))) (memv 2 '(1 2 3)))) (newline)
; expect: ((c d) #f ((1) (2)) (2 3))
(define al '((a . 1) (b . 2) ("c" . 3)))
(write (list (assq 'b al) (assq 'z al) (assoc "c" al) (assv 'a al))) (newline)
; expect: ((b . 2) #f ("c" . 3) (a . 1))
(define p (cons 1 2))
(set-car! p 10)
(set-cdr! p '(20))
(write p) (newline)
; expect: (10 20)
(write (list (null? '()) (null? l) (pair? l) (pair? '()) (list? l) (list? (cons 1 2)))) (newline)
; expect: (#t #f #t #f #t #f)
(write (map + '(1 2 3) '(10 20 30))) (newline)
; expect: (11 22 33)
(write (map (lambda (x) (* x x)) l)) (newline)
; expect: (1 4 9 16 25)
(for-each (lambda (x y) (display (+ x y)) (display ",")) '(1 2) '(3 4)) (newline)
; expect: 4,6,
(write (apply max '(3 9 2))) (write (apply list 1 2 '(3))) (newline)
; expect: 9(1 2 3)
(write (map car '((a 1) (b 2)))) (newline)
; expect: (a b)
(write (list (equal? '(1 (2 #(3))) (list 1 (list 2 (vector 3)))) (eq? '() '()) (equal? "ab" "ab") (eq? (list 1) (list 1)))) (newline)
; expect: (#t #t #t #f)
(write (last-pair '(1 2 3))) (write (list-copy '(1 2))) (newline)
; expect: (3)(1 2)
(write ''a) (write '`(a ,b ,@c)) (newline)
; expect: 'a`(a ,b ,@c)
; A long list built with a loop, and its length (no deep recursion in builtins).
(define (iota n) (let loop ((i (- n 1)) (acc '())) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define big (iota 5000))
(display (length big)) (display " ") (display (apply + big)) (newline)
; expect: 5000 12497500
(display (length (map (lambda (x) x) big))) (newline)
; expect: 5000
