// Step 6: functions and calls.
//
//   loimi run examples/tutorial/step6/main.lm -- FILE.pip [--disasm | --disasm-after]

import std.io;
import std.os;
import std.diag;
import std.mem;
import std.text;
import parser;
import compile;
import compile.{Program};
import value.{Value, Proto};
import vm.{Pip, Machine, Globals, Frame};

fn error(msg: str, line: u32) {
    var b = text.StrBuf.new();
    b.push_str("error: line ");
    b.push_int(line as i64);
    b.push_str(": ");
    b.push_str(msg);
    io.eprintln(b.as_str());
    b.free();
}

fn disassemble(prog: *Program) {
    var out = text.StrBuf.new();
    for i in 0..prog.protos.len {
        let p = prog.protos.at(i);
        out.push_str("fn ");
        out.push_str(p.name);
        out.push_str(":\n");
        Pip.disasm(p.code, &out);
    }
    io.print(out.as_str());
    out.free();
}

const STACK: u64 = 1 << 20;
const FRAMES: u64 = 1 << 16;

fn main() -> i32 {
    let Some(path) = os.arg(1) else { io.eprintln("usage: step6 <file.pip> [--disasm | --disasm-after]"); return 2; };
    let Some(src) = io.read_file(path) else { io.eprintln("cannot read the file"); return 2; };
    let flag = os.arg(2) ?? "";
    var sm = diag.SourceMap.new();
    let file = sm.add(path, src);
    var arena = mem.Arena.new();
    defer arena.free();

    var stmts = match parser.parse_program(src, file, &arena) {
        Ok(s) => s,
        Err(e) => { var d = e.diag(); sm.eprint(&d); return 1; }
    };
    var names = text.Interner.new();
    var prog = match compile.compile(&stmts, &names) {
        Ok(p) => p,
        Err((msg, line)) => { error(msg, line); return 1; }
    };
    if flag.eq("--disasm") { disassemble(&prog); }

    // Verify every function before running anything.
    for i in 0..prog.protos.len {
        let p = prog.protos.at(i);
        if let Some(bad) = Pip.verify(p.code, p, names.names.len as u32) {
            error("bytecode failed verification", p.lines[bad]);
            return 1;
        }
    }

    var m = Machine {
        stack: mem.alloc(STACK), stack_end: 0 as *Value,
        frames: mem.alloc(FRAMES), frames_end: 0 as *Frame,
        out: text.StrBuf.new(), error_line: 0,
        globals: Globals.new(), names: &names, err: text.StrBuf.new(),
    };
    m.stack_end = m.stack + STACK;
    m.frames_end = m.frames + FRAMES;
    let status: i32 = match Pip.run(&m, prog.main) {
        Ok(_) => 0,
        Err(msg) => { error(msg, m.error_line); 1 }
    };
    if flag.eq("--disasm-after") { disassemble(&prog); }
    status
}
