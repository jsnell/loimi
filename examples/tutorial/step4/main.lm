// Step 4: dynamically typed values, slow paths and run-time errors.
//
//   loimi run examples/tutorial/step4/main.lm -- FILE.pip [--disasm]

import std.io;
import std.os;
import std.diag;
import std.mem;
import std.text;
import parser;
import compile;
import value.{Value};
import vm.{Pip, Limits, Machine};

fn main() -> i32 {
    let Some(path) = os.arg(1) else { io.eprintln("usage: step4 <file.pip> [--disasm]"); return 2; };
    let Some(src) = io.read_file(path) else { io.eprintln("cannot read the file"); return 2; };
    let disasm = os.arg(2).is_some();
    var sm = diag.SourceMap.new();
    let file = sm.add(path, src);
    var arena = mem.Arena.new();
    defer arena.free();

    var stmts = match parser.parse_program(src, file, &arena) {
        Ok(s) => s,
        Err(e) => { var d = e.diag(); sm.eprint(&d); return 1; }
    };
    let chunk = match compile.compile(&stmts) {
        Ok(c) => c,
        Err(msg) => { io.eprint("error: "); io.eprintln(msg); return 1; }
    };

    if disasm {
        var out = text.StrBuf.new();
        Pip.disasm(chunk.code, &out);
        io.print(out.as_str());
        out.free();
    }

    // The verifier proves every operand in range, once, so the handlers
    // can index registers and constants without bounds checks.
    var lim = Limits { nregs: chunk.nregs, nconsts: chunk.consts.len as u32 };
    let code = match Pip.verify(chunk.code, &lim) {
        Ok(v) => v,
        Err(e) => {
            var b = text.StrBuf.new();
            b.push_str("error: the bytecode failed verification: ");
            e.write(&b);
            io.eprintln(b.as_str());
            return 1;
        }
    };

    var m = Machine { code: code.start(), lines: chunk.lines.ptr, out: text.StrBuf.new(), error_line: 0 };
    let regs: *Value = mem.alloc(chunk.nregs as u64);
    match Pip.run(&m, code, regs, chunk.consts.ptr) {
        Ok(_) => 0,
        Err(msg) => {
            var b = text.StrBuf.new();
            b.push_str("error: line ");
            b.push_int(m.error_line as i64);
            b.push_str(": ");
            b.push_str(msg);
            io.eprintln(b.as_str());
            1
        }
    }
}
