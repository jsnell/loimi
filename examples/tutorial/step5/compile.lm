// Compile Pip's syntax tree to bytecode for the Pip vm.
//
// Variables: a `let` at the top level defines a global, which lives in the
// vm's globals table and is reached by name. A `let` inside a block
// defines a local, which lives in a register for as long as the block
// runs; using it costs nothing, since instructions name registers.

import std.bc;
import std.mem;
import std.text;
import parser.{Node, Expr, BinOp, Stmt};
import value.{Value};
import vm.{Pip};

/// A compiled program. `lines` holds the source line of every code word.
pub struct Chunk { code: []u32, lines: []u32, consts: []Value, nregs: u32 }

struct Local { name: str, reg: u32 }

struct C {
    code: bc.Code<u32>,
    consts: bc.Pool<Value>,
    regs: bc.Regs,
    /// Locals in scope, innermost last.
    locals: mem.Vec<Local>,
    /// How deep in blocks we are: 0 is the top level.
    depth: u32,
    names: *text.Interner,
    error: ?str,
}

/// The instruction for `dst = a op b`. There is no GT or GE: `a > b` is
/// `b < a`.
fn binop(op: BinOp, dst: u8, a: u8, b: u8) -> u32 {
    match op {
        Add => Pip.ADD(dst, a, b),
        Sub => Pip.SUB(dst, a, b),
        Mul => Pip.MUL(dst, a, b),
        Div => Pip.DIV(dst, a, b),
        Mod => Pip.MOD(dst, a, b),
        Eq => Pip.EQ(dst, a, b),
        Ne => Pip.NE(dst, a, b),
        Lt => Pip.LT(dst, a, b),
        Le => Pip.LE(dst, a, b),
        Gt => Pip.LT(dst, b, a),
        Ge => Pip.LE(dst, b, a),
    }
}

fn C.constant(c: *C, dst: u8, v: Value) {
    let Some(k) = c.consts.add(v) else { c.error = Some("too many constants"); return; };
    c.code.op(Pip.LOADK(dst, k as u16));
}

/// The register of local `name`, if one is in scope.
fn C.local(c: *C, name: str) -> ?u32 {
    var i = c.locals.len;
    while i > 0 {
        i -= 1;
        let l = c.locals.at(i);
        if l.name.eq(name) { return Some(l.reg); }
    }
    None
}

/// The symbol of a global's name, as an operand.
fn C.symbol(c: *C, name: str) -> u16 {
    let s = c.names.intern(name);
    if s > 65535 { c.error = Some("too many names"); }
    s as u16
}

/// Compile `n` so that its value ends up in register `dst`.
fn C.expr_to(c: *C, n: *Node, dst: u32) {
    let d = dst as u8;
    // Instructions emitted from here on belong to this line.
    c.code.set_loc(n.line);
    match n.expr {
        Int(v) => {
            if v >= -32768 and v <= 32767 {
                c.code.op(Pip.LOADI(d, v as i16));
            } else if v >= -2147483648 and v <= 2147483647 {
                c.constant(d, Value.Int(v as i32));
            } else {
                c.constant(d, Value.Num(v as f64));
            }
        }
        Float(x) => c.constant(d, Value.Num(x)),
        Bool(b) => { c.code.op(Pip.LOADBOOL(d, if b { 1 } else { 0 })); }
        Nil => { c.code.op(Pip.LOADNIL(d)); }
        Name(name) => {
            if let Some(r) = c.local(name) {
                if r != dst { c.code.op(Pip.MOVE(d, r as u8)); }
            } else {
                c.code.op(Pip.GETGLOBAL(d, c.symbol(name)));
            }
        }
        Neg(e) => {
            c.expr_to(e, dst);
            c.code.set_loc(n.line);
            c.code.op(Pip.NEG(d, d));
        }
        Not(e) => {
            c.expr_to(e, dst);
            c.code.set_loc(n.line);
            c.code.op(Pip.NOT(d, d));
        }
        Binary(op, l, r) => {
            let mark = c.regs.mark();
            let a = c.operand(l);
            let b = c.operand(r);
            c.code.set_loc(n.line);
            c.code.op(binop(op, d, a as u8, b as u8));
            c.regs.reset(mark);
        }
    }
}

/// A register holding the value of `n`: a local's own register, or a new
/// temporary.
fn C.operand(c: *C, n: *Node) -> u32 {
    if let Name(name) = n.expr and let Some(r) = c.local(name) { return r; }
    let r = c.regs.alloc(1);
    c.expr_to(n, r);
    r
}

/// Emit code that falls through if `cond` is true and jumps to `l` if
/// it is false. A comparison becomes one compare-and-branch op and its
/// JMP; anything else is evaluated and tested.
fn C.jump_if_false(c: *C, cond: *Node, l: bc.Label) {
    let mark = c.regs.mark();
    if let Binary(op, x, y) = cond.expr {
        let w: ?u32 = match op {
            Lt => Some(Pip.JNLT(c.operand(x) as u8, c.operand(y) as u8)),
            Le => Some(Pip.JNLE(c.operand(x) as u8, c.operand(y) as u8)),
            Gt => { let a = c.operand(x); Some(Pip.JNLT(c.operand(y) as u8, a as u8)) }
            Ge => { let a = c.operand(x); Some(Pip.JNLE(c.operand(y) as u8, a as u8)) }
            Eq => Some(Pip.JNEQ(c.operand(x) as u8, c.operand(y) as u8)),
            Ne => Some(Pip.JEQ(c.operand(x) as u8, c.operand(y) as u8)),
            _ => None,
        };
        if let Some(w) = w {
            c.code.set_loc(cond.line);
            c.code.op(w);
            c.code.jump(Pip.JMP(0), l);
            c.regs.reset(mark);
            return;
        }
    }
    let r = c.operand(cond);
    c.code.set_loc(cond.line);
    c.code.jump(Pip.JF(r as u8, 0), l);
    c.regs.reset(mark);
}

fn C.block(c: *C, stmts: *mem.Vec<Stmt>) {
    let level = c.regs.enter();
    let nlocals = c.locals.len;
    c.depth += 1;
    for i in 0..stmts.len { c.stmt(stmts.at(i)); }
    c.depth -= 1;
    c.locals.truncate(nlocals);
    c.regs.leave(level);
}

fn C.stmt(c: *C, s: Stmt) {
    match s {
        Print(e) => {
            let r = c.operand(e);
            c.code.set_loc(e.line);
            c.code.op(Pip.PRINT(r as u8));
        }
        Let(name, e) => {
            if c.depth == 0 {
                let r = c.operand(e);
                c.code.op(Pip.DEFGLOBAL(r as u8, c.symbol(name)));
            } else {
                // The value goes straight into the local's register, which
                // becomes part of the block's frame.
                let r = c.regs.alloc(1);
                c.expr_to(e, r);
                c.regs.end_stmt();
                c.regs.activate(1);
                c.locals.push(Local { name: name, reg: r });
            }
        }
        Assign(name, e) => {
            if let Some(r) = c.local(name) {
                c.expr_to(e, r);
            } else {
                let r = c.operand(e);
                c.code.op(Pip.SETGLOBAL(r as u8, c.symbol(name)));
            }
        }
        If(cond, then_block, else_block) => {
            let otherwise = c.code.label();
            c.jump_if_false(cond, otherwise);
            c.block(&then_block);
            if else_block.len > 0 {
                let end = c.code.label();
                c.code.jump(Pip.JMP(0), end);
                c.code.bind(otherwise);
                c.block(&else_block);
                c.code.bind(end);
            } else {
                c.code.bind(otherwise);
            }
        }
        While(cond, body) => {
            let top = c.code.here();
            let exit = c.code.label();
            c.jump_if_false(cond, exit);
            c.block(&body);
            c.code.jump(Pip.JMP(0), top);
            c.code.bind(exit);
        }
    }
    c.regs.end_stmt();
}

pub fn compile(stmts: *mem.Vec<Stmt>, names: *text.Interner) -> Result<Chunk, str> {
    var c = C {
        code: bc.Code.new(Pip.op_size, Pip.set_label),
        consts: bc.Pool.new(65536),
        regs: bc.Regs.new(250),
        locals: mem.Vec.new(),
        depth: 0,
        names: names,
        error: None,
    };
    for i in 0..stmts.len { c.stmt(stmts.at(i)); }
    c.code.op(Pip.HALT());
    if c.regs.failed() { return Err("expression too complex: out of registers"); }
    if let Some(e) = c.error { return Err(e); }
    if let Some(e) = c.code.check() { return Err(e.message()); }

    let n = c.code.len();
    let code: *u32 = mem.alloc(n);
    c.code.copy_into(code.slice(n));
    let lines: *u32 = mem.alloc(n);
    c.code.locs_into(lines.slice(n));
    let nk = c.consts.len();
    let consts: *Value = mem.alloc(nk);
    for i in 0..nk { consts[i] = c.consts.get(i as u32); }
    let chunk = Chunk {
        code: code.slice(n), lines: lines.slice(n), consts: consts.slice(nk), nregs: c.regs.frame_size(1),
    };
    c.code.free();
    c.consts.free();
    c.locals.free();
    Ok(chunk)
}
