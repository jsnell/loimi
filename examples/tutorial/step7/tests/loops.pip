// Globals, locals, if and while.
let n = 10;
let total = 0;
let i = 1;
while i <= n {
    total = total + i;
    i = i + 1;
}
print total;

// Collatz steps for 27. `steps` and `x` are locals of the if block.
if true {
    let x = 27;
    let steps = 0;
    while x != 1 {
        if x % 2 == 0 { x = x / 2; } else { x = 3 * x + 1; }
        steps = steps + 1;
    }
    print steps;
}

// FizzBuzz-ish, with else-if chains.
let k = 1;
while k <= 15 {
    if k % 15 == 0 { print 1515; }
    else if k % 5 == 0 { print 55; }
    else if k % 3 == 0 { print 33; }
    else { print k; }
    k = k + 1;
}

// Conditions that are not comparisons.
if nil { print 1; } else { print 2; }
if 0 { print 3; }
if not (1 > 2) { print 4; }
