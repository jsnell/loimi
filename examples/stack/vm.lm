// The Stak virtual machine: a data stack, a locals stack and a frame stack.
//
// State registers: `pc`, `sp` and `tos` (the top value is cached in a
// register, `sp` points at the one below it), `lp` (the current word's local slots) and `fp` (the
// current frame). The compiler checks stack depths statically, so ops pop
// and push without underflow checks; CALL checks for overflow once per
// call, against the callee's maximum depth.

import std.io;
import std.gc;
import std.mem;
import std.text;
import value;
import value.{Value, Word};

extern "C" fn fmod(x: f64, y: f64) -> f64;
extern "C" fn sqrt(x: f64) -> f64;

/// One activation. `ret` is where the caller continues and `lp` the
/// caller's locals, both saved by CALL in the callee's frame.
pub struct Frame { word: *Word, ret: *u32, lp: *Value }

pub struct Machine {
    stack: *Value,
    stack_end: *Value,
    lstack: *Value,
    lstack_end: *Value,
    frames: *Frame,
    frames_end: *Frame,
    /// Every compiled word, by index (CALL's operand).
    words: *mem.Vec<*Word>,
    consts: *Value,
    nconsts: u32,
    globals: *Value,
    nglobals: u32,
    heap: gc.Heap,
    /// The state as of the last sync, for the root scanner.
    sp: *Value,
    tos: Value,
    lp: *Value,
    fp: *Frame,
    out: text.StrBuf,
    tmp: text.StrBuf,
    err: text.StrBuf,
    /// Where the last run-time error happened.
    error_line: u32,
    error_word: str,
}

/// GC roots: the data stack up to `sp`, the locals of every active frame,
/// the globals and the constants.
pub fn scan_roots(h: *gc.Heap, data: *u8) {
    let m = data as *Machine;
    var p = m.stack;
    while p <= m.sp { gc_mark(h, *p); p = p + 1; }
    gc_mark(h, m.tos);
    let ltop = m.lp + m.fp.word.nlocals as u64;
    p = m.lstack;
    while p < ltop { gc_mark(h, *p); p = p + 1; }
    for i in 0..m.nglobals as u64 { gc_mark(h, m.globals[i]); }
    for i in 0..m.nconsts as u64 { gc_mark(h, m.consts[i]); }
}

pub enum Arith { Add, Sub, Mul, Div, Mod }

fn type_error(what: str, v: Value, m: *Machine) -> str {
    m.err.clear();
    m.err.push_str(what);
    m.err.push_str(" on ");
    m.err.push_str(value.type_name(v));
    m.err.as_str()
}

/// Arithmetic outside the fast paths: overflow, mixed operands, division,
/// type errors.
fn arith(m: *Machine, op: Arith, a: Value, b: Value) -> Result<Value, str> {
    if let (Int(x), Int(y)) = (a, b) {
        let (x, y) = (x as i64, y as i64);
        let r = match op {
            Add => x + y,
            Sub => x - y,
            Mul => x * y,
            Div => { if y == 0 { return Err("division by zero"); } x / y }
            Mod => {
                if y == 0 { return Err("division by zero"); }
                let r = x % y;
                if r != 0 and ((r < 0) != (y < 0)) { r + y } else { r }
            }
        };
        if r >= -2147483648 and r <= 2147483647 { return Ok(Value.Int(r as i32)); }
        return Ok(Value.Num(r as f64));
    }
    let Some(x) = value.to_f64(a) else { return Err(type_error("arithmetic", a, m)); };
    let Some(y) = value.to_f64(b) else { return Err(type_error("arithmetic", b, m)); };
    Ok(Value.Num(match op {
        Add => x + y,
        Sub => x - y,
        Mul => x * y,
        Div => x / y,
        Mod => { let r = fmod(x, y); if r != 0.0 and ((r < 0.0) != (y < 0.0)) { r + y } else { r } }
    }))
}

fn less(m: *Machine, a: Value, b: Value, or_equal: bool) -> Result<bool, str> {
    if let (Str(x), Str(y)) = (a, b) {
        let n = if x.data.len < y.data.len { x.data.len } else { y.data.len };
        for i in 0..n {
            if x.data[i] != y.data[i] { return Ok(x.data[i] < y.data[i]); }
        }
        return Ok(if or_equal { x.data.len <= y.data.len } else { x.data.len < y.data.len });
    }
    let Some(x) = value.to_f64(a) else { return Err(type_error("comparison", a, m)); };
    let Some(y) = value.to_f64(b) else { return Err(type_error("comparison", b, m)); };
    Ok(if or_equal { x <= y } else { x < y })
}

fn equal(a: Value, b: Value) -> bool {
    if let (Some(x), Some(y)) = (value.to_f64(a), value.to_f64(b)) { return x == y; }
    if let (Str(x), Str(y)) = (a, b) { return x.data.eq(y.data); }
    a == b
}

/// `a b concat`, or `a tostr` when `two` is false: the text of the top
/// value(s) as a new string. The operands are still on the stack, so they
/// are roots if this collects.
fn stringify(m: *Machine, a: Value, b: Value, two: bool) -> Value uses gc {
    gc.maybe_collect(&m.heap);
    m.tmp.clear();
    value.write(&m.tmp, a);
    if two { value.write(&m.tmp, b); }
    Value.Str(value.new_str(&m.heap, m.tmp.as_str()))
}

#[require_verified]
pub vm Stak {
    context ctx: *Machine;
    // The top of the stack lives in `tos`; `sp` points at the value below
    // it. The stack's bottom slot holds a dummy value, so `tos` is always
    // defined.
    state { pc: *u32, sp: *Value, tos: Value, lp: *Value, fp: *Frame }

    verify_context word: *Word, nglobals: u32, nconsts: u32, nwords: u32;

    operand imm = it;
    operand kst = ctx.consts[it] verify (it as u32) < nconsts display "k{}";
    operand loc = lp[it] verify (it as u32) < word.nlocals display "l{}";
    /// A `do` loop's index slot; the limit is in the slot after it.
    operand dslot = lp[it] verify (it as u32) + 1 < word.nlocals display "l{}";
    operand glob = ctx.globals[it] verify (it as u32) < nglobals display "g{}";
    operand wref = it verify (it as u32) < nwords display "w{}";
    operand cnt = it;
    operand label = pc + it verify is_insn_boundary(pc + it);

    sync { ctx.sp = sp; ctx.tos = tos; ctx.lp = lp; ctx.fp = fp; }

    encoding fixed(u32) {
        format N  { op: 8, x: 24 }
        format S  { op: 8, sx: s24 }
        format LS { op: 8, a: 8, sb: s16 }
    }

    fn push(v: Value) { sp = sp + 1; *sp = tos; tos = v; }
    fn drop1() { tos = *sp; sp = sp - 1; }
    /// Replaces the top two values with `v`.
    fn put2(v: Value) { sp = sp - 1; tos = v; }

    // Literals.
    op PUSHI(v: imm) : S { push(Int(v as i32)); next }
    op PUSHK(c: kst) : N { push(c); next }
    op PUSHNIL() : N { push(Nil); next }
    op PUSHBOOL(b: imm) : N { push(Bool(b != 0)); next }

    // Stack shuffling.
    op DUP() : N { push(tos); next }
    op DROP() : N { drop1(); next }
    op SWAP() : N { let b = tos; tos = *sp; *sp = b; next }
    op OVER() : N { let a = *sp; push(a); next }
    op ROT() : N {
        // a b c -- b c a
        let a = *(sp - 1);
        *(sp - 1) = *sp;
        *sp = tos;
        tos = a;
        next
    }
    op NIP() : N { sp = sp - 1; next }
    op TUCK() : N {
        // a b -- b a b
        let a = *sp;
        *sp = tos;
        push(a);
        tos = *sp;
        *sp = a;
        next
    }
    op DUP2() : N { let a = *sp; let b = tos; push(a); push(b); next }
    op DROP2() : N { tos = *(sp - 1); sp = sp - 2; next }

    // Arithmetic: ( a b -- c ).
    inline for (name, checked, sym, kind) in [
        ("ADD", "add_checked", +, Arith.Add),
        ("SUB", "sub_checked", -, Arith.Sub),
        ("MUL", "mul_checked", *, Arith.Mul),
    ] {
        op #name() : N {
            let b = tos;
            let a = *sp;
            match (a, b) {
                (Int(x), Int(y)) => if let Some(r) = x.#checked(y) { put2(Int(r)); next },
                (Num(x), Num(y)) => { put2(Num(x sym y)); next }
                _ => {}
            }
            cold { let r = arith(ctx, kind, a, b)?; put2(r); next }
        }
    }
    op DIV() : N {
        let b = tos;
        let a = *sp;
        match (a, b) {
            (Int(x), Int(y)) if y > 0 => { put2(Int(x / y)); next }
            (Num(x), Num(y)) => { put2(Num(x / y)); next }
            _ => {}
        }
        cold { let r = arith(ctx, Arith.Div, a, b)?; put2(r); next }
    }
    op MOD() : N {
        let b = tos;
        let a = *sp;
        if let (Int(x), Int(y)) = (a, b) and x >= 0 and y > 0 { put2(Int(x % y)); next }
        cold { let r = arith(ctx, Arith.Mod, a, b)?; put2(r); next }
    }
    op NEG() : N {
        match tos {
            Int(x) => if x != -2147483648 { tos = Int(0 - x); next },
            Num(x) => { tos = Num(-x); next }
            _ => {}
        }
        cold { tos = arith(ctx, Arith.Sub, Value.Int(0), tos)?; next }
    }
    op ABS() : N {
        match tos {
            Int(x) => if x != -2147483648 { if x < 0 { tos = Int(0 - x); } next },
            Num(x) => { if x < 0.0 { tos = Num(-x); } next }
            _ => {}
        }
        cold {
            let v = tos;
            if let Int(_) = v { tos = Num(2147483648.0); next }
            raise type_error("abs", v, ctx)
        }
    }

    // Comparisons: ( a b -- bool ).
    inline for (name, test, slow) in [
        ("LT", x < y, less(ctx, a, b, false)),
        ("LE", x <= y, less(ctx, a, b, true)),
        ("GT", x > y, less(ctx, b, a, false)),
        ("GE", x >= y, less(ctx, b, a, true)),
    ] {
        op #name() : N {
            let b = tos;
            let a = *sp;
            match (a, b) {
                (Int(x), Int(y)) => { put2(Bool(test)); next }
                (Num(x), Num(y)) => { put2(Bool(test)); next }
                _ => {}
            }
            cold { let r = slow?; put2(Bool(r)); next }
        }
    }
    op EQ() : N {
        let b = tos;
        let a = *sp;
        if let (Int(x), Int(y)) = (a, b) { put2(Bool(x == y)); next }
        put2(Bool(equal(a, b)));
        next
    }
    op NE() : N {
        let b = tos;
        let a = *sp;
        if let (Int(x), Int(y)) = (a, b) { put2(Bool(x != y)); next }
        put2(Bool(!equal(a, b)));
        next
    }
    op NOT() : N { tos = Bool(!value.truthy(tos)); next }
    op AND() : N { put2(Bool(value.truthy(*sp) and value.truthy(tos))); next }
    op OR() : N { put2(Bool(value.truthy(*sp) or value.truthy(tos))); next }

    // Locals and globals.
    op LGET(l: loc) : N { push(l); next }
    op LSET(l: loc) : N { l = tos; drop1(); next }
    op GGET(g: glob) : N { push(g); next }
    op GSET(g: glob) : N { g = tos; drop1(); next }

    // Branches.
    op JMP(target: label) : S { jump target }
    op JZ(target: label) : S {
        let v = tos;
        drop1();
        if !value.truthy(v) { jump target }
        next
    }

    // Counted loops. DO pops `limit start` into the slot pair and skips
    // the loop if start >= limit; LOOP increments and jumps back while
    // the index is below the limit.
    op DO(s: dslot, target: label) : LS {
        let start = tos;
        let limit = *sp;
        tos = *(sp - 1);
        sp = sp - 2;
        if let (Int(a), Int(b)) = (start, limit) {
            s = start;
            lp[s.raw + 1] = limit;
            if a >= b { jump target }
            next
        }
        cold { raise "do: the bounds must be integers" }
    }
    op LOOP(s: dslot, target: label) : LS {
        if let (Int(i), Int(n)) = (s, lp[s.raw + 1]) {
            let j = i + 1;
            s = Int(j);
            if j < n { jump target }
            next
        }
        cold { raise "loop: corrupted index" }
    }

    // Calls. Arguments stay where they are on the data stack; the callee
    // gets fresh local slots above the caller's.
    op CALL(w: wref) : N {
        let callee = ctx.words.ptr[w];
        let nlp = lp + fp.word.nlocals as u64;
        if sp + callee.maxdepth as u64 >= ctx.stack_end or nlp + callee.nlocals as u64 > ctx.lstack_end
            or fp + 1 == ctx.frames_end {
            cold { raise "stack overflow" }
        }
        // Slots past the caller's may hold dead objects from earlier
        // calls; the root scanner reads them, so clear them.
        for i in 0..callee.nlocals as u64 { nlp[i] = Nil; }
        fp = fp + 1;
        fp.word = callee;
        fp.ret = pc + 1;
        fp.lp = lp;
        lp = nlp;
        jump callee.code
    }
    op RET() : N {
        if fp == ctx.frames { exit Ok(()) }
        lp = fp.lp;
        let r = fp.ret;
        fp = fp - 1;
        jump r
    }
    op HALT() : N { exit Ok(()) }

    // Builtins.
    op PRINT() : N {
        ctx.out.clear();
        value.write(&ctx.out, tos);
        drop1();
        io.println(ctx.out.as_str());
        next
    }
    op DOT() : N {
        ctx.out.clear();
        value.write(&ctx.out, tos);
        ctx.out.push(' ');
        drop1();
        io.print(ctx.out.as_str());
        next
    }
    op CR() : N { io.println(""); next }
    op CONCAT() : N {
        let r = stringify(ctx, *sp, tos, true);
        put2(r);
        next
    }
    op TOSTR() : N {
        if let Str(_) = tos { next }
        tos = stringify(ctx, tos, Nil, false);
        next
    }
    op LEN() : N {
        match tos {
            Str(s) => { tos = Int(s.data.len as i32); next }
            Arr(a) => { tos = Int(a.items.len as i32); next }
            _ => {}
        }
        cold { raise type_error("len", tos, ctx) }
    }
    op ARRAY() : N {
        if let Int(n) = tos and n >= 0 {
            if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } }
            tos = Arr(value.new_arr(&ctx.heap, n as u64));
            next
        }
        cold { raise "array: the size must be a non-negative integer" }
    }
    /// The top `n` values become an array.
    op MKARRAY(n: cnt) : N {
        if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } }
        let a = new(&ctx.heap, value.Arr {}, n);
        if n == 0 { push(Arr(a)); next }
        // The first n-1 values are in memory, the last in `tos`.
        let base = sp + 2 - n;
        for i in 0..n - 1 { a.items[i] = base[i]; }
        a.items[n - 1] = tos;
        sp = base - 1;
        tos = Arr(a);
        next
    }
    op AT() : N {
        if let (Arr(a), Int(i)) = (*sp, tos) {
            let u = i as u64;
            if u < a.items.len { put2(a.items.ptr[u]); next }
            cold { raise "index out of range" }
        }
        cold { raise type_error("@", *sp, ctx) }
    }
    op STORE() : N {
        if let (Arr(a), Int(i)) = (*sp, tos) {
            let u = i as u64;
            if u < a.items.len {
                a.items.ptr[u] = *(sp - 1);
                tos = *(sp - 2);
                sp = sp - 3;
                next
            }
            cold { raise "index out of range" }
        }
        cold { raise type_error("!", *sp, ctx) }
    }
    op SQRT() : N {
        if let Some(x) = value.to_f64(tos) { tos = Num(sqrt(x)); next }
        cold { raise type_error("sqrt", tos, ctx) }
    }
    op TOINT() : N {
        match tos {
            Int(_) => next,
            Num(x) => if x > -2147483649.0 and x < 2147483648.0 { tos = Int(x as i32); next },
            _ => {}
        }
        cold { raise "int: not a number in the int range" }
    }

    // Superinstructions, from `--vm-stats` on the benchmarks.
    super PUSHI_ADD = PUSHI; ADD;
    super PUSHI_SUB = PUSHI; SUB;
    super PUSHI_MOD = PUSHI; MOD;
    super PUSHI_AT = PUSHI; AT;
    super PUSHI_LT_JZ = PUSHI; LT; JZ;
    super PUSHK_MUL = PUSHK; MUL;
    super PUSHK_ADD = PUSHK; ADD;
    super LT_JZ = LT; JZ;
    super LE_JZ = LE; JZ;
    super GT_JZ = GT; JZ;
    super LGET_LGET = LGET; LGET;

    entry run(m: *Machine, main: *Word) -> Result<(), str> uses gc {
        ctx = m;
        fp = m.frames;
        fp.word = main;
        fp.lp = m.lstack;
        lp = m.lstack;
        for i in 0..main.nlocals as u64 { lp[i] = Nil; }
        sp = m.stack - 1;
        tos = Nil;
        m.sp = sp;
        m.tos = tos;
        m.lp = lp;
        m.fp = fp;
        jump main.code
    }

    on raise(msg: str) {
        let w = fp.word;
        let i = ((pc as u64) - (w.code.start() as u64)) / 4;
        ctx.error_line = w.lines[i];
        ctx.error_word = w.name;
        fail msg
    }
}
