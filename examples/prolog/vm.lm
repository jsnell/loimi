// The WAM: a register machine over terms in the GC heap.
//
// State: `pc`, the current environment `e`, the structure pointer `s` and the
// read/write mode `wm` of the unify instructions. Argument registers are an
// array inside the machine (`ctx.x`); the continuation, choicepoint and cut
// barrier are machine fields (they change on calls, not on every
// instruction).

import std.gc;
import std.mem;
import term.{Term, Var, Struct, Cons, deref};
import term;
import machine.{Machine, Frame, Choice, unify};
import machine;
import compile.{Pred};
import compile;
import builtins;
import arith;

pub struct VCtx { nperm: u64, nconsts: u64, npreds: u64, natoms: u64 }

pub const EXIT_TRUE: i32 = 0;
pub const EXIT_FALSE: i32 = 1;
pub const EXIT_THROW: i32 = 2;
pub const EXIT_HALT: i32 = 3;

#[require_verified]
pub vm Wam {
    context ctx: *Machine;
    state { pc: *u32, e: *Frame, s: *Term, wm: bool }

    sync { ctx.e = e; }

    verify_context vc: *VCtx;

    operand xr = ctx.x[it] display "x{}";
    operand yr = ((e + 1) as *Term)[it] verify it < vc.nperm display "y{}";
    operand atom = it verify it < vc.natoms;
    operand fun = it verify it < vc.npreds;
    operand pred = it verify it < vc.npreds;
    operand kst = ctx.consts.ptr[it] verify it < vc.nconsts display "k{}";
    operand imm = it;
    operand simm = it;
    operand label = pc + it verify is_insn_boundary(pc + it);

    encoding fixed(u32) {
        format A   { op: 8, a: 24 }
        format sA  { op: 8, sa: s24 }
        format RB  { op: 8, r: 8, b: 16 }
        format RsB { op: 8, r: 8, sb: s16 }
        format RR  { op: 8, r: 8, q: 8 }
        format R3  { op: 8, a: 8, b: 8, c: 8 }
        format R3s { op: 8, a: 8, b: 8, sc: s8 }
    }

    /// The clause a try chain continues at: a resume point (the start of
    /// the clause's verified code), set by `fill_resumes` (compile.chain).
    cache Target { code: Wam.Resume }

    // ---- backtracking -------------------------------------------------

    #[inline(never)]
    fn backtrack() -> never {
        let b = ctx.b;
        ctx.untrail(b.tr);
        e = b.e;
        ctx.cp = b.cp;
        let a = b.args();
        let xs = ctx.xregs();
        for i in 0..b.n { xs[i] = a[i]; }
        ctx.b0 = b.prev;
        jump b.alt
    }

    fn cut_to(c: *Choice) {
        if c < ctx.b { ctx.b = c; }
    }

    // ---- head: get ----------------------------------------------------

    op GET_VAR_X(r: xr, a: xr) : RR { r = a; next }
    op GET_VAR_Y(r: yr, a: xr) : RR { r = a; next }

    // Fast paths make no calls (a call anywhere in a handler gives it a
    // stack frame on every execution, `-W handler_frame`): bindings that
    // need no trail entry store directly (the write barrier makes no
    // call), and allocations use `try_new`, whose refill is a `cold`
    // block ending in `redo`. Everything else is `cold`.

    /// `v` can be bound inline (`bind_now`): its write barrier will not
    /// log it (so LLVM drops the barrier's slow path: the inline
    /// remembered-set push needs registers that GET_VAL_X would spill),
    /// and it needs no trail entry or the trail has room for one.
    fn can_bind(v: Gc<Var>) -> bool {
        !gc.needs_barrier(v as *u8) and (v.stamp >= ctx.b.stamp or ctx.tr < ctx.trail_cap)
    }
    /// Bind `v` (`can_bind` held), trailing it if it is older than the
    /// newest choicepoint.
    fn bind_now(v: Gc<Var>, t: Term) {
        if v.stamp < ctx.b.stamp {
            let tr = ctx.tr;
            ctx.trail[tr] = Term.Ref(v);
            ctx.tr = tr + 1;
        }
        v.val = t;
    }


    // An unbound variable meeting a non-variable binds in place; anything
    // else is the general unification.
    inline for (name, kind) in [("GET_VAL_X", xr), ("GET_VAL_Y", yr)] {
        op #name(r: kind, a: xr) : RR {
            if r == a { next }
            let x = deref(r);
            let y = deref(a);
            if x == y { next }
            if quick_unify(x, y) { next }
            if clash(x, y) { backtrack() }
            cold { if unify(ctx, x, y) { next } backtrack() }
        }
    }
    fn is_var(t: Term) -> bool { match t { Ref(_) => true, _ => false } }
    /// An atom or a small integer: equal only to the same word.
    fn is_small_atomic(t: Term) -> bool { match t { Atom(_) => true, Int(_) => true, _ => false } }
    /// Dereferenced `x` and `y` (not the same word) cannot unify: neither
    /// is a variable and one is an atom or small integer.
    fn clash(x: Term, y: Term) -> bool {
        !is_var(x) and !is_var(y) and (is_small_atomic(x) or is_small_atomic(y))
    }
    /// Unify dereferenced `x` and `y` (not the same word) inline where one
    /// is a variable that `can_bind` (the younger of two variables is
    /// bound to the older); false if that is not the case (nothing done).
    fn quick_unify(x: Term, y: Term) -> bool {
        if let Ref(v) = x {
            if let Ref(w) = y {
                if v.stamp < w.stamp {
                    if can_bind(w) { bind_now(w, x); return true; }
                    return false;
                }
            }
            if can_bind(v) { bind_now(v, y); return true; }
            return false;
        }
        if let Ref(v) = y and can_bind(v) { bind_now(v, x); return true; }
        false
    }

    inline for (name, kind, value, quick_fail) in [
        ("GET_ATOM", atom, Term.Atom(c as u32), true),
        ("GET_CONST", kst, c, false),
    ] {
        op #name(r: xr, c: kind) : RB {
            let t = deref(r);
            if t == value { next }
            if let Ref(v) = t {
                if can_bind(v) { bind_now(v, value); next }
                cold { ctx.bind(v, value); next }
            }
            if quick_fail and clash(t, value) { backtrack() }
            // Big integers are equal by value.
            cold { if unify(ctx, t, value) { next } backtrack() }
        }
    }
    op GET_INT(r: xr, k: simm) : RsB {
        let t = deref(r);
        if t == Term.Int(k as i48) { next }
        if let Ref(v) = t {
            if can_bind(v) { bind_now(v, Term.Int(k as i48)); next }
            cold { ctx.bind(v, Term.Int(k as i48)); next }
        }
        backtrack()
    }
    // GET_NESTED and GET_NESTED_LIST match a compound inside a head
    // structure, in the register its UNIFY_NESTED loaded; in write mode
    // that register holds `Unb` and `ctx.pend` the slot to build it in
    // (no variable is made for the slot, to be bound at once).
    inline for (name, kind, val, pending, slot) in [
        ("GET_STRUCT", xr, r, false, s),
        ("GET_NESTED", imm, ctx.xregs()[r], ctx.xregs()[r] == Term.Unb, ctx.pendp()[r]),
    ] {
    op #name(r: kind, f: fun) : RB {
        if pending {
            let n = ctx.db.farity(f as u32) as u64;
            if n <= 4 {
                let Some(st) = try_struct(f as u32, n) else cold { ctx.make_room_struct(n); redo };
                *slot = Term.Str(st);
                s = st.args.ptr;
                wm = true;
                next
            }
            cold {
                let st = ctx.mk_struct(f as u32, n);
                *slot = Term.Str(st);
                s = st.args.ptr;
                wm = true;
                next
            }
        }
        let t = deref(val);
        if let Str(st) = t {
            if st.f == f as u32 { s = st.args.ptr; wm = false; next }
            backtrack()
        }
        if let Ref(v) = t {
            let n = ctx.db.farity(f as u32) as u64;
            if n <= 4 and can_bind(v) {
                let Some(st) = try_struct(f as u32, n) else cold { ctx.make_room_struct(n); redo };
                bind_now(v, Term.Str(st));
                s = st.args.ptr;
                wm = true;
                next
            }
            cold {
                let st = ctx.mk_struct(f as u32, n);
                ctx.bind(v, Term.Str(st));
                s = st.args.ptr;
                wm = true;
                next
            }
        }
        backtrack()
    }
    }
    /// A structure of arity `n` (1 to 4) without the allocator's refill
    /// (constant lengths: the zeroing is inline, not a memset call).
    fn try_struct(f: u32, n: u64) -> ?Gc<Struct> {
        if n <= 2 {
            if n == 1 { try_new(&ctx.heap, Struct { f: f }, 1) } else { try_new(&ctx.heap, Struct { f: f }, 2) }
        } else {
            if n == 3 { try_new(&ctx.heap, Struct { f: f }, 3) } else { try_new(&ctx.heap, Struct { f: f }, 4) }
        }
    }

    inline for (name, kind, val, pending, slot) in [
        ("GET_LIST", xr, r, false, s),
        ("GET_NESTED_LIST", imm, ctx.xregs()[r], ctx.xregs()[r] == Term.Unb, ctx.pendp()[r]),
    ] {
    op #name(r: kind) : RR {
        if pending {
            let Some(c) = ctx.try_cons() else cold { ctx.make_room(); redo };
            *slot = Term.Lst(c);
            s = c as *Term;
            wm = true;
            next
        }
        let t = deref(val);
        if let Lst(c) = t { s = c as *Term; wm = false; next }
        if let Ref(v) = t {
            if can_bind(v) {
                let Some(c) = ctx.try_cons() else cold { ctx.make_room(); redo };
                bind_now(v, Term.Lst(c));
                s = c as *Term;
                wm = true;
                next
            }
            cold {
                let c = new(&ctx.heap, Cons { head: Term.Unb, tail: Term.Unb });
                ctx.bind(v, Term.Lst(c));
                s = c as *Term;
                wm = true;
                next
            }
        }
        backtrack()
    }
    }

    /// A compound argument of a head structure, matched later by
    /// GET_NESTED/GET_NESTED_LIST `r`: read mode loads it, write mode
    /// leaves `Unb` in `r` and the slot in `ctx.pendp()[r]`.
    op UNIFY_NESTED(r: imm) : RR {
        if wm {
            ctx.pendp()[r] = s;
            ctx.xregs()[r] = Term.Unb;
            s = s + 1;
            next
        }
        ctx.xregs()[r] = *s;
        s = s + 1;
        next
    }

    inline for (name, kind) in [("UNIFY_VAR_X", xr), ("UNIFY_VAR_Y", yr)] {
        op #name(r: kind) : RR {
            if wm {
                let Some(v) = ctx.try_var() else cold { ctx.make_room(); redo };
                *s = v;
                r = v;
                s = s + 1;
                next
            }
            r = *s;
            s = s + 1;
            next
        }
    }
    inline for (name, kind) in [("UNIFY_VAL_X", xr), ("UNIFY_VAL_Y", yr)] {
        op #name(r: kind) : RR {
            if wm { *s = r; s = s + 1; next }
            let t = *s;
            s = s + 1;
            if t == r { next }
            let x = deref(r);
            let y = deref(t);
            if x == y { next }
            if quick_unify(x, y) { next }
            if clash(x, y) { backtrack() }
            cold { if unify(ctx, x, y) { next } backtrack() }
        }
    }
    inline for (name, kind, value) in [
        ("UNIFY_ATOM", atom, Term.Atom(c as u32)),
        ("UNIFY_CONST", kst, c),
    ] {
        op #name(c: kind) : A {
            if wm { *s = value; s = s + 1; next }
            let t = deref(*s);
            s = s + 1;
            if t == value { next }
            if let Ref(v) = t {
                if can_bind(v) { bind_now(v, value); next }
                cold { ctx.bind(v, value); next }
            }
            if clash(t, value) { backtrack() }
            cold { if unify(ctx, t, value) { next } backtrack() }
        }
    }
    op UNIFY_INT(k: simm) : sA {
        if wm { *s = Term.Int(k as i48); s = s + 1; next }
        let t = deref(*s);
        s = s + 1;
        if t == Term.Int(k as i48) { next }
        if let Ref(v) = t {
            if can_bind(v) { bind_now(v, Term.Int(k as i48)); next }
            cold { ctx.bind(v, Term.Int(k as i48)); next }
        }
        backtrack()
    }
    op UNIFY_VOID(n: imm) : A {
        if wm {
            if n == 1 {
                let Some(v) = ctx.try_var() else cold { ctx.make_room(); redo };
                *s = v;
                s = s + 1;
                next
            }
            cold {
                for i in 0..n { *s = ctx.new_var(); s = s + 1; }
                next
            }
        }
        s = s + n;
        next
    }

    // ---- body: put and set ---------------------------------------------

    inline for (name, kind) in [("PUT_VAR_X", xr), ("PUT_VAR_Y", yr)] {
        op #name(r: kind, a: xr) : RR {
            let Some(v) = ctx.try_var() else cold { ctx.make_room(); redo };
            r = v;
            a = v;
            next
        }
    }
    op PUT_VAL_X(r: xr, a: xr) : RR { a = r; next }
    op PUT_VAL_Y(r: yr, a: xr) : RR { a = r; next }
    op PUT_ATOM(r: xr, c: atom) : RB { r = Term.Atom(c as u32); next }
    op PUT_INT(r: xr, v: simm) : RsB { r = Term.Int(v as i48); next }
    op PUT_CONST(r: xr, k: kst) : RB { r = k; next }
    op PUT_STRUCT(r: xr, f: fun) : RB {
        let n = ctx.db.farity(f as u32) as u64;
        if n <= 4 {
            let Some(st) = try_struct(f as u32, n) else cold { ctx.make_room_struct(n); redo };
            r = Term.Str(st);
            s = st.args.ptr;
            next
        }
        cold {
            let n = ctx.db.farity(f as u32) as u64;
            let st = ctx.mk_struct(f as u32, n);
            r = Term.Str(st);
            s = st.args.ptr;
            next
        }
    }
    op PUT_LIST(r: xr) : RR {
        let Some(c) = ctx.try_cons() else cold { ctx.make_room(); redo };
        r = Term.Lst(c);
        s = c as *Term;
        next
    }
    inline for (name, kind) in [("SET_VAR_X", xr), ("SET_VAR_Y", yr)] {
        op #name(r: kind) : RR {
            let Some(v) = ctx.try_var() else cold { ctx.make_room(); redo };
            *s = v;
            r = v;
            s = s + 1;
            next
        }
    }
    op SET_VAL_X(r: xr) : RR { *s = r; s = s + 1; next }
    op SET_VAL_Y(r: yr) : RR { *s = r; s = s + 1; next }
    op SET_ATOM(c: atom) : A { *s = Term.Atom(c as u32); s = s + 1; next }
    op SET_INT(v: simm) : sA { *s = Term.Int(v as i48); s = s + 1; next }
    op SET_CONST(k: kst) : A { *s = k; s = s + 1; next }
    op SET_VOID(n: imm) : A {
        if n == 1 {
            let Some(v) = ctx.try_var() else cold { ctx.make_room(); redo };
            *s = v;
            s = s + 1;
            next
        }
        cold {
            for i in 0..n { *s = ctx.new_var(); s = s + 1; }
            next
        }
    }

    // ---- control --------------------------------------------------------

    op ALLOCATE(n: imm) : A {
        var top = e.end();
        let bt = ctx.b.etop;
        if bt > top { top = bt; }
        let end = top + 3 + n;
        if end >= ctx.eend { cold { raise builtins.resource_error(ctx, "stack") } }
        if end > ctx.ehw { ctx.ehw = end; }
        let ne = top as *Frame;
        ne.ce = e;
        ne.cp = ctx.cp;
        ne.n = n;
        e = ne;
        next
    }
    op DEALLOCATE() : A {
        ctx.cp = e.cp;
        e = e.ce;
        next
    }
    /// Enter predicate `pr`: through its first-argument index (the INDEX
    /// op's work, without dispatching to it), or its code.
    fn enter(pr: *Pred) -> never {
        if pr.indexed {
            let t = deref(ctx.x[0]);
            match t {
                Ref(_) => jump pr.var_code,
                Lst(_) => jump pr.lst_code,
                _ => jump pr.lookup(compile.key_of(t)),
            }
        }
        jump pr.code
    }
    op CALL(p: pred) : A {
        if unlikely(ctx.heap.allocated > ctx.heap.threshold) {
            cold { gc.collect(&ctx.heap); ctx.cp = next_pc; ctx.b0 = ctx.b; jump ctx.preds.ptr[p].code }
        }
        ctx.cp = next_pc;
        ctx.b0 = ctx.b;
        enter(ctx.preds.ptr[p])
    }
    op EXECUTE(p: pred) : A {
        if unlikely(ctx.heap.allocated > ctx.heap.threshold) {
            cold { gc.collect(&ctx.heap); ctx.b0 = ctx.b; jump ctx.preds.ptr[p].code }
        }
        ctx.b0 = ctx.b;
        enter(ctx.preds.ptr[p])
    }
    op PROCEED() : A { jump ctx.cp }
    op FAIL() : A { backtrack() }

    // ---- inline arithmetic (is/2 and comparisons on registers) ----------

    inline for (name, iname, checked, sym, kind) in [
        ("ADD", "ADDI", "add_checked", +, 0),
        ("SUB", "SUBI", "sub_checked", -, 1),
        ("MUL", "MULI", "mul_checked", *, 2),
    ] {
        op #name(d: xr, a0: xr, b0: xr) : R3 {
            let a = deref(a0);
            let b = deref(b0);
            match (a, b) {
                (Int(x), Int(y)) => if let Some(r) = x.#checked(y) { d = Term.Int(r); next },
                (Flt(x), Flt(y)) => { d = Term.Flt(x sym y); next }
                _ => {}
            }
            cold { d = arith.arith2(ctx, kind, a, b)?; next }
        }
        op #iname(d: xr, a0: xr, k: simm) : R3s {
            let a = deref(a0);
            if let Int(x) = a and let Some(r) = x.#checked(k as i48) { d = Term.Int(r); next }
            cold { d = arith.arith2(ctx, kind, a, Term.Int(k as i48))?; next }
        }
    }
    // Integer fast paths; everything else (floats, bound variables,
    // errors) is the generic evaluator's.
    inline for (name, kind, guard, result) in [
        ("IDIV", 3, y != 0 and !(y == -1), ((x as i64) / (y as i64)) as i48),
        ("MOD", 4, y > 0, ((x % y) + y) % y),
        ("SHR", 5, y >= 0 and y < 48, x >> y),
        ("AND", 7, true, x & y),
        ("OR", 8, true, x | y),
        ("REM", 10, y != 0 and !(y == -1), ((x as i64) % (y as i64)) as i48),
        ("XOR", 11, true, x ^ y),
        ("MIN", 12, true, if x <= y { x } else { y }),
        ("MAX", 13, true, if x >= y { x } else { y }),
    ] {
        op #name(d: xr, a0: xr, b0: xr) : R3 {
            let a = deref(a0);
            let b = deref(b0);
            if let (Int(x), Int(y)) = (a, b) and guard { d = Term.Int(result); next }
            cold { d = arith.arith2(ctx, kind, a, b)?; next }
        }
    }
    inline for (name, kind) in [("SHL", 6), ("DIV", 9), ("FDIV", 14)] {
        op #name(d: xr, a: xr, b: xr) : R3 {
            cold { d = arith.arith2(ctx, kind, a, b)?; next }
        }
    }
    op NEG(d: xr, a0: xr) : R3 {
        let a = deref(a0);
        if let Int(x) = a and let Some(r) = (0 as i48).sub_checked(x) { d = Term.Int(r); next }
        cold { d = arith.arith2(ctx, 1, Term.Int(0), a)?; next }
    }
    inline for (name, test) in [("LT", c < 0), ("LE", c <= 0), ("GT", c > 0), ("GE", c >= 0), ("NEQ", c == 0), ("NNE", c != 0)] {
        op #name(a0: xr, b0: xr) : R3 {
            let a = deref(a0);
            let b = deref(b0);
            if let (Int(x), Int(y)) = (a, b) {
                let c: i32 = if x < y { -1 } else if x > y { 1 } else { 0 };
                if test { next }
                backtrack()
            }
            cold {
                let c = arith.cmp2(ctx, a, b)?;
                if test { next }
                backtrack()
            }
        }
    }

    /// A deterministic builtin on the argument registers.
    op CALLB(id: imm) : A {
        match builtins.call(ctx, id) {
            Ok(true) => next,
            Ok(false) => backtrack(),
            Err(ball) => raise ball,
        }
    }

    op NECK_CUT() : A { cut_to(ctx.b0); next }
    op GET_LEVEL(r: yr) : RR {
        r = Term.Int((((ctx.b0 as u64) - (ctx.cbase as u64)) / 8) as i48);
        next
    }
    op CUT_Y(r: yr) : RR {
        if let Int(off) = r { cut_to((((ctx.cbase as *u64) + off as u64)) as *Choice); }
        next
    }
    /// '$cut'(L) with L in a temporary: the cut of an auxiliary clause.
    op CUT_X(r: xr) : RR {
        if let Int(off) = deref(r) { cut_to((((ctx.cbase as *u64) + off as u64)) as *Choice); }
        next
    }

    // ---- inline type tests and arg/3 -------------------------------------

    inline for (name, test) in [
        ("T_VAR", is_var(t)),
        ("T_NONVAR", !is_var(t)),
        ("T_ATOM", is_atom(t)),
        ("T_ATOMIC", term.is_atomic(t)),
        ("T_INTEGER", is_int(t)),
        ("T_NUMBER", is_num(t)),
        ("T_COMPOUND", is_compound(t)),
        ("T_CALLABLE", term.is_callable(t)),
    ] {
        op #name(a: xr) : RR {
            let t = deref(a);
            if test { next }
            backtrack()
        }
    }
    fn is_atom(t: Term) -> bool { match t { Atom(_) => true, _ => false } }
    fn is_int(t: Term) -> bool { match t { Int(_) => true, Big(_) => true, _ => false } }
    fn is_num(t: Term) -> bool { match t { Int(_) => true, Flt(_) => true, Big(_) => true, _ => false } }
    fn is_compound(t: Term) -> bool { match t { Str(_) => true, Lst(_) => true, _ => false } }

    /// arg(N, T, A) with its arguments in registers.
    op ARG(n: xr, t: xr, a: xr) : R3 {
        let nn = deref(n);
        let tt = deref(t);
        if let (Int(i), Str(st)) = (nn, tt) and (i as i64) >= 1 and (i as u64) <= st.args.len {
            let v = st.args.ptr[(i as u64) - 1];    // in bounds: checked above
            let x = deref(a);
            if let Ref(xv) = x and can_bind(xv) { bind_now(xv, v); next }
            cold { if unify(ctx, x, v) { next } backtrack() }
        }
        cold {
            match builtins.arg3(ctx, nn, tt, a) {
                Ok(true) => next,
                Ok(false) => backtrack(),
                Err(ball) => raise ball,
            }
        }
    }

    // ---- clause selection ----------------------------------------------

    fn push_choice(n: u64, alt: *u32) {
        let b = ctx.b;
        let c = b.end();
        c.prev = b;
        c.alt = alt;
        c.e = e;
        c.cp = ctx.cp;
        c.tr = ctx.tr;
        var top = e.end();
        if b.etop > top { top = b.etop; }
        c.etop = top;
        ctx.cstamp += 1;
        c.stamp = ctx.cstamp;
        c.n = n;
        c.kind = machine.CP_PLAIN;
        let a = c.args();
        let xs = ctx.xregs();
        for i in 0..n { a[i] = xs[i]; }
        ctx.b = c;
    }

    op TRY(n: imm) : A + Target {
        if unlikely((ctx.b.end() as *u64) + 9 + n >= ctx.cend) { cold { raise builtins.resource_error(ctx, "choicepoints") } }
        push_choice(n, next_pc);
        jump cache.code
    }
    op RETRY() : A + Target {
        ctx.b.alt = next_pc;
        jump cache.code
    }
    op TRUST() : A + Target {
        ctx.b = ctx.b.prev;
        jump cache.code
    }

    // Guard chains (compile.guard_chain): a first clause whose head binds
    // nothing and whose arithmetic guards come before its neck cut runs
    // its guards without a choicepoint; a failed guard jumps to the
    // other clauses' code, a passed one into the clause after the guards.
    inline for (name, test) in [("JLT", c < 0), ("JLE", c <= 0), ("JGT", c > 0), ("JGE", c >= 0), ("JNEQ", c == 0), ("JNNE", c != 0)] {
        op #name(a0: xr, b0: xr) : R3 + Target {
            let a = deref(a0);
            let b = deref(b0);
            if let (Int(x), Int(y)) = (a, b) {
                let c: i32 = if x < y { -1 } else if x > y { 1 } else { 0 };
                if test { next }
                jump cache.code
            }
            cold {
                let c = arith.cmp2(ctx, a, b)?;
                if test { next }
                jump cache.code
            }
        }
    }
    op JUMP() : A + Target { jump cache.code }

    /// First-argument indexing: pick the clauses that can match A1.
    op INDEX(p: pred) : A {
        let pr = ctx.preds.ptr[p];
        let t = deref(ctx.x[0]);
        match t {
            Ref(_) => jump pr.var_code,
            Lst(_) => jump pr.lst_code,
            _ => jump pr.lookup(compile.key_of(t)),
        }
    }

    /// A predicate whose clauses changed since its index was built.
    op REINDEX(p: pred) : A {
        let pr = ctx.preds.ptr[p];
        compile.reindex(ctx, pr);
        jump pr.code
    }

    op UNDEF(p: pred) : A {
        cold { raise builtins.existence_error(ctx, p as u32) }
    }

    /// call/N: the goal in A1, N-1 extra arguments after it.
    op METACALL(n: imm) : A {
        if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } }
        match compile.prepare_call(ctx, n) {
            Ok(code) => jump code,
            Err(ball) => raise ball,
        }
    }

    op HALT_TRUE() : A { ctx.e = e; exit EXIT_TRUE }
    op HALT_FALSE() : A { ctx.e = e; exit EXIT_FALSE }
    op HALT() : A { ctx.e = e; exit EXIT_HALT }

    // Superinstructions, from --vm-stats on the benchmarks.
    super GL_UVX2 = GET_LIST; UNIFY_VAR_X; UNIFY_VAR_X;
    super GL_UVALX = GET_LIST; UNIFY_VAL_X;
    super PVY2 = PUT_VAL_Y; PUT_VAL_Y;
    super PVX2 = PUT_VAL_X; PUT_VAL_X;
    super DEALLOC_EXEC = DEALLOCATE; EXECUTE;
    super GVY2 = GET_VAR_Y; GET_VAR_Y;
    super GVX2 = GET_VAR_X; GET_VAR_X;
    super PVARY_CALL = PUT_VAR_Y; CALL;
    super ALLOC_LEVEL = ALLOCATE; GET_LEVEL;
    super GL_UATOM = GET_LIST; UNIFY_ATOM;
    super GVALX_PROCEED = GET_VAL_X; PROCEED;
    super GINT_PROCEED = GET_INT; PROCEED;

    entry run(m: *Machine, code: Verified<Wam>) -> i32 uses gc {
        ctx = m;
        e = m.e;
        s = m.ebase;
        wm = false;
        jump code
    }

    /// throw/1, and errors from builtins: unwind to the newest active
    /// catch/3 and backtrack into it, where its recovery clause takes the
    /// ball (builtins.lm, '$catch_ball').
    on raise(ball: Term) {
        let copy = machine.copy_term(ctx, ball);
        var c = ctx.b;
        loop {
            if c.kind == machine.CP_CATCH { break; }
            if c.prev == c {
                ctx.ball = copy;
                ctx.e = e;
                exit EXIT_THROW
            }
            c = c.prev;
        }
        ctx.b = c;
        ctx.ball = copy;
        backtrack()
    }
}
