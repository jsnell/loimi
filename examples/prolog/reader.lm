// The reader: Prolog tokens, and the hooks of std.parse.Ops (the operator
// precedence parser) over the operator table that op/3 changes and the
// writer consults.

import std.text;
import std.num;
import std.mem;
import std.parse;
import std.parse.{OpType, Tok};
import term.{Term, Var, Struct, Cons, deref};
import term;
import machine.{Machine};
import std.bigint;
import std.bigint.{Arg};
import arith;

/// op/3 for one atom: priority 0 removes the definition.
pub fn add_op(m: *Machine, prec: u32, typ: OpType, a: u32) { m.ops.add(a as u64, prec, typ); }

pub fn init_ops(m: *Machine) {
    let table = [
        (1200, "xfx", ":-"), (1200, "xfx", "-->"), (1200, "fx", ":-"), (1200, "fx", "?-"),
        (1100, "xfy", ";"), (1100, "xfy", "|"), (1105, "xfy", "|"), (1050, "xfy", "->"), (1050, "xfy", "*->"),
        (1000, "xfy", ","), (990, "xfx", ":="), (900, "fy", "\\+"),
        (700, "xfx", "="), (700, "xfx", "\\="), (700, "xfx", "=="), (700, "xfx", "\\=="),
        (700, "xfx", "@<"), (700, "xfx", "@>"), (700, "xfx", "@=<"), (700, "xfx", "@>="),
        (700, "xfx", "=.."), (700, "xfx", "is"), (700, "xfx", "=:="), (700, "xfx", "=\\="),
        (700, "xfx", "<"), (700, "xfx", ">"), (700, "xfx", "=<"), (700, "xfx", ">="),
        (700, "xfx", ">:<"), (700, "xfx", ":<"), (700, "xfx", "as"),
        (600, "xfy", ":"), (500, "yfx", "+"), (500, "yfx", "-"), (500, "yfx", "/\\"),
        (500, "yfx", "\\/"), (500, "yfx", "xor"), (500, "fx", "?"),
        (400, "yfx", "*"), (400, "yfx", "/"), (400, "yfx", "//"), (400, "yfx", "rdiv"),
        (400, "yfx", "<<"), (400, "yfx", ">>"), (400, "yfx", "mod"), (400, "yfx", "rem"),
        (400, "yfx", "div"), (400, "yfx", "divmod"), (200, "xfx", "**"), (200, "xfy", "^"),
        (200, "fy", "-"), (200, "fy", "+"), (200, "fy", "\\"), (1, "fx", "$"),
    ];
    for e in table {
        let (p, t, n) = e;
        add_op(m, p as u32, parse.op_type(t).unwrap(), m.db.atom(n));
    }
    let decl = ["dynamic", "discontiguous", "initialization", "meta_predicate", "module_transparent",
                "multifile", "public", "thread_local", "table"];
    for n in decl { add_op(m, 1150, OpType.FX, m.db.atom(n)); }
    add_op(m, 1100, OpType.XFY, term.A_BAR);
}

pub fn is_op(m: *Machine, a: u32) -> bool { m.ops.is_op(a as u64) }

pub fn op_prec(m: *Machine, a: u32) -> u32 { m.ops.max_prio(a as u64) }

/// (priority, left max, right max)
pub fn infix_op(m: *Machine, a: u32) -> ?(u32, u32, u32) { let d = m.ops.infix(a as u64)?; Some((d.prio, d.left, d.right)) }

/// (priority, argument max)
pub fn prefix_op(m: *Machine, a: u32) -> ?(u32, u32) { let d = m.ops.prefix(a as u64)?; Some((d.prio, d.right)) }

pub fn postfix_op(m: *Machine, a: u32) -> ?(u32, u32) { let d = m.ops.postfix(a as u64)?; Some((d.prio, d.left)) }

// ---- tokens --------------------------------------------------------------

pub enum Tk { BigInt, Atom, Var, Int, Flt, Str, BackQ, Open, OpenCT, Close, Comma, Bar, OpenList, CloseList, OpenCurly, CloseCurly, End, Eof }

pub struct Token {
    kind: Tk,
    text: str,     // atom or variable name (in the reader's arena)
    int: i64,
    flt: f64,
    layout: bool,  // layout (or a comment) before the token
    line: u32,
}

pub struct Reader {
    m: *Machine,
    src: str,
    pos: u64,
    line: u32,
    tok: Token,
    peeked: bool,
    arena: mem.Arena,
    buf: text.StrBuf,
    vars: mem.Vec<(str, Term)>,
    error: ?str,
    err_line: u32,
}

pub fn Reader.new(m: *Machine, src: str) -> Reader {
    Reader {
        m: m, src: src, pos: 0, line: 1,
        tok: Token { kind: Tk.Eof, text: "", int: 0, flt: 0.0, layout: false, line: 1 },
        peeked: false, arena: mem.Arena.new(), buf: text.StrBuf.new(), vars: mem.Vec.new(),
        error: None, err_line: 0,
    }
}

pub fn Reader.free(r: *Reader) {
    r.arena.free();
    r.buf.free();
    r.vars.free();
}

fn is_sym(c: u8) -> bool {
    c == '+' or c == '-' or c == '*' or c == '/' or c == '\\' or c == '^' or c == '<' or c == '>'
        or c == '=' or c == '~' or c == ':' or c == '.' or c == '?' or c == '@' or c == '#'
        or c == '&' or c == '$'
}

fn is_alnum(c: u8) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c >= 128
}

fn is_digit(c: u8) -> bool { c >= '0' and c <= '9' }

fn Reader.peekc(r: *Reader, off: u64) -> u8 {
    if r.pos + off < r.src.len { r.src[r.pos + off] } else { 0 }
}

fn Reader.fail(r: *Reader, msg: str) {
    if r.error.is_none() { r.error = Some(msg); r.err_line = r.line; }
}

/// Skip layout and comments; true if there was any.
fn Reader.skip_layout(r: *Reader) -> bool {
    let start = r.pos;
    loop {
        if r.pos >= r.src.len { break; }
        let c = r.src[r.pos];
        if c == '\n' { r.line += 1; r.pos += 1; }
        else if c == ' ' or c == '\t' or c == '\r' or c == 12 { r.pos += 1; }
        else if c == '%' {
            while r.pos < r.src.len and r.src[r.pos] != '\n' { r.pos += 1; }
        } else if c == '/' and r.peekc(1) == '*' {
            r.pos += 2;
            while r.pos < r.src.len and !(r.src[r.pos] == '*' and r.peekc(1) == '/') {
                if r.src[r.pos] == '\n' { r.line += 1; }
                r.pos += 1;
            }
            r.pos += 2;
            if r.pos > r.src.len { r.pos = r.src.len; }
        } else { break; }
    }
    r.pos != start
}

/// One escape sequence after a backslash in a quoted item; None for a
/// continuation (backslash-newline).
fn Reader.escape(r: *Reader) -> ?u32 {
    let c = r.peekc(0);
    r.pos += 1;
    match c {
        'n' => Some(10), 't' => Some(9), 'r' => Some(13), 'a' => Some(7), 'b' => Some(8),
        'f' => Some(12), 'v' => Some(11), '0'..='7' => {
            var v: u32 = (c - '0') as u32;
            while is_digit(r.peekc(0)) and r.peekc(0) < '8' { v = v * 8 + (r.peekc(0) - '0') as u32; r.pos += 1; }
            if r.peekc(0) == '\\' { r.pos += 1; }
            Some(v)
        }
        'x' => {
            var v: u32 = 0;
            while num.is_hex_digit(r.peekc(0)) { v = v * 16 + num.digit_value(r.peekc(0)); r.pos += 1; }
            if r.peekc(0) == '\\' { r.pos += 1; }
            Some(v)
        }
        'e' => Some(27), 's' => Some(32), 'z' => Some(0xFFFFFFFF),
        '\n' => { r.line += 1; None }
        _ => Some(c as u32),
    }
}

fn push_code(b: *text.StrBuf, c: u32) {
    if c < 128 { b.push(c as u8); }
    else if c < 0x800 { b.push((0xC0 | (c >> 6)) as u8); b.push((0x80 | (c & 63)) as u8); }
    else if c < 0x10000 { b.push((0xE0 | (c >> 12)) as u8); b.push((0x80 | ((c >> 6) & 63)) as u8); b.push((0x80 | (c & 63)) as u8); }
    else { b.push((0xF0 | (c >> 18)) as u8); b.push((0x80 | ((c >> 12) & 63)) as u8); b.push((0x80 | ((c >> 6) & 63)) as u8); b.push((0x80 | (c & 63)) as u8); }
}

/// The body of a quoted item, up to the closing `q`, into `r.buf`.
fn Reader.quoted(r: *Reader, q: u8) {
    r.buf.clear();
    loop {
        if r.pos >= r.src.len { r.fail("unterminated quoted"); return; }
        let c = r.src[r.pos];
        r.pos += 1;
        if c == q {
            if r.peekc(0) == q { r.buf.push(q); r.pos += 1; continue; }
            return;
        }
        if c == '\\' {
            if let Some(e) = r.escape() { push_code(&r.buf, e); }
            continue;
        }
        if c == '\n' { r.line += 1; }
        r.buf.push(c);
    }
}

fn Reader.number(r: *Reader) {
    let start = r.pos;
    let t = &r.tok;
    if r.src[r.pos] == '0' and r.peekc(1) == '\'' {
        // 0'c
        r.pos += 2;
        let c = r.peekc(0);
        if c == '\\' {
            r.pos += 1;
            t.int = (r.escape() ?? 0) as i64;
        } else if c == '\'' and r.peekc(1) == '\'' {
            r.pos += 2;
            t.int = 39;
        } else {
            // A UTF-8 sequence is one code.
            var v = c as u32;
            var n: u64 = 1;
            if c >= 0xF0 { v = (c as u32) & 7; n = 4; } else if c >= 0xE0 { v = (c as u32) & 15; n = 3; } else if c >= 0xC0 { v = (c as u32) & 31; n = 2; }
            for i in 1..n { v = (v << 6) | ((r.peekc(i) as u32) & 63); }
            r.pos += n;
            t.int = v as i64;
        }
        t.kind = Tk.Int;
        return;
    }
    if r.src[r.pos] == '0' and (r.peekc(1) == 'x' or r.peekc(1) == 'o' or r.peekc(1) == 'b') {
        let radix: u32 = if r.peekc(1) == 'x' { 16 } else if r.peekc(1) == 'o' { 8 } else { 2 };
        let ds = r.pos + 2;
        var e = ds;
        while e < r.src.len and num.digit_value(r.src[e]) < radix { e += 1; }
        if e > ds {
            r.pos = e;
            match num.parse_i64(r.src[ds..e], radix) {
                Ok(v) => { t.int = v; t.kind = Tk.Int; }
                Err(_) => { r.fail("integer too large"); t.kind = Tk.Int; t.int = 0; }
            }
            if !term.fits_int(t.int) { r.fail("integer too large"); }
            return;
        }
    }
    while is_digit(r.peekc(0)) or (r.peekc(0) == '_' and is_digit(r.peekc(1))) { r.pos += 1; }
    var is_float = false;
    if r.peekc(0) == '.' and is_digit(r.peekc(1)) {
        is_float = true;
        r.pos += 1;
        while is_digit(r.peekc(0)) { r.pos += 1; }
    }
    if (r.peekc(0) == 'e' or r.peekc(0) == 'E') and (is_digit(r.peekc(1)) or ((r.peekc(1) == '+' or r.peekc(1) == '-') and is_digit(r.peekc(2)))) {
        is_float = true;
        r.pos += 2;
        while is_digit(r.peekc(0)) { r.pos += 1; }
    }
    if r.peekc(0) == 'I' and r.src.len >= r.pos + 3 and r.src[r.pos..r.pos + 3].eq("Inf") and is_float {
        r.pos += 3;
        t.kind = Tk.Flt;
        t.flt = 1.0 / 0.0;
        return;
    }
    // Digit groups (1_000_000) are dropped.
    r.buf.clear();
    for i in start..r.pos { if r.src[i] != '_' { r.buf.push(r.src[i]); } }
    if is_float {
        t.kind = Tk.Flt;
        match num.parse_f64(r.buf.as_str()) { Ok(x) => t.flt = x, Err(_) => r.fail("bad float") }
    } else {
        t.kind = Tk.Int;
        match num.parse_i64(r.buf.as_str(), 10) {
            Ok(v) => t.int = v,
            Err(_) => { t.kind = Tk.BigInt; t.text = r.arena.str(r.buf.as_str()); }
        }
        if t.kind == Tk.Int and !term.fits_int(t.int) { t.kind = Tk.BigInt; t.text = r.arena.str(r.buf.as_str()); }
    }
}

fn Reader.next(r: *Reader) -> *Token {
    if r.peeked { r.peeked = false; return &r.tok; }
    let layout = r.skip_layout();
    let t = &r.tok;
    t.layout = layout;
    t.line = r.line;
    t.text = "";
    t.int = 0;
    if r.pos >= r.src.len { t.kind = Tk.Eof; return t; }
    let c = r.src[r.pos];
    let start = r.pos;
    if is_digit(c) {
        r.number();
        return t;
    }
    if c == '_' or (c >= 'A' and c <= 'Z') {
        while r.pos < r.src.len and is_alnum(r.src[r.pos]) { r.pos += 1; }
        t.kind = Tk.Var;
        t.text = r.src[start..r.pos];
        return t;
    }
    if (c >= 'a' and c <= 'z') or c >= 128 {
        while r.pos < r.src.len and is_alnum(r.src[r.pos]) { r.pos += 1; }
        t.kind = Tk.Atom;
        t.text = r.src[start..r.pos];
        return t;
    }
    r.pos += 1;
    match c {
        '(' => { t.kind = if layout { Tk.Open } else { Tk.OpenCT }; return t; }
        ')' => { t.kind = Tk.Close; return t; }
        '[' => { t.kind = Tk.OpenList; return t; }
        ']' => { t.kind = Tk.CloseList; return t; }
        '{' => { t.kind = Tk.OpenCurly; return t; }
        '}' => { t.kind = Tk.CloseCurly; return t; }
        ',' => { t.kind = Tk.Comma; return t; }
        '|' => {
            if r.peekc(0) == '|' { r.pos += 1; t.kind = Tk.Atom; t.text = "||"; return t; }
            t.kind = Tk.Bar;
            return t;
        }
        '!' => { t.kind = Tk.Atom; t.text = "!"; return t; }
        ';' => { t.kind = Tk.Atom; t.text = ";"; return t; }
        '\'' => {
            r.quoted('\'');
            t.kind = Tk.Atom;
            t.text = r.arena.str(r.buf.as_str());
            t.int = 1;     // quoted: never an operator in functional position checks
            return t;
        }
        '"' => {
            r.quoted('"');
            t.kind = Tk.Str;
            t.text = r.arena.str(r.buf.as_str());
            return t;
        }
        '`' => {
            r.quoted('`');
            t.kind = Tk.BackQ;
            t.text = r.arena.str(r.buf.as_str());
            return t;
        }
        _ => {}
    }
    if c == '.' {
        let n = r.peekc(0);
        if n == 0 or n == ' ' or n == '\n' or n == '\t' or n == '\r' or n == '%' {
            t.kind = Tk.End;
            return t;
        }
    }
    if is_sym(c) {
        while r.pos < r.src.len and is_sym(r.src[r.pos]) { r.pos += 1; }
        t.kind = Tk.Atom;
        t.text = r.src[start..r.pos];
        return t;
    }
    r.fail("illegal character");
    t.kind = Tk.Eof;
    t
}

fn Reader.look(r: *Reader) -> *Token {
    if !r.peeked { r.next(); r.peeked = true; }
    &r.tok
}

fn Reader.variable(r: *Reader, name: str) -> Term {
    if name.eq("_") { return r.m.new_var(); }
    for i in 0..r.vars.len {
        let (n, v) = r.vars.ptr[i];
        if n.eq(name) { return v; }
    }
    let v = r.m.new_var();
    r.vars.push((r.arena.str(name), v));
    v
}

pub fn Reader.codes_pub(r: *Reader, s: str, chars: bool) -> Term { r.codes(s, chars) }

fn Reader.codes(r: *Reader, s: str, chars: bool) -> Term {
    let m = r.m;
    var t = Term.Atom(term.A_NIL);
    // Decode UTF-8 into codes, then build the list from the end.
    var cs: mem.Vec<u32> = mem.Vec.new();
    var i: u64 = 0;
    while i < s.len {
        let c = s[i];
        var v = c as u32;
        var n: u64 = 1;
        if c >= 0xF0 { v = (c as u32) & 7; n = 4; } else if c >= 0xE0 { v = (c as u32) & 15; n = 3; } else if c >= 0xC0 { v = (c as u32) & 31; n = 2; }
        for j in 1..n { if i + j < s.len { v = (v << 6) | ((s[i + j] as u32) & 63); } }
        cs.push(v);
        i += n;
    }
    var k = cs.len;
    while k > 0 {
        k -= 1;
        let e = if chars {
            var b = text.StrBuf.new();
            push_code(&b, cs.ptr[k]);
            let a = m.db.atom(b.as_str());
            b.free();
            Term.Atom(a)
        } else { term.mk_int(cs.ptr[k] as i64) };
        t = m.mk_cons(e, t);
    }
    cs.free();
    t
}

fn Reader.expect(r: *Reader, k: Tk, msg: str) {
    let t = r.next();
    if t.kind != k { r.fail(msg); }
}

fn Reader.arglist(r: *Reader, name: u32) -> Term {
    var args: mem.Vec<Term> = mem.Vec.new();
    loop {
        args.push(r.parse_arg());
        if r.error.is_some() { args.free(); return Term.Atom(term.A_NIL); }
        let t = r.next();
        if t.kind == Tk.Comma { continue; }
        if t.kind != Tk.Close { r.fail("expected , or ) in arguments"); }
        break;
    }
    let m = r.m;
    let res = if name == term.A_DOT and args.len == 2 {
        m.mk_cons(args.ptr[0], args.ptr[1])
    } else {
        let f = m.db.functor(name, args.len as u32);
        let s = m.mk_struct(f, args.len);
        for i in 0..args.len { s.args[i] = args.ptr[i]; }
        Term.Str(s)
    };
    args.free();
    res
}

// ---- the operator precedence parser: hooks for std.parse.Ops ------------

impl parse.OpHooks<Term, ()> for Reader;

/// An atom token not followed directly by `(`, unquoted, and not a sign
/// followed directly by a number, may be an operator at a term start;
/// after a term, any atom, `,` and `|` may be.
fn Reader.peek(r: *Reader, prefix: bool) -> Tok {
    if r.error.is_some() { return Tok.End; }
    let t = r.look();
    match t.kind {
        Atom => {
            if prefix and (t.int != 0 or r.peekc(0) == '(') { return Tok.Term; }
            if prefix and (t.text.eq("-") or t.text.eq("+")) and is_digit(r.peekc(0)) { return Tok.Term; }
            Tok.Name(r.m.db.atom(t.text) as u64)
        }
        Comma => Tok.Sep(term.A_COMMA as u64),
        Bar => Tok.Sep(term.A_BAR as u64),
        Var => Tok.Term, Int => Tok.Term, BigInt => Tok.Term, Flt => Tok.Term, Str => Tok.Term, BackQ => Tok.Term,
        Open => Tok.Term, OpenCT => Tok.Term, OpenList => Tok.Term, OpenCurly => Tok.Term,
        _ => Tok.End,
    }
}

fn Reader.advance(r: *Reader) -> Result<(), ()> { r.next(); Ok(()) }

fn Reader.atom(r: *Reader, a: u64) -> Result<Term, ()> { Ok(Term.Atom(a as u32)) }

fn Reader.prefix(r: *Reader, a: u64, x: Term) -> Result<Term, ()> { Ok(r.m.mk1(a as u32, x)) }

fn Reader.infix(r: *Reader, a: u64, x: Term, y: Term) -> Result<Term, ()> {
    // `|` at priority 1100 or more is `;`.
    let bar = a == term.A_BAR as u64 and infix_op(r.m, term.A_BAR).unwrap().0 >= 1100;
    Ok(r.m.mk2(if bar { term.A_SEMI } else { a as u32 }, x, y))
}

fn Reader.postfix(r: *Reader, a: u64, x: Term) -> Result<Term, ()> { Ok(r.m.mk1(a as u32, x)) }

/// A term that is not an operator application.
fn Reader.primary(r: *Reader) -> Result<Term, ()> {
    let m = r.m;
    let t = r.next();
    match t.kind {
        Int => return Ok(term.mk_int(t.int)),
        BigInt => { let s = t.text; return Ok(big_of(r.m, s, false)); }
        Flt => return Ok(Term.Flt(t.flt)),
        Var => { let name = t.text; return Ok(r.variable(name)); }
        Str => {
            let s = t.text;
            if m.flags_dq == term.A_ATOM { return Ok(Term.Atom(m.db.atom(s))); }
            return Ok(r.codes(s, m.flags_dq == term.A_CHARS));
        }
        BackQ => { let s = t.text; return Ok(r.codes(s, false)); }
        Open => { let x = r.parse(1200); r.expect(Tk.Close, "expected )"); return Ok(x); }
        OpenCT => { let x = r.parse(1200); r.expect(Tk.Close, "expected )"); return Ok(x); }
        OpenList => {
            if r.look().kind == Tk.CloseList {
                r.next();
                return Ok(r.after_atom(term.A_NIL));
            }
            var items: mem.Vec<Term> = mem.Vec.new();
            var tail = Term.Atom(term.A_NIL);
            loop {
                items.push(r.parse_arg());
                if r.error.is_some() { break; }
                let k = r.next().kind;
                if k == Tk.Comma { continue; }
                if k == Tk.Bar { tail = r.parse(999); r.expect(Tk.CloseList, "expected ]"); break; }
                if k != Tk.CloseList { r.fail("expected , | or ] in list"); }
                break;
            }
            var k = items.len;
            while k > 0 { k -= 1; tail = m.mk_cons(items.ptr[k], tail); }
            items.free();
            return Ok(tail);
        }
        OpenCurly => {
            if r.look().kind == Tk.CloseCurly {
                r.next();
                return Ok(r.after_atom(term.A_CURLY));
            }
            let x = r.parse(1200);
            r.expect(Tk.CloseCurly, "expected }");
            return Ok(m.mk1(term.A_CURLY, x));
        }
        Atom => {
            let s = t.text;
            if t.int == 0 and (s.eq("-") or s.eq("+")) and is_digit(r.peekc(0)) {
                // A signed number: `-` directly followed by a number.
                let neg = s.eq("-");
                let n = r.next();
                if n.kind == Tk.BigInt { let d = n.text; return Ok(big_of(m, d, neg)); }
                if n.kind == Tk.Int { return Ok(term.mk_int(if neg { 0 - n.int } else { n.int })); }
                return Ok(Term.Flt(if neg { -n.flt } else { n.flt }));
            }
            return Ok(r.after_atom(m.db.atom(s)));
        }
        Comma => r.fail("unexpected ,"),
        Bar => r.fail("unexpected |"),
        End => r.fail("unexpected end of clause"),
        Eof => r.fail("unexpected end of file"),
        _ => r.fail("unexpected token"),
    }
    Ok(Term.Atom(term.A_NIL))
}

/// An atom just read: functional notation or the atom itself.
fn Reader.after_atom(r: *Reader, a: u32) -> Term {
    if r.look().kind == Tk.OpenCT {
        r.next();
        return r.arglist(a);
    }
    Term.Atom(a)
}

fn Reader.parse(r: *Reader, maxp: u32) -> Term {
    let Ok((t, _)) = r.op_parse(&r.m.ops, maxp) else { return Term.Atom(term.A_NIL); };
    t
}

/// An argument (of a compound or a list): priority 999, but like SWI-Prolog
/// an operator above 999 other than `,` and `|` is accepted (`f(a :- b)`).
fn Reader.parse_arg(r: *Reader) -> Term {
    let Ok(t) = r.op_parse_arg(&r.m.ops) else { return Term.Atom(term.A_NIL); };
    t
}

/// Read one clause; None at the end of the input. On a syntax error,
/// `r.error` is set and the rest of the clause is skipped.
pub fn Reader.read(r: *Reader) -> ?Term {
    r.vars.clear();
    r.error = None;
    let t = r.look();
    if t.kind == Tk.Eof { r.next(); return None; }
    let x = r.parse(1200);
    if r.error.is_none() {
        let e = r.next();
        if e.kind != Tk.End { r.fail("operator expected"); }
    }
    if r.error.is_some() {
        // Skip to the end of the clause.
        loop {
            let k = r.next().kind;
            if k == Tk.End or k == Tk.Eof { break; }
        }
        return Some(Term.Atom(term.A_EOF));
    }
    Some(x)
}

/// The variables of the last clause read, as Name=Var pairs.
pub fn Reader.var_list(r: *Reader) -> Term {
    let m = r.m;
    var t = Term.Atom(term.A_NIL);
    var k = r.vars.len;
    while k > 0 {
        k -= 1;
        let (n, v) = r.vars.ptr[k];
        t = m.mk_cons(m.mk2(term.A_EQ, Term.Atom(m.db.atom(n)), v), t);
    }
    t
}

/// A decimal integer literal too large for 48 bits.
fn big_of(m: *Machine, digits: str, neg: bool) -> Term {
    let b = bigint.gc_parse(&m.heap, digits, 10).unwrap();
    if neg { return arith.norm(bigint.gc_neg(&m.heap, Arg.Ref(b))); }
    arith.norm(b)
}

/// Parse a number from text (number_codes/2, atom_number/2).
pub fn parse_number(m: *Machine, s: str) -> ?Term {
    var r = Reader.new(m, s);
    defer r.free();
    let t = r.next();
    var neg = false;
    var kind = t.kind;
    if kind == Tk.Atom and (t.text.eq("-") or t.text.eq("+")) {
        neg = t.text.eq("-");
        r.next();
        kind = r.tok.kind;
    }
    if r.error.is_some() { return None; }
    var res = Term.Unb;
    if kind == Tk.Int { res = term.mk_int(if neg { 0 - r.tok.int } else { r.tok.int }); }
    else if kind == Tk.BigInt { res = big_of(m, r.tok.text, neg); }
    else if kind == Tk.Flt { res = Term.Flt(if neg { -r.tok.flt } else { r.tok.flt }); }
    else { return None; }
    r.skip_layout();
    if r.pos != r.src.len or r.error.is_some() { return None; }
    Some(res)
}
