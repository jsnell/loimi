// The Mini virtual machine: a register machine in the style of Lua 5.

import std.gc;
import std.text;
import std.mem;
import value;
import lib;
import value.{V, Str, Arr, Table, Proto, Closure, UpVal};
import coro;
import coro.{Coro}; #[cfg(gil)] import std.gil; #[cfg(debug)] import debugger;

extern "C" fn pow(a: f64, b: f64) -> f64;

/// One activation record. `resume` is where this frame continues after
/// the call it is making returns; `nres` is how many results this
/// frame's caller wants (at least 1). `k` caches cl.proto.consts.
pub struct Frame { cl: Gc<Closure>, base: *V, resume: *u32, k: *V, nres: u32 }

/// `Ctx.nret` when the last native returned one result (its Ok value).
pub const NRET_ONE: u64 = 0xffffffffffffffff;

pub struct Ctx {
    heap: gc.Heap,
    stack: *V,
    stack_end: *V,
    frames: *Frame,
    frames_end: *Frame,
    fp: *Frame,
    /// The bottom frame of the innermost run: returning from it leaves
    /// the run (`exit`). Null while no Mini code runs.
    base: *Frame,
    globals: Gc<Table>,
    /// An error that came back from a nested run (`call_value`), which
    /// already says where it happened: `on raise` passes it on unchanged.
    rethrow: V,
    out: text.StrBuf,
    /// Open upvalues, sorted by stack level, highest first.
    open: ?Gc<UpVal>,
    /// Level of the first open upvalue (null when none), so that
    /// "anything to close at or above here?" is one compare.
    open_level: *V,
    /// Natives with ids from HOST_NATIVE up, which an embedder registers
    /// (embed.lm); `no_host` in the standalone interpreter. They may call
    /// back into Mini (`call_value`).
    host: fn(*Ctx, i32, *V, u64) -> Result<V, V> uses reenter,
    // Coroutines (coro.lm). The fields above from `stack` to `open_level`
    // describe the running thread's stacks: a switch swaps them.
    /// The running coroutine: `main` when none is. The threads that
    /// resumed it, innermost first, are linked through `Coro.prev`.
    cur: Gc<Coro>,
    main: Gc<Coro>,
    /// How many of those resumes happened inside a vm run (a CALL), which
    /// count towards MAX_NESTING as the nested runs (`Mini.depth`) do.
    nco: u32,
    /// Results of the last native when it returned several: `nret` of
    /// them in `rbuf` (capacity `rcap`). NRET_ONE otherwise.
    nret: u64,
    rbuf: *V,
    rcap: u64,
    /// Set when a CALL of coroutine.yield left the run, with where to
    /// continue (`ypc`, the instruction after the CALL: a resume point
    /// that `Mini.resume` may jump to; `Mini.Resume.placeholder()`, which
    /// traps, before the first yield) and where the CALL's `ynres`
    /// results go (`ydst`).
    yielded: bool,
    ypc: Mini.Resume,
    ydst: u32,
    ynres: u32,
    /// The values that coroutine.yield passed, or that the return that
    /// ended a run returned (RETN; RET1 and RET0 set only `nxfer`).
    xfer: *V,
    nxfer: u64, #[cfg(gil)] gil: *gil.Gil, #[cfg(debug)] dbg: ?*debugger.Dbg, #[cfg(debug)] pause: u32, // --cfg gil: the lock of threads sharing the state (threads.lm); --cfg debug: the debugger, when running under one (debugger.lm)
}

pub const HOST_NATIVE: i32 = 1000;

pub fn no_host(c: *Ctx, id: i32, args: *V, n: u64) -> Result<V, V> {
    Err(error_msg(c, "unknown builtin"))
}

/// GC roots: globals, the error being passed on, open upvalues, and every
/// active frame's closure and registers (those of nested runs included:
/// they are frames above the native that started them).
pub fn scan_roots(h: *gc.Heap, c: *Ctx) {
    gc_mark(h, c.globals);
    gc_mark(h, c.rethrow);
    if let Some(u) = c.open { gc_mark(h, u); }
    scan_frames(h, c.frames, c.fp);
    // Coroutines: the running one, and the (normal) resumers with their
    // stacks, up to their saved frame pointers (a suspended coroutine's
    // stacks are traced through its object).
    gc_mark(h, c.cur);
    gc_mark(h, c.main);
    var s = c.cur.prev;
    loop {
        let Some(r) = s else { break; };
        gc_mark(h, r);
        if let Some(u) = r.open { gc_mark(h, u); }
        scan_frames(h, r.frames, r.fp);
        s = r.prev;
    }
    if c.nret != NRET_ONE {
        for i in 0..c.nret { gc_mark(h, c.rbuf[i]); }
    }
}

pub fn scan_frames(h: *gc.Heap, first: *Frame, last: *Frame) {
    var f = first;
    while f <= last {
        gc_mark(h, f.cl);
        let n = f.cl.proto.nregs as u64;
        for i in 0..n { gc_mark(h, f.base[i]); }
        f = f + 1;
    }
}

/// The open upvalue for stack slot `level`, created if needed.
fn find_upval(c: *Ctx, level: *V) -> Gc<UpVal> {
    var prev: ?Gc<UpVal> = None;
    var cur = c.open;
    loop {
        let Some(u) = cur else { break; };
        if u.v < level { break; }
        if u.v == level { return u; }
        prev = cur;
        cur = u.next;
    }
    let nu = new(&c.heap, UpVal { v: level, closed: V.Nil, next: cur, co: Some(c.cur) });
    match prev {
        Some(pu) => pu.next = Some(nu),
        None => {
            c.open = Some(nu);
            c.open_level = level;
        }
    }
    nu
}

/// Close every open upvalue at or above `level`.
pub fn close_upvals(c: *Ctx, level: *V) {
    loop {
        let Some(u) = c.open else { break; };
        if u.v < level { break; }
        u.closed = *u.v;
        u.v = &u.closed;
        u.co = None;
        c.open = u.next;
        u.next = None;
    }
    c.open_level = match c.open {
        Some(u) => u.v,
        None => 0 as *V,
    };
}

/// An error message mentioning the type of `v`: "<msg><type> value".
fn error(c: *Ctx, msg: str, v: V) -> V {
    var b = text.StrBuf.new();
    b.push_str(msg);
    b.push_str(value.type_name(v));
    b.push_str(" value");
    let s = value.new_str(&c.heap, b.as_str());
    b.free();
    V.S(s)
}

/// `e` prefixed with the line of the instruction at `at` in `p`'s code:
/// "line N: e".
fn at_line(c: *Ctx, p: Gc<Proto>, at: *u32, e: V) -> V {
    let i = ((at as u64) - (p.code.start() as u64)) / 4;
    var line: u32 = 0;
    if i < p.lines.data.len { line = p.lines.data[i]; }
    c.out.clear();
    c.out.push_str("line ");
    c.out.push_int(line as i64);
    c.out.push_str(": ");
    value.write_value(&c.out, e);
    V.S(value.new_str(&c.heap, c.out.as_str()))
}

fn iter_error(c: *Ctx, v: V) -> V {
    var b = text.StrBuf.new();
    b.push_str("bad argument #1 to 'for iterator' (table expected, got ");
    b.push_str(value.type_name(v));
    b.push_str(")");
    let s = value.new_str(&c.heap, b.as_str());
    b.free();
    V.S(s)
}

fn error_msg(c: *Ctx, msg: str) -> V {
    V.S(value.new_str(&c.heap, msg))
}

/// Arithmetic outside the fast paths: op 0 add, 1 sub, 2 mul, 3 div,
/// 4 mod, 5 pow. Int results that overflow become floats.
fn arith_slow(c: *Ctx, op: i64, a: V, b: V) -> Result<V, V> {
    let Some(x) = value.to_num(a) else { return Err(error(c, "attempt to perform arithmetic on a ", a)); };
    let Some(y) = value.to_num(b) else { return Err(error(c, "attempt to perform arithmetic on a ", b)); };
    if let (Int(i), Int(j)) = (a, b) and op == 4 {
        if j == 0 { return Err(error_msg(c, "attempt to perform 'n%%0'")); }
        let (i, j) = (i as i64, j as i64);
        var r = i % j;
        if r != 0 and (r ^ j) < 0 { r += j; }
        return Ok(V.Int(r as i32));
    }
    let r = match op {
        0 => x + y,
        1 => x - y,
        2 => x * y,
        3 => x / y,
        4 => {
            if y == 0.0 {
                x - x / y * y
            } else {
                var m = x - (x / y).floor() * y;
                if m != 0.0 and (m < 0.0) != (y < 0.0) { m += y; }
                m
            }
        }
        _ => pow(x, y),
    };
    Ok(V.Num(r))
}

fn less(c: *Ctx, a: V, b: V, or_equal: bool) -> Result<bool, V> {
    match (a, b) {
        (S(x), S(y)) => {
            let n = if x.data.len < y.data.len { x.data.len } else { y.data.len };
            for i in 0..n {
                if x.data[i] != y.data[i] { return Ok(x.data[i] < y.data[i]); }
            }
            Ok(if or_equal { x.data.len <= y.data.len } else { x.data.len < y.data.len })
        }
        _ => {
            let (Some(x), Some(y)) = (value.to_num(a), value.to_num(b)) else {
                return Err(error(c, "attempt to compare a ", if value.to_num(a).is_none() { a } else { b }));
            };
            Ok(if or_equal { x <= y } else { x < y })
        }
    }
}

fn concatenable(v: V) -> bool {
    match v {
        S(_) | Int(_) | Num(_) => true,
        _ => false,
    }
}

/// vals[0] .. vals[1] .. ... .. vals[n-1] (n >= 2) as one new string.
/// Errors name the operand Lua would: it concatenates from the right,
/// so the last pair is checked first (its left operand if both are bad).
fn concat(c: *Ctx, vals: *V, n: u64) -> Result<V, V> {
    if !concatenable(vals[n - 2]) { return Err(error(c, "attempt to concatenate a ", vals[n - 2])); }
    if !concatenable(vals[n - 1]) { return Err(error(c, "attempt to concatenate a ", vals[n - 1])); }
    var i = n - 2;
    while i > 0 {
        i -= 1;
        if !concatenable(vals[i]) { return Err(error(c, "attempt to concatenate a ", vals[i])); }
    }
    c.out.clear();
    for j in 0..n { value.write_value(&c.out, vals[j]); }
    Ok(V.S(value.new_str(&c.heap, c.out.as_str())))
}

fn length(c: *Ctx, v: V) -> Result<V, V> {
    match v {
        S(s) => Ok(V.Int(s.data.len as i32)),
        T(t) => Ok(V.Int(value.table_len(t) as i32)),
        _ => Err(error(c, "attempt to get length of a ", v)),
    }
}

/// GETFIELD/SELF cache miss: look `key` up and remember its slot.
fn field_get_slow(t: Gc<Table>, key: V, slot: *u32) -> V {
    let Some(i) = value.table_find(t, key) else { return V.Nil; };
    *slot = i as u32;
    t.hptr[2 * i + 1]
}

/// SETFIELD cache miss: store, then remember the key's slot.
fn field_set_slow(h: *gc.Heap, t: Gc<Table>, key: V, v: V, slot: *u32) {
    value.table_set(h, t, key, v);
    if let Some(i) = value.table_find(t, key) { *slot = i as u32; }
}

/// MODK's cache: m in the low 56 bits, s above, such that
/// floor(x / d) = (x * m) >> s for every 0 <= x < 2^31 (d >= 1). With
/// l = ceil(log2 d), s = 31 + l and m = ceil(2^s / d): m * d - 2^s < d <= 2^l,
/// which is Granlund and Montgomery's condition (PLDI 1994, theorem 4.2)
/// for 31-bit dividends; m <= 2^32, so x * m < 2^63 does not overflow.
fn mod_magic(d: i32) -> u64 {
    let dd = d as u64;
    let l: u64 = if dd <= 1 { 0 } else { 64 - ((dd - 1).clz() as u64) };
    let sh = 31 + l;
    let m = (((1 as u64) << sh) + dd - 1) / dd;
    m | (sh << 56)
}
pub const MAGIC_M: u64 = 0xFFFFFFFFFFFFFF;
pub const MOD_MANY: u32 = 0xFFFFFFFF;

/// Arithmetic outside the (Int, Int) and (Num, Num) fast paths: mixed
/// int/float operands first, then everything else.
fn arith_mixed(c: *Ctx, op: i64, a: V, b: V) -> Result<V, V> {
    if op <= 2 {
        let (x, y) = match (a, b) {
            (Int(i), Num(y)) => (i as f64, y),
            (Num(x), Int(j)) => (x, j as f64),
            _ => return arith_slow(c, op, a, b),
        };
        return Ok(V.Num(if op == 0 { x + y } else if op == 1 { x - y } else { x * y }));
    }
    arith_slow(c, op, a, b)
}

/// Fuse superinstructions in a function again after one of its sites
/// was quickened: fusion compares words by the op they stand for, so
/// specialized members (MUL_F; ADD_F) fuse too.
fn refuse(cl: Gc<Closure>) {
    Mini.optimize(cl.proto.code);
}

/// The single dispatch point for natives. Most allocate but never
/// collect; `table.sort` and host natives may call back into Mini.
/// `from_vm`: called by a CALL instruction, so coroutine.yield may leave
/// the run there (not through call_value: a native in between).
fn call_native(c: *Ctx, id: i32, args: *V, n: u64, from_vm: bool) -> Result<V, V> uses reenter {
    if id >= HOST_NATIVE { return c.host(c, id, args, n); }
    if id == lib.T_SORT { return table_sort(c, args, n); }
    if id >= coro.FIRST { return coro.call(c, id, args, n, from_vm); }
    lib.call(&c.heap, id, args, n)
}

/// `table.sort(t [, comp])`: Lua's algorithm (lib.lm), comparing with
/// `comp` through a nested run, or with `<`.
fn table_sort(c: *Ctx, args: *V, n: u64) -> Result<V, V> uses reenter {
    let comp = if n > 1 { args[1] } else { V.Nil };
    lib.sort(&c.heap, args, n, |a, b| sort_less(c, comp, a, b))
}

fn sort_less(c: *Ctx, comp: V, a: V, b: V) -> Result<bool, V> uses reenter {
    if comp == V.Nil { return less(c, a, b, false); }
    var ab: [V; 2] = [a, b];
    let r = call_value(c, comp, &ab[0], 2)?;
    Ok(value.truthy(r))
}

/// Nested runs allowed at once on a thread (`Mini.depth`), as Lua's
/// LUAI_MAXCCALLS: each one is a few C frames.
pub const MAX_NESTING: u32 = 200;

/// Call `f` with `args[0..n]` from host code: a native (table.sort's
/// comparator) or the embedding API (`mini_call`). While Mini code runs,
/// this is a nested run on the same stack, above the frame that called
/// the native (`ctx.fp`, published by the handler's sync); otherwise a
/// run from the bottom of the stack. The callee's return ends the run.
/// An error comes back as Err, its message already prefixed with its
/// line; `on raise` passes it on as is when a native returns it.
pub fn call_value(c: *Ctx, f: V, args: *V, n: u64) -> Result<V, V> uses reenter {
    let cl = match f {
        F(cl) => cl,
        Native(id) => {
            let r = call_native(c, id, args, n, false);
            c.nret = NRET_ONE;
            return r;
        }
        Co(w) if coro.is_wrap(w) => {
            let Some(co) = w.wrap else { unreachable };
            let r = coro.resume(c, co, args, n, true);
            c.nret = NRET_ONE;
            return r;
        }
        _ => return Err(error(c, "attempt to call a ", f)),
    };
    if Mini.depth >= MAX_NESTING { return Err(error_msg(c, "C stack overflow")); }
    let nregs = cl.proto.nregs as u64;
    // Frames and registers by index: in a coroutine, the stacks move when
    // they grow (`grow`), also during the nested run.
    let nested = c.base != 0 as *Frame;
    var fi: u64 = 0;
    var bi: u64 = 0;
    if nested {
        fi = frame_index(c, c.fp) + 1;
        bi = slot_index(c, c.fp.base) + c.fp.cl.proto.nregs as u64;
        let need = c.stack + bi + nregs;
        if need > c.stack_end or c.frames + fi + 1 >= c.frames_end {
            c.fp = grow(c, c.fp, need)?;
        }
    } else if c.stack + nregs > c.stack_end or c.frames + 1 >= c.frames_end {
        return Err(error_msg(c, "stack overflow"));
    }
    let saved_fp = frame_index(c, c.fp);
    let saved_base = if nested { frame_index(c, c.base) } else { NRET_ONE };
    let at = c.frames + fi;
    let base = c.stack + bi;
    // No collection until the run starts and `at` is a frame the
    // collector sees: the arguments are only in the new window.
    for i in 0..nregs { base[i] = if i < n { args[i] } else { V.Nil }; }
    at.base = base;
    let r = Mini.call(c, at, cl); #[cfg(debug)] debugger.left(c, fi); // --cfg debug: frame fi's run ended
    c.fp = c.frames + saved_fp;
    c.base = if nested { c.frames + saved_base } else { 0 as *Frame };
    if let Err(e) = r {
        // The run stopped mid-call: close what its frames left open.
        close_upvals(c, c.stack + bi);
        c.rethrow = e;
    }
    r
}

/// The index of frame `f` in the running thread's frame stack (may be
/// one below it: `f` = frames - 1 for an empty stack).
fn frame_index(c: *Ctx, f: *Frame) -> u64 {
    ((f as u64) -% (c.frames as u64)) / size_of<Frame>()
}

fn slot_index(c: *Ctx, p: *V) -> u64 {
    ((p as u64) - (c.stack as u64)) / 8
}

/// The stack limits of a coroutine (as the main stack's, state.lm).
pub const CO_SLOTS: u64 = 1 << 20;
pub const CO_FRAMES: u64 = 1 << 16;

/// Make room in the running coroutine for registers up to `need` and one
/// more frame above `fp`, moving its stacks if they must grow; returns
/// `fp` in the frame stack afterwards. Frame bases, open upvalues and the
/// context's pointers move along; a replaced block stays allocated until
/// the resume returns (`coro.retire`), for natives that hold pointers into
/// it. The main stack does not grow.
pub fn grow(c: *Ctx, fp: *Frame, need: *V) -> Result<*Frame, V> {
    let co = c.cur;
    if co == c.main { return Err(error_msg(c, "stack overflow")); }
    let nslots = slot_index(c, need);
    let fi = frame_index(c, fp);
    if nslots > CO_SLOTS or fi + 2 > CO_FRAMES { return Err(error_msg(c, "stack overflow")); }
    var top = fp;
    if nslots > co.nslots {
        var cap = co.nslots * 2;
        while cap < nslots { cap = cap * 2; }
        if cap > CO_SLOTS { cap = CO_SLOTS; }
        let old = c.stack;
        let dst: *V = mem.alloc(cap);
        c.heap.allocated += (cap - co.nslots) * 8;
        for i in 0..co.nslots { dst[i] = old[i]; }
        let delta = (dst as u64) -% (old as u64);
        var f = c.frames;
        while f <= fp {
            f.base = ((f.base as u64) +% delta) as *V;
            f = f + 1;
        }
        var u = c.open;
        loop {
            let Some(uv) = u else { break; };
            uv.v = ((uv.v as u64) +% delta) as *V;
            u = uv.next;
        }
        if c.open_level != 0 as *V { c.open_level = ((c.open_level as u64) +% delta) as *V; }
        coro.retire(co, old as *u8);
        co.stack = dst;
        co.nslots = cap;
        c.stack = dst;
        c.stack_end = dst + cap;
    }
    if fi + 2 > co.nframes {
        var cap = co.nframes * 2;
        while cap < fi + 2 { cap = cap * 2; }
        if cap > CO_FRAMES { cap = CO_FRAMES; }
        let dst: *Frame = mem.alloc(cap);
        c.heap.allocated += (cap - co.nframes) * size_of<Frame>();
        for i in 0..fi + 1 { dst[i] = c.frames[i]; }
        let bi = frame_index(c, c.base);
        coro.retire(co, c.frames as *u8);
        c.frames = dst;
        c.frames_end = dst + cap;
        c.base = dst + bi;
        top = dst + fi;
        co.frames = dst;
        co.nframes = cap;
    }
    c.fp = top;
    Ok(top)
}

#[require_verified]
#[profile("mini.vmprofile")]
pub vm Mini {
    context ctx: *Ctx;
    state { pc: *u32, regs: *V, k: *V, fp: *Frame }

    // Safepoints. Each falls through: its cold block gets a copy of the
    // rest of the op. `gc` collects at the start of an op that allocates;
    // `gil` hands the lock over on backward jumps (`--cfg gil`); `pause`
    // switches to the stepping variant when the debugger asks for a pause
    // (`--cfg debug`). Without the cfg, `poll gil;` and `poll pause;` are
    // nothing.
    poll gc { if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } } }
    #[cfg(gil)] poll gil { if unlikely(ctx.gil.waiting()) { cold { ctx.gil.yield_now(); } } }
    #[cfg(debug)] poll pause { if unlikely((&ctx.pause).atomic_load_relaxed() != 0) { use_variant step; } }

    // The generated verifier checks these against the prototype that
    // holds the code: Mini.build_verified (compile.lm, `finish`) creates
    // the Proto, copies the words into its `code` and verifies them there,
    // with the Proto itself as `proto`.
    verify_context owner proto: Gc<Proto>;
    operand reg = regs[it] verify (it as u32) < proto.nregs;
    // `const`: k is the pool of the code that runs (proto.consts), which
    // never changes once verified (the JIT patches constants in).
    operand kst = k[it] const proto.consts.data.ptr verify (it as u64) < proto.consts.data.len;
    operand imm = it;
    operand simm = it;
    operand callbase = it verify (it as u32) < proto.nregs;
    operand forbase = it verify (it as u32) + 3 < proto.nregs;
    operand upv = it verify (it as u32) < proto.nupvals;
    operand child = it verify (it as u64) < proto.protos.data.len;
    operand level = it verify (it as u32) <= proto.nregs;
    operand label = pc + it verify is_insn_boundary(pc + it);
    // Counts of registers from the A (or B) operand on. They decode to
    // the plain field; the verifier checks the range they cover against
    // the frame, reading the base from the instruction word (`*pc`).
    /// CALL's argument count: R[a+1 .. a+n] are in the frame.
    operand nargs = it verify Mini.ABC_a(*pc) + it < proto.nregs as u64;
    /// CALL's result count (at least 1): the callee's return writes
    /// R[a .. a+n-1].
    operand nres = it verify it >= 1 and Mini.ABC_a(*pc) + it <= proto.nregs as u64;
    /// SETLIST reads R[a+1 .. a+n].
    operand listn = it verify Mini.ABC_a(*pc) + it < proto.nregs as u64;
    /// RETN reads R[a .. a+n-1].
    operand retn = it verify Mini.ABC_a(*pc) + it <= proto.nregs as u64;
    /// CONCAT joins R[b .. b+n-1], at least two.
    operand catn = it verify it >= 2 and Mini.ABC_b(*pc) + it <= proto.nregs as u64;
    /// SWITCH's case count n: it jumps to `pc + 1 + i` for some i <= n,
    /// so the n + 1 words after it must be JMP instructions.
    operand ncases = it verify {
        var ok = true;
        var j: u64 = 0;
        while ok and j <= it {
            ok = is_insn_boundary(pc + 1 + j) and Mini.opcode(*(pc + 1 + j)) == Mini.OP_JMP;
            j += 1;
        }
        ok
    };
    /// GETINDEXI's constant index, 1..255.
    operand index1 = it verify it >= 1;
    /// SELF writes R[a] and R[a+1].
    operand selfbase = it verify (it as u32) + 1 < proto.nregs;

    encoding fixed(u32) {
        format ABC { op: 8, a: 8, b: 8, c: 8 }
        format ABsC { op: 8, a: 8, b: 8, sc: s8 }
        format ABx { op: 8, a: 8, bx: 16 }
        format AsBx { op: 8, a: 8, sbx: s16 }
        format sJ { op: 8, sj: s24 }
    }

    // The collector walks frames up to ctx.fp, and a nested run starts
    // above it.
    sync { ctx.fp = fp; #[cfg(debug)] fp.resume = pc + 1; } // --cfg debug: where a frame calling a native is, for the debugger's backtrace
    // After a native that may have run Mini code (`uses reenter`). The
    // stack never moves and the nested run leaves `ctx.fp` as it was, so
    // this reloads the same values; it is what keeps that an invariant of
    // call_value rather than an assumption of every handler.
    reload {
        fp = ctx.fp;
        regs = fp.base;
        k = fp.k; #[cfg(debug)] if debugger.stepping(ctx) { use_variant step; } // --cfg debug: the native ran Mini code that steps
    }

    op LOADK(dst: reg, c: kst) : ABx { dst = c; next }
    op LOADI(dst: reg, v: imm) : AsBx { dst = Int(v as i32); next }
    op LOADNIL(dst: reg) : ABC { dst = Nil; next }
    op LOADBOOL(dst: reg, b: imm) : ABC { dst = Bool(b != 0); next }
    op MOVE(dst: reg, src: reg) : ABC { dst = src; next }

    // Global reads are quickened: the generic op finds the global's slot
    // in the globals table and caches its index inline; GETGLOBAL_C then
    // only checks that the key in that slot is still the same string.
    // (The compiler interns string constants, so identity works.)
    cache GlobalIC { slot: u32 }

    family GETGLOBAL(dst: reg, name: kst) : ABx + GlobalIC {
        generic {
            if let Some(i) = value.table_find(ctx.globals, name) {
                cache.slot = i as u32;
                dst = ctx.globals.hptr[2 * i + 1];
                become GETGLOBAL_C;
                next
            }
            dst = Nil;
            next
        }
        GETGLOBAL_C {
            let g = ctx.globals;
            let i = cache.slot as u64;
            if likely(i < g.hcap) {
                let slots = g.hptr;
                if slots[2 * i] == name {
                    dst = slots[2 * i + 1];
                    next
                }
            }
            become GETGLOBAL; redo
        }
    }
    #[poll(gc)] op SETGLOBAL(src: reg, name: kst) : ABx {
        value.table_set(&ctx.heap, ctx.globals, name, src);
        next
    }

    op GETUPVAL(dst: reg, i: upv) : ABC { dst = *fp.cl.upvals.ptr[i].v; next }
    op SETUPVAL(src: reg, i: upv) : ABC {
        let u = fp.cl.upvals.ptr[i];
        *u.v = src;
        // A closed upvalue's `v` points at its own `closed` field.
        gc.write_barrier(&ctx.heap, u as *u8);
        next
    }
    /// R[dst] = a new closure of child prototype `i`, capturing upvalues
    /// as its descriptors say.
    #[poll(gc)] op CLOSURE(dst: reg, i: child) : ABx {
        let parent = fp.cl;
        let p = parent.proto.protos.data.ptr[i];
        let n = p.nupvals as u64;
        // unsafe: zero-filled (null `Gc`s); the loop below sets every
        // upvalue before the closure is reachable.
        let c = unsafe { new(&ctx.heap, Closure { proto: p }, n) };
        for j in 0..n {
            let d = p.updesc.data.ptr[j];
            if d >= 256 {
                c.upvals.ptr[j] = find_upval(ctx, regs + (d & 255) as u64);
            } else {
                c.upvals.ptr[j] = parent.upvals.ptr[d];
            }
        }
        dst = F(c);
        next
    }
    /// Close upvalues at or above R[a].
    op CLOSE(a: level) : ABC {
        if ctx.open_level >= regs + a { close_upvals(ctx, regs + a); }
        next
    }

    /// R[dst] = a table with room for `narr` array items and `nhash` fields.
    #[poll(gc)] op NEWTABLE(dst: reg, narr: imm, nhash: imm) : ABC {
        dst = T(value.new_table_sized(&ctx.heap, narr as u64, nhash as u64));
        next
    }
    /// R[a][batch*50 + i] = R[a + i] for i in 1..n.
    op SETLIST(a: callbase, n: listn, batch: imm) : ABC {
        if let T(t) = regs[a] {
            poll gc;
            value.table_setlist(&ctx.heap, t, regs + a + 1, n as u64, batch as u64 * 50);
        }
        next
    }
    // Field access with a constant string key caches the hash slot where
    // the key was last found. A hit only needs the slot to be in range
    // and to hold the same key (strings are interned, so that is one
    // compare). Shapes would let this skip the key check; tables built
    // the same way put a key in the same slot, which is what makes
    // record-style access hit.
    cache FieldIC { slot: u32 }

    op GETFIELD(dst: reg, t: reg, key: kst) : ABC + FieldIC {
        if let T(tab) = t {
            let i = cache.slot as u64;
            if likely(i < tab.hcap) {
                let p = tab.hptr + 2 * i;
                if p[0] == key { dst = p[1]; next }
            }
            cold { dst = field_get_slow(tab, key, &cache.slot); next }
        }
        raise error(ctx, "attempt to index a ", t)
    }
    op SETFIELD(t: reg, key: kst, v: reg) : ABC + FieldIC {
        if let T(tab) = t {
            let i = cache.slot as u64;
            if likely(i < tab.hcap) {
                let p = tab.hptr + 2 * i;
                if p[0] == key { p[1] = v; if unlikely(gc.needs_barrier(tab as *u8)) { cold { value.log_table(tab); } } next }
            }
            cold {
                if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                field_set_slow(&ctx.heap, tab, key, v, &cache.slot);
                next
            }
        }
        raise error(ctx, "attempt to index a ", t)
    }
    op GETINDEX(dst: reg, t: reg, key: reg) : ABC {
        if let (T(tab), Int(_)) = (t, key) {
            let u = value.int_index(key);
            if u < tab.asize { dst = tab.aptr[u]; next }
        }
        if let (T(tab), S(s)) = (t, key) { dst = value.hash_get_str(tab, key, s.hash); next }
        // Other keys in a cold block: the call would give the handler a frame.
        cold {
            if let T(tab) = t { dst = value.table_get(tab, key); next }
            raise error(ctx, "attempt to index a ", t)
        }
    }
    op SETINDEX(t: reg, key: reg, v: reg) : ABC {
        if let (T(tab), Int(_)) = (t, key) {
            let u = value.int_index(key);
            if u < tab.asize { tab.aptr[u] = v; if unlikely(gc.needs_barrier(tab as *u8)) { cold { value.log_table(tab); } } next }
            if u == tab.asize and value.can_append(tab, v) { value.append_in_place(tab, v); if unlikely(gc.needs_barrier(tab as *u8)) { cold { value.log_table(tab); } } next }
        }
        if let (T(tab), S(s)) = (t, key) and value.hash_set_existing_nobar(tab, key, s.hash, v) { if unlikely(gc.needs_barrier(tab as *u8)) { cold { value.log_table(tab); } } next }
        // Calls only in cold blocks (here and the barriers'): a call would
        // give the whole handler a stack frame.
        cold {
            if let T(tab) = t {
                if key == V.Nil { raise error_msg(ctx, "table index is nil") }
                if let Num(x) = key and x != x { raise error_msg(ctx, "table index is NaN") }
                if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                value.table_set(&ctx.heap, tab, key, v);
                next
            }
            raise error(ctx, "attempt to index a ", t)
        }
    }
    /// t[key] = k[c] (a constant value).
    op SETINDEXK(t: reg, key: reg, v: kst) : ABC {
        if let (T(tab), Int(_)) = (t, key) {
            let u = value.int_index(key);
            if u < tab.asize { tab.aptr[u] = v; if unlikely(gc.needs_barrier(tab as *u8)) { cold { value.log_table(tab); } } next }
            if u == tab.asize and value.can_append(tab, v) { value.append_in_place(tab, v); if unlikely(gc.needs_barrier(tab as *u8)) { cold { value.log_table(tab); } } next }
        }
        cold {
            if let T(tab) = t {
                if key == V.Nil { raise error_msg(ctx, "table index is nil") }
                if let Num(x) = key and x != x { raise error_msg(ctx, "table index is NaN") }
                if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                value.table_set(&ctx.heap, tab, key, v);
                next
            }
            raise error(ctx, "attempt to index a ", t)
        }
    }
    /// R[dst] = t[i] for an integer constant 1 <= i <= 255.
    op GETINDEXI(dst: reg, t: reg, i: index1) : ABC {
        if let T(tab) = t {
            let u = (i as u64) - 1;
            if u < tab.asize { dst = tab.aptr[u]; next }
            cold { dst = value.table_get(tab, Int(i as i32)); next }
        }
        raise error(ctx, "attempt to index a ", t)
    }
    /// Method lookup: R[a+1] = obj; R[a] = obj[key].
    op SELF(a: selfbase, obj: reg, key: kst) : ABC + FieldIC {
        let o = obj;
        if let T(tab) = o {
            regs[a + 1] = o;
            let i = cache.slot as u64;
            if likely(i < tab.hcap) {
                let p = tab.hptr + 2 * i;
                if p[0] == key { regs[a] = p[1]; next }
            }
            cold { regs[a] = field_get_slow(tab, key, &cache.slot); next }
        }
        raise error(ctx, "attempt to index a ", o)
    }

    // Arithmetic: one declaration, six families (register and constant
    // second operands). The generic member tests (Int, Int) first; the
    // first time a site sees two floats it becomes the _F member, which
    // tests (Num, Num) first. Both members handle every type, so a site
    // never switches back.
    inline for (name, fname, ifname, finame, checked, sym, code, bkind, bbase) in [
        ("ADD", "ADD_F", "ADD_IF", "ADD_FI", "add_checked", +, 0, reg, regs),
        ("SUB", "SUB_F", "SUB_IF", "SUB_FI", "sub_checked", -, 1, reg, regs),
        ("MUL", "MUL_F", "MUL_IF", "MUL_FI", "mul_checked", *, 2, reg, regs),
        ("ADDK", "ADDK_F", "ADDK_IF", "ADDK_FI", "add_checked", +, 0, kst, k),
        ("SUBK", "SUBK_F", "SUBK_IF", "SUBK_FI", "sub_checked", -, 1, kst, k),
        ("MULK", "MULK_F", "MULK_IF", "MULK_FI", "mul_checked", *, 2, kst, k),
    ] {
        family #name(dst: reg, a: reg, b: bkind) : ABC {
            generic {
                match (a, b) {
                    (Int(x), Int(y)) => if let Some(r) = x.#checked(y) { dst = Int(r); next },
                    (Num(x), Num(y)) => cold { dst = Num(x sym y); become #fname; refuse(fp.cl); next },
                    _ => {}
                }
                cold {
                    match (a, b) {
                        (Int(x), Num(y)) => { dst = Num(x as f64 sym y); become #ifname; refuse(fp.cl); next }
                        (Num(x), Int(y)) => { dst = Num(x sym y as f64); become #finame; refuse(fp.cl); next }
                        _ => {}
                    }
                    dst = arith_slow(ctx, code, a, b)?;
                    next
                }
            }
            #fname {
                // Two floats: a tagged word is a NaN as a double, so a
                // non-NaN result means both operands were numbers.
                let r = f64.from_bits(a as u64) sym f64.from_bits(b as u64);
                if likely(r == r) { dst = r.to_bits() as V; next }
                match (a, b) {
                    (Num(x), Num(y)) => { dst = Num(x sym y); next }
                    (Int(x), Int(y)) => if let Some(r) = x.#checked(y) { dst = Int(r); next },
                    (Int(x), Num(y)) => { dst = Num(x as f64 sym y); next }
                    (Num(x), Int(y)) => { dst = Num(x sym y as f64); next }
                    _ => {}
                }
                cold { dst = arith_mixed(ctx, code, a, b)?; next }
            }
            // Mixed operands, seen first: only that case is fast, and
            // anything else makes the site float-first.
            #ifname {
                if let Int(x) = a {
                    let r = x as f64 sym f64.from_bits(b as u64);
                    if likely(r == r) { dst = r.to_bits() as V; next }
                }
                become #fname; refuse(fp.cl); redo
            }
            #finame {
                if let Int(y) = b {
                    let r = f64.from_bits(a as u64) sym y as f64;
                    if likely(r == r) { dst = r.to_bits() as V; next }
                }
                become #fname; refuse(fp.cl); redo
            }
        }
    }
    /// R[dst] = R[a] + sc (a small signed constant).
    op ADDI(dst: reg, a: reg, sc: simm) : ABsC {
        if let Int(x) = a and let Some(r) = x.add_checked(sc as i32) { dst = Int(r); next }
        cold { dst = arith_slow(ctx, 0, a, Int(sc as i32))?; next }
    }
    // `x % k` for a constant k divides by multiplying (Granlund and
    // Montgomery): the site caches m and s (`mod_magic`) with
    // floor(x / k) = (x * m) >> s for 0 <= x < 2^31. idiv takes about 26
    // cycles, the multiply 3. Zero until the site first runs with an Int
    // constant k > 0.
    cache ModIC { magic: u64 }

    op MODK(dst: reg, a: reg, b: kst) : ABC + ModIC {
        if let (Int(x), Int(y)) = (a, b) and x >= 0 and cache.magic != 0 {
            let mg = cache.magic;
            let q = ((x as u64) * (mg & MAGIC_M)) >> (mg >> 56);
            dst = Int(((x as u64) - q * (y as u64)) as i32);
            next
        }
        if let (Int(x), Int(y)) = (a, b) and y > 0 {
            if cache.magic == 0 { cache.magic = mod_magic(y); }
            let r = x % y;
            dst = Int(if r < 0 { r + y } else { r });
            next
        }
        cold { dst = arith_slow(ctx, 4, a, b)?; next }
    }
    inline for (dname, bkind) in [("DIV", reg), ("DIVK", kst)] {
        op #dname(dst: reg, a: reg, b: bkind) : ABC {
            let r = f64.from_bits(a as u64) / f64.from_bits(b as u64);
            if likely(r == r) { dst = r.to_bits() as V; next }
            match (a, b) {
                (Num(x), Num(y)) => { dst = Num(x / y); next }
                (Int(x), Int(y)) => { dst = Num(x as f64 / y as f64); next }
                (Int(x), Num(y)) => { dst = Num(x as f64 / y); next }
                (Num(x), Int(y)) => { dst = Num(x / y as f64); next }
                _ => {}
            }
            cold { dst = arith_slow(ctx, 3, a, b)?; next }
        }
    }
    // The same for a divisor in a register, keyed by the divisor seen
    // first. A site that sees a second divisor gives up (d = MOD_MANY,
    // never an Int > 0): recomputing m costs a 64-bit division.
    cache ModRIC { d: u32, magic: u64 }

    op MOD(dst: reg, a: reg, b: reg) : ABC + ModRIC {
        if let (Int(x), Int(y)) = (a, b) and x >= 0 and y > 0 and (y as u32) == cache.d {
            let mg = cache.magic;
            let q = ((x as u64) * (mg & MAGIC_M)) >> (mg >> 56);
            dst = Int(((x as u64) - q * (y as u64)) as i32);
            next
        }
        if let (Int(x), Int(y)) = (a, b) and y > 0 {
            if cache.d == 0 {
                cache.d = y as u32;
                cache.magic = mod_magic(y);
            } else if cache.d != y as u32 {
                cache.d = MOD_MANY;
            }
            let r = x % y;
            dst = Int(if r < 0 { r + y } else { r });
            next
        }
        cold { dst = arith_slow(ctx, 4, a, b)?; next }
    }
    /// R[dst] = k[b] - R[a] and k[b] / R[a] (a constant left operand).
    op RSUBK(dst: reg, a: reg, b: kst) : ABC {
        if let (Int(x), Int(y)) = (b, a) and let Some(r) = x.sub_checked(y) { dst = Int(r); next }
        let r = f64.from_bits(b as u64) - f64.from_bits(a as u64);
        if likely(r == r) { dst = r.to_bits() as V; next }
        cold { dst = arith_mixed(ctx, 1, b, a)?; next }
    }
    op RDIVK(dst: reg, a: reg, b: kst) : ABC {
        let r = f64.from_bits(b as u64) / f64.from_bits(a as u64);
        if likely(r == r) { dst = r.to_bits() as V; next }
        cold { dst = arith_slow(ctx, 3, b, a)?; next }
    }
    op POW(dst: reg, a: reg, b: reg) : ABC {
        dst = arith_slow(ctx, 5, a, b)?;
        next
    }
    op NEG(dst: reg, a: reg) : ABC {
        match a {
            Int(x) => if x != -2147483648 { dst = Int(0 - x); next },
            Num(x) => { dst = Num(-x); next }
            _ => {}
        }
        cold { dst = arith_slow(ctx, 1, Int(0), a)?; next }
    }
    op NOT(dst: reg, a: reg) : ABC { dst = Bool(!value.truthy(a)); next }
    op LEN(dst: reg, a: reg) : ABC {
        if let T(t) = a {
            let n = t.asize;
            if n > 0 and t.aptr[n - 1] != V.Nil { dst = Int(n as i32); next }
        }
        dst = length(ctx, a)?;
        next
    }
    /// R[dst] = R[base] .. ... .. R[base + n - 1], as one string.
    #[poll(gc)] op CONCAT(dst: reg, base: callbase, n: catn) : ABC {
        dst = concat(ctx, regs + base, n as u64)?;
        next
    }

    // Comparisons, with a register or constant (K) second operand.
    // GT and GE exist only with K (for `k < x`, the compiler swaps).
    inline for (ename, lname, lename, bkind) in [("EQ", "LT", "LE", reg), ("EQK", "LTK", "LEK", kst)] {
        op #ename(dst: reg, a: reg, b: bkind) : ABC {
            if let (Int(x), Int(y)) = (a, b) { dst = Bool(x == y); next }
            // Same bits means equal, except for NaN.
            if a == b {
                if let Num(x) = a { dst = Bool(x == x); next }
                dst = Bool(true);
                next
            }
            // Different bits: equal only if both are numbers (1 == 1.0).
            if !value.is_number(a) or !value.is_number(b) { dst = Bool(false); next }
            cold { dst = Bool(value.raw_equal(a, b)); next }
        }
        op #lname(dst: reg, a: reg, b: bkind) : ABC {
            match (a, b) {
                (Int(x), Int(y)) => { dst = Bool(x < y); next }
                (Num(x), Num(y)) => { dst = Bool(x < y); next }
                _ => {}
            }
            cold { dst = Bool(less(ctx, a, b, false)?); next }
        }
        op #lename(dst: reg, a: reg, b: bkind) : ABC {
            match (a, b) {
                (Int(x), Int(y)) => { dst = Bool(x <= y); next }
                (Num(x), Num(y)) => { dst = Bool(x <= y); next }
                _ => {}
            }
            cold { dst = Bool(less(ctx, a, b, true)?); next }
        }
    }
    op GTK(dst: reg, a: reg, b: kst) : ABC {
        match (a, b) {
            (Int(x), Int(y)) => { dst = Bool(x > y); next }
            (Num(x), Num(y)) => { dst = Bool(x > y); next }
            _ => {}
        }
        cold { dst = Bool(less(ctx, b, a, false)?); next }
    }
    op GEK(dst: reg, a: reg, b: kst) : ABC {
        match (a, b) {
            (Int(x), Int(y)) => { dst = Bool(x >= y); next }
            (Num(x), Num(y)) => { dst = Bool(x >= y); next }
            _ => {}
        }
        cold { dst = Bool(less(ctx, b, a, true)?); next }
    }

    /// The end of a compare-and-branch: jump to the following JMP's
    /// target, or skip the JMP.
    fn branch(take: bool, target: *u32) -> never {
        if take { poll gil; jump target }
        jump pc + 2
    }

    // Compare and branch, for conditions: the next word is a JMP holding
    // the branch offset (so the verifier and the compiler's jump
    // patching treat it as a jump). Jump if the comparison holds (or,
    // for the N forms, if it does not); otherwise skip the JMP. The A
    // field is unused.
    inline for (name, nname, bkind, isub, fsub, slow) in [
        ("JLT", "JLTN", reg, x < y, x < y, less(ctx, a, b, false)),
        ("JLE", "JLEN", reg, x <= y, x <= y, less(ctx, a, b, true)),
        ("JLTK", "JLTKN", kst, x < y, x < y, less(ctx, a, b, false)),
        ("JLEK", "JLEKN", kst, x <= y, x <= y, less(ctx, a, b, true)),
        ("JGTK", "JGTKN", kst, x > y, x > y, less(ctx, b, a, false)),
        ("JGEK", "JGEKN", kst, x >= y, x >= y, less(ctx, b, a, true)),
    ] {
        inline for (opname, want) in [(name, true), (nname, false)] {
            op #opname(unused: imm, a: reg, b: bkind) : ABC then JMP {
                let (x, y) = ((a as u64) ^ value.int_bias(), (b as u64) ^ value.int_bias());
                if ((x | y) & V.Int.mask) == 0 { branch((isub) == want, then.target) }
                if let (Num(x), Num(y)) = (a, b) { branch((fsub) == want, then.target) }
                cold { branch(slow? == want, then.target) }
            }
        }
    }
    inline for (name, nname, bkind) in [("JEQ", "JEQN", reg), ("JEQK", "JEQKN", kst)] {
        inline for (opname, want) in [(name, true), (nname, false)] {
            op #opname(unused: imm, a: reg, b: bkind) : ABC then JMP {
                if let (Int(x), Int(y)) = (a, b) { branch((x == y) == want, then.target) }
                // Same bits means equal, except for NaN; strings are interned.
                if a == b {
                    var eq = true;
                    if let Num(x) = a { eq = x == x; }
                    branch(eq == want, then.target)
                }
                // Different bits: equal only if both are numbers (1 == 1.0).
                if !value.is_number(a) or !value.is_number(b) { branch(!want, then.target) }
                cold { branch(value.raw_equal(a, b) == want, then.target) }
            }
        }
    }

    /// A jump table (`if x == 1 then .. elseif x == 2 ..`, compile.lm
    /// `if_switch`; MiniJS's SWITCHI): followed by n + 1 JMPs. R[a] equal
    /// to lo + i (an Int, or a float of that value) for 0 <= i < n
    /// continues at JMP i, anything else at JMP n.
    op SWITCH(a: reg, lo: imm, n: ncases) : ABC {
        var i = n as u64;
        if let Int(x) = a {
            let d = (x as i64) - (lo as i64);
            if d >= 0 and d < (n as i64) { i = d as u64; }
        } else if let Num(f) = a and f >= (lo as f64) and f < ((lo + n) as f64) {
            let t = f as i64;
            if (t as f64) == f { i = (t - (lo as i64)) as u64; }
        }
        // To the JMP, not its target: the JIT (`--jit-stencils`) supports
        // jumps to a computed instruction, not into its operands.
        jump pc + 1 + i
    }

    #[poll(gil, pause)] op JMP(target: label) : sJ { jump target }
    /// Jump if falsy.
    op TEST(a: reg, target: label) : AsBx {
        if !value.truthy(a) { poll gil; jump target }
        next
    }
    /// Jump if truthy.
    op TESTT(a: reg, target: label) : AsBx {
        if value.truthy(a) { poll gil; jump target }
        next
    }

    /// The iterations after the first of an integer loop from `i` to `l`
    /// by `s` (one that runs, with s != 0). It can exceed the integer
    /// range, so it is stored as an Int whose payload bits are unsigned.
    fn for_count(i: i64, l: i64, s: i64) -> V {
        let n = if s == 1 { (l - i) as u64 }
            else if s > 0 { ((l - i) as u64) / (s as u64) }
            else { ((i - l) as u64) / ((0 - s) as u64) };
        V.Int(n as i32)
    }

    /// Numeric for: R[a] index, R[a+1] limit, R[a+2] step, R[a+3] the
    /// loop variable. For an integer loop, FORPREP replaces the limit
    /// with the iteration count.
    op FORPREP(a: forbase, target: label) : AsBx {
        match (regs[a], regs[a + 1], regs[a + 2]) {
            (Int(i), Int(l), Int(s)) => {
                if s == 0 { raise error_msg(ctx, "'for' step is zero") }
                if (s > 0 and i > l) or (s < 0 and i < l) { jump target }
                regs[a + 1] = for_count(i as i64, l as i64, s as i64);
                regs[a + 3] = Int(i);
                next
            }
            _ => {}
        }
        cold {
            let (Some(i), Some(l), Some(s)) = (value.to_num(regs[a]), value.to_num(regs[a + 1]), value.to_num(regs[a + 2])) else {
                raise error_msg(ctx, "'for' values must be numbers")
            };
            // Integer start and step: an integer loop, with the float
            // limit floored (or ceiled for a negative step) and clamped.
            if let (Int(ii), Int(si)) = (regs[a], regs[a + 2]) {
                if si == 0 { raise error_msg(ctx, "'for' step is zero") }
                let lf = if si > 0 { l.floor() } else { -((-l).floor()) };
                if l != l or (si > 0 and lf < ii as f64) or (si < 0 and lf > ii as f64) { jump target }
                let li: i32 = if lf > 2147483647.0 { 2147483647 } else if lf < -2147483648.0 { -2147483647 - 1 } else { lf as i32 };
                regs[a + 1] = for_count(ii as i64, li as i64, si as i64);
                regs[a + 3] = Int(ii);
                next
            }
            if s == 0.0 { raise error_msg(ctx, "'for' step is zero") }
            regs[a] = Num(i);
            regs[a + 1] = Num(l);
            regs[a + 2] = Num(s);
            if (s > 0.0 and i > l) or (s < 0.0 and i < l) { jump target }
            regs[a + 3] = Num(i);
            next
        }
    }
    /// An integer loop counts down the iterations left in R[a+1] (as in
    /// Lua 5.4), so stepping needs no overflow or direction checks.
    op FORLOOP(a: forbase, target: label) : AsBx {
        if let Int(c) = regs[a + 1] {
            if c != 0 {
                // The payload is not zero, so decrementing the word
                // decrements it.
                regs[a + 1] = ((regs[a + 1] as u64) - 1) as V;
                let Int(i) = regs[a] else { unreachable };
                let Int(s) = regs[a + 2] else { unreachable };
                let n = V.Int(i +% s);
                regs[a] = n;
                regs[a + 3] = n;
                poll gil; poll pause; jump target
            }
            next
        }
        match (regs[a], regs[a + 1], regs[a + 2]) {
            (Num(i), Num(l), Num(s)) => {
                let n = i + s;
                if (s > 0.0 and n <= l) or (s < 0.0 and n >= l) {
                    regs[a] = Num(n);
                    regs[a + 3] = Num(n);
                    poll gil; poll pause; jump target
                }
                next
            }
            _ => next,
        }
    }

    /// pairs loop: R[a] table, R[a+1] traversal position, R[a+2], R[a+3]
    /// key and value. Jumps to the body while there is a next entry.
    op NEXT(a: forbase, target: label) : AsBx {
        if let (T(t), Int(i)) = (regs[a], regs[a + 1]) {
            let n = value.table_iter(t, i as u64, regs + a + 2);
            if n != 0 {
                regs[a + 1] = Int(n as i32);
                poll gil; poll pause; jump target
            }
            next
        }
        raise iter_error(ctx, regs[a])
    }
    /// ipairs loop: R[a] table, R[a+1] last index, R[a+2], R[a+3] index and value.
    op INEXT(a: forbase, target: label) : AsBx {
        if let (T(t), Int(i)) = (regs[a], regs[a + 1]) {
            let u = i as u64;
            let v = if u < t.asize { t.aptr[u] } else { value.table_get(t, Int(i + 1)) };
            if v == V.Nil { next }
            regs[a + 1] = Int(i + 1);
            regs[a + 2] = Int(i + 1);
            regs[a + 3] = v;
            poll gil; poll pause; jump target
        }
        raise iter_error(ctx, regs[a])
    }

    /// R[base .. base+nres-1] = R[base](R[base+1] .. R[base+nargs]).
    /// nres is at least 1.
    op CALL(base: callbase, nargs: nargs, nres: nres) : ABC {
        let f = regs[base];
        if let F(cl) = f {
            // No GC check: entering a function allocates nothing.
            let p = cl.proto;
            let callee = regs + base + 1;
            let n = p.nregs as u64;
            if callee + n > ctx.stack_end or fp + 1 >= ctx.frames_end {
                // A coroutine's stacks grow; the main stack does not.
                cold {
                    fp = grow(ctx, fp, callee + n)?;
                    regs = fp.base;
                    redo
                }
            }
            var i = nargs as u64;
            while i < n {
                callee[i] = Nil;
                i += 1;
            }
            fp.resume = pc + 1;
            fp = fp + 1;
            fp.cl = cl;
            fp.base = callee;
            fp.nres = nres as u32;
            k = p.consts.data.ptr;
            fp.k = k;
            regs = callee;
            poll gil; poll pause; jump p.code
        }
        if let Native(id) = f {
            cold {
                // coroutine.resume and coroutine.yield switch threads in
                // this run when they can; the native reports the rest.
                if id == coro.RESUME and nargs != 0 and let Co(co) = regs[base + 1] and !coro.is_wrap(co) and coro.can_switch(ctx, co) {
                    switch_in(co, regs + base + 2, nargs as u64 - 1, base as u64, nres as u64, false)
                }
                if id == coro.YIELD and ctx.cur.inrun and ctx.base == ctx.frames {
                    switch_out(regs + base + 1, nargs as u64, base as u64, nres as u64)
                }
                // math.sqrt and math.floor of a number, for one result,
                // without the native call (nbody, sort).
                if nres == 1 and nargs != 0 {
                    let x = regs[base + 1];
                    if id == lib.M_SQRT and let Num(d) = x { regs[base] = Num(d.sqrt()); next }
                    if id == lib.M_FLOOR {
                        if let Int(_) = x { regs[base] = x; next }
                        // Truncate and adjust (libm's floor is a call).
                        if let Num(d) = x and d >= -2147483648.0 and d < 2147483648.0 {
                            let t = d as i32;
                            regs[base] = Int(if (t as f64) > d { t - 1 } else { t });
                            next
                        }
                    }
                }
                if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                let v = call_native(ctx, id, regs + base + 1, nargs as u64, true)?;
                // coroutine.yield: its values are this CALL's arguments.
                if ctx.yielded { ctx.xfer = regs + base + 1; yield_exit(base as u64, nres as u64) }
                native_results(base as u64, nres as u64, v)
            }
        }
        if let Co(w) = f and let Some(co) = w.wrap {
            cold {
                if coro.can_switch(ctx, co) { switch_in(co, regs + base + 1, nargs as u64, base as u64, nres as u64, true) }
                if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                let v = coro.resume(ctx, co, regs + base + 1, nargs as u64, true)?;
                if ctx.yielded { yield_exit(base as u64, nres as u64) }
                native_results(base as u64, nres as u64, v)
            }
        }
        raise error(ctx, "attempt to call a ", f)
    }
    /// After a native returned `v` to CALL: store its results in
    /// R[base .. base+nres-1].
    fn native_results(base: u64, nres: u64, v: V) -> never {
        let m = ctx.nret;
        if m == NRET_ONE {
            regs[base] = v;
            var i: u64 = 1;
            while i < nres {
                regs[base + i] = Nil;
                i += 1;
            }
            next
        }
        ctx.nret = NRET_ONE;
        for i in 0..nres {
            regs[base + i] = if i < m { ctx.rbuf[i] } else { Nil };
        }
        next
    }
    /// A CALL resumes `co` (`coro.can_switch`) in this run: save this
    /// thread's state, with where the CALL's `nres` results go (R[dst..])
    /// and where it continues (the next instruction, as a resume point),
    /// install the coroutine's and continue it: after its yield's CALL,
    /// with `args[0..n]` as that CALL's results, or at the start of its
    /// body with them as arguments. `wrap`: through its wrap function.
    #[inline]
    fn switch_in(co: Gc<Coro>, args: *V, n: u64, dst: u64, nres: u64, wrap: bool) -> never {
        ctx.fp = fp;
        let me = ctx.cur;
        me.ypc = next_resume;
        me.ydst = dst as u32;
        me.ynres = nres as u32;
        ctx.nco += 1;
        if co.started {
            coro.enter(ctx, co, true, wrap);
            fp = co.fp;
            regs = fp.base;
            k = fp.k;
            ctx.fp = fp;
            let d = regs + co.ydst as u64;
            for i in 0..co.ynres as u64 { d[i] = if i < n { args[i] } else { Nil }; }
            jump co.ypc.pc()
        }
        let F(cl) = co.body else { unreachable };
        coro.prepare(ctx, co, cl);
        coro.enter(ctx, co, true, wrap);
        co.started = true;
        let p = cl.proto;
        fp = ctx.frames;
        fp.cl = cl;
        fp.base = ctx.stack;
        fp.nres = 1;
        k = p.consts.data.ptr;
        fp.k = k;
        regs = ctx.stack;
        for i in 0..p.nregs as u64 { regs[i] = if i < n { args[i] } else { Nil }; }
        ctx.fp = fp;
        jump p.code
    }
    /// A CALL of coroutine.yield in a coroutine resumed in this run, with
    /// `vals[0..n]` to pass: suspend it (its CALL's `nres` results will go
    /// to R[dst..]) and continue its resumer.
    #[inline]
    fn switch_out(vals: *V, n: u64, dst: u64, nres: u64) -> never {
        let co = ctx.cur;
        coro.suspend(ctx, co, fp, next_resume, dst as u32, nres as u32);
        back(co, Bool(true), !co.via_wrap, vals, n, false)
    }
    /// The bottom frame of a coroutine resumed in this run returns
    /// `vals[0..n]` (its open upvalues are closed): it dies, and its
    /// resumer continues.
    #[inline(never)]
    fn finish(vals: *V, n: u64) -> never {
        let co = ctx.cur;
        back(co, Bool(true), !co.via_wrap, vals, n, true)
    }
    /// Continue the thread that resumed `co` (whose state is saved, or
    /// which is `dead`) in this run: its CALL gets `first` (if `lead`)
    /// and `vals[0..n]`, which may be in `co`'s stack.
    #[inline]
    fn back(co: Gc<Coro>, first: V, lead: bool, vals: *V, n: u64, dead: bool) -> never {
        ctx.nco -= 1;
        let r = coro.leave(ctx, co);
        fp = r.fp;
        regs = fp.base;
        k = fp.k;
        let d = regs + r.ydst as u64;
        let want = r.ynres as u64;
        var i: u64 = 0;
        if lead {
            d[0] = first;
            i = 1;
        }
        let src = vals - i;
        while i < want {
            d[i] = if i < n + (lead as u64) { src[i] } else { Nil };
            i += 1;
        }
        if dead { coro.die(co); }
        jump r.ypc.pc()
    }
    /// After a CALL of coroutine.yield in a coroutine resumed by a native
    /// (`coro.resume`): leave the run (`coro.resume` picks up the state),
    /// saving where the CALL's `nres` results go and where to continue:
    /// the next instruction, as a resume point, which `Mini.resume` may
    /// jump to.
    fn yield_exit(base: u64, nres: u64) -> never {
        ctx.nret = NRET_ONE;
        ctx.ypc = next_resume;
        ctx.ydst = base as u32;
        ctx.ynres = nres as u32;
        ctx.fp = fp;
        exit Ok(Nil)
    }
    /// Return one value.
    op RET1(src: reg) : ABC {
        let v = src;
        if unlikely(ctx.open_level >= regs) { cold { close_upvals(ctx, regs); redo } }
        if fp == ctx.base {
            if ctx.cur.inrun and fp == ctx.frames { regs[0] = v; finish(regs, 1) }
            ctx.nxfer = 1;
            exit Ok(v)
        }
        *(regs - 1) = v;
        let want = fp.nres as u64;
        if unlikely(want > 1) {
            cold {
                for i in 0..want - 1 { regs[i] = Nil; }
                fp = fp - 1;
                regs = fp.base;
                k = fp.k;
                jump fp.resume
            }
        }
        fp = fp - 1;
        regs = fp.base;
        k = fp.k;
        jump fp.resume
    }
    /// Return R[a .. a+n-1], adjusted to the number of results wanted.
    op RETN(a: reg, n: retn) : ABC {
        if unlikely(ctx.open_level >= regs) { cold { close_upvals(ctx, regs); redo } }
        if fp == ctx.base {
            if ctx.cur.inrun and fp == ctx.frames { finish(regs + a.raw as u64, n as u64) }
            ctx.xfer = regs + a.raw as u64;
            ctx.nxfer = n as u64;
            exit Ok(a)
        }
        let want = fp.nres as u64;
        let src = regs + a.raw as u64;
        let dst = regs - 1;
        for i in 0..want {
            dst[i] = if i < n as u64 { src[i] } else { Nil };
        }
        fp = fp - 1;
        regs = fp.base;
        k = fp.k;
        jump fp.resume
    }
    op RET0() : ABC {
        if unlikely(ctx.open_level >= regs) { cold { close_upvals(ctx, regs); redo } }
        if fp == ctx.base {
            if ctx.cur.inrun and fp == ctx.frames { finish(regs, 0) }
            ctx.nxfer = 0;
            exit Ok(Nil)
        }
        let want = fp.nres as u64;
        let dst = regs - 1;
        for i in 0..want { dst[i] = Nil; }
        fp = fp - 1;
        regs = fp.base;
        k = fp.k;
        jump fp.resume
    }

    // Suggested by `loimi build --vm-stats` on recursive code.
    // All `#[forward]`: where a part reads the register the previous part
    // wrote, `optimize` picks a variant that keeps the value in a machine
    // register (no run-time test; it costs opcodes and code size).
    #[forward] super LOADI_SUB = LOADI; SUB;
    #[forward] super ADD_RET1 = ADD; RET1;
    #[forward] super MUL_F_ADD_F = MUL_F; ADD_F;
    // Overlaps another super, but runs where no ADD_F follows: 2.8% of nbody's ops.
    #[allow(super_overlap)]
    #[forward] super MUL_F_MUL_F = MUL_F; MUL_F;
    // Overlaps another super, but runs outside MUL_F; ADD_F: 15% of mandelbrot's ops, 2.8% of nbody's.
    #[allow(super_overlap)]
    #[forward] super ADD_F_MUL_F = ADD_F; MUL_F;
    // Overlaps another super, but runs outside MUL_F; MUL_F: 8.3% of nbody's ops.
    #[allow(super_overlap)]
    #[forward] super MUL_F_SUB_F = MUL_F; SUB_F;
    // Overlaps another super, but runs outside MUL_F; ADD_F: 15% of mandelbrot's ops.
    #[allow(super_overlap)]
    #[forward] super ADD_F_SUB_F = ADD_F; SUB_F;
    // Overlaps another super, but runs outside the MUL_F pairs: 15% of mandelbrot's ops.
    #[allow(super_overlap)]
    #[forward] super MULK_F_MUL_F = MULK_F; MUL_F;
    // Overlaps another super, but runs outside the MUL_F pairs: 11% of nbody's ops.
    #[allow(super_overlap)]
    #[forward] super GETFIELD_MUL_F = GETFIELD; MUL_F;
    #[forward] super GETFIELD_SUB_F = GETFIELD; SUB_F;
    // Overlaps another super, but runs outside MUL_F; ADD_F: 8.3% of nbody's ops.
    #[allow(super_overlap)]
    #[forward] super ADD_F_SETFIELD = ADD_F; SETFIELD;
    #[forward] super MOVE_CALL = MOVE; CALL;
    // Overlaps another super, but runs outside MOVE; CALL: 2% of closures' ops.
    #[allow(super_overlap)]
    #[forward] super MOVE_MOVE = MOVE; MOVE;
    // Overlaps another super, but runs outside MOVE; MOVE: 6% of string_build's ops.
    #[allow(super_overlap)]
    #[forward] super MOVE_MOVE_CALL = MOVE; MOVE; CALL;
    #[forward] super GETINDEX_GETINDEX = GETINDEX; GETINDEX;
    // Overlaps another super, but runs outside GETINDEX; GETINDEX: 14% of queens' and sort's ops.
    #[allow(super_overlap)]
    #[forward] super GETUPVAL_GETINDEX = GETUPVAL; GETINDEX;
    // Overlaps GETUPVAL; GETINDEX: `if not up[i]` in queens (14% of its ops).
    #[allow(super_overlap)]
    #[forward] super GETUPVAL_GETINDEX_TESTT = GETUPVAL; GETINDEX; TESTT;
    // Overlap GETINDEX; GETINDEX and GETINDEX; ADDI: a lookup tested at
    // once and a count stored back (`local c = t[k]; if c then t[k] = c + 1`),
    // 15% of hash_strings' ops each.
    #[allow(super_overlap)]
    #[forward] super GETINDEX_GETINDEX_TEST = GETINDEX; GETINDEX; TEST;
    #[allow(super_overlap)]
    #[forward] super ADDI_SETINDEX = ADDI; SETINDEX;
    // `f(n - 1)` for a function in an upvalue: fib 40%, coroutine_ring 17%.
    #[allow(super_overlap)]
    #[forward] super GETUPVAL_ADDI_CALL = GETUPVAL; ADDI; CALL;
    // Overlaps another super, but runs outside the MOVE supers: 8% of binary_trees' and spectral_norm's ops.
    #[allow(super_overlap)]
    #[forward] super GETUPVAL_MOVE = GETUPVAL; MOVE;
    // Overlaps ADDI; SETINDEX, which runs where no second ADDI precedes.
    #[allow(super_overlap)]
    #[forward] super ADDI_ADDI = ADDI; ADDI;
    #[forward] super GETUPVAL_JEQN = GETUPVAL; JEQN;
    // Overlaps another super, but runs outside GETINDEX; GETINDEX: 2.3% of interp's ops.
    #[allow(super_overlap)]
    #[forward] super GETINDEX_ADDI = GETINDEX; ADDI;

    /// A top-level run of `cl` from the bottom of the stack (the
    /// standalone interpreter).
    entry run(c: *Ctx, cl: Gc<Closure>) -> Result<V, V> uses gc {
        ctx = c;
        let p = cl.proto;
        fp = c.frames;
        c.base = fp;
        fp.cl = cl;
        fp.base = c.stack;
        fp.nres = 1;
        fp.k = p.consts.data.ptr;
        regs = c.stack;
        for i in 0..p.nregs as u64 { regs[i] = V.Nil; }
        k = p.consts.data.ptr;
        c.fp = fp;
        jump p.code
    }

    /// A run of `cl` in frame `at`, whose window `call_value` filled with
    /// the arguments: `at` becomes the run's bottom frame.
    entry call(c: *Ctx, at: *Frame, cl: Gc<Closure>) -> Result<V, V> uses reenter {
        ctx = c;
        let p = cl.proto;
        fp = at;
        fp.cl = cl;
        fp.nres = 1;
        k = p.consts.data.ptr;
        fp.k = k;
        regs = fp.base;
        c.base = fp;
        c.fp = fp;
        #[cfg(debug)] if debugger.stepping(c) { use_variant step; } jump p.code
    }

    /// Continue a coroutine suspended in coroutine.yield (coro.resume has
    /// installed its stacks): `vals[0..n]` are the yield's results.
    entry resume(c: *Ctx, vals: *V, n: u64) -> Result<V, V> uses reenter {
        ctx = c;
        fp = c.fp;
        regs = fp.base;
        k = fp.k;
        let dst = regs + c.ydst as u64;
        for i in 0..c.ynres as u64 { dst[i] = if i < n { vals[i] } else { V.Nil }; }
        // The instruction after the yield's CALL: a resume point, which
        // only vm code makes (`next_resume`), so `#[require_verified]`
        // lets the entry jump to it.
        #[cfg(debug)] if debugger.stepping(c) { use_variant step; } jump c.ypc
    }

    on raise(e: V) {
        ctx.fp = fp;
        var err = e;
        if e != V.Nil and e == ctx.rethrow {
            // An error from a nested run already has its line.
            ctx.rethrow = Nil;
        } else {
            err = at_line(ctx, fp.cl.proto, pc, e); #[cfg(debug)] debugger.on_error(ctx, pc, fp, err); // --cfg debug: break on error, before unwinding
        }
        // A coroutine resumed in this run dies of it, and its resumer
        // continues: with false and the error, or through a wrap
        // function, raising it at the CALL (with that line too).
        loop {
            let co = ctx.cur;
            if !co.inrun or ctx.base != ctx.frames { exit Err(err) }
            close_upvals(ctx, ctx.stack);
            if !co.via_wrap {
                co.err = err;
                back(co, Bool(false), true, &co.err, 1, true)
            }
            ctx.nco -= 1;
            let r = coro.leave(ctx, co);
            coro.die(co);
            fp = r.fp;
            regs = fp.base;
            k = fp.k;
            err = at_line(ctx, fp.cl.proto, r.ypc.pc() - 1, err);
        }
    }

    // `--cfg debug` (debugger.lm): a breakpoint stops, then puts its
    // instruction back and runs it under `step`, whose wrapper sets the
    // breakpoint again before the next instruction and stops there if a
    // stepping command says so (and turns itself off when neither waits).
    // `#[unfused]`: under `step`, supers run as their parts, so that the
    // first instruction of every line is seen. A run that starts or
    // continues while stepping (`call`, `resume`, after a native in
    // `reload`) turns `step` on; `sync` saves where a frame calling a
    // native is (`fp.resume`, unused otherwise) for backtraces.
    // (These additions sit on existing lines, or here at the end, so that
    // a build without `--cfg debug` keeps its source positions.)
    #[cfg(debug)]
    on break {
        debugger.on_break(ctx, pc, fp);
        use_variant step;
        jump pc
    }
    #[cfg(debug)]
    #[unfused]
    variant step wraps all {
        before {
            if !debugger.on_step(ctx, pc, fp) { use_variant default; }
        }
    }
}
