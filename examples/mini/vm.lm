// The Mini virtual machine: a register machine in the style of Lua 5.

import std.gc;
import std.text;
import value;
import lib;
import value.{V, Str, Arr, Table, Proto, Closure, UpVal};

extern "C" fn pow(a: f64, b: f64) -> f64;

/// One activation record. `resume` is where this frame continues after
/// the call it is making returns; `nres` is how many results this
/// frame's caller wants (at least 1). `k` caches cl.proto.consts.
pub struct Frame { cl: Gc<Closure>, base: *V, resume: *u32, k: *V, nres: u32 }

pub struct Ctx {
    heap: gc.Heap,
    stack: *V,
    stack_end: *V,
    frames: *Frame,
    frames_end: *Frame,
    fp: *Frame,
    /// The bottom frame of the innermost run: returning from it leaves
    /// the run (`exit`). Null while no Mini code runs.
    base: *Frame,
    globals: Gc<Table>,
    /// An error that came back from a nested run (`call_value`), which
    /// already says where it happened: `on raise` passes it on unchanged.
    rethrow: V,
    out: text.StrBuf,
    /// Open upvalues, sorted by stack level, highest first.
    open: ?Gc<UpVal>,
    /// Level of the first open upvalue (null when none), so that
    /// "anything to close at or above here?" is one compare.
    open_level: *V,
    /// Natives with ids from HOST_NATIVE up, which an embedder registers
    /// (embed.lm); `no_host` in the standalone interpreter. They may call
    /// back into Mini (`call_value`).
    host: fn(*Ctx, i32, *V, u64) -> Result<V, V> uses reenter,
}

pub const HOST_NATIVE: i32 = 1000;

pub fn no_host(c: *Ctx, id: i32, args: *V, n: u64) -> Result<V, V> {
    Err(error_msg(c, "unknown builtin"))
}

/// GC roots: globals, the error being passed on, open upvalues, and every
/// active frame's closure and registers (those of nested runs included:
/// they are frames above the native that started them).
pub fn scan_roots(h: *gc.Heap, data: *u8) {
    let c = data as *Ctx;
    gc_mark(h, c.globals);
    gc_mark(h, c.rethrow);
    if let Some(u) = c.open { gc_mark(h, u); }
    var f = c.frames;
    while f <= c.fp {
        gc_mark(h, f.cl);
        let n = f.cl.proto.nregs as u64;
        for i in 0..n { gc_mark(h, f.base[i]); }
        f = f + 1;
    }
}

/// The open upvalue for stack slot `level`, created if needed.
fn find_upval(c: *Ctx, level: *V) -> Gc<UpVal> {
    var prev: ?Gc<UpVal> = None;
    var cur = c.open;
    loop {
        let Some(u) = cur else { break; };
        if u.v < level { break; }
        if u.v == level { return u; }
        prev = cur;
        cur = u.next;
    }
    let nu = new(&c.heap, UpVal { v: level, closed: V.Nil, next: cur });
    match prev {
        Some(pu) => pu.next = Some(nu),
        None => {
            c.open = Some(nu);
            c.open_level = level;
        }
    }
    nu
}

/// Close every open upvalue at or above `level`.
pub fn close_upvals(c: *Ctx, level: *V) {
    loop {
        let Some(u) = c.open else { break; };
        if u.v < level { break; }
        u.closed = *u.v;
        u.v = &u.closed;
        c.open = u.next;
        u.next = None;
    }
    c.open_level = match c.open {
        Some(u) => u.v,
        None => 0 as *V,
    };
}

/// An error message mentioning the type of `v`: "<msg><type> value".
fn error(c: *Ctx, msg: str, v: V) -> V {
    var b = text.StrBuf.new();
    b.push_str(msg);
    b.push_str(value.type_name(v));
    b.push_str(" value");
    let s = value.new_str(&c.heap, b.as_str());
    b.free();
    V.S(s)
}

fn iter_error(c: *Ctx, v: V) -> V {
    var b = text.StrBuf.new();
    b.push_str("bad argument #1 to 'for iterator' (table expected, got ");
    b.push_str(value.type_name(v));
    b.push_str(")");
    let s = value.new_str(&c.heap, b.as_str());
    b.free();
    V.S(s)
}

fn error_msg(c: *Ctx, msg: str) -> V {
    V.S(value.new_str(&c.heap, msg))
}

/// Arithmetic outside the fast paths: op 0 add, 1 sub, 2 mul, 3 div,
/// 4 mod, 5 pow. Int results that overflow become floats.
fn arith_slow(c: *Ctx, op: i64, a: V, b: V) -> Result<V, V> {
    let Some(x) = value.to_num(a) else { return Err(error(c, "attempt to perform arithmetic on a ", a)); };
    let Some(y) = value.to_num(b) else { return Err(error(c, "attempt to perform arithmetic on a ", b)); };
    if let (Int(i), Int(j)) = (a, b) and op == 4 {
        if j == 0 { return Err(error_msg(c, "attempt to perform 'n%%0'")); }
        let (i, j) = (i as i64, j as i64);
        var r = i % j;
        if r != 0 and (r ^ j) < 0 { r += j; }
        return Ok(V.Int(r as i32));
    }
    let r = match op {
        0 => x + y,
        1 => x - y,
        2 => x * y,
        3 => x / y,
        4 => {
            if y == 0.0 {
                x - x / y * y
            } else {
                var m = x - (x / y).floor() * y;
                if m != 0.0 and (m < 0.0) != (y < 0.0) { m += y; }
                m
            }
        }
        _ => pow(x, y),
    };
    Ok(V.Num(r))
}

fn less(c: *Ctx, a: V, b: V, or_equal: bool) -> Result<bool, V> {
    match (a, b) {
        (S(x), S(y)) => {
            let n = if x.data.len < y.data.len { x.data.len } else { y.data.len };
            for i in 0..n {
                if x.data[i] != y.data[i] { return Ok(x.data[i] < y.data[i]); }
            }
            Ok(if or_equal { x.data.len <= y.data.len } else { x.data.len < y.data.len })
        }
        _ => {
            let (Some(x), Some(y)) = (value.to_num(a), value.to_num(b)) else {
                return Err(error(c, "attempt to compare a ", if value.to_num(a).is_none() { a } else { b }));
            };
            Ok(if or_equal { x <= y } else { x < y })
        }
    }
}

fn concatenable(v: V) -> bool {
    match v {
        S(_) | Int(_) | Num(_) => true,
        _ => false,
    }
}

/// vals[0] .. vals[1] .. ... .. vals[n-1] (n >= 2) as one new string.
/// Errors name the operand Lua would: it concatenates from the right,
/// so the last pair is checked first (its left operand if both are bad).
fn concat(c: *Ctx, vals: *V, n: u64) -> Result<V, V> {
    if !concatenable(vals[n - 2]) { return Err(error(c, "attempt to concatenate a ", vals[n - 2])); }
    if !concatenable(vals[n - 1]) { return Err(error(c, "attempt to concatenate a ", vals[n - 1])); }
    var i = n - 2;
    while i > 0 {
        i -= 1;
        if !concatenable(vals[i]) { return Err(error(c, "attempt to concatenate a ", vals[i])); }
    }
    c.out.clear();
    for j in 0..n { value.write_value(&c.out, vals[j]); }
    Ok(V.S(value.new_str(&c.heap, c.out.as_str())))
}

fn length(c: *Ctx, v: V) -> Result<V, V> {
    match v {
        S(s) => Ok(V.Int(s.data.len as i32)),
        T(t) => Ok(V.Int(value.table_len(t) as i32)),
        _ => Err(error(c, "attempt to get length of a ", v)),
    }
}

/// GETFIELD/SELF cache miss: look `key` up and remember its slot.
fn field_get_slow(t: Gc<Table>, key: V, slot: *u32) -> V {
    let Some(i) = value.table_find(t, key) else { return V.Nil; };
    *slot = i as u32;
    t.hptr[2 * i + 1]
}

/// SETFIELD cache miss: store, then remember the key's slot.
fn field_set_slow(h: *gc.Heap, t: Gc<Table>, key: V, v: V, slot: *u32) {
    value.table_set(h, t, key, v);
    if let Some(i) = value.table_find(t, key) { *slot = i as u32; }
}

/// Arithmetic outside the (Int, Int) and (Num, Num) fast paths: mixed
/// int/float operands first, then everything else.
fn arith_mixed(c: *Ctx, op: i64, a: V, b: V) -> Result<V, V> {
    if op <= 2 {
        let (x, y) = match (a, b) {
            (Int(i), Num(y)) => (i as f64, y),
            (Num(x), Int(j)) => (x, j as f64),
            _ => return arith_slow(c, op, a, b),
        };
        return Ok(V.Num(if op == 0 { x + y } else if op == 1 { x - y } else { x * y }));
    }
    arith_slow(c, op, a, b)
}

/// Fuse superinstructions in a function again after one of its sites
/// was quickened: fusion compares words by the op they stand for, so
/// specialized members (MUL_F; ADD_F) fuse too.
fn refuse(cl: Gc<Closure>) {
    Mini.optimize(cl.proto.code);
}

/// The single dispatch point for natives. Most allocate but never
/// collect; `table.sort` and host natives may call back into Mini.
fn call_native(c: *Ctx, id: i32, args: *V, n: u64) -> Result<V, V> uses reenter {
    if id >= HOST_NATIVE { return c.host(c, id, args, n); }
    if id == lib.T_SORT { return table_sort(c, args, n); }
    lib.call(&c.heap, id, args, n)
}

/// `table.sort(t [, comp])`: Lua's algorithm (lib.lm), comparing with
/// `comp` through a nested run, or with `<`.
fn table_sort(c: *Ctx, args: *V, n: u64) -> Result<V, V> uses reenter {
    let comp = if n > 1 { args[1] } else { V.Nil };
    lib.sort(&c.heap, args, n, |a, b| sort_less(c, comp, a, b))
}

fn sort_less(c: *Ctx, comp: V, a: V, b: V) -> Result<bool, V> uses reenter {
    if comp == V.Nil { return less(c, a, b, false); }
    var ab: [V; 2] = [a, b];
    let r = call_value(c, comp, &ab[0], 2)?;
    Ok(value.truthy(r))
}

/// Nested runs allowed at once on a thread (`Mini.depth`), as Lua's
/// LUAI_MAXCCALLS: each one is a few C frames.
pub const MAX_NESTING: u32 = 200;

/// Call `f` with `args[0..n]` from host code: a native (table.sort's
/// comparator) or the embedding API (`mini_call`). While Mini code runs,
/// this is a nested run on the same stack, above the frame that called
/// the native (`ctx.fp`, published by the handler's sync); otherwise a
/// run from the bottom of the stack. The callee's return ends the run.
/// An error comes back as Err, its message already prefixed with its
/// line; `on raise` passes it on as is when a native returns it.
pub fn call_value(c: *Ctx, f: V, args: *V, n: u64) -> Result<V, V> uses reenter {
    let cl = match f {
        F(cl) => cl,
        Native(id) => return call_native(c, id, args, n),
        _ => return Err(error(c, "attempt to call a ", f)),
    };
    if Mini.depth >= MAX_NESTING { return Err(error_msg(c, "C stack overflow")); }
    let saved_fp = c.fp;
    let saved_base = c.base;
    var at = c.frames;
    var base = c.stack;
    if saved_base != 0 as *Frame {
        at = c.fp + 1;
        base = c.fp.base + c.fp.cl.proto.nregs as u64;
    }
    let nregs = cl.proto.nregs as u64;
    if base + nregs > c.stack_end or at + 1 >= c.frames_end {
        return Err(error_msg(c, "stack overflow"));
    }
    // No collection until the run starts and `at` is a frame the
    // collector sees: the arguments are only in the new window.
    for i in 0..nregs { base[i] = if i < n { args[i] } else { V.Nil }; }
    at.base = base;
    let r = Mini.call(c, at, cl);
    c.fp = saved_fp;
    c.base = saved_base;
    if let Err(e) = r {
        // The run stopped mid-call: close what its frames left open.
        close_upvals(c, base);
        c.rethrow = e;
    }
    r
}

pub vm Mini {
    context ctx: *Ctx;
    state { pc: *u32, regs: *V, k: *V, fp: *Frame }

    // The generated verifier (Mini.verify) checks these against the prototype.
    verify_context proto: Gc<Proto>;
    operand reg = regs[it] verify (it as u32) < proto.nregs;
    operand kst = k[it] verify (it as u64) < proto.consts.data.len;
    operand imm = it;
    operand simm = it;
    operand callbase = it verify (it as u32) < proto.nregs;
    operand forbase = it verify (it as u32) + 3 < proto.nregs;
    operand upv = it verify (it as u32) < proto.nupvals;
    operand child = it verify (it as u64) < proto.protos.data.len;
    operand level = it verify (it as u32) <= proto.nregs;
    operand label = pc + it verify is_insn_boundary(pc + it);
    // Counts of registers from the A (or B) operand on. They decode to
    // the plain field; the verifier checks the range they cover against
    // the frame, reading the base from the instruction word (`*pc`).
    /// CALL's argument count: R[a+1 .. a+n] are in the frame.
    operand nargs = it verify Mini.ABC_a(*pc) + it < proto.nregs as u64;
    /// CALL's result count (at least 1): the callee's return writes
    /// R[a .. a+n-1].
    operand nres = it verify it >= 1 and Mini.ABC_a(*pc) + it <= proto.nregs as u64;
    /// SETLIST reads R[a+1 .. a+n].
    operand listn = it verify Mini.ABC_a(*pc) + it < proto.nregs as u64;
    /// RETN reads R[a .. a+n-1].
    operand retn = it verify Mini.ABC_a(*pc) + it <= proto.nregs as u64;
    /// CONCAT joins R[b .. b+n-1], at least two.
    operand catn = it verify it >= 2 and Mini.ABC_b(*pc) + it <= proto.nregs as u64;
    /// GETINDEXI's constant index, 1..255.
    operand index1 = it verify it >= 1;
    /// SELF writes R[a] and R[a+1].
    operand selfbase = it verify (it as u32) + 1 < proto.nregs;

    encoding fixed(u32) {
        format ABC { op: 8, a: 8, b: 8, c: 8 }
        format ABsC { op: 8, a: 8, b: 8, sc: s8 }
        format ABx { op: 8, a: 8, bx: 16 }
        format AsBx { op: 8, a: 8, sbx: s16 }
        format sJ { op: 8, sj: s24 }
    }

    // The collector walks frames up to ctx.fp, and a nested run starts
    // above it.
    sync { ctx.fp = fp; }
    // After a native that may have run Mini code (`uses reenter`). The
    // stack never moves and the nested run leaves `ctx.fp` as it was, so
    // this reloads the same values; it is what keeps that an invariant of
    // call_value rather than an assumption of every handler.
    reload {
        fp = ctx.fp;
        regs = fp.base;
        k = fp.k;
    }

    op LOADK(dst: reg, c: kst) : ABx { dst = c; next }
    op LOADI(dst: reg, v: imm) : AsBx { dst = Int(v as i32); next }
    op LOADNIL(dst: reg) : ABC { dst = Nil; next }
    op LOADBOOL(dst: reg, b: imm) : ABC { dst = Bool(b != 0); next }
    op MOVE(dst: reg, src: reg) : ABC { dst = src; next }

    // Global reads are quickened: the generic op finds the global's slot
    // in the globals table and caches its index inline; GETGLOBAL_C then
    // only checks that the key in that slot is still the same string.
    // (The compiler interns string constants, so identity works.)
    cache GlobalIC { slot: u32 }

    family GETGLOBAL(dst: reg, name: kst) : ABx + GlobalIC {
        generic {
            if let Some(i) = value.table_find(ctx.globals, name) {
                cache.slot = i as u32;
                dst = ctx.globals.hptr[2 * i + 1];
                become GETGLOBAL_C;
                next
            }
            dst = Nil;
            next
        }
        GETGLOBAL_C {
            let g = ctx.globals;
            let i = cache.slot as u64;
            if likely(i < g.hcap) {
                let slots = g.hptr;
                if slots[2 * i] == name {
                    dst = slots[2 * i + 1];
                    next
                }
            }
            cold { become GETGLOBAL; redo }
        }
    }
    op SETGLOBAL(src: reg, name: kst) : ABx {
        if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } }
        value.table_set(&ctx.heap, ctx.globals, name, src);
        next
    }

    op GETUPVAL(dst: reg, i: upv) : ABC { dst = *fp.cl.upvals.ptr[i].v; next }
    op SETUPVAL(src: reg, i: upv) : ABC {
        let u = fp.cl.upvals.ptr[i];
        *u.v = src;
        // A closed upvalue's `v` points at its own `closed` field.
        gc.write_barrier(&ctx.heap, u as *u8);
        next
    }
    /// R[dst] = a new closure of child prototype `i`, capturing upvalues
    /// as its descriptors say.
    op CLOSURE(dst: reg, i: child) : ABx {
        if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } }
        let parent = fp.cl;
        let p = parent.proto.protos.data.ptr[i];
        let n = p.nupvals as u64;
        let c = new(&ctx.heap, Closure { proto: p }, n);
        for j in 0..n {
            let d = p.updesc.data.ptr[j];
            if d >= 256 {
                c.upvals.ptr[j] = find_upval(ctx, regs + (d & 255) as u64);
            } else {
                c.upvals.ptr[j] = parent.upvals.ptr[d];
            }
        }
        dst = F(c);
        next
    }
    /// Close upvalues at or above R[a].
    op CLOSE(a: level) : ABC {
        if ctx.open_level >= regs + a { close_upvals(ctx, regs + a); }
        next
    }

    /// R[dst] = a table with room for `narr` array items and `nhash` fields.
    op NEWTABLE(dst: reg, narr: imm, nhash: imm) : ABC {
        if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } }
        dst = T(value.new_table_sized(&ctx.heap, narr as u64, nhash as u64));
        next
    }
    /// R[a][batch*50 + i] = R[a + i] for i in 1..n.
    op SETLIST(a: callbase, n: listn, batch: imm) : ABC {
        if let T(t) = regs[a] {
            if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } }
            value.table_setlist(&ctx.heap, t, regs + a + 1, n as u64, batch as u64 * 50);
        }
        next
    }
    // Field access with a constant string key caches the hash slot where
    // the key was last found. A hit only needs the slot to be in range
    // and to hold the same key (strings are interned, so that is one
    // compare). Shapes would let this skip the key check; tables built
    // the same way put a key in the same slot, which is what makes
    // record-style access hit.
    cache FieldIC { slot: u32 }

    op GETFIELD(dst: reg, t: reg, key: kst) : ABC + FieldIC {
        if let T(tab) = t {
            let i = cache.slot as u64;
            if likely(i < tab.hcap) {
                let p = tab.hptr + 2 * i;
                if p[0] == key { dst = p[1]; next }
            }
            cold { dst = field_get_slow(tab, key, &cache.slot); next }
        }
        cold { raise error(ctx, "attempt to index a ", t) }
    }
    op SETFIELD(t: reg, key: kst, v: reg) : ABC + FieldIC {
        if let T(tab) = t {
            let i = cache.slot as u64;
            if likely(i < tab.hcap) {
                let p = tab.hptr + 2 * i;
                if p[0] == key { p[1] = v; value.tbar(tab); next }
            }
            cold {
                if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                field_set_slow(&ctx.heap, tab, key, v, &cache.slot);
                next
            }
        }
        cold { raise error(ctx, "attempt to index a ", t) }
    }
    op GETINDEX(dst: reg, t: reg, key: reg) : ABC {
        if let (T(tab), Int(_)) = (t, key) {
            let u = value.int_index(key);
            if u < tab.asize { dst = tab.aptr[u]; next }
        }
        if let (T(tab), S(s)) = (t, key) { dst = value.hash_get_str(tab, key, s.hash); next }
        if let T(tab) = t { dst = value.table_get(tab, key); next }
        cold { raise error(ctx, "attempt to index a ", t) }
    }
    op SETINDEX(t: reg, key: reg, v: reg) : ABC {
        if let (T(tab), Int(_)) = (t, key) {
            let u = value.int_index(key);
            if u < tab.asize { tab.aptr[u] = v; value.tbar(tab); next }
        }
        if let (T(tab), S(s)) = (t, key) and value.hash_set_existing(tab, key, s.hash, v) { next }
        if let T(tab) = t {
            if key == V.Nil { cold { raise error_msg(ctx, "table index is nil") } }
            if let Num(x) = key and x != x { cold { raise error_msg(ctx, "table index is NaN") } }
            if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } }
            value.table_set(&ctx.heap, tab, key, v);
            next
        }
        cold { raise error(ctx, "attempt to index a ", t) }
    }
    /// t[key] = k[c] (a constant value).
    op SETINDEXK(t: reg, key: reg, v: kst) : ABC {
        if let (T(tab), Int(_)) = (t, key) {
            let u = value.int_index(key);
            if u < tab.asize { tab.aptr[u] = v; value.tbar(tab); next }
        }
        if let T(tab) = t {
            if key == V.Nil { cold { raise error_msg(ctx, "table index is nil") } }
            if let Num(x) = key and x != x { cold { raise error_msg(ctx, "table index is NaN") } }
            if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } }
            value.table_set(&ctx.heap, tab, key, v);
            next
        }
        cold { raise error(ctx, "attempt to index a ", t) }
    }
    /// R[dst] = t[i] for an integer constant 1 <= i <= 255.
    op GETINDEXI(dst: reg, t: reg, i: index1) : ABC {
        if let T(tab) = t {
            let u = (i as u64) - 1;
            if u < tab.asize { dst = tab.aptr[u]; next }
            dst = value.table_get(tab, Int(i as i32));
            next
        }
        cold { raise error(ctx, "attempt to index a ", t) }
    }
    /// Method lookup: R[a+1] = obj; R[a] = obj[key].
    op SELF(a: selfbase, obj: reg, key: kst) : ABC + FieldIC {
        let o = obj;
        if let T(tab) = o {
            regs[a + 1] = o;
            let i = cache.slot as u64;
            if likely(i < tab.hcap) {
                let p = tab.hptr + 2 * i;
                if p[0] == key { regs[a] = p[1]; next }
            }
            cold { regs[a] = field_get_slow(tab, key, &cache.slot); next }
        }
        cold { raise error(ctx, "attempt to index a ", o) }
    }

    // Arithmetic: one declaration, six families (register and constant
    // second operands). The generic member tests (Int, Int) first; the
    // first time a site sees two floats it becomes the _F member, which
    // tests (Num, Num) first. Both members handle every type, so a site
    // never switches back.
    inline for (name, fname, ifname, finame, checked, sym, code, bkind, bbase) in [
        ("ADD", "ADD_F", "ADD_IF", "ADD_FI", "add_checked", +, 0, reg, regs),
        ("SUB", "SUB_F", "SUB_IF", "SUB_FI", "sub_checked", -, 1, reg, regs),
        ("MUL", "MUL_F", "MUL_IF", "MUL_FI", "mul_checked", *, 2, reg, regs),
        ("ADDK", "ADDK_F", "ADDK_IF", "ADDK_FI", "add_checked", +, 0, kst, k),
        ("SUBK", "SUBK_F", "SUBK_IF", "SUBK_FI", "sub_checked", -, 1, kst, k),
        ("MULK", "MULK_F", "MULK_IF", "MULK_FI", "mul_checked", *, 2, kst, k),
    ] {
        family #name(dst: reg, a: reg, b: bkind) : ABC {
            generic {
                match (a, b) {
                    (Int(x), Int(y)) => if let Some(r) = x.#checked(y) { dst = Int(r); next },
                    (Num(x), Num(y)) => cold { dst = Num(x sym y); become #fname; refuse(fp.cl); next },
                    _ => {}
                }
                cold {
                    match (a, b) {
                        (Int(x), Num(y)) => { dst = Num(x as f64 sym y); become #ifname; refuse(fp.cl); next }
                        (Num(x), Int(y)) => { dst = Num(x sym y as f64); become #finame; refuse(fp.cl); next }
                        _ => {}
                    }
                    dst = arith_slow(ctx, code, a, b)?;
                    next
                }
            }
            #fname {
                // Two floats: a tagged word is a NaN as a double, so a
                // non-NaN result means both operands were numbers.
                let r = unsafe { *((regs + a.raw) as *f64) } sym unsafe { *((bbase + b.raw) as *f64) };
                if likely(r == r) { dst = r.to_bits() as V; next }
                match (a, b) {
                    (Num(x), Num(y)) => { dst = Num(x sym y); next }
                    (Int(x), Int(y)) => if let Some(r) = x.#checked(y) { dst = Int(r); next },
                    (Int(x), Num(y)) => { dst = Num(x as f64 sym y); next }
                    (Num(x), Int(y)) => { dst = Num(x sym y as f64); next }
                    _ => {}
                }
                cold { dst = arith_mixed(ctx, code, a, b)?; next }
            }
            // Mixed operands, seen first: only that case is fast, and
            // anything else makes the site float-first.
            #ifname {
                if let Int(x) = a {
                    let r = x as f64 sym unsafe { *((bbase + b.raw) as *f64) };
                    if likely(r == r) { dst = r.to_bits() as V; next }
                }
                cold { become #fname; refuse(fp.cl); redo }
            }
            #finame {
                if let Int(y) = b {
                    let r = unsafe { *((regs + a.raw) as *f64) } sym y as f64;
                    if likely(r == r) { dst = r.to_bits() as V; next }
                }
                cold { become #fname; refuse(fp.cl); redo }
            }
        }
    }
    /// R[dst] = R[a] + sc (a small signed constant).
    op ADDI(dst: reg, a: reg, sc: simm) : ABsC {
        if let Int(x) = a and let Some(r) = x.add_checked(sc as i32) { dst = Int(r); next }
        cold { dst = arith_slow(ctx, 0, a, Int(sc as i32))?; next }
    }
    inline for (dname, mname, bkind, bbase) in [("DIV", "MOD", reg, regs), ("DIVK", "MODK", kst, k)] {
        op #dname(dst: reg, a: reg, b: bkind) : ABC {
            let r = unsafe { *((regs + a.raw) as *f64) } / unsafe { *((bbase + b.raw) as *f64) };
            if likely(r == r) { dst = r.to_bits() as V; next }
            match (a, b) {
                (Num(x), Num(y)) => { dst = Num(x / y); next }
                (Int(x), Int(y)) => { dst = Num(x as f64 / y as f64); next }
                (Int(x), Num(y)) => { dst = Num(x as f64 / y); next }
                (Num(x), Int(y)) => { dst = Num(x / y as f64); next }
                _ => {}
            }
            cold { dst = arith_slow(ctx, 3, a, b)?; next }
        }
        op #mname(dst: reg, a: reg, b: bkind) : ABC {
            if let (Int(x), Int(y)) = (a, b) and y > 0 {
                let r = x % y;
                dst = Int(if r < 0 { r + y } else { r });
                next
            }
            cold { dst = arith_slow(ctx, 4, a, b)?; next }
        }
    }
    /// R[dst] = k[b] - R[a] and k[b] / R[a] (a constant left operand).
    op RSUBK(dst: reg, a: reg, b: kst) : ABC {
        if let (Int(x), Int(y)) = (b, a) and let Some(r) = x.sub_checked(y) { dst = Int(r); next }
        let r = unsafe { *((k + b.raw) as *f64) } - unsafe { *((regs + a.raw) as *f64) };
        if likely(r == r) { dst = r.to_bits() as V; next }
        cold { dst = arith_mixed(ctx, 1, b, a)?; next }
    }
    op RDIVK(dst: reg, a: reg, b: kst) : ABC {
        let r = unsafe { *((k + b.raw) as *f64) } / unsafe { *((regs + a.raw) as *f64) };
        if likely(r == r) { dst = r.to_bits() as V; next }
        cold { dst = arith_slow(ctx, 3, b, a)?; next }
    }
    op POW(dst: reg, a: reg, b: reg) : ABC {
        dst = arith_slow(ctx, 5, a, b)?;
        next
    }
    op NEG(dst: reg, a: reg) : ABC {
        match a {
            Int(x) => if x != -2147483648 { dst = Int(0 - x); next },
            Num(x) => { dst = Num(-x); next }
            _ => {}
        }
        cold { dst = arith_slow(ctx, 1, Int(0), a)?; next }
    }
    op NOT(dst: reg, a: reg) : ABC { dst = Bool(!value.truthy(a)); next }
    op LEN(dst: reg, a: reg) : ABC {
        if let T(t) = a {
            let n = t.asize;
            if n > 0 and t.aptr[n - 1] != V.Nil { dst = Int(n as i32); next }
        }
        dst = length(ctx, a)?;
        next
    }
    /// R[dst] = R[base] .. ... .. R[base + n - 1], as one string.
    op CONCAT(dst: reg, base: callbase, n: catn) : ABC {
        if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } }
        dst = concat(ctx, regs + base, n as u64)?;
        next
    }

    // Comparisons, with a register or constant (K) second operand.
    // GT and GE exist only with K (for `k < x`, the compiler swaps).
    inline for (ename, lname, lename, bkind) in [("EQ", "LT", "LE", reg), ("EQK", "LTK", "LEK", kst)] {
        op #ename(dst: reg, a: reg, b: bkind) : ABC {
            if let (Int(x), Int(y)) = (a, b) { dst = Bool(x == y); next }
            // Same bits means equal, except for NaN.
            if a == b {
                if let Num(x) = a { dst = Bool(x == x); next }
                dst = Bool(true);
                next
            }
            cold { dst = Bool(value.raw_equal(a, b)); next }
        }
        op #lname(dst: reg, a: reg, b: bkind) : ABC {
            match (a, b) {
                (Int(x), Int(y)) => { dst = Bool(x < y); next }
                (Num(x), Num(y)) => { dst = Bool(x < y); next }
                _ => {}
            }
            cold { dst = Bool(less(ctx, a, b, false)?); next }
        }
        op #lename(dst: reg, a: reg, b: bkind) : ABC {
            match (a, b) {
                (Int(x), Int(y)) => { dst = Bool(x <= y); next }
                (Num(x), Num(y)) => { dst = Bool(x <= y); next }
                _ => {}
            }
            cold { dst = Bool(less(ctx, a, b, true)?); next }
        }
    }
    op GTK(dst: reg, a: reg, b: kst) : ABC {
        match (a, b) {
            (Int(x), Int(y)) => { dst = Bool(x > y); next }
            (Num(x), Num(y)) => { dst = Bool(x > y); next }
            _ => {}
        }
        cold { dst = Bool(less(ctx, b, a, false)?); next }
    }
    op GEK(dst: reg, a: reg, b: kst) : ABC {
        match (a, b) {
            (Int(x), Int(y)) => { dst = Bool(x >= y); next }
            (Num(x), Num(y)) => { dst = Bool(x >= y); next }
            _ => {}
        }
        cold { dst = Bool(less(ctx, b, a, true)?); next }
    }

    /// The end of a compare-and-branch: jump to the following JMP's
    /// target, or skip the JMP.
    fn branch(take: bool, target: *u32) -> never {
        if take { jump target }
        jump pc + 2
    }

    // Compare and branch, for conditions: the next word is a JMP holding
    // the branch offset (so the verifier and the compiler's jump
    // patching treat it as a jump). Jump if the comparison holds (or,
    // for the N forms, if it does not); otherwise skip the JMP. The A
    // field is unused.
    inline for (name, nname, bkind, isub, fsub, slow) in [
        ("JLT", "JLTN", reg, x < y, x < y, less(ctx, a, b, false)),
        ("JLE", "JLEN", reg, x <= y, x <= y, less(ctx, a, b, true)),
        ("JLTK", "JLTKN", kst, x < y, x < y, less(ctx, a, b, false)),
        ("JLEK", "JLEKN", kst, x <= y, x <= y, less(ctx, a, b, true)),
        ("JGTK", "JGTKN", kst, x > y, x > y, less(ctx, b, a, false)),
        ("JGEK", "JGEKN", kst, x >= y, x >= y, less(ctx, b, a, true)),
    ] {
        inline for (opname, want) in [(name, true), (nname, false)] {
            op #opname(unused: imm, a: reg, b: bkind) : ABC then JMP {
                let (x, y) = ((a as u64) ^ value.int_bias(), (b as u64) ^ value.int_bias());
                if (x | y) < (1 << 48) { branch((isub) == want, then.target) }
                if let (Num(x), Num(y)) = (a, b) { branch((fsub) == want, then.target) }
                cold { branch(slow? == want, then.target) }
            }
        }
    }
    inline for (name, nname, bkind) in [("JEQ", "JEQN", reg), ("JEQK", "JEQKN", kst)] {
        inline for (opname, want) in [(name, true), (nname, false)] {
            op #opname(unused: imm, a: reg, b: bkind) : ABC then JMP {
                if let (Int(x), Int(y)) = (a, b) { branch((x == y) == want, then.target) }
                // Same bits means equal, except for NaN; strings are interned.
                if a == b {
                    var eq = true;
                    if let Num(x) = a { eq = x == x; }
                    branch(eq == want, then.target)
                }
                cold { branch(value.raw_equal(a, b) == want, then.target) }
            }
        }
    }

    op JMP(target: label) : sJ { jump target }
    /// Jump if falsy.
    op TEST(a: reg, target: label) : AsBx {
        if !value.truthy(a) { jump target }
        next
    }
    /// Jump if truthy.
    op TESTT(a: reg, target: label) : AsBx {
        if value.truthy(a) { jump target }
        next
    }

    /// The iterations after the first of an integer loop from `i` to `l`
    /// by `s` (one that runs, with s != 0). It can exceed the integer
    /// range, so it is stored as an Int whose payload bits are unsigned.
    fn for_count(i: i64, l: i64, s: i64) -> V {
        let n = if s == 1 { (l - i) as u64 }
            else if s > 0 { ((l - i) as u64) / (s as u64) }
            else { ((i - l) as u64) / ((0 - s) as u64) };
        V.Int(n as i32)
    }

    /// Numeric for: R[a] index, R[a+1] limit, R[a+2] step, R[a+3] the
    /// loop variable. For an integer loop, FORPREP replaces the limit
    /// with the iteration count.
    op FORPREP(a: forbase, target: label) : AsBx {
        match (regs[a], regs[a + 1], regs[a + 2]) {
            (Int(i), Int(l), Int(s)) => {
                if s == 0 { cold { raise error_msg(ctx, "'for' step is zero") } }
                if (s > 0 and i > l) or (s < 0 and i < l) { jump target }
                regs[a + 1] = for_count(i as i64, l as i64, s as i64);
                regs[a + 3] = Int(i);
                next
            }
            _ => {}
        }
        cold {
            let (Some(i), Some(l), Some(s)) = (value.to_num(regs[a]), value.to_num(regs[a + 1]), value.to_num(regs[a + 2])) else {
                raise error_msg(ctx, "'for' values must be numbers")
            };
            // Integer start and step: an integer loop, with the float
            // limit floored (or ceiled for a negative step) and clamped.
            if let (Int(ii), Int(si)) = (regs[a], regs[a + 2]) {
                if si == 0 { raise error_msg(ctx, "'for' step is zero") }
                let lf = if si > 0 { l.floor() } else { -((-l).floor()) };
                if l != l or (si > 0 and lf < ii as f64) or (si < 0 and lf > ii as f64) { jump target }
                let li: i32 = if lf > 2147483647.0 { 2147483647 } else if lf < -2147483648.0 { -2147483647 - 1 } else { lf as i32 };
                regs[a + 1] = for_count(ii as i64, li as i64, si as i64);
                regs[a + 3] = Int(ii);
                next
            }
            if s == 0.0 { raise error_msg(ctx, "'for' step is zero") }
            regs[a] = Num(i);
            regs[a + 1] = Num(l);
            regs[a + 2] = Num(s);
            if (s > 0.0 and i > l) or (s < 0.0 and i < l) { jump target }
            regs[a + 3] = Num(i);
            next
        }
    }
    /// An integer loop counts down the iterations left in R[a+1] (as in
    /// Lua 5.4), so stepping needs no overflow or direction checks.
    op FORLOOP(a: forbase, target: label) : AsBx {
        if let Int(c) = regs[a + 1] {
            if c != 0 {
                // The payload is not zero, so decrementing the word
                // decrements it.
                regs[a + 1] = ((regs[a + 1] as u64) - 1) as V;
                let Int(i) = regs[a] else { unreachable };
                let Int(s) = regs[a + 2] else { unreachable };
                let n = V.Int(i +% s);
                regs[a] = n;
                regs[a + 3] = n;
                jump target
            }
            next
        }
        match (regs[a], regs[a + 1], regs[a + 2]) {
            (Num(i), Num(l), Num(s)) => {
                let n = i + s;
                if (s > 0.0 and n <= l) or (s < 0.0 and n >= l) {
                    regs[a] = Num(n);
                    regs[a + 3] = Num(n);
                    jump target
                }
                next
            }
            _ => next,
        }
    }

    /// pairs loop: R[a] table, R[a+1] traversal position, R[a+2], R[a+3]
    /// key and value. Jumps to the body while there is a next entry.
    op NEXT(a: forbase, target: label) : AsBx {
        if let (T(t), Int(i)) = (regs[a], regs[a + 1]) {
            let n = value.table_iter(t, i as u64, regs + a + 2);
            if n != 0 {
                regs[a + 1] = Int(n as i32);
                jump target
            }
            next
        }
        cold { raise iter_error(ctx, regs[a]) }
    }
    /// ipairs loop: R[a] table, R[a+1] last index, R[a+2], R[a+3] index and value.
    op INEXT(a: forbase, target: label) : AsBx {
        if let (T(t), Int(i)) = (regs[a], regs[a + 1]) {
            let u = i as u64;
            let v = if u < t.asize { t.aptr[u] } else { value.table_get(t, Int(i + 1)) };
            if v == V.Nil { next }
            regs[a + 1] = Int(i + 1);
            regs[a + 2] = Int(i + 1);
            regs[a + 3] = v;
            jump target
        }
        cold { raise iter_error(ctx, regs[a]) }
    }

    /// R[base .. base+nres-1] = R[base](R[base+1] .. R[base+nargs]).
    /// nres is at least 1.
    op CALL(base: callbase, nargs: nargs, nres: nres) : ABC {
        let f = regs[base];
        if let F(cl) = f {
            // No GC check: entering a function allocates nothing.
            let p = cl.proto;
            let callee = regs + base + 1;
            let n = p.nregs as u64;
            if callee + n > ctx.stack_end or fp + 1 >= ctx.frames_end {
                cold { raise error_msg(ctx, "stack overflow") }
            }
            var i = nargs as u64;
            while i < n {
                callee[i] = Nil;
                i += 1;
            }
            fp.resume = pc + 1;
            fp = fp + 1;
            fp.cl = cl;
            fp.base = callee;
            fp.nres = nres as u32;
            k = p.consts.data.ptr;
            fp.k = k;
            regs = callee;
            jump p.code.ptr
        }
        if let Native(id) = f {
            cold {
                if ctx.heap.allocated > ctx.heap.threshold { gc.collect(&ctx.heap); }
                let v = call_native(ctx, id, regs + base + 1, nargs as u64)?;
                regs[base] = v;
                var i: u64 = 1;
                while i < nres as u64 {
                    regs[base + i] = Nil;
                    i += 1;
                }
                next
            }
        }
        cold { raise error(ctx, "attempt to call a ", f) }
    }
    /// Return one value.
    op RET1(src: reg) : ABC {
        let v = src;
        if unlikely(ctx.open_level >= regs) { cold { close_upvals(ctx, regs); } }
        if fp == ctx.base { exit Ok(v) }
        *(regs - 1) = v;
        let want = fp.nres as u64;
        if unlikely(want > 1) {
            cold {
                for i in 0..want - 1 { regs[i] = Nil; }
                fp = fp - 1;
                regs = fp.base;
                k = fp.k;
                jump fp.resume
            }
        }
        fp = fp - 1;
        regs = fp.base;
        k = fp.k;
        jump fp.resume
    }
    /// Return R[a .. a+n-1], adjusted to the number of results wanted.
    op RETN(a: reg, n: retn) : ABC {
        if unlikely(ctx.open_level >= regs) { cold { close_upvals(ctx, regs); } }
        if fp == ctx.base { exit Ok(a) }
        let want = fp.nres as u64;
        let src = regs + a.raw as u64;
        let dst = regs - 1;
        for i in 0..want {
            dst[i] = if i < n as u64 { src[i] } else { Nil };
        }
        fp = fp - 1;
        regs = fp.base;
        k = fp.k;
        jump fp.resume
    }
    op RET0() : ABC {
        if unlikely(ctx.open_level >= regs) { cold { close_upvals(ctx, regs); } }
        if fp == ctx.base { exit Ok(Nil) }
        let want = fp.nres as u64;
        let dst = regs - 1;
        for i in 0..want { dst[i] = Nil; }
        fp = fp - 1;
        regs = fp.base;
        k = fp.k;
        jump fp.resume
    }

    // Suggested by `loimi build --vm-stats` on recursive code.
    super LOADI_SUB = LOADI; SUB;
    super ADD_RET1 = ADD; RET1;
    super MUL_F_ADD_F = MUL_F; ADD_F;
    // Overlaps another super, but runs where no ADD_F follows: 2.8% of nbody's ops.
    #[allow(super_overlap)]
    super MUL_F_MUL_F = MUL_F; MUL_F;
    // Overlaps another super, but runs outside MUL_F; ADD_F: 15% of mandelbrot's ops, 2.8% of nbody's.
    #[allow(super_overlap)]
    super ADD_F_MUL_F = ADD_F; MUL_F;
    // Overlaps another super, but runs outside MUL_F; MUL_F: 8.3% of nbody's ops.
    #[allow(super_overlap)]
    super MUL_F_SUB_F = MUL_F; SUB_F;
    // Overlaps another super, but runs outside MUL_F; ADD_F: 15% of mandelbrot's ops.
    #[allow(super_overlap)]
    super ADD_F_SUB_F = ADD_F; SUB_F;
    // Overlaps another super, but runs outside the MUL_F pairs: 15% of mandelbrot's ops.
    #[allow(super_overlap)]
    super MULK_F_MUL_F = MULK_F; MUL_F;
    // Overlaps another super, but runs outside the MUL_F pairs: 11% of nbody's ops.
    #[allow(super_overlap)]
    super GETFIELD_MUL_F = GETFIELD; MUL_F;
    super GETFIELD_SUB_F = GETFIELD; SUB_F;
    // Overlaps another super, but runs outside MUL_F; ADD_F: 8.3% of nbody's ops.
    #[allow(super_overlap)]
    super ADD_F_SETFIELD = ADD_F; SETFIELD;
    super MOVE_CALL = MOVE; CALL;
    // Overlaps another super, but runs outside MOVE; CALL: 2% of closures' ops.
    #[allow(super_overlap)]
    super MOVE_MOVE = MOVE; MOVE;
    // Overlaps another super, but runs outside MOVE; MOVE: 6% of string_build's ops.
    #[allow(super_overlap)]
    super MOVE_MOVE_CALL = MOVE; MOVE; CALL;
    super GETINDEX_GETINDEX = GETINDEX; GETINDEX;
    // Overlaps another super, but runs outside GETINDEX; GETINDEX: 14% of queens' and sort's ops.
    #[allow(super_overlap)]
    super GETUPVAL_GETINDEX = GETUPVAL; GETINDEX;
    // Overlaps another super, but runs outside the MOVE supers: 8% of binary_trees' and spectral_norm's ops.
    #[allow(super_overlap)]
    super GETUPVAL_MOVE = GETUPVAL; MOVE;
    #[forward] super ADDI_ADDI = ADDI; ADDI;
    super GETUPVAL_JEQN = GETUPVAL; JEQN;
    // Overlaps another super, but runs outside GETINDEX; GETINDEX: 2.3% of interp's ops.
    #[allow(super_overlap)]
    super GETINDEX_ADDI = GETINDEX; ADDI;

    /// A top-level run of `cl` from the bottom of the stack (the
    /// standalone interpreter).
    entry run(c: *Ctx, cl: Gc<Closure>) -> Result<V, V> {
        ctx = c;
        let p = cl.proto;
        fp = c.frames;
        c.base = fp;
        fp.cl = cl;
        fp.base = c.stack;
        fp.nres = 1;
        fp.k = p.consts.data.ptr;
        regs = c.stack;
        for i in 0..p.nregs as u64 { regs[i] = V.Nil; }
        k = p.consts.data.ptr;
        c.fp = fp;
        jump p.code.ptr
    }

    /// A run of `cl` in frame `at`, whose window `call_value` filled with
    /// the arguments: `at` becomes the run's bottom frame.
    entry call(c: *Ctx, at: *Frame, cl: Gc<Closure>) -> Result<V, V> uses reenter {
        ctx = c;
        let p = cl.proto;
        fp = at;
        fp.cl = cl;
        fp.nres = 1;
        k = p.consts.data.ptr;
        fp.k = k;
        regs = fp.base;
        c.base = fp;
        c.fp = fp;
        jump p.code.ptr
    }

    on raise(e: V) {
        ctx.fp = fp;
        // An error from a nested run already has its line.
        if e != V.Nil and e == ctx.rethrow {
            ctx.rethrow = Nil;
            exit Err(e)
        }
        // Prefix the message with the line of the failing instruction.
        let p = fp.cl.proto;
        let i = ((pc as u64) - (p.code.ptr as u64)) / 4;
        var line: u32 = 0;
        if i < p.lines.data.len { line = p.lines.data[i]; }
        ctx.out.clear();
        ctx.out.push_str("line ");
        ctx.out.push_int(line as i64);
        ctx.out.push_str(": ");
        value.write_value(&ctx.out, e);
        exit Err(S(value.new_str(&ctx.heap, ctx.out.as_str())))
    }
}
