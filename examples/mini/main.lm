// Mini: a small Lua-like language, implemented in Loimi.
//
//   loimi build examples/mini/main.lm -o mini && ./mini script.mini
//
// embed.lm builds the same interpreter as a C library.

import std.io;
import std.os;
import std.text;
import value;
import value.{V};
import vm.{Mini};
import vm;
import compile;
import lib;
import state;

fn main() -> i32 {
    let Some(path) = os.arg(1) else {
        io.eprintln("usage: mini <script>");
        return 2;
    };
    let Some(src) = io.read_file(path) else {
        io.eprint("cannot read ");
        io.eprintln(path);
        return 1;
    };
    var ctx = state.new_ctx(vm.no_host);
    // `stress`: collect at every safepoint; `verify`: the same with a
    // generational heap, checking the write barriers at each collection.
    if let Some(mode) = os.arg(2) {
        ctx.heap.set_stress(true);
        if mode.eq("verify") {
            ctx.heap.set_generational(true);
            ctx.heap.set_verify(true);
        }
    }
    let proto = compile.compile(&ctx.heap, path, src);
    let main_closure = value.new_closure(&ctx.heap, proto);
    state.attach(&ctx);
    let r = Mini.run(&ctx, main_closure);
    lib.flush();
    if let Err(e) = r {
        var b = text.StrBuf.new();
        b.push_str("error: ");
        value.write_value(&b, e);
        io.eprintln(b.as_str());
        return 1;
    }
    0
}
