// Mini: a small Lua-like language, implemented in Loimi.
//
//   loimi build examples/mini/main.lm -o mini && ./mini script.mini

import std.io;
import std.os;
import std.gc;
import std.mem;
import std.text;
import value;
import value.{V};
import vm.{Mini, Ctx, Frame};
import vm;
import compile;

fn main() -> i32 {
    let Some(path) = os.arg(1) else {
        io.eprintln("usage: mini <script>");
        return 2;
    };
    let Some(src) = io.read_file(path) else {
        io.eprint("cannot read ");
        io.eprintln(path);
        return 1;
    };
    var heap = gc.Heap.new();
    let globals = value.new_table(&heap);
    var ctx = Ctx {
        heap: heap,
        stack: mem.alloc(1 << 20),
        stack_end: 0 as *V,
        frames: mem.alloc(1 << 16),
        frames_end: 0 as *Frame,
        fp: 0 as *Frame,
        globals: globals,
        error: V.Nil,
        out: text.StrBuf.new(),
        open: None,
        open_level: 0 as *V,
    };
    ctx.stack_end = ctx.stack + (1 << 20);
    ctx.frames_end = ctx.frames + (1 << 16);
    ctx.fp = ctx.frames;
    if os.arg(2).is_some() { ctx.heap.set_stress(true); }
    let print_name = V.S(value.new_str(&ctx.heap, "print"));
    value.table_set(&ctx.heap, ctx.globals, print_name, V.Native(0));
    let proto = compile.compile(&ctx.heap, src);
    let main_closure = value.new_closure(&ctx.heap, proto);
    ctx.heap.add_scanner(&ctx as *u8, vm.scan_roots);
    Mini.run(&ctx, main_closure);
    if ctx.error != V.Nil {
        var b = text.StrBuf.new();
        b.push_str("error: ");
        value.write_value(&b, ctx.error);
        io.eprintln(b.as_str());
        return 1;
    }
    0
}
