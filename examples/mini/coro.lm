// Lua 5.4 coroutines for Mini: the `coroutine` library.
//
// A coroutine is a `Coro` object with a value stack and a frame stack of
// its own (host memory that the object owns, growing by doubling). The
// VM runs on whichever stacks the context's fields (`stack` .. `open_level`)
// describe. A switch saves the running thread's state (its frame pointer,
// run base, open upvalues and where to continue) in its own `Coro` and
// installs the other's:
//
// - A CALL of coroutine.resume or of a wrap function switches inside the
//   running vm run (`switch_in` in vm.lm), and the coroutine's yield, its
//   last return and its errors switch back the same way (`switch_out`,
//   `on raise`): no native call, no nested entry, no C stack.
// - A resume from a native (a table.sort comparator calling a wrap
//   function, a host function) is `resume` below: it runs the coroutine
//   through a nested entry (`Mini.call` the first time, `Mini.resume`
//   after a yield), and the coroutine's yield leaves that run
//   (`yield_exit` in vm.lm).
//
// Yielding with a native in between (a table.sort comparator, a host
// function) is an error, as in PUC-Lua for C functions without
// continuations.
#![lifetimes]
import std.gc;
import std.mem;
import value;
import value.{V, UpVal, Table, Closure};
import vm;
import vm.{Ctx, Frame, Mini, NRET_ONE};

pub const SUSPENDED: u32 = 0;
pub const RUNNING: u32 = 1;
pub const NORMAL: u32 = 2;
pub const DEAD: u32 = 3;

/// A coroutine (or the main thread, `Ctx.main`). While it is not
/// running (suspended after a yield, or normal: it resumed another),
/// `fp`, `base`, `open` and `open_level` are its saved thread state, and
/// the CALL that yielded (or resumed) continues at `ypc`, storing its
/// `ynres` results from register `ydst`.
///
/// While it runs, `prev` is the thread that resumed it, and `inrun` says
/// whether that happened inside the resumer's vm run (a CALL), so that
/// its yield, return and errors switch back in the run, or through a
/// native (`resume`), so that they leave the run. `via_wrap`: resumed by
/// calling its wrap function (results without the leading true, errors
/// raised in the resumer).
///
/// Its stacks, `nslots` values at `stack` and `nframes` frames at
/// `frames`, are host memory (`mem.alloc`) that the object owns: allocated
/// at the first resume, released when it dies, or by the free hook
/// (`release`) if it is collected first. The collector reaches the
/// values in them through `trace_coro`, which walks the frames of a
/// suspended coroutine, so the dead slots above its top frame keep
/// nothing alive. A running or normal coroutine's stacks are roots
/// instead (`vm.scan_roots`).
#[trace(trace_coro)]
pub object Coro {
    status: u32,
    started: bool,
    body: V,
    stack: *V,
    nslots: u64,
    frames: *Frame,
    nframes: u64,
    /// The blocks that growing the stacks replaced during the current
    /// resume: natives of its run may still point into them, so they are
    /// released when the resume returns.
    retired: *Retired,
    fp: *Frame,
    base: *Frame,
    open: ?Gc<UpVal>,
    open_level: *V,
    ypc: Mini.Resume,
    ydst: u32,
    ynres: u32,
    prev: ?Gc<Coro>,
    inrun: bool,
    via_wrap: bool,
    /// The error that killed it, until coroutine.close reports it.
    err: V,
    /// Set in the function that coroutine.wrap returns (a Coro of its own,
    /// so that it is not the thread that coroutine.running returns): the
    /// coroutine it resumes.
    wrap: ?Gc<Coro>,
}

/// A replaced stack block (`Coro.retired`).
pub struct Retired { p: *u8, next: *Retired }

/// The `#[trace]` hook: the registers of a suspended coroutine's frames.
/// The VM writes a running coroutine's stacks without write barriers;
/// they are roots while it runs or is normal, and `resume` logs the
/// object (`gc.write_barrier`) when it suspends.
fn trace_coro(h: *gc.Heap, co: Gc<Coro>) {
    if co.status == SUSPENDED and co.frames != 0 as *Frame { vm.scan_frames(h, co.frames, co.fp); }
}

/// Release the stacks and the retired blocks. Also the free hook
/// (`gc.Heap.on_free_gc`) of a coroutine with stacks.
fn release(co: Gc<Coro>) {
    if co.stack != 0 as *V {
        mem.release(co.stack);
        co.stack = 0 as *V;
        co.nslots = 0;
    }
    if co.frames != 0 as *Frame {
        mem.release(co.frames);
        co.frames = 0 as *Frame;
        co.nframes = 0;
    }
    release_retired(co);
}

pub fn release_retired(co: Gc<Coro>) {
    var r = co.retired;
    while r != 0 as *Retired {
        let next = r.next;
        mem.release(r.p);
        mem.release(r);
        r = next;
    }
    co.retired = 0 as *Retired;
}

/// Keep a stack block that `vm.grow` replaced until the resume returns.
pub fn retire(co: Gc<Coro>, p: *u8) {
    let r: *Retired = mem.alloc(1);
    r.p = p;
    r.next = co.retired;
    co.retired = r;
}

pub fn is_wrap(co: Gc<Coro>) -> bool {
    match co.wrap {
        Some(_) => true,
        None => false,
    }
}

/// Native ids (vm.call_native sends ids from FIRST up here).
pub const FIRST: i32 = 50;
const CREATE: i32 = 50;
pub const RESUME: i32 = 51;
pub const YIELD: i32 = 52;
const STATUS: i32 = 53;
const ISYIELDABLE: i32 = 54;
const RUNNING_FN: i32 = 55;
const WRAP: i32 = 56;
const CLOSE: i32 = 57;

/// Initial stack sizes, in values and frames.
const VS_INIT: u64 = 60;
const FS_INIT: u64 = 12;

fn set(h: *gc.Heap, t: Gc<Table>, name: str, v: V) {
    let k = V.S(value.new_str(h, name));
    value.table_set(h, t, k, v);
}

pub fn install(h: *gc.Heap, globals: Gc<Table>) {
    let t = value.new_table(h);
    set(h, t, "create", V.Native(CREATE));
    set(h, t, "resume", V.Native(RESUME));
    set(h, t, "yield", V.Native(YIELD));
    set(h, t, "status", V.Native(STATUS));
    set(h, t, "isyieldable", V.Native(ISYIELDABLE));
    set(h, t, "running", V.Native(RUNNING_FN));
    set(h, t, "wrap", V.Native(WRAP));
    set(h, t, "close", V.Native(CLOSE));
    set(h, globals, "coroutine", V.T(t));
}

/// The main thread's coroutine object (what coroutine.running returns
/// outside any coroutine): running, on the main stacks (which it does not
/// own: they never grow, and `Ctx` frees them).
pub fn new_main(h: *gc.Heap, stack: *V, nslots: u64, frames: *Frame, nframes: u64) -> Gc<Coro> {
    new(h, Coro { status: RUNNING, started: true, body: V.Nil, err: V.Nil, ypc: Mini.Resume.placeholder(),
        stack: stack, nslots: nslots, frames: frames, nframes: nframes, ..zero })
}

fn msg(c: *Ctx, s: str) -> V { V.S(value.new_str(&c.heap, s)) }

fn bad_arg(c: *Ctx, i: u64, name: str, want: str) -> V {
    c.out.clear();
    c.out.push_str("bad argument #");
    c.out.push_int(i as i64 + 1);
    c.out.push_str(" to '");
    c.out.push_str(name);
    c.out.push_str("' (");
    c.out.push_str(want);
    c.out.push_str(" expected)");
    V.S(value.new_str(&c.heap, c.out.as_str()))
}

/// The result buffer with room for `n` values; the native returns
/// several results by filling it and setting `c.nret`.
fn results(c: *Ctx, n: u64) -> *V {
    if n > c.rcap {
        var cap = c.rcap * 2;
        while cap < n { cap = cap * 2; }
        c.rbuf = mem.grow(c.rbuf, cap);
        c.rcap = cap;
    }
    c.rbuf
}

fn two(c: *Ctx, a: V, b: V) -> Result<V, V> {
    let r = results(c, 2);
    r[0] = a;
    r[1] = b;
    c.nret = 2;
    Ok(a)
}

fn check_co(c: *Ctx, args: *V, n: u64, name: str) -> Result<Gc<Coro>, V> {
    if n > 0 {
        if let Co(co) = args[0] and !is_wrap(co) { return Ok(co); }
    }
    Err(bad_arg(c, 0, name, "coroutine"))
}

pub fn call(c: *Ctx, id: i32, args: *V, n: u64, from_vm: bool) -> Result<V, V> uses reenter {
    if id == CREATE or id == WRAP {
        let f = if n > 0 { args[0] } else { V.Nil };
        match f {
            F(_) | Native(_) => {}
            Co(w) if is_wrap(w) => {}
            _ => return Err(bad_arg(c, 0, if id == CREATE { "create" } else { "wrap" }, "function")),
        }
        let co = new(&c.heap, Coro { status: SUSPENDED, started: false, body: f, err: V.Nil, ypc: Mini.Resume.placeholder(), ..zero });
        if id == CREATE { return Ok(V.Co(co)); }
        return Ok(V.Co(new(&c.heap, Coro { status: DEAD, started: true, body: V.Nil, err: V.Nil, ypc: Mini.Resume.placeholder(), wrap: Some(co), ..zero })));
    }
    if id == RESUME {
        let co = check_co(c, args, n, "resume")?;
        return resume(c, co, args + 1, n - 1, false);
    }
    if id == YIELD {
        if c.cur == c.main { return Err(msg(c, "attempt to yield from outside a coroutine")); }
        if !from_vm or c.base != c.frames { return Err(msg(c, "attempt to yield across a C-call boundary")); }
        // `xfer` (the values, in the CALL's window) is set by the CALL
        // instruction itself: `args` is only lent for this call.
        c.nxfer = n;
        c.yielded = true;
        c.nret = 0;
        return Ok(V.Nil);
    }
    if id == STATUS {
        let co = check_co(c, args, n, "status")?;
        return Ok(msg(c, status_name(c, co)));
    }
    if id == ISYIELDABLE {
        if n > 0 and args[0] != V.Nil {
            let co = check_co(c, args, n, "isyieldable")?;
            if co != c.cur { return Ok(V.Bool(co != c.main)); }
        }
        return Ok(V.Bool(c.cur != c.main and from_vm and c.base == c.frames));
    }
    if id == RUNNING_FN {
        return two(c, V.Co(c.cur), V.Bool(c.cur == c.main));
    }
    // CLOSE
    let co = check_co(c, args, n, "close")?;
    if co.status == SUSPENDED {
        // Close the upvalues still open into its stack, then free it.
        var u = co.open;
        loop {
            let Some(uv) = u else { break; };
            uv.closed = *uv.v;
            uv.v = &uv.closed;
            uv.co = None;
            u = uv.next;
            uv.next = None;
        }
        die(co);
        return Ok(V.Bool(true));
    }
    if co.status == DEAD {
        let e = co.err;
        if e == V.Nil { return Ok(V.Bool(true)); }
        co.err = V.Nil;
        return two(c, V.Bool(false), e);
    }
    Err(msg(c, if co == c.cur { "cannot close a running coroutine" } else { "cannot close a normal coroutine" }))
}

fn status_name(c: *Ctx, co: Gc<Coro>) -> str {
    if co == c.cur { return "running"; }
    if co.status == SUSPENDED { return "suspended"; }
    if co.status == DEAD { return "dead"; }
    "normal"
}

pub fn die(co: Gc<Coro>) {
    co.status = DEAD;
    release(co);
    co.open = None;
    co.body = V.Nil;
}

/// The first resume of a coroutine whose body is a native: a plain call,
/// which cannot yield.
fn resume_native(c: *Ctx, co: Gc<Coro>, args: *V, n: u64, wrap: bool) -> Result<V, V> uses reenter {
    co.started = true;
    co.status = RUNNING;
    let r = vm.call_value(c, co.body, args, n);
    die(co);
    match r {
        Ok(v) => {
            if wrap { return Ok(v); }
            two(c, V.Bool(true), v)
        }
        Err(e) => {
            c.rethrow = V.Nil;
            if wrap { return Err(e); }
            co.err = e;
            two(c, V.Bool(false), e)
        }
    }
}

/// Whether a CALL may resume `co` inside its run (vm.lm, `switch_in`):
/// suspended, under the nesting limit, and with Mini code to run. The
/// other cases go through `resume`, which reports them.
pub fn can_switch(c: *Ctx, co: Gc<Coro>) -> bool {
    if co.status != SUSPENDED or Mini.depth + c.nco >= vm.MAX_NESTING { return false; }
    if co.started { return true; }
    match co.body {
        F(_) => true,
        _ => false,
    }
}

/// Give a coroutine that is about to start its stacks.
pub fn prepare(c: *Ctx, co: Gc<Coro>, cl: Gc<Closure>) {
    let nregs = cl.proto.nregs as u64;
    let cap = if nregs > VS_INIT { nregs } else { VS_INIT };
    co.stack = mem.alloc(cap);
    co.nslots = cap;
    co.frames = mem.alloc(FS_INIT);
    co.nframes = FS_INIT;
    // Count the stacks towards the next collection, as if they were in
    // the heap.
    c.heap.allocated += cap * 8 + FS_INIT * size_of<Frame>();
    c.heap.on_free_gc(co, release);
}

/// Save the running thread's state in its `Coro` (normal from now on)
/// and install `co`'s stacks, `co` resumed by it (`inrun`: by a CALL in
/// the same vm run). The caller sets up the frame registers.
///
/// `enter` and `suspend` store references through raw pointers, which
/// skips the compiler's write barrier, and log the objects themselves
/// with `gc.remember`, out of line. The compiler's barrier has its slow
/// path inline (std.gc `log_obj`), which made the two too large for LLVM
/// to inline into `switch_in`/`switch_out` (vm.lm): chameneos and
/// coroutine_ring took 6% longer in tail-call mode. (`#[inline]` on them
/// instead made switch mode 7-10% slower.)
pub fn enter(c: *Ctx, co: Gc<Coro>, inrun: bool, wrap: bool) {
    let r = c.cur;
    r.fp = c.fp;
    r.base = c.base;
    let ro = &r.open;
    *ro = c.open;
    r.open_level = c.open_level;
    r.status = NORMAL;
    let cp = &co.prev;
    *cp = Some(r);
    co.inrun = inrun;
    co.via_wrap = wrap;
    co.status = RUNNING;
    // From here until it suspends, its stacks are roots (vm.scan_roots),
    // and so are the resumer's (through `prev`).
    c.stack = co.stack;
    c.stack_end = co.stack + co.nslots;
    c.frames = co.frames;
    c.frames_end = co.frames + co.nframes;
    c.base = co.frames;
    c.open = co.open;
    c.open_level = co.open_level;
    c.cur = co;
    // Last, so that the rare call is a tail call and `enter` needs no
    // stack frame.
    if unlikely(gc.needs_barrier(r as *u8) or gc.needs_barrier(co as *u8)) { log_pair(r, co); }
}

/// Reinstall the state of the thread that resumed `co`, which stopped
/// running (its own state is saved, or it is dead); returns that thread.
pub fn leave(c: *Ctx, co: Gc<Coro>) -> Gc<Coro> {
    let Some(r) = co.prev else { unreachable };
    co.prev = None;
    c.stack = r.stack;
    c.stack_end = r.stack + r.nslots;
    c.frames = r.frames;
    c.frames_end = r.frames + r.nframes;
    c.fp = r.fp;
    c.base = r.base;
    c.open = r.open;
    c.open_level = r.open_level;
    c.cur = r;
    r.status = RUNNING;
    r
}

/// Suspend the running coroutine `co`, whose top frame is `fp`: the
/// yield's CALL continues at `ypc` with its `nres` results from register
/// `dst`.
pub fn suspend(c: *Ctx, co: Gc<Coro>, fp: *Frame, ypc: Mini.Resume, dst: u32, nres: u32) {
    co.status = SUSPENDED;
    co.fp = fp;
    co.base = c.base;
    let o = &co.open;
    *o = c.open;
    co.open_level = c.open_level;
    co.ypc = ypc;
    co.ydst = dst;
    co.ynres = nres;
    release_retired(co);
    // Its stacks are no longer roots, and the VM wrote them without
    // barriers: a minor collection must trace them (and `open`).
    if unlikely(gc.needs_barrier(co as *u8)) { gc.remember(co as *u8); }
}

/// The write barrier of `enter`'s stores into `a` and `b`.
#[inline(never)]
fn log_pair(a: Gc<Coro>, b: Gc<Coro>) {
    gc.remember(a as *u8);
    gc.remember(b as *u8);
}

/// coroutine.resume(co, args[0..n]) (`wrap` false: results true and the
/// values, or false and the error) and calling a wrap function (`wrap`
/// true: the values, or the error raised), from a native or from a CALL
/// that cannot switch (`can_switch`). The coroutine runs through a nested
/// entry, which returns when it yields, returns or fails.
pub fn resume(c: *Ctx, co: Gc<Coro>, args: *V, n: u64, wrap: bool) -> Result<V, V> uses reenter {
    if co.status != SUSPENDED {
        let m = msg(c, if co.status == DEAD { "cannot resume dead coroutine" } else { "cannot resume non-suspended coroutine" });
        if wrap { return Err(m); }
        return two(c, V.Bool(false), m);
    }
    if Mini.depth + c.nco >= vm.MAX_NESTING {
        let m = msg(c, "C stack overflow");
        if wrap { return Err(m); }
        return two(c, V.Bool(false), m);
    }
    if !co.started {
        let F(cl) = co.body else { return resume_native(c, co, args, n, wrap); };
        prepare(c, co, cl);
    }
    enter(c, co, false, wrap);
    var r: Result<V, V> = Ok(V.Nil);
    if co.started {
        c.fp = co.fp;
        c.ypc = co.ypc;
        c.ydst = co.ydst;
        c.ynres = co.ynres;
        r = Mini.resume(c, args, n);
    } else {
        co.started = true;
        let F(cl) = co.body else { unreachable };
        let nregs = cl.proto.nregs as u64;
        let base = c.stack;
        for i in 0..nregs { base[i] = if i < n { args[i] } else { V.Nil }; }
        c.frames.base = base;
        c.fp = c.frames;
        c.frames.cl = cl;
        r = Mini.call(c, c.frames, cl);
    }
    // Collect the results before the coroutine's stack can go away.
    let lead: u64 = if wrap { 0 } else { 1 };
    var first = V.Nil;
    var failed = false;
    match r {
        Ok(v) => {
            var src = c.xfer;
            var cnt = c.nxfer;
            if c.yielded {
                c.yielded = false;
                suspend(c, co, c.fp, c.ypc, c.ydst, c.ynres);
            } else {
                co.status = DEAD;
                if cnt == 1 { src = &v; }
            }
            let out = results(c, cnt + lead);
            if !wrap { out[0] = V.Bool(true); }
            for i in 0..cnt { out[lead + i] = src[i]; }
            c.nret = cnt + lead;
            first = if cnt + lead > 0 { out[0] } else { V.Nil };
        }
        Err(e) => {
            // Errors leave the coroutine dead; close what it left open.
            vm.close_upvals(c, c.stack);
            co.status = DEAD;
            co.err = e;
            c.rethrow = V.Nil;
            failed = true;
            first = e;
        }
    }
    leave(c, co);
    release_retired(co);
    if co.status == DEAD {
        let e = co.err;
        die(co);
        co.err = e;
    }
    if failed {
        if wrap {
            co.err = V.Nil;
            return Err(first);
        }
        return two(c, V.Bool(false), first);
    }
    Ok(first)
}
