// Runtime values of the Mini language: NaN-boxed values, and GC-managed
// strings, tables and function prototypes.

import std.gc;
import std.mem;
import std.hash;
import std.text;
import vm.{Mini};
import coro;
import coro.{Coro};

extern "C" fn snprintf(buf: *u8, n: u64, fmt: *u8, ...) -> i32;

pub object Str { hash: u64, data: [u8] }
pub object Arr { data: [V] }
/// A table: an array part holding keys 1..asize, and an open-addressing
/// hash part allocated on demand. The array part starts in the table's own
/// trailing storage (`inl`, sized by the constructor) and moves to a
/// separate `arr` when it grows; `aptr` points at whichever is in use and
/// `acap` is its capacity. Likewise `hptr` points into `hash` (or is null
/// when `hcap` is 0). Hash slots hold key/value pairs; a Nil key is an
/// empty slot, and a key with a Nil value is a tombstone (dropped on
/// rehash). Invariant: the hash part holds no non-nil value for keys
/// 1..asize+1.
pub object Table {
    asize: u64,
    acap: u64,
    aptr: *V,
    hcap: u64,
    hptr: *V,
    hused: u64,
    border: u64,
    arr: ?Gc<Arr>,
    hash: ?Gc<Arr>,
    inl: [V],
}
/// Source line of each instruction.
pub object Lines { data: [u32] }
/// Upvalue descriptors: bit 8 set means "register `low byte` of the
/// enclosing frame", otherwise "upvalue `low byte` of the enclosing closure".
pub object UpDescs { data: [u32] }
pub object Protos { data: [Gc<Proto>] }
/// A function prototype. `code` holds the bytecode, which only
/// Mini.build_verified writes: it verifies the words in place against
/// this prototype's nregs, nupvals and its constant and child counts
/// (compile.lm, `finish`), none of which change after. Every call jumps
/// to a `code`, so every function that runs was verified.
pub object Proto {
    name: Gc<Str>,
    nparams: u32,
    nregs: u32,
    nupvals: u32,
    consts: Gc<Arr>,
    lines: Gc<Lines>,
    protos: Gc<Protos>,
    updesc: Gc<UpDescs>,
    /// Reads as a `Verified<Mini>`; `jump p.code` is the array's address.
    code: verified [u32] by Mini,
}
/// A captured variable. While open, `v` points at the variable's stack
/// slot and `next` links the open list (sorted by level, highest first).
/// Closing copies the value into `closed` and points `v` at it.
/// `co` is the coroutine whose stack `v` points into while open: an open
/// upvalue keeps it alive (and so its stack, which it frees when it is
/// collected). Closing the upvalue drops it.
pub object UpVal { v: *V, closed: V, next: ?Gc<UpVal>, co: ?Gc<Coro> }
pub object Closure { proto: Gc<Proto>, upvals: [Gc<UpVal>] }

/// Eight tagged variants: seven 48-bit blocks and the one word of `Nil`
/// (`loimi build --explain-values`). The pins keep it so: `Int` shares its
/// block width with the pointers, so tuple tests such as `(T(t), Int(_))`
/// merge into one test, and a ninth variant would leave it alone.
pub value V repr nanbox {
    Num(f64) unboxed,
    Int(i32) block 48,
    Nil block 0,
    Bool(bool),
    S(Gc<Str>),
    T(Gc<Table>),
    F(Gc<Closure>),
    Native(i32),
    /// A coroutine (Lua's "thread"), or a function made by coroutine.wrap
    /// (a Coro whose `wrap` is the coroutine it resumes). One variant: an
    /// eighth keeps every other variant's 48-bit block (lowering.md §2).
    Co(Gc<Coro>),
}

/// The string intern table: every live Str, so equal strings are the
/// same object and string equality is identity. Open addressing over one
/// word per slot: the Str's address in the low 48 bits and the top 16
/// bits of its hash above them, so probes rarely touch the strings. 0 is
/// an empty slot and 1 a tombstone. Weak: a sweeper turns strings the
/// collector did not mark into tombstones. Reached through the heap's
/// `user` pointer. `buf` is a byte buffer kept between the natives that
/// build strings (`take_buf`). `young` holds the slot words of the
/// strings made since the last sweep (and of large survivors, which stay
/// young for one more collection): in a minor collection only those can
/// die, so the sweeper checks them instead of the whole table.
pub struct Strings { slots: *u64, cap: u64, live: u64, used: u64, buf: text.StrBuf, young: mem.Vec<u64> }

const TOMB: u64 = 1;
/// Prefetch distance of `sweep_strings`, in slots.
const PF: u64 = 16;
const ADDR: u64 = 0xFFFFFFFFFFFF;
const HTAG: u64 = 0xFFFF000000000000;

/// The Str in slot word `w`: its address with the tag bits of a `V.S`
/// (a Gc pointer can only be made from an integer through a value).
fn str_at(w: u64) -> Gc<Str> {
    let S(o) = ((w & ADDR) | V.S.tag) as V else { unreachable };
    o
}

/// Create the intern table and attach it to `h`.
pub fn init_strings(h: *gc.Heap) {
    let st: *Strings = mem.alloc(1);
    st.cap = 0;
    st.buf = text.StrBuf.new();
    st.young = mem.Vec.new();
    strings_resize(st, 1024);
    h.user = st as *u8;
    h.add_sweeper(st as *u8, sweep_strings);
}

/// Rehash into `cap` slots, dropping tombstones.
fn strings_resize(st: *Strings, cap: u64) {
    let old = st.slots;
    let n = st.cap;
    st.cap = cap;
    st.live = 0;
    st.used = 0;
    st.slots = mem.alloc(cap);
    mem.memset(st.slots as *u8, 0, cap * 8);
    let mask = cap - 1;
    for j in 0..n {
        let w = old[j];
        if w > TOMB {
            var i = str_at(w).hash & mask;
            while st.slots[i] != 0 { i = (i + 1) & mask; }
            st.slots[i] = w;
            st.live += 1;
            st.used += 1;
        }
    }
    if n > 0 { mem.release(old); }
}

/// Strings longer than this may be large objects (over 496 bytes with
/// the header), which are young until they survive two collections.
const YOUNG_LARGE: u64 = 400;

fn sweep_strings(h: *gc.Heap, data: *u8) {
    let st = data as *Strings;
    let slots = st.slots;
    let cap = st.cap;
    if h.is_minor() {
        // Old strings count as marked: only `young` ones can die. A dead
        // one is still intact here (no sweeper before this one reuses
        // memory), so its hash finds its slot.
        let mask = cap - 1;
        var keep: u64 = 0;
        for j in 0..st.young.len {
            let w = st.young.at(j);
            let o = str_at(w);
            if h.is_marked((w & ADDR) as *u8) {
                if o.data.len > YOUNG_LARGE {
                    st.young.set(keep, w);
                    keep += 1;
                }
            } else {
                var i = o.hash & mask;
                loop {
                    let x = slots[i];
                    if x == w {
                        slots[i] = TOMB;
                        st.live -= 1;
                        break;
                    }
                    if x == 0 { break; }
                    i = (i + 1) & mask;
                }
            }
        }
        st.young.truncate(keep);
        return;
    }
    st.young.clear();
    for i in 0..cap {
        // The live strings' headers are scattered over the heap: start
        // loading the one PF slots ahead (empty slots and tombstones
        // prefetch near address 0, which is harmless).
        if i + PF < cap { (((slots[i + PF] & ADDR) -% 16) as *u8).prefetch(); }
        let w = slots[i];
        if w > TOMB and !h.is_marked((w & ADDR) as *u8) {
            slots[i] = TOMB;
            st.live -= 1;
        }
    }
    if st.cap > 1024 and st.live * 8 < st.cap { strings_resize(st, st.cap / 2); }
}

/// An empty buffer to build a string in: the kept one if it is free
/// (saving a malloc and its regrowth per call), else a new one. Hand it
/// back with `give_buf` (or free it).
pub fn take_buf(h: *gc.Heap) -> text.StrBuf {
    let st = h.user as *Strings;
    var b = st.buf;
    st.buf = text.StrBuf.new();
    b.clear();
    b
}

/// Keep `b` for the next `take_buf` if none is kept, else free it.
pub fn give_buf(h: *gc.Heap, b: *text.StrBuf) {
    let st = h.user as *Strings;
    if st.buf.bytes.cap == 0 {
        st.buf = *b;
        *b = text.StrBuf.new();
    } else {
        b.free();
    }
}

pub fn new_str(h: *gc.Heap, s: str) -> Gc<Str> {
    let hv = hash.bytes(s);
    let st = h.user as *Strings;
    let slots = st.slots;
    let mask = st.cap - 1;
    let tag = hv & HTAG;
    var i = hv & mask;
    loop {
        let w = slots[i];
        if w == 0 { break; }
        if (w & HTAG) == tag and w != TOMB {
            let o = str_at(w);
            if o.data.len == s.len and mem.memcmp(o.data.ptr, s.ptr, s.len) == 0 { return o; }
        }
        i = (i + 1) & mask;
    }
    let o = new(h, Str { hash: hv }, s.len);
    mem.memcpy(o.data.ptr, s.ptr, s.len);
    slots[i] = (o as u64) | tag;
    st.young.push((o as u64) | tag);
    st.live += 1;
    st.used += 1;
    if st.used * 2 > st.cap {
        // Grow only if mostly live; otherwise just drop the tombstones.
        strings_resize(st, if st.live * 3 > st.cap { st.cap * 2 } else { st.cap });
    }
    o
}

/// The write barrier for stores into a table's array and hash parts.
/// Those go through raw pointers (`aptr`, `hptr`), which the compiler's
/// barrier does not see, into the table (inline array part) or its `arr`
/// and `hash` objects. One test of the table's own header: a table is
/// logged together with its parts (`log_table`), and the parts are never
/// older than the table (they are allocated after it), so while the
/// table needs no logging (young, or logged already) neither do they.
/// Call it also before replacing a part (`t.arr = ..`), so that the
/// compiler's barrier on that store does not log the table alone.
#[inline]
pub fn tbar(t: Gc<Table>) {
    if unlikely(gc.needs_barrier(t as *u8)) { log_table(t); }
}

#[inline(never)]
pub fn log_table(t: Gc<Table>) {
    gc.remember(t as *u8);
    if let Some(a) = t.arr { gc.remember(a as *u8); }
    if let Some(a) = t.hash { gc.remember(a as *u8); }
}

pub fn new_arr(h: *gc.Heap, n: u64) -> Gc<Arr> {
    let a = new(h, Arr {}, n);
    for i in 0..n { a.data[i] = V.Nil; }
    a
}

/// A closure without upvalues (the main chunk).
pub fn new_closure(h: *gc.Heap, p: Gc<Proto>) -> Gc<Closure> {
    new(h, Closure { proto: p }, 0)
}

pub fn new_table(h: *gc.Heap) -> Gc<Table> {
    new_table_sized(h, 0, 0)
}

/// A table with room for `narr` array items and `nhash` hash entries.
pub fn new_table_sized(h: *gc.Heap, narr: u64, nhash: u64) -> Gc<Table> {
    let t = new(h, Table { asize: 0, acap: narr, aptr: 0 as *V, hcap: 0, hptr: 0 as *V, hused: 0, border: 0, arr: None, hash: None }, narr);
    t.aptr = t.inl.ptr;
    for i in 0..narr { t.aptr[i] = V.Nil; }
    if nhash > 0 {
        var cap: u64 = 4;
        while nhash * 4 > cap * 3 { cap *= 2; }
        let hs = new_arr(h, cap * 2);
        t.hcap = cap;
        t.hash = Some(hs);
        t.hptr = hs.data.ptr;
    }
    t
}

pub fn truthy(v: V) -> bool {
    match v {
        Nil => false,
        Bool(b) => b,
        _ => true,
    }
}

pub fn type_name(v: V) -> str {
    match v {
        Num(_) | Int(_) => "number",
        Nil => "nil",
        Bool(_) => "boolean",
        S(_) => "string",
        T(_) => "table",
        F(_) | Native(_) => "function",
        Co(c) => if coro.is_wrap(c) { "function" } else { "thread" },
    }
}

/// Primitive equality: numbers by value, strings by content, others by identity.
#[inline]
pub fn is_number(v: V) -> bool {
    match v {
        Int(_) | Num(_) => true,
        _ => false,
    }
}

pub fn raw_equal(a: V, b: V) -> bool {
    match (a, b) {
        (Int(x), Int(y)) => x == y,
        (Num(x), Num(y)) => x == y,
        (Int(x), Num(y)) => x as f64 == y,
        (Num(x), Int(y)) => x == y as f64,
        _ => a == b,
    }
}

/// A float with an integral value in the Int range.
fn int_float(x: f64) -> bool {
    x == x.floor() and x >= -2147483648.0 and x <= 2147483647.0
}

/// The canonical form of a table key: integral floats become Int.
fn norm_key(k: V) -> V {
    if let Num(x) = k and int_float(x) { return V.Int(x as i32); }
    k
}

fn key_hash(k: V) -> u64 {
    match k {
        Int(i) => hash.mix(i as u64),
        Num(x) => hash.mix(x.to_bits()),
        S(s) => s.hash,
        _ => hash.mix(k as u64),
    }
}

/// Equality of normalized keys: identical bits (strings are interned).
fn key_eq(a: V, b: V) -> bool {
    a == b
}

/// Constants (the compiler's std.bc.Pool) are equal when their bits are:
/// strings are interned, and 1 and 1.0 stay apart.
pub fn V.hash(v: V) -> u64 { hash.mix(v as u64) }
pub fn V.eq(a: V, b: V) -> bool { a == b }
impl hash.Hash for V;

/// Index of the hash slot holding (normalized) key `k`, if present.
fn hash_find(t: Gc<Table>, k: V) -> ?u64 {
    if t.hcap == 0 { return None; }
    let slots = t.hptr;
    let mask = t.hcap - 1;
    var i = key_hash(k) & mask;
    loop {
        let key = slots[2 * i];
        if key == V.Nil { return None; }
        if key_eq(key, k) { return Some(i); }
        i = (i + 1) & mask;
    }
}

/// Lookup in the hash part only (`k` normalized).
pub fn hash_get(t: Gc<Table>, k: V) -> V {
    let Some(i) = hash_find(t, k) else { return V.Nil; };
    t.hptr[2 * i + 1]
}

/// t[k] for a string key `k` with hash `hv`.
pub fn hash_get_str(t: Gc<Table>, k: V, hv: u64) -> V {
    if t.hcap == 0 { return V.Nil; }
    let slots = t.hptr;
    let mask = t.hcap - 1;
    var i = hv & mask;
    loop {
        let key = slots[2 * i];
        if key == k { return slots[2 * i + 1]; }
        if key == V.Nil { return V.Nil; }
        i = (i + 1) & mask;
    }
}

/// Overwrite the value of string key `k` (hash `hv`) if it is present
/// (possibly as a tombstone); false if absent. The caller does the
/// write barrier (`tbar`) when it returns true.
#[inline]
pub fn hash_set_existing_nobar(t: Gc<Table>, k: V, hv: u64, v: V) -> bool {
    if t.hcap == 0 { return false; }
    let slots = t.hptr;
    let mask = t.hcap - 1;
    var i = hv & mask;
    loop {
        let key = slots[2 * i];
        if key == k { slots[2 * i + 1] = v; return true; }
        if key == V.Nil { return false; }
        i = (i + 1) & mask;
    }
}

/// The array index of an Int key `k`: its word minus the word of
/// Int(1). Payloads are stored zero-extended below the tag, so this is
/// i - 1 for i >= 1, and for i <= 0 it is beyond any array part (at
/// least 2^31 - 1). Saves sign-extending the payload.
pub fn int_index(k: V) -> u64 {
    (k as u64) -% (V.Int(1) as u64)
}

/// Int words xor this have no bits under `V.Int.mask` exactly for Ints
/// (the tag cancels out), and as unsigned numbers they are ordered like
/// the integers (the payload's sign bit is flipped). So two Ints are
/// tested and compared without extracting their payloads, whatever the
/// layout gives `Int` (`V.Int.mask` is the layout's).
pub fn int_bias() -> u64 {
    V.Int(-2147483648) as u64
}

pub fn table_get(t: Gc<Table>, k: V) -> V {
    var k = k;
    match k {
        Int(_) => {
            let u = int_index(k);
            if u < t.asize { return t.aptr[u]; }
        }
        Num(x) => {
            if int_float(x) {
                k = V.Int(x as i32);
                let u = ((x as i64) - 1) as u64;
                if u < t.asize { return t.aptr[u]; }
            }
        }
        _ => {}
    }
    hash_get(t, k)
}

/// Index of the hash slot holding key `k`, if present (for inline caches;
/// the slot's key and value are `t.hptr[2 * i]` and `[2 * i + 1]`).
pub fn table_find(t: Gc<Table>, k: V) -> ?u64 {
    hash_find(t, norm_key(k))
}

/// Rebuild the hash part with room for its live entries plus one,
/// dropping tombstones.
fn rehash(h: *gc.Heap, t: Gc<Table>) {
    var live: u64 = 0;
    let old = t.hptr;
    let n = t.hcap;
    for i in 0..n {
        if old[2 * i] != V.Nil and old[2 * i + 1] != V.Nil { live += 1; }
    }
    var cap: u64 = 4;
    while (live + 1) * 4 > cap * 3 { cap *= 2; }
    // `old` stays alive: it is only dropped from `t.hash` below, and
    // nothing here collects.
    let hs = new_arr(h, cap * 2);
    tbar(t);
    t.hcap = cap;
    t.hused = 0;
    t.hptr = hs.data.ptr;
    t.hash = Some(hs);
    for i in 0..n {
        let key = old[2 * i];
        let v = old[2 * i + 1];
        if key != V.Nil and v != V.Nil { hash_insert_new(t, key, v); }
    }
}

/// Insert a key known to be absent; there must be a free slot.
fn hash_insert_new(t: Gc<Table>, k: V, v: V) {
    let slots = t.hptr;
    let mask = t.hcap - 1;
    var i = key_hash(k) & mask;
    while slots[2 * i] != V.Nil { i = (i + 1) & mask; }
    slots[2 * i] = k;
    slots[2 * i + 1] = v;
    tbar(t);
    t.hused += 1;
}

fn hash_set(h: *gc.Heap, t: Gc<Table>, k: V, v: V) {
    // An existing key (or tombstone) is overwritten in place: no rehash,
    // so assigning to existing fields during traversal is safe.
    if let Some(i) = hash_find(t, k) {
        t.hptr[2 * i + 1] = v;
        tbar(t);
        return;
    }
    if v == V.Nil { return; }
    if (t.hused + 1) * 4 > t.hcap * 3 { rehash(h, t); }
    hash_insert_new(t, k, v);
}

/// Make room for `n` array items, moving the array part to a new `arr`.
fn array_grow(h: *gc.Heap, t: Gc<Table>, n: u64) {
    let na = new(h, Arr {}, n);
    let p = na.data.ptr;
    for i in 0..t.asize { p[i] = t.aptr[i]; }
    for i in t.asize..n { p[i] = V.Nil; }
    tbar(t);
    t.arr = Some(na);
    t.aptr = p;
    t.acap = n;
}

/// Whether t[asize+1] = v can be stored by `append_in_place`: room in the
/// array part, no hash part entries (so none for asize+2.. to move
/// over), and a value that is not nil.
#[inline]
pub fn can_append(t: Gc<Table>, v: V) -> bool {
    t.asize < t.acap and t.hused == 0 and v != V.Nil
}

/// t[asize+1] = v when `can_append`: no allocation, so no GC check.
/// The caller does the write barrier (`tbar`).
#[inline]
pub fn append_in_place(t: Gc<Table>, v: V) {
    t.aptr[t.asize] = v;
    t.asize += 1;
}

/// Append at asize+1, then move the following integer keys over from the hash.
fn array_append(h: *gc.Heap, t: Gc<Table>, v: V) {
    var v = v;
    loop {
        let cap = t.acap;
        if t.asize == cap { array_grow(h, t, if cap < 4 { 4 } else { cap * 2 }); }
        t.aptr[t.asize] = v;
        tbar(t);
        t.asize += 1;
        if t.hused == 0 { return; }
        let next = V.Int((t.asize + 1) as i32);
        let Some(i) = hash_find(t, next) else { return; };
        v = t.hptr[2 * i + 1];
        if v == V.Nil { return; }
        t.hptr[2 * i + 1] = V.Nil;
    }
}

/// Set a key (assigning nil removes it). `k` must not be nil or NaN.
pub fn table_set(h: *gc.Heap, t: Gc<Table>, k: V, v: V) {
    let k = norm_key(k);
    if let Int(_) = k {
        let u = int_index(k);
        if u < t.asize { t.aptr[u] = v; tbar(t); return; }
        if u == t.asize and v != V.Nil { array_append(h, t, v); return; }
    }
    hash_set(h, t, k, v);
}

/// Store `n` positional constructor items `vals[0..n]` at keys start+1...
pub fn table_setlist(h: *gc.Heap, t: Gc<Table>, vals: *V, n: u64, start: u64) {
    if t.hcap > 0 or t.asize < start {
        for i in 0..n { table_set(h, t, V.Int((start + i + 1) as i32), vals[i]); }
        return;
    }
    let end = start + n;
    if end > t.acap { array_grow(h, t, end); }
    for i in 0..n { t.aptr[start + i] = vals[i]; }
    tbar(t);
    if end > t.asize { t.asize = end; }
}

/// A border of `t`: 0 if t[1] is nil, else some n with t[n] ~= nil and t[n+1] == nil.
pub fn table_len(t: Gc<Table>) -> i64 {
    let n = t.asize;
    if n == 0 { return 0; }
    let a = t.aptr;
    // The hash never holds asize+1, so a full array part is a border.
    if a[n - 1] != V.Nil { return n as i64; }
    // Try the cached border and its neighbours (push/pop patterns).
    var j = t.border;
    if j >= n { j = n - 1; }
    if (j == 0 or a[j - 1] != V.Nil) and a[j] == V.Nil { return j as i64; }
    if j > 0 and a[j - 1] == V.Nil and (j == 1 or a[j - 2] != V.Nil) {
        t.border = j - 1;
        return (j - 1) as i64;
    }
    if j + 1 < n and a[j] != V.Nil and a[j + 1] == V.Nil {
        t.border = j + 1;
        return (j + 1) as i64;
    }
    // Binary search: t[lo] is non-nil (or lo == 0), t[hi] is nil.
    var lo: u64 = 0;
    var hi = n;
    while hi - lo > 1 {
        let m = (lo + hi) / 2;
        if a[m - 1] == V.Nil { hi = m; } else { lo = m; }
    }
    t.border = lo;
    lo as i64
}

/// Traversal: scan from position `i` (array part first, then hash slots)
/// for the next non-nil entry. Writes key and value to out[0], out[1] and
/// returns the position after it, or 0 at the end.
pub fn table_iter(t: Gc<Table>, i: u64, out: *V) -> u64 {
    var i = i;
    let a = t.aptr;
    while i < t.asize {
        let v = a[i];
        i += 1;
        if v != V.Nil {
            out[0] = V.Int(i as i32);
            out[1] = v;
            return i;
        }
    }
    let slots = t.hptr;
    var j = i - t.asize;
    while j < t.hcap {
        let key = slots[2 * j];
        let v = slots[2 * j + 1];
        j += 1;
        if key != V.Nil and v != V.Nil {
            out[0] = key;
            out[1] = v;
            return t.asize + j;
        }
    }
    0
}

pub fn to_num(v: V) -> ?f64 {
    match v {
        Int(i) => Some(i as f64),
        Num(x) => Some(x),
        _ => None,
    }
}

/// Number from a double: an Int when it is integral and fits.
pub fn number(x: f64) -> V {
    V.Num(x)
}

/// Append `v` converted as by Lua's `tostring`.
pub fn write_value(b: *text.StrBuf, v: V) {
    match v {
        Int(i) => b.push_int(i as i64),
        Num(x) => {
            var buf: [u8; 48] = [0; 48];
            let n = snprintf(&buf[0], 48, "%.14g\0".ptr, x) as u64;
            b.push_str(buf[0..n]);
            // Looks like an integer (only digits and '-')? Mark it as a float.
            var int_like = true;
            for i in 0..n {
                if buf[i] != '-' and !text.is_digit(buf[i]) { int_like = false; }
            }
            if int_like { b.push_str(".0"); }
        }
        Nil => b.push_str("nil"),
        Bool(x) => b.push_str(if x { "true" } else { "false" }),
        S(s) => b.push_str(s.data),
        T(t) => push_addr(b, "table: ", t as u64),
        F(c) => push_addr(b, "function: ", c as u64),
        Native(_) => b.push_str("function: builtin"),
        Co(c) => push_addr(b, if coro.is_wrap(c) { "function: " } else { "thread: " }, c as u64),
    }
}

fn push_addr(b: *text.StrBuf, prefix: str, addr: u64) {
    var buf: [u8; 48] = [0; 48];
    let n = snprintf(&buf[0], 48, "%p\0".ptr, addr as *u8) as u64;
    b.push_str(prefix);
    b.push_str(buf[0..n]);
}
