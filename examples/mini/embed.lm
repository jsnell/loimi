// Mini as a C library: the embedding API.
//
//   loimi build examples/mini/embed.lm --lib --header mini.h   # libembed.a
//   loimi build examples/mini/embed.lm --shared --header mini.h  # libembed.so
//
// examples/embed/host.c is a host program that uses it. This module only
// wraps the interpreter that main.lm runs standalone (state.lm, compile.lm,
// vm.lm); every `export "C"` function below is in the generated header.
//
// A `MiniState` is one interpreter: its own heap, globals and VM stack.
// Any number may be alive at once; each must be used by one thread at a
// time. Strings returned to C (`loimi_str`) point into the GC heap and
// stay valid until the next `mini_dostring` on that state.
//
// Natives (C functions registered with `mini_register`) run in the middle
// of a VM instruction, between two GC safepoints. While one runs, the
// host may use the argument and result functions and the global
// getters and setters of any state (they allocate but never collect), but
// not `mini_dostring`: re-entering the interpreter from a native is not
// supported and returns MiniStatus_Reenter (see docs/language.md §10).

import std.mem;
import std.text;
import value;
import value.{V};
import vm.{Mini, Ctx};
import vm;
import compile;
import state;

extern "C" fn strlen(s: *u8) -> u64;

/// What mini_dostring did (MiniStatus_Ok, ... in C).
enum MiniStatus: i32 { Ok, Syntax, Runtime, Reenter }

/// The type of a value (mini_get_type, mini_arg_type).
enum MiniType: i32 { Nil, Boolean, Number, String, Table, Function }

/// A C function callable from Mini: returns 0 with its result set by a
/// `mini_return_*` call (nil if none), or nonzero after `mini_raise`.
struct Native { f: fn(*MiniState, *u8) -> i32, ud: *u8 }

pub struct MiniState {
    /// First, so the VM's `*Ctx` is also the `*MiniState`.
    ctx: Ctx,
    natives: mem.Vec<Native>,
    /// The message of the last failed mini_dostring.
    err: text.StrBuf,
    /// The native running now: its arguments and result.
    args: *V,
    nargs: u64,
    ret: V,
}

/// Interpreter runs active on this thread. Nonzero while a native runs.
#[thread_local]
var running: u32 = 0;

fn cstr(p: *u8) -> str { p.slice(strlen(p)) }

fn key(s: *MiniState, name: *u8) -> V { V.S(value.new_str(&s.ctx.heap, cstr(name))) }

/// `vm.Ctx.host`: call registered native `id`.
fn host_call(c: *Ctx, id: i32, args: *V, n: u64) -> Result<V, V> {
    let s = c as *MiniState;
    let i = (id - vm.HOST_NATIVE) as u64;
    if i >= s.natives.len { return Err(V.S(value.new_str(&c.heap, "unknown native"))); }
    let nf = s.natives.at(i);
    let (sa, sn, sr) = (s.args, s.nargs, s.ret);
    s.args = args;
    s.nargs = n;
    s.ret = V.Nil;
    let status = nf.f(s, nf.ud);
    let r = s.ret;
    s.args = sa;
    s.nargs = sn;
    s.ret = sr;
    if status != 0 { Err(r) } else { Ok(r) }
}

fn type_of(v: V) -> MiniType {
    match v {
        Nil => MiniType.Nil,
        Bool(_) => MiniType.Boolean,
        Int(_) | Num(_) => MiniType.Number,
        S(_) => MiniType.String,
        T(_) => MiniType.Table,
        F(_) | Native(_) => MiniType.Function,
    }
}

fn as_str(v: V) -> str {
    match v {
        S(s) => s.data,
        _ => "",
    }
}

// ── states ──────────────────────────────────────────────────────────

/// A new interpreter with the standard library loaded.
export "C" fn mini_new() -> *MiniState {
    let s: *MiniState = mem.alloc(1);
    s.ctx = state.new_ctx(host_call);
    state.attach(&s.ctx);
    s.natives = mem.Vec.new();
    s.err = text.StrBuf.new();
    s.args = 0 as *V;
    s.nargs = 0;
    s.ret = V.Nil;
    s
}

/// Free the interpreter and everything in its heap.
export "C" fn mini_free(s: *MiniState) {
    state.free_ctx(&s.ctx);
    s.natives.free();
    s.err.free();
    mem.release(s);
}

/// Collect at every safepoint (to test GC rooting), or stop doing so.
export "C" fn mini_set_gc_stress(s: *MiniState, on: bool) { s.ctx.heap.set_stress(on); }

/// Collections so far.
export "C" fn mini_gc_count(s: *MiniState) -> u64 { s.ctx.heap.collections }

// ── running code ────────────────────────────────────────────────────

/// Compile and run `len` bytes of Mini source. On an error, the message
/// is in `mini_error`.
export "C" fn mini_dostring(s: *MiniState, src: *u8, len: u64) -> MiniStatus {
    s.err.clear();
    if running > 0 {
        s.err.push_str("mini_dostring called while Mini code is running (from a native): re-entry is not supported");
        return MiniStatus.Reenter;
    }
    let c = &s.ctx;
    let Some(proto) = compile.try_compile(&c.heap, "chunk", src.slice(len), &s.err) else { return MiniStatus.Syntax; };
    let cl = value.new_closure(&c.heap, proto);
    c.error = V.Nil;
    running += 1;
    Mini.run(c, cl);
    running -= 1;
    if c.error == V.Nil { return MiniStatus.Ok; }
    value.write_value(&s.err, c.error);
    c.error = V.Nil;
    // The run stopped mid-call: close what the dead frames left open.
    vm.close_upvals(c, c.stack);
    MiniStatus.Runtime
}

/// The message of the last failed `mini_dostring` (empty after success).
/// Valid until the next `mini_dostring` on this state.
export "C" fn mini_error(s: *MiniState) -> str { s.err.as_str() }

// ── globals ─────────────────────────────────────────────────────────

fn get(s: *MiniState, name: *u8) -> V { value.table_get(s.ctx.globals, key(s, name)) }

fn set(s: *MiniState, name: *u8, v: V) {
    let k = key(s, name);
    value.table_set(&s.ctx.heap, s.ctx.globals, k, v);
}

export "C" fn mini_set_number(s: *MiniState, name: *u8, x: f64) { set(s, name, V.Num(x)); }

export "C" fn mini_set_integer(s: *MiniState, name: *u8, x: i32) { set(s, name, V.Int(x)); }

export "C" fn mini_set_string(s: *MiniState, name: *u8, v: str) {
    let o = value.new_str(&s.ctx.heap, v);
    set(s, name, V.S(o));
}

export "C" fn mini_set_nil(s: *MiniState, name: *u8) { set(s, name, V.Nil); }

/// The type of global `name` (MiniType_Nil if unset).
export "C" fn mini_get_type(s: *MiniState, name: *u8) -> MiniType { type_of(get(s, name)) }

/// Global `name` as a double, if it is a number.
export "C" fn mini_get_number(s: *MiniState, name: *u8, out: *f64) -> bool {
    let Some(x) = value.to_num(get(s, name)) else { return false; };
    *out = x;
    true
}

/// Global `name` if it is a string, else { NULL, 0 }.
export "C" fn mini_get_string(s: *MiniState, name: *u8) -> str { as_str(get(s, name)) }

// ── natives ─────────────────────────────────────────────────────────

/// Make global `name` a function that calls `f(state, ud)`.
export "C" fn mini_register(s: *MiniState, name: *u8, f: fn(*MiniState, *u8) -> i32, ud: *u8) {
    let id = vm.HOST_NATIVE + s.natives.len as i32;
    s.natives.push(Native { f: f, ud: ud });
    set(s, name, V.Native(id));
}

fn arg(s: *MiniState, i: u64) -> V { if i < s.nargs { s.args[i] } else { V.Nil } }

/// In a native: the number of arguments.
export "C" fn mini_argc(s: *MiniState) -> u64 { s.nargs }

/// In a native: the type of argument `i` (from 0; MiniType_Nil past the end).
export "C" fn mini_arg_type(s: *MiniState, i: u64) -> MiniType { type_of(arg(s, i)) }

/// In a native: argument `i` as a double (0 if it is not a number).
export "C" fn mini_arg_number(s: *MiniState, i: u64) -> f64 {
    let Some(x) = value.to_num(arg(s, i)) else { return 0.0; };
    x
}

/// In a native: argument `i` if it is a string, else { NULL, 0 }.
export "C" fn mini_arg_string(s: *MiniState, i: u64) -> str { as_str(arg(s, i)) }

/// In a native: set the result.
export "C" fn mini_return_number(s: *MiniState, x: f64) { s.ret = V.Num(x); }

export "C" fn mini_return_integer(s: *MiniState, x: i32) { s.ret = V.Int(x); }

export "C" fn mini_return_bool(s: *MiniState, b: bool) { s.ret = V.Bool(b); }

export "C" fn mini_return_string(s: *MiniState, v: str) {
    let o = value.new_str(&s.ctx.heap, v);
    s.ret = V.S(o);
}

/// In a native: fail with `msg`. Returns 1, so `return mini_raise(S, m);`.
export "C" fn mini_raise(s: *MiniState, msg: str) -> i32 {
    let o = value.new_str(&s.ctx.heap, msg);
    s.ret = V.S(o);
    1
}
