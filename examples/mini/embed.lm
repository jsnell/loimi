// Mini as a C library: the embedding API.
//
//   loimi build examples/mini/embed.lm --lib --header mini.h   # libembed.a
//   loimi build examples/mini/embed.lm --shared --header mini.h  # libembed.so
//
// examples/embed/host.c is a host program that uses it. This module only
// wraps the interpreter that main.lm runs standalone (state.lm, compile.lm,
// vm.lm); every `export "C"` function below is in the generated header.
//
// A `MiniState` is one interpreter: its own heap, globals and VM stack.
// Any number may be alive at once; each must be used by one thread at a
// time. Strings returned to C (`loimi_str`) point into the GC heap: those
// from `mini_to_string` stay valid while their value is on the value
// stack, the others until Mini code next runs on that state.
//
// Natives (C functions registered with `mini_register`) run in the middle
// of a VM instruction. They may call back into Mini: `mini_call` calls a
// Mini function from the state's value stack (a global, an argument, ...)
// and `mini_dostring` runs a chunk, both as a nested run above the
// native's caller (`vm.call_value`; docs/language.md §10.1). Mini code
// may collect garbage there, which is why C never holds Mini values
// itself: they live on the value stack, a GC root, and C refers to them
// by position. Values a native pushes are popped when it returns. More
// than `vm.MAX_NESTING` nested runs on a thread fail with "C stack
// overflow". A native must not free its own state.
//
// Internal errors: a panic inside the interpreter (a bug, out of memory
// in a buffer, `mini_debug_panic`) is caught by `mini_dostring` and
// `mini_call`, which return `MiniStatus_Internal` instead of aborting the
// host (`#[catch_panic]`, docs/language.md §10.1). The state is then
// poisoned: `mini_error` says what happened, `mini_dostring` and
// `mini_call` return `MiniStatus_Internal` again, and the host should
// only `mini_free` it. Other states are unaffected. A state knows it is
// poisoned by counting: `busy` counts its API calls in progress and
// `in_native` its natives running; in C code they are equal unless a panic
// abandoned an API call. A native whose nested call came back poisoned
// re-panics when it returns, so the run it was called from stops too.

import std.gc;
import std.mem;
import std.rt;
import std.text;
import value;
import value.{V};
import vm.{Mini, Ctx};
import vm;
import compile;
import state;
import coro; #[cfg(debug)] import debugger; #[cfg(debug)] import debugger.{Dbg, Resume, Ref, RefKind}; #[cfg(debug)] import std.debug; // --cfg debug: the debugging API (at the end)
#[cfg(gil)]
import std.gil;
#[cfg(gil)]
import threads;

extern "C" fn strlen(s: *u8) -> u64;

/// What mini_dostring or mini_call did (MiniStatus_Ok, ... in C).
/// MiniStatus_Internal: an internal error; the state is poisoned.
enum MiniStatus: i32 { Ok, Syntax, Runtime, Internal }

/// The type of a value (mini_get_type, mini_arg_type).
enum MiniType: i32 { Nil, Boolean, Number, String, Table, Function, Thread }

/// A native callable from Mini: returns 0 with its result set by a
/// `mini_return_*` call (nil if none), or nonzero after `mini_raise`. It
/// may call back into Mini (`mini_call`, `mini_dostring`). A C native is
/// its function closed over its user data (`mini_register`).
type Native = closure fn(*MiniState) -> i32 uses reenter;

pub struct MiniState {
    /// First, so the VM's `*Ctx` is also the `*MiniState`.
    ctx: Ctx,
    natives: mem.Vec<Native>,
    /// The natives' environments.
    arena: mem.Arena,
    /// The message of the last failed mini_dostring or mini_call.
    err: text.StrBuf,
    /// The native running now: its arguments and result.
    args: *V,
    nargs: u64,
    ret: V,
    /// The value stack: Mini values the host refers to by position (a GC
    /// root, like `ret`).
    vals: mem.Vec<V>,
    /// API calls in progress on this state, and natives running (see the
    /// top of the file); `poisoned` once they disagree.
    busy: u32,
    in_native: u32,
    poisoned: bool,
}

/// Whether `s` is poisoned: an internal error abandoned one of its API
/// calls. Call only from functions C calls directly, outside `busy`.
fn poisoned(s: *MiniState) -> bool {
    if s.poisoned { return true; }
    if s.busy == s.in_native { return false; }
    s.poisoned = true;
    s.err.clear();
    s.err.push_str("internal error: ");
    s.err.push_str(rt.panic_message());
    true
}

/// GC roots of the API: the value stack and the pending result.
fn scan_api(h: *gc.Heap, s: *MiniState) {
    gc_mark(h, s.ret);
    for i in 0..s.vals.len { gc_mark(h, s.vals.at(i)); }
}

fn cstr(p: *u8) -> str { p.slice(strlen(p)) }

fn key(s: *MiniState, name: *u8) -> V { V.S(value.new_str(&s.ctx.heap, cstr(name))) }

/// `vm.Ctx.host`: call registered native `id`. A native may call back
/// into Mini, which may run another native: the outer one's arguments,
/// result and value stack are saved here (the saved result is a local,
/// rooted while the native runs).
fn host_call(c: *Ctx, id: i32, args: *V, n: u64) -> Result<V, V> uses reenter {
    let s = c as *MiniState;
    let i = (id - vm.HOST_NATIVE) as u64;
    if i >= s.natives.len { return Err(V.S(value.new_str(&c.heap, "unknown native"))); }
    let native = s.natives.at(i);
    let (sa, sn, sr) = (s.args, s.nargs, s.ret);
    let top = s.vals.len;
    s.args = args;
    s.nargs = n;
    s.ret = V.Nil;
    s.in_native += 1;
    let status = native(s);
    // A nested call that the native made on this state failed with an
    // internal error: stop this run as well.
    if poisoned(s) { rt.panic(s.err.as_str()); }
    s.in_native -= 1;
    let r = s.ret;
    s.args = sa;
    s.nargs = sn;
    s.ret = sr;
    s.vals.truncate(top);
    if status != 0 { Err(r) } else { Ok(r) }
}

fn type_of(v: V) -> MiniType {
    match v {
        Nil => MiniType.Nil,
        Bool(_) => MiniType.Boolean,
        Int(_) | Num(_) => MiniType.Number,
        S(_) => MiniType.String,
        T(_) => MiniType.Table,
        F(_) | Native(_) => MiniType.Function,
        Co(c) => if coro.is_wrap(c) { MiniType.Function } else { MiniType.Thread },
    }
}

fn as_str(v: V) -> str {
    match v {
        S(s) => s.data,
        _ => "",
    }
}

// ── threads sharing a state (`--cfg gil`) ───────────────────────────
//
// Built with `--cfg gil`, a state may be run by several threads, one at a
// time: it has a lock (std.gil), which the thread that created it holds
// at first. Every API call needs the lock. Other threads attach
// (`mini_thread_attach`, which waits for the lock) and detach; a native
// or the host lets go of the lock around blocking code
// (`mini_unlock`/`mini_lock`, Python's Py_BEGIN/END_ALLOW_THREADS), and
// the running code hands it over at loop back-edges and calls when
// another thread waits. Each thread has its own Mini thread (value and
// frame stacks, its main coroutine) and its own API value stack, native
// arguments and error message (threads.lm, `ApiThread`); globals, tables
// and functions are shared.

/// A thread's part of the API state, saved while another thread holds
/// the lock.
#[cfg(gil)]
struct ApiThread {
    core: threads.CtxThread,
    args: *V,
    nargs: u64,
    ret: V,
    vals: mem.Vec<V>,
    err: text.StrBuf,
    busy: u32,
    in_native: u32,
}

#[cfg(gil)]
fn new_api_thread() -> *ApiThread {
    let t: *ApiThread = mem.alloc(1);
    threads.init_thread(&t.core);
    t.ret = V.Nil;
    t.vals = mem.Vec.new();
    t.err = text.StrBuf.new();
    t
}

#[cfg(gil)]
fn api_save(d: *u8, td: *u8) {
    let s = d as *MiniState;
    let t = td as *ApiThread;
    threads.save(&s.ctx, &t.core);
    t.args = s.args;
    t.nargs = s.nargs;
    t.ret = s.ret;
    t.vals = s.vals;
    t.err = s.err;
    t.busy = s.busy;
    t.in_native = s.in_native;
}

#[cfg(gil)]
fn api_load(d: *u8, td: *u8) {
    let s = d as *MiniState;
    let t = td as *ApiThread;
    threads.load(&s.ctx, &t.core);
    s.args = t.args;
    s.nargs = t.nargs;
    s.ret = t.ret;
    s.vals = t.vals;
    s.err = t.err;
    s.busy = t.busy;
    s.in_native = t.in_native;
}

#[cfg(gil)]
fn api_scan(h: *gc.Heap, d: *u8, td: *u8) {
    let t = td as *ApiThread;
    threads.scan(h, &t.core);
    gc_mark(h, t.ret);
    for i in 0..t.vals.len { gc_mark(h, t.vals.at(i)); }
}

/// Built with `--cfg gil`: attach the calling thread to `s` and wait for
/// the lock. The thread gets a Mini thread of its own (stacks, API value
/// stack); it must not be attached already.
#[cfg(gil)]
export "C" fn mini_thread_attach(s: *MiniState) uses gc {
    s.ctx.gil.attach(new_api_thread() as *u8);
}

/// Built with `--cfg gil`: detach the calling thread, which holds the
/// lock, and let go of it. False (and nothing done) for the thread that
/// created the state, which stays attached until `mini_free`, or while
/// Mini code runs on the thread (from a native).
#[cfg(gil)]
export "C" fn mini_thread_detach(s: *MiniState) -> bool {
    let g = s.ctx.gil;
    let t = g.holder().data as *ApiThread;
    if !t.core.owned or s.ctx.base != 0 as *vm.Frame { return false; }
    s.vals.free();
    s.err.free();
    threads.save(&s.ctx, &t.core);
    threads.release(&t.core);
    mem.release(t);
    g.detach();
    true
}

/// Built with `--cfg gil`: let go of the lock, before code that blocks
/// (in a native, or in the host between calls). Until `mini_lock`, the
/// thread must not call the API.
#[cfg(gil)]
export "C" fn mini_unlock(s: *MiniState) uses gc { s.ctx.gil.unlock(); }

/// Built with `--cfg gil`: take the lock back after `mini_unlock`
/// (waiting for it).
#[cfg(gil)]
export "C" fn mini_lock(s: *MiniState) uses gc { s.ctx.gil.lock(); }

/// Built with `--cfg gil`: how many times the lock changed hands.
#[cfg(gil)]
export "C" fn mini_lock_switches(s: *MiniState) -> u64 { s.ctx.gil.switches() }

// ── states ──────────────────────────────────────────────────────────

/// A new interpreter with the standard library loaded; NULL if out of
/// memory.
#[catch_panic]
export "C" fn mini_new() -> ?*MiniState {
    let s: *MiniState = mem.alloc(1);
    s.ctx = state.new_ctx(host_call);
    state.attach(&s.ctx);
    // The creating thread's record holds the API's part too.
    #[cfg(gil)]
    {
        let t = new_api_thread();
        t.core.fresh = false;
        let me = s.ctx.gil.holder();
        mem.release(me.data);
        me.data = t as *u8;
        s.ctx.gil.set_hooks(gil.Hooks { data: s as *u8, save: api_save, load: api_load, scan: api_scan });
    }
    s.ctx.heap.add_scanner(s, scan_api);
    s.natives = mem.Vec.new();
    s.arena = mem.Arena.new();
    s.err = text.StrBuf.new();
    s.args = 0 as *V;
    s.nargs = 0;
    s.ret = V.Nil;
    s.vals = mem.Vec.new();
    s.busy = 0;
    s.in_native = 0;
    s.poisoned = false;
    Some(s)
}

/// Free the interpreter and everything in its heap.
export "C" fn mini_free(s: *MiniState) {
    state.free_ctx(&s.ctx);
    s.natives.free();
    s.arena.free();
    s.vals.free();
    s.err.free();
    mem.release(s);
}

/// Collect at every safepoint (to test GC rooting), or stop doing so.
export "C" fn mini_set_gc_stress(s: *MiniState, on: bool) { s.ctx.heap.set_stress(on); }

/// Fail with an internal error with message `msg`, as a bug in the
/// interpreter would: for testing a host's error handling. The innermost
/// `mini_dostring` or `mini_call` on the thread returns
/// `MiniStatus_Internal`, and `s` is poisoned.
export "C" fn mini_debug_panic(s: *MiniState, msg: str) {
    s.busy += 1;
    rt.panic(msg);
}

/// Collections so far.
export "C" fn mini_gc_count(s: *MiniState) -> u64 { s.ctx.heap.collections }

// ── running code ────────────────────────────────────────────────────

/// Compile and run `len` bytes of Mini source. On an error, the message
/// is in `mini_error`. From a native, the chunk runs nested above it.
#[catch_panic(Internal)]
export "C" fn mini_dostring(s: *MiniState, src: *u8, len: u64) -> MiniStatus uses reenter {
    if poisoned(s) { return MiniStatus.Internal; }
    s.busy += 1;
    let r = dostring(s, src, len);
    s.busy -= 1;
    r
}

fn dostring(s: *MiniState, src: *u8, len: u64) -> MiniStatus uses reenter {
    s.err.clear();
    let c = &s.ctx;
    let Some(proto) = compile.try_compile(&c.heap, "chunk", src.slice(len), &s.err) else { return MiniStatus.Syntax; };
    let cl = value.new_closure(&c.heap, proto);
    match vm.call_value(c, V.F(cl), 0 as *V, 0) {
        Ok(_) => MiniStatus.Ok,
        Err(e) => {
            s.err.clear();
            value.write_value(&s.err, e);
            MiniStatus.Runtime
        }
    }
}

/// The message of the last failed `mini_dostring` or `mini_call` (empty
/// after a successful one). Valid until the next call that runs Mini code
/// on this state.
export "C" fn mini_error(s: *MiniState) -> str {
    poisoned(s);
    s.err.as_str()
}

// ── the value stack and calls ───────────────────────────────────────
//
// Positions count from 0 at the bottom; negative ones from the top (-1
// is the top). Inside a native, the stack starts out as the caller left
// it, and what the native pushes is popped when it returns.

fn push(s: *MiniState, v: V) {
    s.busy += 1;
    s.vals.push(v);
    s.busy -= 1;
}

/// The value at position `i`, if there is one.
fn slot(s: *MiniState, i: i64) -> ?V {
    let n = s.vals.len as i64;
    let j = if i < 0 { n + i } else { i };
    if j < 0 or j >= n { return None; }
    Some(s.vals.at(j as u64))
}

/// Values on the stack.
export "C" fn mini_top(s: *MiniState) -> u64 { s.vals.len }

/// Pop `n` values (all, if there are fewer).
export "C" fn mini_pop(s: *MiniState, n: u64) {
    let len = s.vals.len;
    s.vals.truncate(if n > len { 0 } else { len - n });
}

/// Push global `name` (nil if unset).
export "C" fn mini_push_global(s: *MiniState, name: *u8) { push(s, get(s, name)); }

/// In a native: push argument `i` (from 0; nil past the end).
export "C" fn mini_push_arg(s: *MiniState, i: u64) { push(s, arg(s, i)); }

export "C" fn mini_push_nil(s: *MiniState) { push(s, V.Nil); }

export "C" fn mini_push_number(s: *MiniState, x: f64) { push(s, V.Num(x)); }

export "C" fn mini_push_integer(s: *MiniState, x: i32) { push(s, V.Int(x)); }

export "C" fn mini_push_string(s: *MiniState, v: str) {
    let o = value.new_str(&s.ctx.heap, v);
    push(s, V.S(o));
}

/// The type of the value at `i` (MiniType_Nil if there is none).
export "C" fn mini_type(s: *MiniState, i: i64) -> MiniType {
    match slot(s, i) {
        Some(v) => type_of(v),
        None => MiniType.Nil,
    }
}

/// The value at `i` as a double, if it is a number.
export "C" fn mini_to_number(s: *MiniState, i: i64, out: *f64) -> bool {
    let Some(v) = slot(s, i) else { return false; };
    let Some(x) = value.to_num(v) else { return false; };
    *out = x;
    true
}

/// The value at `i` if it is a string, else { NULL, 0 }. Valid while the
/// value is on the stack.
export "C" fn mini_to_string(s: *MiniState, i: i64) -> str {
    match slot(s, i) {
        Some(v) => as_str(v),
        None => "",
    }
}

/// Call a function with `nargs` arguments: pops them and the function
/// below them, then pushes the result (MiniStatus_Ok) or the error value
/// (MiniStatus_Runtime; its message is also in `mini_error`). From a
/// native, the call runs nested above the native's caller; from the host
/// between runs, it is a run of its own.
#[catch_panic(Internal)]
export "C" fn mini_call(s: *MiniState, nargs: u64) -> MiniStatus uses reenter {
    if poisoned(s) { return MiniStatus.Internal; }
    s.busy += 1;
    let r = call(s, nargs);
    s.busy -= 1;
    r
}

fn call(s: *MiniState, nargs: u64) -> MiniStatus uses reenter {
    s.err.clear();
    let len = s.vals.len;
    if nargs >= len {
        s.err.push_str("mini_call: no function below the arguments");
        push(s, V.S(value.new_str(&s.ctx.heap, s.err.as_str())));
        return MiniStatus.Runtime;
    }
    let at = len - nargs - 1;
    let f = s.vals.at(at);
    // The function and arguments stay on the stack (rooted) until
    // call_value has copied the arguments into the new frame.
    let r = vm.call_value(&s.ctx, f, s.vals.ptr + at + 1, nargs);
    s.vals.truncate(at);
    match r {
        Ok(v) => {
            push(s, v);
            MiniStatus.Ok
        }
        Err(e) => {
            // Nested calls that failed on the way wrote theirs.
            s.err.clear();
            value.write_value(&s.err, e);
            push(s, e);
            MiniStatus.Runtime
        }
    }
}

/// In a native: pop the top value and make it the result.
export "C" fn mini_return_top(s: *MiniState) {
    if let Some(v) = s.vals.pop() { s.ret = v; }
}

/// In a native: pop the top value and fail with it. Returns 1, so
/// `return mini_raise_top(S);`. An error value from `mini_call` passes
/// through unchanged (its message already has its line).
export "C" fn mini_raise_top(s: *MiniState) -> i32 {
    if let Some(v) = s.vals.pop() { s.ret = v; }
    1
}

// ── globals ─────────────────────────────────────────────────────────

fn get(s: *MiniState, name: *u8) -> V { value.table_get(s.ctx.globals, key(s, name)) }

fn set(s: *MiniState, name: *u8, v: V) {
    let k = key(s, name);
    value.table_set(&s.ctx.heap, s.ctx.globals, k, v);
}

export "C" fn mini_set_number(s: *MiniState, name: *u8, x: f64) { set(s, name, V.Num(x)); }

export "C" fn mini_set_integer(s: *MiniState, name: *u8, x: i32) { set(s, name, V.Int(x)); }

export "C" fn mini_set_string(s: *MiniState, name: *u8, v: str) {
    let o = value.new_str(&s.ctx.heap, v);
    set(s, name, V.S(o));
}

export "C" fn mini_set_nil(s: *MiniState, name: *u8) { set(s, name, V.Nil); }

/// The type of global `name` (MiniType_Nil if unset).
export "C" fn mini_get_type(s: *MiniState, name: *u8) -> MiniType { type_of(get(s, name)) }

/// Global `name` as a double, if it is a number.
export "C" fn mini_get_number(s: *MiniState, name: *u8, out: *f64) -> bool {
    let Some(x) = value.to_num(get(s, name)) else { return false; };
    *out = x;
    true
}

/// Global `name` if it is a string, else { NULL, 0 }.
export "C" fn mini_get_string(s: *MiniState, name: *u8) -> str { as_str(get(s, name)) }

// ── natives ─────────────────────────────────────────────────────────

/// Make global `name` a function that calls `f(state, ud)`.
export "C" fn mini_register(s: *MiniState, name: *u8, f: fn(*MiniState, *u8) -> i32 uses reenter, ud: *u8) {
    s.busy += 1;
    let id = vm.HOST_NATIVE + s.natives.len as i32;
    s.natives.push(new(&s.arena, |st| f(st, ud)));
    s.busy -= 1;
    set(s, name, V.Native(id));
}

fn arg(s: *MiniState, i: u64) -> V { if i < s.nargs { s.args[i] } else { V.Nil } }

/// In a native: the number of arguments.
export "C" fn mini_argc(s: *MiniState) -> u64 { s.nargs }

/// In a native: the type of argument `i` (from 0; MiniType_Nil past the end).
export "C" fn mini_arg_type(s: *MiniState, i: u64) -> MiniType { type_of(arg(s, i)) }

/// In a native: argument `i` as a double (0 if it is not a number).
export "C" fn mini_arg_number(s: *MiniState, i: u64) -> f64 {
    let Some(x) = value.to_num(arg(s, i)) else { return 0.0; };
    x
}

/// In a native: argument `i` if it is a string, else { NULL, 0 }.
export "C" fn mini_arg_string(s: *MiniState, i: u64) -> str { as_str(arg(s, i)) }

/// In a native: set the result.
export "C" fn mini_return_number(s: *MiniState, x: f64) { s.ret = V.Num(x); }

export "C" fn mini_return_integer(s: *MiniState, x: i32) { s.ret = V.Int(x); }

export "C" fn mini_return_bool(s: *MiniState, b: bool) { s.ret = V.Bool(b); }

export "C" fn mini_return_string(s: *MiniState, v: str) {
    let o = value.new_str(&s.ctx.heap, v);
    s.ret = V.S(o);
}

/// In a native: fail with `msg`. Returns 1, so `return mini_raise(S, m);`.
export "C" fn mini_raise(s: *MiniState, msg: str) -> i32 {
    let o = value.new_str(&s.ctx.heap, msg);
    s.ret = V.S(o);
    1
}

// ── debugging (`--cfg debug`) ───────────────────────────────────────
//
// Mini's debugging API, in the C library built with `--cfg debug`:
//
//   loimi build --cfg debug examples/mini/embed.lm --lib --header mini.h
//
// A host (an editor's debug adapter: examples/mini/dap) attaches a stop
// callback to a state, loads chunks through `mini_debug_load` (so that
// the debugger knows their lines and locals), sets breakpoints by file
// and line, and runs the chunk with `mini_call`. Each time the program
// stops (at entry, a breakpoint, the end of a step, a pause, an uncaught
// error), the callback runs on the interpreter's thread, inside the
// instruction where it stopped. From there, and only there, the host may
// query the stack (`mini_debug_depth`, `mini_debug_frame`), variables
// (`mini_debug_scope`, `mini_debug_variables`, tables expanded lazily
// through handles), evaluate expressions (`mini_debug_eval`), and set or
// delete breakpoints; it returns how to go on (`MiniResume`). It must not
// call `mini_dostring` or `mini_call` there.
//
// `mini_debug_pause` is the only call another thread may make while the
// program runs: it sets a flag that the running code polls at loop
// back-edges and calls (one relaxed load each, in debug builds only), and
// the program then stops at the next instruction with MiniStop_Pause. A
// host that needs the program stopped for its own work (new breakpoints
// from the editor while it runs) pauses it the same way and returns
// MiniResume_Keep, which continues as before (a `next` in progress goes
// on).
//
// Breakpoint conditions are Mini expressions evaluated in the stopped
// frame (its locals, upvalues and the globals), as is `mini_debug_eval`:
// the expression is compiled as a function of those variables and run
// nested above the frame, with every breakpoint taken out of the code
// meanwhile, so that it neither stops nor disturbs the step-over of the
// instruction the program is stopped at (debugger.lm, `Dbg.eval_at`;
// docs/design/debugging.md section 9).
//
// Strings returned to C are valid until the next `mini_debug_*` call on
// the state (names of functions and chunks: while the program is
// stopped); those passed to the variable callback, during the call.

#[cfg(debug)]
/// Why the program stopped (the stop callback's `reason`).
enum MiniStop: i32 { Entry, Breakpoint, Step, Pause, Error }

#[cfg(debug)]
/// What the program does after a stop: run to the next breakpoint, step
/// into calls, step over them, run until the function returns, or
/// (after a pause the host made for itself) whatever it was doing.
enum MiniResume: i32 { Continue, Step, Next, Finish, Keep }

#[cfg(debug)]
/// The variables of a frame (`mini_debug_scope`).
enum MiniScope: i32 { Locals, Globals }

#[cfg(debug)]
/// The stop callback: `bp` is the breakpoint's id (reason Breakpoint).
type StopCb = fn(*MiniState, *u8, MiniStop, u32) -> MiniResume uses reenter;

#[cfg(debug)]
struct Host { s: *MiniState, cb: StopCb, ud: *u8 }

#[cfg(debug)]
fn host_stop(d: *Dbg, data: *u8) -> Resume uses reenter {
    let h = data as *Host;
    let Some(st) = d.at else { return Resume.Continue; };
    let reason = match st.reason {
        Entry => MiniStop.Entry,
        Breakpoint => MiniStop.Breakpoint,
        Step => MiniStop.Step,
        Pause => MiniStop.Pause,
        Error => MiniStop.Error,
    };
    let cb = h.cb;
    match cb(h.s, h.ud, reason, st.bp) {
        Continue => Resume.Continue,
        Step => Resume.Step,
        Next => Resume.Next,
        Finish => Resume.Finish,
        Keep => Resume.Keep,
    }
}

#[cfg(debug)]
fn dbg(s: *MiniState) -> ?*Dbg { s.ctx.dbg }

#[cfg(debug)]
/// Debug `s`: `cb(s, ud, reason, bp)` runs at each stop. Globals set so
/// far (the library, natives registered before) are left out of the
/// globals scope.
export "C" fn mini_debug_attach(s: *MiniState, cb: fn(*MiniState, *u8, MiniStop, u32) -> MiniResume uses reenter, ud: *u8) {
    if let Some(d) = dbg(s) {
        let h = d.data as *Host;
        h.cb = cb;
        h.ud = ud;
        return;
    }
    let h: *Host = s.arena.alloc_bytes(size_of<Host>(), 8) as *Host;
    *h = Host { s: s, cb: cb, ud: ud };
    debugger.attach(&s.ctx, host_stop, h as *u8);
}

#[cfg(debug)]
/// Compile `src` as chunk `name` (the file name breakpoints and frames
/// use) and push it as a function, for `mini_call`. Breakpoints set
/// before apply to it. On a syntax error, nothing is pushed and the
/// message is in `mini_error`. Needs `mini_debug_attach` first.
export "C" fn mini_debug_load(s: *MiniState, name: str, src: str) -> MiniStatus {
    s.err.clear();
    let Some(d) = dbg(s) else {
        s.err.push_str("mini_debug_load: no debugger attached");
        return MiniStatus.Runtime;
    };
    // The debugger keeps the chunk (names of locals point into it).
    let n = s.arena.str(name);
    let t = s.arena.str(src);
    let Some(p) = d.load(n, t, &s.err) else { return MiniStatus.Syntax; };
    s.vals.push(V.F(value.new_closure(&s.ctx.heap, p)));
    MiniStatus.Ok
}

#[cfg(debug)]
/// Stop (MiniStop_Entry) before the first instruction of the chunk
/// loaded last.
export "C" fn mini_debug_stop_on_entry(s: *MiniState) {
    let Some(d) = dbg(s) else { return; };
    if d.chunks.len == 0 { return; }
    d.break_at_entry(d.chunks.at(d.chunks.len - 1).main);
}

#[cfg(debug)]
/// Stop (MiniStop_Error) at an error that nothing catches, before it
/// unwinds: the message is in `mini_debug_message`, and the frames are
/// those of the error. The error goes on once the program continues.
export "C" fn mini_debug_break_on_error(s: *MiniState, on: bool) {
    if let Some(d) = dbg(s) { d.break_on_error = on; }
}

#[cfg(debug)]
/// A breakpoint at line `line` of chunk `file` (by its last path
/// component), in code loaded now or later: its id.
export "C" fn mini_debug_set_break(s: *MiniState, file: str, line: u32) -> u32 {
    let Some(d) = dbg(s) else { return 0; };
    d.add_break(s.arena.str(file), line, false)
}

#[cfg(debug)]
/// Give breakpoint `id` a condition and a hit condition. `cond` ("" for
/// none) is a Mini expression that must be true for it to stop; `hit`
/// ("" for none) is on the number of hits where `cond` held: "N" or
/// "== N" (the Nth), ">= N", "> N", "<= N", "< N", "% N" (every Nth).
/// False if there is no such breakpoint or `hit` is not a hit condition.
export "C" fn mini_debug_condition(s: *MiniState, id: u32, cond: str, hit: str) -> bool {
    let Some(d) = dbg(s) else { return false; };
    let Some(h) = debug.parse_hit_condition(hit) else { return false; };
    d.bps.set_condition(id, cond, h)
}

#[cfg(debug)]
/// The instructions breakpoint `id` is set at (0: no code at its line
/// yet, or no such breakpoint).
export "C" fn mini_debug_break_sites(s: *MiniState, id: u32) -> u32 {
    let Some(d) = dbg(s) else { return 0; };
    let Some(b) = d.bps.bp(id) else { return 0; };
    b.nsites
}

#[cfg(debug)]
/// The first line at or after `line` that has code in chunk `file`, 0 if
/// none: where to move a breakpoint set on a blank line.
export "C" fn mini_debug_code_line(s: *MiniState, file: str, line: u32) -> u32 {
    let Some(d) = dbg(s) else { return 0; };
    d.code_line(file, line)
}

#[cfg(debug)]
/// Delete breakpoint `id` (false if there is none).
export "C" fn mini_debug_delete(s: *MiniState, id: u32) -> bool {
    let Some(d) = dbg(s) else { return false; };
    d.bps.delete(id)
}

#[cfg(debug)]
/// Stop the running program soon (MiniStop_Pause). Safe from any thread;
/// a request made while it is stopped is dropped when it continues.
export "C" fn mini_debug_pause(s: *MiniState) { debugger.pause(&s.ctx); }

// ── at a stop ───────────────────────────────────────────────────────

#[cfg(debug)]
/// At a stop: the error (MiniStop_Error), or why a breakpoint's condition
/// failed to evaluate (MiniStop_Breakpoint); else empty.
export "C" fn mini_debug_message(s: *MiniState) -> str {
    let Some(d) = dbg(s) else { return ""; };
    d.msg.as_str()
}

#[cfg(debug)]
/// At a stop: the number of frames (0 if not stopped).
export "C" fn mini_debug_depth(s: *MiniState) -> u32 {
    let Some(d) = dbg(s) else { return 0; };
    d.depth()
}

#[cfg(debug)]
/// At a stop: frame `level` (0 the innermost): its function's name
/// ("main chunk" for a chunk), chunk name and line. False if there is no
/// such frame.
export "C" fn mini_debug_frame(s: *MiniState, level: u32, func: *str, file: *str, line: *u32) -> bool {
    let Some(d) = dbg(s) else { return false; };
    let Some((f, ch, l)) = d.frame_info(level) else { return false; };
    *func = f;
    *file = ch;
    *line = l;
    true
}

#[cfg(debug)]
/// At a stop: the handle of a scope of frame `level`, for
/// `mini_debug_variables` (0 if there is no such frame). Handles are
/// valid until the program continues.
export "C" fn mini_debug_scope(s: *MiniState, level: u32, scope: MiniScope) -> u32 {
    let Some(d) = dbg(s) else { return 0; };
    if d.frame(level).is_none() { return 0; }
    match scope {
        Locals => d.ref_of(Ref { kind: RefKind.Locals, level: level, v: V.Nil }),
        Globals => d.ref_of(Ref { kind: RefKind.Globals, level: 0, v: V.Nil }),
    }
}

#[cfg(debug)]
/// At a stop: call `f(ud, name, value, child)` for the variables
/// of `handle` from number `start`, at most `count` of them (0: all).
/// `value` is shown as the debugger shows values (strings quoted, tables
/// as "table (N entries)"); `child` is the handle of a table's entries
/// (0 for other values). Returns the number of variables in all (0 for a
/// bad handle).
export "C" fn mini_debug_variables(s: *MiniState, handle: u32, start: u32, count: u32, f: fn(*u8, str, str, u32), ud: *u8) -> u32 {
    let Some(d) = dbg(s) else { return 0; };
    d.variables(handle, start, count, f, ud)
}

#[cfg(debug)]
/// At a stop: evaluate `expr` in frame `level` (its locals and upvalues,
/// as copies, and the globals): an expression, or else a statement (an
/// assignment to a global, a call). MiniStatus_Ok with `*out` the
/// result as shown and `*child` its handle (as for variables), or
/// MiniStatus_Runtime with `*out` the error message. The code runs
/// with breakpoints off.
export "C" fn mini_debug_eval(s: *MiniState, level: u32, expr: str, out: *str, child: *u32) -> MiniStatus uses reenter {
    *out = "";
    *child = 0;
    let Some(d) = dbg(s) else { return MiniStatus.Runtime; };
    if d.at.is_none() { *out = "not stopped"; return MiniStatus.Runtime; }
    let r = d.eval(level, expr, true);
    d.out.clear();
    match r {
        Ok(v) => {
            debugger.render(&d.out, v);
            *child = d.child_ref(v);
            *out = unsafe { d.out.as_str() }; // lent to C until the next mini_debug_* call (above)
            MiniStatus.Ok
        }
        Err(e) => {
            value.write_value(&d.out, e);
            *out = unsafe { d.out.as_str() }; // lent to C until the next mini_debug_* call (above)
            MiniStatus.Runtime
        }
    }
}
