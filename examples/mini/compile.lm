// Mini compiler: source text → register bytecode, in a single pass.
// Expressions are tracked as descriptors (as in Lua's expdesc) so that
// values are only materialized in a register when needed.

import std.io;
import std.mem;
import std.text;
import std.gc;
import std.os;
import std.hash;
import std.map;
import value;
import value.{V, Str, Arr, Table, Proto, Lines, Protos, UpDescs};
import vm.{Mini};

// ── lexer ────────────────────────────────────────────────────────────

enum T {
    Eof, Name, Number, String,
    And, Break, Do, Else, Elseif, End, False, For, Function, If, In, Local, Nil, Not, Or, Repeat, Return, Then, True, Until, While,
    Plus, Minus, Star, Slash, Percent, Caret, Hash, Concat, Eq, Ne, Lt, Le, Gt, Ge, Assign,
    LParen, RParen, LBrace, RBrace, LBracket, RBracket, Comma, Dot, Colon, Semi,
}

struct Token { kind: T, text: str, line: u32, num: V }

struct Lexer { src: str, pos: u64, line: u32 }

fn keyword(s: str) -> T {
    if s.eq("and") { return T.And; }
    if s.eq("break") { return T.Break; }
    if s.eq("do") { return T.Do; }
    if s.eq("else") { return T.Else; }
    if s.eq("elseif") { return T.Elseif; }
    if s.eq("end") { return T.End; }
    if s.eq("false") { return T.False; }
    if s.eq("for") { return T.For; }
    if s.eq("function") { return T.Function; }
    if s.eq("if") { return T.If; }
    if s.eq("in") { return T.In; }
    if s.eq("local") { return T.Local; }
    if s.eq("nil") { return T.Nil; }
    if s.eq("not") { return T.Not; }
    if s.eq("or") { return T.Or; }
    if s.eq("repeat") { return T.Repeat; }
    if s.eq("return") { return T.Return; }
    if s.eq("then") { return T.Then; }
    if s.eq("true") { return T.True; }
    if s.eq("until") { return T.Until; }
    if s.eq("while") { return T.While; }
    T.Name
}

fn Lexer.peek(lx: *Lexer, off: u64) -> u8 {
    if lx.pos + off < lx.src.len { lx.src[lx.pos + off] } else { 0 }
}

fn fail(line: u32, msg: str) -> never {
    io.eprint("syntax error on line ");
    var b = text.StrBuf.new();
    b.push_int(line as i64);
    b.push_str(": ");
    b.push_str(msg);
    io.eprintln(b.as_str());
    os.quit(1)
}

fn hex_digit(c: u8) -> ?u64 {
    if text.is_digit(c) { return Some((c - '0') as u64); }
    if c >= 'a' and c <= 'f' { return Some((c - 'a') as u64 + 10); }
    if c >= 'A' and c <= 'F' { return Some((c - 'A') as u64 + 10); }
    None
}

/// The level (number of `=`) of a long bracket `[==[` at the current position.
fn Lexer.long_bracket(lx: *Lexer) -> ?u64 {
    if lx.peek(0) != '[' { return None; }
    var n: u64 = 0;
    while lx.peek(1 + n) == '=' { n += 1; }
    if lx.peek(1 + n) == '[' { Some(n) } else { None }
}

/// Skip a long bracket of the given level, starting at its opening `[`.
fn Lexer.skip_long(lx: *Lexer, level: u64) {
    let line = lx.line;
    lx.pos += level + 2;
    loop {
        if lx.pos >= lx.src.len { fail(line, "unfinished long comment"); }
        let c = lx.peek(0);
        if c == '\n' { lx.line += 1; }
        if c == ']' {
            var n: u64 = 0;
            while lx.peek(1 + n) == '=' { n += 1; }
            if n == level and lx.peek(1 + n) == ']' {
                lx.pos += n + 2;
                return;
            }
        }
        lx.pos += 1;
    }
}

fn Lexer.next(lx: *Lexer) -> Token {
    // Whitespace and comments.
    loop {
        let c = lx.peek(0);
        if c == '\n' { lx.line += 1; lx.pos += 1; continue; }
        if text.is_space(c) { lx.pos += 1; continue; }
        if c == '-' and lx.peek(1) == '-' {
            lx.pos += 2;
            if let Some(level) = lx.long_bracket() {
                lx.skip_long(level);
            } else {
                while lx.pos < lx.src.len and lx.peek(0) != '\n' { lx.pos += 1; }
            }
            continue;
        }
        break;
    }
    let start = lx.pos;
    let line = lx.line;
    if lx.pos >= lx.src.len {
        return Token { kind: T.Eof, text: "", line: line, num: V.Nil };
    }
    let c = lx.peek(0);
    if text.is_alpha(c) {
        while text.is_alpha(lx.peek(0)) or text.is_digit(lx.peek(0)) { lx.pos += 1; }
        let s = lx.src[start..lx.pos];
        return Token { kind: keyword(s), text: s, line: line, num: V.Nil };
    }
    if c == '0' and (lx.peek(1) == 'x' or lx.peek(1) == 'X') {
        lx.pos += 2;
        var v: f64 = 0.0;
        var digits = 0;
        while let Some(d) = hex_digit(lx.peek(0)) {
            v = v * 16.0 + d as f64;
            digits += 1;
            lx.pos += 1;
        }
        if digits == 0 or text.is_alpha(lx.peek(0)) { fail(line, "malformed number"); }
        let num = if v <= 2147483647.0 { V.Int(v as i32) } else { V.Num(v) };
        return Token { kind: T.Number, text: lx.src[start..lx.pos], line: line, num: num };
    }
    if text.is_digit(c) or (c == '.' and text.is_digit(lx.peek(1))) {
        var is_float = false;
        while text.is_digit(lx.peek(0)) { lx.pos += 1; }
        if lx.peek(0) == '.' {
            is_float = true;
            lx.pos += 1;
            while text.is_digit(lx.peek(0)) { lx.pos += 1; }
        }
        if lx.peek(0) == 'e' or lx.peek(0) == 'E' {
            is_float = true;
            lx.pos += 1;
            if lx.peek(0) == '+' or lx.peek(0) == '-' { lx.pos += 1; }
            while text.is_digit(lx.peek(0)) { lx.pos += 1; }
        }
        let s = lx.src[start..lx.pos];
        var num = V.Nil;
        if !is_float {
            if let Some(i) = text.parse_int(s) and i >= -2147483648 and i <= 2147483647 {
                num = V.Int(i as i32);
            }
        }
        if num == V.Nil {
            let Some(f) = text.parse_f64(s) else { fail(line, "malformed number") };
            num = V.Num(f);
        }
        return Token { kind: T.Number, text: s, line: line, num: num };
    }
    if c == '"' or c == '\'' {
        lx.pos += 1;
        while lx.peek(0) != c {
            if lx.pos >= lx.src.len or lx.peek(0) == '\n' { fail(line, "unfinished string"); }
            if lx.peek(0) == '\\' {
                lx.pos += 1;
                if lx.peek(0) == '\n' { lx.line += 1; }
            }
            lx.pos += 1;
        }
        lx.pos += 1;
        return Token { kind: T.String, text: lx.src[start + 1..lx.pos - 1], line: line, num: V.Nil };
    }
    lx.pos += 1;
    let two = lx.peek(0);
    var kind = T.Eof;
    match c {
        '+' => kind = T.Plus,
        '-' => kind = T.Minus,
        '*' => kind = T.Star,
        '/' => kind = T.Slash,
        '%' => kind = T.Percent,
        '^' => kind = T.Caret,
        '#' => kind = T.Hash,
        '(' => kind = T.LParen,
        ')' => kind = T.RParen,
        '{' => kind = T.LBrace,
        '}' => kind = T.RBrace,
        '[' => kind = T.LBracket,
        ']' => kind = T.RBracket,
        ',' => kind = T.Comma,
        ';' => kind = T.Semi,
        ':' => kind = T.Colon,
        '.' => if two == '.' { lx.pos += 1; kind = T.Concat; } else { kind = T.Dot; },
        '=' => if two == '=' { lx.pos += 1; kind = T.Eq; } else { kind = T.Assign; },
        '<' => if two == '=' { lx.pos += 1; kind = T.Le; } else { kind = T.Lt; },
        '>' => if two == '=' { lx.pos += 1; kind = T.Ge; } else { kind = T.Gt; },
        '~' => if two == '=' { lx.pos += 1; kind = T.Ne; } else { fail(line, "unexpected '~'"); },
        _ => fail(line, "unexpected character"),
    }
    Token { kind: kind, text: lx.src[start..lx.pos], line: line, num: V.Nil }
}

// ── function state and expression descriptors ───────────────────────

struct Local { name: str, reg: u32 }

/// An upvalue of the function being compiled: register `idx` of the
/// enclosing function (instack) or upvalue `idx` of the enclosing closure.
struct UpDesc { name: str, instack: bool, idx: u32 }

/// A lexical block. `upval` is set when a nested function captures one of
/// the block's locals, so that leaving the block must close upvalues.
struct Block { first_local: u64, nactive: u32, upval: bool }

struct FuncState {
    parent: ?*FuncState,
    code: mem.Vec<u32>,
    consts: mem.Vec<V>,
    locals: mem.Vec<Local>,
    nactive: u32,
    freereg: u32,
    maxreg: u32,
    nparams: u32,
    name: str,
    /// Pending `break` jumps of the enclosing loops.
    breaks: mem.Vec<u64>,
    loop_depth: u32,
    /// First register of the innermost loop's variables (closed by `break`).
    loop_level: u32,
    lines: mem.Vec<u32>,
    upvals: mem.Vec<UpDesc>,
    /// Child prototypes. (The compiler never collects, so a plain Vec is fine.)
    protos: mem.Vec<Gc<Proto>>,
    blocks: mem.Vec<Block>,
}

enum VarRef { Loc(u32), Up(u32), Glob }

enum E {
    Nil,
    True,
    False,
    K(u32),
    I(i32),
    Local(u32),
    Upval(u32),
    Temp(u32),
    Global(u32),
    Field(u32, u32),
    Index(u32, u32),
    /// t[i] for an integer literal 1 <= i <= 255.
    IndexI(u32, u32),
    Reloc(u64),
    /// An open call: function and results at register .0, CALL at .1.
    /// Its result count can still be raised (see explist_to).
    Call(u32, u64),
}

struct LoopSave { depth: u32, level: u32, breaks: u64 }

struct Parser {
    lx: Lexer,
    tok: Token,
    heap: *gc.Heap,
    fs: *FuncState,
    /// String constants interned across all functions of the chunk.
    strings: map.HashMap<str, V>,
    /// Line of the last consumed token (recorded for each instruction).
    line: u32,
}

fn FuncState.find_local(fs: *FuncState, name: str) -> ?u64 {
    var i = fs.locals.len;
    while i > 0 {
        i -= 1;
        if fs.locals.at(i).name.eq(name) { return Some(i); }
    }
    None
}

/// Flag the block that declares local number `li` as captured.
fn FuncState.mark_captured(fs: *FuncState, li: u64) {
    var i = fs.blocks.len;
    while i > 0 {
        i -= 1;
        let b = fs.blocks.ptr_at(i);
        if b.first_local <= li {
            b.upval = true;
            return;
        }
    }
}

/// Resolve a name: a local, an upvalue (created on demand through the
/// enclosing functions), or a global.
fn FuncState.resolve(fs: *FuncState, name: str, line: u32) -> VarRef {
    if let Some(li) = fs.find_local(name) { return VarRef.Loc(fs.locals.at(li).reg); }
    for i in 0..fs.upvals.len {
        if fs.upvals.at(i).name.eq(name) { return VarRef.Up(i as u32); }
    }
    let Some(parent) = fs.parent else { return VarRef.Glob; };
    var instack = false;
    var idx: u32 = 0;
    if let Some(li) = parent.find_local(name) {
        parent.mark_captured(li);
        instack = true;
        idx = parent.locals.at(li).reg;
    } else {
        match parent.resolve(name, line) {
            Up(i) => idx = i,
            _ => return VarRef.Glob,
        }
    }
    if fs.upvals.len >= 255 { fail(line, "too many upvalues"); }
    fs.upvals.push(UpDesc { name: name, instack: instack, idx: idx });
    VarRef.Up((fs.upvals.len - 1) as u32)
}

fn Parser.advance(p: *Parser) {
    p.line = p.tok.line;
    p.tok = p.lx.next();
}

/// The kind of the token after the current one.
fn Parser.peek_kind(p: *Parser) -> T {
    var lx = p.lx;
    lx.next().kind
}

fn Parser.check(p: *Parser, k: T, what: str) {
    if p.tok.kind != k {
        var b = text.StrBuf.new();
        b.push_str("expected ");
        b.push_str(what);
        b.push_str(" near '");
        b.push_str(p.tok.text);
        b.push_str("'");
        fail(p.tok.line, b.as_str());
    }
    p.advance();
}

fn Parser.accept(p: *Parser, k: T) -> bool {
    if p.tok.kind == k { p.advance(); return true; }
    false
}

fn Parser.emit(p: *Parser, w: u32) -> u64 {
    p.fs.code.push(w);
    p.fs.lines.push(p.line);
    p.fs.code.len - 1
}

fn Parser.pc(p: *Parser) -> u64 { p.fs.code.len }

/// Point the jump at `at` to `target`.
fn Parser.patch(p: *Parser, at: u64, target: u64) {
    let w = p.fs.code.at(at);
    let off = target as i64 - at as i64;
    let op = Mini.opcode(w);
    if op == Mini.OP_JMP {
        p.fs.code.set(at, Mini.JMP(off as i32));
    } else {
        if off < -32768 or off > 32767 { fail(p.tok.line, "control structure too long"); }
        p.fs.code.set(at, (w & 0xFFFF) | (((off as i32) as u32 & 0xFFFF) << 16));
    }
}

fn Parser.constant(p: *Parser, v: V) -> u32 {
    // One string object per distinct string, across the whole chunk.
    var v = v;
    if let S(s) = v {
        match p.strings.get(s.data) {
            Some(existing) => v = existing,
            None => { p.strings.insert(s.data, v); }
        }
    }
    let fs = p.fs;
    for i in 0..fs.consts.len {
        let c = fs.consts.at(i);
        let same = match (c, v) {
            (S(a), S(b)) => a.data.eq(b.data),
            _ => c == v,
        };
        if same { return i as u32; }
    }
    if fs.consts.len >= 65535 { fail(p.tok.line, "too many constants"); }
    fs.consts.push(v);
    (fs.consts.len - 1) as u32
}

fn Parser.name_const(p: *Parser, s: str) -> u32 {
    p.constant(V.S(value.new_str(p.heap, s)))
}

fn Parser.string_const(p: *Parser, s: str) -> u32 {
    // Process escapes.
    var b = text.StrBuf.new();
    var i: u64 = 0;
    while i < s.len {
        var c = s[i];
        if c == '\\' and i + 1 < s.len {
            i += 1;
            if text.is_digit(s[i]) {
                // \ddd: up to three decimal digits.
                var v: u32 = 0;
                var n = 0;
                while n < 3 and i < s.len and text.is_digit(s[i]) {
                    v = v * 10 + (s[i] - '0') as u32;
                    i += 1;
                    n += 1;
                }
                if v > 255 { fail(p.tok.line, "decimal escape too large"); }
                b.push(v as u8);
                continue;
            }
            c = match s[i] { 'n' => '\n', 't' => '\t', 'r' => '\r', x => x };
        }
        b.push(c);
        i += 1;
    }
    let k = p.constant(V.S(value.new_str(p.heap, b.as_str())));
    b.free();
    k
}

fn Parser.reserve(p: *Parser, n: u32) -> u32 {
    let r = p.fs.freereg;
    p.fs.freereg += n;
    if p.fs.freereg > p.fs.maxreg { p.fs.maxreg = p.fs.freereg; }
    if p.fs.freereg > 250 { fail(p.tok.line, "function or expression needs too many registers"); }
    r
}

fn Parser.free_reg(p: *Parser, r: u32) {
    if r >= p.fs.nactive {
        p.fs.freereg -= 1;
        if r != p.fs.freereg { fail(p.tok.line, "internal error: register freed out of order"); }
    }
}

fn Parser.free_exp(p: *Parser, e: E) {
    match e {
        Temp(r) => p.free_reg(r),
        Call(r, _) => p.free_reg(r),
        Field(t, _) => p.free_reg(t),
        IndexI(t, _) => p.free_reg(t),
        Index(t, k) => {
            if k > t { p.free_reg(k); p.free_reg(t); } else { p.free_reg(t); p.free_reg(k); }
        }
        _ => {}
    }
}

/// Emit code that leaves the value of `e` in `dst` (no freeing).
fn Parser.discharge(p: *Parser, e: E, dst: u32) {
    let d = dst as u8;
    match e {
        Nil => { p.emit(Mini.LOADNIL(d)); }
        True => { p.emit(Mini.LOADBOOL(d, 1)); }
        False => { p.emit(Mini.LOADBOOL(d, 0)); }
        I(i) => { p.emit(Mini.LOADI(d, i as i16)); }
        K(k) => { p.emit(Mini.LOADK(d, k as u16)); }
        Local(r) => { if r != dst { p.emit(Mini.MOVE(d, r as u8)); } }
        Temp(r) => { if r != dst { p.emit(Mini.MOVE(d, r as u8)); } }
        Call(r, _) => { if r != dst { p.emit(Mini.MOVE(d, r as u8)); } }
        Upval(i) => { p.emit(Mini.GETUPVAL(d, i as u8)); }
        Global(k) => {
            p.emit(Mini.GETGLOBAL(d, k as u16));
            p.emit(0);   // inline cache word
        }
        Field(t, k) => {
            p.emit(Mini.GETFIELD(d, t as u8, k as u8));
            p.emit(0);   // inline cache word
        }
        Index(t, k) => { p.emit(Mini.GETINDEX(d, t as u8, k as u8)); }
        IndexI(t, i) => { p.emit(Mini.GETINDEXI(d, t as u8, i as u8)); }
        Reloc(at) => {
            let w = p.fs.code.at(at);
            p.fs.code.set(at, (w & 0xFFFF00FF) | (dst << 8));
        }
    }
}

/// Put `e` in the next free register.
fn Parser.to_next_reg(p: *Parser, e: E) -> u32 {
    p.free_exp(e);
    let r = p.reserve(1);
    p.discharge(e, r);
    r
}

/// Any register holding the value of `e` (a local's own register if possible).
fn Parser.any_reg(p: *Parser, e: E) -> E {
    match e {
        Local(_) | Temp(_) | Call(_, _) => e,
        _ => E.Temp(p.to_next_reg(e)),
    }
}

fn reg_of(e: E) -> u32 {
    match e {
        Local(r) => r,
        Temp(r) => r,
        Call(r, _) => r,
        _ => 0,
    }
}

/// Assign the value of `v` to the variable `target`. Temporaries are
/// not freed: statements reset the free register at their end.
fn Parser.store_var(p: *Parser, target: E, v: E) {
    match target {
        Local(r) => p.discharge(v, r),
        Upval(i) => {
            let v = p.any_reg(v);
            p.emit(Mini.SETUPVAL(reg_of(v) as u8, i as u8));
        }
        Global(k) => {
            let v = p.any_reg(v);
            p.emit(Mini.SETGLOBAL(reg_of(v) as u8, k as u16));
        }
        Field(t, k) => {
            let v = p.any_reg(v);
            p.emit(Mini.SETFIELD(t as u8, k as u8, reg_of(v) as u8));
            p.emit(0);   // inline cache word
        }
        Index(t, k) => {
            if let Some(c) = p.kindex(v, true) {
                p.emit(Mini.SETINDEXK(t as u8, k as u8, c as u8));
                return;
            }
            let v = p.any_reg(v);
            p.emit(Mini.SETINDEX(t as u8, k as u8, reg_of(v) as u8));
        }
        IndexI(t, i) => {
            let v = p.any_reg(v);
            let kr = p.reserve(1);
            p.emit(Mini.LOADI(kr as u8, i as i16));
            p.emit(Mini.SETINDEX(t as u8, kr as u8, reg_of(v) as u8));
        }
        _ => fail(p.line, "cannot assign to this expression"),
    }
}

// ── expressions ─────────────────────────────────────────────────────

fn Parser.singlevar(p: *Parser, name: str) -> E {
    match p.fs.resolve(name, p.line) {
        Loc(r) => E.Local(r),
        Up(i) => E.Upval(i),
        Glob => E.Global(p.name_const(name)),
    }
}

fn small_int(v: V) -> ?i32 {
    if let Int(i) = v and i >= -32768 and i <= 32767 { return Some(i); }
    None
}

fn Parser.primary(p: *Parser) -> E {
    let t = p.tok;
    match t.kind {
        Name => {
            p.advance();
            p.singlevar(t.text)
        }
        LParen => {
            p.advance();
            let e = p.expr();
            p.check(T.RParen, "')'");
            // A parenthesized call or field read is just one value.
            match p.any_reg(e) {
                Call(r, _) => E.Temp(r),
                x => x,
            }
        }
        _ => fail(t.line, "unexpected symbol"),
    }
}

fn Parser.field_key(p: *Parser, t: E, k: u32) -> E {
    if k <= 255 { return E.Field(reg_of(t), k); }
    let kr = p.reserve(1);
    p.emit(Mini.LOADK(kr as u8, k as u16));
    E.Index(reg_of(t), kr)
}

/// Arguments of a call whose function is in `base` and whose first
/// `nfixed` arguments are already in place; emits the CALL.
fn Parser.call_args(p: *Parser, base: u32, nfixed: u32) -> E {
    var nargs = nfixed;
    match p.tok.kind {
        String => {
            let k = p.string_const(p.tok.text);
            p.advance();
            p.to_next_reg(E.K(k));
            nargs += 1;
        }
        LBrace => {
            let t = p.constructor();
            p.to_next_reg(t);
            nargs += 1;
        }
        LParen => {
            p.advance();
            if p.tok.kind != T.RParen {
                loop {
                    let a = p.expr();
                    p.to_next_reg(a);
                    nargs += 1;
                    if !p.accept(T.Comma) { break; }
                }
            }
            p.check(T.RParen, "')'");
        }
        _ => fail(p.tok.line, "function arguments expected"),
    }
    let at = p.emit(Mini.CALL(base as u8, nargs as u8, 1));
    p.fs.freereg = base + 1;
    E.Call(base, at)
}

fn Parser.suffixed(p: *Parser) -> E {
    var e = p.primary();
    loop {
        match p.tok.kind {
            Dot => {
                p.advance();
                let name = p.tok;
                p.check(T.Name, "field name");
                let t = p.any_reg(e);
                let k = p.name_const(name.text);
                e = p.field_key(t, k);
            }
            LBracket => {
                p.advance();
                let t = p.any_reg(e);
                let ke = p.expr();
                if let I(i) = ke and i >= 1 and i <= 255 {
                    p.check(T.RBracket, "']'");
                    e = E.IndexI(reg_of(t), i as u32);
                    continue;
                }
                let k = p.any_reg(ke);
                p.check(T.RBracket, "']'");
                e = E.Index(reg_of(t), reg_of(k));
            }
            Colon => {
                p.advance();
                let name = p.tok;
                p.check(T.Name, "method name");
                let obj = p.any_reg(e);
                p.free_exp(obj);
                let base = p.reserve(2);
                let k = p.name_const(name.text);
                if k <= 255 {
                    p.emit(Mini.SELF(base as u8, reg_of(obj) as u8, k as u8));
                    p.emit(0);   // inline cache word
                } else {
                    p.emit(Mini.MOVE((base + 1) as u8, reg_of(obj) as u8));
                    p.emit(Mini.LOADK(base as u8, k as u16));
                    p.emit(Mini.GETINDEX(base as u8, (base + 1) as u8, base as u8));
                }
                e = p.call_args(base, 1);
            }
            LParen | String | LBrace => {
                let base = p.to_next_reg(e);
                e = p.call_args(base, 0);
            }
            _ => return e,
        }
    }
}

/// Table constructor: positional items are collected in registers above
/// the table and stored in batches by SETLIST.
fn Parser.constructor(p: *Parser) -> E {
    p.check(T.LBrace, "'{'");
    if p.accept(T.RBrace) { return E.Reloc(p.emit(Mini.NEWTABLE(0, 0, 0))); }
    let t = p.reserve(1);
    let at = p.emit(Mini.NEWTABLE(t as u8, 0, 0));
    var narr: u32 = 0;
    var nhash: u32 = 0;
    var pending: u32 = 0;
    var batch: u32 = 0;
    while p.tok.kind != T.RBrace {
        if p.tok.kind == T.Name and p.peek_kind() == T.Assign {
            let name = p.tok.text;
            p.advance();
            p.advance();
            let k = p.name_const(name);
            let v = p.expr();
            let vr = p.any_reg(v);
            if k <= 255 {
                p.emit(Mini.SETFIELD(t as u8, k as u8, reg_of(vr) as u8));
                p.emit(0);   // inline cache word
            } else {
                let kr = p.reserve(1);
                p.emit(Mini.LOADK(kr as u8, k as u16));
                p.emit(Mini.SETINDEX(t as u8, kr as u8, reg_of(vr) as u8));
            }
            p.fs.freereg = t + 1 + pending;
            nhash += 1;
        } else if p.tok.kind == T.LBracket {
            p.advance();
            let ke = p.expr();
            let kr = p.any_reg(ke);
            p.check(T.RBracket, "']'");
            p.check(T.Assign, "'='");
            let v = p.expr();
            let vr = p.any_reg(v);
            p.emit(Mini.SETINDEX(t as u8, reg_of(kr) as u8, reg_of(vr) as u8));
            p.fs.freereg = t + 1 + pending;
            nhash += 1;
        } else {
            let e = p.expr();
            p.to_next_reg(e);
            pending += 1;
            narr += 1;
            if pending == 50 {
                p.flush_list(t, pending, batch);
                pending = 0;
                batch += 1;
            }
        }
        if !p.accept(T.Comma) and !p.accept(T.Semi) { break; }
    }
    p.check(T.RBrace, "'}'");
    if pending > 0 { p.flush_list(t, pending, batch); }
    let na = if narr > 255 { 255 } else { narr };
    let nh = if nhash > 255 { 255 } else { nhash };
    p.fs.code.set(at, Mini.NEWTABLE(t as u8, na as u8, nh as u8));
    E.Temp(t)
}

fn Parser.flush_list(p: *Parser, t: u32, n: u32, batch: u32) {
    if batch > 255 { fail(p.tok.line, "table constructor too long"); }
    p.emit(Mini.SETLIST(t as u8, n as u8, batch as u8));
    p.fs.freereg = t + 1;
}

fn Parser.simple(p: *Parser) -> E {
    let t = p.tok;
    match t.kind {
        Number => {
            p.advance();
            if let Some(i) = small_int(t.num) { return E.I(i); }
            E.K(p.constant(t.num))
        }
        String => {
            p.advance();
            E.K(p.string_const(t.text))
        }
        Nil => { p.advance(); E.Nil }
        True => { p.advance(); E.True }
        False => { p.advance(); E.False }
        LBrace => p.constructor(),
        Function => {
            p.advance();
            let idx = p.function_body("anonymous", false);
            E.Reloc(p.emit(Mini.CLOSURE(0, idx as u16)))
        }
        _ => p.suffixed(),
    }
}

/// (left priority, right priority) of a binary operator.
fn priority(k: T) -> (u32, u32) {
    match k {
        Or => (1, 1),
        And => (2, 2),
        Eq | Ne | Lt | Le | Gt | Ge => (3, 3),
        Concat => (5, 4),
        Plus | Minus => (6, 6),
        Star | Slash | Percent => (7, 7),
        Caret => (10, 9),
        _ => (0, 0),
    }
}

const UNARY: u32 = 8;

fn Parser.expr(p: *Parser) -> E { p.subexpr(0) }

fn Parser.subexpr(p: *Parser, limit: u32) -> E {
    var e: E = E.Nil;
    if p.tok.kind == T.Not or p.tok.kind == T.Minus or p.tok.kind == T.Hash {
        let op = p.tok.kind;
        p.advance();
        let operand = p.subexpr(UNARY);
        var folded = false;
        if op == T.Minus {
            if let I(i) = operand { e = E.I(0 - i); folded = true; }
        }
        if !folded {
            let r = p.any_reg(operand);
            p.free_exp(r);
            let a = reg_of(r) as u8;
            let w = match op {
                Not => Mini.NOT(0, a),
                Minus => Mini.NEG(0, a),
                _ => Mini.LEN(0, a),
            };
            e = E.Reloc(p.emit(w));
        }
    } else {
        e = p.simple();
    }
    loop {
        let op = p.tok.kind;
        let (lp, rp) = priority(op);
        if lp <= limit { break; }
        p.advance();
        if op == T.And or op == T.Or {
            let r = p.to_next_reg(e);
            let w = if op == T.And { Mini.TEST(r as u8, 0) } else { Mini.TESTT(r as u8, 0) };
            let j = p.emit(w);
            let rhs = p.subexpr(rp);
            p.free_exp(rhs);
            p.discharge(rhs, r);
            p.patch(j, p.pc());
            e = E.Temp(r);
            continue;
        }
        // A constant left operand of a commutative operator or a
        // comparison stays unmaterialized, so the K form can be used
        // with the operands swapped (`k - x` and `k / x` have their own
        // reversed ops).
        if swappable(op) and let Some(kl) = p.kindex(e, op == T.Eq or op == T.Ne) {
            let rhs = p.subexpr(rp);
            if p.kindex(rhs, op == T.Eq or op == T.Ne).is_none() {
                let r = p.any_reg(rhs);
                p.free_exp(r);
                let a = reg_of(r) as u8;
                let k = kl as u8;
                let w = match op {
                    Plus => Mini.ADDK(0, a, k),
                    Star => Mini.MULK(0, a, k),
                    Minus => Mini.RSUBK(0, a, k),
                    Slash => Mini.RDIVK(0, a, k),
                    Eq | Ne => Mini.EQK(0, a, k),
                    Lt => Mini.GTK(0, a, k),
                    Le => Mini.GEK(0, a, k),
                    Gt => Mini.LTK(0, a, k),
                    _ => Mini.LEK(0, a, k),
                };
                e = p.finish_binop(op, w);
                continue;
            }
            let l = p.any_reg(e);
            e = p.binop(op, l, rhs);
            continue;
        }
        if op == T.Concat {
            e = p.concat(e, rp);
            continue;
        }
        let l = p.any_reg(e);
        let rhs = p.subexpr(rp);
        e = p.binop(op, l, rhs);
    }
    e
}

/// `e .. rhs`: operands go to consecutive registers, and a chain
/// a .. b .. c becomes one CONCAT over all of them (as in Lua).
fn Parser.concat(p: *Parser, e: E, rp: u32) -> E {
    let l = p.to_next_reg(e);
    let rhs = p.subexpr(rp);
    // The right operand is itself a concatenation starting right after l:
    // extend it to start at l.
    if let Reloc(at) = rhs and at + 1 == p.pc() {
        let w = p.fs.code.at(at);
        if Mini.opcode(w) == Mini.OP_CONCAT and ((w >> 16) & 255) == l + 1 {
            let n = (w >> 24) + 1;
            p.fs.code.set(at, Mini.CONCAT(0, l as u8, n as u8));
            p.free_reg(l);
            return rhs;
        }
    }
    let r = p.to_next_reg(rhs);
    if r != l + 1 { fail(p.line, "internal error: concat operands not consecutive"); }
    p.free_reg(r);
    p.free_reg(l);
    E.Reloc(p.emit(Mini.CONCAT(0, l as u8, 2)))
}

fn swappable(op: T) -> bool {
    op == T.Plus or op == T.Star or op == T.Minus or op == T.Slash or op == T.Eq or op == T.Ne or op == T.Lt or op == T.Le or op == T.Gt or op == T.Ge
}

/// The constant index (at most 255) of a numeric constant expression, or
/// also of nil, true, false and strings if `any`.
fn Parser.kindex(p: *Parser, e: E, any: bool) -> ?u32 {
    let k = match e {
        I(i) => p.constant(V.Int(i)),
        K(k) => {
            let v = p.fs.consts.at(k as u64);
            let num = match v { Int(_) | Num(_) => true, _ => false };
            if !any and !num { return None; }
            k
        }
        Nil => if any { p.constant(V.Nil) } else { return None; },
        True => if any { p.constant(V.Bool(true)) } else { return None; },
        False => if any { p.constant(V.Bool(false)) } else { return None; },
        _ => return None,
    };
    if k > 255 { None } else { Some(k) }
}

/// The binary operator `op` on `l` (in a register) and `rhs`.
fn Parser.binop(p: *Parser, op: T, l: E, rhs: E) -> E {
    // x + c and x - c with a small constant c.
    if op == T.Plus or op == T.Minus {
        if let I(c) = rhs {
            let c = if op == T.Minus { 0 - c } else { c };
            if c >= -128 and c <= 127 {
                p.free_exp(l);
                return E.Reloc(p.emit(Mini.ADDI(0, reg_of(l) as u8, c as i8)));
            }
        }
    }
    let a = reg_of(l) as u8;
    if op != T.Caret and op != T.Concat and let Some(k) = p.kindex(rhs, op == T.Eq or op == T.Ne) {
        p.free_exp(l);
        let k = k as u8;
        let w = match op {
            Plus => Mini.ADDK(0, a, k),
            Minus => Mini.SUBK(0, a, k),
            Star => Mini.MULK(0, a, k),
            Slash => Mini.DIVK(0, a, k),
            Percent => Mini.MODK(0, a, k),
            Eq | Ne => Mini.EQK(0, a, k),
            Lt => Mini.LTK(0, a, k),
            Le => Mini.LEK(0, a, k),
            Gt => Mini.GTK(0, a, k),
            Ge => Mini.GEK(0, a, k),
            _ => fail(p.tok.line, "bad operator"),
        };
        return p.finish_binop(op, w);
    }
    let r = p.any_reg(rhs);
    p.free_exp(r);
    p.free_exp(l);
    let b = reg_of(r) as u8;
    let w = match op {
        Plus => Mini.ADD(0, a, b),
        Minus => Mini.SUB(0, a, b),
        Star => Mini.MUL(0, a, b),
        Slash => Mini.DIV(0, a, b),
        Percent => Mini.MOD(0, a, b),
        Caret => Mini.POW(0, a, b),
        Concat => Mini.CONCAT(0, a, b),
        Eq | Ne => Mini.EQ(0, a, b),
        Lt => Mini.LT(0, a, b),
        Le => Mini.LE(0, a, b),
        Gt => Mini.LT(0, b, a),
        Ge => Mini.LE(0, b, a),
        _ => fail(p.tok.line, "bad operator"),
    };
    p.finish_binop(op, w)
}

/// Emit the instruction `w` for operator `op` (negated for `~=`).
fn Parser.finish_binop(p: *Parser, op: T, w: u32) -> E {
    let e = E.Reloc(p.emit(w));
    if op != T.Ne { return e; }
    let t = p.to_next_reg(e);
    p.free_reg(t);
    E.Reloc(p.emit(Mini.NOT(0, t as u8)))
}

/// Evaluate an expression list into consecutive registers starting at
/// the free register, adjusted to exactly `nvars` values. Only a call in
/// the last position can produce several values.
fn Parser.explist_to(p: *Parser, nvars: u32) {
    let start = p.fs.freereg;
    var n: u32 = 1;
    var e = p.expr();
    while p.accept(T.Comma) {
        p.to_next_reg(e);
        e = p.expr();
        n += 1;
    }
    if let Call(base, at) = e and n < nvars {
        if base != start + n - 1 { fail(p.line, "internal error: misplaced call results"); }
        let want = nvars - n + 1;
        let w = p.fs.code.at(at);
        p.fs.code.set(at, (w & 0x00FFFFFF) | (want << 24));
        p.reserve(want - 1);
        return;
    }
    p.to_next_reg(e);
    while n < nvars {
        let r = p.reserve(1);
        p.emit(Mini.LOADNIL(r as u8));
        n += 1;
    }
    p.fs.freereg = start + nvars;
}

// ── statements ──────────────────────────────────────────────────────

fn block_end(k: T) -> bool {
    k == T.End or k == T.Else or k == T.Elseif or k == T.Until or k == T.Eof
}

fn Parser.enter_block(p: *Parser) {
    p.fs.blocks.push(Block { first_local: p.fs.locals.len, nactive: p.fs.nactive, upval: false });
}

fn Parser.leave_block(p: *Parser) {
    let Some(b) = p.fs.blocks.pop() else { fail(p.line, "internal error: block underflow") };
    // The function's outermost block needs no CLOSE: returning closes.
    if b.upval and p.fs.blocks.len > 0 { p.emit(Mini.CLOSE(b.nactive as u8)); }
    p.fs.locals.truncate(b.first_local);
    p.fs.nactive = b.nactive;
    p.fs.freereg = b.nactive;
}

fn Parser.statlist(p: *Parser) {
    while !block_end(p.tok.kind) {
        if p.tok.kind == T.Return {
            p.statement();
            return;
        }
        p.statement();
    }
}

fn Parser.block(p: *Parser) {
    p.enter_block();
    p.statlist();
    p.leave_block();
}

fn Parser.add_local(p: *Parser, name: str, r: u32) {
    p.fs.locals.push(Local { name: name, reg: r });
    p.fs.nactive = r + 1;
    if p.fs.freereg < p.fs.nactive { p.fs.freereg = p.fs.nactive; }
}

// Conditions of if, while and repeat compile to jumps, as in Lua: each
// operand of an and/or chain jumps straight to the false (or true) exit,
// `not` flips a test instead of materializing a boolean, and constants
// fold away.

/// Emit a test of `e` that jumps when its truthiness is `when` (to be
/// patched), or nothing if it can never jump. Falls through otherwise.
fn Parser.jump_if(p: *Parser, e: E, when: bool) -> ?u64 {
    match e {
        True => return if when { Some(p.emit(Mini.JMP(0))) } else { None },
        Nil | False => return if when { None } else { Some(p.emit(Mini.JMP(0))) },
        _ => {}
    }
    var when = when;
    var src: u32 = 0;
    var e = e;
    if let Reloc(at) = e and at + 1 == p.pc() and Mini.opcode(p.fs.code.at(at)) == Mini.OP_NOT {
        src = (p.fs.code.at(at) >> 16) & 255;
        p.fs.code.truncate(at);
        p.fs.lines.truncate(at);
        when = !when;
        // `a ~= b` is EQ into a temporary, then NOT.
        if at > 0 and jump_op(Mini.opcode(p.fs.code.at(at - 1))) != 0 and ((p.fs.code.at(at - 1) >> 8) & 255) == src and src >= p.fs.nactive {
            e = E.Reloc(at - 1);
        } else {
            return Some(p.emit(Mini.TESTT(src as u8, 0)));
        }
    }
    // A comparison just emitted: compare and branch.
    if let Reloc(at) = e and at + 1 == p.pc() {
        let w = p.fs.code.at(at);
        let jop = jump_op(Mini.opcode(w));
        if jop != 0 {
            let pol: u32 = if when { 1 } else { 0 };
            p.fs.code.set(at, (w & 0xFFFF0000) | (pol << 8) | jop);
            return Some(p.emit(Mini.JMP(0)));
        }
    }
    let r = p.any_reg(e);
    p.free_exp(r);
    src = reg_of(r);
    Some(p.emit(if when { Mini.TESTT(src as u8, 0) } else { Mini.TEST(src as u8, 0) }))
}

/// The compare-and-branch op for comparison op `op`, or 0.
fn jump_op(op: u32) -> u32 {
    if op == Mini.OP_EQ { return Mini.OP_JEQ; }
    if op == Mini.OP_EQK { return Mini.OP_JEQK; }
    if op == Mini.OP_LT { return Mini.OP_JLT; }
    if op == Mini.OP_LE { return Mini.OP_JLE; }
    if op == Mini.OP_LTK { return Mini.OP_JLTK; }
    if op == Mini.OP_LEK { return Mini.OP_JLEK; }
    if op == Mini.OP_GTK { return Mini.OP_JGTK; }
    if op == Mini.OP_GEK { return Mini.OP_JGEK; }
    0
}

/// Whether `op` is a compare-and-branch op (followed by its JMP word).
fn is_jump_op(op: u32) -> bool {
    op == Mini.OP_JEQ or op == Mini.OP_JEQK or op == Mini.OP_JLT or op == Mini.OP_JLE or op == Mini.OP_JLTK or op == Mini.OP_JLEK or op == Mini.OP_JGTK or op == Mini.OP_JGEK
}

fn Parser.patch_list(p: *Parser, l: *mem.Vec<u64>, target: u64) {
    for i in 0..l.len { p.patch(l.at(i), target); }
    l.clear();
}

/// `a and b and ...`: falls through when all are true; returns the jumps
/// taken when one is false.
fn Parser.cond_and(p: *Parser) -> mem.Vec<u64> {
    var f: mem.Vec<u64> = mem.Vec.new();
    loop {
        // Operands bind tighter than `and` and `or`.
        let e = p.subexpr(2);
        if let Some(j) = p.jump_if(e, false) { f.push(j); }
        if !p.accept(T.And) { break; }
    }
    f
}

/// A condition: falls through when true; returns the jumps taken when
/// false (to be patched to the false exit, then freed).
fn Parser.cond(p: *Parser) -> mem.Vec<u64> {
    var t: mem.Vec<u64> = mem.Vec.new();
    var f = p.cond_and();
    while p.accept(T.Or) {
        // This operand being true makes the whole condition true.
        var flipped = false;
        if f.len > 0 {
            let last = f.at(f.len - 1);
            let w = p.fs.code.at(last);
            let op = Mini.opcode(w);
            if last + 1 == p.pc() and (op == Mini.OP_TEST or op == Mini.OP_TESTT) {
                // Invert the final test: jump to the true exit instead.
                let r = ((w >> 8) & 255) as u8;
                p.fs.code.set(last, if op == Mini.OP_TEST { Mini.TESTT(r, 0) } else { Mini.TEST(r, 0) });
                f.pop();
                t.push(last);
                flipped = true;
            } else if last + 1 == p.pc() and op == Mini.OP_JMP and last > 0 and is_jump_op(Mini.opcode(p.fs.code.at(last - 1))) {
                // Same for a compare and branch: flip its polarity.
                p.fs.code.set(last - 1, p.fs.code.at(last - 1) ^ (1 << 8));
                f.pop();
                t.push(last);
                flipped = true;
            }
        }
        if !flipped { t.push(p.emit(Mini.JMP(0))); }
        p.patch_list(&f, p.pc());
        f.free();
        f = p.cond_and();
    }
    p.patch_list(&t, p.pc());
    t.free();
    f
}

fn Parser.loop_enter(p: *Parser) -> LoopSave {
    let s = LoopSave { depth: p.fs.loop_depth, level: p.fs.loop_level, breaks: p.fs.breaks.len };
    p.fs.loop_depth += 1;
    p.fs.loop_level = p.fs.nactive;
    s
}

/// Point the loop's breaks here and restore the enclosing loop.
fn Parser.loop_exit(p: *Parser, s: LoopSave) {
    for i in s.breaks..p.fs.breaks.len { p.patch(p.fs.breaks.at(i), p.pc()); }
    p.fs.breaks.truncate(s.breaks);
    p.fs.loop_depth = s.depth;
    p.fs.loop_level = s.level;
}

/// If `e` is a local and an earlier assignment target indexes through
/// that local's register, make those targets use a copy (the old value).
fn Parser.check_conflict(p: *Parser, targets: *mem.Vec<E>, e: E) {
    let Local(r) = e else { return; };
    var conflict = false;
    for i in 0..targets.len {
        match targets.at(i) {
            Field(t, _) => if t == r { conflict = true; },
            IndexI(t, _) => if t == r { conflict = true; },
            Index(t, k) => if t == r or k == r { conflict = true; },
            _ => {}
        }
    }
    if !conflict { return; }
    let copy = p.reserve(1);
    p.emit(Mini.MOVE(copy as u8, r as u8));
    for i in 0..targets.len {
        match targets.at(i) {
            Field(t, k) => if t == r { targets.set(i, E.Field(copy, k)); },
            IndexI(t, k) => if t == r { targets.set(i, E.IndexI(copy, k)); },
            Index(t, k) => {
                let t2 = if t == r { copy } else { t };
                let k2 = if k == r { copy } else { k };
                targets.set(i, E.Index(t2, k2));
            }
            _ => {}
        }
    }
}

fn assignable(e: E) -> bool {
    match e {
        Local(_) | Upval(_) | Global(_) | Field(_, _) | Index(_, _) | IndexI(_, _) => true,
        _ => false,
    }
}

fn Parser.statement(p: *Parser) {
    p.statement_inner();
    p.fs.freereg = p.fs.nactive;
}

fn Parser.statement_inner(p: *Parser) {
    let line = p.tok.line;
    match p.tok.kind {
        Semi => p.advance(),
        Local => {
            p.advance();
            if p.accept(T.Function) {
                let name = p.tok.text;
                p.check(T.Name, "function name");
                let r = p.reserve(1);
                p.add_local(name, r);
                let idx = p.function_body(name, false);
                p.emit(Mini.CLOSURE(r as u8, idx as u16));
                return;
            }
            var names: mem.Vec<str> = mem.Vec.new();
            loop {
                names.push(p.tok.text);
                p.check(T.Name, "local name");
                if !p.accept(T.Comma) { break; }
            }
            let base = p.fs.freereg;
            let n = names.len as u32;
            if p.accept(T.Assign) {
                p.explist_to(n);
            } else {
                for i in 0..n {
                    let r = p.reserve(1);
                    p.emit(Mini.LOADNIL(r as u8));
                }
            }
            for i in 0..n { p.add_local(names.at(i as u64), base + i); }
            names.free();
        }
        Function => {
            p.advance();
            var name = p.tok.text;
            p.check(T.Name, "function name");
            var target = p.singlevar(name);
            var is_method = false;
            while p.tok.kind == T.Dot or p.tok.kind == T.Colon {
                is_method = p.tok.kind == T.Colon;
                p.advance();
                name = p.tok.text;
                p.check(T.Name, "field name");
                let t = p.any_reg(target);
                target = p.field_key(t, p.name_const(name));
                if is_method { break; }
            }
            let idx = p.function_body(name, is_method);
            let f = E.Reloc(p.emit(Mini.CLOSURE(0, idx as u16)));
            p.store_var(target, f);
        }
        If => {
            p.advance();
            var jumps_to_end: mem.Vec<u64> = mem.Vec.new();
            var f = p.cond();
            p.check(T.Then, "'then'");
            p.block();
            loop {
                if p.tok.kind == T.Elseif {
                    jumps_to_end.push(p.emit(Mini.JMP(0)));
                    p.patch_list(&f, p.pc());
                    f.free();
                    p.advance();
                    f = p.cond();
                    p.check(T.Then, "'then'");
                    p.block();
                } else if p.tok.kind == T.Else {
                    jumps_to_end.push(p.emit(Mini.JMP(0)));
                    p.patch_list(&f, p.pc());
                    p.advance();
                    p.block();
                    break;
                } else {
                    break;
                }
            }
            p.patch_list(&f, p.pc());
            f.free();
            p.check(T.End, "'end'");
            for i in 0..jumps_to_end.len { p.patch(jumps_to_end.at(i), p.pc()); }
            jumps_to_end.free();
        }
        Do => {
            p.advance();
            p.block();
            p.check(T.End, "'end'");
        }
        While => {
            p.advance();
            let start = p.pc();
            var f = p.cond();
            p.check(T.Do, "'do'");
            let saved = p.loop_enter();
            p.block();
            p.check(T.End, "'end'");
            let back = p.emit(Mini.JMP(0));
            p.patch(back, start);
            p.patch_list(&f, p.pc());
            f.free();
            p.loop_exit(saved);
        }
        Repeat => {
            p.advance();
            let saved = p.loop_enter();
            let start = p.pc();
            p.enter_block();
            p.statlist();
            p.check(T.Until, "'until'");
            var f = p.cond();
            let b = p.fs.blocks.at(p.fs.blocks.len - 1);
            if b.upval {
                // Captured body locals are closed on both paths.
                let exit = p.emit(Mini.JMP(0));
                p.patch_list(&f, p.pc());
                p.emit(Mini.CLOSE(b.nactive as u8));
                let back = p.emit(Mini.JMP(0));
                p.patch(back, start);
                p.patch(exit, p.pc());
            } else {
                p.patch_list(&f, start);
            }
            f.free();
            p.leave_block();
            p.loop_exit(saved);
        }
        For => {
            p.advance();
            let name = p.tok.text;
            p.check(T.Name, "loop variable");
            if p.tok.kind == T.Assign {
                p.numeric_for(name, line);
            } else {
                p.generic_for(name, line);
            }
        }
        Break => {
            p.advance();
            if p.fs.loop_depth == 0 { fail(line, "break outside a loop"); }
            p.emit(Mini.CLOSE(p.fs.loop_level as u8));
            p.fs.breaks.push(p.emit(Mini.JMP(0)));
        }
        Return => {
            p.advance();
            if block_end(p.tok.kind) or p.tok.kind == T.Semi {
                p.emit(Mini.RET0());
            } else {
                let e = p.expr();
                if p.tok.kind == T.Comma {
                    let base = p.to_next_reg(e);
                    var n: u32 = 1;
                    while p.accept(T.Comma) {
                        let x = p.expr();
                        p.to_next_reg(x);
                        n += 1;
                    }
                    p.emit(Mini.RETN(base as u8, n as u8));
                } else {
                    let r = p.any_reg(e);
                    p.emit(Mini.RET1(reg_of(r) as u8));
                }
            }
            p.accept(T.Semi);
        }
        _ => {
            let first = p.suffixed();
            if p.tok.kind != T.Assign and p.tok.kind != T.Comma {
                match first {
                    Call(_, _) => {}
                    _ => fail(line, "syntax error: expected a statement"),
                }
                return;
            }
            if !assignable(first) { fail(line, "cannot assign to this expression"); }
            if p.accept(T.Assign) {
                // One target.
                let rhs = p.expr();
                if p.tok.kind != T.Comma {
                    p.store_var(first, rhs);
                    return;
                }
                let r = p.to_next_reg(rhs);
                while p.accept(T.Comma) {
                    let x = p.expr();
                    p.to_next_reg(x);
                }
                p.store_var(first, E.Temp(r));
                return;
            }
            var targets: mem.Vec<E> = mem.Vec.new();
            targets.push(first);
            while p.accept(T.Comma) {
                let t = p.suffixed();
                if !assignable(t) { fail(line, "cannot assign to this expression"); }
                p.check_conflict(&targets, t);
                targets.push(t);
            }
            p.check(T.Assign, "'='");
            let base = p.fs.freereg;
            let n = targets.len as u32;
            p.explist_to(n);
            var i = n;
            while i > 0 {
                i -= 1;
                p.store_var(targets.at(i as u64), E.Temp(base + i));
            }
            targets.free();
        }
    }
}

fn Parser.numeric_for(p: *Parser, name: str, line: u32) {
    p.check(T.Assign, "'='");
    let saved = p.loop_enter();
    p.enter_block();
    let base = p.fs.freereg;
    let a = p.expr();
    p.to_next_reg(a);
    p.check(T.Comma, "','");
    let b = p.expr();
    p.to_next_reg(b);
    if p.accept(T.Comma) {
        let s = p.expr();
        p.to_next_reg(s);
    } else {
        let r = p.reserve(1);
        p.emit(Mini.LOADI(r as u8, 1));
    }
    p.check(T.Do, "'do'");
    p.add_local("(for index)", base);
    p.add_local("(for limit)", base + 1);
    p.add_local("(for step)", base + 2);
    let prep = p.emit(Mini.FORPREP(base as u8, 0));
    p.fs.lines.set(prep, line);
    p.enter_block();
    p.reserve(1);
    p.add_local(name, base + 3);
    p.statlist();
    p.leave_block();
    p.check(T.End, "'end'");
    let lp = p.emit(Mini.FORLOOP(base as u8, 0));
    p.patch(lp, prep + 1);
    p.patch(prep, p.pc());
    p.leave_block();
    p.loop_exit(saved);
}

/// `for k, v in pairs(e)` and `for i, v in ipairs(e)`: R[base] table,
/// R[base+1] traversal state, R[base+2], R[base+3] the variables.
fn Parser.generic_for(p: *Parser, name: str, line: u32) {
    var name2 = "(for value)";
    if p.accept(T.Comma) {
        name2 = p.tok.text;
        p.check(T.Name, "loop variable");
    }
    p.check(T.In, "'=' or 'in'");
    let it = p.tok.text;
    p.check(T.Name, "pairs or ipairs");
    let is_pairs = it.eq("pairs");
    if !is_pairs and !it.eq("ipairs") { fail(line, "generic for supports only pairs(...) and ipairs(...)"); }
    p.check(T.LParen, "'('");
    let saved = p.loop_enter();
    p.enter_block();
    let base = p.fs.freereg;
    let e = p.expr();
    p.to_next_reg(e);
    p.check(T.RParen, "')'");
    p.check(T.Do, "'do'");
    let r = p.reserve(1);
    p.emit(Mini.LOADI(r as u8, 0));
    p.add_local("(for table)", base);
    p.add_local("(for state)", base + 1);
    let j = p.emit(Mini.JMP(0));
    let body = p.pc();
    p.enter_block();
    p.reserve(2);
    p.add_local(name, base + 2);
    p.add_local(name2, base + 3);
    p.statlist();
    p.leave_block();
    p.check(T.End, "'end'");
    p.patch(j, p.pc());
    let at = if is_pairs { p.emit(Mini.NEXT(base as u8, 0)) } else { p.emit(Mini.INEXT(base as u8, 0)) };
    p.fs.lines.set(at, line);
    p.patch(at, body);
    p.leave_block();
    p.loop_exit(saved);
}

fn FuncState.new(name: str, parent: ?*FuncState) -> FuncState {
    FuncState {
        parent: parent,
        code: mem.Vec.new(),
        consts: mem.Vec.new(),
        locals: mem.Vec.new(),
        nactive: 0,
        freereg: 0,
        maxreg: 0,
        nparams: 0,
        name: name,
        breaks: mem.Vec.new(),
        loop_depth: 0,
        loop_level: 0,
        lines: mem.Vec.new(),
        upvals: mem.Vec.new(),
        protos: mem.Vec.new(),
        blocks: mem.Vec.new(),
    }
}

fn Parser.finish(p: *Parser, fs: *FuncState) -> Gc<Proto> {
    p.emit(Mini.RET0());
    let h = p.heap;
    let consts = value.new_arr(h, fs.consts.len);
    for i in 0..fs.consts.len { consts.data[i] = fs.consts.at(i); }
    let nregs = if fs.maxreg == 0 { 1 } else { fs.maxreg };
    let lines = new(h, Lines {}, fs.lines.len);
    for i in 0..fs.lines.len { lines.data[i] = fs.lines.at(i); }
    let protos = new(h, Protos {}, fs.protos.len);
    for i in 0..fs.protos.len { protos.data[i] = fs.protos.at(i); }
    let updesc = new(h, UpDescs {}, fs.upvals.len);
    for i in 0..fs.upvals.len {
        let u = fs.upvals.at(i);
        updesc.data[i] = if u.instack { 256 | u.idx } else { u.idx };
    }
    let proto = new(h, Proto {
        name: value.new_str(h, fs.name),
        nparams: fs.nparams,
        nregs: nregs,
        nupvals: fs.upvals.len as u32,
        consts: consts,
        lines: lines,
        protos: protos,
        updesc: updesc,
    }, fs.code.len);
    for i in 0..fs.code.len { proto.code[i] = fs.code.at(i); }
    if let Some(bad) = Mini.verify(proto.code, proto) {
        var b = text.StrBuf.new();
        b.push_str("internal error: generated code fails verification at instruction ");
        b.push_int(bad as i64);
        fail(0, b.as_str());
    }
    Mini.optimize(proto.code);
    fs.code.free();
    fs.consts.free();
    fs.locals.free();
    fs.breaks.free();
    fs.lines.free();
    fs.upvals.free();
    fs.protos.free();
    fs.blocks.free();
    proto
}

/// Compile a function body (after `function name`) into a child
/// prototype of the current function; returns its index.
fn Parser.function_body(p: *Parser, name: str, is_method: bool) -> u32 {
    let parent = p.fs;
    var fs = FuncState.new(name, Some(parent));
    p.fs = &fs;
    p.enter_block();
    if is_method {
        let r = p.reserve(1);
        p.add_local("self", r);
        fs.nparams += 1;
    }
    p.check(T.LParen, "'('");
    if p.tok.kind != T.RParen {
        loop {
            let pname = p.tok.text;
            p.check(T.Name, "parameter name");
            let r = p.reserve(1);
            p.add_local(pname, r);
            fs.nparams += 1;
            if !p.accept(T.Comma) { break; }
        }
    }
    p.check(T.RParen, "')'");
    p.statlist();
    p.check(T.End, "'end'");
    let proto = p.finish(&fs);
    p.fs = parent;
    parent.protos.push(proto);
    if parent.protos.len > 65535 { fail(p.line, "too many functions"); }
    (parent.protos.len - 1) as u32
}

/// Compile a chunk. Allocates in `h` but never collects.
pub fn compile(h: *gc.Heap, src: str) -> Gc<Proto> {
    var fs = FuncState.new("main chunk", None);
    var p = Parser {
        lx: Lexer { src: src, pos: 0, line: 1 },
        tok: Token { kind: T.Eof, text: "", line: 1, num: V.Nil },
        heap: h,
        fs: &fs,
        strings: map.HashMap.new(),
        line: 1,
    };
    p.advance();
    p.enter_block();
    p.statlist();
    if p.tok.kind != T.Eof { fail(p.tok.line, "'<eof>' expected"); }
    p.finish(&fs)
}
