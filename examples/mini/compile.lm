// Mini compiler: source text → register bytecode, in a single pass.
// Expressions are tracked as descriptors (as in Lua's expdesc) so that
// values are only materialized in a register when needed.
//
// The front end and the code buffer come from the standard library:
// std.lex scans tokens (Lua's comments, numerals, escapes and long
// brackets), std.parse's Pratt driver handles binary and unary operators
// with hooks that generate code as it goes, std.diag reports syntax
// errors with the source line and a caret, and std.bc holds the code
// (with jump patching and labels), the constant pool and the registers.

import std.io;
import std.mem;
import std.text;
import std.gc;
import std.os;
import std.lex;
import std.num;
import std.diag;
import std.parse;
import std.bc;
import std.rt;
import value;
import value.{V, Str, Arr, Table, Proto, Lines, Protos, UpDescs};
import vm.{Mini}; #[cfg(debug)] import debugger;

// ── lexer ────────────────────────────────────────────────────────────

enum T {
    Eof, Name, Number, String,
    And, Break, Do, Else, Elseif, End, False, For, Function, If, In, Local, Nil, Not, Or, Repeat, Return, Then, True, Until, While,
    Plus, Minus, Star, Slash, Percent, Caret, Hash, Concat, Eq, Ne, Lt, Le, Gt, Ge, Assign,
    LParen, RParen, LBrace, RBrace, LBracket, RBracket, Comma, Dot, Colon, Semi,
}

/// A token: `text` is a name or a decoded string literal, `num` a
/// numeral's value; `lo..hi` its bytes in the source.
struct Token { kind: T, text: str, line: u32, num: V, lo: u32, hi: u32 }

/// Shared by copies of the lexer (`peek_kind` lexes ahead on a copy).
struct LexTables { ops: lex.OpTable<T>, kw: lex.Keywords<T>, buf: text.StrBuf, strings: mem.Arena }

struct Lexer { cur: lex.Cursor, t: *LexTables }

fn LexTables.new() -> LexTables {
    var ops: lex.OpTable<T> = lex.OpTable.new();
    ops.add("+", T.Plus); ops.add("-", T.Minus); ops.add("*", T.Star); ops.add("/", T.Slash);
    ops.add("%", T.Percent); ops.add("^", T.Caret); ops.add("#", T.Hash); ops.add("..", T.Concat);
    ops.add("==", T.Eq); ops.add("~=", T.Ne); ops.add("<", T.Lt); ops.add("<=", T.Le);
    ops.add(">", T.Gt); ops.add(">=", T.Ge); ops.add("=", T.Assign);
    ops.add("(", T.LParen); ops.add(")", T.RParen); ops.add("{", T.LBrace); ops.add("}", T.RBrace);
    ops.add("[", T.LBracket); ops.add("]", T.RBracket); ops.add(",", T.Comma); ops.add(".", T.Dot);
    ops.add(":", T.Colon); ops.add(";", T.Semi);
    var kw: lex.Keywords<T> = lex.Keywords.new();
    kw.add("and", T.And); kw.add("break", T.Break); kw.add("do", T.Do); kw.add("else", T.Else);
    kw.add("elseif", T.Elseif); kw.add("end", T.End); kw.add("false", T.False); kw.add("for", T.For);
    kw.add("function", T.Function); kw.add("if", T.If); kw.add("in", T.In); kw.add("local", T.Local);
    kw.add("nil", T.Nil); kw.add("not", T.Not); kw.add("or", T.Or); kw.add("repeat", T.Repeat);
    kw.add("return", T.Return); kw.add("then", T.Then); kw.add("true", T.True); kw.add("until", T.Until);
    kw.add("while", T.While);
    LexTables { ops: ops, kw: kw, buf: text.StrBuf.new(), strings: mem.Arena.new() }
}

fn LexTables.free(t: *LexTables) {
    t.ops.free();
    t.kw.free();
    t.buf.free();
    t.strings.free();
}

/// Integers outside Mini's 32-bit range become floats.
fn num_value(n: num.Number) -> V {
    match n {
        Int(i) => if i >= -2147483648 and i <= 2147483647 { V.Int(i as i32) } else { V.Num(i as f64) },
        Float(f) => V.Num(f),
    }
}

fn Lexer.next(lx: *Lexer) -> Result<Token, lex.Error> {
    let c = &lx.cur;
    c.skip_trivia()?;
    let start = c.pos;
    var tok = Token { kind: T.Eof, text: "", line: c.line, num: V.Nil, lo: start as u32, hi: start as u32 };
    if c.at_end() { return Ok(tok); }
    if let Some(name) = c.ident() {
        tok.kind = lx.t.kw.get(name) ?? T.Name;
        tok.text = name;
    } else if c.at_number() {
        tok.kind = T.Number;
        tok.num = num_value(c.number()?);
    } else if c.peek() == '"' or c.peek() == '\'' {
        lx.t.buf.clear();
        c.quoted(&lx.t.buf)?;
        tok.kind = T.String;
        tok.text = lx.t.strings.str(lx.t.buf.as_str());
    } else if c.long_bracket_level().is_some() {
        tok.kind = T.String;
        tok.text = c.long_string()?;
    } else if let Some(k) = c.op(&lx.t.ops) {
        tok.kind = k;
    } else {
        return Err(c.error_here("unexpected character"));
    }
    tok.hi = c.pos as u32;
    Ok(tok)
}

// ── function state and expression descriptors ───────────────────────

/// A local variable. `id` numbers the chunk's locals in the order of
/// their declarations (the same in both passes of `compile`). `konst`:
/// declared with a constant value `kv` and never assigned, so that the
/// functions nested in its scope read the constant instead of an upvalue.
struct Local { name: str, reg: u32, id: u32, konst: bool, kv: V }

/// An upvalue of the function being compiled: register `idx` of the
/// enclosing function (instack) or upvalue `idx` of the enclosing closure;
/// `lid` is the id of the local it refers to.
struct UpDesc { name: str, instack: bool, idx: u32, lid: u32 }

/// A lexical block. `upval` is set when a nested function captures one of
/// the block's locals, so that leaving the block must close upvalues.
struct Block { first_local: u64, nactive: u32, upval: bool }

struct FuncState {
    parent: ?*FuncState,
    code: bc.Code<u32>,
    consts: bc.Pool<V>,
    regs: bc.Regs,
    locals: mem.Vec<Local>,
    nparams: u32,
    name: str,
    /// The innermost loop's exit, for `break`.
    loop_exit: ?bc.Label,
    /// First register of the innermost loop's variables (closed by `break`).
    loop_level: u32,
    upvals: mem.Vec<UpDesc>,
    /// Child prototypes. (The compiler never collects, so a plain Vec is fine.)
    protos: mem.Vec<Gc<Proto>>,
    blocks: mem.Vec<Block>,
}

enum VarRef { Loc(u32), Up(u32), Glob, Const(V) }

enum E {
    Nil,
    True,
    False,
    K(u32),
    I(i32),
    Local(u32),
    Upval(u32),
    Temp(u32),
    Global(u32),
    Field(u32, u32),
    Index(u32, u32),
    /// t[i] for an integer literal 1 <= i <= 255.
    IndexI(u32, u32),
    Reloc(u64),
    /// An open call: function and results at register .0, CALL at .1.
    /// Its result count can still be raised (see explist_to).
    Call(u32, u64),
}

struct LoopSave { exit: ?bc.Label, level: u32 }

struct Parser {
    lx: Lexer,
    tok: Token,
    /// The last consumed token (its line is recorded for each instruction).
    prev: Token,
    heap: *gc.Heap,
    fs: *FuncState,
    /// The operator parser. Its hooks never fail (errors exit through
    /// `Parser.fail`), hence the error type `()`.
    exprs: parse.Pratt<Parser, T, E, ()>,
    sm: *diag.SourceMap,
    file: u32,
    /// Constant locals (`compile`): FOLD_NONE, or the first pass, which
    /// records in `assigned` (by local id) which locals some statement
    /// assigns, or the second, which folds the others.
    fold: u32,
    nlocals: u32,
    assigned: *mem.Vec<bool>,
}

const FOLD_NONE: u32 = 0;
const FOLD_SCAN: u32 = 1;
const FOLD_APPLY: u32 = 2;

// ── errors ──────────────────────────────────────────────────────────

/// Where `try_compile` wants the syntax error message (None: `compile`).
#[thread_local]
var error_out: ?*text.StrBuf = None;

/// Report a syntax error at `s` ("line N: msg", the line and a caret) and
/// exit; under `try_compile`, hand it "line N: msg" and unwind.
fn Parser.fail_at(p: *Parser, s: diag.Span, msg: str) -> never {
    var b = text.StrBuf.new();
    b.push_str("line ");
    b.push_int(p.sm.line_col(s.file, s.lo).line as i64);
    b.push_str(": ");
    b.push_str(msg);
    if let Some(out) = error_out {
        out.push_str(b.as_str());
        b.free();
        rt.throw()
    }
    var d = diag.error(s, b.as_str());
    p.sm.eprint(&d);
    os.quit(1)
}

fn tok_span(p: *Parser, t: Token) -> diag.Span { diag.span(p.file, t.lo as u64, t.hi as u64) }

/// An error at the current token.
fn Parser.fail(p: *Parser, msg: str) -> never { p.fail_at(tok_span(p, p.tok), msg) }

/// An error at the last consumed token.
fn Parser.fail_prev(p: *Parser, msg: str) -> never { p.fail_at(tok_span(p, p.prev), msg) }

/// An error from the first token `first` to the last consumed one.
fn Parser.fail_from(p: *Parser, first: Token, msg: str) -> never {
    p.fail_at(tok_span(p, first).to(tok_span(p, p.prev)), msg)
}

/// An internal error, without a position.
fn internal_error(msg: str) -> never {
    var b = text.StrBuf.new();
    b.push_str("error: internal error: ");
    b.push_str(msg);
    io.eprintln(b.as_str());
    os.quit(1)
}

// ── tokens ──────────────────────────────────────────────────────────

fn Parser.advance(p: *Parser) {
    p.prev = p.tok;
    p.tok = match p.lx.next() {
        Ok(t) => t,
        Err(e) => p.fail_at(e.span, e.msg),
    };
}

/// The kind of the token after the current one.
fn Parser.peek_kind(p: *Parser) -> T {
    var lx = p.lx;
    match lx.next() {
        Ok(t) => t.kind,
        Err(_) => T.Eof,
    }
}

fn Parser.check(p: *Parser, k: T, what: str) {
    if p.tok.kind != k {
        var b = text.StrBuf.new();
        b.push_str("expected ");
        b.push_str(what);
        b.push_str(" near ");
        if p.tok.kind == T.Eof {
            b.push_str("<eof>");
        } else {
            b.push('\'');
            b.push_str(p.lx.cur.src[p.tok.lo as u64..p.tok.hi as u64]);
            b.push('\'');
        }
        p.fail(b.as_str());
    }
    p.advance();
}

fn Parser.accept(p: *Parser, k: T) -> bool {
    if p.tok.kind == k { p.advance(); return true; }
    false
}

// ── variables ───────────────────────────────────────────────────────

fn FuncState.find_local(fs: *FuncState, name: str) -> ?u64 {
    var i = fs.locals.len;
    while i > 0 {
        i -= 1;
        if fs.locals.at(i).name.eq(name) { return Some(i); }
    }
    None
}

/// Flag the block that declares local number `li` as captured.
fn FuncState.mark_captured(fs: *FuncState, li: u64) {
    var i = fs.blocks.len;
    while i > 0 {
        i -= 1;
        let b = fs.blocks.ptr_at(i);
        if b.first_local <= li {
            b.upval = true;
            return;
        }
    }
}

/// Resolve a name: a local, an upvalue (created on demand through the
/// enclosing functions), or a global.
fn FuncState.resolve(fs: *FuncState, p: *Parser, name: str) -> VarRef {
    if let Some(li) = fs.find_local(name) { return VarRef.Loc(fs.locals.at(li).reg); }
    for i in 0..fs.upvals.len {
        if fs.upvals.at(i).name.eq(name) { return VarRef.Up(i as u32); }
    }
    let Some(parent) = fs.parent else { return VarRef.Glob; };
    var instack = false;
    var idx: u32 = 0;
    var lid: u32 = 0;
    if let Some(li) = parent.find_local(name) {
        let l = parent.locals.at(li);
        if l.konst { return VarRef.Const(l.kv); }
        parent.mark_captured(li);
        instack = true;
        idx = l.reg;
        lid = l.id;
    } else {
        match parent.resolve(p, name) {
            Up(i) => {
                idx = i;
                lid = parent.upvals.at(i as u64).lid;
            }
            Const(v) => return VarRef.Const(v),
            _ => return VarRef.Glob,
        }
    }
    if fs.upvals.len >= 255 { p.fail_prev("too many upvalues"); }
    fs.upvals.push(UpDesc { name: name, instack: instack, idx: idx, lid: lid });
    VarRef.Up((fs.upvals.len - 1) as u32)
}

// ── code, constants and registers ───────────────────────────────────

fn Parser.emit(p: *Parser, w: u32) -> u64 {
    p.fs.code.set_loc(p.prev.line);
    p.fs.code.op(w)
}

/// Emit an instruction attributed to `line` (a loop's header).
fn Parser.emit_line(p: *Parser, w: u32, line: u32) -> u64 {
    p.fs.code.set_loc(line);
    p.fs.code.op(w)
}

fn Parser.pc(p: *Parser) -> u64 { p.fs.code.pc() }

fn Parser.jump(p: *Parser) -> u64 { p.emit(Mini.JMP(0)) }

/// Point the jump at `at` to `target`. (A jump that does not fit is
/// reported when the function ends.)
fn Parser.patch(p: *Parser, at: u64, target: u64) { p.fs.code.patch(at, target); }

fn Parser.patch_here(p: *Parser, l: *mem.Vec<u64>) { p.fs.code.patch_here(l); }

/// Strings are interned, so equal constants have equal bits.
fn Parser.constant(p: *Parser, v: V) -> u32 {
    p.fs.consts.add(v) ?? p.fail("too many constants")
}

fn Parser.str_const(p: *Parser, s: str) -> u32 {
    p.constant(V.S(value.new_str(p.heap, s)))
}

fn Parser.reserve(p: *Parser, n: u32) -> u32 {
    p.fs.regs.try_alloc(n) ?? p.fail("function or expression needs too many registers")
}

fn Parser.free_reg(p: *Parser, r: u32) {
    if !p.fs.regs.free(r) { internal_error("register freed out of order"); }
}

fn Parser.free_exp(p: *Parser, e: E) {
    match e {
        Temp(r) => p.free_reg(r),
        Call(r, _) => p.free_reg(r),
        Field(t, _) => p.free_reg(t),
        IndexI(t, _) => p.free_reg(t),
        Index(t, k) => {
            if k > t { p.free_reg(k); p.free_reg(t); } else { p.free_reg(t); p.free_reg(k); }
        }
        _ => {}
    }
}

/// Emit code that leaves the value of `e` in `dst` (no freeing).
fn Parser.discharge(p: *Parser, e: E, dst: u32) {
    let d = dst as u8;
    match e {
        Nil => { p.emit(Mini.LOADNIL(d)); }
        True => { p.emit(Mini.LOADBOOL(d, 1)); }
        False => { p.emit(Mini.LOADBOOL(d, 0)); }
        I(i) => { p.emit(Mini.LOADI(d, i as i16)); }
        K(k) => { p.emit(Mini.LOADK(d, k as u16)); }
        Local(r) => { if r != dst { p.emit(Mini.MOVE(d, r as u8)); } }
        Temp(r) => { if r != dst { p.emit(Mini.MOVE(d, r as u8)); } }
        Call(r, _) => { if r != dst { p.emit(Mini.MOVE(d, r as u8)); } }
        Upval(i) => { p.emit(Mini.GETUPVAL(d, i as u8)); }
        Global(k) => { p.emit(Mini.GETGLOBAL(d, k as u16)); }
        Field(t, k) => { p.emit(Mini.GETFIELD(d, t as u8, k as u8)); }
        Index(t, k) => { p.emit(Mini.GETINDEX(d, t as u8, k as u8)); }
        IndexI(t, i) => { p.emit(Mini.GETINDEXI(d, t as u8, i as u8)); }
        Reloc(at) => {
            let w = p.fs.code.at(at);
            p.fs.code.set(at, (w & 0xFFFF00FF) | (dst << 8));
        }
    }
}

/// Put `e` in the next free register.
fn Parser.to_next_reg(p: *Parser, e: E) -> u32 {
    p.free_exp(e);
    let r = p.reserve(1);
    p.discharge(e, r);
    r
}

/// Any register holding the value of `e` (a local's own register if possible).
fn Parser.any_reg(p: *Parser, e: E) -> E {
    match e {
        Local(_) | Temp(_) | Call(_, _) => e,
        _ => E.Temp(p.to_next_reg(e)),
    }
}

fn reg_of(e: E) -> u32 {
    match e {
        Local(r) => r,
        Temp(r) => r,
        Call(r, _) => r,
        _ => 0,
    }
}

/// Assign the value of `v` to the variable `target`. Temporaries are
/// not freed: statements reset the free register at their end.
fn Parser.store_var(p: *Parser, target: E, v: E) {
    if p.fold == FOLD_SCAN { p.note_assigned(target); }
    match target {
        Local(r) => p.discharge(v, r),
        Upval(i) => {
            let v = p.any_reg(v);
            p.emit(Mini.SETUPVAL(reg_of(v) as u8, i as u8));
        }
        Global(k) => {
            let v = p.any_reg(v);
            p.emit(Mini.SETGLOBAL(reg_of(v) as u8, k as u16));
        }
        Field(t, k) => {
            let v = p.any_reg(v);
            p.emit(Mini.SETFIELD(t as u8, k as u8, reg_of(v) as u8));
        }
        Index(t, k) => {
            if let Some(c) = p.kindex(v, true) {
                p.emit(Mini.SETINDEXK(t as u8, k as u8, c as u8));
                return;
            }
            let v = p.any_reg(v);
            p.emit(Mini.SETINDEX(t as u8, k as u8, reg_of(v) as u8));
        }
        IndexI(t, i) => {
            let v = p.any_reg(v);
            let kr = p.reserve(1);
            p.emit(Mini.LOADI(kr as u8, i as i16));
            p.emit(Mini.SETINDEX(t as u8, kr as u8, reg_of(v) as u8));
        }
        _ => p.fail_prev("cannot assign to this expression"),
    }
}

/// The first pass of `compile`: record that the local behind `target`
/// (a register of this function or an upvalue) is assigned.
fn Parser.note_assigned(p: *Parser, target: E) {
    var id: u32 = 0;
    match target {
        Local(r) => {
            var i = p.fs.locals.len;
            loop {
                if i == 0 { return; }
                i -= 1;
                if p.fs.locals.at(i).reg == r { break; }
            }
            id = p.fs.locals.at(i).id;
        }
        Upval(u) => id = p.fs.upvals.at(u as u64).lid,
        _ => return,
    }
    p.assigned.set(id as u64, true);
}

// ── expressions ─────────────────────────────────────────────────────

/// The constant expression for value `v` (of a constant local).
fn Parser.const_exp(p: *Parser, v: V) -> E {
    match v {
        Nil => E.Nil,
        Bool(b) => if b { E.True } else { E.False },
        _ => {
            if let Some(i) = small_int(v) { return E.I(i); }
            E.K(p.constant(v))
        }
    }
}

fn Parser.singlevar(p: *Parser, name: str) -> E {
    match p.fs.resolve(p, name) {
        Loc(r) => E.Local(r),
        Up(i) => E.Upval(i),
        Glob => E.Global(p.str_const(name)),
        Const(v) => p.const_exp(v),
    }
}

fn small_int(v: V) -> ?i32 {
    if let Int(i) = v and i >= -32768 and i <= 32767 { return Some(i); }
    None
}

fn Parser.primary(p: *Parser) -> E {
    let t = p.tok;
    match t.kind {
        Name => {
            p.advance();
            p.singlevar(t.text)
        }
        LParen => {
            p.advance();
            let e = p.expr();
            p.check(T.RParen, "')'");
            // A parenthesized call or field read is just one value.
            match p.any_reg(e) {
                Call(r, _) => E.Temp(r),
                x => x,
            }
        }
        _ => p.fail("unexpected symbol"),
    }
}

fn Parser.field_key(p: *Parser, t: E, k: u32) -> E {
    if k <= 255 { return E.Field(reg_of(t), k); }
    let kr = p.reserve(1);
    p.emit(Mini.LOADK(kr as u8, k as u16));
    E.Index(reg_of(t), kr)
}

/// Arguments of a call whose function is in `base` and whose first
/// `nfixed` arguments are already in place; emits the CALL.
fn Parser.call_args(p: *Parser, base: u32, nfixed: u32) -> E {
    var nargs = nfixed;
    match p.tok.kind {
        String => {
            let k = p.str_const(p.tok.text);
            p.advance();
            p.to_next_reg(E.K(k));
            nargs += 1;
        }
        LBrace => {
            let t = p.constructor();
            p.to_next_reg(t);
            nargs += 1;
        }
        LParen => {
            p.advance();
            if p.tok.kind != T.RParen {
                loop {
                    let a = p.expr();
                    p.to_next_reg(a);
                    nargs += 1;
                    if !p.accept(T.Comma) { break; }
                }
            }
            p.check(T.RParen, "')'");
        }
        _ => p.fail("function arguments expected"),
    }
    let at = p.emit(Mini.CALL(base as u8, nargs as u8, 1));
    p.fs.regs.reset(base + 1);
    E.Call(base, at)
}

fn Parser.suffixed(p: *Parser) -> E {
    var e = p.primary();
    loop {
        match p.tok.kind {
            Dot => {
                p.advance();
                let name = p.tok;
                p.check(T.Name, "field name");
                let t = p.any_reg(e);
                let k = p.str_const(name.text);
                e = p.field_key(t, k);
            }
            LBracket => {
                p.advance();
                let t = p.any_reg(e);
                let ke = p.expr();
                if let I(i) = ke and i >= 1 and i <= 255 {
                    p.check(T.RBracket, "']'");
                    e = E.IndexI(reg_of(t), i as u32);
                    continue;
                }
                let k = p.any_reg(ke);
                p.check(T.RBracket, "']'");
                e = E.Index(reg_of(t), reg_of(k));
            }
            Colon => {
                p.advance();
                let name = p.tok;
                p.check(T.Name, "method name");
                let obj = p.any_reg(e);
                p.free_exp(obj);
                let base = p.reserve(2);
                let k = p.str_const(name.text);
                if k <= 255 {
                    p.emit(Mini.SELF(base as u8, reg_of(obj) as u8, k as u8));
                } else {
                    p.emit(Mini.MOVE((base + 1) as u8, reg_of(obj) as u8));
                    p.emit(Mini.LOADK(base as u8, k as u16));
                    p.emit(Mini.GETINDEX(base as u8, (base + 1) as u8, base as u8));
                }
                e = p.call_args(base, 1);
            }
            LParen | String | LBrace => {
                let base = p.to_next_reg(e);
                e = p.call_args(base, 0);
            }
            _ => return e,
        }
    }
}

/// Table constructor: positional items are collected in registers above
/// the table and stored in batches by SETLIST.
fn Parser.constructor(p: *Parser) -> E {
    p.check(T.LBrace, "'{'");
    if p.accept(T.RBrace) { return E.Reloc(p.emit(Mini.NEWTABLE(0, 0, 0))); }
    let t = p.reserve(1);
    let at = p.emit(Mini.NEWTABLE(t as u8, 0, 0));
    var narr: u32 = 0;
    var nhash: u32 = 0;
    var pending: u32 = 0;
    var batch: u32 = 0;
    while p.tok.kind != T.RBrace {
        if p.tok.kind == T.Name and p.peek_kind() == T.Assign {
            let name = p.tok.text;
            p.advance();
            p.advance();
            let k = p.str_const(name);
            let v = p.expr();
            let vr = p.any_reg(v);
            if k <= 255 {
                p.emit(Mini.SETFIELD(t as u8, k as u8, reg_of(vr) as u8));
            } else {
                let kr = p.reserve(1);
                p.emit(Mini.LOADK(kr as u8, k as u16));
                p.emit(Mini.SETINDEX(t as u8, kr as u8, reg_of(vr) as u8));
            }
            p.fs.regs.reset(t + 1 + pending);
            nhash += 1;
        } else if p.tok.kind == T.LBracket {
            p.advance();
            let ke = p.expr();
            let kr = p.any_reg(ke);
            p.check(T.RBracket, "']'");
            p.check(T.Assign, "'='");
            let v = p.expr();
            let vr = p.any_reg(v);
            p.emit(Mini.SETINDEX(t as u8, reg_of(kr) as u8, reg_of(vr) as u8));
            p.fs.regs.reset(t + 1 + pending);
            nhash += 1;
        } else {
            let e = p.expr();
            p.to_next_reg(e);
            pending += 1;
            narr += 1;
            if pending == 50 {
                p.flush_list(t, pending, batch);
                pending = 0;
                batch += 1;
            }
        }
        if !p.accept(T.Comma) and !p.accept(T.Semi) { break; }
    }
    p.check(T.RBrace, "'}'");
    if pending > 0 { p.flush_list(t, pending, batch); }
    let na = if narr > 255 { 255 } else { narr };
    let nh = if nhash > 255 { 255 } else { nhash };
    p.fs.code.set(at, Mini.NEWTABLE(t as u8, na as u8, nh as u8));
    E.Temp(t)
}

fn Parser.flush_list(p: *Parser, t: u32, n: u32, batch: u32) {
    if batch > 255 { p.fail("table constructor too long"); }
    p.emit(Mini.SETLIST(t as u8, n as u8, batch as u8));
    p.fs.regs.reset(t + 1);
}

fn Parser.simple(p: *Parser) -> E {
    let t = p.tok;
    match t.kind {
        Number => {
            p.advance();
            if let Some(i) = small_int(t.num) { return E.I(i); }
            E.K(p.constant(t.num))
        }
        String => {
            p.advance();
            E.K(p.str_const(t.text))
        }
        Nil => { p.advance(); E.Nil }
        True => { p.advance(); E.True }
        False => { p.advance(); E.False }
        LBrace => p.constructor(),
        Function => {
            p.advance();
            let idx = p.function_body("anonymous", false);
            E.Reloc(p.emit(Mini.CLOSURE(0, idx as u16)))
        }
        _ => p.suffixed(),
    }
}

// Operators go through std.parse's Pratt driver. Binding powers, as in
// Lua: `or` < `and` < comparisons < `..` (right) < `+ -` < `* / %` <
// unary < `^` (right).
// `and`, `or` and `..` are `led` operators: their hooks need to emit
// code both before and after the right operand.

const UNARY: u32 = 8;

fn operators() -> parse.Pratt<Parser, T, E, ()> {
    var x: parse.Pratt<Parser, T, E, ()> = parse.Pratt.new(hook_peek, hook_advance, hook_atom, hook_unary, hook_binary);
    x.before_rhs = Some(hook_before_rhs);
    x.led(T.Or, 1, 1, hook_andor);
    x.led(T.And, 2, 2, hook_andor);
    x.infix_left(T.Eq, 3); x.infix_left(T.Ne, 3); x.infix_left(T.Lt, 3);
    x.infix_left(T.Le, 3); x.infix_left(T.Gt, 3); x.infix_left(T.Ge, 3);
    x.led(T.Concat, 5, 4, hook_concat);
    x.infix_left(T.Plus, 6); x.infix_left(T.Minus, 6);
    x.infix_left(T.Star, 7); x.infix_left(T.Slash, 7); x.infix_left(T.Percent, 7);
    x.infix_right(T.Caret, 10);
    x.prefix(T.Not, UNARY); x.prefix(T.Minus, UNARY); x.prefix(T.Hash, UNARY);
    x
}

fn Parser.expr(p: *Parser) -> E { p.subexpr(0) }

/// An expression whose operators all bind tighter than `limit`.
fn Parser.subexpr(p: *Parser, limit: u32) -> E {
    match p.exprs.parse(p, limit) {
        Ok(e) => e,
        Err(_) => unreachable,
    }
}

fn hook_peek(p: *Parser) -> T { p.tok.kind }
fn hook_advance(p: *Parser) -> Result<(), ()> { p.advance(); Ok(()) }
fn hook_atom(p: *Parser) -> Result<E, ()> { Ok(p.simple()) }

fn hook_unary(p: *Parser, op: T, operand: E) -> Result<E, ()> {
    if op == T.Minus {
        if let I(i) = operand { return Ok(E.I(0 - i)); }
    }
    let r = p.any_reg(operand);
    p.free_exp(r);
    let a = reg_of(r) as u8;
    let w = match op {
        Not => Mini.NOT(0, a),
        Minus => Mini.NEG(0, a),
        _ => Mini.LEN(0, a),
    };
    Ok(E.Reloc(p.emit(w)))
}

/// `e and rhs`, `e or rhs`: test `e` in the result register and skip
/// the right operand.
fn hook_andor(p: *Parser, op: T, e: E) -> Result<E, ()> {
    let r = p.to_next_reg(e);
    let j = p.emit(if op == T.And { Mini.TEST(r as u8, 0) } else { Mini.TESTT(r as u8, 0) });
    let rhs = p.subexpr(p.exprs.infix_of(op).right);
    p.free_exp(rhs);
    p.discharge(rhs, r);
    p.patch(j, p.pc());
    Ok(E.Temp(r))
}

/// `e .. rhs`, with `e` in the next register.
fn hook_concat(p: *Parser, op: T, e: E) -> Result<E, ()> {
    let l = p.to_next_reg(e);
    let rhs = p.subexpr(p.exprs.infix_of(op).right);
    Ok(p.concat(l, rhs))
}

/// After an arithmetic or comparison operator, before its right operand:
/// put the left operand in a register.
fn hook_before_rhs(p: *Parser, op: T, e: E) -> Result<E, ()> {
    // A constant left operand of a commutative operator or a comparison
    // stays unmaterialized, so the K form can be used with the operands
    // swapped (`k - x` and `k / x` have their own reversed ops).
    if swappable(op) and p.kindex(e, op == T.Eq or op == T.Ne).is_some() { return Ok(e); }
    Ok(p.any_reg(e))
}

fn hook_binary(p: *Parser, op: T, e: E, rhs: E) -> Result<E, ()> {
    let eq = op == T.Eq or op == T.Ne;
    if swappable(op) and let Some(kl) = p.kindex(e, eq) {
        if p.kindex(rhs, eq).is_none() {
            let r = p.any_reg(rhs);
            p.free_exp(r);
            let a = reg_of(r) as u8;
            let k = kl as u8;
            let w = match op {
                Plus => Mini.ADDK(0, a, k),
                Star => Mini.MULK(0, a, k),
                Minus => Mini.RSUBK(0, a, k),
                Slash => Mini.RDIVK(0, a, k),
                Eq | Ne => Mini.EQK(0, a, k),
                Lt => Mini.GTK(0, a, k),
                Le => Mini.GEK(0, a, k),
                Gt => Mini.LTK(0, a, k),
                _ => Mini.LEK(0, a, k),
            };
            return Ok(p.finish_binop(op, w));
        }
        let l = p.any_reg(e);
        return Ok(p.binop(op, l, rhs));
    }
    Ok(p.binop(op, e, rhs))
}

/// `R[l] .. rhs`: operands go to consecutive registers, and a chain
/// a .. b .. c becomes one CONCAT over all of them (as in Lua).
fn Parser.concat(p: *Parser, l: u32, rhs: E) -> E {
    // The right operand is itself a concatenation starting right after l:
    // extend it to start at l.
    if let Reloc(at) = rhs and at + 1 == p.pc() {
        let w = p.fs.code.at(at);
        if Mini.opcode(w) == Mini.OP_CONCAT and ((w >> 16) & 255) == l + 1 {
            let n = (w >> 24) + 1;
            p.fs.code.set(at, Mini.CONCAT(0, l as u8, n as u8));
            p.free_reg(l);
            return rhs;
        }
    }
    let r = p.to_next_reg(rhs);
    if r != l + 1 { internal_error("concat operands not consecutive"); }
    p.free_reg(r);
    p.free_reg(l);
    E.Reloc(p.emit(Mini.CONCAT(0, l as u8, 2)))
}

fn swappable(op: T) -> bool {
    op == T.Plus or op == T.Star or op == T.Minus or op == T.Slash or op == T.Eq or op == T.Ne or op == T.Lt or op == T.Le or op == T.Gt or op == T.Ge
}

/// The constant index (at most 255) of a numeric constant expression, or
/// also of nil, true, false and strings if `any`.
fn Parser.kindex(p: *Parser, e: E, any: bool) -> ?u32 {
    let k = match e {
        I(i) => p.constant(V.Int(i)),
        K(k) => {
            let v = p.fs.consts.get(k);
            let num = v is Int | Num;
            if !any and !num { return None; }
            k
        }
        Nil => if any { p.constant(V.Nil) } else { return None; },
        True => if any { p.constant(V.Bool(true)) } else { return None; },
        False => if any { p.constant(V.Bool(false)) } else { return None; },
        _ => return None,
    };
    if k > 255 { None } else { Some(k) }
}

/// The binary operator `op` on `l` (in a register) and `rhs`.
fn Parser.binop(p: *Parser, op: T, l: E, rhs: E) -> E {
    // x + c and x - c with a small constant c.
    if op == T.Plus or op == T.Minus {
        if let I(c) = rhs {
            let c = if op == T.Minus { 0 - c } else { c };
            if c >= -128 and c <= 127 {
                p.free_exp(l);
                return E.Reloc(p.emit(Mini.ADDI(0, reg_of(l) as u8, c as i8)));
            }
        }
    }
    let a = reg_of(l) as u8;
    if op != T.Caret and let Some(k) = p.kindex(rhs, op == T.Eq or op == T.Ne) {
        p.free_exp(l);
        let k = k as u8;
        let w = match op {
            Plus => Mini.ADDK(0, a, k),
            Minus => Mini.SUBK(0, a, k),
            Star => Mini.MULK(0, a, k),
            Slash => Mini.DIVK(0, a, k),
            Percent => Mini.MODK(0, a, k),
            Eq | Ne => Mini.EQK(0, a, k),
            Lt => Mini.LTK(0, a, k),
            Le => Mini.LEK(0, a, k),
            Gt => Mini.GTK(0, a, k),
            _ => Mini.GEK(0, a, k),
        };
        return p.finish_binop(op, w);
    }
    let r = p.any_reg(rhs);
    p.free_exp(r);
    p.free_exp(l);
    let b = reg_of(r) as u8;
    let w = match op {
        Plus => Mini.ADD(0, a, b),
        Minus => Mini.SUB(0, a, b),
        Star => Mini.MUL(0, a, b),
        Slash => Mini.DIV(0, a, b),
        Percent => Mini.MOD(0, a, b),
        Caret => Mini.POW(0, a, b),
        Eq | Ne => Mini.EQ(0, a, b),
        Lt => Mini.LT(0, a, b),
        Le => Mini.LE(0, a, b),
        Gt => Mini.LT(0, b, a),
        _ => Mini.LE(0, b, a),
    };
    p.finish_binop(op, w)
}

/// Emit the instruction `w` for operator `op` (negated for `~=`).
fn Parser.finish_binop(p: *Parser, op: T, w: u32) -> E {
    let e = E.Reloc(p.emit(w));
    if op != T.Ne { return e; }
    let t = p.to_next_reg(e);
    p.free_reg(t);
    E.Reloc(p.emit(Mini.NOT(0, t as u8)))
}

/// Evaluate an expression list into consecutive registers starting at
/// the free register, adjusted to exactly `nvars` values. Only a call in
/// the last position can produce several values.
/// A constant that `store_var` can store without a register.
fn is_const(e: E) -> bool {
    match e {
        True | False | Nil | I(_) | K(_) => true,
        _ => false,
    }
}

/// `explist_to` for a multiple assignment: the `nvars` values, each a
/// register from the current top on, or a constant left unloaded (its
/// register is reserved but not written), so that `t[i], u[j] = true,
/// false` stores constants (SETINDEXK) instead of loading them first.
fn Parser.explist_vals(p: *Parser, nvars: u32) -> mem.Vec<E> {
    let start = p.fs.regs.top;
    var vals: mem.Vec<E> = mem.Vec.new();
    var n: u32 = 1;
    var e = p.expr();
    while p.accept(T.Comma) {
        if is_const(e) {
            p.reserve(1);
            vals.push(e);
        } else {
            vals.push(E.Temp(p.to_next_reg(e)));
        }
        e = p.expr();
        n += 1;
    }
    if let Call(base, at) = e and n < nvars {
        if base != start + n - 1 { internal_error("misplaced call results"); }
        let want = nvars - n + 1;
        let w = p.fs.code.at(at);
        p.fs.code.set(at, (w & 0x00FFFFFF) | (want << 24));
        p.reserve(want - 1);
        for i in 0..want { vals.push(E.Temp(base + i)); }
        return vals;
    }
    if is_const(e) {
        p.reserve(1);
        vals.push(e);
    } else {
        vals.push(E.Temp(p.to_next_reg(e)));
    }
    while n < nvars {
        p.reserve(1);
        vals.push(E.Nil);
        n += 1;
    }
    p.fs.regs.reset(start + nvars);
    vals
}

fn Parser.explist_to(p: *Parser, nvars: u32) {
    let start = p.fs.regs.top;
    var n: u32 = 1;
    var e = p.expr();
    while p.accept(T.Comma) {
        p.to_next_reg(e);
        e = p.expr();
        n += 1;
    }
    if let Call(base, at) = e and n < nvars {
        if base != start + n - 1 { internal_error("misplaced call results"); }
        let want = nvars - n + 1;
        let w = p.fs.code.at(at);
        p.fs.code.set(at, (w & 0x00FFFFFF) | (want << 24));
        p.reserve(want - 1);
        return;
    }
    p.to_next_reg(e);
    while n < nvars {
        let r = p.reserve(1);
        p.emit(Mini.LOADNIL(r as u8));
        n += 1;
    }
    p.fs.regs.reset(start + nvars);
}

// ── statements ──────────────────────────────────────────────────────

fn block_end(k: T) -> bool {
    k == T.End or k == T.Else or k == T.Elseif or k == T.Until or k == T.Eof
}

fn Parser.enter_block(p: *Parser) {
    p.fs.blocks.push(Block { first_local: p.fs.locals.len, nactive: p.fs.regs.nactive, upval: false });
}

fn Parser.leave_block(p: *Parser) {
    let Some(b) = p.fs.blocks.pop() else { internal_error("block underflow") };
    // The function's outermost block needs no CLOSE: returning closes.
    if b.upval and p.fs.blocks.len > 0 { p.emit(Mini.CLOSE(b.nactive as u8)); }
    #[cfg(debug)] debugger.close_locals(p.fs as *u8, b.first_local, p.fs.code.len()); p.fs.locals.truncate(b.first_local);
    p.fs.regs.leave(b.nactive);
}

fn Parser.statlist(p: *Parser) {
    while !block_end(p.tok.kind) {
        if p.tok.kind == T.Return {
            p.statement();
            return;
        }
        p.statement();
    }
}

fn Parser.block(p: *Parser) {
    p.enter_block();
    p.statlist();
    p.leave_block();
}

/// Make register `r` (already reserved) the local `name`.
fn Parser.add_local(p: *Parser, name: str, r: u32) {
    #[cfg(debug)] debugger.open_local(p.fs as *u8, name, r, p.fs.code.len()); p.fs.locals.push(Local { name: name, reg: r, id: p.nlocals, konst: false, kv: V.Nil });
    if p.fold == FOLD_SCAN { p.assigned.push(false); }
    p.nlocals += 1;
    p.fs.regs.activate(r + 1 - p.fs.regs.nactive);
}

// Conditions of if, while and repeat compile to jumps, as in Lua: each
// operand of an and/or chain jumps straight to the false (or true) exit,
// `not` flips a test instead of materializing a boolean, and constants
// fold away.

/// Emit a test of `e` that jumps when its truthiness is `when` (to be
/// patched), or nothing if it can never jump. Falls through otherwise.
fn Parser.jump_if(p: *Parser, e: E, when: bool) -> ?u64 {
    match e {
        True => return if when { Some(p.jump()) } else { None },
        Nil | False => return if when { None } else { Some(p.jump()) },
        _ => {}
    }
    var when = when;
    var src: u32 = 0;
    var e = e;
    let code = &p.fs.code;
    if let Reloc(at) = e and at + 1 == p.pc() and Mini.opcode(code.at(at)) == Mini.OP_NOT {
        src = (code.at(at) >> 16) & 255;
        code.truncate(at);
        when = !when;
        // `a ~= b` is EQ into a temporary, then NOT.
        if at > 0 and Mini.jump(Mini.opcode(code.at(at - 1))).is_some() and ((code.at(at - 1) >> 8) & 255) == src and p.fs.regs.is_temp(src) {
            e = E.Reloc(at - 1);
        } else {
            return Some(p.emit(if when { Mini.TESTT(src as u8, 0) } else { Mini.TEST(src as u8, 0) }));
        }
    }
    // A comparison just emitted: compare and branch.
    if let Reloc(at) = e and at + 1 == p.pc() {
        let w = code.at(at);
        if let Some(jop) = Mini.jump(Mini.opcode(w)) {
            let o = if when { jop } else { Mini.negate(jop).unwrap() };
            code.set(at, (w & 0xFFFF0000) | o);
            return Some(p.jump());
        }
    }
    let r = p.any_reg(e);
    p.free_exp(r);
    src = reg_of(r);
    Some(p.emit(if when { Mini.TESTT(src as u8, 0) } else { Mini.TEST(src as u8, 0) }))
}

/// `a and b and ...`: falls through when all are true; returns the jumps
/// taken when one is false.
fn Parser.cond_and(p: *Parser) -> mem.Vec<u64> {
    var f: mem.Vec<u64> = mem.Vec.new();
    loop {
        // Operands bind tighter than `and` and `or`.
        let e = p.subexpr(2);
        if let Some(j) = p.jump_if(e, false) { f.push(j); }
        if !p.accept(T.And) { break; }
    }
    f
}

/// A condition: falls through when true; returns the jumps taken when
/// false (to be patched to the false exit, then freed).
fn Parser.cond(p: *Parser) -> mem.Vec<u64> {
    var t: mem.Vec<u64> = mem.Vec.new();
    var f = p.cond_and();
    let code = &p.fs.code;
    while p.accept(T.Or) {
        // This operand being true makes the whole condition true.
        var flipped = false;
        if f.len > 0 {
            let last = f.at(f.len - 1);
            let w = code.at(last);
            let op = Mini.opcode(w);
            if last + 1 == p.pc() and (op == Mini.OP_TEST or op == Mini.OP_TESTT) {
                // Invert the final test: jump to the true exit instead.
                let r = ((w >> 8) & 255) as u8;
                code.set(last, if op == Mini.OP_TEST { Mini.TESTT(r, 0) } else { Mini.TEST(r, 0) });
                f.pop();
                t.push(last);
                flipped = true;
            } else if last + 1 == p.pc() and op == Mini.OP_JMP and last > 0 and Mini.negate(Mini.opcode(code.at(last - 1))).is_some() {
                // Same for a compare and branch: flip its polarity.
                let cw = code.at(last - 1);
                code.set(last - 1, (cw & 0xFFFFFF00) | Mini.negate(Mini.opcode(cw)).unwrap());
                f.pop();
                t.push(last);
                flipped = true;
            }
        }
        if !flipped { t.push(p.jump()); }
        p.patch_here(&f);
        f.free();
        f = p.cond_and();
    }
    p.patch_here(&t);
    t.free();
    f
}

/// Words of condition code that a while loop repeats after its body.
const MAX_ROTATE: u64 = 16;

/// A condition that jumps to `target` when true and falls through when
/// false; returns the jumps taken when false (to be patched to the
/// fall-through point, then freed). `cond` with the opposite sense, for
/// the test at the bottom of a rotated while loop.
fn Parser.cond_jump_true(p: *Parser, target: u64) -> mem.Vec<u64> {
    loop {
        // One and-chain: a false operand goes to the next alternative
        // (or out), a true last operand to `target`.
        var fails: mem.Vec<u64> = mem.Vec.new();
        loop {
            let e = p.subexpr(2);
            if p.accept(T.And) {
                if let Some(j) = p.jump_if(e, false) { fails.push(j); }
                continue;
            }
            if let Some(j) = p.jump_if(e, true) { p.patch(j, target); }
            break;
        }
        if !p.accept(T.Or) { return fails; }
        p.patch_here(&fails);
        fails.free();
    }
}

fn Parser.loop_enter(p: *Parser) -> LoopSave {
    let s = LoopSave { exit: p.fs.loop_exit, level: p.fs.loop_level };
    p.fs.loop_exit = Some(p.fs.code.label());
    p.fs.loop_level = p.fs.regs.nactive;
    s
}

/// Point the loop's breaks here and restore the enclosing loop.
fn Parser.loop_exit(p: *Parser, s: LoopSave) {
    if let Some(l) = p.fs.loop_exit { p.fs.code.bind(l); }
    p.fs.loop_exit = s.exit;
    p.fs.loop_level = s.level;
}

/// If `e` is a local and an earlier assignment target indexes through
/// that local's register, make those targets use a copy (the old value).
fn Parser.check_conflict(p: *Parser, targets: *mem.Vec<E>, e: E) {
    let Local(r) = e else { return; };
    var conflict = false;
    for i in 0..targets.len {
        match targets.at(i) {
            Field(t, _) => if t == r { conflict = true; },
            IndexI(t, _) => if t == r { conflict = true; },
            Index(t, k) => if t == r or k == r { conflict = true; },
            _ => {}
        }
    }
    if !conflict { return; }
    let copy = p.reserve(1);
    p.emit(Mini.MOVE(copy as u8, r as u8));
    for i in 0..targets.len {
        match targets.at(i) {
            Field(t, k) => if t == r { targets.set(i, E.Field(copy, k)); },
            IndexI(t, k) => if t == r { targets.set(i, E.IndexI(copy, k)); },
            Index(t, k) => {
                let t2 = if t == r { copy } else { t };
                let k2 = if k == r { copy } else { k };
                targets.set(i, E.Index(t2, k2));
            }
            _ => {}
        }
    }
}

fn assignable(e: E) -> bool {
    match e {
        Local(_) | Upval(_) | Global(_) | Field(_, _) | Index(_, _) | IndexI(_, _) => true,
        _ => false,
    }
}

fn Parser.statement(p: *Parser) {
    p.statement_inner();
    p.fs.regs.end_stmt();
}

fn Parser.statement_inner(p: *Parser) {
    let first_tok = p.tok;
    let line = first_tok.line;
    match p.tok.kind {
        Semi => p.advance(),
        Local => {
            p.advance();
            if p.accept(T.Function) {
                let name = p.tok.text;
                p.check(T.Name, "function name");
                let r = p.reserve(1);
                p.add_local(name, r);
                let idx = p.function_body(name, false);
                p.emit(Mini.CLOSURE(r as u8, idx as u16));
                return;
            }
            var names: mem.Vec<str> = mem.Vec.new();
            loop {
                names.push(p.tok.text);
                p.check(T.Name, "local name");
                if !p.accept(T.Comma) { break; }
            }
            let base = p.fs.regs.top;
            let n = names.len as u32;
            if p.fold == FOLD_APPLY and p.accept(T.Assign) {
                // Constants that are never assigned become constant
                // locals; they are still stored in their registers.
                var vals = p.explist_vals(n);
                for i in 0..n {
                    let e = vals.at(i as u64);
                    let id = p.nlocals;
                    p.add_local(names.at(i as u64), base + i);
                    if is_const(e) {
                        p.discharge(e, base + i);
                        if !p.assigned.at(id as u64) {
                            let l = p.fs.locals.ptr_at(p.fs.locals.len - 1);
                            l.konst = true;
                            l.kv = match e {
                                Nil => V.Nil,
                                True => V.Bool(true),
                                False => V.Bool(false),
                                I(k) => V.Int(k),
                                K(k) => p.fs.consts.get(k),
                                _ => V.Nil,
                            };
                        }
                    }
                }
                vals.free();
                names.free();
                return;
            }
            if p.accept(T.Assign) {
                p.explist_to(n);
            } else {
                for i in 0..n {
                    let r = p.reserve(1);
                    p.emit(Mini.LOADNIL(r as u8));
                }
            }
            for i in 0..n { p.add_local(names.at(i as u64), base + i); }
            names.free();
        }
        Function => {
            p.advance();
            var name = p.tok.text;
            p.check(T.Name, "function name");
            var target = p.singlevar(name);
            var is_method = false;
            while p.tok.kind == T.Dot or p.tok.kind == T.Colon {
                is_method = p.tok.kind == T.Colon;
                p.advance();
                name = p.tok.text;
                p.check(T.Name, "field name");
                let t = p.any_reg(target);
                target = p.field_key(t, p.str_const(name));
                if is_method { break; }
            }
            let idx = p.function_body(name, is_method);
            let f = E.Reloc(p.emit(Mini.CLOSURE(0, idx as u16)));
            p.store_var(target, f);
        }
        If => {
            p.advance();
            var sw = true;
            #[cfg(debug)] { sw = false; } // --cfg debug: each test is a line to stop at
            if sw and let Some(plan) = p.switch_plan() {
                p.if_switch(plan);
                return;
            }
            let done = p.fs.code.label();
            var f = p.cond();
            p.check(T.Then, "'then'");
            p.block();
            loop {
                if p.tok.kind == T.Elseif {
                    p.fs.code.jump(Mini.JMP(0), done);
                    p.patch_here(&f);
                    f.free();
                    p.advance();
                    f = p.cond();
                    p.check(T.Then, "'then'");
                    p.block();
                } else if p.tok.kind == T.Else {
                    p.fs.code.jump(Mini.JMP(0), done);
                    p.patch_here(&f);
                    p.advance();
                    p.block();
                    break;
                } else {
                    break;
                }
            }
            p.patch_here(&f);
            f.free();
            p.check(T.End, "'end'");
            p.fs.code.bind(done);
        }
        Do => {
            p.advance();
            p.block();
            p.check(T.End, "'end'");
        }
        While => {
            p.advance();
            let start = p.pc();
            // Where the condition starts, to compile it again after the body.
            let at_cond = p.lx;
            let tok = p.tok;
            let prev = p.prev;
            let nprotos = p.fs.protos.len;
            var f = p.cond();
            // Rotate small conditions that define no functions (below).
            var rotate = p.pc() - start <= MAX_ROTATE and p.fs.protos.len == nprotos;
            #[cfg(debug)] { rotate = false; } // --cfg debug: the jump back is a JMP, which polls for a pause
            p.check(T.Do, "'do'");
            let saved = p.loop_enter();
            p.fs.code.mark_target();
            let body = p.pc();
            p.block();
            p.check(T.End, "'end'");
            if rotate {
                // The condition again, jumping back to the body while it
                // holds: one dispatch per iteration fewer than a JMP back
                // to the test at the top.
                let after = p.lx;
                let atok = p.tok;
                let aprev = p.prev;
                p.lx = at_cond;
                p.tok = tok;
                p.prev = prev;
                var g = p.cond_jump_true(body);
                p.lx = after;
                p.tok = atok;
                p.prev = aprev;
                p.patch_here(&g);
                g.free();
            } else {
                p.patch(p.jump(), start);
            }
            p.patch_here(&f);
            f.free();
            p.loop_exit(saved);
        }
        Repeat => {
            p.advance();
            let saved = p.loop_enter();
            let start = p.pc();
            p.enter_block();
            p.statlist();
            p.check(T.Until, "'until'");
            var f = p.cond();
            let b = p.fs.blocks.at(p.fs.blocks.len - 1);
            if b.upval {
                // Captured body locals are closed on both paths.
                let exit = p.jump();
                p.patch_here(&f);
                p.emit(Mini.CLOSE(b.nactive as u8));
                p.patch(p.jump(), start);
                p.patch(exit, p.pc());
            } else {
                #[cfg(not(debug))] p.fs.code.patch_list(&f, start);
                // --cfg debug: the jump back is a JMP, which polls for a pause.
                #[cfg(debug)] {
                    let exit = p.jump();
                    p.patch_here(&f);
                    p.patch(p.jump(), start);
                    p.patch(exit, p.pc());
                }
            }
            f.free();
            p.leave_block();
            p.loop_exit(saved);
        }
        For => {
            p.advance();
            let name = p.tok.text;
            p.check(T.Name, "loop variable");
            if p.tok.kind == T.Assign {
                p.numeric_for(name, line);
            } else {
                p.generic_for(name, line);
            }
        }
        Break => {
            p.advance();
            let Some(exit) = p.fs.loop_exit else { p.fail_prev("break outside a loop") };
            p.emit(Mini.CLOSE(p.fs.loop_level as u8));
            p.fs.code.jump(Mini.JMP(0), exit);
        }
        Return => {
            p.advance();
            if block_end(p.tok.kind) or p.tok.kind == T.Semi {
                p.emit(Mini.RET0());
            } else {
                let e = p.expr();
                if p.tok.kind == T.Comma {
                    let base = p.to_next_reg(e);
                    var n: u32 = 1;
                    while p.accept(T.Comma) {
                        let x = p.expr();
                        p.to_next_reg(x);
                        n += 1;
                    }
                    p.emit(Mini.RETN(base as u8, n as u8));
                } else {
                    let r = p.any_reg(e);
                    p.emit(Mini.RET1(reg_of(r) as u8));
                }
            }
            p.accept(T.Semi);
        }
        _ => {
            let first = p.suffixed();
            if p.tok.kind != T.Assign and p.tok.kind != T.Comma {
                match first {
                    Call(_, _) => {}
                    _ => p.fail_from(first_tok, "expected a statement"),
                }
                return;
            }
            if !assignable(first) { p.fail_from(first_tok, "cannot assign to this expression"); }
            if p.accept(T.Assign) {
                // One target.
                let rhs = p.expr();
                if p.tok.kind != T.Comma {
                    p.store_var(first, rhs);
                    return;
                }
                let r = p.to_next_reg(rhs);
                while p.accept(T.Comma) {
                    let x = p.expr();
                    p.to_next_reg(x);
                }
                p.store_var(first, E.Temp(r));
                return;
            }
            var targets: mem.Vec<E> = mem.Vec.new();
            targets.push(first);
            while p.accept(T.Comma) {
                let t_first = p.tok;
                let t = p.suffixed();
                if !assignable(t) { p.fail_from(t_first, "cannot assign to this expression"); }
                p.check_conflict(&targets, t);
                targets.push(t);
            }
            p.check(T.Assign, "'='");
            let n = targets.len as u32;
            var vals = p.explist_vals(n);
            var i = n;
            while i > 0 {
                i -= 1;
                p.store_var(targets.at(i as u64), vals.at(i as u64));
            }
            vals.free();
            targets.free();
        }
    }
}

/// An `if` whose conditions are all `x == K`, for one local `x` and
/// integer constants K (numerals or constant locals): register `reg`,
/// each arm's K in `keys`, the range `lo .. lo + n` they span.
struct SwitchPlan { reg: u32, lo: i64, n: u64, keys: mem.Vec<i64> }

/// Fewest arms for a jump table, and the largest table.
const SWITCH_MIN: u64 = 4;
const SWITCH_MAX: u64 = 64;

/// The integer value of key token `t` (a numeral or a constant local).
fn Parser.switch_key(p: *Parser, t: Token) -> ?i64 {
    let v = match t.kind {
        Number => t.num,
        Name => match p.fs.resolve(p, t.text) {
            Const(v) => v,
            _ => return None,
        },
        _ => return None,
    };
    if let Int(i) = v { return Some(i as i64); }
    None
}

/// Look ahead (the parser is after `if`) for an if/elseif chain that
/// `if_switch` can compile: at least SWITCH_MIN arms, keys in a range of
/// at most SWITCH_MAX from 0 to 255.
fn Parser.switch_plan(p: *Parser) -> ?SwitchPlan {
    let t0 = p.tok;
    if t0.kind != T.Name { return None; }
    var lx = p.lx;
    var keys: mem.Vec<i64> = mem.Vec.new();
    var t = t0;
    var ok = false;
    loop {
        // `x == K then`
        if t.kind != T.Name or !t.text.eq(t0.text) { break; }
        let Ok(e) = lx.next() else { break; };
        if e.kind != T.Eq { break; }
        let Ok(kt) = lx.next() else { break; };
        let Some(key) = p.switch_key(kt) else { break; };
        let Ok(th) = lx.next() else { break; };
        if th.kind != T.Then { break; }
        keys.push(key);
        // The arm's block, to the next elseif, else or end at this level.
        var depth: u64 = 0;
        var arm_end = T.Eof;
        loop {
            let Ok(b) = lx.next() else { break; };
            match b.kind {
                If | Function | Do | Repeat => depth += 1,
                End | Until => {
                    if depth == 0 { arm_end = b.kind; break; }
                    depth -= 1;
                }
                Elseif | Else => if depth == 0 { arm_end = b.kind; break; },
                Eof => break,
                _ => {}
            }
        }
        if arm_end == T.Elseif {
            let Ok(nt) = lx.next() else { break; };
            t = nt;
            continue;
        }
        ok = arm_end == T.Else or arm_end == T.End;
        break;
    }
    if !ok or keys.len < SWITCH_MIN {
        keys.free();
        return None;
    }
    var lo = keys.at(0);
    var hi = lo;
    for i in 0..keys.len {
        let k = keys.at(i);
        if k < lo { lo = k; }
        if k > hi { hi = k; }
    }
    let Loc(r) = p.fs.resolve(p, t0.text) else { keys.free(); return None; };
    if lo < 0 or lo > 255 or (hi - lo + 1) as u64 > SWITCH_MAX {
        keys.free();
        return None;
    }
    Some(SwitchPlan { reg: r, lo: lo, n: (hi - lo + 1) as u64, keys: keys })
}

/// The if statement that `switch_plan` found: SWITCH and its table of
/// JMPs to the arms (the first arm with a key wins, as the tests would),
/// the arms' blocks as usual, the default to the else block or the end.
fn Parser.if_switch(p: *Parser, plan: SwitchPlan) {
    let done = p.fs.code.label();
    p.emit(Mini.SWITCH(plan.reg as u8, plan.lo as u8, plan.n as u8));
    let table = p.pc();
    for i in 0..plan.n + 1 { p.emit(Mini.JMP(0)); }
    var filled: mem.Vec<bool> = mem.Vec.new();
    for i in 0..plan.n + 1 { filled.push(false); }
    var arm: u64 = 0;
    loop {
        // `x == K then`, checked by switch_plan.
        p.advance();
        p.advance();
        p.advance();
        p.check(T.Then, "'then'");
        p.fs.code.mark_target();
        let slot = (plan.keys.at(arm) - plan.lo) as u64;
        if !filled.at(slot) {
            p.patch(table + slot, p.pc());
            filled.set(slot, true);
        }
        arm += 1;
        p.block();
        if p.tok.kind == T.Elseif {
            p.fs.code.jump(Mini.JMP(0), done);
            p.advance();
            continue;
        }
        if p.tok.kind == T.Else {
            p.fs.code.jump(Mini.JMP(0), done);
            p.advance();
            p.fs.code.mark_target();
            let here = p.pc();
            for i in 0..plan.n + 1 {
                if !filled.at(i) { p.patch(table + i, here); }
            }
            p.block();
        } else {
            for i in 0..plan.n + 1 {
                if !filled.at(i) { p.fs.code.fixup(table + i, done); }
            }
        }
        break;
    }
    filled.free();
    var keys = plan.keys;
    keys.free();
    p.check(T.End, "'end'");
    p.fs.code.bind(done);
}

fn Parser.numeric_for(p: *Parser, name: str, line: u32) {
    p.check(T.Assign, "'='");
    let saved = p.loop_enter();
    p.enter_block();
    let base = p.fs.regs.top;
    let a = p.expr();
    p.to_next_reg(a);
    p.check(T.Comma, "','");
    let b = p.expr();
    p.to_next_reg(b);
    if p.accept(T.Comma) {
        let s = p.expr();
        p.to_next_reg(s);
    } else {
        let r = p.reserve(1);
        p.emit(Mini.LOADI(r as u8, 1));
    }
    p.check(T.Do, "'do'");
    p.add_local("(for index)", base);
    p.add_local("(for limit)", base + 1);
    p.add_local("(for step)", base + 2);
    let prep = p.emit_line(Mini.FORPREP(base as u8, 0), line);
    p.enter_block();
    p.reserve(1);
    p.add_local(name, base + 3);
    p.statlist();
    p.leave_block();
    p.check(T.End, "'end'");
    let lp = p.emit(Mini.FORLOOP(base as u8, 0));
    p.patch(lp, prep + 1);
    p.patch(prep, p.pc());
    p.leave_block();
    p.loop_exit(saved);
}

/// `for k, v in pairs(e)` and `for i, v in ipairs(e)`: R[base] table,
/// R[base+1] traversal state, R[base+2], R[base+3] the variables.
fn Parser.generic_for(p: *Parser, name: str, line: u32) {
    var name2 = "(for value)";
    if p.accept(T.Comma) {
        name2 = p.tok.text;
        p.check(T.Name, "loop variable");
    }
    p.check(T.In, "'=' or 'in'");
    let it = p.tok.text;
    p.check(T.Name, "pairs or ipairs");
    let is_pairs = it.eq("pairs");
    if !is_pairs and !it.eq("ipairs") { p.fail_prev("generic for supports only pairs(...) and ipairs(...)"); }
    p.check(T.LParen, "'('");
    let saved = p.loop_enter();
    p.enter_block();
    let base = p.fs.regs.top;
    let e = p.expr();
    p.to_next_reg(e);
    p.check(T.RParen, "')'");
    p.check(T.Do, "'do'");
    let r = p.reserve(1);
    p.emit(Mini.LOADI(r as u8, 0));
    p.add_local("(for table)", base);
    p.add_local("(for state)", base + 1);
    let j = p.jump();
    let body = p.pc();
    p.enter_block();
    p.reserve(2);
    p.add_local(name, base + 2);
    p.add_local(name2, base + 3);
    p.statlist();
    p.leave_block();
    p.check(T.End, "'end'");
    p.patch(j, p.pc());
    let at = p.emit_line(if is_pairs { Mini.NEXT(base as u8, 0) } else { Mini.INEXT(base as u8, 0) }, line);
    p.patch(at, body);
    p.leave_block();
    p.loop_exit(saved);
}

fn FuncState.new(name: str, parent: ?*FuncState) -> FuncState {
    FuncState {
        parent: parent,
        code: bc.Code.new(Mini.op_size, Mini.set_label),
        consts: bc.Pool.new(65535),
        regs: bc.Regs.new(250),
        locals: mem.Vec.new(),
        nparams: 0,
        name: name,
        loop_exit: None,
        loop_level: 0,
        upvals: mem.Vec.new(),
        protos: mem.Vec.new(),
        blocks: mem.Vec.new(),
    }
}

fn is_jmp(w: u32) -> bool { Mini.opcode(w) == Mini.OP_JMP }

fn Parser.finish(p: *Parser, fs: *FuncState) -> Gc<Proto> {
    p.emit(Mini.RET0());
    if let Some(e) = fs.code.check() {
        let msg = match e.kind { JumpRange => "control structure too long", _ => e.message() };
        p.fail_at(p.sm.line_span(p.file, e.loc), msg);
    }
    // A jump to a JMP goes to its target instead (the end of an `if`
    // branch at the end of a loop body, for one). Not under `--cfg debug`,
    // whose stepping sees the lines of the jumps.
    #[cfg(not(debug))]
    fs.code.thread_jumps(Mini.label, is_jmp);
    let h = p.heap;
    let consts = value.new_arr(h, fs.consts.len());
    for i in 0..fs.consts.len() { consts.data[i] = fs.consts.get(i as u32); }
    let lines = new(h, Lines {}, fs.code.len());
    fs.code.locs_into(lines.data);
    // unsafe: zero-filled (null `Gc`s), every element set on the next line.
    let protos = unsafe { new(h, Protos {}, fs.protos.len) };
    for i in 0..fs.protos.len { protos.data[i] = fs.protos.at(i); }
    let updesc = new(h, UpDescs {}, fs.upvals.len);
    for i in 0..fs.upvals.len {
        let u = fs.upvals.at(i);
        updesc.data[i] = if u.instack { 256 | u.idx } else { u.idx };
    }
    // The Proto is created with its code, verified against the counts
    // it holds: CALL jumps only to a Proto's verified `code`.
    let init = Proto {
        name: value.new_str(h, fs.name),
        nparams: fs.nparams,
        nregs: fs.regs.frame_size(1),
        nupvals: fs.upvals.len as u32,
        consts: consts,
        lines: lines,
        protos: protos,
        updesc: updesc,
    };
    let proto = match Mini.build_verified(h, init, fs.code.words()) {
        Ok(p) => p,
        Err(e) => {
            var b = text.StrBuf.new();
            b.push_str("generated code fails verification: ");
            e.write(&b);
            internal_error(b.as_str())
        }
    };
    Mini.accumulate(proto.code.words(), 0); Mini.optimize(proto.code); #[cfg(debug)] debugger.finish_proto(fs as *u8, proto);
    fs.code.free();
    fs.consts.free();
    fs.locals.free();
    fs.upvals.free();
    fs.protos.free();
    fs.blocks.free();
    proto
}

/// Compile a function body (after `function name`) into a child
/// prototype of the current function; returns its index.
fn Parser.function_body(p: *Parser, name: str, is_method: bool) -> u32 {
    let parent = p.fs;
    var fs = FuncState.new(name, Some(parent));
    p.fs = &fs;
    p.enter_block();
    if is_method {
        let r = p.reserve(1);
        p.add_local("self", r);
        fs.nparams += 1;
    }
    p.check(T.LParen, "'('");
    if p.tok.kind != T.RParen {
        loop {
            let pname = p.tok.text;
            p.check(T.Name, "parameter name");
            let r = p.reserve(1);
            p.add_local(pname, r);
            fs.nparams += 1;
            if !p.accept(T.Comma) { break; }
        }
    }
    p.check(T.RParen, "')'");
    p.statlist();
    p.check(T.End, "'end'");
    let proto = p.finish(&fs);
    p.fs = parent;
    parent.protos.push(proto);
    if parent.protos.len > 65535 { p.fail_prev("too many functions"); }
    (parent.protos.len - 1) as u32
}

/// Compile the chunk `src` (read from file `name`). Allocates in `h` but
/// never collects. Syntax errors are reported on stderr and exit.
///
/// Locals declared with a constant (`local N, K = 10, "x"`) that nothing
/// assigns read as that constant in the functions nested in their scope
/// (no upvalue: `op == ADD` compiles as a compare with a constant). A
/// first pass finds the assigned locals (the code it compiles is
/// dropped). Not under `--cfg debug`, whose debugger shows upvalues and
/// may assign variables.
pub fn compile(h: *gc.Heap, name: str, src: str) -> Gc<Proto> {
    var assigned: mem.Vec<bool> = mem.Vec.new();
    var fold = FOLD_SCAN;
    #[cfg(debug)] fold = FOLD_NONE;
    if fold == FOLD_SCAN { compile_pass(h, name, src, FOLD_SCAN, &assigned); fold = FOLD_APPLY; }
    let proto = compile_pass(h, name, src, fold, &assigned);
    assigned.free();
    proto
}

fn compile_pass(h: *gc.Heap, name: str, src: str, fold: u32, assigned: *mem.Vec<bool>) -> Gc<Proto> {
    var sm = diag.SourceMap.new();
    let file = sm.add(name, src);
    var tables = LexTables.new();
    var fs = FuncState.new("main chunk", None);
    let none = Token { kind: T.Eof, text: "", line: 1, num: V.Nil, lo: 0, hi: 0 };
    var p = Parser {
        lx: Lexer { cur: lex.Cursor.new(src, file, lex.lua()), t: &tables },
        tok: none,
        prev: none,
        heap: h,
        fs: &fs,
        exprs: operators(),
        sm: &sm,
        file: file,
        fold: fold,
        nlocals: 0,
        assigned: assigned,
    };
    p.advance();
    p.enter_block();
    p.statlist();
    if p.tok.kind != T.Eof { p.fail("'<eof>' expected"); }
    let proto = p.finish(&fs);
    p.exprs.free();
    tables.free();
    sm.free();
    proto
}

struct Job { h: *gc.Heap, name: str, src: str, proto: ?Gc<Proto> }

fn compile_job(data: *u8) {
    let j = data as *Job;
    j.proto = Some(compile(j.h, j.name, j.src));
}

/// `compile`, for an embedder: a syntax error returns None and appends
/// its message ("line N: msg") to `err` instead of exiting. The parser's
/// own memory is leaked on that path (see std.rt).
pub fn try_compile(h: *gc.Heap, name: str, src: str, err: *text.StrBuf) -> ?Gc<Proto> {
    let saved = error_out;
    error_out = Some(err);
    var job = Job { h: h, name: name, src: src, proto: None };
    let ok = rt.protect(compile_job, &job as *u8);
    error_out = saved;
    if ok { job.proto } else { None }
}

/// `--cfg debug`: the names of the upvalues of the function being
/// compiled with FuncState `fs`, in order (debugger.lm).
#[cfg(debug)]
pub fn debug_upvals(fs: *u8, out: *mem.Vec<str>) {
    let f = fs as *FuncState;
    for i in 0..f.upvals.len { out.push(f.upvals.at(i).name); }
}
