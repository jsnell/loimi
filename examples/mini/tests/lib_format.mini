print(string.format("%d", 42), string.format("%d", -7), string.format("%d", 3.0))
print(string.format("[%5d]", 42), string.format("[%-5d]", 42), string.format("[%05d]", 42))
print(string.format("[%.3d]", 7), string.format("[%8.3d]", 7), string.format("[%+d]", 5))
print(string.format("%x", 255), string.format("%x", 0), string.format("[%4x]", 10), string.format("[%-4x]", 10))
print(string.format("%x", 4096.0), string.format("%x", -1), string.format("%X", 48879))
print(string.format("%s", "str"), string.format("%s", 12), string.format("%s", 1.5))
print(string.format("%s %s %s", nil, true, false))
print(string.format("[%10s]", "hi"), string.format("[%-10s]", "hi"), string.format("[%.2s]", "hello"))
print(string.format("[%5.1s]", "abc"), string.format("[%-5.3s]", "abcdef"), string.format("[%s]", ""))
print(string.format("%f", 1.5), string.format("%.2f", 3.14159), string.format("%.0f", 2.5))
print(string.format("[%10.3f]", -1.5), string.format("[%-10.1f]", 2.25), string.format("%f", 3))
print(string.format("%5.2f%%", 99.5), string.format("%.3f", 1 / 3), string.format("%f", 1e20))
print(string.format("%g", 1.5), string.format("%g", 1e20), string.format("%g", 0.0001), string.format("%g", 100))
print(string.format("%.3g", 3.14159), string.format("[%10g]", 2.5), string.format("[%-8g]", 1e-10))
print(string.format("%g", 1 / 0), string.format("%f", -1 / 0), string.format("%.1f", 0.05))
print(string.format("%c", 65), string.format("%c%c%c", 76, 117, 97), string.format("[%3c]", 120), string.format("[%-3c]", 120))
print(string.format("100%%"), string.format("%%d"), string.format("a%%b%%c"))
print(string.format("no directives"), string.format(""))
print(string.format("%d items at %.2f each: %s", 3, 9.5, "ok"))
print(string.format("%s|%s", 1e15, 9007199254740992.0), string.format("%s", -0.0))
print(string.format("%5s|%-5s|", 1, 2))
print(string.len(string.format("%c", 0)))
local t = {}
print(string.sub(string.format("%s", t), 1, 7))
