-- tostring and print of floats, integers and other values
print(1.0, -1.0, 0.0, -0.0, 3.5, -2.25)
print(0.1, 0.1 + 0.2, 1 / 3, -1 / 3, 2 / 3)
print(100.0, 1e14, 1e15, 1e16, 9007199254740992.0, 9223372036854775808.0)
print(123456789012345.0, 12345678901234.5, 0.1 + 0.7)
print(1e-5, 1.5e-10, 1e100, -1e100, 5e-324)
print(1 / 0, -1 / 0, math.huge, -math.huge)
print(math.pi, -math.pi)
print(2147483648.0, 2147483648.0 - 1, 7 / 7)
print(42, -42, 0, 2147483647, -2147483647)
print(nil, true, false, "str")
print(tostring(1.5), tostring(10), tostring(nil), tostring(true))
print(tostring(1e15) .. "|" .. tostring(-0.0) .. "|" .. tostring(16777216.0))
print("x" .. 1.0, "x" .. 10, "x" .. 1e100, 2.0 .. "")
print(string.sub(tostring(print), 1, 10), string.sub(tostring(math), 1, 7))
function f() end
print(string.sub(tostring(f), 1, 10), type(tostring({})))
local t = {}
print(tostring(t) == tostring(t), tostring(t) == tostring({}))
print()
print("")
print(1, nil, 2)
