-- Arithmetic sites that change operand types after quickening, and
-- constant left operands (RSUBK, RDIVK).
local function add(a, b) return a + b end
local function mulk(a) return a * 0.5 end
local function ksub(a) return 10 - a end
local function kdiv(a) return 1 / a end
print(add(1, 2.5), add(2.5, 1), add(1, 2), add(1.5, 2.5), add(1, 2.5))
print(mulk(3), mulk(3.0), mulk(4), mulk(1))
print(ksub(3), ksub(2.5), ksub(-2147483647), ksub(3))
print(kdiv(4), kdiv(0.5), kdiv(0), kdiv(-4))
local s = "x"
for i = 1, 3 do s = s .. add(i, 0.5) end
print(s)
-- expect: 3.5	3.5	3	4.0	3.5
-- expect: 1.5	1.5	2.0	0.5
-- expect: 7	7.5	2147483657	7
-- expect: 0.25	2.0	inf	-0.25
-- expect: x1.52.53.5
