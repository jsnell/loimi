-- math.floor and math.sqrt run inline in CALL for one result: the edges.
local floor, sqrt = math.floor, math.sqrt
print(floor(-0.5), floor(0.5), floor(-0.0), floor(3), floor(-7), floor(2.0))
print(floor(2147483647.5), floor(-2147483648.0), floor(-2147483647.5))
print(floor(-2147483648.5), floor(2147483648.0), floor(1e300))
print(floor(1/0), floor(-1/0), floor(0/0) ~= floor(0/0))
print(sqrt(16), sqrt(2.25), sqrt(-1) ~= sqrt(-1), sqrt(1/0))
local a, b = floor(7.5), sqrt(4.0)
print(a, b, (floor(-3.25)))
-- expect: -1	0	0	3	-7	2
-- expect: 2147483647	-2147483648	-2147483648
-- expect: -2147483649	2147483648	1e+300
-- expect: inf	-inf	true
-- expect: 4.0	1.5	true	inf
-- expect: 7	2.0	-4
