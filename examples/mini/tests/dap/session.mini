local function fib(n)
  if n < 2 then return n end
  return fib(n - 1) + fib(n - 2)
end

local config = {name = "demo", sizes = {3, 5, 8}, nested = {deep = {x = 1}}}
local total = 0
for i = 1, 8 do
  total = total + fib(i)
end
print("total", total)
local function check(v)
  return v.missing.field
end
n = 0
while not done do n = n + 1 end
print("spun")
check(config)
