-- counters: each closure has its own captured variable
local function counter()
  local n = 0
  return function() n = n + 1 return n end
end
local c1, c2 = counter(), counter()
print(c1(), c1(), c1(), c2())
-- shared upvalues: closures created in the same scope share a variable
local function pair()
  local v = 0
  local function get() return v end
  local function set(x) v = x end
  return get, set
end
local get, set = pair()
set(42)
print(get())
-- a closure sees later assignments to the enclosing local
local x = 1
local function getx() return x end
x = 2
print(getx())
-- per-iteration capture: numeric for, while, repeat, pairs, ipairs
local fs = {}
for i = 1, 3 do fs[i] = function() return i end end
print(fs[1](), fs[2](), fs[3]())
local ws = {}
local j = 0
while j < 3 do
  j = j + 1
  local k = j * 10
  ws[j] = function() return k end
end
print(ws[1](), ws[2](), ws[3]())
local rs = {}
local m = 0
repeat
  m = m + 1
  local q = m
  rs[m] = function() return q end
until q >= 3
print(rs[1](), rs[2](), rs[3]())
local ps = {}
for idx, v in ipairs({"a", "b", "c"}) do ps[idx] = function() return v .. idx end end
print(ps[1](), ps[2](), ps[3]())
-- break closes the loop's upvalues
local bs = {}
for i = 1, 10 do
  local y = i * 2
  bs[#bs + 1] = function() return y end
  if i == 2 then break end
end
print(bs[1](), bs[2]())
-- nested functions: upvalues of upvalues
local function outer()
  local a = 1
  return function()
    local b = 10
    return function() a = a + 1; b = b + 1; return a + b end
  end
end
local mk = outer()
local f1, f2 = mk(), mk()
print(f1(), f1(), f2())
-- recursive local function
local function fact(n) if n <= 1 then return 1 end return n * fact(n - 1) end
print(fact(10))
-- anonymous functions as values
local apply = function(f, v) return f(v) end
print(apply(function(z) return z * z end, 7))
-- closure over a parameter, captured after return
local function adder(n) return function(v) return v + n end end
local add5 = adder(5)
print(add5(1), adder(10)(1))
-- expect: 1	2	3	1
