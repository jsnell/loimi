local t = {}
table.insert(t, "a")
table.insert(t, "b")
table.insert(t, "c")
print(t[1], t[2], t[3], t[4])
print(table.concat(t), table.concat(t, ", "), table.concat(t, ""))
print(table.remove(t), t[3], table.concat(t, "-"))
print(table.remove(t), table.remove(t), table.remove(t), table.remove(t))
print("[" .. table.concat(t) .. "]", "[" .. table.concat(t, "x") .. "]")
local n = {}
for i = 1, 10 do table.insert(n, i * i) end
print(table.concat(n, " "))
print(table.remove(n), table.remove(n))
print(table.concat(n, ","))
local m = {}
table.insert(m, 1)
table.insert(m, 2.5)
table.insert(m, "three")
table.insert(m, 1e15)
print(table.concat(m, " "), table.concat(m, 0))
-- built by assignment
local q = {}
q[1] = "x"
q[2] = "y"
print(table.concat(q, "+"))
table.insert(q, "z")
print(q[3], table.concat(q, "+"))
-- remove, then insert reuses the slot
table.remove(q)
table.insert(q, "w")
print(table.concat(q, "+"))
-- a big one
local big = {}
for i = 1, 1000 do table.insert(big, i) end
local s = 0
for i = 1, 1000 do s = s + big[i] end
print(s, string.len(table.concat(big, ",")))
for i = 1, 500 do table.remove(big) end
print(big[500], big[501])
-- expect: a	b	c	nil
-- expect: abc	a, b, c	abc
-- expect: c	nil	a-b
-- expect: b	a	nil	nil
-- expect: []	[]
-- expect: 1 4 9 16 25 36 49 64 81 100
-- expect: 100	81
-- expect: 1,4,9,16,25,36,49,64
-- expect: 1 2.5 three 1e+15	102.50three01e+15
-- expect: x+y
-- expect: z	x+y+z
-- expect: x+y+w
-- expect: 500500	3892
-- expect: 500	nil
