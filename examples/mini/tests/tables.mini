local t = {}
t.x = 10
t["y"] = 20
t[1] = "one"
t[2.0] = "two"
print(t.x + t.y, t[1], t[2], t.missing)
local keys = {}
for i = 1, 100 do keys[i] = i * i end
local sum = 0
for i = 1, 100 do sum = sum + keys[i] end
print(sum)
-- tables of tables, strings as keys built at runtime
local reg = {}
for i = 1, 50 do
  local name = "k" .. i
  reg[name] = {}
  reg[name].v = i
end
print(reg["k7"].v, reg.k50.v)
-- expect: 30	one	two	nil
-- expect: 338350
-- expect: 7	50
