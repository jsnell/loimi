-- if/elseif chains comparing one local with integer constants compile
-- to a jump table (compile.lm, `if_switch`); they must behave as the
-- tests in order would.
local A, B, C, D = 1, 2, 3, 4
local function name(op)
  if op == A then return "a"
  elseif op == B then return "b"
  elseif op == C then return "c"
  elseif op == 3 then return "c again" -- a repeated key: the first arm wins
  elseif op == D then return "d"
  elseif op == 9 then return "nine"
  else return "other" end
end
local got = {}
for _, v in ipairs({ 0, 1, 2, 3, 4, 5, 8, 9, 10, -1, 1.0, 2.5, 4.0, "1", true }) do
  got[#got + 1] = name(v)
end
print(table.concat(got, " "))
print(name(nil), name({}), name(1e300), name(0/0), name(-0.0))
-- no else: falls out of the if; nested blocks inside the arms
local function count(xs)
  local n1, n2, n3, n4, other = 0, 0, 0, 0, 0
  for i = 1, #xs do
    local x = xs[i]
    if x == 1 then
      n1 = n1 + 1
    elseif x == 2 then
      if n2 > 1 then n2 = n2 + 10 else n2 = n2 + 1 end
    elseif x == 3 then
      local j = 0
      while j < 2 do j = j + 1 end
      repeat j = j - 1 until j == 0
      n3 = n3 + 1 + j
    elseif x == 4 then
      n4 = n4 + (function() return 1 end)()
    end
    if x > 4 then other = other + 1 end
  end
  return n1, n2, n3, n4, other
end
local c1, c2, c3, c4, c5 = count({ 1, 2, 3, 4, 2, 2, 7, 1, 4, 4 })
print(c1, c2, c3, c4, c5)
-- the keys at the ends of the range (0 and 63 apart), empty arms
local function edge(x)
  local r = "none"
  if x == 0 then r = "zero"
  elseif x == 63 then r = "last"
  elseif x == 10 then
  elseif x == 20 then r = "twenty"
  end
  return r
end
print(edge(0), edge(63), edge(10), edge(20), edge(64), edge(30))
-- too wide a range, or a key that is not a constant: plain tests
local k = 5
local function wide(x)
  if x == 1 then return 1 elseif x == 2 then return 2
  elseif x == 3 then return 3 elseif x == 100 then return 100 end
  return 0
end
local function nonconst(x)
  if x == 1 then return 1 elseif x == 2 then return 2
  elseif x == 3 then return 3 elseif x == k then return k end
  return 0
end
k = 6
print(wide(100), wide(4), nonconst(6), nonconst(5))
