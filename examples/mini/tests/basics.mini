-- arithmetic and numbers
print(1 + 2, 7 - 10, 6 * 7, 7 / 2, 7 % 3, -7 % 3)
print(2147483647 + 1, 1.5 * 2, 0.1 + 0.2)
-- comparisons and logic
print(1 < 2, 2 <= 2, 3 > 4, 4 >= 5, 1 == 1, 1 ~= 1, "a" < "b")
print(nil and 1, false or "x", 1 and 2, nil or false, not nil, not 0)
-- strings
local s = "hello" .. ", " .. "world"
print(s, "n=" .. 42, "f=" .. 1.5)
-- control flow
local total = 0
for i = 1, 10 do total = total + i end
print(total)
for i = 10, 1, -3 do print(i) end
local n = 0
while n < 5 do n = n + 1 end
print(n)
local i = 0
while true do
  i = i + 1
  if i == 3 then break end
end
print(i)
if n == 1 then print("one") elseif n == 5 then print("five") else print("other") end
-- expect: 3	-3	42	3.5	1	2
-- expect: 2147483648.0	3.0	0.30000000000000004
-- expect: true	true	false	false	true	false	true
-- expect: nil	x	2	false	true	false
-- expect: hello, world	n=42	f=1.5
-- expect: 55
-- expect: 10
-- expect: 7
-- expect: 4
-- expect: 1
-- expect: 5
-- expect: 3
-- expect: five
