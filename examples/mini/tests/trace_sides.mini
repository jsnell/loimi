-- Side traces (docs/design/trace-tier.md section 13): exits of a trace
-- that ran often in the profile get the hot path from them, rejoining
-- the trace, in the same function; loops inside a loop are on its path.
-- This checks a dispatch loop whose arms are side traces, side traces
-- whose own guards fail (in the forced builds of mini_traces), a side
-- trace dropped while its root goes on, and nested loops.

-- a dispatch loop (an `if` chain on small ints: a jump table): the root
-- runs the hottest arm, side traces the others
local code = {}
for i = 1, 60 do code[i] = (i * 7) % 5 + 1 end
local acc, n = 0, 0
for r = 1, 300 do
  for pc = 1, #code do
    local op = code[pc]
    if op == 1 then acc = acc + pc
    elseif op == 2 then acc = acc - 1
    elseif op == 3 then acc = (acc * 3) % 100003
    elseif op == 4 then n = n + 1
    else acc = acc + n end
  end
end
print(acc, n)

-- a side trace with a branch inside it, taken a third of the time: in
-- the forced builds (blocks run in under half of their step's runs are
-- guards) that is a guard of the side trace that fails, often enough to
-- drop the side trace; the root goes on
local s, t = 0, 0
for i = 1, 30000 do
  if i % 2 == 0 then
    s = s + i
  else
    if i % 3 == 0 then t = t + 2.5 else t = t + 1 end
    s = s - 1
  end
end
print(s, t)

-- arithmetic that changes type in a side trace: ints, then floats
local x = 0
for i = 1, 20000 do
  if i % 4 == 0 then
    x = x + (i > 15000 and 0.5 or 1)
  else
    x = x + 1
  end
end
print(x)

-- nested loops: the outer loop's trace runs the inner loop in it (a
-- short inner loop, entered on every outer iteration)
local m = 0
for i = 1, 5000 do
  for j = 1, i % 3 + 1 do
    m = (m + i * j) % 1000003
  end
end
print(m)

-- a loop whose exits all run often: no single path closes most of the
-- iterations
local hist = { 0, 0, 0, 0, 0, 0 }
local v = 7
for i = 1, 30000 do
  v = (v * 1103515245 + 12345) % 2147483648
  local k = v % 6 + 1
  if k <= 2 then hist[1] = hist[1] + 1
  elseif k == 3 then hist[2] = hist[2] + k
  elseif k == 4 then hist[3] = hist[3] + 1
  elseif k == 5 then hist[4] = hist[4] + 2
  else hist[5] = hist[5] + 1 end
end
print(hist[1], hist[2], hist[3], hist[4], hist[5])

-- a callee called through a table of functions: a polymorphic call site,
-- each callee a side trace
local fns = {
  function(a) return a + 1 end,
  function(a) return a * 2 % 1009 end,
  function(a) return a - 3 end,
}
local w = 1
for i = 1, 30000 do
  w = fns[i % 3 + 1](w) % 100003
end
print(w)

-- expect: 96336	3600
-- expect: 225000000	22500.0
-- expect: 19375.0
-- expect: 683212
-- expect: 9819	30273.0	53	19994	40
-- expect: 971
