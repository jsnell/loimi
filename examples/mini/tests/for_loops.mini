-- Numeric for loops: integer loops count their iterations (FORPREP/FORLOOP).
for i = 1, 3 do io.write(i, " ") end print()
for i = 3, 1, -1 do io.write(i, " ") end print()
for i = 1, 10, 3 do io.write(i, " ") end print()
for i = 10, 1, -4 do io.write(i, " ") end print()
for i = 1, 0 do io.write(i, " ") end print("empty")
for i = 2147483645, 2147483647 do io.write(i, " ") end print()
for i = -2147483648, -2147483646 do io.write(i, " ") end print()
for i = -2147483647, 2147483647, 2147483647 do io.write(i, " ") end print()
for i = 2147483647, -2147483648, -2147483647 do io.write(i, " ") end print()
for i = 1, 3.5 do io.write(i, " ") end print()
for i = 1, -3.5, -1 do io.write(i, " ") end print()
for i = 1.0, 2 do io.write(i, " ") end print()
for i = 1, 2, 0.5 do io.write(i, " ") end print()
for i = 5, 1e300 do if i > 7 then break end io.write(i, " ") end print()
local n = 0 for i = 1, 1000 do n = n + i end print(n)
for i = 1, 3 do local j = i; i = i * 10; io.write(i, " ") end print()
-- expect: 1 2 3 
-- expect: 3 2 1 
-- expect: 1 4 7 10 
-- expect: 10 6 2 
-- expect: empty
-- expect: 2147483645 2147483646 2147483647 
-- expect: -2147483648 -2147483647 -2147483646 
-- expect: -2147483647 0 2147483647 
-- expect: 2147483647 0 -2147483647 
-- expect: 1 2 3 
-- expect: 1 0 -1 -2 -3 
-- expect: 1 2 
-- expect: 1 1.5 2 
-- expect: 5 6 7 
-- expect: 500500
-- expect: 10 20 30 
