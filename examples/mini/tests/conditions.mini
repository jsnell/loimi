-- Conditions compile to jump chains: and/or/not, constants, elseif,
-- while and repeat. Checksum computed with PUC-Lua 5.4.
local vals = {false, true, 0, "x"}
vals[5] = nil
local out = {}
for i = 1, 5 do for j = 1, 5 do for k = 1, 5 do
  local a, b, c = vals[i], vals[j], vals[k]
  local r = 0
  if a and b or c then r = r + 1 end
  if not a and not b and not c then r = r + 2 end
  if a or b and not c then r = r + 4 end
  if (a or b) and c then r = r + 8 end
  if not (a and b) then r = r + 16 end
  if a == b or a ~= c then r = r + 32 end
  if a and (b or c) or not a and c then r = r + 64 end
  if true and a then r = r + 128 elseif nil or b then r = r + 256 else r = r + 512 end
  local n = 0
  while n < 3 and (a or n < 1) do n = n + 1 end
  repeat n = n + 1 until n > 5 or not b
  r = r + n * 1000
  out[#out + 1] = r
end end end
local s = 0
for i = 1, #out do s = (s * 31 + out[i]) % 1000003 end
print(#out, s)
local x = 5
if 3 < x and x <= 5 and 1 > 0 and 2 >= x - 3 and x == 5 and x ~= 4 then print("ok") end
if 10 < x or 1.5 >= x or x > 6 then print("bad") else print("ok2") end
-- expect: 125	912637
-- expect: ok
-- expect: ok2
