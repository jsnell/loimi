// A source-level debugger for Mini, compiled in with `--cfg debug`:
//
//   loimi build --cfg debug examples/mini/main.lm -o mini-dbg
//   ./mini-dbg --debug script.mini < commands
//
// It stops before the first line and reads gdb-like commands from stdin
// (`break [FILE:]LINE`, `continue`, `step`, `next`, `finish`, `bt`,
// `locals`, `print NAME`, `op`, `info`, `delete ID`, `quit`; `help`
// lists them). The generic parts are the compiler's and std.debug's
// (docs/design/debugging.md):
//
// - breakpoints are generated BREAK ops patched over instructions
//   (`Mini.set_break`), so the program runs at full speed between them;
// - the vm's `on break` handler (vm.lm) stops, puts the instruction back
//   and runs it under the `step` variant, whose wrapper calls `on_step`
//   before each instruction: it sets the breakpoint again (std.debug's
//   step-over) and, while stepping, stops at the next line;
// - `op` prints the current instruction with the generated disassembler.
//
// What is Mini's: lines (each Proto's line table), call depth (the frame
// stack), frames and locals (the compiler records each local's register
// and live range with `open_local`/`close_locals`/`finish_proto`).

import std.debug;
import std.io;
import std.mem;
import std.os;
import std.text;
import value;
import value.{V, Proto};
import vm;
import vm.{Ctx, Frame, Mini};
import compile;
import lib;
import state;

extern "C" fn exit(code: i32) -> never;

// ── locals, recorded by the compiler ────────────────────────────────────

/// A local variable: its register, and the code words where it is live
/// (`start` to `end`, exclusive).
pub struct LocVar { name: str, reg: u32, start: u32, end: u32 }

/// The locals of a function being compiled (`key` is its FuncState), as
/// a stack parallel to the compiler's `locals` (indices into `vars`).
struct Building { key: u64, open: mem.Vec<u64>, vars: mem.Vec<LocVar> }
/// The locals of a compiled function.
struct ProtoInfo { proto: u64, vars: mem.Vec<LocVar> }
struct Registry { building: mem.Vec<Building>, done: mem.Vec<ProtoInfo> }

var registry: ?*Registry = None;

fn reg() -> *Registry {
    if let Some(r) = registry { return r; }
    let r: *Registry = mem.alloc(1);
    *r = Registry { building: mem.Vec.new(), done: mem.Vec.new() };
    registry = Some(r);
    r
}

fn building(key: u64) -> *Building {
    let r = reg();
    for i in 0..r.building.len {
        if r.building.at(i).key == key { return r.building.ptr_at(i); }
    }
    r.building.push(Building { key: key, open: mem.Vec.new(), vars: mem.Vec.new() });
    r.building.ptr_at(r.building.len - 1)
}

/// The compiler made register `reg` the local `name`, live from word `pc`.
pub fn open_local(fs: *u8, name: str, reg: u32, pc: u64) {
    let b = building(fs as u64);
    b.open.push(b.vars.len);
    b.vars.push(LocVar { name: name, reg: reg, start: pc as u32, end: 4294967295 });
}

/// The compiler left a block: locals from number `first` on end at `pc`.
pub fn close_locals(fs: *u8, first: u64, pc: u64) {
    let b = building(fs as u64);
    while b.open.len > first {
        let Some(v) = b.open.pop() else { break; };
        b.vars.ptr_at(v).end = pc as u32;
    }
}

/// The function compiled with FuncState `fs` is `p`.
pub fn finish_proto(fs: *u8, p: Gc<Proto>) {
    let r = reg();
    let b = building(fs as u64);
    let vars = b.vars;
    b.open.free();
    let i = ((b as u64) - (r.building.ptr as u64)) / size_of<Building>();
    for j in i + 1..r.building.len { r.building.set(j - 1, r.building.at(j)); }
    r.building.truncate(r.building.len - 1);
    r.done.push(ProtoInfo { proto: p as u64, vars: vars });
}

fn locvars(p: Gc<Proto>) -> []LocVar {
    let r = reg();
    for i in 0..r.done.len {
        let d = r.done.ptr_at(i);
        if d.proto == p as u64 { return d.vars.items(); }
    }
    (r.done.ptr as *LocVar).slice(0)
}

// ── the debugger ────────────────────────────────────────────────────────

pub struct Dbg {
    bps: debug.Breakpoints<Mini.Break>,
    step: debug.Stepper,
    input: debug.Input,
    file: str,
    src: str,
    main: Gc<Proto>,
    out: text.StrBuf,
}

fn clear_site(b: Mini.Break) -> bool { Mini.clear_break(b) }
fn rearm_site(b: Mini.Break) -> ?Mini.Break { b.rearm() }

/// `mini --debug FILE`: run FILE under the debugger.
pub fn main() -> i32 uses gc {
    let Some(path) = os.arg(2) else {
        io.eprintln("usage: mini --debug <script>");
        return 2;
    };
    let Some(src) = io.read_file(path) else {
        io.eprint("cannot read ");
        io.eprintln(path);
        return 1;
    };
    var ctx = state.new_ctx(vm.no_host);
    let proto = compile.compile(&ctx.heap, path, src);
    let main_closure = value.new_closure(&ctx.heap, proto);
    state.attach(&ctx);
    var d = Dbg {
        bps: debug.Breakpoints.new(clear_site, rearm_site),
        step: debug.Stepper.new(),
        input: debug.Input.stdin(),
        file: path,
        src: src,
        main: proto,
        out: text.StrBuf.new(),
    };
    // Stop before the first instruction: a one-shot breakpoint there.
    let id = d.bps.add(path, 0, true);
    if let Some(t) = Mini.set_break(proto.code, 0) { d.bps.add_site(id, proto.code.start() as u64, t); }
    // Its id is free again before the first command (the hit deletes it):
    // the user's breakpoints count from 1.
    d.bps.next_id = id;
    ctx.dbg = Some(&d);
    let r = Mini.run(&ctx, main_closure);
    lib.flush();
    if let Err(e) = r {
        var b = text.StrBuf.new();
        b.push_str("error: ");
        value.write_value(&b, e);
        io.eprintln(b.as_str());
        io.println("[program failed]");
        return 1;
    }
    io.println("[program finished]");
    0
}

/// From the vm's `on break` handler: the breakpoint at `pc` was hit.
/// Stop, with the instruction put back for the handler to run.
pub fn on_break(c: *Ctx, pc: *u32, fp: *Frame) {
    let Some(d) = c.dbg else { return; };
    let id = d.bps.hit(pc as u64);
    stop(d, c, pc, fp, id);
}

/// From the `step` variant, before each instruction: whether the variant
/// must stay on (a breakpoint waits to be set again, or a stepping
/// command runs).
pub fn on_step(c: *Ctx, pc: *u32, fp: *Frame) -> bool {
    let Some(d) = c.dbg else { return false; };
    let pending = d.bps.tick();
    // A breakpoint here stops in its own handler.
    if d.step.active() and !Mini.is_break(*pc) {
        let (line, depth) = where_at(c, pc, fp);
        if d.step.should_stop(line, depth) { stop(d, c, pc, fp, 0); }
    }
    pending or d.step.active()
}

/// Whether a stepping command or a step-over is in progress: a run that
/// starts or continues after a native (a nested run, or its caller after
/// it) turns the `step` variant on.
pub fn stepping(c: *Ctx) -> bool {
    let Some(d) = c.dbg else { return false; };
    d.step.active() or d.bps.pending.is_some()
}

/// The line and call depth of the instruction at `pc` in frame `fp`.
fn where_at(c: *Ctx, pc: *u32, fp: *Frame) -> (u32, u64) {
    (line_of(fp.cl.proto, pc), ((fp as u64) - (c.frames as u64)) / size_of<Frame>())
}

fn line_of(p: Gc<Proto>, pc: *u32) -> u32 {
    let i = ((pc as u64) - (p.code.start() as u64)) / 4;
    if i < p.lines.data.len { p.lines.data[i] } else { 0 }
}

fn Dbg.flush(d: *Dbg) {
    io.print(d.out.as_str());
    d.out.clear();
}

/// Text of source line `n` (1-based).
fn Dbg.source_line(d: *Dbg, n: u32) -> str {
    var line: u32 = 1;
    var start: u64 = 0;
    for i in 0..d.src.len {
        if line == n {
            var e = i;
            while e < d.src.len and d.src[e] != '\n' { e += 1; }
            return d.src[i..e];
        }
        if d.src[i] == '\n' {
            line += 1;
            start = i + 1;
        }
    }
    let _ = start;
    ""
}

fn Dbg.location(d: *Dbg, p: Gc<Proto>, line: u32) {
    d.out.push_str(debug.basename(d.file));
    d.out.push_str(":");
    d.out.push_int(line as i64);
    d.out.push_str(" in ");
    let n = p.name.data;
    if p == d.main { d.out.push_str("main chunk"); } else { d.out.push_str("function '"); d.out.push_str(n); d.out.push_str("'"); }
}

/// Stop at `pc` (breakpoint `id`, or 0 for a step) and run commands
/// until one continues the program.
fn stop(d: *Dbg, c: *Ctx, pc: *u32, fp: *Frame, id: u32) {
    lib.flush();
    let p = fp.cl.proto;
    let (line, depth) = where_at(c, pc, fp);
    if id != 0 {
        if let Some(b) = d.bps.bp(id) and !b.temp {
            d.out.push_str("breakpoint ");
            d.out.push_int(id as i64);
            d.out.push_str(", ");
        }
    }
    d.location(p, line);
    d.out.push_str("\n");
    d.out.push_int(line as i64);
    d.out.push_str("\t");
    d.out.push_str(d.source_line(line));
    d.out.push_str("\n");
    loop {
        d.out.push_str("(mdb) ");
        d.flush();
        let Some(cmdline) = d.input.read_line() else {
            // End of the commands: detach and let the program finish.
            if !d.input.is_tty() { io.println(""); }
            d.bps.clear_all();
            d.step.start(debug.Mode.Run, 0, 0);
            return;
        };
        if !d.input.is_tty() {
            d.out.push_str(cmdline);
            d.out.push_str("\n");
        }
        match debug.parse_command(cmdline) {
            Break(f, l) => d.set_line_break(f, l, false),
            TBreak(f, l) => d.set_line_break(f, l, true),
            Delete(n) => {
                if !d.bps.delete(n) { d.out.push_str("no breakpoint "); d.out.push_int(n as i64); d.out.push_str("\n"); }
            }
            Info => d.info(),
            Continue => { d.step.start(debug.Mode.Run, line, depth); d.flush(); return; }
            Step => { d.step.start(debug.Mode.Step, line, depth); d.flush(); return; }
            Next => { d.step.start(debug.Mode.Next, line, depth); d.flush(); return; }
            Finish => { d.step.start(debug.Mode.Finish, line, depth); d.flush(); return; }
            Backtrace => d.backtrace(c, pc, fp),
            Locals => d.locals(fp, pc, ""),
            Print(name) => d.locals(fp, pc, name),
            Op => {
                let words = p.code.words();
                Mini.disasm_insn(words, ((pc as u64) - (words.ptr as u64)) / 4, &d.out);
            }
            Quit => { d.flush(); lib.flush(); exit(0) }
            Help => d.out.push_str(debug.HELP),
            Empty => {}
            Bad(msg) => { d.out.push_str(msg); d.out.push_str("\n"); }
        }
    }
}

/// `break [FILE:]LINE`: a site at each instruction that starts a run of
/// LINE's code, in every function.
fn Dbg.set_line_break(d: *Dbg, file: str, line: u32, temp: bool) {
    if file.len > 0 and !debug.basename(file).eq(debug.basename(d.file)) {
        d.out.push_str("no source file named ");
        d.out.push_str(file);
        d.out.push_str("\n");
        return;
    }
    let id = d.bps.add(d.file, line, temp);
    d.sites_in(d.main, id, line);
    let Some(b) = d.bps.bp(id) else { return; };
    if b.nsites == 0 {
        d.bps.delete(id);
        d.bps.next_id = id;
        d.out.push_str("no code at line ");
        d.out.push_int(line as i64);
        d.out.push_str("\n");
        return;
    }
    d.out.push_str("breakpoint ");
    d.out.push_int(id as i64);
    d.out.push_str(" at ");
    d.out.push_str(debug.basename(d.file));
    d.out.push_str(":");
    d.out.push_int(line as i64);
    d.out.push_str("\n");
}

fn Dbg.sites_in(d: *Dbg, p: Gc<Proto>, id: u32, line: u32) {
    let words = p.code.words();
    var i: u64 = 0;
    var prev: u32 = 0;
    while i < words.len {
        let l = p.lines.data[i];
        if l == line and (i == 0 or prev != line) {
            if let Some(t) = Mini.set_break(p.code, i) { d.bps.add_site(id, (words.ptr + i) as u64, t); }
        }
        prev = l;
        i += Mini.base_size(words[i]);
    }
    for j in 0..p.protos.data.len { d.sites_in(p.protos.data[j], id, line); }
}

fn Dbg.info(d: *Dbg) {
    let l = d.bps.list();
    if l.len == 0 { d.out.push_str("no breakpoints\n"); return; }
    for i in 0..l.len {
        let b = l[i];
        d.out.push_str("breakpoint ");
        d.out.push_int(b.id as i64);
        d.out.push_str(" at ");
        d.out.push_str(debug.basename(b.file));
        d.out.push_str(":");
        d.out.push_int(b.line as i64);
        d.out.push_str(", hit ");
        d.out.push_int(b.hits as i64);
        d.out.push_str(if b.hits == 1 { " time\n" } else { " times\n" });
    }
}

/// Frames from the innermost: each function and the line it is at (a
/// caller at its CALL).
fn Dbg.backtrace(d: *Dbg, c: *Ctx, pc: *u32, fp: *Frame) {
    var f = fp;
    var at = pc;
    var n: i64 = 0;
    loop {
        d.out.push_str("#");
        d.out.push_int(n);
        d.out.push_str(" ");
        d.location(f.cl.proto, line_of(f.cl.proto, at));
        d.out.push_str("\n");
        if f == c.frames { break; }
        f = f - 1;
        at = f.resume - 1;
        n += 1;
    }
}

/// The locals live at `pc` in frame `fp` (only `name`'s if not empty),
/// innermost scope last.
fn Dbg.locals(d: *Dbg, fp: *Frame, pc: *u32, name: str) {
    let p = fp.cl.proto;
    let i = ((pc as u64) - (p.code.start() as u64)) / 4;
    let vars = locvars(p);
    var found = false;
    for j in 0..vars.len {
        let v = vars[j];
        if (v.start as u64) <= i and i < (v.end as u64) and v.name.len > 0 and v.name[0] != '(' {
            if name.len == 0 or v.name.eq(name) {
                d.out.push_str(v.name);
                d.out.push_str(" = ");
                show(&d.out, fp.base[v.reg]);
                d.out.push_str("\n");
                found = true;
            }
        }
    }
    if !found {
        if name.len == 0 { d.out.push_str("no locals\n"); } else { d.out.push_str("no local '"); d.out.push_str(name); d.out.push_str("'\n"); }
    }
}

/// A value as the debugger shows it: strings quoted, tables and
/// functions without their addresses.
fn show(b: *text.StrBuf, v: V) {
    match v {
        S(s) => { b.push_str("\""); b.push_str(s.data); b.push_str("\""); }
        T(_) => b.push_str("<table>"),
        F(cl) => { b.push_str("<function '"); b.push_str(cl.proto.name.data); b.push_str("'>"); }
        _ => value.write_value(b, v),
    }
}
