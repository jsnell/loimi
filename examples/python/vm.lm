// The bytecode vm of the Python subset: a register machine with
// Lua-style register windows, frames in a host array, exceptions through
// `on raise` and per-prototype handler tables, and generators as frames
// whose registers are saved in the generator object between resumes.
import std.gc;
import std.mem;
import std.text;
import std.map;
import value;
import value.{Value, Str, Arr, List, Tuple, Dict, Inst, Func, Box, K_MODULE, K_STATICM, K_CLASSM,
              K_CLASS, K_BOUND, K_RANGEIT, K_SEQIT, K_GEN, GEN_NEW, GEN_SUSPENDED, GEN_RUNNING, GEN_DONE};
import ops;
import builtins; #[cfg(debug)] import debugger;

/// A handler table entry: words [start, end) are protected; an exception
/// raised there is stored in `reg` and execution continues at `target`.
pub struct ExcEntry { start: u32, end: u32, target: u32, reg: u32 }

pub const P_VARARGS: u32 = 1;
pub const P_VARKW: u32 = 2;
pub const P_GEN: u32 = 4;
/// The function names `NotImplemented`: the vm loop does not call it as an
/// operator method in place (ops.simple_method), whose result would be
/// used without the reflected-operand fallback.
pub const P_NOTIMPL: u32 = 8;

pub struct Proto {
    name: str,
    nparams: u32,
    nkwonly: u32,
    flags: u32,
    nregs: u32,
    /// nparams when a call with exactly that many positional arguments
    /// needs no argument processing, else u32 max.
    simple: u32,
    /// Names of the parameters, in register order (Str values).
    pnames: []Value,
    /// For each free variable of a function created from this prototype:
    /// where MAKEFUNC finds the cell: bit 31 set: the creator's free
    /// variable number; clear: the creator's register holding the cell.
    freesrc: []u32,
    words: []u32,
    code: Verified<Py>,
    consts: []Value,
    lines: []u32,
    handlers: []ExcEntry,
    /// Index of the first default value's parameter.
    ndefaults: u32,
}

pub const F_DISCARD: u64 = 1;
pub const F_GEN: u64 = 2;
/// The bottom frame of a nested run (RET and an uncaught raise exit it).
pub const F_BASE: u64 = 4;

pub struct Frame {
    func: Value,
    gen: Value,
    base: *Value,
    k: *Value,
    proto: *Proto,
    ret_pc: *u32,
    ret_slot: *Value,
    alt_pc: *u32,
    flags: u64, #[cfg(debug)] at: *u32, // --cfg debug: where this frame called a native (sync), for the debugger's backtrace
}

pub const NTYPES: u64 = 24;
// Builtin type codes: index into Ctx.types.
pub const T_NONE: u64 = 0;
pub const T_BOOL: u64 = 1;
pub const T_INT: u64 = 2;
pub const T_FLOAT: u64 = 3;
pub const T_STR: u64 = 4;
pub const T_LIST: u64 = 5;
pub const T_TUPLE: u64 = 6;
pub const T_DICT: u64 = 7;
pub const T_SET: u64 = 8;
pub const T_FUNC: u64 = 9;
pub const T_BUILTIN: u64 = 10;
pub const T_TYPE: u64 = 11;
pub const T_RANGE: u64 = 12;
pub const T_GEN: u64 = 13;
pub const T_METHOD: u64 = 14;
pub const T_MODULE: u64 = 15;
pub const T_OBJECT: u64 = 16;
pub const T_ITER: u64 = 17;
pub const T_FROZENSET: u64 = 18;
pub const T_SLICE: u64 = 19;
pub const T_PROPERTY: u64 = 20;
pub const T_SUPER: u64 = 21;
pub const T_CELL: u64 = 22;
pub const T_NOTIMPL: u64 = 23;

/// An entry of the global method cache (`Ctx.mcache`, ops.loadmethod's
/// miss path): name `name` (an interned string's address) looked up on
/// class `cls` at class epoch `epoch` is the function with bits `fnv`
/// (ops.method_value).
pub struct MCEnt { cls: u32, epoch: u32, name: u64, fnv: u64 }
pub const MC_SIZE: u64 = 1024;

/// Its GC references are marked by the generated `Ctx.trace` (`#[trace]`),
/// called from `scan_roots`, which marks the stacks and code constants.
#[trace]
pub struct Ctx {
    heap: gc.Heap,
    stack: *Value,
    stack_end: *Value,
    /// Every stack slot below `hw` may hold a value and is scanned.
    hw: *Value,
    frames: *Frame,
    frames_end: *Frame,
    fp: *Frame,
    protos: mem.Vec<*Proto>,
    globals: ?Gc<Dict>,
    builtins: ?Gc<Dict>,
    modules: ?Gc<Dict>,
    types: [?Gc<Box>; 24],
    /// Exception classes by builtins.E_* number.
    excs: [?Gc<Box>; 32],
    strs: map.HashMap<str, Gc<Str>>,
    names: mem.Arena,
    /// Bumped whenever a class dict changes (method caches check it).
    epoch: u32,
    /// MC_SIZE entries (zeroed: class ids start at 1).
    mcache: *MCEnt,
    next_cls: u32,
    gen_done: bool,
    err_line: u32,
    buf: text.StrBuf,
    /// Interned names the runtime looks up.
    n_init: ?Gc<Str>,
    n_str: Value,
    n_repr: Value,
    mt: [u32; 624],
    mti: u64,
    vm_depth: u64,
    /// Depth of the runtime's own recursion over values (repr, ==, <,
    /// hash of nested containers): past ops.C_DEPTH_MAX it raises
    /// RecursionError instead of overflowing the C stack.
    c_depth: u64,
    /// Lowest C stack address natives may recurse down to (main sets it
    /// from the stack rlimit, keeping a reserve): ops.stack_low.
    stack_low: u64,
    /// Lists and dicts whose repr is being written (CPython's
    /// Py_ReprEnter): a cycle prints as [...] / {...}.
    repr_active: mem.Vec<u64>,
    /// Prelude functions (Python): list(g), f(list(g)), f(a, list(g)).
    pre_list: Value,
    pre_via1: Value,
    pre_via2: Value,
    /// Interned dunder names (ops.DN_*).
    dn: [Value; 40],
    /// Empty instance shapes by slot count, for builtin classes (user
    /// classes have their own), and the shape of dict-mode instances
    /// (ops.new_inst, value.Inst).
    shape_roots: [?Gc<Box>; 65],
    shape_dict: ?Gc<Box>,
}

/// Interned string for a name (kept alive for the run).
pub fn intern(c: *Ctx, s: str) -> Gc<Str> {
    if let Some(x) = c.strs.get(s) { return x; }
    let k = c.names.str(s);
    let o = value.new_str(&c.heap, k);
    value.str_hash(o);
    c.strs.insert(k, o);
    o
}

pub fn scan_roots(h: *gc.Heap, c: *Ctx) {
    var p = c.stack;
    while p < c.hw { gc_mark(h, *p); p = p + 1; }
    var f = c.frames;
    while f <= c.fp {
        gc_mark(h, f.func);
        gc_mark(h, f.gen);
        f = f + 1;
    }
    for i in 0..c.protos.len {
        let pr = c.protos.at(i);
        for j in 0..pr.consts.len { gc_mark(h, pr.consts[j]); }
        for j in 0..pr.pnames.len { gc_mark(h, pr.pnames[j]); }
    }
    c.trace(h);
}

pub fn line_of(p: *Proto, pc: *u32) -> u32 {
    let off = p.code.index_of(pc);
    if off < p.lines.len { p.lines[off] } else { 0 }
}

#[profile("python.vmprofile")]
pub vm Py {
    context ctx: *Ctx;
    state { pc: *u32, regs: *Value, k: *Value, fp: *Frame }

    verify_context proto: *Proto;
    operand reg = regs[it] verify (it as u32) < proto.nregs display "r{}";
    operand kst = k[it] verify it < proto.consts.len display "k{}";
    operand imm = it;
    operand simm = it;
    operand label = pc + it verify is_insn_boundary(pc + it);
    /// Argument counts: R[base+1 .. base+n] must be in the frame.
    operand nargs = it verify Py.ABC_a(*pc) + it < proto.nregs as u64;
    /// MAKEFUNC's prototype index.
    operand pidx = it verify it < ctx_protos_len();

    /// Exception handler table: `on raise` jumps to `start + target` and
    /// writes `regs[reg]`, so both must be valid for the code.
    verify handlers {
        var ok = true;
        for i in 0..proto.handlers.len {
            let h = proto.handlers[i];
            if !is_insn_boundary(code.ptr + h.target as u64) or h.reg >= proto.nregs or h.start > h.end {
                reject(h.start as u64, "bad exception handler entry");
                ok = false;
            }
        }
        ok
    }

    encoding fixed(u32) {
        format ABC  { op: 8, a: 8, b: 8, c: 8 }
        format ABx  { op: 8, a: 8, bx: 16 }
        format AsBx { op: 8, a: 8, sbx: s16 }
        format sJ   { op: 8, sj: s24 }
    }

    cache GlobalIC = ops.GlobalSite;
    cache SetGIC { idx: u32 }
    /// Two entry numbers: attribute reads see instances of two layouts.
    cache AttrIC { idx: u32, idx2: u32 }
    /// SETATTR: idx is where the attribute is (adding one does not use it).
    cache SetIC { idx: u32 }
    /// Two classes (deltablue's call sites see several).
    /// Instances: four entries (class id, the method's bits), most recent
    /// first, valid at class epoch `epoch` (see ops.method_value); modules
    /// and classes (epoch 0xfffffffe) and builtin types (0xffffffff) use
    /// `idx`.
    cache MethIC { cls: u32, epoch: u32, idx: u32, fnv: u64, cls2: u32, fnv2: u64, cls3: u32, fnv3: u64, cls4: u32, fnv4: u64 }

    /// SUPERMETHOD: the method (its bits, ops.method_value) found from
    /// class id `cls` (the class super() starts after) at class epoch `epoch`.
    cache SupIC { cls: u32, epoch: u32, fnv: u64 }

    sync { ctx.fp = fp; #[cfg(debug)] fp.at = pc; } // --cfg debug: where a frame calling a native is (backtraces)
    reload { fp = ctx.fp; regs = fp.base; k = fp.k; #[cfg(debug)] if debugger.stepping() { use_variant step; } } // --cfg debug: the native ran Python code that steps

    // ── frames ──────────────────────────────────────────────────────

    /// Make sure the stack is scanned up to `top`.
    fn ensure(top: *Value) -> bool {
        if top > ctx.hw {
            if top > ctx.stack_end { return false; }
            ctx.hw = top;
        }
        true
    }

    /// Push a frame for `f` whose arguments are in place at `win`, and run it.
    fn push_frame(f: Gc<Func>, win: *Value, slot: *Value, flags: u64) -> never {
        let p = f.proto;
        if !ensure(win + p.nregs as u64) { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") }
        if fp + 1 >= ctx.frames_end { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") }
        let nf = fp + 1;
        nf.func = Func(f);
        nf.gen = Nil;
        nf.base = win;
        nf.k = p.consts.ptr;
        nf.proto = p;
        nf.ret_pc = next_pc;
        nf.ret_slot = slot;
        nf.flags = flags;
        fp = nf;
        regs = win;
        k = nf.k;
        jump p.code
    }

    /// push_frame for `f` called with `n` positional arguments at `win`
    /// that ops.args_fast accepts: the missing ones are defaults.
    fn push_args(f: Gc<Func>, win: *Value, slot: *Value, n: u64, flags: u64) -> never {
        let p = f.proto;
        let np = p.simple as u64;
        if n < np {
            if !ensure(win + p.nregs as u64) { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") }
            let d = f.defaults as! Some;
            let nd = d.items.len;
            for i in n..np { win[i] = *(d.items.ptr + (i + nd - np)); }
        }
        push_frame(f, win, slot, flags)
    }

    /// Call R[b] with the `n` arguments at R[win..]; the result goes to R[b].
    /// `kw` is Nil or a tuple naming the last arguments.
    fn call_slow(b: u64, win: u64, n: u64, kw: Value) -> never {
        builtins.count(builtins.CNT_CALLSLOW);
        var callee = regs[b];
        var w = win;
        var nn = n;
        var flags: u64 = 0;
        loop {
            match callee {
                Func(f) => {
                    let p = f.proto;
                    builtins.count(330);
                    if kw == Nil and ops.args_fast(f, nn) { push_args(f, regs + w, regs + b, nn, flags) }
                    builtins.count(331);
                    if !ensure(regs + w + p.nregs as u64 + 1) { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") }
                    ops.bind_args(ctx, f, regs + w, nn, kw)?;
                    if (p.flags & P_GEN) != 0 {
                        let g = ops.make_gen(ctx, f, regs + w);
                        if (flags & F_DISCARD) == 0 { regs[b] = g; }
                        next
                    }
                    push_frame(f, regs + w, regs + b, flags)
                }
                Builtin(id) => {
                    // A generator argument to a consuming builtin: collect it
                    // in Python (prelude), so it runs in this loop rather than
                    // through a nested run per item.
                    if kw == Nil and nn >= 1 and nn <= 2 and value.is_kind(regs[w + nn - 1], K_GEN) and builtins.consumes(id) {
                        if !ensure(regs + w + nn + 2) { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") }
                        var i = nn;
                        while i > 0 { regs[w + i] = regs[w + i - 1]; i -= 1; }
                        regs[w] = callee;
                        callee = if nn == 1 { ctx.pre_via1 } else { ctx.pre_via2 };
                        nn += 1;
                        continue;
                    }
                    let r = builtins.call(ctx, id, regs + w, nn, kw)?;
                    if (flags & F_DISCARD) == 0 { regs[b] = r; }
                    next
                }
                Obj(o) => {
                    if o.kind == K_BOUND {
                        builtins.count(332);
                        if !ensure(regs + w + nn + 2) { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") }
                        var i = nn;
                        while i > 0 { regs[w + i] = regs[w + i - 1]; i -= 1; }
                        regs[w] = o.a;
                        nn += 1;
                        callee = o.b;
                        continue;
                    }
                    if o.kind == K_CLASS {
                        builtins.count(333);
                        if o.n != 0 {
                            if kw == Nil and nn == 1 and value.is_kind(regs[w], K_GEN) and o.n < 1000 {
                                let t = (o.n - 1) as u64;
                                if t == T_LIST { callee = ctx.pre_list; continue; }
                                if t == T_TUPLE or t == T_SET or t == T_FROZENSET or t == T_DICT {
                                    if !ensure(regs + w + 3) { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") }
                                    regs[w + 1] = regs[w];
                                    regs[w] = callee;
                                    callee = ctx.pre_via1;
                                    nn = 2;
                                    continue;
                                }
                            }
                            regs[b] = builtins.construct(ctx, o, regs + w, nn, kw)?;
                            next
                        }
                        let inst = ops.new_instance(ctx, o);
                        regs[b] = inst;
                        let init = ops.cached_init(ctx, o);
                        let Some(iv) = init else {
                            if nn > 0 or kw != Nil { raise ops.type_error(ctx, "takes no arguments", inst) }
                            next
                        };
                        if !ensure(regs + w + nn + 2) { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") }
                        var i = nn;
                        while i > 0 { regs[w + i] = regs[w + i - 1]; i -= 1; }
                        regs[w] = inst;
                        nn += 1;
                        callee = iv;
                        flags = F_DISCARD;
                        continue;
                    }
                    raise ops.not_callable(ctx, callee)
                }
                Inst(o) => {
                    let Some(m) = ops.class_lookup(o.cls, ops.dn(ctx, ops.DN_CALL)) else { raise ops.not_callable(ctx, callee) };
                    if !ensure(regs + w + nn + 2) { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") }
                    var i = nn;
                    while i > 0 { regs[w + i] = regs[w + i - 1]; i -= 1; }
                    regs[w] = callee;
                    nn += 1;
                    callee = m;
                    continue;
                }
                _ => raise ops.not_callable(ctx, callee),
            }
        }
    }

    /// Return `v` from the current frame.
    fn ret(v: Value) -> never {
        if fp.flags == 0 {
            *fp.ret_slot = v;
            let r = fp.ret_pc;
            fp = fp - 1;
            regs = fp.base;
            k = fp.k;
            jump r
        }
        cold {
            let fl = fp.flags;
            if (fl & F_GEN) != 0 {
                if let Obj(g) = fp.gen { g.m = GEN_DONE; g.b = v; } // the return value, for StopIteration and `yield from`
                if (fl & F_BASE) != 0 { ctx.gen_done = true; exit Ok(v) }
                let r = fp.alt_pc;
                fp = fp - 1;
                regs = fp.base;
                k = fp.k;
                jump r
            }
            if (fl & F_BASE) != 0 { exit Ok(v) }
            if (fl & F_DISCARD) == 0 { *fp.ret_slot = v; }
            let r = fp.ret_pc;
            fp = fp - 1;
            regs = fp.base;
            k = fp.k;
            jump r
        }
    }

    /// Resume generator `g`: on yield the value goes to `slot` and
    /// execution continues at `cont` (FORITER: `then_next_pc`); when done, at `alt`.
    fn resume(g: Gc<Box>, slot: *Value, cont: *u32, alt: *u32) -> never {
        if g.m == GEN_DONE { jump alt }
        if g.m == GEN_RUNNING { raise ops.exc(ctx, builtins.Exc.ValueError, "generator already executing") }
        let f = g.a as! Func;
        let p = f.proto;
        let win = regs + fp.proto.nregs as u64;
        if !ensure(win + p.nregs as u64) { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") }
        if fp + 1 >= ctx.frames_end { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") }
        let saved = g.extra.ptr;
        for i in 0..p.nregs as u64 { win[i] = saved[i]; }
        if g.m == GEN_SUSPENDED { win[g.s as u64] = Nil; }
        g.m = GEN_RUNNING;
        let nf = fp + 1;
        nf.func = g.a;
        nf.gen = Obj(g);
        nf.base = win;
        nf.k = p.consts.ptr;
        nf.proto = p;
        nf.ret_pc = cont;
        nf.ret_slot = slot;
        nf.alt_pc = alt;
        nf.flags = F_GEN;
        fp = nf;
        regs = win;
        k = nf.k;
        jump (p.code.start() + g.n as u64)
    }

    /// Call `f(x, y)` in this loop, the result going to R[dst]: for
    /// operator methods (__add__, __getitem__, ...).
    fn call2(f: Gc<Func>, x: Value, y: Value, dst: u64) -> never {
        let win = regs + fp.proto.nregs as u64;
        if !ensure(win + 2) { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") }
        win[0] = x;
        win[1] = y;
        push_frame(f, win, regs + dst, 0)
    }

    fn gc_point() {
        if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); } }
    }
    /// `#[poll(gc)]`: collect at the start of an op that allocates, then
    /// run it again (nothing before the poll has happened yet).
    poll gc { if unlikely(ctx.heap.allocated > ctx.heap.threshold) { cold { gc.collect(&ctx.heap); redo } } }

    // ── moves and constants ─────────────────────────────────────────

    op MOVE(dst: reg, src: reg) : ABC { dst = src; next }
    op LOADK(dst: reg, c: kst) : ABx { dst = c; next }
    op LOADI(dst: reg, v: simm) : AsBx { dst = Int(v as i48); next }
    op LOADNIL(dst: reg) : ABC { dst = Nil; next }
    op LOADBOOL(dst: reg, v: imm) : ABC { dst = Bool(v != 0); next }

    family GETGLOBAL(dst: reg, name: kst) : ABx + GlobalIC {
        generic {
            let s = name as! Str;
            dst = ops.get_global(ctx, fp.func, s, &cache)?;
            if cache.builtin != 0 { become GETGLOBAL_B; next }
            become GETGLOBAL_C;
            next
        }
        GETGLOBAL_C {
            let f = fp.func as! Func;
            let d = f.globals;
            let i = cache.idx as u64;
            if likely(i < d.used) {
                let e = d.ents.e.ptr + i;
                if e.key == name { dst = e.value; next }
            }
            become GETGLOBAL; redo
        }
        GETGLOBAL_B {
            let f = fp.func as! Func;
            let d = f.globals;
            if (d.version as u32) == cache.ver {
                let bd = ctx.builtins.unwrap();
                dst = (bd.ents.e.ptr + (cache.idx as u64)).value;
                next
            }
            become GETGLOBAL; redo
        }
    }
    /// The entry number is checked as GETGLOBAL_C checks it.
    op SETGLOBAL(src: reg, name: kst) : ABx + SetGIC {
        let f = fp.func as! Func;
        let d = f.globals;
        let i = cache.idx as u64;
        if likely(i < d.used) {
            let e = d.ents.e.ptr + i;
            if e.key == name {
                e.value = src;
                gc.write_barrier(&ctx.heap, d.ents as *u8);
                next
            }
        }
        cold {
            let s = name as! Str;
            value.dict_set_str(&ctx.heap, d, s, src);
            if let Some(j) = value.dict_find_str(d, s) { cache.idx = j as u32; }
            next
        }
    }
    op DELGLOBAL(name: kst @ bx) : ABx {
        let f = fp.func as! Func;
        if !value.dict_del(f.globals, name, value.hash_of(name).unwrap()) {
            raise ops.name_error(ctx, name)
        }
        next
    }
    /// Class bodies: names live in the namespace dict R[ns].
    op LOADNAME(dst: reg, ns: reg, name: kst) : ABC {
        let s = name as! Str;
        let d = ns as! Dict;
        if let Some(v) = value.dict_get_str(d, s) { dst = v; next }
        var g = ops.GlobalSite { idx: 0, ver: 0, builtin: 0 };
        dst = ops.get_global(ctx, fp.func, s, &g)?;
        next
    }
    op STORENAME(src: reg, ns: reg, name: kst) : ABC {
        let s = name as! Str;
        let d = ns as! Dict;
        value.dict_set_str(&ctx.heap, d, s, src);
        next
    }

    // ── cells (closures) ────────────────────────────────────────────

    #[poll(gc)] op MAKECELL(r: reg) : ABC {
        r = Cell(new(&ctx.heap, value.Cell { v: r }));
        next
    }
    op LOADCELL(dst: reg, cell: reg) : ABC {
        let c = cell as! Cell;
        let v = c.v;
        if v == Undef { raise ops.unbound(ctx) }
        dst = v;
        next
    }
    op STORECELL(cell: reg, src: reg) : ABC {
        let c = cell as! Cell;
        c.v = src;
        next
    }
    op LOADFREE(dst: reg, i: imm) : ABC {
        let f = fp.func as! Func;
        let c = f.cells.unwrap().items[i] as! Cell;
        let v = c.v;
        if v == Undef { raise ops.unbound(ctx) }
        dst = v;
        next
    }
    op STOREFREE(src: reg, i: imm) : ABC {
        let f = fp.func as! Func;
        let c = f.cells.unwrap().items[i] as! Cell;
        c.v = src;
        next
    }

    // ── attributes ──────────────────────────────────────────────────

    op GETATTR(dst: reg, obj: reg, name: kst) : ABC + AttrIC {
        if let Inst(o) = obj {
            // Attribute i is `name` if the shape's name i is (interned: one
            // compare); it is in slot i if i is below the shape's inline
            // count `s` (the others: value.inst_at, in the cold block).
            let sh = o.keys;
            let ni = sh.s as u64;
            let i = cache.idx as u64;
            if likely(i < ni) {
                if *(sh.extra.ptr + i) == name { dst = *(o.slots.ptr + i); next }
            }
            let j = cache.idx2 as u64;
            if j < ni {
                if *(sh.extra.ptr + j) == name { dst = *(o.slots.ptr + j); next }
            }
        } else if let Obj(b) = obj and (b.kind == K_CLASS or b.kind == K_MODULE) and let Some(d) = b.dict {
            // A plain attribute of the class (or module) itself; ops.getattr
            // fills the cache only for values that need no binding.
            let i = cache.idx as u64;
            if i < d.used {
                let e = d.ents.e.ptr + i;
                if e.key == name { dst = e.value; next }
            }
        }
        cold {
            if let Inst(o) = obj and let Some(v) = ops.inst_cached(o, name, cache.idx) { dst = v; next }
            let s = name as! Str;
            let old = cache.idx;
            dst = ops.getattr(ctx, obj, s, &cache.idx)?;
            if cache.idx != old { cache.idx2 = old; }
            next
        }
    }
    op SETATTR(obj: reg, name: kst, src: reg) : ABC + SetIC {
        if let Inst(o) = obj {
            let sh = o.keys;
            let i = cache.idx as u64;
            if likely(i < sh.s as u64) {
                if *(sh.extra.ptr + i) == name {
                    *(o.slots.ptr + i) = src;
                    gc.write_barrier(&ctx.heap, o as *u8);
                    next
                }
            }
            // Adding attribute n (whatever the cache says: sites in a
            // base's __init__ add at different positions): the shape's last
            // transition, if it was for `name` (the dict-mode shape has
            // none) and the class had no attribute `name` at this epoch
            // (ops.setattr records it in the shape, `a`).
            let n = sh.extra.len;
            if n < o.slots.len and let Obj(t) = sh.c and *(t.extra.ptr + n) == name and t.a == Int(ctx.epoch as i48) {
                *(o.slots.ptr + n) = src;
                o.keys = t;
                gc.write_barrier(&ctx.heap, o as *u8);
                next
            }
        }
        cold {
            if let Inst(o) = obj and ops.inst_cached(o, name, cache.idx).is_some() {
                value.inst_set_at(o, cache.idx as u64, src);
                next
            }
            gc_point();
            let s = name as! Str;
            ops.setattr(ctx, obj, s, src, &cache.idx)?;
            next
        }
    }
    op DELATTR(obj: reg, name: kst) : ABC {
        let s = name as! Str;
        ops.delattr(ctx, obj, s)?;
        next
    }
    /// R[base] = the method, R[base+1] = self (or Undef for a plain value).
    op LOADMETHOD(base: reg, obj: reg, name: kst) : ABC + MethIC {
        let o = obj;
        if let Inst(i) = o {
            let cls = i.cls;
            if ctx.epoch == cache.epoch {
                if cls.id == cache.cls {
                    regs[base.raw] = ops.method_value(cache.fnv);
                    regs[base.raw + 1] = o;
                    next
                }
                if cls.id == cache.cls2 {
                    regs[base.raw] = ops.method_value(cache.fnv2);
                    regs[base.raw + 1] = o;
                    next
                }
                if cls.id == cache.cls3 {
                    regs[base.raw] = ops.method_value(cache.fnv3);
                    regs[base.raw + 1] = o;
                    next
                }
                if cls.id == cache.cls4 {
                    regs[base.raw] = ops.method_value(cache.fnv4);
                    regs[base.raw + 1] = o;
                    next
                }
            }
        } else if let Obj(b) = o and cache.epoch == 0xfffffffe and let Some(d) = b.dict {
            // A function in a module's or class's own dict, called without self.
            let i = cache.idx as u64;
            if i < d.used and (b.kind == K_MODULE or b.kind == K_CLASS) {
                let e = d.ents.e.ptr + i;
                if e.key == name {
                    let v = e.value;
                    if let Obj(sm) = v and sm.kind == K_STATICM { regs[base.raw] = sm.a; regs[base.raw + 1] = Undef; next }
                    if let Obj(cm) = v and cm.kind == K_CLASSM { regs[base.raw] = cm.a; regs[base.raw + 1] = o; next }
                    regs[base.raw] = v;
                    regs[base.raw + 1] = Undef;
                    next
                }
            }
        } else if ops.type_code(o) == cache.cls and cache.epoch == 0xffffffff {
            regs[base.raw] = Builtin(cache.idx);
            regs[base.raw + 1] = o;
            next
        }
        cold {
            let s = name as! Str;
            // The previous entries move down one.
            let (pc_, pe, pf) = (cache.cls, cache.epoch, cache.fnv);
            var m = Value.Nil;
            var selfv = o;
            // The global method cache first, without the call (sites that
            // see more classes than their two entries).
            var f = pf;
            if let Inst(i) = o and let Some(v) = ops.mc_fill(ctx, i.cls, s, &cache.cls, &cache.epoch, &f) {
                m = v;
            } else {
                gc_point();
                let (m2, s2) = ops.loadmethod(ctx, o, s, &cache.cls, &cache.epoch, &cache.idx, &f)?;
                m = m2;
                selfv = s2;
            }
            cache.fnv = f;
            if pe == cache.epoch and pe != 0xffffffff and pe != 0xfffffffe and pc_ != cache.cls and pc_ != 0 {
                cache.cls4 = cache.cls3;
                cache.fnv4 = cache.fnv3;
                cache.cls3 = cache.cls2;
                cache.fnv3 = cache.fnv2;
                cache.cls2 = pc_;
                cache.fnv2 = pf;
            } else if pe != cache.epoch {
                cache.cls2 = 0;
                cache.cls3 = 0;
                cache.cls4 = 0;
            }
            regs[base.raw] = m;
            regs[base.raw + 1] = selfv;
            next
        }
    }

    /// `super(R[base], R[base+1]).name` (z = 0), or `super().name` in a
    /// method with self in R[base+1] (z = 1: the class is the function's
    /// owner), for a method call: R[base] = the method and R[base+1] self,
    /// as LOADMETHOD leaves them, without making the super object.
    op SUPERMETHOD(base: reg, z: imm, name: kst) : ABC + SupIC {
        var kv = base;
        if z != 0 { kv = Nil; if let Func(f) = fp.func and let Some(o) = f.owner { kv = Obj(o); } }
        if let Obj(k) = kv and k.id == cache.cls and ctx.epoch == cache.epoch and k.kind == K_CLASS {
            regs[base.raw] = ops.method_value(cache.fnv);
            next
        }
        cold {
            gc_point();
            let s = name as! Str;
            var f = cache.fnv;
            let (m, sv) = ops.super_method(ctx, kv, regs[base.raw + 1], s, &cache.cls, &cache.epoch, &f)?;
            cache.fnv = f;
            regs[base.raw] = m;
            regs[base.raw + 1] = sv;
            next
        }
    }

    // ── calls ───────────────────────────────────────────────────────

    /// CALL_NEW: a call of a class (user classes) whose __init__ takes the
    /// arguments as they are; CALL_M1: a one-argument math function. Both
    /// were paths of the generic op's cold block. (CALL_NEW redoes as
    /// CALL after `ensure`, which only ever raises the stack's high-water
    /// mark: CALL raises it again, to the same height.)
    #[allow(redo_effect)]
    family CALL(base: reg, n: nargs) : ABC {
        generic {
            if let Func(f) = base {
                if f.proto.simple == n as u32 { push_frame(f, regs + base.raw + 1, regs + base.raw, 0) }
            }
            if let Builtin(id) = base and id == builtins.b_len() and n == 1 {
                match regs[base.raw + 1] {
                    List(l) => { regs[base.raw] = Int(l.len as i48); next }
                    Tuple(t) => { regs[base.raw] = Int(t.items.len as i48); next }
                    Str(s) => { regs[base.raw] = Int(s.data.len as i48); next }
                    Dict(d) => { regs[base.raw] = Int(d.len as i48); next }
                    Obj(o) => if (o.kind == value.K_SET or o.kind == value.K_FROZENSET) and let Some(d) = o.dict {
                        regs[base.raw] = Int(d.len as i48);
                        next
                    },
                    _ => {}
                }
            }
            cold {
                // A user class whose __init__ is a function that takes the
                // arguments as they are: the instance, then __init__'s frame
                // (its None result goes to the self slot, so RET needs no
                // F_DISCARD).
                if let Obj(cl) = base and cl.kind == K_CLASS {
                    gc_point();
                    if cl.n == 0 and let Some(iv) = ops.cached_init(ctx, cl) and let Func(init) = iv and ops.args_fast(init, n as u64 + 1) {
                        let w = regs + base.raw + 1;
                        if !ensure(w + n as u64 + 1) { cold { raise ops.exc(ctx, builtins.Exc.RecursionError, "maximum recursion depth exceeded") } }
                        let inst = ops.new_instance(ctx, cl);
                        var i = n as u64;
                        while i > 0 { w[i] = w[i - 1]; i -= 1; }
                        w[0] = inst;
                        regs[base.raw] = inst;
                        if init.proto.simple == n as u32 + 1 { become CALL_NEW; }
                        push_args(init, w, w, n as u64 + 1, 0)
                    }
                    // A builtin type (or a subclass of one): its constructor,
                    // unless a generator is to be collected (call_slow).
                    if cl.n != 0 and cl.n < 1000 and (n == 0 or !value.is_kind(regs[base.raw + 1], K_GEN)) {
                        regs[base.raw] = builtins.construct(ctx, cl, regs + base.raw + 1, n as u64, Nil)?;
                        next
                    }
                }
                if let Func(f) = base and ops.args_fast(f, n as u64) { push_args(f, regs + base.raw + 1, regs + base.raw, n as u64, 0) }
                // isinstance(instance, class), without the builtin call.
                if let Builtin(id) = base and id == builtins.b_isinstance() and n == 2 and let Inst(o) = regs[base.raw + 1]
                    and let Obj(cls) = regs[base.raw + 2] and cls.kind == K_CLASS {
                    regs[base.raw] = Bool(ops.subclass(o.cls, cls));
                    next
                }
                if n == 1 and let Builtin(id) = base and let Some(r) = builtins.math1(id, regs[base.raw + 1]) { regs[base.raw] = r; become CALL_M1; next }
                gc_point();
                // A bound list method (`pop = l.pop; pop(0)`).
                if let Obj(bm) = base and bm.kind == K_BOUND and let Builtin(id) = bm.b and let List(l) = bm.a
                    and let Some(r) = builtins.list_fast(ctx, id, l, regs + base.raw + 1, n as u64) {
                    regs[base.raw] = r;
                    next
                }
                call_slow(base.raw, base.raw + 1, n as u64, Nil)
            }
        }
        CALL_NEW {
            if let Obj(cl) = base and cl.kind == K_CLASS and cl.n == 0 and cl.b == Int(ctx.epoch as i48) and let Func(init) = cl.c
                and init.proto.simple == n as u32 + 1 and ctx.heap.allocated <= ctx.heap.threshold {
                let w = regs + base.raw + 1;
                if ensure(w + n as u64 + 1) {
                    let inst = ops.new_instance(ctx, cl);
                    var i = n as u64;
                    while i > 0 { w[i] = w[i - 1]; i -= 1; }
                    w[0] = inst;
                    regs[base.raw] = inst;
                    push_frame(init, w, w, 0)
                }
            }
            become CALL; redo
        }
        /// math.sqrt(x) & co. imported as names (builtins.math1).
        CALL_M1 {
            if let Builtin(id) = base and let Some(r) = builtins.math1(id, regs[base.raw + 1]) { regs[base.raw] = r; next }
            become CALL; redo
        }
    }
    /// Method call after LOADMETHOD: R[base] callee, R[base+1] self or
    /// Undef, then the n arguments.
    op CALLMETHOD(base: reg, n: imm) : ABC {
        let f = base;
        let s = regs[base.raw + 1];
        if s != Undef {
            if let Func(fn_) = f {
                if fn_.proto.simple == (n + 1) as u32 { push_frame(fn_, regs + base.raw + 1, regs + base.raw, 0) }
            }
            if let Builtin(id) = f and id == builtins.b_list_append() and n == 1 and let List(l) = s and l.len < l.arr.items.len {
                *(l.arr.items.ptr + l.len) = regs[base.raw + 2];
                l.len += 1;
                gc.write_barrier(&ctx.heap, l.arr as *u8);
                regs[base.raw] = Nil;
                next
            }
            cold {
                if let Func(fn_) = f and ops.args_fast(fn_, n as u64 + 1) { push_args(fn_, regs + base.raw + 1, regs + base.raw, n as u64 + 1, 0) }
                // object.__init__(self) (super().__init__() in a class
                // without other bases) does nothing.
                if n == 0 and let Builtin(id) = f and id == builtins.b_object_init() { regs[base.raw] = Nil; next }
                gc_point();
                if let Builtin(id) = f and let List(l) = s and let Some(r) = builtins.list_fast(ctx, id, l, regs + base.raw + 2, n as u64) {
                    regs[base.raw] = r;
                    next
                }
                call_slow(base.raw, base.raw + 1, n as u64 + 1, Nil)
            }
        }
        cold {
            // math.sqrt(x) & co.: a function of a module, called without self.
            if n == 1 and let Builtin(id) = f and let Some(r) = builtins.math1(id, regs[base.raw + 2]) { regs[base.raw] = r; next }
            gc_point();
            call_slow(base.raw, base.raw + 2, n as u64, Nil)
        }
    }
    /// CALL with keyword arguments: the last len(K[kw]) of the n
    /// arguments are named by the tuple K[kw].
    #[poll(gc)] op CALLKW(base: reg, n: nargs, kw: kst) : ABC {
        call_slow(base.raw, base.raw + 1, n as u64, kw)
    }
    #[poll(gc)] op CALLMETHODKW(base: reg, n: imm, kw: kst) : ABC {
        if regs[base.raw + 1] != Undef { call_slow(base.raw, base.raw + 1, n as u64 + 1, kw) }
        call_slow(base.raw, base.raw + 2, n as u64, kw)
    }
    /// R[base](*R[base+1], **R[base+2]) (R[base+2] may be None).
    #[poll(gc)] op CALLEX(base: reg) : ABC {
        let (n, kw) = ops.spread_args(ctx, regs + base.raw + 1)?;
        call_slow(base.raw, base.raw + 1, n, kw)
    }
    op RET(src: reg) : ABC { ret(src) }
    op RETNIL() : ABC { ret(Nil) }

    // ── arithmetic ──────────────────────────────────────────────────

    inline for (name, checked, sym, opn, bkind) in [
        ("ADD", "add_checked", +, ops.O_ADD, reg),
        ("SUB", "sub_checked", -, ops.O_SUB, reg),
        ("MUL", "mul_checked", *, ops.O_MUL, reg),
        ("ADDK", "add_checked", +, ops.O_ADD, kst),
        ("SUBK", "sub_checked", -, ops.O_SUB, kst),
        ("MULK", "mul_checked", *, ops.O_MUL, kst),
    ] {
        op #name(dst: reg, a: reg, b: bkind) : ABC {
            match (a, b) {
                (Int(x), Int(y)) => if let Some(r) = x.#checked(y) { dst = Int(r); next },
                (Float(x), Float(y)) => { dst = Float(x sym y); next }
                _ => {}
            }
            cold {
                match (a, b) {
                    (Int(x), Float(y)) => { dst = Float((x as f64) sym y); next }
                    (Float(x), Int(y)) => { dst = Float(x sym (y as f64)); next }
                    _ => {}
                }
                if let Some(f) = ops.binop_method(ctx, opn, a, b) {
                    if let Inst(_) = a { call2(f, a, b, dst.raw) }
                    call2(f, b, a, dst.raw)
                }
                gc_point();
                dst = ops.arith(ctx, opn, a, b)?;
                next
            }
        }
    }
    /// `a += b`: lists extend in place.
    op IADD(dst: reg, a: reg, b: reg) : ABC {
        match (a, b) {
            (Int(x), Int(y)) => if let Some(r) = x.add_checked(y) { dst = Int(r); next },
            (Float(x), Float(y)) => { dst = Float(x + y); next }
            _ => {}
        }
        cold {
            gc_point();
            if let List(_) = a { ops.list_extend(ctx, a, b)?; dst = a; next }
            dst = ops.arith(ctx, ops.O_ADD, a, b)?;
            next
        }
    }
    op TRUEDIV(dst: reg, a: reg, b: reg) : ABC {
        match (a, b) {
            (Float(x), Float(y)) => if y != 0.0 { dst = Float(x / y); next },
            (Float(x), Int(y)) => if y != 0 { dst = Float(x / (y as f64)); next },
            _ => {}
        }
        cold {
            match (a, b) {
                (Int(x), Float(y)) => if y != 0.0 { dst = Float((x as f64) / y); next },
                (Float(x), Int(y)) => if y != 0 { dst = Float(x / (y as f64)); next },
                (Int(x), Int(y)) => if y != 0 { dst = Float((x as f64) / (y as f64)); next },
                _ => {}
            }
            if let Some(f) = ops.binop_method(ctx, ops.O_TRUEDIV, a, b) {
                if let Inst(_) = a { call2(f, a, b, dst.raw) }
                call2(f, b, a, dst.raw)
            }
            gc_point();
            dst = ops.arith(ctx, ops.O_TRUEDIV, a, b)?;
            next
        }
    }
    op FLOORDIV(dst: reg, a: reg, b: reg) : ABC {
        if let (Int(x), Int(y)) = (a, b) and y > 0 {
            var q = x / y;
            if (x % y) != 0 and x < 0 { q -= 1; }
            dst = Int(q);
            next
        }
        cold { gc_point(); dst = ops.arith(ctx, ops.O_FLOORDIV, a, b)?; next }
    }
    op MOD(dst: reg, a: reg, b: reg) : ABC {
        if let (Int(x), Int(y)) = (a, b) and y > 0 {
            var r = x % y;
            if r < 0 { r += y; }
            dst = Int(r);
            next
        }
        cold { gc_point(); dst = ops.arith(ctx, ops.O_MOD, a, b)?; next }
    }
    op POW(dst: reg, a: reg, b: reg) : ABC {
        // A float to a float or int power with a finite result (no error
        // to raise: not 0.0 to a negative power, not a complex result).
        let fy = match b { Float(y) => y, Int(y) => y as f64, _ => 0.5 };
        if let Float(x) = a and x != 0.0 and (b is Float | Int) {
            let r = builtins.pow_f(x, fy);
            if r - r == 0.0 { dst = Float(r); next }
        }
        if let (Int(x), Int(y)) = (a, b) and y == 2 and let Some(r) = x.mul_checked(x) { dst = Int(r); next }
        cold {
            gc_point();
            dst = ops.arith(ctx, ops.O_POW, a, b)?;
            next
        }
    }
    inline for (name, opn) in [("LSHIFT", ops.O_LSHIFT), ("RSHIFT", ops.O_RSHIFT), ("MATMUL", ops.O_MATMUL)] {
        op #name(dst: reg, a: reg, b: reg) : ABC {
            gc_point();
            dst = ops.arith(ctx, opn, a, b)?;
            next
        }
    }
    inline for (name, sym, opn) in [("BAND", &, ops.O_BAND), ("BOR", |, ops.O_BOR), ("BXOR", ^, ops.O_BXOR)] {
        op #name(dst: reg, a: reg, b: reg) : ABC {
            if let (Int(x), Int(y)) = (a, b) { dst = Int(x sym y); next }
            cold {
                gc_point();
                // Ints that fit an i64 (go's 63-bit Zobrist hashes).
                if let Some(x) = ops.i64_int(a) and let Some(y) = ops.i64_int(b) { dst = value.int_val(&ctx.heap, x sym y); next }
                dst = ops.arith(ctx, opn, a, b)?;
                next
            }
        }
    }
    op NEG(dst: reg, a: reg) : ABC {
        match a {
            Int(x) => if x != -140737488355328 { dst = Int(0 - x); next },
            Float(x) => { dst = Float(-x); next }
            _ => {}
        }
        cold { gc_point(); dst = ops.unary(ctx, ops.U_NEG, a)?; next }
    }
    op POS(dst: reg, a: reg) : ABC { dst = ops.unary(ctx, ops.U_POS, a)?; next }
    op INVERT(dst: reg, a: reg) : ABC {
        if let Int(x) = a { dst = Int(~x); next }
        cold { dst = ops.unary(ctx, ops.U_INVERT, a)?; next }
    }
    op NOT(dst: reg, a: reg) : ABC {
        match a {
            Bool(x) => { dst = Bool(!x); next }
            Nil => { dst = Bool(true); next }
            _ => {}
        }
        cold { dst = Bool(!ops.truthy(ctx, a)?); next }
    }

    // ── comparisons ─────────────────────────────────────────────────

    inline for (name, test, opn) in [
        ("LT", x < y, ops.C_LT), ("LE", x <= y, ops.C_LE), ("GT", x > y, ops.C_GT),
        ("GE", x >= y, ops.C_GE), ("EQ", x == y, ops.C_EQ), ("NE", x != y, ops.C_NE),
    ] {
        op #name(dst: reg, a: reg, b: reg) : ABC {
            match (a, b) {
                (Int(x), Int(y)) => { dst = Bool(test); next }
                (Float(x), Float(y)) => { dst = Bool(test); next }
                _ => {}
            }
            cold {
                match (a, b) {
                    (Int(i), Float(y)) => { let x = i as f64; dst = Bool(test); next }
                    (Float(x), Int(j)) => { let y = j as f64; dst = Bool(test); next }
                    _ => {}
                }
                let q = ops.identity_eq(ctx, opn, a, b);
                if q != 2 { dst = Bool(q == 1); next }
                if let Some(f) = ops.cmp_method(ctx, opn, a, b) {
                    if let Inst(_) = a { call2(f, a, b, dst.raw) }
                    call2(f, b, a, dst.raw)
                }
                dst = ops.compare_value(ctx, opn, a, b)?;
                next
            }
        }
    }
    op IS(dst: reg, a: reg, b: reg) : ABC { dst = Bool(ops.is_same(a, b)); next }
    op ISNOT(dst: reg, a: reg, b: reg) : ABC { dst = Bool(!ops.is_same(a, b)); next }
    op IN(dst: reg, a: reg, b: reg) : ABC {
        let r = ops.contains_fast(b, a);
        if r != 2 { dst = Bool(r == 1); next }
        cold { dst = Bool(ops.contains(ctx, b, a)?); next }
    }
    op NOTIN(dst: reg, a: reg, b: reg) : ABC {
        let r = ops.contains_fast(b, a);
        if r != 2 { dst = Bool(r == 0); next }
        cold { dst = Bool(!ops.contains(ctx, b, a)?); next }
    }

    // ── jumps ───────────────────────────────────────────────────────

    op JMP(target: label) : sJ { jump target }
    op JT(a: reg, target: label) : AsBx {
        match a {
            Bool(x) => { if x { jump target } next }
            Nil => next,
            Int(x) => { if x != 0 { jump target } next }
            _ => {}
        }
        cold { if ops.truthy(ctx, a)? { jump target } next }
    }
    op JF(a: reg, target: label) : AsBx {
        match a {
            Bool(x) => { if !x { jump target } next }
            Nil => jump target,
            Int(x) => { if x == 0 { jump target } next }
            _ => {}
        }
        cold { if !ops.truthy(ctx, a)? { jump target } next }
    }

    /// Compare and branch: followed by a JMP taken when the test fails.
    fn branch(holds: bool, target: *u32) -> never {
        if holds { jump pc + 2 }
        jump target
    }
    // `Py.jn(cmp)` and `Py.jnk(cmp)`: the op that jumps unless compare
    // `cmp` holds, with a register or constant right operand (compile.lm).
    inline for (cmp, kf, test, opn, bkind, rn) in [
        ("LT", "", x < y, ops.C_LT, reg, jn), ("LE", "", x <= y, ops.C_LE, reg, jn),
        ("GT", "", x > y, ops.C_GT, reg, jn), ("GE", "", x >= y, ops.C_GE, reg, jn),
        ("EQ", "", x == y, ops.C_EQ, reg, jn), ("NE", "", x != y, ops.C_NE, reg, jn),
        ("LT", "K", x < y, ops.C_LT, kst, jnk), ("LE", "K", x <= y, ops.C_LE, kst, jnk),
        ("GT", "K", x > y, ops.C_GT, kst, jnk), ("GE", "K", x >= y, ops.C_GE, kst, jnk),
        ("EQ", "K", x == y, ops.C_EQ, kst, jnk), ("NE", "K", x != y, ops.C_NE, kst, jnk),
    ] {
        rel rn(#cmp) = #("JN" ++ cmp ++ kf);
        op #("JN" ++ cmp ++ kf)(a: reg, b: bkind) : ABC then JMP {
            match (a, b) {
                (Int(x), Int(y)) => branch(test, then.target),
                (Float(x), Float(y)) => branch(test, then.target),
                _ => {}
            }
            cold {
                match (a, b) {
                    (Int(i), Float(y)) => { let x = i as f64; branch(test, then.target) }
                    (Float(x), Int(j)) => { let y = j as f64; branch(test, then.target) }
                    _ => {}
                }
                let q = ops.identity_eq(ctx, opn, a, b);
                if q != 2 { branch(q == 1, then.target) }
                branch(ops.compare(ctx, opn, a, b)?, then.target)
            }
        }
    }

    /// `if x is None` / `if x is not None`: skip the JMP when the test holds.
    op JNNONE(a: reg) : ABC then JMP { branch(a == Nil, then.target) }
    op JNSOME(a: reg) : ABC then JMP { branch(a != Nil, then.target) }

    // ── superinstructions (from --vm-stats on the benchmarks) ───────
    supers {
        LOADMETHOD, CALLMETHOD;
        GETATTR, GETATTR;
        #[allow(super_overlap)] GETATTR, GETATTR, MUL;
        MOVE, MOVE, MOVE;
    }

    // ── containers ──────────────────────────────────────────────────

    op GETINDEX(dst: reg, obj: reg, key: reg) : ABC {
        match (obj, key) {
            (List(l), Int(i)) => {
                let n = l.len;
                let j = if i < 0 { (i as i64 + n as i64) as u64 } else { i as u64 };
                if j < n { dst = *(l.arr.items.ptr + j); next }
            }
            (Tuple(t), Int(i)) => {
                let n = t.items.len;
                let j = if i < 0 { (i as i64 + n as i64) as u64 } else { i as u64 };
                if j < n { dst = *(t.items.ptr + j); next }
            }
            _ => {}
        }
        cold {
            if let Inst(o) = obj and let Some(f) = ops.simple_method(ctx, o.cls, ops.DN_GETITEM, 2) { call2(f, obj, key, dst.raw) }
            gc_point();
            dst = ops.getindex(ctx, obj, key)?;
            next
        }
    }
    op SETINDEX(obj: reg, key: reg, src: reg) : ABC {
        if let (List(l), Int(i)) = (obj, key) {
            let n = l.len;
            let j = if i < 0 { (i as i64 + n as i64) as u64 } else { i as u64 };
            if j < n {
                *(l.arr.items.ptr + j) = src;
                gc.write_barrier(&ctx.heap, l.arr as *u8);
                next
            }
        }
        cold { gc_point(); ops.setindex(ctx, obj, key, src)?; next }
    }
    op DELINDEX(obj: reg, key: reg) : ABC { ops.delindex(ctx, obj, key)?; next }
    /// R[dst] = R[obj][R[lo]:R[lo+1]:R[lo+2]]
    #[poll(gc)] op GETSLICE(dst: reg, obj: reg, lo: reg) : ABC {
        dst = ops.getslice(ctx, obj, lo, regs[lo.raw + 1], regs[lo.raw + 2])?;
        next
    }
    #[poll(gc)] op SETSLICE(obj: reg, lo: reg, src: reg) : ABC {
        ops.setslice(ctx, obj, lo, regs[lo.raw + 1], regs[lo.raw + 2], src)?;
        next
    }
    #[poll(gc)] op NEWLIST(dst: reg, base: reg, n: imm) : ABC {
        dst = List(value.list_of(&ctx.heap, (regs + base.raw).slice(n)));
        next
    }
    #[poll(gc)] op NEWTUPLE(dst: reg, base: reg, n: imm) : ABC {
        dst = Tuple(value.tuple_of(&ctx.heap, (regs + base.raw).slice(n)));
        next
    }
    /// R[dst] = {R[base]: R[base+1], ...} (n pairs)
    #[poll(gc)] op NEWDICT(dst: reg, base: reg, n: imm) : ABC {
        let d = value.new_dict(&ctx.heap, n);
        for i in 0..n {
            ops.dict_put(ctx, d, regs[base.raw + 2 * i], regs[base.raw + 2 * i + 1])?;
        }
        dst = Dict(d);
        next
    }
    #[poll(gc)] op NEWSET(dst: reg, base: reg, n: imm) : ABC {
        let s = ops.new_set(ctx, false);
        for i in 0..n { ops.set_add(ctx, s, regs[base.raw + i])?; }
        dst = s;
        next
    }
    op LISTAPPEND(l: reg, v: reg) : ABC {
        let x = l as! List;
        if x.len < x.arr.items.len {
            *(x.arr.items.ptr + x.len) = v;
            x.len += 1;
            gc.write_barrier(&ctx.heap, x.arr as *u8);
            next
        }
        cold {
            gc_point();
            value.list_push(&ctx.heap, x, v);
            next
        }
    }
    /// list.extend for [*a] and f(*a): R[l] must be a list.
    #[poll(gc)] op LISTEXTEND(l: reg, v: reg) : ABC {
        ops.list_extend(ctx, l, v)?;
        next
    }
    op SETADD(s: reg, v: reg) : ABC { gc_point(); ops.set_add(ctx, s, v)?; next }
    #[poll(gc)] op DICTSET(d: reg, key: reg, v: reg) : ABC {
        let x = d as! Dict;
        ops.dict_put(ctx, x, key, v)?;
        next
    }
    #[poll(gc)] op TOTUPLE(dst: reg, src: reg) : ABC {
        let l = src as! List;
        dst = Tuple(value.tuple_of(&ctx.heap, l.arr.items[0..l.len]));
        next
    }
    /// Unpack R[src] into R[base..base+n].
    op UNPACK(base: reg, src: reg, n: imm) : ABC {
        if let Tuple(t) = src and t.items.len == n {
            for i in 0..n { regs[base.raw + i] = t.items[i]; }
            next
        }
        if let List(l) = src and l.len == n {
            for i in 0..n { regs[base.raw + i] = l.arr.items[i]; }
            next
        }
        cold { gc_point(); ops.unpack(ctx, src, regs + base.raw, n, 0xff)?; next }
    }
    /// Starred unpack: n = before | (after << 4); the starred list goes
    /// between them.
    #[poll(gc)] op UNPACKEX(base: reg, src: reg, n: imm) : ABC {
        ops.unpack(ctx, src, regs + base.raw, n & 15, n >> 4)?;
        next
    }

    // ── strings ─────────────────────────────────────────────────────

    /// R[dst] = format(R[v], R[spec]) after conversion `conv` ('r', 's', 'a' or 0);
    /// spec register 255 means no spec.
    #[poll(gc)] op FORMAT(dst: reg, v: reg, spec: imm) : ABC {
        dst = ops.format_field(ctx, v, if spec == 255 { Nil } else { regs[spec] }, 0)?;
        next
    }
    #[poll(gc)] op CONVERT(dst: reg, v: reg, conv: imm) : ABC {
        dst = ops.convert(ctx, v, conv)?;
        next
    }
    #[poll(gc)] op BUILDSTR(dst: reg, base: reg, n: imm) : ABC {
        dst = ops.join_strs(ctx, regs + base.raw, n);
        next
    }

    // ── iteration ───────────────────────────────────────────────────

    #[poll(gc)] op GETITER(dst: reg, src: reg) : ABC {
        match src {
            List(_) | Tuple(_) => {
                let b = value.new_box(&ctx.heap, K_SEQIT, 0);
                b.a = src;
                dst = Obj(b);
                next
            }
            Obj(o) => if o.kind == value.K_RANGE {
                let b = value.new_box(&ctx.heap, K_RANGEIT, 0);
                b.n = o.n; b.m = o.m; b.s = o.s;
                dst = Obj(b);
                next
            } else if o.kind == K_GEN { dst = src; next },
            _ => {}
        }
        cold { dst = ops.getiter(ctx, src)?; next }
    }
    /// Next item of R[it] into R[dst], skipping the JMP; or take the JMP
    /// when the iterator is exhausted.
    op FORITER(dst: reg, it: reg) : ABC then JMP {
        if let Obj(b) = it {
            if b.kind == K_RANGEIT {
                let i = b.n;
                if (b.s > 0 and i < b.m) or (b.s < 0 and i > b.m) {
                    b.n = i + b.s;
                    if i >= -140737488355328 and i <= 140737488355327 { dst = Int(i as i48); jump then_next_pc }
                    cold { dst = value.int_val(&ctx.heap, i); jump then_next_pc }
                }
                jump then.target
            }
            if b.kind == K_SEQIT {
                let i = b.n as u64;
                match b.a {
                    List(l) => { if i < l.len { b.n += 1; dst = *(l.arr.items.ptr + i); jump then_next_pc } jump then.target }
                    Tuple(t) => { if i < t.items.len { b.n += 1; dst = *(t.items.ptr + i); jump then_next_pc } jump then.target }
                    _ => {}
                }
            }
            if b.kind == K_GEN { resume(b, regs + dst.raw, then_next_pc, then.target) }
        }
        cold {
            gc_point();
            match ops.next(ctx, it)? {
                Some(v) => { dst = v; jump then_next_pc }
                None => jump then.target,
            }
        }
    }
    /// `for a, b in it` with two plain locals: the next item of R[it]
    /// unpacked into R[d1] and R[d2], skipping the JMP; or take the JMP
    /// when the iterator is exhausted. enumerate() and zip() of two
    /// lists write the pair without making the tuple.
    op FORITER2(d1: reg, it: reg, d2: reg) : ABC then JMP {
        if let Obj(b) = it {
            if b.kind == K_SEQIT and let List(l) = b.a {
                let i = b.n as u64;
                if i >= l.len { jump then.target }
                if let Tuple(t) = *(l.arr.items.ptr + i) and t.items.len == 2 {
                    b.n += 1;
                    d1 = *t.items.ptr;
                    d2 = *(t.items.ptr + 1);
                    jump then_next_pc
                }
            } else if b.kind == value.K_ENUMIT and let Obj(s) = b.a and s.kind == K_SEQIT and let List(l) = s.a {
                let i = s.n as u64;
                if i >= l.len { jump then.target }
                let n = b.n;
                if n <= 140737488355327 {
                    s.n += 1;
                    b.n = n + 1;
                    d1 = Int(n as i48);
                    d2 = *(l.arr.items.ptr + i);
                    jump then_next_pc
                }
            } else if b.kind == value.K_ZIPIT and let Tuple(its) = b.a and its.items.len == 2
                and let Obj(s1) = *its.items.ptr and s1.kind == K_SEQIT and let List(l1) = s1.a
                and let Obj(s2) = *(its.items.ptr + 1) and s2.kind == K_SEQIT and let List(l2) = s2.a {
                let i = s1.n as u64;
                if i >= l1.len { jump then.target }
                s1.n += 1;
                let j = s2.n as u64;
                if j >= l2.len { jump then.target }
                s2.n += 1;
                d1 = *(l1.arr.items.ptr + i);
                d2 = *(l2.arr.items.ptr + j);
                jump then_next_pc
            }
        }
        cold {
            gc_point();
            match ops.next(ctx, it)? {
                Some(v) => {
                    if let Tuple(t) = v and t.items.len == 2 { d1 = t.items[0]; d2 = t.items[1]; jump then_next_pc }
                    let (x, y) = ops.unpack2(ctx, v)?;
                    d1 = x;
                    d2 = y;
                    jump then_next_pc
                }
                None => jump then.target,
            }
        }
    }
    /// R[dst] = (yield R[val]): suspend the generator.
    op YIELD(dst: reg, val: reg) : ABC {
        let v = val;
        let g = fp.gen as! Obj;
        let f = fp.func as! Func;
        let p = f.proto;
        let saved = g.extra.ptr;
        for i in 0..p.nregs as u64 { saved[i] = regs[i]; }
        gc.write_barrier(&ctx.heap, g as *u8);
        g.n = p.code.index_of(next_pc) as i64;
        g.s = dst.raw as i64;
        g.m = GEN_SUSPENDED;
        if (fp.flags & F_BASE) != 0 { exit Ok(v) }
        *fp.ret_slot = v;
        let r = fp.ret_pc;
        fp = fp - 1;
        regs = fp.base;
        k = fp.k;
        jump r
    }

    // ── functions, classes, exceptions ──────────────────────────────

    /// R[dst] = a function of prototype `p`; its defaults are in
    /// R[dst+1 ..] (the prototype says how many), then its kw-only
    /// defaults as a dict or None.
    #[poll(gc)] op MAKEFUNC(dst: reg, p: pidx) : ABx {
        dst = ops.make_func(ctx, fp.func, ctx.protos.at(p), regs, dst.raw)?;
        next
    }
    /// R[dst] = class named R[base] with bases tuple R[base+1] and
    /// namespace R[base+2]; its methods set `hint` attributes on self.
    #[poll(gc)] op BUILDCLASS(dst: reg, base: reg, hint: imm) : ABC {
        dst = ops.build_class(ctx, base, regs[base.raw + 1], regs[base.raw + 2], hint as u64)?;
        next
    }
    #[poll(gc)] op RAISE(e: reg) : ABC {
        let x = ops.make_exc(ctx, e)?;
        raise x
    }
    op RERAISE(e: reg) : ABC { raise e }
    /// R[dst] = isinstance(R[e], R[cls]) for an except clause.
    op EXCMATCH(dst: reg, e: reg, cls: reg) : ABC {
        dst = Bool(ops.exc_match(ctx, e, cls)?);
        next
    }
    #[poll(gc)] op SUPER(dst: reg, selfv: reg) : ABC {
        dst = ops.make_super(ctx, fp.func, selfv)?;
        next
    }
    #[poll(gc)] op IMPORT(dst: reg, name: kst) : ABx {
        dst = builtins.import_module(ctx, name)?;
        next
    }
    op NOP() : ABC { next }
    /// R[dst] = the return value of generator R[it] (None for other
    /// iterators), after `yield from` exhausted it.
    op GENRESULT(dst: reg, it: reg) : ABC {
        if let Obj(g) = it and g.kind == K_GEN { dst = g.b; g.b = Nil; next }
        dst = Nil;
        next
    }

    entry call(c: *Ctx, at: *Frame, code: *u32) -> Result<Value, Value> uses reenter {
        ctx = c;
        fp = at;
        regs = at.base;
        k = at.k;
        #[cfg(debug)] if debugger.stepping() { use_variant step; } jump code
    }

    on raise(e: Value) {
        loop {
            let p = fp.proto;
            if ctx.err_line == 0 { ctx.err_line = line_of(p, pc); }
            let start = p.code.start();
            let off = p.code.index_of(pc) as u32;
            for i in 0..p.handlers.len {
                let h = p.handlers[i];
                if off >= h.start and off < h.end {
                    regs[h.reg as u64] = e;
                    ctx.err_line = 0;
                    jump (start + h.target as u64)
                }
            }
            let fl = fp.flags;
            if (fl & F_GEN) != 0 { if let Obj(g) = fp.gen { g.m = GEN_DONE; } }
            if (fl & F_BASE) != 0 { exit Err(e) }
            pc = fp.ret_pc - 1;
            fp = fp - 1;
            regs = fp.base;
            k = fp.k;
        }
    }

    // --cfg debug: the debugger (see the end of this file).
    #[cfg(debug)] on break { debugger.on_break(ctx, pc, fp); use_variant step; jump pc }
    #[cfg(debug)] #[unfused] variant step wraps all {
        before { if !debugger.on_step(ctx, pc, fp) { use_variant default; } }
    }
}

/// Number of prototypes, for the verifier (set before verification).
pub var NPROTOS: u64 = 0;
fn ctx_protos_len() -> u64 { NPROTOS }

/// Call `f` with `args` from host code, as a nested run above the
/// current frame.
pub fn invoke(c: *Ctx, f: Value, args: []Value) -> Result<Value, Value> uses reenter {
    let caller = c.fp;
    let top = caller.base + caller.proto.nregs as u64;
    // top[0] holds the callee; arguments follow.
    let need = top + args.len + 2;
    if need > c.stack_end { return Err(ops.exc(c, builtins.Exc.RecursionError, "maximum recursion depth exceeded")); }
    if need > c.hw { c.hw = need; }
    top[0] = f;
    for i in 0..args.len { top[1 + i] = args[i]; }
    invoke_at(c, top, args.len, Value.Nil)
}

/// Call the callee at `top[0]` with the `n` arguments after it.
pub fn invoke_at(c: *Ctx, top: *Value, n: u64, kw: Value) -> Result<Value, Value> uses reenter {
    builtins.count(builtins.CNT_INVOKE);
    let caller = c.fp;
    if caller + 2 >= c.frames_end or c.vm_depth > 180 or ops.stack_low(c) {
        return Err(ops.exc(c, builtins.Exc.RecursionError, "maximum recursion depth exceeded"));
    }
    let f0 = top[0];
    match f0 {
        Func(f) => {
            let p = f.proto;
            let win = top + 1;
            let need = win + p.nregs as u64 + 1;
            if need > c.stack_end { return Err(ops.exc(c, builtins.Exc.RecursionError, "maximum recursion depth exceeded")); }
            if need > c.hw { c.hw = need; }
            if p.simple != n as u32 or kw != Value.Nil {
                ops.bind_args(c, f, win, n, kw)?;
            }
            if (p.flags & P_GEN) != 0 { return Ok(ops.make_gen(c, f, win)); }
            let nf = caller + 1;
            nf.func = f0;
            nf.gen = Value.Nil;
            nf.base = win;
            nf.k = p.consts.ptr;
            nf.proto = p;
            nf.ret_pc = 0 as *u32;
            nf.ret_slot = top;
            nf.flags = F_BASE;
            c.vm_depth += 1;
            let r = Py.call(c, nf, p.code.start());
            c.vm_depth -= 1; #[cfg(debug)] debugger.left(c, nf); // --cfg debug: frame nf's run ended (a stepping command in it moves to its caller)
            c.fp = caller;
            r
        }
        Builtin(id) => builtins.call(c, id, top + 1, n, kw),
        _ => {
            // Classes, bound methods, callable instances: through a CALL
            // instruction of a tiny trampoline.
            ops.call_generic(c, top, n, kw)
        }
    }
}

/// Resume generator `g` from host code: Ok(Some(v)) for a yielded value,
/// Ok(None) when it finished.
pub fn gen_next(c: *Ctx, g: Gc<Box>, send: Value) -> Result<?Value, Value> uses reenter {
    gen_resume(c, g, send, Value.Nil)
}

/// gen.throw(e) / gen.close(): raise `e` in the generator where it is
/// suspended (its handlers run), or right away if it has not started
/// or has finished.
pub fn gen_throw(c: *Ctx, g: Gc<Box>, e: Value) -> Result<?Value, Value> uses reenter {
    if g.m == GEN_RUNNING { return Err(ops.exc(c, builtins.Exc.ValueError, "generator already executing")); }
    if g.m != GEN_SUSPENDED { g.m = GEN_DONE; return Err(e); }
    gen_resume(c, g, Value.Nil, e)
}

fn gen_resume(c: *Ctx, g: Gc<Box>, send: Value, throw: Value) -> Result<?Value, Value> uses reenter {
    builtins.count(builtins.CNT_GENNEXT);
    if g.m == GEN_DONE { return Ok(None); }
    if g.m == GEN_RUNNING { return Err(ops.exc(c, builtins.Exc.ValueError, "generator already executing")); }
    let caller = c.fp;
    if caller + 2 >= c.frames_end or c.vm_depth > 180 or ops.stack_low(c) {
        return Err(ops.exc(c, builtins.Exc.RecursionError, "maximum recursion depth exceeded"));
    }
    let f = g.a as! Func;
    let p = f.proto;
    let win = caller.base + caller.proto.nregs as u64;
    let need = win + p.nregs as u64 + 1;
    if need > c.stack_end { return Err(ops.exc(c, builtins.Exc.RecursionError, "maximum recursion depth exceeded")); }
    if need > c.hw { c.hw = need; }
    for i in 0..p.nregs as u64 { win[i] = g.extra[i]; }
    var at = g.n as u64;
    if throw != Value.Nil {
        // The handler around the YIELD (the word before the resume point).
        let off = (g.n - 1) as u32;
        var found = false;
        for i in 0..p.handlers.len {
            let h = p.handlers[i];
            if off >= h.start and off < h.end {
                win[h.reg as u64] = throw;
                at = h.target as u64;
                found = true;
                break;
            }
        }
        if !found { g.m = GEN_DONE; return Err(throw); }
    } else if g.m == GEN_SUSPENDED { win[g.s as u64] = send; }
    g.m = GEN_RUNNING;
    let nf = caller + 1;
    nf.func = g.a;
    nf.gen = Value.Obj(g);
    nf.base = win;
    nf.k = p.consts.ptr;
    nf.proto = p;
    nf.ret_pc = 0 as *u32;
    nf.ret_slot = win;
    nf.flags = F_GEN | F_BASE;
    c.gen_done = false;
    c.vm_depth += 1;
    let r = Py.call(c, nf, p.code.start() + at);
    c.vm_depth -= 1; #[cfg(debug)] debugger.left(c, nf);
    c.fp = caller;
    match r {
        Ok(v) => {
            if c.gen_done { c.gen_done = false; return Ok(None); }
            Ok(Some(v))
        }
        Err(e) => Err(e),
    }
}

// --cfg debug: the debugger (debugger.lm, docs/design/debugging.md), on
// the line that ends the vm above. A breakpoint stops, puts its
// instruction back and runs it under `step`, whose wrapper sets the
// breakpoint again before the next instruction and stops there if a
// stepping command says so (and turns itself off when neither waits).
// `#[unfused]`: under `step`, supers run as their parts, so the first
// instruction of every line is seen. Runs that start or continue while
// stepping (`call`, and `reload` after a native) turn `step` on; `sync`
// saves where a frame calling a native is (`Frame.at`) for backtraces;
// `invoke_at` and `gen_next` tell the stepper when a nested run's frame
// has left. (All of it sits on existing lines, so that a build without
// `--cfg debug` keeps its source positions in panic messages.)
