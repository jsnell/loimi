// Values and heap objects of the Python subset.
import std.gc;
import std.mem;
import std.text;
import std.hash;
import std.num;
import std.dict;
import std.bigint;
import big;
import vm.{Proto};

/// A string: bytes plus a cached hash (0: not computed yet).
pub object Str { hash: u64, data: [u8] }
/// Backing store of a list.
pub object Arr { items: [Value] }
pub object List { len: u64, arr: Gc<Arr> }
pub object Tuple { items: [Value] }
/// An insertion-ordered dict: std.dict's (CPython's compact layout).
/// Entry numbers are stable until a resize, which bumps `version`.
pub type Dict = dict.Dict<Value, Value>;
/// An instance of a user class (exceptions too). Its attributes are
/// values in `slots`, in the order they were added; the names are in its
/// *shape* `keys` (a `K_SHAPE` box: `keys.extra[i]` is the name of
/// `slots[i]`). Instances that add the same names in the same order share
/// a shape, so a cache entry "slot i" is checked by comparing one name.
/// The slot count is fixed at allocation (`ops.new_inst`). An instance
/// with more attributes than slots keeps the last slot's value and the
/// rest in a tuple in the last slot (`inst_at`). One that deletes an
/// attribute, has its `__dict__` taken or more than ops.MAX_SLOTS
/// attributes goes to *dict mode*: shape `Ctx.shape_dict` (no names, so
/// no cache hits) and its attributes in a `Dict` in `slots[0]` (see
/// `inst_dictmode`).
pub object Inst { cls: Gc<Box>, keys: Gc<Box>, slots: [Value] }
pub object Func {
    proto: *Proto,
    defaults: ?Gc<Tuple>,
    kwdefaults: ?Gc<Dict>,
    cells: ?Gc<Tuple>,
    globals: Gc<Dict>,
    /// The class whose body defined it (for `super()`).
    owner: ?Gc<Box>,
}
/// A big integer's limbs and sign (std.bigint's GC object; `Long.s`
/// repeats the sign).
pub type Limbs = bigint.Big;
/// Every other kind of object: classes, bound methods, iterators,
/// generators, sets, modules, ...
pub object Box {
    kind: u32,
    id: u32,
    n: i64,
    m: i64,
    s: i64,
    a: Value,
    b: Value,
    c: Value,
    dict: ?Gc<Dict>,
    base: ?Gc<Box>,
    extra: [Value],
}

/// A closure cell (MAKECELL, LOADCELL, ...).
pub object Cell { v: Value }
/// An int outside the i48 range of `Int`: a *medium* one (fits an i64)
/// has `big` None and the number in `n`; a big one has `big` the limbs.
/// `s` is the sign (1 or -1) in both.
pub object Long { n: i64, s: i64, big: ?Gc<Limbs> }

/// The hot variants first, in whole 48-bit blocks; the rest share one
/// (`block 45`: told apart by the low 3 bits of the pointer).
pub value Value repr nanbox {
    Float(f64) unboxed,
    Int(i48),
    Nil block 0,
    /// An unbound local, a deleted dict entry, "no self" in LOADMETHOD.
    Undef block 0,
    Bool(bool) block 1,
    Builtin(u32) block 32,
    Str(Gc<Str>),
    List(Gc<List>),
    Tuple(Gc<Tuple>),
    Inst(Gc<Inst>),
    Func(Gc<Func>),
    Dict(Gc<Dict>) block 45,
    Obj(Gc<Box>) block 45,
    Cell(Gc<Cell>) block 45,
    Long(Gc<Long>) block 45,
}

// Box kinds.
pub const K_CLASS: u32 = 1;
pub const K_BOUND: u32 = 2;
// 3 was K_BIG (now `Long`).
pub const K_RANGE: u32 = 4;
pub const K_RANGEIT: u32 = 5;
pub const K_SEQIT: u32 = 6;
pub const K_DICTIT: u32 = 7;
pub const K_GEN: u32 = 8;
// 9 was K_CELL (now `Cell`).
pub const K_SUPER: u32 = 10;
pub const K_PROPERTY: u32 = 11;
pub const K_STATICM: u32 = 12;
pub const K_CLASSM: u32 = 13;
pub const K_SET: u32 = 14;
pub const K_MODULE: u32 = 15;
pub const K_SLICE: u32 = 16;
pub const K_ENUMIT: u32 = 17;
pub const K_ZIPIT: u32 = 18;
pub const K_MAPIT: u32 = 19;
pub const K_FILTERIT: u32 = 20;
pub const K_DICTVIEW: u32 = 21;
pub const K_REVIT: u32 = 22;
pub const K_NOTIMPL: u32 = 23;
pub const K_FROZENSET: u32 = 24;
/// An instance shape (value.Inst): `extra` the names, `base` the parent
/// shape, `c` the last child taken (or Nil), `dict` name -> child, `m` the
/// number of children; `n` is 1 for the dict-mode shape. Each tree of
/// shapes is for instances with one slot count, `b` (an Int): `s` is how
/// many of the names are in the slots of the same number (all of them,
/// or one less than the slot count once they overflow, see `inst_at`).
pub const K_SHAPE: u32 = 25;

// Generator states (Box.m).
pub const GEN_NEW: i64 = 0;
pub const GEN_SUSPENDED: i64 = 1;
pub const GEN_RUNNING: i64 = 2;
pub const GEN_DONE: i64 = 3;

pub fn Value.hash(v: Value) -> u64 { hash.mix(v as u64) }
pub fn Value.eq(a: Value, b: Value) -> bool { a == b }
impl hash.Hash for Value;

// ── strings ─────────────────────────────────────────────────────────

pub fn new_str(h: *gc.Heap, s: str) -> Gc<Str> {
    let o = new(h, Str { hash: 0 }, s.len);
    mem.copy(o.data.ptr, s.ptr, s.len);
    o
}

pub fn str_hash(s: Gc<Str>) -> u64 {
    if s.hash != 0 { return s.hash; }
    let hv = hash.bytes(s.data) | 1;
    s.hash = hv;
    hv
}

pub fn str_eq(a: Gc<Str>, b: Gc<Str>) -> bool {
    if (a as u64) == (b as u64) { return true; }
    if a.data.len != b.data.len { return false; }
    if a.hash != 0 and b.hash != 0 and a.hash != b.hash { return false; }
    mem.equal_bytes(a.data, b.data)
}

pub fn sv(s: Gc<Str>) -> str { s.data }

// ── lists and tuples ────────────────────────────────────────────────

pub fn new_list(h: *gc.Heap, cap: u64) -> Gc<List> {
    let c = if cap < 4 { 4 } else { cap };
    let a = new(h, Arr {}, c);
    for i in 0..c { a.items[i] = Value.Nil; }
    new(h, List { len: 0, arr: a })
}

/// A list of length `n` whose items the caller stores (they are zero
/// bits, Float 0.0, until then; also past `n`, never read).
pub fn new_list_n(h: *gc.Heap, n: u64) -> Gc<List> {
    let a = new(h, Arr {}, if n < 4 { 4 } else { n });
    new(h, List { len: n, arr: a })
}

pub fn list_push(h: *gc.Heap, l: Gc<List>, v: Value) {
    if l.len == l.arr.items.len { list_grow(h, l, l.len + 1); }
    l.arr.items[l.len] = v;
    l.len += 1;
}

pub fn list_grow(h: *gc.Heap, l: Gc<List>, need: u64) {
    var c = l.arr.items.len * 2;
    if c < need { c = need; }
    if c < 4 { c = 4; }
    let a = new(h, Arr {}, c);
    // Raw copies into the new array (the rest stays zero bits, never read).
    let src = l.arr.items.ptr;
    let dst = a.items.ptr;
    for i in 0..l.len { *(dst + i) = *(src + i); }
    l.arr = a;
    gc.write_barrier(h, a as *u8);
}

/// Item `i` of a list or tuple, if it has one now.
pub fn seq_at(v: Value, i: u64) -> ?Value {
    match v {
        List(l) => if i < l.len { Some(l.arr.items[i]) } else { None },
        Tuple(t) => if i < t.items.len { Some(t.items[i]) } else { None },
        _ => None,
    }
}

/// The length of a list or tuple (0 for anything else).
pub fn seq_len(v: Value) -> u64 {
    match v {
        List(l) => l.len,
        Tuple(t) => t.items.len,
        _ => 0,
    }
}

pub fn new_tuple(h: *gc.Heap, n: u64) -> Gc<Tuple> {
    let t = new(h, Tuple {}, n);
    for i in 0..n { t.items[i] = Value.Nil; }
    t
}

pub fn tuple_of(h: *gc.Heap, xs: []Value) -> Gc<Tuple> {
    let t = new(h, Tuple {}, xs.len);
    for i in 0..xs.len { t.items[i] = xs[i]; }
    t
}

pub fn list_of(h: *gc.Heap, xs: []Value) -> Gc<List> {
    let l = new_list(h, xs.len);
    for i in 0..xs.len { l.arr.items[i] = xs[i]; }
    l.len = xs.len;
    l
}

// ── boxes ───────────────────────────────────────────────────────────

pub fn new_box(h: *gc.Heap, kind: u32, n: u64) -> Gc<Box> {
    let b = new(h, Box { kind: kind, id: 0, n: 0, m: 0, s: 0, a: Value.Nil, b: Value.Nil, c: Value.Nil,
                         dict: None, base: None }, n);
    for i in 0..n { b.extra[i] = Value.Nil; }
    b
}

pub fn is_kind(v: Value, k: u32) -> bool {
    if let Obj(b) = v { return b.kind == k; }
    false
}

// ── dicts ───────────────────────────────────────────────────────────

pub fn new_dict(h: *gc.Heap, n: u64) -> Gc<Dict> { Dict.new(h, n) }

/// Hash for builtin key types; None for unhashable values and for
/// instances (which hash by identity: the caller decides).
pub fn hash_of(v: Value) -> ?u64 {
    match v {
        Str(s) => Some(str_hash(s)),
        Int(i) => Some(hash_int(i as i64)),
        Bool(b) => Some(if b { 1 } else { 0 }),
        Nil => Some(0x5ca1ab1e),
        Float(f) => {
            if let Some(i) = num.to_i64_exact(f) { return Some(hash_int(i)); }
            Some(hash.mix(f.to_bits()))
        }
        Tuple(t) => hash_tuple(t, 0),
        List(_) => None,
        Dict(_) => None,
        Long(b) => Some(big_hash(b)),
        Obj(b) => {
            if b.kind == K_SET { return None; }
            if b.kind == K_FROZENSET { return Some(0xf205e7 ^ (b.dict.unwrap().len)); }
            Some(hash.mix(v as u64))
        }
        _ => Some(hash.mix(v as u64)),
    }
}

/// Tuples nested deeper than this are unhashable (ops.hash_key raises
/// RecursionError for them), which bounds the recursion.
pub const HASH_DEPTH: u64 = 10000;

fn hash_tuple(t: Gc<Tuple>, depth: u64) -> ?u64 {
    if depth >= HASH_DEPTH { return None; }
    var hv: u64 = 0x345678;
    for i in 0..t.items.len {
        let v = t.items[i];
        let x = if let Tuple(u) = v { hash_tuple(u, depth + 1)? } else { hash_of(v)? };
        hv = (hv ^ x) *% 1000003 +% (i as u64);
    }
    Some(hv)
}

/// Why hash_of(v) is None: Ok(the first unhashable item, v itself or an
/// item of a tuple), Err when tuples nest past HASH_DEPTH.
pub fn unhashable_part(v: Value, depth: u64) -> Result<?Value, ()> {
    let Tuple(t) = v else { return Ok(if hash_of(v).is_none() { Some(v) } else { None }); };
    if depth >= HASH_DEPTH { return Err(()); }
    for i in 0..t.items.len {
        if let Some(x) = unhashable_part(t.items[i], depth + 1)? { return Ok(Some(x)); }
    }
    Ok(None)
}

/// CPython's hash of an int (n mod 2^61 - 1, with its sign; -1 is -2).
pub fn hash_int(i: i64) -> u64 {
    if i == -1 { return 0xfffffffffffffffe; }
    if i > -2305843009213693951 and i < 2305843009213693951 { return i as u64; }
    bigint.hash_i64(i) as u64
}

fn big_hash(b: Gc<Long>) -> u64 {
    if let Some(l) = b.big { return bigint.hash_py(l.num()) as u64; }
    hash_int(b.n)
}

/// Equality of builtin values without calling guest code. Instances
/// compare by identity.
pub fn eq_builtin(a: Value, b: Value) -> bool {
    if a == b {
        if let Float(f) = a { return f == f; }
        return true;
    }
    match (a, b) {
        (Str(x), Str(y)) => str_eq(x, y),
        (Int(x), Float(y)) => (x as f64) == y,
        (Float(x), Int(y)) => x == (y as f64),
        (Float(x), Float(y)) => x == y,
        (Bool(x), Int(y)) => (if x { 1 } else { 0 }) == (y as i64),
        (Int(x), Bool(y)) => (x as i64) == (if y { 1 } else { 0 }),
        (Tuple(x), Tuple(y)) => {
            if x.items.len != y.items.len { return false; }
            for i in 0..x.items.len { if !eq_builtin(x.items[i], y.items[i]) { return false; } }
            true
        }
        (List(x), List(y)) => {
            if x.len != y.len { return false; }
            for i in 0..x.len { if !eq_builtin(x.arr.items[i], y.arr.items[i]) { return false; } }
            true
        }
        (Dict(x), Dict(y)) => {
            if x.len != y.len { return false; }
            var i: u64 = 0;
            while let Some(e) = x.next(&i) {
                let Some(v) = dict_get(y, x.key(e), x.hash_at(e)) else { return false; };
                if !eq_builtin(x.value(e), v) { return false; }
            }
            true
        }
        (Long(x), Long(y)) => big.cmp_long(x, y) == 0,
        (Obj(x), Obj(y)) => {
            if (x.kind == K_SET or x.kind == K_FROZENSET) and (y.kind == K_SET or y.kind == K_FROZENSET) {
                let dx = x.dict.unwrap();
                let dy = y.dict.unwrap();
                if dx.len != dy.len { return false; }
                var i: u64 = 0;
                while let Some(e) = dx.next(&i) {
                    if dict_get(dy, dx.key(e), dx.hash_at(e)).is_none() { return false; }
                }
                return true;
            }
            false
        }
        (Long(x), Float(y)) => big.to_f64(x) == y,
        (Float(x), Long(y)) => big.to_f64(y) == x,
        _ => false,
    }
}

/// Entry number of `key` in `d`, if present.
pub fn dict_find(d: Gc<Dict>, key: Value, hv: u64) -> ?u64 {
    d.find_by(hv, |k| k == key or eq_builtin(k, key))
}

/// Fast path for interned attribute names: pointer comparison first.
#[inline]
pub fn dict_find_str(d: Gc<Dict>, key: Gc<Str>) -> ?u64 {
    let kv = Value.Str(key);
    d.find_by(str_hash(key), |k| -> bool {
        if k == kv { return true; }
        if let Str(ks) = k { return str_eq(ks, key); }
        false
    })
}

/// Append `key` (an interned name with its hash computed) with `v` if it
/// is not present and the dict has room; false (nothing done) otherwise.
pub fn dict_append_new(d: Gc<Dict>, key: Gc<Str>, v: Value) -> bool {
    let hv = key.hash;
    if hv == 0 { return false; }
    let kv = Value.Str(key);
    d.try_add_by(hv, kv, v, |k| -> bool {
        if k == kv { return true; }
        if let Str(ks) = k { return str_eq(ks, key); }
        false
    }).is_some()
}

pub fn dict_get(d: Gc<Dict>, key: Value, hv: u64) -> ?Value {
    let Some(e) = dict_find(d, key, hv) else { return None; };
    Some(d.value(e))
}

pub fn dict_get_str(d: Gc<Dict>, key: Gc<Str>) -> ?Value {
    let Some(e) = dict_find_str(d, key) else { return None; };
    Some(d.value(e))
}

pub fn dict_set(h: *gc.Heap, d: Gc<Dict>, key: Value, hv: u64, v: Value) {
    d.put_by(h, hv, key, v, |k| k == key or eq_builtin(k, key));
}

pub fn dict_set_str(h: *gc.Heap, d: Gc<Dict>, key: Gc<Str>, v: Value) {
    let kv = Value.Str(key);
    d.put_by(h, str_hash(key), kv, v, |k| -> bool {
        if k == kv { return true; }
        if let Str(ks) = k { return str_eq(ks, key); }
        false
    });
}

pub fn dict_del(d: Gc<Dict>, key: Value, hv: u64) -> bool {
    let Some(e) = dict_find(d, key, hv) else { return false; };
    d.remove_at(e);
    true
}

pub fn dict_clear(h: *gc.Heap, d: Gc<Dict>) { d.clear(); }

pub fn dict_copy(h: *gc.Heap, d: Gc<Dict>) -> Gc<Dict> { d.copy(h) }

/// Next live entry at or after `*i`.
pub fn dict_next(d: Gc<Dict>, i: *u64) -> ?u64 { d.next(i) }

pub fn dict_key(d: Gc<Dict>, e: u64) -> Value { d.key(e) }
pub fn dict_val(d: Gc<Dict>, e: u64) -> Value { d.value(e) }

// Instance attributes (see `Inst`).

/// The slot of attribute `key` in a (non dict-mode) instance.
#[inline]
pub fn inst_slot(o: Gc<Inst>, key: Gc<Str>) -> ?u64 {
    let k = o.keys;
    let kv = Value.Str(key);
    for i in 0..k.extra.len { if k.extra[i] == kv { return Some(i); } }
    for i in 0..k.extra.len {
        if let Str(ks) = k.extra[i] and str_eq(ks, key) { return Some(i); }
    }
    None
}

/// The attributes of a dict-mode instance.
#[inline]
pub fn inst_dictmode(o: Gc<Inst>) -> ?Gc<Dict> {
    if o.keys.n != 1 { return None; }
    let Dict(d) = o.slots[0] else { return None; };
    Some(d)
}

/// Attribute number `i` of a (non dict-mode) instance, i < its count:
/// `slots[i]`, unless the attributes overflowed the slots and i is the
/// last slot or past it: then item `i - (slots - 1)` of the tuple there.
#[inline]
pub fn inst_at(o: Gc<Inst>, i: u64) -> Value {
    let cap = o.slots.len;
    if i + 1 < cap or o.keys.extra.len <= cap { return o.slots[i]; }
    let Tuple(t) = o.slots[cap - 1] else { trap() };
    t.items[i - (cap - 1)]
}

/// Set attribute number `i` (see `inst_at`).
#[inline]
pub fn inst_set_at(o: Gc<Inst>, i: u64, v: Value) {
    let cap = o.slots.len;
    if i + 1 < cap or o.keys.extra.len <= cap { o.slots[i] = v; return; }
    let Tuple(t) = o.slots[cap - 1] else { trap() };
    t.items[i - (cap - 1)] = v;
}

pub fn inst_get(o: Gc<Inst>, key: Gc<Str>) -> ?Value {
    if let Some(i) = inst_slot(o, key) { return Some(inst_at(o, i)); }
    if let Some(d) = inst_dictmode(o) { return dict_get_str(d, key); }
    None
}

/// The attributes as a new `Dict`, in order.
pub fn inst_attrs_dict(h: *gc.Heap, o: Gc<Inst>) -> Gc<Dict> {
    let n = o.keys.extra.len;
    let r: Gc<Dict> = Dict.new(h, n);
    for i in 0..n {
        let Str(k) = o.keys.extra[i] else { trap() };
        r.insert_new(h, str_hash(k), Value.Str(k), inst_at(o, i));
    }
    r
}

// ── numbers ─────────────────────────────────────────────────────────

/// An integer value from an i64: small ones as Int, others as big ints.
pub fn int_val(h: *gc.Heap, x: i64) -> Value {
    if x >= -140737488355328 and x <= 140737488355327 { return Value.Int(x as i48); }
    Value.Long(big.from_i64(h, x))
}

/// The integer in `v` as an i64, if it is an int (or bool) that fits.
pub fn as_i64(v: Value) -> ?i64 {
    match v {
        Int(i) => Some(i as i64),
        Bool(b) => Some(if b { 1 } else { 0 }),
        Long(b) => big.to_i64(b),
        _ => None,
    }
}

pub fn is_int(v: Value) -> bool {
    match v {
        Int(_) => true,
        Bool(_) => true,
        Long(_) => true,
        _ => false,
    }
}

pub fn is_num(v: Value) -> bool {
    if let Float(_) = v { return true; }
    is_int(v)
}

pub fn to_f64(v: Value) -> ?f64 {
    match v {
        Float(f) => Some(f),
        Int(i) => Some(i as f64),
        Bool(b) => Some(if b { 1.0 } else { 0.0 }),
        Long(b) => Some(big.to_f64(b)),
        _ => None,
    }
}

pub fn write_float(b: *text.StrBuf, f: f64) {
    if f != f { b.push_str("nan"); return; }
    if f == 1.0 / 0.0 { b.push_str("inf"); return; }
    if f == -1.0 / 0.0 { b.push_str("-inf"); return; }
    if f >= 1e16 or f <= -1e16 {
        // std's write_shortest keeps 17-digit integers (2**31 + 1e16) in
        // fixed notation; Python's repr uses an exponent from 1e16 on.
        var t = text.StrBuf.new();
        num.write_shortest(&t, f);
        let s = t.as_str();
        var has_e = false;
        for i in 0..s.len { if s[i] == 'e' { has_e = true; } }
        if has_e { b.push_str(s); t.free(); return; }
        var d: u64 = 0;
        if s[0] == '-' { b.push('-'); d = 1; }
        let exp = s.len - d - 1;
        var end = s.len;
        while end > d + 1 and s[end - 1] == '0' { end -= 1; }
        b.push(s[d]);
        if end > d + 1 { b.push('.'); b.push_str(s[d + 1..end]); }
        b.push_str("e+");
        b.push_int(exp as i64);
        t.free();
        return;
    }
    let start = b.len();
    num.write_shortest(b, f);
    // Python writes 1e+16 for 1e16, and 1e-05 for 0.00001.
    let s = b.as_str();
    var has_e = false;
    for i in start..s.len { if s[i] == 'e' { has_e = true; } }
    if !has_e { num.mark_float(b, start); }
}
