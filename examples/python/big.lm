// Python ints beyond i48, on std.bigint. Values that fit an i48 are
// always `Int`; the rest are `Long`s: a *medium* int (fits an i64) has
// `big` None and the number in `n`; a big one has `big` a std.bigint
// `Big` (limbs and sign). `s` is the sign (1 or -1) in both. Every
// result is normalized to the smallest of the three forms.
import std.gc;
import std.mem;
import std.text;
import std.bigint;
import std.bigint.{Num, Arg, Big};
import value;
import value.{Value, Long};

/// An operand for std.bigint: small (an i64) or the limbs of a big int.
fn arg(v: Value) -> Arg {
    match v {
        Int(i) => Arg.Small(i as i64),
        Bool(b) => Arg.Small(b as i64),
        Long(b) => match b.big { Some(l) => Arg.Ref(l), None => Arg.Small(b.n) },
        _ => Arg.Small(0),
    }
}

/// The view of an int value; `buf` holds the limb of a small one.
fn view(v: Value, buf: *u64) -> Num { arg(v).num(buf) }

/// A std.bigint result as a value: Int, medium or big.
fn finish(h: *gc.Heap, l: Gc<Big>) -> Value {
    if let Some(x) = bigint.to_i64(l.num()) { return value.int_val(h, x); }
    Value.Long(new(h, Long { n: 0, s: if l.neg { -1 } else { 1 }, big: Some(l) }))
}

/// A medium `Long` (an int outside the i48 range that fits an i64, or
/// any i64 as an operand): no limbs, `n` holds it.
pub fn from_i64(h: *gc.Heap, x: i64) -> Gc<Long> {
    new(h, Long { n: x, s: if x < 0 { -1 } else { 1 }, big: None })
}

pub fn to_i64(b: Gc<Long>) -> ?i64 {
    match b.big { Some(l) => bigint.to_i64(l.num()), None => Some(b.n) }
}

/// The nearest float (correctly rounded); inf when out of range.
pub fn to_f64(b: Gc<Long>) -> f64 {
    match b.big { Some(l) => bigint.to_f64(l.num()), None => b.n as f64 }
}

/// An int from a float (truncating), or None for inf/nan.
pub fn from_f64(h: *gc.Heap, f: f64) -> ?Value {
    if f != f or f == 1.0 / 0.0 or f == -1.0 / 0.0 { return None; }
    let t = f.trunc();
    if t >= -9.0e18 and t <= 9.0e18 { return Some(value.int_val(h, t as i64)); }
    let l = bigint.gc_from_f64(h, f).unwrap();
    Some(finish(h, l))
}

pub fn add(h: *gc.Heap, a: Value, b: Value) -> Value { finish(h, bigint.gc_add(h, arg(a), arg(b))) }
pub fn sub(h: *gc.Heap, a: Value, b: Value) -> Value { finish(h, bigint.gc_sub(h, arg(a), arg(b))) }
pub fn mul(h: *gc.Heap, a: Value, b: Value) -> Value { finish(h, bigint.gc_mul(h, arg(a), arg(b))) }
pub fn neg(h: *gc.Heap, a: Value) -> Value { finish(h, bigint.gc_neg(h, arg(a))) }

pub fn abs(h: *gc.Heap, a: Value) -> Value {
    if is_neg(a) { neg(h, a) } else { a }
}

/// Floor division and modulo; None on division by zero.
pub fn divmod(h: *gc.Heap, a: Value, b: Value) -> ?(Value, Value) {
    let Some((q, r)) = bigint.gc_divmod(h, arg(a), arg(b), true) else { return None; };
    let qv = finish(h, q);
    Some((qv, finish(h, r)))
}

pub fn shl(h: *gc.Heap, a: Value, n: u64) -> Value { finish(h, bigint.gc_shl(h, arg(a), n)) }
pub fn shr(h: *gc.Heap, a: Value, n: u64) -> Value { finish(h, bigint.gc_shr(h, arg(a), n)) }

/// op: 0 and, 1 or, 2 xor.
pub fn bitop(h: *gc.Heap, a: Value, b: Value, op: u32) -> Value {
    let x = arg(a);
    let y = arg(b);
    let r = if op == 0 { bigint.gc_and(h, x, y) } else if op == 1 { bigint.gc_or(h, x, y) } else { bigint.gc_xor(h, x, y) };
    finish(h, r)
}

pub fn cmp(a: Value, b: Value) -> i32 {
    var x: u64 = 0;
    var y: u64 = 0;
    bigint.cmp(view(a, &x), view(b, &y))
}

pub fn cmp_long(a: Gc<Long>, b: Gc<Long>) -> i32 { cmp(Value.Long(a), Value.Long(b)) }

pub fn is_neg(v: Value) -> bool {
    match v {
        Int(i) => i < 0,
        Long(b) => b.s < 0,
        _ => false,
    }
}

pub fn is_odd(v: Value) -> bool {
    var x: u64 = 0;
    bigint.is_odd(view(v, &x))
}

/// Digits in `radix` (2 to 36, lowercase), with a `-` if negative.
pub fn write_radix(b: *text.StrBuf, v: Value, radix: u32) {
    if let Int(i) = v and radix == 10 { b.push_int(i as i64); return; }
    var x: u64 = 0;
    bigint.write(b, view(v, &x), radix);
}

/// Decimal digits.
pub fn write(b: *text.StrBuf, v: Value) { write_radix(b, v, 10); }

/// Parse digits in `radix` (no sign, no prefix, underscores skipped).
pub fn parse(h: *gc.Heap, s: str, radix: u32, negative: bool) -> ?Value {
    var t = text.StrBuf.new();
    var digits = s;
    if mem.find_byte(s, '_').is_some() {
        for i in 0..s.len { if s[i] != '_' { t.push(s[i]); } }
        digits = t.as_str();
    }
    let r = bigint.gc_parse(h, digits, radix);
    t.free();
    let Some(l) = r else { return None; };
    l.neg = negative and l.len != 0;
    Some(finish(h, l))
}

/// a ** e for e >= 0.
pub fn pow(h: *gc.Heap, a: Value, e: u64) -> Value { finish(h, bigint.gc_pow(h, arg(a), e)) }

/// Number of bits of |v|.
pub fn bit_length(v: Value) -> u64 {
    var x: u64 = 0;
    bigint.bit_length(view(v, &x))
}
