// Bytecode fuzzer: compile patterns, mutate their code, and run whatever
// the generated verifier accepts on both engines, under a step limit.
// The handlers index the slot, class and literal tables without bounds
// checks because the verifier ran, so a hole in a `verify` clause shows
// up here (build with ASan: see check.sh --asan).
//
//   loimi build examples/regex/fuzz.lm --release -o rxfuzz && ./rxfuzz 20000 1

import std.io;
import std.mem;
import std.os;
import std.text;
import lib;
import pike;
import pike.{Pike};
import vm.{Rx, Regex};

struct Rng { s: u64 }
fn Rng.next(r: *Rng) -> u64 {
    r.s = r.s *% 6364136223846793005 +% 1442695040888963407;
    r.s >> 33
}
fn Rng.below(r: *Rng, n: u64) -> u64 { r.next() % n }

const CORPUS: [str; 12] = ["(a|b)*c", "(\\w+)@(\\w+)\\.com", "a{2,4}?b", "(a*)+$", "^(?:ab|a)+?c",
                           "[^a-c]+x", "(a?){1,3}b", "abc|abd|x", ".*?(\\d+)", "((a)|b)+", "(|a)+b", "a+b+c+"];

fn mutate(r: *Rng, w: []u32, nslots: u64) {
    let i = r.below(w.len);
    var x = w[i];
    let k = r.below(100);
    if k < 35 {
        // A small operand, usually near the valid range.
        let v = r.below(nslots + 4) as u32;
        x = (x & 0xFF) | (v << 8);
    } else if k < 60 {
        x = (x & 0xFFFFFF00) | (r.below(Rx.NUM_OPS + 2) as u32);
    } else if k < 80 {
        let off = r.below(w.len + 4) as i64 - i as i64 - 2;
        if let Some(j) = Rx.set_label(x, off) { x = j; }
    } else if k < 95 {
        x = x ^ ((1 as u32) << r.below(32));
    } else {
        x = r.next() as u32;
    }
    w[i] = x;
}

fn main() -> i32 {
    let n = text.parse_int(os.arg(1) ?? "2000") ?? 2000;
    let seed = text.parse_int(os.arg(2) ?? "1") ?? 1;
    var rng = Rng { s: seed as u64 };
    let subj = "ab1ab c\nabcab@xx.com aab";
    var accepted: i64 = 0;
    var rejected: i64 = 0;
    var matches: i64 = 0;
    var limits: i64 = 0;
    var i: i64 = 0;
    while i < n {
        i += 1;
        let pat = CORPUS[rng.below(12)];
        let re = lib.rx_compile(pat.ptr, pat.len);
        let nslots = 2 * (re.ngroups as u64 + 1);
        // Mutate a copy of the backtracker's code (before optimize).
        let words = re.words.items();
        let copy: *u32 = mem.alloc(words.len);
        mem.copy(copy, words.ptr, words.len);
        let code = copy.slice(words.len);
        for _ in 0..1 + rng.below(3) { mutate(&rng, code, nslots); }
        match Rx.verify(code, &re.lim) {
            Err(_) => rejected += 1,
            Ok(v) => {
                accepted += 1;
                let opt = if rng.below(2) == 0 { Rx.optimize(v) } else { v };
                re.code = opt;
                re.step_limit = 100000;
                let start = rng.below(subj.len);
                let flags = 1 + 2 * (rng.below(2) as u32);
                // The Pike VM steps through the backtracker's code too.
                re.pike_code = opt;
                if let Some(p) = re.pike { (p as *Pike).free(); re.pike = None; }
                var spans: [i64; 8] = [0; 8];
                let rc = lib.rx_exec(re, subj.ptr, subj.len, start, flags, &spans[0], 4);
                if rc == 1 { matches += 1; }
                if rc < 0 { limits += 1; }
            }
        }
        mem.release(copy);
        lib.rx_free(re);
    }
    var b = text.StrBuf.new();
    b.fmt4("fuzz: {} programs, {} rejected, {} accepted ({} matched, ", n, rejected, accepted, matches);
    b.fmt("{} hit the step limit)", limits);
    io.println(b.as_str());
    0
}
