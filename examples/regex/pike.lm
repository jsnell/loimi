// The Pike VM: a breadth-first simulation of the same bytecode, in time
// O(pattern * input). It is ordinary host code: it reads the words with
// the vm's generated decoders (Rx.op_of, Rx.A_a, Rx.label, ...), since a
// vm's handlers can only run the backtracking semantics. Both dispatches
// are exhaustive matches over `Rx.Op`, so adding an op to the vm is a
// compile error here until the Pike VM handles it.
//
// Threads are kept in priority order, and a thread is added to a list
// only once per pc per step, which gives the same leftmost-first answer
// (and captures) as the backtracker.
#![lifetimes]
import std.mem;
import std.map;
import syntax.{Set};
import vm.{Rx, Regex};

struct List { pcs: *u32, caps: *i64, n: u64 }

/// An entry of the explicit stack that follows the epsilon edges:
/// explore `pc` with loop marks `mask` set at this position (slot ==
/// NONE), or restore `slots[slot] = val`.
struct Work { pc: u32, slot: u32, val: i64, mask: u64 }

const NONE: u32 = 0xFFFFFFFF;

pub struct Pike {
    nw: u64,
    nsl: u64,
    a: List,
    b: List,
    seen: *u64,
    /// (mask << 24 | pc) -> gen, for states with a nonzero mask.
    seen_masked: map.HashMap<u64, u64>,
    gen: u64,
    cur: *i64,
    work: mem.Vec<Work>,
}

fn new_list(nw: u64, nsl: u64) -> List {
    List { pcs: mem.alloc(nw), caps: mem.alloc(nw * nsl + 1), n: 0 }
}

pub fn Pike.new(nw: u64, nsl: u64) -> *Pike {
    let p: *Pike = mem.alloc(1);
    *p = Pike {
        nw: nw, nsl: nsl,
        a: new_list(nw, nsl), b: new_list(nw, nsl),
        seen: mem.alloc(nw), seen_masked: map.HashMap.new(), gen: 0,
        cur: mem.alloc(nsl + 1),
        work: mem.Vec.new(),
    };
    p
}

pub fn Pike.free(p: *Pike) {
    mem.release(p.a.pcs); mem.release(p.a.caps);
    mem.release(p.b.pcs); mem.release(p.b.caps);
    mem.release(p.seen); mem.release(p.cur);
    p.seen_masked.free();
    p.work.free();
    mem.release(p);
}

/// Follow the epsilon edges from `pc0` at input position `sp`, with the
/// slots in `p.cur`, adding every consuming instruction and MATCH reached
/// to `l` in priority order.
///
/// What happens after an epsilon instruction depends on its pc and on
/// which loop marks equal `sp`, i.e. were set by a MARK in this closure:
/// LOOP goes round again only if its mark is older. Each work item
/// carries those marks as a bit mask, and an epsilon pc is followed once
/// per (pc, mask), so the first (highest priority) path to reach a state
/// wins, which is the answer the backtracker gives. A thread waiting at a
/// consuming instruction or MATCH does not depend on the mask (every mark
/// is older than the next position), so it is added once per pc.
fn Pike.add(p: *Pike, code: []u32, l: *List, pc0: u64, input: *u8, sp: u64, end: u64, nslots: u64) {
    p.work.clear();
    p.work.push(Work { pc: pc0 as u32, slot: NONE, val: 0, mask: 0 });
    while let Some(wk) = p.work.pop() {
        if wk.slot != NONE { p.cur[wk.slot as u64] = wk.val; continue; }
        let pc = wk.pc as u64;
        let mask = wk.mask;
        let w = code[pc];
        if mask == 0 {
            if p.seen[pc] == p.gen { continue; }
            p.seen[pc] = p.gen;
        } else {
            let key = (mask << 24) | pc;
            if p.seen_masked.get(key) == Some(p.gen) { continue; }
            p.seen_masked.insert(key, p.gen);
        }
        let next = Work { pc: (pc + 1) as u32, slot: NONE, val: 0, mask: mask };
        match Rx.op_of(w) {
            Rx.Op.JMP => p.work.push(Work { pc: target(w, pc), slot: NONE, val: 0, mask: mask }),
            Rx.Op.SPLIT => {
                p.work.push(Work { pc: target(w, pc), slot: NONE, val: 0, mask: mask });
                p.work.push(next);
            }
            Rx.Op.SPLITX => {
                p.work.push(next);
                p.work.push(Work { pc: target(w, pc), slot: NONE, val: 0, mask: mask });
            }
            Rx.Op.SAVE => {
                let s = Rx.A_a(w);
                p.work.push(Work { pc: 0, slot: s as u32, val: p.cur[s], mask: 0 });
                p.cur[s] = sp as i64;
                p.work.push(next);
            }
            Rx.Op.MARK => {
                let m = Rx.A_a(w);
                p.work.push(Work { pc: (pc + 1) as u32, slot: NONE, val: 0, mask: mask | ((1 as u64) << m) });
            }
            Rx.Op.UNMARK => {
                let m = Rx.A_a(w);
                p.work.push(Work { pc: (pc + 1) as u32, slot: NONE, val: 0, mask: mask & ~((1 as u64) << m) });
            }
            Rx.Op.NOPROG => {
                let m = Rx.AJ_a(w);
                if (mask & ((1 as u64) << m)) != 0 {
                    p.work.push(Work { pc: target(w, pc), slot: NONE, val: 0, mask: mask });
                } else {
                    p.work.push(next);
                }
            }
            Rx.Op.LOOP => {
                let m = Rx.AJ_a(w);
                if (mask & ((1 as u64) << m)) == 0 {
                    p.work.push(Work { pc: target(w, pc), slot: NONE, val: 0, mask: mask });
                } else {
                    p.work.push(next);
                }
            }
            Rx.Op.BOL => if sp == 0 { p.work.push(next); },
            Rx.Op.EOL => if sp == end or (sp + 1 == end and input[sp] == '\n') { p.work.push(next); },
            // The backtracker's multi-byte instructions are not in Pike
            // programs, but the fuzzer runs the Pike VM over the
            // backtracker's code too: there a thread waits at them and
            // dies (see `run`).
            Rx.Op.CHAR | Rx.Op.ANY | Rx.Op.CLASS | Rx.Op.MATCH | Rx.Op.LIT | Rx.Op.CSTAR | Rx.Op.CPLUS => {
                // A thread waits here.
                if mask != 0 {
                    if p.seen[pc] == p.gen { continue; }
                    p.seen[pc] = p.gen;
                }
                l.pcs[l.n] = pc as u32;
                mem.copy(l.caps + l.n * p.nsl, p.cur, p.nsl);
                l.n += 1;
            }
        }
    }
}

fn target(w: u32, pc: u64) -> u32 {
    let Some(off) = Rx.label(w) else { trap() };
    (pc as i64 + off) as u32
}

fn reset(p: *Pike) { for i in 0..p.nsl { p.cur[i] = -1; } }

/// Run the Pike VM; on a match, copy the slots to `r.slots` and return true.
pub fn run(r: *Regex, p: *Pike, input: *u8, end: u64, start: u64, searching: bool) -> bool {
    let code = r.pike_code.words();
    let nslots = 2 * (r.ngroups as u64 + 1);
    let unanchored = searching and !r.anchored;
    var clist = &p.a;
    var nlist = &p.b;
    var matched = false;
    var sp = start;
    if unanchored and !r.first_all { sp = skip(r, input, sp, end); }
    if sp > end or (unanchored and !r.first_all and sp == end) { return false; }
    p.gen += 1;
    clist.n = 0;
    reset(p);
    p.add(code, clist, 0, input, sp, end, nslots);
    loop {
        p.gen += 1;
        nlist.n = 0;
        let c: u8 = if sp < end { input[sp] } else { 0 };
        var i: u64 = 0;
        while i < clist.n {
            let pc = clist.pcs[i] as u64;
            let w = code[pc];
            let more = sp < end;
            let ok = match Rx.op_of(w) {
                Rx.Op.MATCH => {
                    // Threads after this one have lower priority: drop them.
                    mem.copy(r.slots, clist.caps + i * p.nsl, nslots);
                    matched = true;
                    break;
                }
                Rx.Op.CHAR => more and c as u64 == Rx.A_a(w),
                Rx.Op.ANY => more and c != '\n',
                Rx.Op.CLASS => more and r.classes[Rx.A_a(w)].has(c),
                Rx.Op.LIT | Rx.Op.CSTAR | Rx.Op.CPLUS => false,
                // `add` puts only the ops above in the lists.
                Rx.Op.JMP | Rx.Op.SPLIT | Rx.Op.SPLITX | Rx.Op.SAVE | Rx.Op.MARK | Rx.Op.UNMARK
                    | Rx.Op.NOPROG | Rx.Op.LOOP | Rx.Op.BOL | Rx.Op.EOL => trap(),
            };
            if ok {
                mem.copy(p.cur, clist.caps + i * p.nsl, p.nsl);
                p.add(code, nlist, pc + 1, input, sp + 1, end, nslots);
            }
            i += 1;
        }
        if sp >= end { break; }
        if !matched and unanchored {
            if nlist.n == 0 and !r.first_all {
                // Nothing alive: skip to a byte that can start a match.
                let nx = skip(r, input, sp + 1, end);
                if nx >= end { break; }
                sp = nx;
                reset(p);
                p.add(code, nlist, 0, input, sp, end, nslots);
                let t = clist; clist = nlist; nlist = t;
                continue;
            }
            // The lowest-priority thread: a match starting at sp + 1.
            reset(p);
            p.add(code, nlist, 0, input, sp + 1, end, nslots);
        }
        if nlist.n == 0 and (matched or !unanchored) { break; }
        let t = clist; clist = nlist; nlist = t;
        sp += 1;
    }
    matched
}

fn skip(r: *Regex, input: *u8, s: u64, end: u64) -> u64 {
    var i = s;
    while i < end and !r.first.has(input[i]) { i += 1; }
    i
}
