// The regex compiler: syntax tree to Rx bytecode.
//
// Layouts (L: labels; `x` is the operand's code):
//
//   a|b      SPLIT L1; a; JMP L2; L1: b; L2:
//   x*       L: SPLIT E; x; JMP L; E:            (x*?: SPLITX E instead)
//   x+       JMP B; L: SPLIT E; B: x; JMP L; E:  (enters the loop body first)
//   x?       SPLIT E; x; E:                      (x??: SPLITX E)
//   x{m,n}   x m times, then n-m times `SPLIT E; x`, all to one E
//   (x)      SAVE 2k; x; SAVE 2k+1
//
// A loop whose body can match the empty string brackets each iteration
// with `MARK m` ... `LOOP m, L`, which goes round again only if the
// iteration consumed input (otherwise `(a*)*` would loop forever). x+
// enters its first iteration after `UNMARK m`, so that one is not checked.
#![lifetimes]
import std.bc;
import std.mem;
import syntax;
import syntax.{Node, Tree, Set, INF};
import vm.{Rx, Lit};

pub struct Out {
    words: mem.Vec<u32>,
    lits: mem.Vec<Lit>,
    lit_bytes: mem.Vec<u8>,
    nmarks: u32,
}

struct C {
    t: *Tree,
    code: bc.Code<u32>,
    out: *Out,
    /// Use the backtracker's multi-byte instructions: LIT for runs of
    /// literal bytes, CSTAR/CPLUS for greedy loops over one byte. (The
    /// Pike VM steps one byte at a time and has neither.)
    use_lit: bool,
    err: ?str,
}

/// Most code words a pattern may compile to.
const MAX_WORDS: u64 = 1 << 18;

pub fn compile(t: *Tree, use_lit: bool, out: *Out) -> ?str {
    var c = C { t: t, code: bc.Code.new(Rx.op_size, Rx.set_label), out: out, use_lit: use_lit, err: None };
    c.code.op(Rx.SAVE(0));
    c.node(t.root);
    c.code.op(Rx.SAVE(1));
    c.code.op(Rx.MATCH());
    if c.err.is_none() {
        if let Some(e) = c.code.check() { c.err = Some(e.message()); }
    }
    if c.err.is_none() {
        let w = c.code.words();
        for i in 0..w.len { out.words.push(w[i]); }
    }
    c.code.free();
    c.err
}

fn C.node_at(c: *C, i: u32) -> Node { c.t.nodes.at(i as u64) }

/// Can node `i` match the empty string?
pub fn nullable(t: *Tree, i: u32) -> bool {
    match t.nodes.at(i as u64) {
        Empty => true,
        Byte(_) => false,
        Any => false,
        Class(_) => false,
        Bol => true,
        Eol => true,
        Group(_, x) => nullable(t, x),
        Cat(a, b) => nullable(t, a) and nullable(t, b),
        Alt(a, b) => nullable(t, a) or nullable(t, b),
        Rep(x, min, _, _) => min == 0 or nullable(t, x),
    }
}

/// Add the bytes that can start a match of node `i` to `s`. Returns
/// whether `i` is nullable (then what follows can start it too).
pub fn first(t: *Tree, i: u32, s: *Set) -> bool {
    match t.nodes.at(i as u64) {
        Empty => true,
        Byte(b) => { s.add(b); false }
        Any => { var a = Set.empty(); a.add('\n'); a.invert(); s.union(&a); false }
        Class(k) => { s.union(t.classes.ptr_at(k as u64)); false }
        Bol => true,
        Eol => true,
        Group(_, x) => first(t, x, s),
        Cat(a, b) => { if first(t, a, s) { first(t, b, s) } else { false } }
        Alt(a, b) => { let x = first(t, a, s); let y = first(t, b, s); x or y }
        Rep(x, min, _, _) => { let n = first(t, x, s); n or min == 0 }
    }
}

/// A byte that every match of node `i` contains, if there is one that
/// is easy to find (a literal byte not under an alternation or an
/// optional repeat). A search first checks that the input has it.
pub fn required(t: *Tree, i: u32) -> ?u8 {
    match t.nodes.at(i as u64) {
        Byte(b) => Some(b),
        Group(_, x) => required(t, x),
        Cat(a, b) => if let Some(x) = required(t, b) { Some(x) } else { required(t, a) },
        Rep(x, min, _, _) => if min > 0 { required(t, x) } else { None },
        _ => None,
    }
}

/// Does every match of node `i` start with `^`?
pub fn anchored(t: *Tree, i: u32) -> bool {
    match t.nodes.at(i as u64) {
        Bol => true,
        Group(_, x) => anchored(t, x),
        Cat(a, _) => anchored(t, a),
        Alt(a, b) => anchored(t, a) and anchored(t, b),
        _ => false,
    }
}

fn C.too_big(c: *C) -> bool {
    if c.code.pc() > MAX_WORDS {
        if c.err.is_none() { c.err = Some("pattern too large"); }
        return true;
    }
    c.err.is_some()
}

fn C.node(c: *C, i: u32) {
    if c.too_big() { return; }
    match c.node_at(i) {
        Empty => {}
        Byte(b) => { c.code.op(Rx.CHAR(b as u32)); }
        Any => { c.code.op(Rx.ANY()); }
        Class(k) => { c.code.op(Rx.CLASS(k)); }
        Bol => { c.code.op(Rx.BOL()); }
        Eol => { c.code.op(Rx.EOL()); }
        Group(k, x) => {
            c.code.op(Rx.SAVE(2 * k));
            c.node(x);
            c.code.op(Rx.SAVE(2 * k + 1));
        }
        Cat(_, _) => c.cat(i),
        Alt(a, b) => {
            let l1 = c.code.label();
            let l2 = c.code.label();
            c.code.jump(Rx.SPLIT(0), l1);
            c.node(a);
            c.code.jump(Rx.JMP(0), l2);
            c.code.bind(l1);
            c.node(b);
            c.code.bind(l2);
        }
        Rep(x, min, max, greedy) => c.rep(x, min, max, greedy),
    }
}

/// Collect the leaves of a tree of Cat nodes, left to right.
fn C.flatten(c: *C, i: u32, out: *mem.Vec<u32>) {
    if let Cat(a, b) = c.node_at(i) {
        c.flatten(a, out);
        c.flatten(b, out);
    } else {
        out.push(i);
    }
}

fn C.cat(c: *C, i: u32) {
    var parts: mem.Vec<u32> = mem.Vec.new();
    defer parts.free();
    c.flatten(i, &parts);
    var k: u64 = 0;
    while k < parts.len {
        // A run of two or more literal bytes becomes one LIT.
        var run: u64 = 0;
        if c.use_lit {
            while k + run < parts.len {
                let Byte(_) = c.node_at(parts.at(k + run)) else { break };
                run += 1;
            }
        }
        if run >= 2 {
            let off = c.out.lit_bytes.len as u32;
            for j in 0..run {
                let Byte(b) = c.node_at(parts.at(k + j)) else { unreachable };
                c.out.lit_bytes.push(b);
            }
            c.out.lits.push(Lit { off: off, len: run as u32 });
            c.code.op(Rx.LIT((c.out.lits.len - 1) as u32));
            k += run;
        } else {
            c.node(parts.at(k));
            k += 1;
        }
    }
}

fn C.new_mark(c: *C) -> ?u32 {
    // The Pike VM keeps the marks set at the current position in a bit
    // mask next to a 24-bit pc.
    if c.out.nmarks >= 40 {
        if c.err.is_none() { c.err = Some("too many loops that can match the empty string (limit 40)"); }
        return None;
    }
    c.out.nmarks += 1;
    Some(c.out.nmarks - 1)
}

/// The class of a node that matches exactly one byte, if it is one.
fn C.single_byte_class(c: *C, x: u32) -> ?u32 {
    var s = Set.empty();
    match c.node_at(x) {
        Byte(b) => s.add(b),
        Any => { s.add('\n'); s.invert(); }
        Class(k) => return Some(k),
        _ => return None,
    }
    c.t.classes.push(s);
    Some((c.t.classes.len - 1) as u32)
}

/// x* (min_one: x+), greedy or lazy.
fn C.star(c: *C, x: u32, min_one: bool, greedy: bool) {
    if c.use_lit and greedy {
        if let Some(k) = c.single_byte_class(x) {
            c.code.op(if min_one { Rx.CPLUS(k) } else { Rx.CSTAR(k) });
            return;
        }
    }
    let empty_body = nullable(c.t, x);
    let body = c.code.label();
    let exit = c.code.label();
    if !empty_body {
        if min_one { c.code.jump(Rx.JMP(0), body); }
        let head = c.code.here();
        c.code.jump(if greedy { Rx.SPLIT(0) } else { Rx.SPLITX(0) }, exit);
        c.code.bind(body);
        c.node(x);
        c.code.jump(Rx.JMP(0), head);
        c.code.bind(exit);
        return;
    }
    // As Python's sre does: an iteration may start only if the previous
    // optional one consumed input. The mandatory first iteration of x+ is
    // not checked, so it enters with the mark cleared.
    let Some(m) = c.new_mark() else { return };
    if min_one {
        c.code.op(Rx.UNMARK(m));
        c.code.jump(Rx.JMP(0), body);
    }
    let head = c.code.here();
    c.code.jump(if greedy { Rx.SPLIT(0) } else { Rx.SPLITX(0) }, exit);
    c.code.op(Rx.MARK(m));
    c.code.bind(body);
    c.node(x);
    c.code.jump(Rx.LOOP(m as u8, 0), head);
    c.code.bind(exit);
}

fn C.rep(c: *C, x: u32, min: u32, max: u32, greedy: bool) {
    if max == INF {
        if min == 0 { c.star(x, false, greedy); return; }
        for _ in 0..(min - 1) as u64 { c.node(x); if c.too_big() { return; } }
        c.star(x, true, greedy);
        return;
    }
    for _ in 0..min as u64 { c.node(x); if c.too_big() { return; } }
    if max == min { return; }
    // Optional copies: each one is only tried if the previous matched.
    // If x can match empty, an optional copy after the first is only
    // tried if the previous one consumed input (sre's rule, as in star).
    let exit = c.code.label();
    var mark: ?u32 = None;
    if nullable(c.t, x) {
        let Some(m) = c.new_mark() else { return };
        mark = Some(m);
    }
    for i in 0..(max - min) as u64 {
        if let Some(m) = mark and i > 0 { c.code.jump(Rx.NOPROG(m as u8, 0), exit); }
        c.code.jump(if greedy { Rx.SPLIT(0) } else { Rx.SPLITX(0) }, exit);
        if let Some(m) = mark { c.code.op(Rx.MARK(m)); }
        c.node(x);
        if c.too_big() { return; }
    }
    c.code.bind(exit);
}
