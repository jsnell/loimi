@@ -40,6 +40,96 @@ pub value Term repr nanbox {
     Big(Gc<Big>),
 }
 
+// ── BIBOP-UB measurement hack (speed-audit item 5): Var and Cons cells
+// from a plain, never-freed arena of CELL-byte cells instead of the GC
+// heap (as examples/scheme/value.lm's pairs). CELL 16: headerless; 24: an
+// 8-byte header word; 32: the stock 16-byte header (allocation-path
+// control). 2 MiB segments from gc.raw_segment (the GC's own segment source), 64 KiB blocks
+// whose first 16 bytes are a zero "chunk head" holding the flag byte the
+// write barrier tests (mask + load). Only valid when nothing collects.
+pub const ARENA: bool = false;
+pub const CELL: u64 = 16;
+const HDR: u64 = CELL - 16;
+const ABLK: u64 = 65536;
+const ASEG: u64 = 2 << 20;
+var A_CUR: u64 = 0;
+var A_LIM: u64 = 0;
+var A_SEG: u64 = 0;
+var A_SEG_END: u64 = 0;
+var A_LOGGED: u64 = 0;
+
+
+#[cold]
+#[inline(never)]
+fn arena_refill() {
+    if A_SEG == A_SEG_END {
+        let start = gc.raw_segment() as u64;
+        A_SEG = start;
+        A_SEG_END = start + ASEG;
+    }
+    let b = A_SEG;
+    A_SEG = b + ABLK;
+    A_CUR = b + 16;
+    A_LIM = b + 16 + (ABLK - 16) / CELL * CELL;
+}
+
+#[inline]
+fn arena_cell(h: *gc.Heap) -> u64 {
+    if A_LIM - A_CUR < CELL { arena_refill(); }
+    let c = A_CUR;
+    A_CUR = c + CELL;
+    if HDR == 8 { *(c as *u64) = CELL | (1 << 32); }
+    if HDR == 16 { *(c as *u64) = CELL | (1 << 32); *((c + 8) as *u64) = 0; }
+    h.count += 1;
+    h.allocated += CELL;
+    c + HDR
+}
+
+#[inline]
+pub fn new_var(h: *gc.Heap, stamp: u64) -> Gc<Var> {
+    if !ARENA { return new(h, Var { val: Term.Unb, stamp: stamp }); }
+    let p = arena_cell(h);
+    *(p as *Term) = Term.Unb;
+    *((p + 8) as *u64) = stamp;
+    unsafe { p as Gc<Var> }
+}
+
+#[inline]
+pub fn new_cons(h: *gc.Heap, hd: Term, tl: Term) -> Gc<Cons> {
+    if !ARENA { return new(h, Cons { head: hd, tail: tl }); }
+    let p = arena_cell(h);
+    *(p as *Term) = hd;
+    *((p + 8) as *Term) = tl;
+    unsafe { p as Gc<Cons> }
+}
+
+#[inline]
+fn chunk_flag(a: u64) -> bool {
+    let f = *((a & !(ABLK - 1)) as *u8);
+    (f & 4) != 0
+}
+
+/// `gc.needs_barrier` for a Var.
+#[inline]
+pub fn var_needs_barrier(v: Gc<Var>) -> bool {
+    if !ARENA { return gc.needs_barrier(v as *u8); }
+    chunk_flag(v as u64)
+}
+
+#[inline]
+pub fn set_val(v: Gc<Var>, t: Term) {
+    if !ARENA { v.val = t; return; }
+    *((v as u64) as *Term) = t;
+    if unlikely(chunk_flag(v as u64)) { A_LOGGED += 1; }
+}
+
+#[inline]
+pub fn set_tail(c: Gc<Cons>, t: Term) {
+    if !ARENA { c.tail = t; return; }
+    *((c as u64 + 8) as *Term) = t;
+    if unlikely(chunk_flag(c as u64)) { A_LOGGED += 1; }
+}
+
