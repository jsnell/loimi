-    V.P(new(h, Pair { car: a, cdr: d }))
+    V.P(mk_pair(h, a, d))
+}
+
+// ── BIBOP-UB measurement hack (speed-audit item 5): pairs from a plain,
+// never-freed arena of CELL-byte cells instead of the GC heap. CELL 16:
+// headerless pairs; 24: an 8-byte header word before the pair; 32: the
+// stock 16-byte header (control for the allocation path). The arena is
+// 2 MiB segments from gc.raw_segment (the GC's own segment source),
+// carved into 64 KiB blocks whose first 16 bytes are a zero "chunk head"
+// (the per-chunk flag byte the write barrier tests: mask + load, as the
+// BiBoP proposal's barrier would). Only valid when nothing collects.
+pub const ARENA: bool = false;
+pub const CELL: u64 = 16;
+const HDR: u64 = CELL - 16;
+const ABLK: u64 = 65536;
+const ASEG: u64 = 2 << 20;
+var A_CUR: u64 = 0;
+var A_LIM: u64 = 0;
+var A_SEG: u64 = 0;
+var A_SEG_END: u64 = 0;
+var A_LOGGED: u64 = 0;
+
+
+#[cold]
+#[inline(never)]
+fn arena_refill() {
+    if A_SEG == A_SEG_END {
+        let start = gc.raw_segment() as u64;
+        A_SEG = start;
+        A_SEG_END = start + ASEG;
+    }
+    let b = A_SEG;
+    A_SEG = b + ABLK;
+    A_CUR = b + 16;
+    A_LIM = b + 16 + (ABLK - 16) / CELL * CELL;
+}
+
+#[inline]
+fn arena_put(h: *gc.Heap, c: u64, a: V, d: V) -> Gc<Pair> {
+    if HDR == 8 { *(c as *u64) = CELL | (1 << 32); }
+    if HDR == 16 { *(c as *u64) = CELL | (1 << 32); *((c + 8) as *u64) = 0; }
+    h.count += 1;
+    h.allocated += CELL;
+    let p = c + HDR;
+    *(p as *V) = a;
+    *((p + 8) as *V) = d;
+    unsafe { p as Gc<Pair> }
+}
+
+#[inline]
+pub fn mk_pair(h: *gc.Heap, a: V, d: V) -> Gc<Pair> {
+    if !ARENA { return new(h, Pair { car: a, cdr: d }); }
+    if A_LIM - A_CUR < CELL { arena_refill(); }
+    let c = A_CUR;
+    A_CUR = c + CELL;
+    arena_put(h, c, a, d)
+}
+
+/// `try_new` for pairs: None when the current run (block) is used up.
+#[inline]
+pub fn try_pair(h: *gc.Heap, a: V, d: V) -> ?Gc<Pair> {
+    if !ARENA { return try_new(h, Pair { car: a, cdr: d }); }
+    if A_LIM - A_CUR < CELL { return None; }
+    let c = A_CUR;
+    A_CUR = c + CELL;
+    Some(arena_put(h, c, a, d))
+}
+
+#[inline]
+fn arena_barrier(p: Gc<Pair>) {
+    let f = *(((p as u64) & !(ABLK - 1)) as *u8);
+    if unlikely((f & 4) != 0) { A_LOGGED += 1; }
+}
+
+#[inline]
+pub fn set_car(p: Gc<Pair>, v: V) {
+    if !ARENA { p.car = v; return; }
+    *((p as u64) as *V) = v;
+    arena_barrier(p);
+}
+
+#[inline]
+pub fn set_cdr(p: Gc<Pair>, v: V) {
+    if !ARENA { p.cdr = v; return; }
+    *((p as u64 + 8) as *V) = v;
+    arena_barrier(p);
 }
 
