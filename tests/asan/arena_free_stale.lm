// expect-stderr: heap-use-after-free
// A value from an arena used after `Arena.free`.
// The stale use is the point (ASan reports it at run time), so the
// compile-time check that rejects it is off.
#![lifetimes(off)]
import std.io;
import std.mem;

fn main() {
    var a = mem.Arena.new();
    let p = new(&a, 42 as i64);
    a.free();
    io.print_int(*p);
}
