// expect-stderr: use-after-poison
// An `OrderedMap` entry pointer kept across `clear` (the table is kept,
// its entries are dead).
// The stale use is the point (ASan reports it at run time), so the
// compile-time check that rejects it is off.
#![lifetimes(off)]
import std.io;
import std.map;

fn main() {
    var m: map.OrderedMap<u64, i64> = map.OrderedMap.new();
    m.insert(1, 10);
    m.insert(2, 20);
    let p = m.get_ptr(2).unwrap();
    m.clear();
    io.print_int(*p);
}
