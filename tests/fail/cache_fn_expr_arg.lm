vm V {
    state { pc: *u32 }
    encoding fixed(u32) { format A { op: 8 } }
    cache IC { n: u32 }
    fn bump(c: cache IC) { c.n += 1; }
    op NOP() : A + IC { bump(pc as *u32); next }
    entry run(c: *u32) -> i64 { pc = c; jump pc }
}
