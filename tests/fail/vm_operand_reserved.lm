// Operand names starting with `__` are reserved for generated code.
// error: names starting with `__` are reserved for generated code
vm M {
    state { pc: *u32, regs: *i64 }
    operand reg = regs[it];
    encoding fixed(u32) { format AB { op: 8, a: 8, b: 16 } }
    op RET(__at: reg) : AB { exit __at }
    entry run(code: *u32, r: *i64) -> i64 { pc = code; regs = r; jump pc }
}

fn main() {}
