// error: vm `M` declares stack effects, so every op needs one: add `stack(--)` if `HALT` neither pops nor pushes
vm M {
    state { pc: *u32 }
    encoding fixed(u32) { format X { op: 8 } }
    op NOP() : X stack(--) { next }
    op HALT() : X { exit 0 }
    entry run(code: *u32) -> i64 { jump code }
}

fn main() {}
