// Checked per instance: a generic object's trailing array of `T` is
// fine for `i64` and not for `Gc<Node>`.
import std.gc;
object Node { v: i64 }
object Arr<T> { items: [T] }
fn make<T>(h: *gc.Heap, n: u64) -> Gc<Arr<T>> { new(h, Arr {}, n) }
fn main() {
    var heap = gc.Heap.new();
    let a: Gc<Arr<i64>> = make(&heap, 4);
    let b: Gc<Arr<Gc<Node>>> = make(&heap, 4);
}
// error: zero is a null `Gc<Node>`
