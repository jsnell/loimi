// A scanner runs during a collection, so it must not collect: its type
// has no effects.
import std.gc;
fn bad_scan(h: *gc.Heap, data: *u8) uses gc { gc.collect(h); }
fn main() {
    var heap = gc.Heap.new();
    heap.add_scanner(0 as *u8, bad_scan);
}
