// A condition or scrutinee that fails (here because it reads a poisoned
// binding) does not hide the errors in the branches; what an `if let`
// binds from a bad value is poisoned too.
fn f(n: u64) -> u64 {
    let offset = no_such_a;
    let end = offset + (1 << n);
    if end < 65536 {
        bad_one(1);
    } else {
        bad_two(2);
    }
    match offset {
        1 => bad_three(),
        _ => {}
    }
    while offset.more {
        bad_four();
    }
    if let Some(x) = no_such_b {
        x.anything();
        bad_five();
    }
    end
}
fn main() {}
