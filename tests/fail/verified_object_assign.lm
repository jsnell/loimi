// `p.code` reads as the proof; it is not a place.
// error: left side of assignment is not a place
import std.gc;

object Proto { nregs: u32, code: verified [u32] by V }

vm V {
    state { pc: *u32 }
    encoding fixed(u32) { format X { op: 8 } }
    op HALT() : X { exit 0 }
    entry run(p: Gc<Proto>) -> i64 { jump p.code }
}

fn main() {
    var heap = gc.Heap.new();
    let w: [u32; 1] = [V.HALT()];
    let Ok(p) = V.build_verified(&heap, Proto { nregs: 1 }, w[..]) else { return; };
    p.code = V.placeholder();
}
