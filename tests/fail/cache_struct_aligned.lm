// A struct with an 8-byte field is not laid out as 4-byte code words.
struct Site { n: u32, big: u64 }
fn get(p: *Site) -> u64 { p.big }
vm V {
    state { pc: *u32 }
    encoding fixed(u32) { format A { op: 8 } }
    cache IC = Site;
    op NOP() : A + IC { cache.big = 1; let x = get(&cache); next }
    entry run(c: *u32) -> i64 { pc = c; jump pc }
}
fn main() {}
// error: `&cache` cannot be a `*Site`: `Site` is 8-byte aligned and code words only 4-byte
