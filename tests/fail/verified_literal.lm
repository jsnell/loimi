// A Verified<V> comes only from V.verify: its code field is private to
// the vm's generated code, so a struct literal cannot build one.
vm V {
    state { pc: *u32 }
    encoding fixed(u32) { format A { op: 8 } }
    op RET() : A { exit 0 }
    entry run(code: Verified<V>) -> i64 { jump code }
}
fn main() {
    var code: [u32; 1] = [0; 1];
    let v = V__Verified { __code: code[..] };
    V.run(v);
}
// error: field `__code` of `V.Verified` is private to the file that declares it
