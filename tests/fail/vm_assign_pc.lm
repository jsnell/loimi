// error: this assigns `pc` in an op or vm function
// A handler that moves pc and then says `next` ran the wrong code: in a
// super the next part is compiled in, and the JIT patched `next` relative
// to the instruction. Handlers leave pc to the control words.
vm M {
    state { pc: *u32, regs: *i64 }
    operand reg = regs[it];
    encoding fixed(u32) { format X { op: 8, a: 8, b: 8, c: 8 } }
    op SKIPODD(a: reg) : X {
        if a % 2 == 1 { pc = pc + 1; }
        next
    }
    op RET(a: reg) : X { exit a }
    entry run(code: *u32, r: *i64) -> i64 { regs = r; pc = code; jump pc }
}

fn main() {}
