// A kept slice passed to a function that stores through its parameter.
import std.gc;
object Node { v: i64 }
object Arr { items: [?Gc<Node>] }
fn put(s: []?Gc<Node>, n: Gc<Node>) { s[0] = Some(n); }
fn main() uses gc {
    var heap = gc.Heap.new();
    let a = new(&heap, Arr {}, 2);
    let s = a.items;
    put(s, new(&heap, Node { v: 1 }));
}
// error: a slice of an object's traced trailing array is passed (held in a local) to a function that may store through it or keep it: a store through it would skip the write barrier
