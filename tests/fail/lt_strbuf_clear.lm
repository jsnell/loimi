// Lifetimes (docs/design/lifetimes.md section 5.3): `StrBuf.clear` is not
// annotated; it calls `Vec.clear` (`#[shrinks(v)]`), and its summary says
// it removes the elements of `b.bytes`.
#![lifetimes]
import std.io;
import std.text;
fn main() {
    var b = text.StrBuf.new();
    b.push_str("old");
    let s = b.as_str();
    b.clear();
    b.push_str("new");
    io.print(s);
}
// error: `s` may point to removed elements: the call of `StrBuf.clear`
