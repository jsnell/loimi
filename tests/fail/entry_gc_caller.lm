// Calling an entry that may collect needs the effect, as any `uses gc` call.
// error: `run` uses gc, but `start` does not declare it; add `uses gc` to its signature
import std.gc;

struct Ctx { heap: gc.Heap }

vm M {
    context ctx: *Ctx;
    state { pc: *u32 }
    encoding fixed(u32) { format X { op: 8 } }
    op GC() : X { gc.collect(&ctx.heap); next }
    op HALT() : X { exit 0 }
    entry run(c: *Ctx, code: *u32) -> i64 uses gc { ctx = c; jump code }
}

fn start(c: *Ctx, code: *u32) -> i64 { M.run(c, code) }

fn main() {}
