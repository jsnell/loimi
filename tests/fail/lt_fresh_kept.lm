// Lifetimes: a constructor keeps its argument in the memory it returns
// (tests/run/lt_fresh_kept.lm); storing that result in a global keeps
// the address of the caller's local beyond the call.
#![lifetimes]
import std.mem;

struct Counter { n: u64 }
struct Table { owner: *Counter, size: u64 }

var TABLE: *Table = 0 as *Table;

fn Table.new(c: *Counter) -> *Table {
    let t: *Table = mem.alloc(1);
    *t = Table { owner: c, size: 4 };
    t
}

fn run() {
    var c = Counter { n: 1 };
    TABLE = Table.new(&c);
}

fn main() {
    run();
}
// error: stores the address of local `c` in memory that outlives the function
