// V.assume_verified skips the verifier, so it needs `unsafe { }`.
vm V {
    state { pc: *u32 }
    encoding fixed(u32) { format A { op: 8 } }
    op RET() : A { exit 0 }
    entry run(code: Verified<V>) -> i64 { jump code }
}
fn main() {
    var code: [u32; 1] = [0; 1];
    V.run(V.assume_verified(code[..]));
}
// error: `V.assume_verified` is unsafe
