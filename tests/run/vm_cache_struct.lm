// Cache layouts from structs: `cache X = S;` declares a cache whose
// words are S's fields, and `&cache` (or `&c` for a cache handle) is a
// `*S`, which plain functions take like any pointer.
// matrix: dispatch
import std.io;
import std.obj;
import std.text;

struct Site { shape: u32, slot: u32, hits: u32 }

/// Fills a site: written once, called from an op and from a vm function.
fn fill(s: *Site, shape: u32, slot: u32) { s.shape = shape; s.slot = slot; }
fn bump(s: *Site) -> u32 { s.hits += 1; s.hits }
fn note_miss(s: *obj.Site) { s.miss += 1; }

vm V {
    state { pc: *u32, regs: *i64, acc: i64 }
    operand reg = regs[it];
    operand imm = it;
    encoding fixed(u32) { format ABC { op: 8, a: 8, b: 8, c: 8 } }

    cache SiteIC = Site;
    cache PropIC = obj.Site;

    // A vm function passes its handle on as a `*Site`.
    fn refill(c: cache SiteIC, shape: u32) { fill(&c, shape, shape * 2); }

    // GET dst, shape: hits when the cached shape is `shape`.
    op GET(dst: reg, shape: imm) : ABC + SiteIC {
        if cache.shape == shape as u32 { dst = bump(&cache) as i64; next }
        if cache.shape == 0 { fill(&cache, shape as u32, shape as u32 * 2); } else { refill(cache, shape as u32); }
        dst = 100 + cache.slot as i64;
        next
    }
    op MISS(dst: reg) : ABC + PropIC { note_miss(&cache); cache.sid = 9; dst = cache.miss as i64; next }
    op ADD(dst: reg, a: reg, b: reg) : ABC { dst = a + b; next }
    op RET(src: reg) : ABC { exit src }
    super GET_ADD = GET; ADD;

    entry run(code: *u32, r: *i64) -> i64 { pc = code; regs = r; acc = 0; jump pc }
}

fn main() {
    // Every field starts a word: 1 + 3 and 1 + 6.
    io.print_int(V.op_size(V.GET(0, 0)) as i64); io.println("");
    io.print_int(V.op_size(V.MISS(0)) as i64); io.println("");
    var code: [u32; 64] = [0; 64];
    let c = code[..];
    var at: u64 = 0;
    at = V.emit.GET(c, at, 1, 5);
    at = V.emit.ADD(c, at, 0, 0, 1);
    at = V.emit.GET(c, at, 1, 5);
    at = V.emit.ADD(c, at, 0, 0, 1);
    at = V.emit.MISS(c, at, 2);
    at = V.emit.ADD(c, at, 0, 0, 2);
    at = V.emit.RET(c, at, 0);
    var regs: [i64; 4] = [0, 0, 0, 0];
    // 110 + 110 + 1 (the fills, a miss), then 221 + 1 + 1 + 2 (hits, misses).
    io.print_int(V.run(&code[0], &regs[0])); io.println("");
    io.print_int(V.run(&code[0], &regs[0])); io.println("");
    // The words of the first site: shape, slot, hits.
    io.print_int(code[1] as i64); io.print(" "); io.print_int(code[2] as i64); io.print(" "); io.print_int(code[3] as i64); io.println("");
    // A refill through the vm function's handle.
    code[1] = 4;
    regs = [0, 0, 0, 0];
    io.print_int(V.run(&code[0], &regs[0])); io.println("");
    io.print_int(code[1] as i64); io.print(" "); io.print_int(code[2] as i64); io.println("");
    // The disassembler prints the fields by name.
    var out = text.StrBuf.new();
    V.disasm(c[0..at], &out);
    io.print(out.as_str());
    // Supers pass the part's own cache.
    V.optimize_words(c[0..at]);
    io.print(V.op_name(code[0])); io.println("");
    regs = [0, 0, 0, 0];
    io.print_int(V.run(&code[0], &regs[0])); io.println("");
}
// expect: 4
// expect: 7
// expect: 221
// expect: 225
// expect: 5 10 1
// expect: 115
// expect: 5 10
// expect:     0  GET dst=1 shape=5 [cache shape=5 slot=10 hits=1]
// expect:     4  ADD dst=0 a=0 b=1
// expect:     5  GET dst=1 shape=5 [cache shape=5 slot=10 hits=2]
// expect:     9  ADD dst=0 a=0 b=1
// expect:    10  MISS dst=2 [cache sid=9 slot=0 cell=0 depth=0 ent=0 miss=3]
// expect:    17  ADD dst=0 a=0 b=2
// expect:    18  RET src=0
// expect: GET_ADD
// expect: 9
