// Lifetimes (docs/design/lifetimes.md section 5): patterns the inference
// must accept, each a false positive of an earlier version found when the
// examples opted in (section 7).
//
// 1. A closure's captured owning value grows inside the closure and is
//    read again whole (Mini's debugger sorting keys by name): the
//    captured `StrBuf` is the enclosing function's variable, not a view
//    of its buffer, so it does not dangle.
// 2. A pointer exactly at the depth bound (8 steps from a parameter) is
//    passed on as `&t.inner`, whose buffer the callee frees: the freed
//    block lies below the cut, a different block from `t`'s, which stays
//    usable (Mini's `mini_thread_detach`).
#![lifetimes]
import std.io;
import std.mem;
import std.text;

fn fill(b: *text.StrBuf, k: u64) {
    b.push_str("abcdefghijklmnopqrstuvwxyz");
    if k > 1 { b.push_str("x"); }
}

fn sorted(keys: *mem.Vec<u64>) {
    var a = text.StrBuf.new();
    keys.sort_by(|x, y| {
        a.clear();
        fill(&a, *x);
        let n = a.as_str().len;
        if *x < *y { -1 } else if n > 100 { 1 } else { 0 }
    });
    a.free();
}

struct Inner { buf: *u64, n: u64 }
struct D { inner: Inner, v: u64 }
struct X { d: *D }
struct C { pad: u64, x: X }
struct B { c: *C }
struct A { b: *B }

fn release(i: *Inner) {
    mem.release(i.buf);
    i.buf = 0 as *u64;
}

/// `s.b.c.x.d` reads 8 steps from `s`: `s.*.b.*.c.*.x.d.*`.
fn deep(s: *A) -> u64 {
    let t = s.b.c.x.d;
    release(&t.inner);
    t.v
}

fn main() {
    var v: mem.Vec<u64> = mem.Vec.new();
    v.push(3);
    v.push(1);
    sorted(&v);
    io.print_int(v.at(0) as i64);
    io.print("\n");
    v.free();
    var d = D { inner: Inner { buf: mem.alloc(4), n: 4 }, v: 7 };
    var c = C { pad: 0, x: X { d: &d } };
    var b = B { c: &c };
    var a = A { b: &b };
    io.print_int(deep(&a) as i64);
    io.print("\n");
}
// expect: 1
// expect: 7
