// matrix: dispatch
// Hot-handler ordering (docs/lowering.md section 12, "Handler order"):
// the profile lays out MUL and ADD first, in their own section; behaviour
// is unchanged. tests/golden.rs (vm_profile_layout) checks the layout.
import std.io;

#[profile("vm_profile.vmprofile")]
vm V {
    state { pc: *u32, acc: i64 }
    encoding fixed(u32) { format A { op: 8, x: 24 } }
    op ADD(x: imm) : A { acc = acc + (x as i64); next }
    op SUB(x: imm) : A { acc = acc - (x as i64); next }
    op MUL(x: imm) : A { acc = acc * (x as i64); next }
    op HALT() : A { exit acc }
    operand imm = it;
    entry run(code: *u32) -> i64 { acc = 0; jump code }
}

fn main() -> i32 {
    var code: [u32; 5] = [V.ADD(5), V.MUL(8), V.SUB(1), V.ADD(3), V.HALT()];
    io.print_int(V.run(&code[0]));
    io.println("");
    0
}
// expect: 42
