// Arbitrary-width integer types iN / uN (1 <= N <= 64): arithmetic,
// overflow detection at the declared width, shifts, casts and layout.
import std.io;

struct S { a: u8, b: i48, c: u24 }

fn p(x: i64) { io.print_int(x); io.println(""); }

fn show(r: ?i48) {
    match r { Some(x) => p(x as i64), None => io.println("overflow") }
}

fn main() {
    let max: i48 = 140737488355327;     // 2^47 - 1
    let min: i48 = -140737488355328;
    show(max.add_checked(0));
    show(max.add_checked(1));
    show(min.add_checked(-1));
    show(min.sub_checked(1));
    show(min.add_checked(max));
    show(max.sub_checked(-1));
    show((-5 as i48).sub_checked(7));
    let big: i48 = 1 << 30;
    show(big.mul_checked(1 << 16));   // 2^46: fits
    show(big.mul_checked(1 << 17));   // 2^47: overflows
    show(big.mul_checked(-(1 << 17)));  // -2^47: fits
    show((-3 as i48).mul_checked(-7));
    // Wrapping arithmetic wraps at 48 bits.
    p((max +% 1) as i64);
    p((min -% 1) as i64);
    // Unsigned.
    let um: u48 = 281474976710655;      // 2^48 - 1
    match um.add_checked(1) { Some(_) => io.println("?"), None => io.println("u overflow") }
    match (0 as u48).sub_checked(1) { Some(_) => io.println("?"), None => io.println("u borrow") }
    match (65536 as u48).mul_checked(65536) { Some(x) => p(x as i64), None => io.println("?") }
    match (65536 as u48).mul_checked(1 << 32) { Some(_) => io.println("?"), None => io.println("u mul overflow") }
    p((um +% 2) as i64);
    // Casts sign- and zero-extend at the declared width.
    p((-1 as i48) as u48 as i64);
    p((um as i48) as i64);
    p(0x1234_5678_9ABC_DEF0 as i48 as i64);
    // Shifts: amounts are taken modulo the width.
    let one: i48 = 1;
    p((one << 47) as i64);
    p(((one << 47) >> 46) as i64);
    var n: i48 = 49;
    p((one << n) as i64);
    // Small and odd widths.
    let x: u5 = 31;
    match x.add_checked(1) { Some(_) => io.println("?"), None => io.println("u5 overflow") }
    let y: i61 = 1152921504606846975;   // 2^60 - 1
    match y.add_checked(1) { Some(_) => io.println("?"), None => io.println("i61 overflow") }
    p((y.add_checked(-1).unwrap()) as i64);
    // Layout: an i48 takes 8 bytes, a u24 four.
    p(size_of<i48>() as i64);
    p(size_of<u24>() as i64);
    p(size_of<S>() as i64);
    var s = S { a: 1, b: -2, c: 16777215 };
    s.b = s.b * 3;
    p(s.b as i64);
    p(s.c as i64);
}
// expect: 140737488355327
// expect: overflow
// expect: overflow
// expect: overflow
// expect: -1
// expect: overflow
// expect: -12
// expect: 70368744177664
// expect: overflow
// expect: -140737488355328
// expect: 21
// expect: -140737488355328
// expect: 140737488355327
// expect: u overflow
// expect: u borrow
// expect: 4294967296
// expect: u mul overflow
// expect: 1
// expect: 281474976710655
// expect: -1
// expect: 95075992133360
// expect: -140737488355328
// expect: -2
// expect: 2
// expect: u5 overflow
// expect: i61 overflow
// expect: 1152921504606846974
// expect: 8
// expect: 4
// expect: 24
// expect: -6
// expect: 16777215
