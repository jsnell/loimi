// `..zero` in struct literals, and `[]` as the empty slice.
import std.io;
import std.gc;
import std.mem;
import std.text;
import std.diag;

struct Machine {
    name: str,
    out: text.StrBuf,
    sp: ?*i64,
    depth: u32,
    ratio: f64,
    ok: bool,
    last: ?i64,
    regs: [u16; 4],
    pair: (i8, ?*u8),
    words: []u32,
}

struct Cfg { limit: i64, name: str, extra: ?u8 }

object Box { x: i64 }

/// Raw pointers start null (placeholders, as `0 as *T` would be), and
/// `?Gc<T>` and `?fn` start as None.
struct Vmish {
    stack: *i64,
    stack_end: *i64,
    words: *mem.Vec<*u32>,
    ptrs: [*u8; 2],
    cur: ?Gc<Box>,
    hook: ?fn(i64) -> i64,
    heap: gc.Heap,
}

const NULLS: Vmish2 = Vmish2 { n: 5, ..zero };
struct Vmish2 { n: i64, p: *u8, q: ?*u8 }

const CFG: Cfg = Cfg { limit: 7, ..zero };
var GCFG: Cfg = Cfg { ..zero };

fn sum(xs: []u32) -> u64 {
    var t: u64 = 0;
    for i in 0..xs.len { t += xs[i] as u64; }
    t
}

fn main() {
    var m = Machine { out: text.StrBuf.new(), depth: 3, ..zero };
    io.print_int(m.depth as i64);
    io.print_int(m.name.len as i64);
    io.print_int(if m.sp.is_none() { 0 } else { 1 });
    io.print_int(m.ratio as i64);
    io.print_bool(m.ok);
    io.print_bool(m.last.is_none());
    io.print_int(m.regs[3] as i64);
    io.print_int(m.pair.0 as i64);
    io.print_bool(m.pair.1.is_none());
    io.print_int(m.words.len as i64);
    io.println("");
    io.print_int(CFG.limit + CFG.name.len as i64 + GCFG.limit);
    io.println("");
    m.out.push_str("x");
    io.println(m.out.as_str());

    // A module-qualified struct, trailing comma.
    let s = diag.Span { file: 1, ..zero, };
    io.print_int(s.lo as i64 + s.hi as i64 + s.file as i64);
    io.println("");

    // Pointer fields.
    var v = Vmish { stack: mem.alloc(4), heap: gc.Heap.new(), ..zero };
    io.print_bool(v.stack_end as u64 == 0);
    io.print_bool(v.words as u64 == 0);
    io.print_bool(v.ptrs[1] as u64 == 0);
    io.print_bool(v.cur.is_none());
    io.print_bool(v.hook.is_none());
    v.stack_end = v.stack + 4;
    io.print_int(((v.stack_end as u64) - (v.stack as u64)) as i64);
    io.print_int(NULLS.n + NULLS.p as i64);
    io.print_bool(NULLS.q.is_none());
    io.println("");
    v.heap.free();

    // The empty slice.
    let e: []u32 = [];
    io.print_int(e.len as i64);
    io.print_int(sum([]) as i64);
    let arr = [1 as u32, 2, 3];
    m.words = arr[..];
    io.print_int(sum(m.words) as i64);
    m.words = [];
    io.print_int(sum(m.words) as i64);
    io.println("");
}
// expect: 3000falsetrue00true0
// expect: 7
// expect: x
// expect: 1
// expect: truetruetruetruetrue325true
// expect: 0060
