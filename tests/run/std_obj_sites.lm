// matrix: dispatch
// std.obj's inline-cache state machine in a vm: a GETPROP family with a
// member per IcState (own inline/out of line, prototype, polymorphic,
// megamorphic) and a SETPROP family with cached adds, all driven by
// `read_miss` / `write_miss` over the six cache words of an `obj.Site`.
import std.io;
import std.gc;
import std.mem;
import std.obj;

value Value repr nanbox { Num(f64) unboxed, Int(i32), Nil, O(Gc<Obj>) }
object Obj { shape: Gc<obj.Shape>, dict: ?Gc<obj.Dict>, overflow: ?Gc<Slots>, proto: ?Gc<Obj>, inline: [Value] }
object Slots { data: [Value] }

fn new_slots(h: *gc.Heap, n: u64) -> Gc<Slots> { new(h, Slots {}, n) }

struct Ctx {
    heap: gc.Heap,
    m: obj.Model<Gc<Obj>, Gc<Slots>, Value>,
    /// Receivers PICK cycles through, and the prototype of NEW objects.
    objs: mem.Vec<Gc<Obj>>,
    proto: ?Gc<Obj>,
    misses: i64,
}

fn scan(h: *gc.Heap, data: *u8) {
    let c = data as *Ctx;
    for i in 0..c.objs.len { gc_mark(h, c.objs.at(i)); }
    if let Some(p) = c.proto { gc_mark(h, p); }
}

fn read(c: *Ctx, s: *obj.Site, st: obj.IcState, v: Value, key: u64) -> (Value, obj.IcState) {
    c.misses += 1;
    let O(o) = v else { return (Value.Nil, st); };
    let (r, ns) = c.m.read_miss(s, st, o, key);
    (r ?? Value.Nil, ns)
}

fn write(c: *Ctx, s: *obj.Site, v: Value, key: u64, x: Value) -> obj.IcState {
    c.misses += 1;
    let O(o) = v else { return obj.IcState.Generic; };
    c.m.write_miss(s, o, key, x)
}

vm P {
    context ctx: *Ctx;
    state { pc: *u32, regs: *Value }
    operand reg = regs[it];
    operand imm = it;
    operand label = pc + it;
    encoding fixed(u32) {
        format ABC { op: 8, a: 8, b: 8, c: 8 }
        format AsBx { op: 8, a: 8, sbx: s16 }
    }
    // The words of an obj.Site, which `&cache` passes to std.obj.
    cache PropIC = obj.Site;

    family GETPROP(dst: reg, o: reg, key: imm) : ABC + PropIC {
        generic {
            let (v, st) = read(ctx, &cache, obj.IcState.Generic, o, key as u64);
            dst = v;
            if st == obj.IcState.OwnIn { become GETPROP_IN; }
            if st == obj.IcState.OwnOut { become GETPROP_OUT; }
            if st == obj.IcState.Proto { become GETPROP_P; }
            next
        }
        GETPROP_IN {
            if let O(x) = o and x.shape.id == cache.sid { dst = x.inline.ptr[cache.slot]; next }
            cold { become GETPROP_MISS; redo }
        }
        GETPROP_OUT {
            if let O(x) = o and x.shape.id == cache.sid { dst = ctx.m.load_out(x, cache.slot & !obj.OUT); next }
            cold { become GETPROP_MISS; redo }
        }
        GETPROP_P {
            if let O(x) = o and x.shape.id == cache.sid and let Some(v) = ctx.m.proto_load(x, cache.slot, cache.cell, cache.depth) {
                dst = v;
                next
            }
            cold { become GETPROP_MISS; redo }
        }
        // A monomorphic member missed: refill, or go polymorphic.
        GETPROP_MISS {
            cold {
                let (v, st) = read(ctx, &cache, obj.IcState.OwnIn, o, key as u64);
                dst = v;
                if st == obj.IcState.OwnIn { become GETPROP_IN; }
                if st == obj.IcState.OwnOut { become GETPROP_OUT; }
                if st == obj.IcState.Proto { become GETPROP_P; }
                if st == obj.IcState.Poly { become GETPROP_POLY; }
                if st == obj.IcState.Generic { become GETPROP; }
                next
            }
        }
        GETPROP_POLY {
            if let O(x) = o and let Some(v) = ctx.m.poly_get(x, cache.ent) { dst = v; next }
            cold {
                let (v, st) = read(ctx, &cache, obj.IcState.Poly, o, key as u64);
                dst = v;
                if st == obj.IcState.Mega { become GETPROP_MEGA; }
                next
            }
        }
        GETPROP_MEGA {
            if let O(x) = o and let Some(v) = ctx.m.mega_get(x, key as u64) { dst = v; next }
            cold {
                let (v, st) = read(ctx, &cache, obj.IcState.Mega, o, key as u64);
                dst = v;
                next
            }
        }
    }

    family SETPROP(o: reg, key: imm, v: reg) : ABC + PropIC {
        generic {
            let st = write(ctx, &cache, o, key as u64, v);
            if st == obj.IcState.OwnIn { become SETPROP_IN; }
            if st == obj.IcState.Add { become SETPROP_ADD; }
            next
        }
        SETPROP_IN {
            if let O(x) = o and x.shape.id == cache.sid { x.inline.ptr[cache.slot] = v; next }
            cold { become SETPROP; redo }
        }
        SETPROP_ADD {
            if let O(x) = o and x.shape.id == cache.sid { ctx.m.add_hit(x, cache.ent, cache.slot, v); next }
            cold { become SETPROP; redo }
        }
    }

    op NEW(dst: reg) : ABC {
        let p = ctx.proto;
        dst = Value.O(new(&ctx.heap, Obj { shape: ctx.m.root_for(p, 2), dict: None, overflow: None, proto: p }, 2));
        next
    }
    op PICK(dst: reg, i: reg) : ABC {
        if let Int(n) = i { dst = Value.O(ctx.objs.at(n as u64 % ctx.objs.len)); }
        next
    }
    op ADD(dst: reg, a: reg, b: reg) : ABC {
        if let (Int(x), Int(y)) = (a, b) { dst = Value.Int(x +% y); next }
        dst = Value.Nil;
        next
    }
    op DEC(dst: reg) : ABC {
        if let Int(x) = dst { dst = Value.Int(x - 1); }
        next
    }
    op JPOS(a: reg, target: label) : AsBx {
        if let Int(x) = a and x > 0 { jump target }
        next
    }
    op RET(src: reg) : ABC { exit src }

    entry run(c: *Ctx, code: *u32, r: *Value) -> Value { ctx = c; pc = code; regs = r; jump pc }
}

const KX: u64 = 1;
const KY: u64 = 2;

fn Ctx.obj(c: *Ctx, proto: ?Gc<Obj>, n: u32) -> Gc<Obj> {
    new(&c.heap, Obj { shape: c.m.root_for(proto, n), dict: None, overflow: None, proto: proto }, n as u64)
}

fn int(v: Value) -> i64 { match v { Int(n) => n as i64, _ => -1 } }

/// Run the program `n` times round, with receivers picked from `objs`.
fn go(c: *Ctx, code: *u32, n: i32) -> i64 {
    var regs: [Value; 8] = [Value.Nil; 8];
    regs[1] = Value.Int(0);
    regs[2] = Value.Int(n);
    c.misses = 0;
    int(P.run(c, code, &regs[0]))
}

fn main() uses gc {
    var c = Ctx { heap: gc.Heap.new(), m: obj.Model.new(new_slots, Value.Nil), objs: mem.Vec.new(), proto: None, misses: 0 };
    c.m.attach(&c.heap);
    c.heap.add_scanner(&c as *u8, scan);
    c.m.ic.refills = 3;
    c.m.ic.resets = 1;

    // r0 = receiver, r1 = sum, r2 = counter, r3 = tmp, r4 = new object
    var code: [u32; 64] = [0; 64];
    let s = code[..];
    var at: u64 = 0;
    at = P.emit.NEW(s, at, 4);                // 0
    at = P.emit.SETPROP(s, at, 4, KY as u8, 2);     // 1: r4.y = r2 (an add)
    let set_pc = 1;
    at = P.emit.GETPROP(s, at, 3, 4, KY as u8);     // 8: r3 = r4.y
    let own_pc = at - 7;
    at = P.emit.ADD(s, at, 1, 1, 3);
    at = P.emit.PICK(s, at, 0, 2);
    at = P.emit.GETPROP(s, at, 3, 0, KX as u8);     // r3 = r0.x
    let site = at - 7;
    at = P.emit.ADD(s, at, 1, 1, 3);
    at = P.emit.DEC(s, at, 2);
    at = P.emit.JPOS(s, at, 2, -(at as i16));
    at = P.emit.RET(s, at, 1);

    // 1. One receiver with own x: everything monomorphic.
    let a = c.obj(None, 2);
    c.m.set(a, KX, Value.Int(1));
    c.objs.push(a);
    io.print_int(go(&c, &code[0], 100)); io.println("");
    io.print_int(c.misses); io.println("");
    io.println(P.op_name(code[set_pc]));
    io.println(P.op_name(code[own_pc]));
    io.println(P.op_name(code[site]));

    // 2. x inherited from a prototype two levels up.
    let base = c.obj(None, 2);
    c.m.set(base, KX, Value.Int(2));
    let mid = c.obj(Some(base), 2);
    let r = c.obj(Some(mid), 2);
    c.objs.clear();
    c.objs.push(r);
    io.print_int(go(&c, &code[0], 100)); io.println("");
    io.print_int(c.misses); io.println("");
    io.println(P.op_name(code[site]));
    // The prototype changes: the cell dies, the site refills.
    c.m.set(mid, KX, Value.Int(3));
    io.print_int(go(&c, &code[0], 100)); io.println("");
    io.print_int(c.misses); io.println("");

    // 3. Four shapes alternating. The site's third monomorphic miss (it
    //    counts them over its life) goes polymorphic, keeping the old hit.
    c.objs.clear();
    for i in 0..4 {
        let o = c.obj(Some(mid), 2);
        for k in 0..i as u64 { c.m.set(o, 10 + k, Value.Nil); }
        c.objs.push(o);
    }
    io.print_int(go(&c, &code[0], 100)); io.println("");
    io.print_int(c.misses); io.println("");
    io.println(P.op_name(code[site]));
    io.print_int(go(&c, &code[0], 100)); io.println("");
    io.print_int(c.misses); io.println("");

    // 4. Twelve shapes: the entry fills up, starts over once, then the
    //    site goes megamorphic, where the shared cache hits.
    c.objs.clear();
    for i in 0..12 {
        let o = c.obj(None, 2);
        for k in 0..i as u64 { c.m.set(o, 20 + k, Value.Nil); }
        c.m.set(o, KX, Value.Int(i as i32));
        c.objs.push(o);
    }
    io.print_int(go(&c, &code[0], 120)); io.println("");
    io.println(P.op_name(code[site]));
    io.print_int(go(&c, &code[0], 120)); io.println("");
    io.print_int(c.misses); io.println("");

    // 5. Collections: the NEW objects die every time, and their shapes
    //    with them, but ids are stable: no new misses.
    for i in 0..3 {
        gc.collect(&c.heap);
        io.print_int(go(&c, &code[0], 120)); io.print(" "); io.print_int(c.misses); io.println("");
    }
    io.println(P.op_name(code[own_pc]));

    // 6. NEW objects get a prototype (which has a cell): a new root, so
    //    the add and the read of y miss once each and are cached again
    //    (the objects themselves are not prototypes).
    c.proto = Some(mid);
    io.print_int(go(&c, &code[0], 120)); io.print(" "); io.print_int(c.misses); io.println("");
    io.println(P.op_name(code[set_pc]));
}
// expect: 5150
// expect: 3
// expect: SETPROP_ADD
// expect: GETPROP_IN
// expect: GETPROP_IN
// expect: 5250
// expect: 1
// expect: GETPROP_P
// expect: 5350
// expect: 1
// expect: 5350
// expect: 3
// expect: GETPROP_POLY
// expect: 5350
// expect: 0
// expect: 7920
// expect: GETPROP_MEGA
// expect: 7920
// expect: 0
// expect: 7920 0
// expect: 7920 0
// expect: 7920 0
// expect: GETPROP_IN
// expect: 7920 2
// expect: SETPROP_ADD
