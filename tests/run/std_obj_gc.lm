// std.obj under GC stress: random property writes, deletions, prototype
// changes, dictionary switches and object replacement, with a collection
// after every operation, checked against a host-side model. Slot values
// include references to boxes reachable only through the slots, and
// discarded objects leave dead shapes behind for the sweeper. Cached
// prototype hits (plain words) and read and write sites driven by
// std.obj's cache state machine are checked against fresh lookups after
// every step: an id names a layout forever, and a validity cell dies
// with its object, so no stale entry may ever hit.
import std.io;
import std.gc;
import std.mem;
import std.obj;

value Value repr nanbox { Num(f64) unboxed, Int(i32), Nil, O(Gc<Obj>) }
object Obj { shape: Gc<obj.Shape>, dict: ?Gc<obj.Dict>, overflow: ?Gc<Slots>, proto: ?Gc<Obj>, inline: [Value] }
object Slots { data: [Value] }

fn new_slots(h: *gc.Heap, n: u64) -> Gc<Slots> { new(h, Slots {}, n) }

const N: u64 = 12;
const KEYS: u64 = 6;
const ABSENT: i64 = -1000000;

struct World {
    heap: gc.Heap,
    m: obj.Model<Gc<Obj>, Gc<Slots>, Value>,
    objs: mem.Vec<Gc<Obj>>,
    /// Expected own values: objs × KEYS; ABSENT, n (Int), or n + 1000 (boxed).
    want: mem.Vec<i64>,
    proto: mem.Vec<i64>,
    entries: mem.Vec<obj.Hit>,
    /// Per key: a read site and a write site, with their states.
    rsites: mem.Vec<obj.Site>,
    rstates: mem.Vec<obj.IcState>,
    wsites: mem.Vec<obj.Site>,
    wstates: mem.Vec<obj.IcState>,
    site_hits: u64,
    ekeys: mem.Vec<u64>,
    hits: u64,
    shadows: u64,
    seed: u64,
    errors: u64,
}

fn scan(h: *gc.Heap, data: *u8) {
    let w = data as *World;
    for i in 0..w.objs.len { gc_mark(h, w.objs.at(i)); }
}

fn World.rand(w: *World, n: u64) -> u64 {
    w.seed = w.seed *% 6364136223846793005 +% 1442695040888963407;
    (w.seed >> 33) % n
}

fn World.fresh(w: *World, i: u64) {
    let n = w.rand(4);
    let o = new(&w.heap, Obj { shape: w.m.root(n as u32), dict: None, overflow: None, proto: None }, n);
    w.objs.set(i, o);
    for k in 0..KEYS { w.want.set(i * KEYS + k, ABSENT); }
    w.proto.set(i, -1);
    // Objects that had this one as prototype keep the old object; forget
    // the relation in the model so lookups through it are not checked.
    for j in 0..N { if w.proto.at(j) == i as i64 { w.proto.set(j, -2); } }
    if i > 0 and w.rand(4) != 0 {
        let j = w.rand(i);
        w.m.set_proto(o, Some(w.objs.at(j)));
        w.proto.set(i, j as i64);
    }
}

fn value_of(v: Value) -> i64 {
    match v {
        Int(n) => n as i64,
        O(b) => match b.inline[0] { Int(n) => n as i64 + 1000, _ => -7 },
        _ => -9,
    }
}

fn World.check(w: *World, i: u64) {
    let o = w.objs.at(i);
    var count: u64 = 0;
    for k in 0..KEYS {
        let want = w.want.at(i * KEYS + k);
        let got = match w.m.get(o, k) { Some(v) => value_of(v), None => ABSENT };
        if got != want {
            if w.errors < 5 {
                io.print("mismatch obj "); io.print_int(i as i64); io.print(" key "); io.print_int(k as i64);
                io.print(" want "); io.print_int(want); io.print(" got "); io.print_int(got); io.println("");
            }
            w.errors += 1;
        }
        if want != ABSENT { count += 1; }
        // Through the chain: the nearest object (in the model) with the key.
        var j = i as i64;
        var expect = ABSENT;
        while j >= 0 {
            let x = w.want.at(j as u64 * KEYS + k);
            if x != ABSENT { expect = x; break; }
            j = w.proto.at(j as u64);
        }
        if j == -2 { continue; }
        let chain = match w.m.get_chain(o, k) { Some(v) => value_of(v), None => ABSENT };
        if chain != expect { w.errors += 1; }
    }
    if w.m.len(o) != count { w.errors += 1; }
}

/// Write the cached key somewhere on cached receiver i's chain:
/// shadowing must invalidate the entry, overwriting the holder must not.
fn World.write_chain(w: *World, i: u64) {
    let o = w.objs.at(i);
    let e = w.entries.ptr_at(i);
    if w.m.hit(o, e).is_none() or e.cell == 0 { return; }
    var cur = o.proto;
    var hops = w.rand(3);
    loop {
        let Some(p) = cur else { break; };
        if hops == 0 { break; }
        hops -= 1;
        cur = p.proto;
    }
    let Some(p) = cur else { return; };
    for j in 0..N {
        if w.objs.at(j) == p {
            let n = w.rand(1000) as i32;
            let key = w.ekeys.at(i);
            w.m.set(p, key, Value.Int(n));
            w.want.set(j * KEYS + key, n as i64);
            w.shadows += 1;
        }
    }
}

/// A read site for key `k`, as a vm runs it: the member for the site's
/// state checks its hit, and a miss runs `read_miss`.
fn World.site_read(w: *World, o: Gc<Obj>, i: u64, k: u64) {
    let s = w.rsites.ptr_at(k);
    let st = w.rstates.at(k);
    var v: ?Value = None;
    if (st == obj.IcState.OwnIn or st == obj.IcState.OwnOut) and o.shape.id == s.sid {
        v = Some(w.m.load_ref(o, s.slot));
    } else if st == obj.IcState.Proto and o.shape.id == s.sid {
        v = w.m.proto_load(o, s.slot, s.cell, s.depth);
    } else if st == obj.IcState.Poly {
        v = w.m.poly_get(o, s.ent);
    } else if st == obj.IcState.Mega {
        v = w.m.mega_get(o, k);
    }
    if v.is_some() {
        w.site_hits += 1;
    } else {
        let (x, ns) = w.m.read_miss(s, st, o, k);
        w.rstates.set(k, ns);
        v = x;
    }
    // Absent-property hits give nil (no property holds nil here).
    let got = match v { Some(Nil) => ABSENT, Some(x) => value_of(x), None => ABSENT };
    let fresh = match w.m.get_chain(o, k) { Some(x) => value_of(x), None => ABSENT };
    if got != fresh {
        if w.errors < 5 { io.println("stale read site"); }
        w.errors += 1;
    }
}

/// A write site for key `k`: own stores, cached adds, polymorphic and
/// megamorphic stores.
fn World.site_write(w: *World, o: Gc<Obj>, k: u64, v: Value) {
    let s = w.wsites.ptr_at(k);
    let st = w.wstates.at(k);
    if (st == obj.IcState.Poly and w.m.poly_set(o, s.ent, v)) or (st == obj.IcState.Mega and w.m.mega_set(o, k, v)) {
        w.site_hits += 1;
        return;
    }
    if (st == obj.IcState.OwnIn or st == obj.IcState.OwnOut) and o.shape.id == s.sid {
        w.m.store_ref(o, s.slot, v);
        w.site_hits += 1;
        return;
    }
    if st == obj.IcState.Add and o.shape.id == s.sid {
        w.m.add_hit(o, s.ent, s.slot, v);
        w.site_hits += 1;
        return;
    }
    let from = if st == obj.IcState.Add or (st != obj.IcState.Poly and st != obj.IcState.Mega and w.rand(2) == 0) { obj.IcState.Generic } else { st };
    w.wstates.set(k, w.m.write_miss_in(s, from, o, k, v));
}

fn World.step(w: *World) {
    let i = w.rand(N);
    let o = w.objs.at(i);
    let k = w.rand(KEYS);
    match w.rand(18) {
        0 | 1 | 2 | 3 | 4 | 5 => {
            let n = w.rand(1000) as i32;
            w.m.set(o, k, Value.Int(n));
            w.want.set(i * KEYS + k, n as i64);
        }
        6 | 7 => {
            // A box reachable only from the slot.
            let n = w.rand(1000) as i32;
            let b = new(&w.heap, Obj { shape: w.m.root(1), dict: None, overflow: None, proto: None }, 1);
            w.m.set(b, 0, Value.Int(n));
            w.m.set(o, k, Value.O(b));
            w.want.set(i * KEYS + k, n as i64 + 1000);
        }
        8 | 9 => {
            let had = w.want.at(i * KEYS + k) != ABSENT;
            if w.m.delete(o, k) != had { w.errors += 1; }
            w.want.set(i * KEYS + k, ABSENT);
        }
        10 => {
            // A prototype with a lower index (no cycles), or none.
            let j = w.rand(N);
            if j < i {
                w.m.set_proto(o, Some(w.objs.at(j)));
                w.proto.set(i, j as i64);
            } else {
                w.m.set_proto(o, None);
                w.proto.set(i, -1);
            }
        }
        11 => { if w.rand(2) == 0 { w.m.to_dict(o); } else { w.m.optimize(o); } }
        13 => {
            // Twice: the second read usually hits.
            w.site_read(o, i, k);
            w.site_read(o, i, k);
        }
        14 => {
            // Twice: an add (or a store), then a store.
            let n = w.rand(1000) as i32;
            w.site_write(o, k, Value.Int(n));
            w.site_write(o, k, Value.Int(n + 1));
            w.want.set(i * KEYS + k, n as i64 + 1);
        }
        12 => w.fresh(i),
        _ => {
            // A cached prototype read, then a hit check on the same receiver.
            let e = w.entries.ptr_at(i);
            let v = w.m.read(o, k, e);
            w.ekeys.set(i, k);
            if let Some(hv) = w.m.hit(o, e) and let Some(x) = v {
                if value_of(hv) != value_of(x) { w.errors += 1; }
            }
            if w.rand(2) == 0 { w.write_chain(i); }
        }
    }
    // Every cached entry that still hits must agree with a fresh lookup.
    for j in 0..N {
        let e = w.entries.ptr_at(j);
        let oj = w.objs.at(j);
        if let Some(hv) = w.m.hit(oj, e) {
            w.hits += 1;
            let fresh = match w.m.get_chain(oj, w.ekeys.at(j)) { Some(v) => value_of(v), None => ABSENT };
            if fresh != value_of(hv) {
                if w.errors < 5 { io.println("stale prototype cache entry"); }
                w.errors += 1;
            }
        }
    }
    w.check(i);
}

fn main() uses gc {
    var w = World {
        heap: gc.Heap.new(),
        m: obj.Model.new(new_slots, Value.Nil),
        objs: mem.Vec.new(), want: mem.Vec.new(), proto: mem.Vec.new(), entries: mem.Vec.new(), ekeys: mem.Vec.new(), hits: 0, shadows: 0,
        rsites: mem.Vec.new(), rstates: mem.Vec.new(), wsites: mem.Vec.new(), wstates: mem.Vec.new(), site_hits: 0,
        seed: 12345, errors: 0,
    };
    w.m.attach(&w.heap);
    w.m.dict_threshold = 12;
    // Small budgets, so sites go through every state.
    w.m.ic.refills = 2;
    w.m.ic.resets = 2;
    w.m.ic.absent = true;
    // Keep few dead ids, so the table forgets now and then.
    w.m.shapes.retain = 64;
    for k in 0..KEYS {
        w.rsites.push(obj.Site { sid: 0, slot: 0, cell: 0, depth: 0, ent: 0, miss: 0 });
        w.rstates.push(obj.IcState.Generic);
        w.wsites.push(obj.Site { sid: 0, slot: 0, cell: 0, depth: 0, ent: 0, miss: 0 });
        w.wstates.push(obj.IcState.Generic);
    }
    w.heap.add_scanner(&w as *u8, scan);
    w.heap.set_stress(true);
    let tmp = new(&w.heap, Obj { shape: w.m.root(0), dict: None, overflow: None, proto: None }, 0);
    for i in 0..N {
        w.objs.push(tmp);
        w.proto.push(-1);
        w.entries.push(obj.Hit.empty());
        w.ekeys.push(0);
        for k in 0..KEYS { w.want.push(ABSENT); }
    }
    for i in 0..N { w.fresh(i); }
    for step in 0..10000 {
        w.step();
        gc.maybe_collect(&w.heap);
    }
    for i in 0..N { w.check(i); }
    io.print("errors "); io.print_int(w.errors as i64); io.println("");
    io.print_bool(w.heap.collections >= 10000); io.println("");
    io.print_bool(w.m.shapes.swept > 0); io.println("");
    io.print_bool(w.hits > 200 and w.shadows > 20); io.println("");
    io.print_bool(w.site_hits > 200); io.println("");
    var mega = false;
    for k in 0..KEYS { if w.rstates.at(k) == obj.IcState.Mega { mega = true; } }
    io.print_bool(mega and w.m.shapes.reborn > 0 and w.m.shapes.forgotten > 0); io.println("");
}
// expect: errors 0
// expect: true
// expect: true
// expect: true
// expect: true
// expect: true
