// `verify` clauses are pasted into the generated verifier. A verify
// context whose name the verifier also uses for itself (here `w`, which
// held the instruction word) must still mean the context.
import std.io;

vm V {
    state { pc: *u32, regs: *i64 }
    verify_context w: u32;
    verify_context code: u32;

    operand reg = regs[it] verify (it as u32) < w;
    operand kst = it verify (it as u32) < code;

    encoding fixed(u32) { format ABC { op: 8, a: 8, b: 8, c: 8 } }

    op LOADK(dst: reg, k: kst) : ABC { dst = k as i64; next }
    op RET(a: reg) : ABC { exit a }

    entry run(c: *u32, r: *i64) -> i64 { pc = c; regs = r; jump pc }
}

fn show(r: ?u64) {
    match r {
        None => io.println("ok"),
        Some(i) => { io.print("bad at "); io.print_int(i as i64); io.println(""); }
    }
}

fn main() {
    var code: [u32; 2] = [V.LOADK(1, 2), V.RET(1)];
    show(V.verify(code[..], 2, 3));
    code[0] = V.LOADK(5, 2);             // register 5 of 2
    show(V.verify(code[..], 2, 3));
    code[0] = V.LOADK(1, 3);             // constant 3 of 3
    show(V.verify(code[..], 2, 3));
}
// expect: ok
// expect: bad at 0
// expect: bad at 0
