                    let x162: i64 = vf1(kk, (Pair { a: mk(c, 1, None, None), b: Some(mk(c, 3, None, None)), k: kk }).a);
                    acc = mix(acc, da([none(), Some(x160)]));
                } else {
                    let E.Two(x164, x165) = E.Pr((Pair { a: mk(c, 17, None, None), b: Some(mk(c, 17, None, None)), k: kk })) else {
                        let x163: (Gc<Node>, i64) = x121;
                        next
                    };
                }
            }
            raise (acc % 13)
        };
            acc += gc(c);
            acc = mix(acc, dn(x166));
            acc = mix(acc, dn(x167));
        next
    }
    op OP2(k: imm) : N {
        let kk: i64 = k as i64;
        let Some(x172) = (Some(mk(c, 2, None, None)) ?? mk(c, 0, None, None)).l else cold {
            acc = mix(acc, da([Some(mk(c, 5, None, None)), Some(mk(c, 19, None, None))]));
            var w168: ?Gc<Node> = cur;
            var s169: i64 = 0;
            while let Some(x170) = w168 {
                s169 += 1;
                if s169 > 3 { break; }
                w168 = x170.l;
                let x171: E = E.Pr((Pair { a: x170, b: Some(mk(c, 3, None, None)), k: kk }));
            }
            next
        };
            acc += gc(c);
            acc = mix(acc, dn(x172));
        var s174: i64 = 0;
        let x175: Gc<Node> = loop {
            s174 += 1;
            if s174 > 2 { break pick(mk(c, kk, none(), Some(mk(c, 15, None, None))), (Pair { a: mk(c, 19, None, None), b: none(), k: kk }).a, kk); }
            defer { c.sum = mix(c.sum, da([none(), none()])); gc(c); }
            var x176: ?Gc<Node> = [none(), Some(mk(c, 8, None, None))][1];
            let E.One(x179) = E.Two(x172, x172) else cold {
                let Some(x177) = none() else {
                    next
                };
                    acc += gc(c);
                    acc = mix(acc, dn(x177));
                raise 13
            };
                acc += gc(c);
                acc = mix(acc, dn(x179));
            if kk % 2 == 0 { break x172; }
        };
        next
    }
    op HALT() : N { exit (acc + dig(cur, 3) + dv(tos)) % MD }

    operand imm = it;

    on raise(e: i64) {
        let x181: (Gc<Node>, i64) = (pick(mk(c, 12, None, None), mk(c, 5, None, None), e), e);
        exit (acc + e) % MD
    }

    entry run(cx: *Ctx, code: *u32) -> i64 uses gc { c = cx; pc = code; acc = 0; cur = None; tos = V.Nil; jump code }
}

fn main() uses gc {
    let mode = os.arg_count();
    var c = Ctx { heap: gc.Heap.new(), keep: None, sum: 0, fuel: 0, leaks: 0, gen: false, gcs: 0 };
    c.heap.add_scanner(&c as *u8, scan);
    if mode == 2 { c.heap.set_stress(true); }
    if mode == 3 { c.heap.set_generational(true); c.heap.set_stress(true); c.heap.set_verify(true); c.gen = true; }
    c.fuel = 40;
    io.print_int(dv(f0(&c, 1, mk(&c, 1, None, None), None)));
    io.println(" f0");
    c.fuel = 40;
    io.print_int(dv(f0(&c, 5, mk(&c, 2, None, None), Some(mk(&c, 4, None, None)))));
    io.println(" f0");
    c.fuel = 40;
    io.print_int(dv(f1(&c, 16, mk(&c, 1, None, None), None)));
    io.println(" f1");
    c.fuel = 40;
    io.print_int(dv(f1(&c, 10, mk(&c, 2, None, None), Some(mk(&c, 4, None, None)))));
    io.println(" f1");
    c.fuel = 40;
    io.print_int(dv(f2(&c, 0, mk(&c, 1, None, None), None)));
    io.println(" f2");
    c.fuel = 40;
    io.print_int(dv(f2(&c, 18, mk(&c, 2, None, None), Some(mk(&c, 4, None, None)))));
    io.println(" f2");
    c.fuel = 40;
    io.print_int(((f3(&c, 19, mk(&c, 1, None, None), None)) % MD + MD) % MD);
    io.println(" f3");
    c.fuel = 40;
    io.print_int(((f3(&c, 10, mk(&c, 2, None, None), Some(mk(&c, 4, None, None)))) % MD + MD) % MD);
    io.println(" f3");
    {
        var code: [u32; 8] = [M.OP0(4), M.OP1(9), M.OP0(3), M.OP0(19), M.OP1(0), M.OP1(16), M.OP1(10), M.HALT()];
        for i in 0..2 {
            c.fuel = 40;
            io.print_int(M.run(&c, &code[0]));
            io.println(" vm0");
        }
    }
    {
        var code: [u32; 7] = [M.OP0(9), M.OP2(9), M.OP0(5), M.OP2(3), M.OP0(11), M.OP2(9), M.HALT()];
        for i in 0..2 {
            c.fuel = 40;
            io.print_int(M.run(&c, &code[0]));
            io.println(" vm1");
        }
    }
    {
        var code: [u32; 3] = [M.OP1(8), M.OP2(2), M.HALT()];
        for i in 0..2 {
            c.fuel = 40;
            io.print_int(M.run(&c, &code[0]));
            io.println(" vm2");
        }
    }
    io.print_int(c.sum);
    io.println(" sum");
    io.print("leaks ");
    io.print_int(if c.gen { 0 } else { c.leaks });
    io.println("");
    c.heap.free();
}
