// std.obj: shapes, transitions, overflow slots, dictionary mode,
// prototype chains with validity cells, cache helpers, and weak
// transitions after a collection.
import std.io;
import std.gc;
import std.mem;
import std.obj;

value Value repr nanbox { Num(f64) unboxed, Int(i32), Nil, O(Gc<Obj>) }
object Obj { shape: Gc<obj.Shape>, dict: ?Gc<obj.Dict>, overflow: ?Gc<Slots>, proto: ?Gc<Obj>, inline: [Value] }
object Slots { data: [Value] }

fn new_slots(h: *gc.Heap, n: u64) -> Gc<Slots> { new(h, Slots {}, n) }

struct World { heap: gc.Heap, m: obj.Model<Gc<Obj>, Gc<Slots>, Value> }

fn World.obj(w: *World, proto: ?Gc<Obj>, n: u32) -> Gc<Obj> {
    new(&w.heap, Obj { shape: w.m.root_for(proto, n), dict: None, overflow: None, proto: proto }, n as u64)
}

fn int(v: ?Value) -> i64 {
    match v {
        Some(Int(i)) => i as i64,
        Some(Nil) => -1,
        None => -2,
        _ => -3,
    }
}

fn show(label: str, x: i64) { io.print(label); io.print(" "); io.print_int(x); io.println(""); }
fn yes(label: str, b: bool) { io.print(label); io.print(" "); io.print_bool(b); io.println(""); }

const X: u64 = 1;
const Y: u64 = 2;
const Z: u64 = 3;
const METHOD: u64 = 100;

fn shapes(w: *World) {
    let a = w.obj(None, 2);
    let b = w.obj(None, 2);
    let c = w.obj(None, 2);
    w.m.set(a, X, Value.Int(1));
    w.m.set(a, Y, Value.Int(2));
    w.m.set(b, X, Value.Int(10));
    w.m.set(b, Y, Value.Int(20));
    w.m.set(c, Y, Value.Int(200));
    w.m.set(c, X, Value.Int(100));
    yes("same order shares a shape", a.shape.id == b.shape.id);
    yes("other order differs", a.shape.id != c.shape.id);
    show("a.y", int(w.m.get(a, Y)));
    show("c.x", int(w.m.get(c, X)));
    show("missing", int(w.m.get(a, Z)));
    // Overflow: two inline slots, then out of line.
    for k in 10..20 { w.m.set(a, k as u64, Value.Int(k as i32)); }
    show("a.15", int(w.m.get(a, 15)));
    show("len", w.m.len(a) as i64);
    yes("slot 1 inline", obj.slot_ref(1, 2) == 1);
    yes("slot 2 out of line", obj.slot_ref(2, 2) == (0 | obj.OUT));
    // Overwrite keeps the shape.
    let sid = a.shape.id;
    w.m.set(a, 15, Value.Int(-15));
    yes("overwrite keeps shape", a.shape.id == sid);
    show("a.15", int(w.m.get(a, 15)));
    // Deleting the last property steps back to the parent shape.
    let before = b.shape.id;
    w.m.set(b, Z, Value.Int(30));
    yes("delete last", w.m.delete(b, Z));
    yes("back to parent", b.shape.id == before);
    yes("delete absent", !w.m.delete(b, Z));
    // Deleting another property switches to dictionary mode.
    yes("delete x", w.m.delete(a, X));
    yes("dict", w.m.is_dict(a));
    show("a.x", int(w.m.get(a, X)));
    show("a.y", int(w.m.get(a, Y)));
    show("a.19", int(w.m.get(a, 19)));
    for k in 20..60 { w.m.set(a, k as u64, Value.Int(k as i32)); }
    for k in 20..50 { w.m.delete(a, k as u64); }
    w.m.set(a, X, Value.Int(7));
    show("len", w.m.len(a) as i64);
    var keys: mem.Vec<u64> = mem.Vec.new();
    w.m.keys(a, &keys);
    io.print("keys");
    for i in 0..keys.len { io.print(" "); io.print_int(keys.at(i) as i64); }
    io.println("");
    // Back to a fast object: keys and values survive, in order.
    w.m.optimize(a);
    yes("fast again", !w.m.is_dict(a));
    var sum: i64 = 0;
    for i in 0..keys.len { sum += int(w.m.get(a, keys.at(i))); }
    show("sum", sum);
    var keys2: mem.Vec<u64> = mem.Vec.new();
    w.m.keys(a, &keys2);
    var same = keys.len == keys2.len;
    for i in 0..keys.len { if keys.at(i) != keys2.at(i) { same = false; } }
    yes("same keys", same);
    keys.free();
    keys2.free();
    // The threshold: many properties go to dictionary mode.
    let big = w.obj(None, 4);
    for k in 0..100 { w.m.set(big, k as u64, Value.Int(k as i32 * 2)); }
    yes("big is dict", w.m.is_dict(big));
    show("big.99", int(w.m.get(big, 99)));
    // Long fast chains use a lookup table.
    let long = w.obj(None, 4);
    for k in 0..40 { w.m.set(long, (1000 + k) as u64, Value.Int(k as i32)); }
    yes("long is fast", !w.m.is_dict(long));
    show("long.1033", int(w.m.get(long, 1033)));
    show("long.999", int(w.m.get(long, 999)));
}

fn caches(w: *World) {
    let a = w.obj(None, 1);
    w.m.set(a, X, Value.Int(1));
    w.m.set(a, Y, Value.Int(2));
    let b = w.obj(None, 1);
    w.m.set(b, X, Value.Int(3));
    w.m.set(b, Y, Value.Int(4));
    // Monomorphic: fill from a, hit on b.
    var cs: u32 = obj.EMPTY_ID;
    var cr: u32 = 0;
    show("fill", int(w.m.get_fill(a, Y, &cs, &cr)));
    yes("out of line", cr & obj.OUT != 0);
    yes("hit", b.shape.id == cs);
    show("hit value", int(Some(w.m.load_ref(b, cr))));
    w.m.set_fill(b, Y, Value.Int(44), &cs, &cr);
    w.m.store_ref(b, cr, Value.Int(45));
    show("stored", int(w.m.get(b, Y)));
    // A dictionary-mode object never fills the cache.
    w.m.to_dict(b);
    var ds: u32 = obj.EMPTY_ID;
    var dr: u32 = 0;
    show("dict get", int(w.m.get_fill(b, X, &ds, &dr)));
    yes("not filled", ds == obj.EMPTY_ID and b.shape.id != cs);
    // Polymorphic and megamorphic.
    var p = obj.Poly.new();
    var ha = obj.Hit { sid: a.shape.id, slot: cr, cell: 0, depth: 0 };
    yes("poly add", p.add(&ha));
    yes("poly find", p.find(a.shape.id).is_some() and p.find(12345).is_none());
    var mc = obj.MegaCache.new(256);
    show("mega miss", int(w.m.get_mega(&mc, a, X)));
    yes("mega filled", mc.get(a.shape.id, X).is_some());
    show("mega hit", int(w.m.get_mega(&mc, a, X)));
    mc.free();
}

fn protos(w: *World) {
    let base = w.obj(None, 2);
    w.m.set(base, METHOD, Value.Int(1));
    let mid = w.obj(Some(base), 2);
    w.m.set(mid, X, Value.Int(5));
    let o1 = w.obj(Some(mid), 2);
    let o2 = w.obj(Some(mid), 2);
    w.m.set(o1, Y, Value.Int(1));
    w.m.set(o2, Y, Value.Int(2));
    let o3 = w.obj(Some(base), 2);
    w.m.set(o3, Y, Value.Int(3));
    yes("proto in shape", o1.shape.id == o2.shape.id and o1.shape.id != o3.shape.id);
    show("chain", int(w.m.get_chain(o1, METHOD)));
    match w.m.lookup(o1, X) {
        Proto(h, _) => yes("found on mid", h == mid),
        _ => io.println("wrong"),
    }
    let mid_sid = mid.shape.id;
    var e = obj.Hit.empty();
    show("fill", int(w.m.read(o1, METHOD, &e)));
    yes("cached on o1's shape", e.sid == o1.shape.id and e.cell != 0 and e.depth == 2);
    // Prototypes with cells moved to the prototype tree; o1 did not.
    yes("protos flagged", w.m.is_proto(mid) and w.m.is_proto(base) and !w.m.is_proto(o1));
    yes("mid's shape changed", mid.shape.id != mid_sid and mid.shape.count == 1);
    show("mid.x", int(w.m.get(mid, X)));
    show("hit on o2", int(w.m.hit(o2, &e)));
    show("miss on o3", int(w.m.hit(o3, &e)));
    // Overwriting the value on the holder keeps the entry valid.
    w.m.set(base, METHOD, Value.Int(2));
    show("value change", int(w.m.hit(o2, &e)));
    // Shadowing on mid invalidates it.
    w.m.set(mid, METHOD, Value.Int(3));
    show("after shadowing", int(w.m.hit(o2, &e)));
    show("refill", int(w.m.read(o1, METHOD, &e)));
    yes("depth 1", e.depth == 1);
    show("hit", int(w.m.hit(o2, &e)));
    // A change above the holder (a new key on base) invalidates too.
    w.m.read(o1, X, &e);
    show("hit x", int(w.m.hit(o2, &e)));
    w.m.set(base, Z, Value.Int(0));
    show("after base change", int(w.m.hit(o2, &e)));
    // Own properties: cell 0.
    w.m.read(o1, Y, &e);
    yes("own hit", e.cell == 0 and int(w.m.hit(o2, &e)) == 2);
    // Changing a prototype moves the object to the new prototype's tree.
    w.m.set_proto(o3, Some(mid));
    yes("o3 now like o1", o3.shape.id == o1.shape.id);
    show("o3.x", int(w.m.get_chain(o3, X)));
    show("o3.y", int(w.m.get(o3, Y)));
    // Templates learn the final size.
    var t = obj.Template.new(0, 0);
    let first = new(&w.heap, Obj { shape: w.m.template_root(&t), dict: None, overflow: None, proto: None }, t.inline as u64);
    for k in 0..5 { w.m.set(first, k as u64, Value.Int(k as i32)); }
    w.m.observe(&t, first);
    show("template inline", t.inline as i64);
}

fn scan(h: *gc.Heap, data: *u8) {
    let keep = data as *mem.Vec<Gc<Obj>>;
    for i in 0..keep.len { gc_mark(h, keep.at(i)); }
}

/// Shapes nobody uses are collected; their edges are cleared, and the
/// tree is rebuilt on demand.
/// `keep` is a root for as long as the heap lives: the heap keeps its
/// address, so it is `main`'s (a local of `weak` registered here would
/// dangle once `weak` returned).
fn weak(w: *World, keep: *mem.Vec<Gc<Obj>>) uses gc {
    let a = w.obj(None, 3);
    keep.push(a);
    w.m.set(a, X, Value.Int(1));
    var id5000: u32 = 0;
    for i in 0..200 {
        let t = w.obj(None, 3);
        w.m.set(t, X, Value.Int(1));
        w.m.set(t, (5000 + i) as u64, Value.Int(2));
        if i == 0 { id5000 = t.shape.id; }
    }
    let created = w.m.shapes.created;
    let swept = w.m.shapes.swept;
    gc.collect(&w.heap);
    yes("swept shapes", w.m.shapes.swept - swept >= 200);
    let b = w.obj(None, 3);
    keep.push(b);
    w.m.set(b, X, Value.Int(1));
    yes("x shape kept", a.shape.id == b.shape.id);
    w.m.set(b, 5000, Value.Int(2));
    yes("new shape made", w.m.shapes.created == created + 1);
    yes("with the old id", b.shape.id == id5000);
    show("b", int(w.m.get(b, 5000)));
    gc.collect(&w.heap);
    show("a.x", int(w.m.get(a, X)));
}

fn main() uses gc {
    var w = World { heap: gc.Heap.new(), m: obj.Model.new(new_slots, Value.Nil) };

    w.m.attach(&w.heap);
    w.m.dict_threshold = 64;
    shapes(&w);
    caches(&w);
    protos(&w);
    var keep: mem.Vec<Gc<Obj>> = mem.Vec.new();
    w.heap.add_scanner(&keep as *u8, scan);
    weak(&w, &keep);
}
