                        None => if fits { bad("i63", "add none", a64, b64); fails += 1; },
                    }
                }
                None => if a.add_checked(b).is_some() { bad("i63", "add some", a64, b64); fails += 1; },
            }
            if (a +% b) as i64 != (((a64 +% b64) << 1) >> 1) { bad("i63", "add wrap", a64, b64); fails += 1; }
            match a64.sub_checked(b64) {
                Some(r) => {
                    let fits = r >= lo and r <= hi;
                    match a.sub_checked(b) {
                        Some(x) => if !fits or x as i64 != r { bad("i63", "sub", a64, b64); fails += 1; },
                        None => if fits { bad("i63", "sub none", a64, b64); fails += 1; },
                    }
                }
                None => if a.sub_checked(b).is_some() { bad("i63", "sub some", a64, b64); fails += 1; },
            }
            if (a -% b) as i64 != (((a64 -% b64) << 1) >> 1) { bad("i63", "sub wrap", a64, b64); fails += 1; }
            match a64.mul_checked(b64) {
                Some(r) => {
                    let fits = r >= lo and r <= hi;
                    match a.mul_checked(b) {
                        Some(x) => if !fits or x as i64 != r { bad("i63", "mul", a64, b64); fails += 1; },
                        None => if fits { bad("i63", "mul none", a64, b64); fails += 1; },
                    }
                }
                None => if a.mul_checked(b).is_some() { bad("i63", "mul some", a64, b64); fails += 1; },
            }
            if (a *% b) as i64 != (((a64 *% b64) << 1) >> 1) { bad("i63", "mul wrap", a64, b64); fails += 1; }
            if (a < b) != (a64 < b64) or (a <= b) != (a64 <= b64) or (a == b) != (a64 == b64) or (a > b) != (a64 > b64) { bad("i63", "cmp", a64, b64); fails += 1; }
            if b64 != 0 and !(a64 == lo and b64 == -1) {
                if (a / b) as i64 != a64 / b64 or (a % b) as i64 != a64 % b64 { bad("i63", "div", a64, b64); fails += 1; }
                if b > (0 as i63) and (a / b) as i64 != a64 / b64 { bad("i63", "div pos", a64, b64); fails += 1; }
            }
            let s = (b64 as u64 % 63) as i63;
            let s64 = (b64 as u64 % 63) as i64;
            if (a << s) as i64 != (((a64 << s64) << 1) >> 1) { bad("i63", "shl", a64, b64); fails += 1; }
            if (a >> s) as i64 != a64 >> s64 { bad("i63", "shr", a64, b64); fails += 1; }
        }
        let a64 = vs[i] + z;
        let a = a64 as i63;
        if ((0 as i63) -% a) as i64 != (((0 -% a64) << 1) >> 1) { bad("i63", "neg", a64, 0); fails += 1; }
        match (0 as i63).sub_checked(a) {
            Some(x) => if 0 - a64 < lo or 0 - a64 > hi or x as i64 != 0 - a64 { bad("i63", "neg checked", a64, 0); fails += 1; },
            None => if 0 - a64 >= lo and 0 - a64 <= hi { bad("i63", "neg none", a64, 0); fails += 1; },
        }
        if (a as f64) != (a64 as f64) { bad("i63", "to f64", a64, 0); fails += 1; }
    }
    fails
}

#[inline(never)]
