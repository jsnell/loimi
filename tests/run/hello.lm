import std.io;

struct Point { x: f64, y: f64 }

fn Point.norm2(p: *Point) -> f64 { p.x * p.x + p.y * p.y }

enum Shape { Circle(f64), Rect(f64, f64), Empty }

fn area(s: Shape) -> f64 {
    match s {
        Circle(r) => 3.0 * r * r,
        Rect(w, h) => w * h,
        Empty => 0.0,
    }
}

fn fib(n: i64) -> i64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn find(xs: []i64, want: i64) -> ?u64 {
    for i in 0..xs.len {
        if xs[i] == want { return Some(i); }
    }
    None
}

fn main() {
    io.println("hello, loimi");
    io.print_int(fib(20)); io.println("");
    var p = Point { x: 3.0, y: 4.0 };
    io.print_f64(p.norm2()); io.println("");
    p.x = 1.5;
    io.print_f64(p.x); io.println("");
    io.print_f64(area(Shape.Rect(2.0, 3.5))); io.println("");
    io.print_f64(area(.Circle(1.0))); io.println("");
    io.print_f64(area(Shape.Empty)); io.println("");
    let arr = [5, 7, 9, 11];
    if let Some(i) = find(arr[..], 9) { io.print_int(i as i64); io.println(""); }
    io.print_bool(find(arr[..], 4).is_none()); io.println("");
    var total = 0;
    var i = 0;
    while i < 10 { total += i; i += 1; }
    io.print_int(total); io.println("");
    let t = (1, 2.5, true);
    io.print_f64(t.1); io.println("");
    let big: i32 = 2147483647;
    match big.add_checked(1) {
        Some(v) => io.print_int(v as i64),
        None => io.print("overflow"),
    }
    io.println("");
    io.print_int(-42); io.println("");
}
// expect: hello, loimi
// expect: 6765
// expect: 25
// expect: 1.5
// expect: 7
// expect: 3
// expect: 0
// expect: 2
// expect: true
// expect: 45
// expect: 2.5
// expect: overflow
// expect: -42
