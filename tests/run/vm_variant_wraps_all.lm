// matrix: dispatch
// `variant .. wraps all` on a vm with many ops, loops in handlers and two
// entries, only one of which switches tables. In goto mode the entry
// that never switches used to get every wrapper block too, unreachable
// but still there for most of LLVM's pipeline, and loop strength
// reduction then took minutes on the tutorial's interpreter. Entries
// that cannot reach a `use_variant` now get no wrappers. (Ops that
// switch tables, which every entry may then reach: vm_variants.lm.)
import std.io;

struct M { steps: i64, sum: i64 }

vm V {
    context ctx: *M;
    state { pc: *u32, regs: *i64 }

    operand reg = regs[it];
    operand imm = it;
    operand label = pc + it;

    encoding fixed(u32) {
        format ABC { op: 8, a: 8, b: 8, c: 8 }
        format AsBx { op: 8, a: 8, sbx: s16 }
    }

    op LOADI(dst: reg, v: imm) : AsBx { dst = v as i64; next }
    // Many ops with a loop each, as an interpreter's list and string ops have.
    inline for (name, k) in [(F0, 1), (F1, 2), (F2, 3), (F3, 4), (F4, 5), (F5, 6), (F6, 7), (F7, 8),
                             (F8, 9), (F9, 10), (F10, 11), (F11, 12), (F12, 13), (F13, 14), (F14, 15), (F15, 16),
                             (F16, 17), (F17, 18), (F18, 19), (F19, 20), (F20, 21), (F21, 22), (F22, 23), (F23, 24),
                             (F24, 25), (F25, 26), (F26, 27), (F27, 28), (F28, 29), (F29, 30), (F30, 31), (F31, 32),
                             (F32, 33), (F33, 34), (F34, 35), (F35, 36), (F36, 37), (F37, 38), (F38, 39), (F39, 40)] {
        op #name(dst: reg, base: reg, n: imm) : ABC {
            var s: i64 = 0;
            for i in 0..n { s += regs[base.raw + i] * k; }
            dst = s;
            next
        }
    }
    op ADD(dst: reg, a: reg, b: reg) : ABC { dst = a + b; next }
    op JNZ(a: reg, t: label) : AsBx { if a != 0 { jump t } next }
    op RET(src: reg) : ABC { exit src }

    variant counted wraps all {
        before { ctx.steps += 1; }
    }

    entry run(m: *M, code: *u32, r: *i64) -> i64 {
        ctx = m;
        pc = code;
        regs = r;
        jump pc
    }
    entry run_counted(m: *M, code: *u32, r: *i64) -> i64 {
        use_variant counted;
        ctx = m;
        pc = code;
        regs = r;
        jump pc
    }
}

fn main() {
    var m = M { steps: 0, sum: 0 };
    var code: [u32; 32] = [0; 32];
    var regs: [i64; 8] = [0; 8];
    var at: u64 = 0;
    at = V.emit.LOADI(code[..], at, 0, 1);
    at = V.emit.LOADI(code[..], at, 1, 2);
    at = V.emit.LOADI(code[..], at, 2, 3);
    at = V.emit.F0(code[..], at, 3, 0, 3);      // 6
    at = V.emit.F39(code[..], at, 4, 0, 2);     // 3 * 40
    at = V.emit.ADD(code[..], at, 5, 3, 4);
    at = V.emit.RET(code[..], at, 5);
    io.print_int(V.run(&m, &code[0], &regs[0])); io.println("");
    io.print_int(m.steps); io.println("");
    io.print_int(V.run_counted(&m, &code[0], &regs[0])); io.println("");
    io.print_int(m.steps); io.println("");
}
// expect: 126
// expect: 0
// expect: 126
// expect: 7
