// A store through a sub-slice of an object's trailing array or array field
// (`a.items[1..3][0] = v`) gets the write barrier; it used to have none,
// and verify mode aborted with "missing write barrier". Bounds are still
// checked.
import std.io;
import std.gc;

object Node { value: i64, next: ?Gc<Node> }
object Arr { fixed: [?Gc<Node>; 4], items: [?Gc<Node>] }

fn young(h: *gc.Heap, v: i64) -> Gc<Node> { new(h, Node { value: v, next: None }) }
fn age(h: *gc.Heap) uses gc { gc.collect(h); gc.collect(h); }

fn main() uses gc {
    var heap = gc.Heap.new();
    let h = &heap;
    h.set_generational(true);
    h.set_verify(true);
    let a = new(h, Arr { fixed: [None, None, None, None] }, 4);
    age(h);
    a.items[1..3][0] = Some(young(h, 1));
    age(h);
    a.items[2..][..2][1] = Some(young(h, 2));
    age(h);
    a.fixed[1..][2] = Some(young(h, 3));
    age(h);
    var t = 0;
    for i in 0..4 {
        if let Some(n) = a.items[i] { t += n.value * 10; }
        if let Some(n) = a.fixed[i] { t += n.value; }
    }
    io.print_int(t); io.println("");
    a.items[3..][1] = None;
    io.println("not reached");
}

// expect: 33
// expect-exit: 134
// expect-stderr: index out of bounds
