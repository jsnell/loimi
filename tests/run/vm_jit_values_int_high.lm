// matrix: jit
// The JIT's stencil variants per constant tag for `nanbox(int_high)`:
// their mask tests rotate with the words (a shared block's 3-bit tag
// sits above the 16-bit low tag), and the unboxed float gets no stencil
// variant (its test is no mask test of the stored word). Same output as
// vm_jit_values_shared.lm, with the JIT on and off.
import std.io;
import std.gc;

object Str { data: [u8] }
object Cell { v: i64 }
object Box { n: i64 }
object O1 { n: i64 }
object O2 { n: i64 }
object O3 { n: i64 }
object O4 { n: i64 }
object O5 { n: i64 }
object Arr { items: [V] }
object Proto { consts: Gc<Arr>, code: verified [u32] by M }

#[allow(value_layout)]
value V repr nanbox(int_high) {
    Num(f64) unboxed,
    Int(i48),
    Nil,
    A1(Gc<O1>), A2(Gc<O2>), A3(Gc<O3>), A4(Gc<O4>), A5(Gc<O5>),
    Cell(Gc<Cell>),
    Str(Gc<Str>),
    Box(Gc<Box>),
}

#[require_verified]
vm M {
    state { pc: *u32, regs: *V, k: *V }
    verify_context owner proto: Gc<Proto>;
    operand reg = regs[it];
    operand kst = k[it] const proto.consts.items.ptr verify (it as u64) < proto.consts.items.len;
    operand label = pc + it verify is_insn_boundary(pc + it);

    encoding fixed(u32) {
        format ABC { op: 8, a: 8, b: 8, c: 8 }
        format ABsC { op: 8, a: 8, b: 8, sc: s8 }
    }

    op LOADK(dst: reg, c: kst) : ABC { dst = c; next }
    // a + the constant's number: an Int, a cell's value, a string's
    // length, a box's n.
    op ADDK(dst: reg, a: reg, c: kst) : ABC {
        match (a, c) {
            (Int(x), Int(y)) => dst = Int(x + y),
            (Int(x), Cell(y)) => dst = Int(x + y.v as i48),
            (Int(x), Str(s)) => dst = Int(x + s.data.len as i48),
            (Int(x), Box(b)) => dst = Int(x + b.n as i48),
            (Num(x), Num(y)) => dst = Num(x + y),
            _ => dst = Nil,
        }
        next
    }
    op JLT(a: reg, b: reg, off: label) : ABsC {
        if let (Int(x), Int(y)) = (a, b) { if x < y { jump off } }
        next
    }
    op RET(src: reg) : ABC { exit src }

    entry run(p: Gc<Proto>, r: *V) -> V { regs = r; k = p.consts.items.ptr; jump p.code }
}

fn main() {
    var heap = gc.Heap.new();
    let h = &heap;
    let ks: Gc<Arr> = new(h, Arr {}, 6);
    ks.items[0] = V.Int(0);
    ks.items[1] = V.Cell(new(h, Cell { v: 1000 }));
    let s = new(h, Str {}, 3);
    ks.items[2] = V.Str(s);
    ks.items[3] = V.Box(new(h, Box { n: 1000000 }));
    ks.items[4] = V.Int(1);
    ks.items[5] = V.Int(200);
    var code: [u32; 16] = [0; 16];
    let c = code[..];
    var at: u64 = 0;
    // r0 = 0; r1 = 0; r2 = 200; loop: r1 += cell; r1 += str; r1 += box;
    // r0 += 1; if r0 < r2 goto loop; ret r1
    at = M.emit.LOADK(c, at, 0, 0);
    at = M.emit.LOADK(c, at, 1, 0);
    at = M.emit.LOADK(c, at, 2, 5);
    at = M.emit.ADDK(c, at, 1, 1, 1);
    at = M.emit.ADDK(c, at, 1, 1, 2);
    at = M.emit.ADDK(c, at, 1, 1, 3);
    at = M.emit.ADDK(c, at, 0, 0, 4);
    at = M.emit.JLT(c, at, 0, 2, -5);
    at = M.emit.RET(c, at, 1);
    let Ok(p) = M.build_verified(h, Proto { consts: ks }, c[0..at]) else { io.println("bad"); return; };
    var regs: [V; 4] = [V.Nil; 4];
    for _i in 0..2 {
        match M.run(p, &regs[0]) {
            Int(x) => io.print_int(x as i64),
            _ => io.print("?"),
        }
        io.println("");
    }
}
// expect: 200200600
// expect: 200200600
