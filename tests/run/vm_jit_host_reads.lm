// args: --jit-stencils
// env: LOIMI_JIT=1 LOIMI_JIT_HOT=1
// Host code that reads code words sees the real words while the JIT
// holds the code: compiled instructions' words are enter words, which
// `V.real_word` maps back, and which the generated readers (disasm,
// op_name, op_size, label, set_label, field getters, operand metadata,
// verify) map themselves. Without the JIT (no --jit-stencils), the
// output is the same but for the last line ("not compiled"); before the
// fix, every compiled word printed as `<invalid ..>` and verify failed.
import std.io;
import std.text;
import std.gc;

object Proto { code: verified [u32] by V }

#[require_verified]
vm V {
    state { pc: *u32, regs: *i64 }
    verify_context owner proto: Gc<Proto>;
    operand reg = regs[it] display "r{}";
    operand imm = it;
    operand label = pc + it verify is_insn_boundary(pc + it);

    encoding fixed(u32) {
        format ABC { op: 8, a: 8, b: 8, c: 8 }
        format AsBx { op: 8, a: 8, sbx: s16 }
        format ABsC { op: 8, a: 8, b: 8, sc: s8 }
    }
    cache Cnt { n: u32 }

    op LOADI(dst: reg, v: imm) : AsBx { dst = v; next }
    family ADD(dst: reg, a: reg, b: reg) : ABC + Cnt {
        generic { cache.n = cache.n + 1; dst = a + b; become ADD_Q; next }
        ADD_Q { cache.n = cache.n + 1; dst = a + b; next }
    }
    op JLT(a: reg, b: reg, off: label) : ABsC { if a < b { jump off } next }
    op RET(src: reg) : ABC { exit src }

    entry run(p: Gc<Proto>, r: *i64) -> i64 { regs = r; jump p.code }
}

fn show(ws: []u32, p: Gc<Proto>, b: *text.StrBuf) {
    V.disasm(ws, b);
    for i in 0..ws.len {
        let w = ws[i];
        b.push_int(i as i64);
        b.push_str(" ");
        b.push_str(V.op_name(w));
        b.push_str(" size=");
        b.push_int(V.op_size(w) as i64);
        b.push_str(" operands=");
        b.push_int(V.operand_count(w) as i64);
        b.push_str(" a=");
        b.push_int(V.ABC_a(w) as i64);
        match V.label(w) {
            Some(l) => {
                b.push_str(" label=");
                b.push_int(l);
                // set_label re-encodes the real word.
                let Some(nw) = V.set_label(w, l) else { b.push_str(" set_label failed"); return; };
                if nw != V.real_word(w) { b.push_str(" set_label differs"); }
            }
            None => {}
        }
        b.push_str("\n");
    }
    match V.verify(ws, p) {
        Ok(_) => b.push_str("verify ok\n"),
        Err(e) => { b.push_str("verify: "); e.write(b); b.push_str("\n"); }
    }
}

fn main() {
    var heap = gc.Heap.new();
    let h = &heap;
    var code: [u32; 16] = [0; 16];
    var regs: [i64; 8] = [0; 8];
    let c = code[..];
    var at: u64 = 0;
    // r0 = 0; r1 = 100; r2 = 1; loop: r0 += r2; if r0 < r1 goto loop; ret r0
    at = V.emit.LOADI(c, at, 0, 0);
    at = V.emit.LOADI(c, at, 1, 100);
    at = V.emit.LOADI(c, at, 2, 1);
    at = V.emit.ADD(c, at, 0, 0, 2);
    at = V.emit.JLT(c, at, 0, 1, -2);
    at = V.emit.RET(c, at, 0);
    let Ok(p) = V.build_verified(h, Proto {}, c[0..at]) else { io.println("bad"); return; };
    io.print_int(V.run(p, &regs[0]));
    io.println("");
    let ws = p.code.words();
    var b = text.StrBuf.new();
    show(ws, p, &b);
    io.print(b.as_str());
    // The same words, read through real_word, as plain (uncompiled) code.
    var copy: [u32; 16] = [0; 16];
    for i in 0..ws.len { copy[i] = V.real_word(ws[i]); }
    var b2 = text.StrBuf.new();
    show(copy[0..ws.len], p, &b2);
    let x = b.as_str();
    let y = b2.as_str();
    var same = x.len == y.len;
    for i in 0..x.len { if same and x[i] != y[i] { same = false; } }
    if same { io.println("same"); } else { io.println("differs"); io.print(y); }
    // With the JIT, some words are enter words.
    var raw: u64 = 0;
    for i in 0..ws.len { if ws[i] != copy[i] { raw += 1; } }
    if raw > 0 { io.println("compiled"); } else { io.println("not compiled"); }
}
// expect: 100
// expect:     0  LOADI dst=r0 v=0
// expect:     1  LOADI dst=r1 v=100
// expect:     2  LOADI dst=r2 v=1
// expect:     3  ADD_Q dst=r0 a=r0 b=r2 [cache n=100]
// expect:     5  JLT a=r0 b=r1 off -> 3
// expect:     6  RET src=r0
// expect: 0 LOADI size=1 operands=2 a=0
// expect: 1 LOADI size=1 operands=2 a=1
// expect: 2 LOADI size=1 operands=2 a=2
// expect: 3 ADD_Q size=2 operands=3 a=0
// expect: 4 <invalid> size=1 operands=0 a=0
// expect: 5 JLT size=1 operands=3 a=0 label=-2
// expect: 6 RET size=1 operands=1 a=0
// expect: verify ok
// expect: same
// expect: compiled
