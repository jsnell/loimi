import std.io;
import std.text;

struct Proto { nregs: u32, nconsts: u32 }

// Entries start only in verified code: `run` takes a Verified<V>.
#[require_verified]
vm V {
    state { pc: *u32, regs: *i64 }
    verify_context proto: *Proto;

    operand reg = regs[it] verify (it as u32) < proto.nregs;
    operand kst = it verify (it as u32) < proto.nconsts;
    operand label = pc + it verify is_insn_boundary(pc + it);

    encoding fixed(u32) {
        format ABC { op: 8, a: 8, b: 8, c: 8 }
        format AsBx { op: 8, a: 8, sbx: s16 }
    }
    cache C { x: u32 }

    op LOADK(dst: reg, k: kst) : ABC { dst = k as i64; next }
    op ADD(dst: reg, a: reg, b: reg) : ABC { dst = a + b; next }
    op JLT(a: reg, target: label) : AsBx { if a < 10 { jump target } next }
    op CACHED(dst: reg) : ABC + C { cache.x = cache.x + 1; next }
    op RET(src: reg) : ABC { exit src }

    entry run(code: Verified<V>, r: *i64) -> i64 { regs = r; jump code }
}

fn show(r: Result<Verified<V>, V.VerifyError>) {
    match r {
        Ok(v) => { io.print("ok, "); io.print_int(v.len() as i64); io.println(" words"); }
        Err(e) => {
            var b = text.StrBuf.new();
            e.write(&b);
            io.println(b.as_str());
            b.free();
        }
    }
}

fn main() {
    var p = Proto { nregs: 4, nconsts: 2 };
    var code: [u32; 8] = [0; 8];
    let c = code[..];
    var at: u64 = 0;
    at = V.emit.LOADK(c, at, 0, 1);
    at = V.emit.CACHED(c, at, 1);       // occupies 2 words
    at = V.emit.ADD(c, at, 0, 0, 0);
    at = V.emit.JLT(c, at, 0, -1);      // back to the ADD
    at = V.emit.RET(c, at, 0);
    show(V.verify(c[0..at], &p));

    code[4] = V.JLT(0, -2);              // into the middle of CACHED's inline cache
    show(V.verify(c[0..at], &p));
    code[4] = V.JLT(0, -1);

    code[3] = V.ADD(0, 0, 7);            // register 7 is out of range
    show(V.verify(c[0..at], &p));
    code[3] = V.ADD(0, 0, 0);

    code[0] = V.LOADK(0, 2);             // constant 2 is out of range
    show(V.verify(c[0..at], &p));
    code[0] = V.LOADK(0, 1);

    code[5] = 200;                       // not an opcode
    show(V.verify(c[0..at], &p));
    code[5] = V.RET(0);

    show(V.verify(c[0..2], &p));         // CACHED cut off by the end
    show(V.verify(c[0..4], &p));         // ends in ADD, which continues
    show(V.verify(c[0..0], &p));         // empty

    // The reason is an enum, for programs that act on it.
    if let Err(e) = V.verify(c[0..0], &p) {
        match e.reason {
            Empty => io.println("reason: Empty"),
            _ => io.println("reason: other"),
        }
        io.println(e.message());
    }

    var regs: [i64; 4] = [0; 4];
    match V.verify(c[0..at], &p) {
        Ok(v) => {
            // `optimize` takes and returns the proof: fusing preserves it.
            let v2 = V.optimize(v);
            io.print_int(V.run(v2, &regs[0])); io.println("");
        }
        Err(_) => io.println("unexpected"),
    }
    // A placeholder for a field that needs a Verified before the real
    // code is verified: one invalid opcode, which traps if it runs.
    let ph = V.placeholder();
    io.print_int(ph.len() as i64); io.println("");
    show(V.verify(ph.words(), &p));
    // Code the host trusts without checking.
    let t = unsafe { V.assume_verified(c[0..at]) };
    io.print_int(V.run(t, &regs[0])); io.println("");
}
// expect: ok, 6 words
// expect: word 4 (JLT): operand `target` (label) fails `is_insn_boundary(pc + it)`
// expect: word 3 (ADD): operand `b` (reg) fails `(it as u32) < proto.nregs`
// expect: word 0 (LOADK): operand `k` (kst) fails `(it as u32) < proto.nconsts`
// expect: word 5: invalid opcode
// expect: word 1 (CACHED): the instruction runs past the end of the code
// expect: word 3 (ADD): execution can run off the end of the code after this instruction
// expect: word 0: the code is empty
// expect: reason: Empty
// expect: the code is empty
// expect: 16
// expect: 1
// expect: word 0: invalid opcode
// expect: 16
