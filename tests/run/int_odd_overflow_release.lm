                        None => if fits { bad("u63", "sub none", a64, b64); fails += 1; },
                    }
                }
                None => if a.sub_checked(b).is_some() { bad("u63", "sub some", a64, b64); fails += 1; },
            }
            if (a -% b) as i64 != ((a64 -% b64) & 9223372036854775807) { bad("u63", "sub wrap", a64, b64); fails += 1; }
            match a64.mul_checked(b64) {
                Some(r) => {
                    let fits = r >= lo and r <= hi;
                    match a.mul_checked(b) {
                        Some(x) => if !fits or x as i64 != r { bad("u63", "mul", a64, b64); fails += 1; },
                        None => if fits { bad("u63", "mul none", a64, b64); fails += 1; },
                    }
                }
                None => if a.mul_checked(b).is_some() { bad("u63", "mul some", a64, b64); fails += 1; },
            }
            if (a *% b) as i64 != ((a64 *% b64) & 9223372036854775807) { bad("u63", "mul wrap", a64, b64); fails += 1; }
            if (a < b) != (a64 < b64) or (a <= b) != (a64 <= b64) or (a == b) != (a64 == b64) or (a > b) != (a64 > b64) { bad("u63", "cmp", a64, b64); fails += 1; }
            if b64 != 0 {
                if (a / b) as i64 != a64 / b64 or (a % b) as i64 != a64 % b64 { bad("u63", "div", a64, b64); fails += 1; }
                if b > (0 as u63) and (a / b) as i64 != a64 / b64 { bad("u63", "div pos", a64, b64); fails += 1; }
            }
            let s = (b64 as u64 % 63) as u63;
            let s64 = (b64 as u64 % 63) as i64;
            if (a << s) as i64 != ((a64 << s64) & 9223372036854775807) { bad("u63", "shl", a64, b64); fails += 1; }
            if (a >> s) as i64 != a64 >> s64 { bad("u63", "shr", a64, b64); fails += 1; }
        }
        let a64 = vs[i] + z;
        let a = a64 as u63;
        if ((0 as u63) -% a) as i64 != ((0 -% a64) & 9223372036854775807) { bad("u63", "neg", a64, 0); fails += 1; }
        match (0 as u63).sub_checked(a) {
            Some(x) => if 0 - a64 < lo or 0 - a64 > hi or x as i64 != 0 - a64 { bad("u63", "neg checked", a64, 0); fails += 1; },
            None => if 0 - a64 >= lo and 0 - a64 <= hi { bad("u63", "neg none", a64, 0); fails += 1; },
        }
        if (a as f64) != (a64 as f64) { bad("u63", "to f64", a64, 0); fails += 1; }
    }
    fails
}

fn main() {
    let z = os.arg_count() as i64 - 1;
    var fails: i64 = 0;
    fails += check_i3(z);
    fails += check_u3(z);
    fails += check_i17(z);
    fails += check_u17(z);
    fails += check_i31(z);
    fails += check_u31(z);
    fails += check_i47(z);
    fails += check_u47(z);
    fails += check_i48(z);
    fails += check_u48(z);
    fails += check_i63(z);
    fails += check_u63(z);
    if fails == 0 { p("ok"); } else { io.print_int(fails); p(" failures"); }
}

