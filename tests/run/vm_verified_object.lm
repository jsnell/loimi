// matrix: dispatch
// Code stored in its prototype as `code: verified [u32] by V`: created
// only by `V.build_verified`, which verifies the words in the object
// with the object as the `owner` verify context; `p.code` reads as a
// `Verified<V>`, and `jump p.code` starts at the array. A `verify` block
// checks a side table (handler targets) against the code's boundaries.
import std.io;
import std.gc;
import std.text;

object Targets { data: [u32] }
object Proto { nregs: u32, targets: Gc<Targets>, code: verified [u32] by V }

#[require_verified]
vm V {
    context heap: *gc.Heap;
    state { pc: *u32, regs: *i64, p: Gc<Proto> }
    verify_context owner proto: Gc<Proto>, max: u64;

    operand reg = regs[it] verify (it as u32) < proto.nregs;
    operand imm = it verify it <= max;
    operand label = pc + it verify is_insn_boundary(pc + it);
    operand target = it verify (it as u64) < proto.targets.data.len;

    /// Every handler target is an instruction boundary of the code.
    verify targets {
        var ok = true;
        for i in 0..proto.targets.data.len {
            if !is_insn_boundary(code.ptr + proto.targets.data[i]) { ok = false; }
        }
        ok
    }

    encoding fixed(u32) {
        format ABC { op: 8, a: 8, b: 8, c: 8 }
        format AJ { op: 8, a: 8, j: s16 }
    }
    cache Wide { x: u32 }

    op LOADI(dst: reg, v: imm) : ABC { dst = v as i64; next }
    op ADDI(dst: reg, v: imm) : ABC + Wide { cache.x += 1; dst = dst + v as i64; next }
    op JMP(off: label) : AJ { jump off }
    /// Continue at handler target `t`, a word offset from the code start.
    op GOTO(t: target) : ABC { jump p.code.start() + p.targets.data[t] }
    op RET(src: reg) : ABC { exit src }

    entry run(h: *gc.Heap, proto: Gc<Proto>, r: *i64) -> i64 {
        heap = h;
        p = proto;
        regs = r;
        jump proto.code
    }
}

fn show(r: Result<Gc<Proto>, V.VerifyError>) -> ?Gc<Proto> {
    match r {
        Ok(p) => { io.println("ok"); Some(p) }
        Err(e) => {
            var b = text.StrBuf.new();
            e.write(&b);
            io.println(b.as_str());
            b.free();
            None
        }
    }
}

fn targets(h: *gc.Heap, ts: []u32) -> Gc<Targets> {
    let t = new(h, Targets {}, ts.len);
    for i in 0..ts.len { t.data[i] = ts[i]; }
    t
}

fn main() {
    var heap = gc.Heap.new();
    let h = &heap;
    // ADDI has a cache word: offset 4 is inside it, 5 is the RET.
    var code: [u32; 6] = [V.LOADI(0, 5), V.GOTO(0), V.LOADI(0, 1), V.ADDI(0, 2), 0, V.RET(0)];
    let ok_targets: [u32; 1] = [3];
    let bad_targets: [u32; 1] = [4];
    let Some(p) = show(V.build_verified(h, Proto { nregs: 1, targets: targets(h, ok_targets[..]) }, code[..], 9)) else { return; };
    show(V.build_verified(h, Proto { nregs: 1, targets: targets(h, bad_targets[..]) }, code[..], 9));
    show(V.build_verified(h, Proto { nregs: 0, targets: targets(h, ok_targets[..]) }, code[..], 9));
    show(V.build_verified(h, Proto { nregs: 1, targets: targets(h, ok_targets[..]) }, code[..], 4));
    // The proof reads the object's own words.
    io.print_int(p.code.len() as i64); io.println("");
    io.print_int((p.code.start() as u64 - (&p.code.words()[0]) as u64) as i64); io.println("");
    var regs: [i64; 2] = [0; 2];
    io.print_int(V.run(h, p, &regs[0])); io.println("");
    io.print_int(V.run(h, p, &regs[0])); io.println("");
    // The source array is a copy: changing it does not change the code.
    code[3] = V.ADDI(0, 7);
    io.print_int(V.run(h, p, &regs[0])); io.println("");
}
// expect: ok
// expect: check `targets` fails
// expect: word 0 (LOADI): operand `dst` (reg) fails `(it as u32) < proto.nregs`
// expect: word 0 (LOADI): operand `v` (imm) fails `it <= max`
// expect: 6
// expect: 0
// expect: 7
// expect: 7
// expect: 7
