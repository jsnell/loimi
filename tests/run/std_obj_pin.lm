// std.obj: shapes die with their last object, so an object built the same
// way after a collection gets a new shape id; a pinned shape keeps its id.
import std.io;
import std.gc;
import std.obj;

value Value repr nanbox { Num(f64) unboxed, Int(i32), Nil, O(Gc<obj.Obj<Value>>) }

struct World {
    heap: gc.Heap,
    m: obj.Model<Gc<obj.Obj<Value>>, Gc<obj.Slots<Value>>, Value>,
}

/// The shape id of a fresh object with properties 1, 2, 3 (then dropped).
fn World.build(w: *World) -> u32 {
    let none: ?Gc<obj.Obj<Value>> = None;
    let o = obj.new_obj(&w.heap, w.m.root(4), none, 4);
    w.m.set(o, 1, Value.Int(1));
    w.m.set(o, 2, Value.Int(2));
    w.m.set(o, 3, Value.Int(3));
    o.shape.id
}

fn World.pin_last(w: *World) {
    let none: ?Gc<obj.Obj<Value>> = None;
    let o = obj.new_obj(&w.heap, w.m.root(4), none, 4);
    w.m.set(o, 1, Value.Int(1));
    w.m.set(o, 2, Value.Int(2));
    w.m.set(o, 3, Value.Int(3));
    w.m.shapes.pin(o.shape);
    w.m.shapes.pin(o.shape);
}

fn main() uses gc {
    var w = World { heap: gc.Heap.new(), m: obj.Model.new(obj.new_slots<Value>, Value.Nil) };
    w.m.attach(&w.heap);
    let a = w.build();
    gc.collect(&w.heap);
    let b = w.build();
    io.print_bool(a == b); io.println("");
    w.pin_last();
    let c = w.build();
    gc.collect(&w.heap);
    gc.collect(&w.heap);
    let d = w.build();
    io.print_bool(c == d); io.println("");
    io.print_int(w.m.shapes.pinned.len as i64); io.println("");
}
// expect: false
// expect: true
// expect: 1
