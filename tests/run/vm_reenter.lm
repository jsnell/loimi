// matrix: dispatch
// Re-entry: a native calls back into the vm through a nested entry
// (`entry call(..) uses reenter`), which runs guest code above the
// caller's frames and returns to the native when the callee returns.
// Every callback moves the stack (a new buffer, the old one poisoned), so
// a handler that kept using its cached `regs` after the native returned
// would read and write the dead copy: the vm's `reload` block restores
// the state registers after each call that may re-enter.
import std.io;
import std.mem;

struct Frame { base: u64, ret: *u32, dst: u64 }

struct Ctx {
    stack: *i64,
    size: u64,
    frames: *Frame,
    fp: *Frame,
    /// The bottom frame of the innermost run: RET from it leaves the run.
    entry_fp: *Frame,
    funcs: **u32,
    moves: i64,
    max_depth: u32,
}

const WINDOW: u64 = 8;

/// Move the stack to a new buffer, poisoning the old one.
fn move_stack(c: *Ctx) {
    let size = c.size + 64;
    let s: *i64 = mem.alloc(size);
    for i in 0..c.size { s[i] = c.stack[i]; }
    for i in 0..c.size { c.stack[i] = 0x7777; }
    c.stack = s;
    c.size = size;
    c.moves += 1;
}

/// Call guest function `f` from host code, above the current frame.
fn call_guest(c: *Ctx, f: u64, arg: i64) -> Result<i64, i64> uses reenter {
    if R.depth >= 6 { return Err(-1); }
    let (fp, entry) = (c.fp, c.entry_fp);
    move_stack(c);
    let r = R.call(c, f, arg);
    if R.depth + 1 > c.max_depth { c.max_depth = R.depth + 1; }
    c.fp = fp;
    c.entry_fp = entry;
    r
}

/// The natives: 0 applies function 1; 2 counts down through function 3,
/// one nested run per step; 3 calls function 4, which fails.
fn native(c: *Ctx, id: i64, a: i64) -> Result<i64, i64> uses reenter {
    match id {
        0 => call_guest(c, 1, a),
        2 => if a == 0 { Ok(100) } else { call_guest(c, 3, a - 1) },
        3 => call_guest(c, 4, a),
        _ => Err(-2),
    }
}

vm R {
    context ctx: *Ctx;
    state { pc: *u32, regs: *i64, fp: *Frame }
    operand reg = regs[it];
    operand imm = it;
    encoding fixed(u32) {
        format ABC { op: 8, a: 8, b: 8, c: 8 }
        format AsBx { op: 8, a: 8, sbx: s16 }
    }

    sync { ctx.fp = fp; }
    reload {
        fp = ctx.fp;
        regs = ctx.stack + fp.base;
    }

    /// A plain vm function whose call re-enters: synced and reloaded in
    /// place, through the state pointers it sees.
    fn via(id: i64, a: i64) -> i64 {
        match native(ctx, id, a) {
            Ok(v) => v,
            Err(e) => 0 - e,
        }
    }

    op LOADI(dst: reg, v: imm) : AsBx { dst = v as i64; next }
    op ADD(dst: reg, a: reg, b: reg) : ABC { dst = a + b; next }
    /// R[dst] = native `id`(R[a]), in a cold block.
    op NATIVE(dst: reg, id: imm, a: reg) : ABC {
        cold {
            dst = native(ctx, id as i64, a)?;
            next
        }
    }
    /// The same on the hot path, through a vm function.
    op NATIVEF(dst: reg, id: imm, a: reg) : ABC {
        dst = via(id as i64, a);
        next
    }
    /// R[dst] = guest function `f`(R[a]).
    op CALL(dst: reg, f: imm, a: reg) : ABC {
        let x = a;
        fp.ret = pc + 1;
        fp.dst = dst.raw;
        let base = fp.base + WINDOW;
        fp = fp + 1;
        fp.base = base;
        regs = ctx.stack + base;
        regs[0] = x;
        jump ctx.funcs[f]
    }
    op RET(src: reg) : ABC {
        let v = src;
        if fp == ctx.entry_fp { exit Ok(v) }
        fp = fp - 1;
        regs = ctx.stack + fp.base;
        regs[fp.dst] = v;
        jump fp.ret
    }
    op FAIL(a: reg) : ABC { raise a }

    /// A top-level run, from the bottom of the stack.
    entry run(c: *Ctx, f: u64, arg: i64) -> Result<i64, i64> {
        ctx = c;
        fp = c.frames;
        fp.base = 0;
        c.entry_fp = fp;
        c.fp = fp;
        regs = c.stack;
        regs[0] = arg;
        jump c.funcs[f]
    }

    /// A nested run, above the frame that made the call (`ctx.fp`, which
    /// `sync` published).
    entry call(c: *Ctx, f: u64, arg: i64) -> Result<i64, i64> uses reenter {
        ctx = c;
        let base = c.fp.base + WINDOW;
        fp = c.fp + 1;
        fp.base = base;
        c.entry_fp = fp;
        c.fp = fp;
        regs = c.stack + base;
        regs[0] = arg;
        jump c.funcs[f]
    }

    on raise(e: i64) { exit Err(e) }
}

fn show(c: *Ctx, r: Result<i64, i64>) {
    match r {
        Ok(v) => { io.print("ok "); io.print_int(v); }
        Err(e) => { io.print("err "); io.print_int(e); }
    }
    io.print(" depth ");
    io.print_int(R.depth as i64);
    io.println("");
}

fn main() {
    var code: [u32; 64] = [0; 64];
    let k = code[..];
    var funcs: [*u32; 6] = [0 as *u32; 6];
    var at: u64 = 0;
    // f0(x) = native0(x) + x, with native0(x) = f1(x) = x + 10.
    funcs[0] = &code[at];
    at = R.emit.NATIVE(k, at, 1, 0, 0);
    at = R.emit.ADD(k, at, 2, 1, 0);
    at = R.emit.RET(k, at, 2);
    funcs[1] = &code[at];
    at = R.emit.LOADI(k, at, 1, 10);
    at = R.emit.ADD(k, at, 2, 0, 1);
    at = R.emit.RET(k, at, 2);
    // f3(x) = native2(x) + 1: native2 calls f3(x - 1), down to 100.
    funcs[3] = &code[at];
    at = R.emit.NATIVE(k, at, 1, 2, 0);
    at = R.emit.LOADI(k, at, 2, 1);
    at = R.emit.ADD(k, at, 3, 1, 2);
    at = R.emit.RET(k, at, 3);
    // f4 fails with its argument.
    funcs[4] = &code[at];
    at = R.emit.FAIL(k, at, 0);
    // f2(x) = f1(x) + nativef0(x): a guest call, then a re-entry from a
    // vm function on the hot path.
    funcs[2] = &code[at];
    at = R.emit.CALL(k, at, 1, 1, 0);
    at = R.emit.NATIVEF(k, at, 2, 0, 0);
    at = R.emit.ADD(k, at, 3, 1, 2);
    at = R.emit.RET(k, at, 3);
    // f5(x) = nativef2(x) + f2(x)
    funcs[5] = &code[at];
    at = R.emit.NATIVEF(k, at, 1, 2, 0);
    at = R.emit.CALL(k, at, 2, 2, 0);
    at = R.emit.ADD(k, at, 3, 1, 2);
    at = R.emit.RET(k, at, 3);

    var frames: [Frame; 16] = [Frame { base: 0, ret: 0 as *u32, dst: 0 }; 16];
    let stack: *i64 = mem.alloc(64);
    var c = Ctx { stack: stack, size: 64, frames: &frames[0], fp: &frames[0], entry_fp: &frames[0], funcs: &funcs[0], moves: 0, max_depth: 0 };
    show(&c, R.run(&c, 0, 5));      // 15 + 5
    show(&c, R.run(&c, 3, 3));      // three nested runs: 104
    io.print("max depth ");
    io.print_int(c.max_depth as i64);
    io.println("");
    show(&c, R.run(&c, 3, 10));     // too deep: -1 from the seventh
    show(&c, R.run(&c, 0, -3));     // 7 + -3
    // A failure in a nested run comes back to the native as an Err.
    at = R.emit.NATIVE(k, 0, 1, 3, 0);
    show(&c, R.run(&c, 0, 7));
    // f2(4) = 14 + 14; f5(2) = nativef2(2) + f2(2) = 102 + 24.
    show(&c, R.run(&c, 2, 4));
    show(&c, R.run(&c, 5, 2));
    io.print("moves ");
    io.print_int(c.moves);
    io.println("");
}
// expect: ok 20 depth 0
// expect: ok 104 depth 0
// expect: max depth 3
// expect: err -1 depth 0
// expect: ok 4 depth 0
// expect: err 7 depth 0
// expect: ok 28 depth 0
// expect: ok 126 depth 0
// expect: moves 16
