// `mem.Vec.sort_by` with closure comparators (capturing a key table) and
// with a plain function; stability; GC values sorted under stress.
import std.io;
import std.gc;
import std.mem;
import std.mem.{Vec};

fn cmp_i64(a: *i64, b: *i64) -> i32 {
    if *a < *b { -1 } else if *a > *b { 1 } else { 0 }
}

object Box { key: i64 }

fn main() uses gc {
    // Sort indices by a table the closure captures.
    var keys: [i64; 8] = [50, 20, 70, 20, 10, 90, 50, 30];
    var idx: Vec<u32> = Vec.new();
    for i in 0..8 { idx.push(i as u32); }
    idx.sort_by(|a, b| cmp_i64(&keys[*a as u64], &keys[*b as u64]));
    for i in 0..idx.len { if i > 0 { io.print(" "); } io.print_int(idx.at(i) as i64); }
    io.println("");

    // Descending, counting comparisons in a captured variable.
    var calls: i64 = 0;
    idx.sort_by(|a, b| { calls += 1; cmp_i64(&keys[*b as u64], &keys[*a as u64]) });
    for i in 0..idx.len { if i > 0 { io.print(" "); } io.print_int(keys[idx.at(i) as u64]); }
    io.println("");
    io.print_bool(calls > 0); io.println("");

    // A plain function as the comparator; many elements (several merge passes).
    var v: Vec<i64> = Vec.new();
    var x: u64 = 88172645463325252;
    for i in 0..1000 {
        x = x ^ (x << 13); x = x ^ (x >> 7); x = x ^ (x << 17);
        v.push((x % 1000) as i64);
    }
    v.sort_by(cmp_i64);
    var sorted = true;
    for i in 1..v.len { if v.at(i - 1) > v.at(i) { sorted = false; } }
    io.print_bool(sorted); io.println("");

    // Stability: equal keys keep their order.
    var pairs: Vec<(i64, i64)> = Vec.new();
    for i in 0..100 { pairs.push((i % 3, i)); }
    pairs.sort_by(|a, b| cmp_i64(&a.0, &b.0));
    var stable = true;
    for i in 1..pairs.len {
        let (p, q) = (pairs.at(i - 1), pairs.at(i));
        if p.0 == q.0 and p.1 > q.1 { stable = false; }
    }
    io.print_bool(stable); io.print(" "); io.print_int(pairs.at(0).1); io.print(" "); io.print_int(pairs.at(99).1);
    io.println("");

    // Sorting GC references: the comparator has no effects, so sorting
    // never collects; the vector is a root through a scanner.
    var heap = gc.Heap.new();
    heap.set_stress(true);
    var boxes: Vec<Gc<Box>> = Vec.new();
    for i in 0..40 { boxes.push(new(&heap, Box { key: (i * 7) % 40 })); }
    heap.add_scanner(&boxes as *u8, scan_boxes);
    boxes.sort_by(|a, b| cmp_i64(&a.key, &b.key));
    gc.collect(&heap);
    var ok = true;
    for i in 0..boxes.len { if boxes.at(i).key != i as i64 { ok = false; } }
    io.print_bool(ok); io.println("");
    idx.free(); v.free(); pairs.free(); boxes.free();
}

fn scan_boxes(h: *gc.Heap, data: *u8) {
    let v = data as *Vec<Gc<Box>>;
    for i in 0..v.len { gc_mark(h, v.at(i)); }
}
// expect: 4 1 3 7 0 6 2 5
// expect: 90 70 50 50 30 20 20 10
// expect: true
// expect: true
// expect: true 0 98
// expect: true
