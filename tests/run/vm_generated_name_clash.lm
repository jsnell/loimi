// matrix: jit
// A module may declare items named like the C functions vm expansion
// calls (`calloc`, `free` for the verifier's scratch arrays, the JIT
// runtime's `loimi_jit_register`, `loimi_jit_word`, ..): generated code
// declares them under reserved names that link to the C symbols. (With
// --jit-stencils, `loimi_jit_register` used to be "defined more than once".)
import std.io;

extern "C" fn calloc(n: u64, size: u64) -> *u8;
fn loimi_jit_register(x: i64) -> i64 { x + 1 }
fn loimi_jit_word(x: i64) -> i64 { x + 2 }
fn free(x: i64) -> i64 { x + 3 }

vm V {
    state { pc: *u32 }
    operand imm = it;
    operand label = pc + it verify is_insn_boundary(pc + it);
    encoding fixed(u32) {
        format A { op: 8, a: 24 }
        format J { op: 8, sj: s24 }
    }
    op NOP(x: imm) : A { next }
    op JMP(target: label) : J { jump target }
    op RET(x: imm) : A { exit x as i64 }
    super NOP_RET = NOP; RET;
    entry run(code: *u32) -> i64 { pc = code; jump pc }
}

fn main() {
    var code: [u32; 8] = [0; 8];
    let c = code[..];
    var at: u64 = 0;
    at = V.emit.NOP(c, at, 1);
    at = V.emit.RET(c, at, 7);
    match V.verify(c[0..at]) { Ok(_) => io.println("ok"), Err(_) => io.println("bad") }
    io.print_int(V.run(&code[0]) + loimi_jit_register(1) + loimi_jit_word(1) + free(1));
    io.println("");
    let p = calloc(1, 1);
    io.print_int(p[0] as i64);
    io.println("");
}
// expect: ok
// expect: 16
// expect: 0
