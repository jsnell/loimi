// `loimi ir-diff` fixture (tests/golden.rs `ir_diff`): ../b/main.lm is this
// program with its lines moved and its table and helper renamed, so the
// code is the same; ../c/main.lm changes one operation.
import std.io;
import std.os;

var NAMES: [str; 3] = ["zero", "one", "two"];

fn pick(i: u64) -> str { NAMES[i] }

fn half(x: i64) -> i64 { x / (os.arg_count() as i64 - 7) }

fn main() {
    let n = os.arg_count() as u64;
    io.println(pick(n));
    io.print_int(half(n as i64 * 10));
    io.println("");
}
