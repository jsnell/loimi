// Reproducers for holes in Mini's verify clauses (examples/mini/vm.lm).
// Each program passes Mini.verify, then writes or reads past the stack.
//   repro 1: CALL with nres 255, callee RET1 (RET1's cold path clears
//            want - 1 registers of the callee's frame)
//   repro 2: SETLIST reading n registers past the frame
//   repro 3: CALL with nres 255, callee RETN (writes want results)
//   repro 4: RETN reading n registers past the frame
//   repro 5: CALL with nres 255, callee RET0 (writes want Nils; what the
//            fuzzer hit first)
//   repro 6: GETINDEXI with index 0: `(i as u64) - 1` overflows (panics
//            in debug builds)
//   repro 7: SELF with a = nregs - 1 writes R[a+1], one past the frame
//            (`callbase` checks a < nregs; SELF needs a + 1 < nregs)
//   repro 8: CONCAT with n = 0: `n - 2` underflows in concat()
//   repro 9: CONCAT reading n registers past the frame
// 1-6, 8, 9 came from `imm` operands without `verify` clauses (nres, n,
// i). They are fixed: Mini.verify now rejects every case. Without
// arguments this checks all nine (exit 1 if one verifies; run by
// tests/fuzz.rs); `holes N` builds case N and runs it if it verifies.
// The stack holds exactly the main frame, so ASan would see an overflow:
//   mkdir d; ln -s $PWD/examples/mini/{value,vm,lib}.lm d/
//   ln -s $PWD/tests/fuzz/mini_holes.lm d/
//   loimi build d/mini_holes.lm --sanitize=address -o holes; ./holes 5
import std.io;
import std.os;
import std.gc;
import std.mem;
import std.text;
import value;
import value.{V, Proto, Lines, Protos, UpDescs};
import vm.{Mini, Ctx, Frame};
import vm;

fn proto(h: *gc.Heap, nregs: u32, code: []u32, kids: []Gc<Proto>) -> Gc<Proto> {
    let protos = new(h, Protos {}, kids.len);
    for i in 0..kids.len { protos.data[i] = kids[i]; }
    let p = new(h, Proto {
        name: value.new_str(h, "f"), nparams: 0, nregs: nregs, nupvals: 0,
        consts: value.new_arr(h, 1), lines: new(h, Lines {}, code.len),
        protos: protos, updesc: new(h, UpDescs {}, 0),
    }, code.len);
    for i in 0..code.len { p.code[i] = code[i]; p.lines.data[i] = 0; }
    p
}

fn main() -> i32 {
    let Some(arg) = os.arg(1) else {
        var bad = 0;
        for i in 1..10 {
            if verifies(i as u8, false) {
                io.print("case ");
                io.print_int(i as i64);
                io.println(" verifies");
                bad += 1;
            }
        }
        if bad == 0 { io.println("all rejected"); }
        return if bad == 0 { 0 } else { 1 };
    };
    verifies(arg[0] - '0', true);
    0
}

/// Build case `which`; whether its main function passes Mini.verify. If
/// `run` and it does, print the verdicts and run it.
fn verifies(which: u8, run: bool) -> bool {
    var heap = gc.Heap.new();
    value.init_strings(&heap);
    let h = &heap;
    var main_code: [u32; 4] = [0; 4];
    var mlen: u64 = 3;
    var child_code: [u32; 1] = [0; 1];
    var nregs: u32 = 3;
    if which == 1 or which == 3 or which == 5 {
        child_code[0] = if which == 1 { Mini.RET1(0) } else if which == 3 { Mini.RETN(0, 1) } else { Mini.RET0() };
        main_code[0] = Mini.CLOSURE(0, 0);
        main_code[1] = Mini.CALL(0, 0, 255);
        main_code[2] = Mini.RET0();
    } else if which == 7 {
        // SELF needs a table in R[obj] to reach the write.
        main_code[0] = Mini.NEWTABLE(0, 0, 0);
        main_code[1] = Mini.SELF(2, 0, 0);
        main_code[3] = Mini.RET0();     // SELF has a cache word
        mlen = 4;
    } else if which == 8 or which == 9 {
        main_code[0] = Mini.LOADNIL(0);
        main_code[1] = Mini.CONCAT(0, 1, if which == 8 { 0 } else { 200 });
        main_code[2] = Mini.RET0();
    } else if which == 6 {
        main_code[0] = Mini.NEWTABLE(0, 0, 0);
        main_code[1] = Mini.GETINDEXI(1, 0, 0);
        main_code[2] = Mini.RET0();
    } else if which == 2 {
        main_code[0] = Mini.NEWTABLE(0, 0, 0);
        main_code[1] = Mini.SETLIST(0, 200, 0);
        main_code[2] = Mini.RET0();
    } else {
        // RETN only reads past the frame when returning to a caller.
        child_code[0] = Mini.RETN(0, 200);
        main_code[0] = Mini.CLOSURE(0, 0);
        main_code[1] = Mini.CALL(0, 0, 200);
        main_code[2] = Mini.RET0();
    }
    var nokids: mem.Vec<Gc<Proto>> = mem.Vec.new();
    let child = proto(h, 1, child_code[..], nokids.items());
    var kids: [Gc<Proto>; 1] = [child];
    let mainp = proto(h, nregs, main_code[0..mlen], kids[..]);
    let ok = Mini.verify(mainp.code, mainp).is_none();
    if !run { return ok; }
    io.print("verify main: ");
    io.println(if ok { "ok" } else { "rejected" });
    io.print("verify child: ");
    io.println(if Mini.verify(child.code, child).is_none() { "ok" } else { "rejected" });
    if !ok { return false; }
    let stack: *V = mem.alloc(nregs as u64);
    var ctx = Ctx {
        heap: heap, stack: stack, stack_end: stack + nregs as u64,
        frames: mem.alloc(16), frames_end: 0 as *Frame, fp: 0 as *Frame,
        globals: value.new_table(h), error: V.Nil, out: text.StrBuf.new(),
        open: None, open_level: 0 as *V, host: vm.no_host,
    };
    ctx.frames_end = ctx.frames + 16;
    ctx.fp = ctx.frames;
    Mini.run(&ctx, value.new_closure(&ctx.heap, mainp));
    io.println("ran");
    true
}
