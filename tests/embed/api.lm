// A library exercising the C ABI of `export "C"` functions and the
// generated header (tests/embed/api.h is the expected header; host.c
// calls every function). Built by the `c_library` test in golden.rs.

import std.mem;
import std.os;
import std.rt;

struct Counter { n: i64, hits: u32 }
/// A C name of its own: `api_point` in the header.
#[c_name("api_point")]
struct Point { x: i64, y: i64 }
/// What counter_step does: add or subtract.
enum Mode: u8 { Add, Sub }

export "C" fn counter_new() -> *Counter {
    let c: *Counter = mem.alloc(1);
    c.n = 0;
    c.hits = 0;
    c
}

export "C" fn counter_free(c: *Counter) { mem.release(c); }

export "C" fn counter_step(c: *Counter, mode: Mode, by: i64) -> i64 {
    c.hits += 1;
    match mode {
        Mode.Add => c.n += by,
        Mode.Sub => c.n -= by,
    }
    c.n
}

/// `?*T` is a nullable pointer.
export "C" fn counter_or_null(c: ?*Counter) -> i64 {
    match c {
        Some(p) => p.n,
        None => -1,
    }
}

export "C" fn is_big(c: *Counter, limit: i64) -> bool { c.n > limit }
export "C" fn negate(b: bool) -> bool { !b }

export "C" fn widths(a: i8, b: u8, c: i16, d: u16, e: i32, f: u32, g: i64, h: u64) -> i64 {
    (a as i64) + (b as i64) + (c as i64) + (d as i64) + (e as i64) + (f as i64) + g + (h as i64)
}

export "C" fn floats(x: f32, y: f64) -> f64 { (x as f64) * y }

export "C" fn fill(out: *i32, n: u64) {
    for i in 0..n { out[i] = (i * i) as i32; }
}

export "C" fn first_byte(pp: **u8) -> u8 { (*pp)[0] }

/// `str` in and out: a pointer and a length.
export "C" fn longer(a: str, b: str) -> str { if b.len > a.len { b } else { a } }
export "C" fn str_len(s: str) -> u64 { s.len }

/// A C callback.
export "C" fn apply_twice(f: fn(i32) -> i32, x: i32) -> i32 { f(f(x)) }

/// Libraries have no command line.
export "C" fn arg_count() -> u64 { os.arg_count() }

// std.rt: recover from deep inside code with no error path, twice nested.
struct Job { depth: i32, limit: i32 }

fn dive(j: *Job) {
    if j.depth == j.limit { rt.throw(); }
    j.depth += 1;
    dive(j);
}

fn job(data: *u8) { dive(data as *Job); }

fn outer(data: *u8) {
    let j = data as *Job;
    var inner = Job { depth: 0, limit: 5 };
    if !rt.protect(job, &inner as *u8) { j.depth = inner.depth * 100; }
    j.limit += j.depth;
    dive(j);
}

/// -1 if no throw; else the depth reached (with `nested`, after an inner
/// protect caught a throw at depth 5, 500 + limit).
export "C" fn protected_depth(limit: i32, nested: bool) -> i32 {
    var j = Job { depth: 0, limit: limit };
    let ok = rt.protect(if nested { outer } else { job }, &j as *u8);
    if ok { -1 } else { j.depth }
}

// Constants in the header, with their documentation.

/// Flags: a `u32` constant.
export "C" const API_FLAG_A: u32 = 1;
export "C" const API_FLAG_B: u32 = API_FLAG_A << 1;
export "C" const API_MIN: i32 = -5;
export "C" const API_BIG: u64 = 0x100000000;
export "C" const API_ON: bool = true;
export "C" const API_NAME: str = "api \"v1\"";
export "C" const API_SUB: Mode = Mode.Sub;

export "C" fn point_new(x: i64, y: i64) -> *Point {
    let p: *Point = mem.alloc(1);
    p.x = x;
    p.y = y;
    p
}

/// Read-only parameters: `const` in C.
#[c_const(p, bytes)]
export "C" fn point_sum(p: *Point, bytes: *u8, n: u64) -> i64 {
    var t = p.x + p.y;
    for i in 0..n { t += bytes[i] as i64; }
    t
}
