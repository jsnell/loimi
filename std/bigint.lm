// Arbitrary-precision integers (docs/stdlib.md, "std.bigint").
//
// Three layers over one representation: a magnitude of 64-bit limbs,
// least significant first, normalized (no zero limb at the top; zero has
// no limbs), plus a sign.
//
// - `Num` is a view: a sign and a slice of limbs that someone else owns.
//   Every operation reads `Num`s and writes its result into a buffer the
//   caller provides (`add_into(out, a, b)`), sized by the matching
//   `*_size` function, and returns the result as a `Num` over the start of
//   that buffer. Nothing here allocates except scratch space for the
//   algorithms, which is freed before returning. An interpreter keeps
//   limbs wherever it likes (a GC object's trailing array, an arena).
// - `BigInt` owns its limbs (a `mem.Vec<u64>` on the C heap):
//   `bigint.add(a, b) -> BigInt`, freed with `x.free()`.
// - `Big` is a GC object holding limbs, and `gc_add(h, a, b) -> Gc<Big>`
//   computes straight into a new one. Operands are `Arg`s (a small `i64`
//   or a `Gc<Big>`). Allocating does not collect (collections run at the
//   interpreter's safepoints), so none of these has an effect.
//
// Small integers are the interpreter's business: keep them unboxed in the
// value type and come here on overflow (`num.add_overflow`), making a
// `Num` of an `i64` with `from_i64(buf, x)` (one limb of buffer).
//
// Algorithms (thresholds below, in limbs, measured; docs/stdlib.md has
// the numbers): schoolbook multiplication (row by row, or column by
// column for longer operands), Karatsuba, Toom-3; the same three for
// squaring, used whenever both operands are the same limbs; Knuth's
// algorithm D (dividing by a precomputed reciprocal, not `div_wide`,
// which is a libcall) and above DIV_DC recursive divide-and-conquer
// division (Burnikel-Ziegler, as in GMP's mpn_dcpi1_div_qr); Zimmermann's
// Karatsuba square root; binary powering; divide-and-conquer formatting
// (over the fast division) and parsing. Not built: FFT multiplication,
// unbalanced Toom variants, Newton (Barrett) division, subquadratic gcd.

import std.mem;
import std.text;
import std.gc;

extern "C" fn loimi_panic(msg: *u8, len: u64);

/// Multiplications of at least this many limbs (both operands) use
/// Karatsuba's algorithm.
pub const KARATSUBA: u64 = 48;
/// Squarings of at least this many limbs use Karatsuba squaring.
pub const KARATSUBA_SQR: u64 = 48;
/// Products of at least this many limbs (both operands) use Toom-3.
pub const TOOM3: u64 = 250;
/// Squarings of at least this many limbs use Toom-3 squaring.
pub const TOOM3_SQR: u64 = 500;
/// Schoolbook products and squares sum column by column (Comba) when
/// the shorter operand has at least this many limbs, row by row below.
const MUL_COLUMNS: u64 = 14;
const SQR_COLUMNS: u64 = 14;
/// Divisions whose divisor and quotient both have at least this many
/// limbs use divide-and-conquer (Burnikel-Ziegler) division.
pub const DIV_DC: u64 = 80;
/// Formatting numbers of more limbs than this splits them in halves
/// (divide and conquer).
pub const DC_LIMBS: u64 = 16;
/// Parsing more than this many limbs' worth of digits splits the digits
/// (divide and conquer).
pub const PARSE_DC: u64 = 512;

/// A signed integer: `neg` and the magnitude `d` (limbs, least
/// significant first). Normalized: `d` has no zero limb at the top, and
/// zero (no limbs) is not negative. Functions here return normalized
/// views, and expect them.
pub struct Num { neg: bool, d: []u64 }

fn fail(m: str) {
    loimi_panic(m.ptr, m.len);
}

fn need(out: []u64, n: u64) {
    if out.len < n { fail("std.bigint: output buffer too small\n"); }
}

fn max(a: u64, b: u64) -> u64 { if a > b { a } else { b } }
fn min(a: u64, b: u64) -> u64 { if a < b { a } else { b } }

/// Length of `p[0..n]` without its zero limbs at the top.
fn norm(p: *u64, n: u64) -> u64 {
    var k = n;
    while k > 0 and p[k - 1] == 0 { k -= 1; }
    k
}

/// The normalized view of `p[0..n]` with sign `neg` (dropped for zero).
fn view(p: *u64, n: u64, neg: bool) -> Num {
    let k = norm(p, n);
    Num { neg: neg and k != 0, d: p.slice(k) }
}

/// Zero.
pub fn zero() -> Num { Num { neg: false, d: [] } }

/// A view of `p[0..n]` (normalized here: top zero limbs are dropped).
pub fn of_limbs(p: *u64, n: u64, neg: bool) -> Num { view(p, n, neg) }

// ── magnitudes: raw limb arithmetic ────────────────────────────────

fn mag_cmp(a: *u64, na: u64, b: *u64, nb: u64) -> i32 {
    if na != nb { return if na < nb { -1 } else { 1 }; }
    var i = na;
    while i > 0 {
        i -= 1;
        let x = a[i];
        let y = b[i];
        if x != y { return if x < y { -1 } else { 1 }; }
    }
    0
}

/// r[0..na] = a + b (na >= nb); returns the carry. `r` may be `a`.
fn add_to(r: *u64, a: *u64, na: u64, b: *u64, nb: u64) -> u64 {
    var c: u64 = 0;
    var i: u64 = 0;
    while i < nb {
        let x = a[i];
        let s = x +% b[i];
        let t = s +% c;
        c = if s < x or t < s { 1 } else { 0 };
        r[i] = t;
        i += 1;
    }
    while i < na {
        let x = a[i];
        let t = x +% c;
        c = if t < x { 1 } else { 0 };
        r[i] = t;
        i += 1;
    }
    c
}

/// r[0..rn] += b[0..nb] (rn >= nb), stopping once the carry is
/// absorbed; returns the carry out of r[rn - 1].
fn add_in(r: *u64, rn: u64, b: *u64, nb: u64) -> u64 {
    var c: u64 = 0;
    var i: u64 = 0;
    while i < nb {
        let x = r[i];
        let s = x +% b[i];
        let t = s +% c;
        c = if s < x or t < s { 1 } else { 0 };
        r[i] = t;
        i += 1;
    }
    while c != 0 and i < rn {
        let t = r[i] +% 1;
        r[i] = t;
        c = if t == 0 { 1 } else { 0 };
        i += 1;
    }
    c
}

/// r[0..na] = a - b (na >= nb); returns the borrow. `r` may be `a`.
fn sub_to(r: *u64, a: *u64, na: u64, b: *u64, nb: u64) -> u64 {
    var br: u64 = 0;
    var i: u64 = 0;
    while i < nb {
        let x = a[i];
        let y = b[i];
        let d = x -% y;
        r[i] = d -% br;
        br = if x < y or d < br { 1 } else { 0 };
        i += 1;
    }
    while i < na {
        let x = a[i];
        r[i] = x -% br;
        br = if x < br { 1 } else { 0 };
        i += 1;
    }
    br
}

/// r[0..rn] -= b[0..nb] (rn >= nb), stopping once the borrow is
/// absorbed; returns the borrow.
fn sub_in(r: *u64, rn: u64, b: *u64, nb: u64) -> u64 {
    var br: u64 = 0;
    var i: u64 = 0;
    while i < nb {
        let x = r[i];
        let y = b[i];
        let d = x -% y;
        r[i] = d -% br;
        br = if x < y or d < br { 1 } else { 0 };
        i += 1;
    }
    while br != 0 and i < rn {
        let x = r[i];
        r[i] = x -% 1;
        br = if x == 0 { 1 } else { 0 };
        i += 1;
    }
    br
}

/// r[0..n] = a * m; returns the carry limb. `r` may be `a`.
fn mul_1(r: *u64, a: *u64, n: u64, m: u64) -> u64 {
    var c: u64 = 0;
    for i in 0..n {
        let (lo, hi) = a[i].mul_wide(m);
        let t = lo +% c;
        c = hi + (if t < lo { 1 } else { 0 });
        r[i] = t;
    }
    c
}

/// r[0..n] += a * m; returns the carry limb.
fn addmul_1(r: *u64, a: *u64, n: u64, m: u64) -> u64 {
    var c: u64 = 0;
    for i in 0..n {
        let (lo, hi) = a[i].mul_wide(m);
        let t = lo +% c;
        var h = hi + (if t < lo { 1 } else { 0 });
        let u = r[i] +% t;
        h += if u < t { 1 } else { 0 };
        r[i] = u;
        c = h;
    }
    c
}

/// r[0..n] -= a * m; returns the borrow limb.
fn submul_1(r: *u64, a: *u64, n: u64, m: u64) -> u64 {
    var c: u64 = 0;
    for i in 0..n {
        let (lo, hi) = a[i].mul_wide(m);
        let t = lo +% c;
        var h = hi + (if t < lo { 1 } else { 0 });
        let x = r[i];
        r[i] = x -% t;
        h += if x < t { 1 } else { 0 };
        c = h;
    }
    c
}

/// r[0..na + nb] = a * b (na >= nb >= 1); r must not overlap a or b.
fn mul_basecase(r: *u64, a: *u64, na: u64, b: *u64, nb: u64) {
    if nb < MUL_COLUMNS {
        // Row by row.
        r[na] = mul_1(r, a, na, b[0]);
        for j in 1..nb {
            r[na + j] = addmul_1(r + j, a, na, b[j]);
        }
        return;
    }
    // Column by column (Comba): each result limb is the sum of its
    // products in a three-limb accumulator, so one store per limb; two
    // accumulators (alternate products) halve the carry chains.
    var c0: u64 = 0;
    var c1: u64 = 0;
    var c2: u64 = 0;
    for k in 0..na + nb - 1 {
        let i0 = if k >= nb { k - nb + 1 } else { 0 };
        let i1 = if k < na { k + 1 } else { na };
        var d0: u64 = 0;
        var d1: u64 = 0;
        var d2: u64 = 0;
        var i = i0;
        while i + 1 < i1 {
            let (lo, hi) = a[i].mul_wide(b[k - i]);
            let s0 = c0 +% lo;
            let t = hi + (if s0 < lo { 1 } else { 0 });
            let s1 = c1 +% t;
            c2 += if s1 < t { 1 } else { 0 };
            c0 = s0;
            c1 = s1;
            let (lo2, hi2) = a[i + 1].mul_wide(b[k - i - 1]);
            let e0 = d0 +% lo2;
            let u = hi2 + (if e0 < lo2 { 1 } else { 0 });
            let e1 = d1 +% u;
            d2 += if e1 < u { 1 } else { 0 };
            d0 = e0;
            d1 = e1;
            i += 2;
        }
        if i < i1 {
            let (lo, hi) = a[i].mul_wide(b[k - i]);
            let s0 = c0 +% lo;
            let t = hi + (if s0 < lo { 1 } else { 0 });
            let s1 = c1 +% t;
            c2 += if s1 < t { 1 } else { 0 };
            c0 = s0;
            c1 = s1;
        }
        let s0 = c0 +% d0;
        let s1 = c1 +% d1;
        let s2 = s1 +% (if s0 < d0 { 1 } else { 0 });
        c2 += d2 + (if s1 < d1 { 1 } else { 0 }) + (if s2 < s1 { 1 } else { 0 });
        r[k] = s0;
        c0 = s2;
        c1 = c2;
        c2 = 0;
    }
    r[na + nb - 1] = c0;
}

/// r[0..2n] = a * b, both n limbs, by Karatsuba's algorithm.
fn kmul(r: *u64, a: *u64, b: *u64, n: u64) {
    if n < KARATSUBA {
        mul_basecase(r, a, n, b, n);
        return;
    }
    let h = n / 2;
    let hh = n - h;
    kmul(r, a, b, h);
    kmul(r + 2 * h, a + h, b + h, hh);
    let m = hh + 1;
    let t: *u64 = mem.alloc(4 * m);
    let sa = t;
    let sb = t + m;
    let z = t + 2 * m;
    sa[hh] = add_to(sa, a + h, hh, a, h);
    sb[hh] = add_to(sb, b + h, hh, b, h);
    kmul(z, sa, sb, m);
    sub_in(z, 2 * m, r, 2 * h);
    sub_in(z, 2 * m, r + 2 * h, 2 * hh);
    add_in(r + h, 2 * n - h, z, norm(z, 2 * m));
    mem.release(t);
}

/// r[0..2n] = a * a (n >= 1) by schoolbook squaring: the products
/// a[i] * a[j] for i < j once, doubled, plus the squares a[i] * a[i].
/// Column by column like mul_basecase (rows for short numbers). r must
/// not overlap a.
fn sqr_basecase(r: *u64, a: *u64, n: u64) {
    if n < SQR_COLUMNS {
        sqr_rows(r, a, n);
        return;
    }
    var c0: u64 = 0;
    var c1: u64 = 0;
    var c2: u64 = 0;
    for k in 0..2 * n - 1 {
        // The column's products a[i] a[k - i] for i < k - i, doubled,
        // plus the square on the diagonal.
        var d0: u64 = 0;
        var d1: u64 = 0;
        var d2: u64 = 0;
        var i = if k >= n { k - n + 1 } else { 0 };
        while 2 * i < k {
            let (lo, hi) = a[i].mul_wide(a[k - i]);
            let s0 = d0 +% lo;
            let t = hi + (if s0 < lo { 1 } else { 0 });
            let s1 = d1 +% t;
            d2 += if s1 < t { 1 } else { 0 };
            d0 = s0;
            d1 = s1;
            i += 1;
        }
        d2 = (d2 << 1) | (d1 >> 63);
        d1 = (d1 << 1) | (d0 >> 63);
        d0 = d0 << 1;
        if (k & 1) == 0 {
            let (lo, hi) = a[k / 2].mul_wide(a[k / 2]);
            let s0 = d0 +% lo;
            let s1 = d1 +% hi;
            let s2 = s1 +% (if s0 < lo { 1 } else { 0 });
            d2 += (if s1 < hi { 1 } else { 0 }) + (if s2 < s1 { 1 } else { 0 });
            d0 = s0;
            d1 = s2;
        }
        let s0 = c0 +% d0;
        let s1 = c1 +% d1;
        let s2 = s1 +% (if s0 < d0 { 1 } else { 0 });
        c2 += d2 + (if s1 < d1 { 1 } else { 0 }) + (if s2 < s1 { 1 } else { 0 });
        r[k] = s0;
        c0 = s2;
        c1 = c2;
        c2 = 0;
    }
    r[2 * n - 1] = c0;
}

/// sqr_basecase row by row: the off-diagonal products with mul_1 and
/// addmul_1, shifted, plus the diagonal.
fn sqr_rows(r: *u64, a: *u64, n: u64) {
    if n == 1 {
        let (lo, hi) = a[0].mul_wide(a[0]);
        r[0] = lo;
        r[1] = hi;
        return;
    }
    r[0] = 0;
    r[2 * n - 1] = 0;
    r[n] = mul_1(r + 1, a + 1, n - 1, a[0]);
    for i in 1..n - 1 {
        r[n + i] = addmul_1(r + 2 * i + 1, a + i + 1, n - i - 1, a[i]);
    }
    lshift(r, r, 2 * n, 1);
    var c: u64 = 0;
    for i in 0..n {
        let (lo, hi) = a[i].mul_wide(a[i]);
        let x = r[2 * i];
        let s1 = x +% lo;
        let s2 = s1 +% c;
        let c1: u64 = if s1 < x or s2 < s1 { 1 } else { 0 };
        r[2 * i] = s2;
        let y = r[2 * i + 1];
        let t1 = y +% hi;
        let t2 = t1 +% c1;
        c = if t1 < y or t2 < t1 { 1 } else { 0 };
        r[2 * i + 1] = t2;
    }
}

/// r[0..2n] = a * a by Karatsuba squaring: with a = a1 B^h + a0,
/// 2 a0 a1 = a0^2 + a1^2 - (a1 - a0)^2. r must not overlap a.
fn ksqr(r: *u64, a: *u64, n: u64) {
    if n < KARATSUBA_SQR {
        sqr_basecase(r, a, n);
        return;
    }
    let h = n / 2;
    let hh = n - h;
    ksqr(r, a, h);
    ksqr(r + 2 * h, a + h, hh);
    let t: *u64 = mem.alloc(5 * hh + 1);
    let d = t;
    let z = t + hh;
    let w = t + 3 * hh;
    // d = |a1 - a0| (hh limbs; a0 has h <= hh)
    if mag_cmp(a + h, norm(a + h, hh), a, norm(a, h)) >= 0 {
        sub_to(d, a + h, hh, a, h);
    } else {
        // a1 < a0, so a1's limb h (if hh > h) is zero.
        sub_to(d, a, h, a + h, h);
        if hh > h { d[h] = 0; }
    }
    let nd = norm(d, hh);
    // w = a0^2 + a1^2 - d^2 = 2 a0 a1
    mem.copy(w, r + 2 * h, 2 * hh);
    w[2 * hh] = add_in(w, 2 * hh, r, 2 * h);
    if nd > 0 {
        ksqr(z, d, nd);
        sub_in(w, 2 * hh + 1, z, 2 * nd);
    }
    add_in(r + h, 2 * n - h, w, norm(w, 2 * hh + 1));
    mem.release(t);
}

/// r[0..2n] = a * a (n >= 1); r must not overlap a.
fn sqr_mag(r: *u64, a: *u64, n: u64) {
    if n >= TOOM3_SQR { toom3(r, a, a, n); } else { ksqr(r, a, n); }
}

/// r[0..2n] = a * b, both n limbs: Toom-3, Karatsuba or schoolbook.
fn mul_n(r: *u64, a: *u64, b: *u64, n: u64) {
    if n >= TOOM3 { toom3(r, a, b, n); } else if n >= KARATSUBA { kmul(r, a, b, n); } else { mul_basecase(r, a, n, b, n); }
}

/// x / 3 for x a multiple of 3.
fn div3(x: Num) -> BigInt {
    var v = room(max(x.d.len, 1));
    divrem_1(v.ptr, x.d.ptr, x.d.len, 3);
    own(v, view(v.ptr, x.d.len, x.neg))
}

/// x = x + y, replacing (and freeing) x.
fn acc_add(x: *BigInt, y: Num) { let z = add(x.num(), y); x.free(); *x = z; }
fn acc_sub(x: *BigInt, y: Num) { let z = sub(x.num(), y); x.free(); *x = z; }

/// The values of a2 t^2 + a1 t + a0 at t = 1, -1, -2: (p1, pm1, pm2).
fn toom3_eval(a0: Num, a1: Num, a2: Num) -> (BigInt, BigInt, BigInt) {
    var t = add(a0, a2);
    let p1 = add(t.num(), a1);
    var pm1 = sub(t.num(), a1);
    t.free();
    // pm2 = 2 (pm1 + a2) - a0
    var u = add(pm1.num(), a2);
    var v = shl(u.num(), 1);
    let pm2 = sub(v.num(), a0);
    u.free();
    v.free();
    (p1, pm1, pm2)
}

/// r[0..2n] = a * b, both n limbs, by Toom-3: a and b split in three
/// pieces of k limbs, as polynomials evaluated at 0, 1, -1, -2 and
/// infinity, five products of about n / 3 limbs (recursively), and
/// Bodrato's interpolation sequence. a == b squares (five squarings).
/// Works on owned temporaries: it runs only on hundreds of limbs.
fn toom3(r: *u64, a: *u64, b: *u64, n: u64) {
    let k = (n + 2) / 3;
    let a0 = view(a, k, false);
    let a1 = view(a + k, k, false);
    let a2 = view(a + 2 * k, n - 2 * k, false);
    let b0 = view(b, k, false);
    let b1 = view(b + k, k, false);
    let b2 = view(b + 2 * k, n - 2 * k, false);
    let sq = a == b;
    let (e1, em1, em2) = toom3_eval(a0, a1, a2);
    var p1 = e1;
    var pm1 = em1;
    var pm2 = em2;
    var r1 = BigInt { neg: false, d: mem.Vec.new() };
    var rm1 = BigInt { neg: false, d: mem.Vec.new() };
    var rm2 = BigInt { neg: false, d: mem.Vec.new() };
    if sq {
        r1 = mul(p1.num(), p1.num());
        rm1 = mul(pm1.num(), pm1.num());
        rm2 = mul(pm2.num(), pm2.num());
    } else {
        let (f1, fm1, fm2) = toom3_eval(b0, b1, b2);
        var q1 = f1;
        var qm1 = fm1;
        var qm2 = fm2;
        r1 = mul(p1.num(), q1.num());
        rm1 = mul(pm1.num(), qm1.num());
        rm2 = mul(pm2.num(), qm2.num());
        q1.free();
        qm1.free();
        qm2.free();
    }
    p1.free();
    pm1.free();
    pm2.free();
    var r0 = mul(a0, b0);
    var rinf = mul(a2, b2);
    // r3 = (rm2 - r1) / 3
    acc_sub(&rm2, r1.num());
    var r3 = div3(rm2.num());
    rm2.free();
    // r1 = (r1 - rm1) / 2
    acc_sub(&r1, rm1.num());
    var h = shr(r1.num(), 1);
    r1.free();
    r1 = h;
    // r2 = rm1 - r0
    var r2 = sub(rm1.num(), r0.num());
    rm1.free();
    // r3 = (r2 - r3) / 2 + 2 rinf
    var d = sub(r2.num(), r3.num());
    r3.free();
    r3 = shr(d.num(), 1);
    d.free();
    acc_add(&r3, rinf.num());
    acc_add(&r3, rinf.num());
    // r2 = r2 + r1 - rinf; r1 = r1 - r3
    acc_add(&r2, r1.num());
    acc_sub(&r2, rinf.num());
    acc_sub(&r1, r3.num());
    // r = r0 + r1 B^k + r2 B^2k + r3 B^3k + rinf B^4k (all nonnegative)
    mem.memset(r as *u8, 0, 2 * n * 8);
    mem.copy(r, r0.d.ptr, r0.d.len);
    add_in(r + k, 2 * n - k, r1.d.ptr, r1.d.len);
    add_in(r + 2 * k, 2 * n - 2 * k, r2.d.ptr, r2.d.len);
    add_in(r + 3 * k, 2 * n - 3 * k, r3.d.ptr, r3.d.len);
    add_in(r + 4 * k, 2 * n - 4 * k, rinf.d.ptr, rinf.d.len);
    r0.free();
    r1.free();
    r2.free();
    r3.free();
    rinf.free();
}

/// r[0..na + nb] = a * b (na >= nb >= 1); r must not overlap a or b.
fn mul_mag(r: *u64, a: *u64, na: u64, b: *u64, nb: u64) {
    if a == b and na == nb {
        sqr_mag(r, a, na);
        return;
    }
    if nb < KARATSUBA {
        mul_basecase(r, a, na, b, nb);
        return;
    }
    if na == nb {
        mul_n(r, a, b, na);
        return;
    }
    // Unbalanced: multiply b by na / nb pieces of a.
    mem.memset(r as *u8, 0, (na + nb) * 8);
    let t: *u64 = mem.alloc(2 * nb);
    var off: u64 = 0;
    while off < na {
        let len = min(nb, na - off);
        if len == nb { mul_n(t, a + off, b, nb); } else { mul_mag(t, b, nb, a + off, len); }
        add_in(r + off, na + nb - off, t, len + nb);
        off += len;
    }
    mem.release(t);
}

/// The reciprocal floor((B^2 - 1) / d) - B of a normalized limb d
/// (top bit set), for `div_pi`.
fn reciprocal(d: u64) -> u64 {
    let (v, _) = (~d).div_wide(0xffffffffffffffff, d);
    v
}

/// (nh nl) divmod d for nh < d, d normalized, di = reciprocal(d):
/// Moller and Granlund's division by an invariant integer, two
/// multiplications instead of a 128-bit division (which is a libcall).
fn div_pi(nh: u64, nl: u64, d: u64, di: u64) -> (u64, u64) {
    let (pl, ph) = nh.mul_wide(di);
    let ql = pl +% nl;
    var qh = ph +% nh +% 1 +% (if ql < pl { 1 } else { 0 });
    var r = nl -% (qh *% d);
    if r > ql {
        qh = qh -% 1;
        r = r +% d;
    }
    if r >= d {
        qh += 1;
        r -= d;
    }
    (qh, r)
}

/// q[0..n] = a / d, returns a % d (d != 0). `q` may be `a`.
fn divrem_1(q: *u64, a: *u64, n: u64, d: u64) -> u64 {
    if n == 0 { return 0; }
    let s = d.clz() as u64;
    let dn = d << s;
    let di = reciprocal(dn);
    var r: u64 = 0;
    var i = n;
    if s == 0 {
        while i > 0 {
            i -= 1;
            let (qq, rr) = div_pi(r, a[i], dn, di);
            q[i] = qq;
            r = rr;
        }
        return r;
    }
    // Divide a << s by d << s, shifting a limb at a time.
    r = a[n - 1] >> (64 - s);
    while i > 0 {
        i -= 1;
        let lo = if i > 0 { a[i - 1] >> (64 - s) } else { 0 };
        let (qq, rr) = div_pi(r, (a[i] << s) | lo, dn, di);
        q[i] = qq;
        r = rr;
    }
    r >> s
}

/// r[0..n] = a << s for 1 <= s < 64; returns the bits shifted out.
/// `r` may be `a`.
fn lshift(r: *u64, a: *u64, n: u64, s: u64) -> u64 {
    if n == 0 { return 0; }
    let out = a[n - 1] >> (64 - s);
    var i = n - 1;
    while i > 0 {
        r[i] = (a[i] << s) | (a[i - 1] >> (64 - s));
        i -= 1;
    }
    r[0] = a[0] << s;
    out
}

/// r[0..n] = a >> s for 1 <= s < 64. `r` may be `a`.
fn rshift(r: *u64, a: *u64, n: u64, s: u64) {
    if n == 0 { return; }
    for i in 0..n - 1 {
        r[i] = (a[i] >> s) | (a[i + 1] << (64 - s));
    }
    r[n - 1] = a[n - 1] >> s;
}

/// q[0..n] -= 1; returns the borrow.
fn decr(q: *u64, n: u64) -> u64 {
    var one: [u64; 1] = [1; 1];
    if n == 0 { return 1; }
    sub_in(q, n, &one[0], 1)
}

// Division works on a normalized divisor d (top bit set) and divides in
// place: the dividend n[0..nn] is overwritten, its low dn limbs ending as
// the remainder. Each routine writes nn - dn quotient limbs to q and
// returns the quotient's limb above those (0 or 1).

/// Knuth's algorithm D (nn >= dn >= 2).
fn sb_div_qr(q: *u64, an: *u64, nn: u64, bn: *u64, nb: u64) -> u64 {
    var qh: u64 = 0;
    if mag_cmp(an + nn - nb, nb, bn, nb) >= 0 {
        sub_in(an + nn - nb, nb, bn, nb);
        qh = 1;
    }
    let btop = bn[nb - 1];
    let bsec = bn[nb - 2];
    let binv = reciprocal(btop);
    var j = nn - nb;
    while j > 0 {
        j -= 1;
        let hi = an[j + nb];
        let lo = an[j + nb - 1];
        var qhat: u64 = 0;
        var rhat: u64 = 0;
        var rover = false;
        if hi >= btop {
            qhat = 0xffffffffffffffff;
            rhat = lo +% btop;
            rover = rhat < lo;
        } else {
            let (qq, rr) = div_pi(hi, lo, btop, binv);
            qhat = qq;
            rhat = rr;
        }
        let t = an[j + nb - 2];
        while !rover {
            let (pl, ph) = qhat.mul_wide(bsec);
            if ph > rhat or (ph == rhat and pl > t) {
                qhat -= 1;
                let nr = rhat +% btop;
                rover = nr < rhat;
                rhat = nr;
            } else {
                break;
            }
        }
        let br = submul_1(an + j, bn, nb, qhat);
        let top = an[j + nb];
        an[j + nb] = top -% br;
        if top < br {
            qhat -= 1;
            let c = add_in(an + j, nb, bn, nb);
            an[j + nb] = an[j + nb] +% c;
        }
        q[j] = qhat;
    }
    qh
}

/// Divide-and-conquer division of n[0..2m] by d[0..m] (Burnikel and
/// Ziegler; the structure of GMP's mpn_dcpi1_div_qr_n): the high half of
/// the quotient from the top halves of both (recursively), then the
/// product of that half by d's low half subtracted, then the same for the
/// low half. tp: m limbs of scratch.
fn dc_div_qr_n(q: *u64, n: *u64, d: *u64, m: u64, tp: *u64) -> u64 {
    let lo = m / 2;
    let hi = m - lo;
    var qh = if hi < DIV_DC { sb_div_qr(q + lo, n + 2 * lo, 2 * hi, d + lo, hi) } else { dc_div_qr_n(q + lo, n + 2 * lo, d + lo, hi, tp) };
    mul_mag(tp, q + lo, hi, d, lo);
    var cy = sub_to(n + lo, n + lo, m, tp, m);
    if qh != 0 { cy += sub_to(n + m, n + m, lo, d, lo); }
    while cy != 0 {
        qh -= decr(q + lo, hi);
        cy -= add_to(n + lo, n + lo, m, d, m);
    }
    let ql = if lo < DIV_DC { sb_div_qr(q, n + hi, 2 * lo, d + hi, lo) } else { dc_div_qr_n(q, n + hi, d + hi, lo, tp) };
    mul_mag(tp, d, hi, q, lo);
    cy = sub_to(n, n, m, tp, m);
    if ql != 0 { cy += sub_to(n + lo, n + lo, hi, d, hi); }
    while cy != 0 {
        decr(q, lo);
        cy -= add_to(n, n, m, d, m);
    }
    qh
}

/// Division of n[0..nn] by d[0..dn] (nn >= dn >= 2): Knuth's algorithm D
/// when the divisor or the quotient is short, otherwise divide and
/// conquer in blocks of dn quotient limbs.
fn div_qr(q: *u64, n: *u64, nn: u64, d: *u64, dn: u64) -> u64 {
    let qn = nn - dn;
    if dn < DIV_DC or qn < DIV_DC { return sb_div_qr(q, n, nn, d, dn); }
    let tp: *u64 = mem.alloc(dn);
    var qh: u64 = 0;
    if qn >= dn {
        // A short block of qn % dn quotient limbs at the top, then full
        // blocks (each one's remainder is the top of the next dividend).
        let k = qn % dn;
        var off = qn - k;
        var first = true;
        if k > 0 {
            qh = div_qr(q + off, n + off, dn + k, d, dn);
            first = false;
        }
        while off > 0 {
            off -= dn;
            let h = dc_div_qr_n(q + off, n + off, d, dn, tp);
            if first { qh = h; first = false; }
        }
    } else {
        // Divide the top 2 qn limbs by d's top qn limbs, then subtract the
        // quotient times d's low limbs and correct.
        let lo = dn - qn;
        qh = dc_div_qr_n(q, n + lo, d + lo, qn, tp);
        if qn >= lo { mul_mag(tp, q, qn, d, lo); } else { mul_mag(tp, d, lo, q, qn); }
        var cy = sub_to(n, n, dn, tp, dn);
        if qh != 0 { cy += sub_to(n + qn, n + qn, lo, d, lo); }
        while cy != 0 {
            qh -= decr(q, qn);
            cy -= add_to(n, n, dn, d, dn);
        }
    }
    mem.release(tp);
    qh
}

/// q[0..na - nb + 1] = a / b and r[0..nb] = a % b, for na >= nb >= 2 and
/// b normalized. q and r must not overlap a or b.
fn divrem(q: *u64, r: *u64, a: *u64, na: u64, b: *u64, nb: u64) {
    let s = b[nb - 1].clz() as u64;
    let bn: *u64 = mem.alloc(nb);
    let an: *u64 = mem.alloc(na + 1);
    if s > 0 {
        lshift(bn, b, nb, s);
        an[na] = lshift(an, a, na, s);
    } else {
        mem.copy(bn, b, nb);
        mem.copy(an, a, na);
        an[na] = 0;
    }
    // an's top limb is below bn's, so the quotient has na - nb + 1 limbs.
    div_qr(q, an, na + 1, bn, nb);
    if s > 0 { rshift(r, an, nb, s); } else { mem.copy(r, an, nb); }
    mem.release(an);
    mem.release(bn);
}

/// Magnitude division into fresh buffers: (q, nq, r, nr), normalized.
/// b must be nonzero. The caller releases q and r.
fn divmod_alloc(a: []u64, b: []u64) -> (*u64, u64, *u64, u64) {
    let na = a.len;
    let nb = b.len;
    if na < nb {
        let r: *u64 = mem.alloc(nb);
        mem.copy(r, a.ptr, na);
        return (mem.alloc(1), 0, r, na);
    }
    let q: *u64 = mem.alloc(na - nb + 1);
    let r: *u64 = mem.alloc(nb);
    if nb == 1 {
        r[0] = divrem_1(q, a.ptr, na, b[0]);
        return (q, norm(q, na), r, norm(r, 1));
    }
    divrem(q, r, a.ptr, na, b.ptr, nb);
    (q, norm(q, na - nb + 1), r, norm(r, nb))
}

// ── views: predicates, comparison, conversions ──────────────────────

pub fn is_zero(a: Num) -> bool { a.d.len == 0 }

/// -1, 0 or 1.
pub fn sign(a: Num) -> i32 {
    if a.d.len == 0 { 0 } else if a.neg { -1 } else { 1 }
}

pub fn is_odd(a: Num) -> bool { a.d.len > 0 and (a.d[0] & 1) != 0 }

/// Number of bits of |a| (0 for zero), Python's `int.bit_length`.
pub fn bit_length(a: Num) -> u64 {
    let n = a.d.len;
    if n == 0 { return 0; }
    64 * n - (a.d[n - 1].clz() as u64)
}

/// -1, 0 or 1 as a < b, a == b, a > b.
pub fn cmp(a: Num, b: Num) -> i32 {
    if a.neg != b.neg { return if a.neg { -1 } else { 1 }; }
    let c = mag_cmp(a.d.ptr, a.d.len, b.d.ptr, b.d.len);
    if a.neg { 0 - c } else { c }
}

/// Compare magnitudes: |a| against |b|.
pub fn cmp_abs(a: Num, b: Num) -> i32 { mag_cmp(a.d.ptr, a.d.len, b.d.ptr, b.d.len) }

pub fn eq(a: Num, b: Num) -> bool { a.neg == b.neg and cmp_abs(a, b) == 0 }

/// -a, as a view of the same limbs.
pub fn neg(a: Num) -> Num { Num { neg: !a.neg and a.d.len != 0, d: a.d } }

/// |a|, as a view of the same limbs.
pub fn abs(a: Num) -> Num { Num { neg: false, d: a.d } }

/// `x` as a view of `out` (one limb).
pub fn from_i64(out: []u64, x: i64) -> Num {
    need(out, 1);
    let m = if x < 0 { (0 -% x) as u64 } else { x as u64 };
    out[0] = m;
    view(out.ptr, 1, x < 0)
}

/// `x` as a view of `out` (one limb).
pub fn from_u64(out: []u64, x: u64) -> Num {
    need(out, 1);
    out[0] = x;
    view(out.ptr, 1, false)
}

/// a as an i64, if it fits.
pub fn to_i64(a: Num) -> ?i64 {
    if a.d.len == 0 { return Some(0); }
    if a.d.len > 1 { return None; }
    let m = a.d[0];
    if a.neg {
        if m > 0x8000000000000000 { return None; }
        return Some(0 -% (m as i64));
    }
    if m > 0x7fffffffffffffff { return None; }
    Some(m as i64)
}

/// a as a u64, if it fits (and is not negative).
pub fn to_u64(a: Num) -> ?u64 {
    if a.d.len == 0 { return Some(0); }
    if a.neg or a.d.len > 1 { return None; }
    Some(a.d[0])
}

/// The low 64 bits of a in two's complement (C-style wrapping
/// conversion: `(u64) a`).
pub fn to_u64_wrapping(a: Num) -> u64 {
    if a.d.len == 0 { return 0; }
    if a.neg { 0 -% a.d[0] } else { a.d[0] }
}

/// The nearest f64 (ties to even), as Python's `float(n)`; ±inf when
/// |a| rounds to 2^1024 or more (Python raises OverflowError there).
pub fn to_f64(a: Num) -> f64 {
    let n = a.d.len;
    if n == 0 { return 0.0; }
    let bits = bit_length(a);
    var f: f64 = 0.0;
    if bits <= 64 {
        f = a.d[0] as f64;
    } else if bits > 1024 {
        f = 1.0 / 0.0;
    } else {
        // The top 64 bits, with a sticky bit for anything nonzero below:
        // rounding them to 53 bits rounds the whole number correctly.
        let shift = bits - 64;
        let li = shift / 64;
        let bi = shift % 64;
        var top = a.d[li] >> bi;
        if bi != 0 { top = top | (a.d[li + 1] << (64 - bi)); }
        var sticky = bi != 0 and (a.d[li] << (64 - bi)) != 0;
        var i: u64 = 0;
        while !sticky and i < li {
            if a.d[i] != 0 { sticky = true; }
            i += 1;
        }
        if sticky { top = top | 1; }
        f = (top as f64) * f64.from_bits((1023 + shift) << 52);
    }
    if a.neg { 0.0 - f } else { f }
}

/// Limbs `from_f64_into` needs for `x` (any f64).
pub fn f64_size(x: f64) -> u64 {
    let e = ((x.to_bits() >> 52) & 0x7ff) as u64;
    if e < 1075 { 1 } else { (e - 1075 + 53) / 64 + 2 }
}

/// The integer part of `x` (truncated toward zero), or None for inf
/// and nan.
pub fn from_f64_into(out: []u64, x: f64) -> ?Num {
    let bits = x.to_bits();
    let e = ((bits >> 52) & 0x7ff) as u64;
    if e == 0x7ff { return None; }
    let neg = (bits >> 63) != 0;
    need(out, f64_size(x));
    if e < 1023 { return Some(zero()); }
    let m = (bits & 0xfffffffffffff) | 0x10000000000000;
    if e <= 1075 {
        out[0] = m >> (1075 - e);
        return Some(view(out.ptr, 1, neg));
    }
    let sh = e - 1075;
    let li = sh / 64;
    let bi = sh % 64;
    let n = li + 2;
    for i in 0..n { out[i] = 0; }
    out[li] = m << bi;
    if bi != 0 { out[li + 1] = m >> (64 - bi); }
    Some(view(out.ptr, n, neg))
}

const P61: u64 = 0x1fffffffffffffff;

fn mod61(x: u64) -> u64 {
    let y = (x & P61) + (x >> 61);
    if y >= P61 { y - P61 } else { y }
}

/// Python's `hash(n)` for an int: n modulo 2^61 - 1 with n's sign, and
/// -2 for -1. Equal to `hash_i64` for numbers that fit an i64.
pub fn hash_py(a: Num) -> i64 {
    var h: u64 = 0;
    var i = a.d.len;
    while i > 0 {
        i -= 1;
        h = mod61(mod61(h << 3) + mod61(a.d[i]));
    }
    var r = h as i64;
    if a.neg { r = 0 - r; }
    if r == -1 { -2 } else { r }
}

/// Python's `hash(n)` for an int that fits an i64.
pub fn hash_i64(x: i64) -> i64 {
    var buf: [u64; 1] = [0; 1];
    hash_py(from_i64(buf[0..1], x))
}

// ── arithmetic into caller buffers ──────────────────────────────────
//
// Each `op_into(out, ..)` writes the result to the start of `out`, which
// must have at least `op_size(..)` limbs (else a panic), and returns it
// as a view of `out`. `out` must not overlap the operands.

/// Limbs for `add_into` and `sub_into`.
pub fn add_size(a: Num, b: Num) -> u64 { max(a.d.len, b.d.len) + 1 }

fn add_signed(out: []u64, an: bool, a: []u64, bn: bool, b: []u64) -> Num {
    need(out, max(a.len, b.len) + 1);
    let r = out.ptr;
    if an == bn {
        if a.len >= b.len {
            r[a.len] = add_to(r, a.ptr, a.len, b.ptr, b.len);
            return view(r, a.len + 1, an);
        }
        r[b.len] = add_to(r, b.ptr, b.len, a.ptr, a.len);
        return view(r, b.len + 1, an);
    }
    let c = mag_cmp(a.ptr, a.len, b.ptr, b.len);
    if c == 0 { return zero(); }
    if c > 0 {
        sub_to(r, a.ptr, a.len, b.ptr, b.len);
        return view(r, a.len, an);
    }
    sub_to(r, b.ptr, b.len, a.ptr, a.len);
    view(r, b.len, bn)
}

/// a + b.
pub fn add_into(out: []u64, a: Num, b: Num) -> Num { add_signed(out, a.neg, a.d, b.neg, b.d) }

/// a - b.
pub fn sub_into(out: []u64, a: Num, b: Num) -> Num { add_signed(out, a.neg, a.d, !b.neg, b.d) }

/// Limbs for `mul_into`.
pub fn mul_size(a: Num, b: Num) -> u64 { a.d.len + b.d.len }

/// a * b.
pub fn mul_into(out: []u64, a: Num, b: Num) -> Num {
    let na = a.d.len;
    let nb = b.d.len;
    if na == 0 or nb == 0 { return zero(); }
    need(out, na + nb);
    if na >= nb { mul_mag(out.ptr, a.d.ptr, na, b.d.ptr, nb); } else { mul_mag(out.ptr, b.d.ptr, nb, a.d.ptr, na); }
    view(out.ptr, na + nb, a.neg != b.neg)
}

/// Limbs for the quotient of `divmod_into`.
pub fn quot_size(a: Num, b: Num) -> u64 {
    if a.d.len >= b.d.len { a.d.len - b.d.len + 2 } else { 1 }
}

/// Limbs for the remainder of `divmod_into`.
pub fn rem_size(a: Num, b: Num) -> u64 { max(b.d.len, 1) }

/// Quotient and remainder of a / b, or None if b is zero. `floor`:
/// the quotient rounds toward negative infinity and the remainder takes
/// b's sign (Python's `//` and `%`, Scheme's `floor/`); otherwise it
/// truncates toward zero and the remainder takes a's sign (C, Scheme's
/// `truncate/`). `q` needs `quot_size(a, b)` limbs and `r`
/// `rem_size(a, b)`.
pub fn divmod_into(q: []u64, r: []u64, a: Num, b: Num, floor: bool) -> ?(Num, Num) {
    let na = a.d.len;
    let nb = b.d.len;
    if nb == 0 { return None; }
    need(q, quot_size(a, b));
    need(r, rem_size(a, b));
    var nq: u64 = 0;
    var nr: u64 = 0;
    if na < nb {
        mem.copy(r.ptr, a.d.ptr, na);
        nr = na;
    } else if nb == 1 {
        r[0] = divrem_1(q.ptr, a.d.ptr, na, b.d[0]);
        nq = norm(q.ptr, na);
        nr = norm(r.ptr, 1);
    } else {
        divrem(q.ptr, r.ptr, a.d.ptr, na, b.d.ptr, nb);
        nq = norm(q.ptr, na - nb + 1);
        nr = norm(r.ptr, nb);
    }
    let qneg = a.neg != b.neg;
    if floor and qneg and nr != 0 {
        // q - 1 (that is, |q| + 1) and r + b (that is, |b| - |r|).
        q[nq] = 0;
        var one: [u64; 1] = [1; 1];
        add_in(q.ptr, nq + 1, &one[0], 1);
        nq = norm(q.ptr, nq + 1);
        sub_to(r.ptr, b.d.ptr, nb, r.ptr, nr);
        nr = norm(r.ptr, nb);
        return Some((view(q.ptr, nq, true), view(r.ptr, nr, b.neg)));
    }
    Some((view(q.ptr, nq, qneg), view(r.ptr, nr, a.neg)))
}

/// Limbs for `shl_into(.., a, n)`.
pub fn shl_size(a: Num, n: u64) -> u64 { a.d.len + n / 64 + 1 }

/// a * 2^n.
pub fn shl_into(out: []u64, a: Num, n: u64) -> Num {
    let na = a.d.len;
    if na == 0 { return zero(); }
    need(out, shl_size(a, n));
    let li = n / 64;
    let bi = n % 64;
    for i in 0..li { out[i] = 0; }
    if bi == 0 {
        mem.copy(out.ptr + li, a.d.ptr, na);
        out[li + na] = 0;
    } else {
        out[li + na] = lshift(out.ptr + li, a.d.ptr, na, bi);
    }
    view(out.ptr, li + na + 1, a.neg)
}

/// Limbs for `shr_into(.., a, n)`.
pub fn shr_size(a: Num, n: u64) -> u64 {
    let li = n / 64;
    if li >= a.d.len { 1 } else { a.d.len - li + 1 }
}

/// floor(a / 2^n): an arithmetic shift, so -1 >> n is -1 (Python's `>>`).
pub fn shr_into(out: []u64, a: Num, n: u64) -> Num {
    let na = a.d.len;
    if na == 0 { return zero(); }
    need(out, shr_size(a, n));
    let li = n / 64;
    let bi = n % 64;
    var lost = false;
    var m: u64 = 0;
    if li >= na {
        lost = true;
    } else {
        m = na - li;
        if bi == 0 { mem.copy(out.ptr, a.d.ptr + li, m); } else { rshift(out.ptr, a.d.ptr + li, m, bi); }
        if bi != 0 and (a.d[li] << (64 - bi)) != 0 { lost = true; }
        var i: u64 = 0;
        while !lost and i < li {
            if a.d[i] != 0 { lost = true; }
            i += 1;
        }
    }
    out[m] = 0;
    if a.neg and lost {
        var one: [u64; 1] = [1; 1];
        add_in(out.ptr, m + 1, &one[0], 1);
        return view(out.ptr, m + 1, true);
    }
    view(out.ptr, m + 1, a.neg)
}

/// Limbs for `and_into`, `or_into` and `xor_into`.
pub fn bitop_size(a: Num, b: Num) -> u64 { max(a.d.len, b.d.len) + 1 }

const AND: u32 = 0;
const OR: u32 = 1;
const XOR: u32 = 2;

/// Limb i of a's infinite two's complement, given the running carry of
/// the negation (~|a| + 1).
fn twos_limb(a: Num, i: u64, carry: *u64) -> u64 {
    let x = if i < a.d.len { a.d[i] } else { 0 };
    if !a.neg { return x; }
    let t = (~x) +% *carry;
    if *carry != 0 and t != 0 { *carry = 0; }
    t
}

fn bitop(out: []u64, a: Num, b: Num, op: u32) -> Num {
    let n = max(a.d.len, b.d.len) + 1;
    need(out, n);
    var ca: u64 = 1;
    var cb: u64 = 1;
    for i in 0..n {
        let x = twos_limb(a, i, &ca);
        let y = twos_limb(b, i, &cb);
        out[i] = if op == AND { x & y } else if op == OR { x | y } else { x ^ y };
    }
    let rneg = (out[n - 1] >> 63) != 0;
    if rneg {
        // The magnitude is the two's complement of the limbs.
        var c: u64 = 1;
        for i in 0..n {
            let t = (~out[i]) +% c;
            if c != 0 and t != 0 { c = 0; }
            out[i] = t;
        }
    }
    view(out.ptr, n, rneg)
}

/// a & b, with Python's semantics for negative numbers (infinite two's
/// complement).
pub fn and_into(out: []u64, a: Num, b: Num) -> Num { bitop(out, a, b, AND) }

/// a | b (infinite two's complement).
pub fn or_into(out: []u64, a: Num, b: Num) -> Num { bitop(out, a, b, OR) }

/// a ^ b (infinite two's complement).
pub fn xor_into(out: []u64, a: Num, b: Num) -> Num { bitop(out, a, b, XOR) }

/// Limbs for `not_into`.
pub fn not_size(a: Num) -> u64 { max(a.d.len, 1) + 1 }

/// ~a, that is -a - 1.
pub fn not_into(out: []u64, a: Num) -> Num {
    var buf: [u64; 1] = [1; 1];
    let one = Num { neg: false, d: buf[0..1] };
    // -a - 1 = -(a + 1)
    let r = add_into(out, a, one);
    neg(r)
}

/// Limbs for `pow_into(.., a, e)`, or None if that does not fit a u64.
pub fn pow_size(a: Num, e: u64) -> ?u64 {
    let bits = bit_length(a);
    if bits <= 1 or e == 0 { return Some(1); }
    let Some(t) = bits.mul_checked(e) else { return None; };
    Some(t / 64 + 2)
}

/// a ** e. `out` needs `pow_size(a, e)` limbs.
pub fn pow_into(out: []u64, a: Num, e: u64) -> Num {
    let Some(n) = pow_size(a, e) else { fail("std.bigint: pow result too large\n"); return zero(); };
    need(out, n);
    let rneg = a.neg and (e & 1) != 0;
    if e == 0 or (a.d.len == 1 and a.d[0] == 1) {
        out[0] = 1;
        return view(out.ptr, 1, rneg);
    }
    if a.d.len == 0 { return zero(); }
    // Left to right binary powering between two scratch buffers.
    var x: *u64 = mem.alloc(n);
    var y: *u64 = mem.alloc(n);
    mem.copy(x, a.d.ptr, a.d.len);
    var nx = a.d.len;
    var bit = 63 - (e.clz() as u64);
    while bit > 0 {
        bit -= 1;
        mul_mag(y, x, nx, x, nx);
        nx = norm(y, 2 * nx);
        var t = x; x = y; y = t;
        if ((e >> bit) & 1) != 0 {
            if nx >= a.d.len { mul_mag(y, x, nx, a.d.ptr, a.d.len); } else { mul_mag(y, a.d.ptr, a.d.len, x, nx); }
            nx = norm(y, nx + a.d.len);
            t = x; x = y; y = t;
        }
    }
    mem.copy(out.ptr, x, nx);
    mem.release(x);
    mem.release(y);
    view(out.ptr, nx, rneg)
}

/// Limbs for `gcd_into`.
pub fn gcd_size(a: Num, b: Num) -> u64 { max(max(a.d.len, b.d.len), 1) }

/// The greatest common divisor of |a| and |b| (never negative; zero when
/// both are zero): Euclid's algorithm, on machine words once both
/// numbers fit one limb.
pub fn gcd_into(out: []u64, a: Num, b: Num) -> Num {
    let n = max(a.d.len, b.d.len);
    need(out, max(n, 1));
    if a.d.len == 0 or b.d.len == 0 {
        let c = if a.d.len == 0 { b } else { a };
        mem.copy(out.ptr, c.d.ptr, c.d.len);
        return view(out.ptr, c.d.len, false);
    }
    // Rotating buffers: x mod y goes to z, then (x, y, z) = (y, z, x).
    let m = n + 2;
    var x: *u64 = mem.alloc(m);
    var y: *u64 = mem.alloc(m);
    var z: *u64 = mem.alloc(m);
    let q: *u64 = mem.alloc(m);
    mem.copy(x, a.d.ptr, a.d.len);
    mem.copy(y, b.d.ptr, b.d.len);
    var nx = a.d.len;
    var ny = b.d.len;
    while ny != 0 {
        if nx == 1 and ny == 1 {
            var u = x[0];
            var v = y[0];
            while v != 0 {
                let t = u % v;
                u = v;
                v = t;
            }
            x[0] = u;
            break;
        }
        let (_, r) = divmod_into(q.slice(m), z.slice(m), view(x, nx, false), view(y, ny, false), false).unwrap();
        let nr = r.d.len;
        let t = x;
        x = y;
        nx = ny;
        y = z;
        ny = nr;
        z = t;
    }
    mem.copy(out.ptr, x, nx);
    mem.release(x);
    mem.release(y);
    mem.release(z);
    mem.release(q);
    view(out.ptr, nx, false)
}

/// Limbs for `isqrt_into`.
pub fn isqrt_size(a: Num) -> u64 { a.d.len / 2 + 1 }

/// Whether r * r > n.
fn square_above(r: u64, n: u64) -> bool {
    let (lo, hi) = r.mul_wide(r);
    hi != 0 or lo > n
}

/// floor(sqrt(a)), or None if a is negative: Zimmermann's Karatsuba
/// square root (`sqrtrem`) above one limb.
pub fn isqrt_into(out: []u64, a: Num) -> ?Num {
    if a.neg { return None; }
    need(out, isqrt_size(a));
    if a.d.len == 0 { return Some(zero()); }
    if a.d.len == 1 {
        let n = a.d[0];
        // Within one of the root (the conversion may round n up).
        var r = (n as f64).sqrt() as u64;
        while square_above(r, n) { r -= 1; }
        while !square_above(r + 1, n) { r += 1; }
        out[0] = r;
        return Some(view(out.ptr, 1, false));
    }
    // Scale a by 4^t so that it has an even number of limbs and its top
    // limb is at least 2^62; then floor(sqrt(a)) = sqrtrem(a 4^t) >> t.
    let n = a.d.len;
    let m = (n + 1) / 2;
    let pad = 2 * m - n;
    let sh = (a.d[n - 1].clz() as u64) & 62;
    let w: *u64 = mem.alloc(2 * m + 2 * m + 1);
    let x = w;
    let s = w + 2 * m;
    let r = w + 3 * m;
    if sh > 0 { lshift(x + pad, a.d.ptr, n, sh); } else { mem.copy(x + pad, a.d.ptr, n); }
    sqrtrem(s, r, x, m);
    let t = sh / 2 + 32 * pad;
    if t > 0 { rshift(out.ptr, s, m, t); } else { mem.copy(out.ptr, s, m); }
    mem.release(w);
    Some(view(out.ptr, m, false))
}

/// The square root and remainder of a two-limb number (a1 >= 2^62):
/// (s, r0, r1) with s = floor(sqrt(a)) and r1 r0 = a - s^2 (at most 2s).
fn sqrtrem_2(a1: u64, a0: u64) -> (u64, u64, u64) {
    let f = ((a1 as f64) * 18446744073709551616.0 + (a0 as f64)).sqrt();
    var s: u64 = if f >= 18446744073709551615.0 { 0xffffffffffffffff } else { f as u64 };
    // One Newton step from within 2^-50 of the root, then at most a few
    // corrections. The step needs a1 < s for the 128 by 64 division.
    if a1 < s {
        let (q, _) = a1.div_wide(a0, s);
        s = (s >> 1) + (q >> 1) + (s & q & 1);
    } else {
        s = 0xffffffffffffffff;
    }
    loop {
        let (lo, hi) = s.mul_wide(s);
        if hi > a1 or (hi == a1 and lo > a0) { s -= 1; } else { break; }
    }
    while s != 0xffffffffffffffff {
        let (lo, hi) = (s + 1).mul_wide(s + 1);
        if hi < a1 or (hi == a1 and lo <= a0) { s += 1; } else { break; }
    }
    let (lo, hi) = s.mul_wide(s);
    let r0 = a0 -% lo;
    let r1 = a1 -% hi -% (if a0 < lo { 1 } else { 0 });
    (s, r0, r1)
}

/// Zimmermann's Karatsuba square root (the structure of GMP's
/// mpn_dc_sqrtrem): for a[0..2m] with a[2m - 1] >= 2^62, s[0..m] =
/// floor(sqrt(a)) and r[0..m + 1] = a - s^2. With a = ah B^2l + a1 B^l +
/// a0 (B = 2^64, l = m / 2): (s', r') = sqrtrem(ah), (q, u) = (r' B^l +
/// a1) divmod 2 s', s = s' B^l + q, r = u B^l + a0 - q^2, and if r < 0
/// one correction r += 2s - 1, s -= 1. Returns r's length.
fn sqrtrem(s: *u64, r: *u64, a: *u64, m: u64) -> u64 {
    if m == 1 {
        let (s0, r0, r1) = sqrtrem_2(a[1], a[0]);
        s[0] = s0;
        r[0] = r0;
        r[1] = r1;
        return norm(r, 2);
    }
    let l = m / 2;
    let h = m - l;
    let sh = s + l;
    // Scratch: r' (h + 1), N (m + 2), q (m + 2), u (h + 3), R (m + 3), q^2 (2 l).
    let t: *u64 = mem.alloc(5 * m + 2 * h + 11);
    let rp = t;
    let nb = rp + h + 1;
    let qb = nb + m + 2;
    let ub = qb + m + 2;
    let rb = ub + h + 3;
    let q2 = rb + m + 3;
    let rn = sqrtrem(sh, rp, a + 2 * l, h);
    // N = (r' B^l + a1) / 2, and its low bit.
    mem.copy(nb, a + l, l);
    mem.copy(nb + l, rp, rn);
    let low = nb[0] & 1;
    rshift(nb, nb, m + 1, 1);
    let nn = norm(nb, m + 1);
    // (q, u) = N divmod s', then u = 2u + low: (r' B^l + a1) divmod 2 s'.
    if nn < h {
        mem.copy(ub, nb, nn);
    } else if h == 1 {
        ub[0] = divrem_1(qb, nb, nn, sh[0]);
    } else {
        divrem(qb, ub, nb, nn, sh, h);
    }
    ub[h] = lshift(ub, ub, h, 1);
    ub[0] = ub[0] | low;
    if qb[l] != 0 {
        // q = B^l: use B^l - 1 and u + 2 s' instead.
        for i in 0..l { qb[i] = 0xffffffffffffffff; }
        qb[l] = 0;
        add_in(ub, h + 3, sh, h);
        add_in(ub, h + 3, sh, h);
    }
    mem.copy(s, qb, l);
    // R = u B^l + a0 - q^2
    mem.copy(rb, a, l);
    mem.copy(rb + l, ub, h + 2);
    var nr = norm(rb, m + 2);
    let ql = norm(qb, l);
    var n2: u64 = 0;
    if ql > 0 {
        sqr_mag(q2, qb, ql);
        n2 = norm(q2, 2 * ql);
    }
    if mag_cmp(rb, nr, q2, n2) >= 0 {
        sub_in(rb, nr, q2, n2);
        nr = norm(rb, nr);
        mem.copy(r, rb, nr);
    } else {
        // r = 2s - 1 - (q^2 - R), s -= 1
        sub_to(q2, q2, n2, rb, nr);
        let nd = norm(q2, n2);
        r[m] = lshift(r, s, m, 1);
        decr(r, m + 1);
        sub_in(r, m + 1, q2, nd);
        decr(s, m);
        nr = norm(r, m + 1);
    }
    mem.release(t);
    nr
}

// ── text ────────────────────────────────────────────────────────────

const DIGITS: str = "0123456789abcdefghijklmnopqrstuvwxyz";

/// The largest power of `radix` that fits a u64, and its exponent.
fn chunk_base(radix: u32) -> (u64, u64) {
    let r = radix as u64;
    var b = r;
    var k: u64 = 1;
    loop {
        let Some(nb) = b.mul_checked(r) else { break; };
        b = nb;
        k += 1;
    }
    (b, k)
}

fn is_pow2(radix: u32) -> bool { (radix & (radix - 1)) == 0 }

/// Write |x| (x[0..n], normalized, nonzero or n == 0) in a radix that is
/// not a power of two, at least `pad` digits (zeros in front).
fn write_base(b: *text.StrBuf, x: *u64, n: u64, radix: u32, base: u64, k: u64, pad: u64) {
    let t: *u64 = mem.alloc(n + 1);
    mem.copy(t, x, n);
    var m = n;
    var chunks: mem.Vec<u64> = mem.Vec.new();
    while m > 0 {
        chunks.push(divrem_1(t, t, m, base));
        m = norm(t, m);
    }
    mem.release(t);
    var buf: [u8; 64] = [0; 64];
    var i = chunks.len;
    var first = true;
    while i > 0 {
        i -= 1;
        // The chunk's digits, right to left (radix 10 divides by a
        // constant, which compiles to a multiplication).
        var c = chunks.at(i);
        var j: u64 = 64;
        if radix == 10 {
            while c != 0 { j -= 1; buf[j] = DIGITS[c % 10]; c = c / 10; }
        } else {
            let r = radix as u64;
            while c != 0 { j -= 1; buf[j] = DIGITS[c % r]; c = c / r; }
        }
        if first {
            var z = (64 - j) + i * k;
            while z < pad { b.push('0'); z += 1; }
            first = false;
        } else {
            while 64 - j < k { j -= 1; buf[j] = '0'; }
        }
        b.push_str(buf[j..64]);
    }
    if first {
        var z: u64 = 0;
        while z < pad { b.push('0'); z += 1; }
    }
    chunks.free();
}

/// Divide and conquer: x < pows[level + 1]; pows[i] = base^(2^i).
fn write_dc(b: *text.StrBuf, x: *u64, n: u64, pows: *mem.Vec<BigInt>, level: u64, pad: u64, radix: u32, base: u64, k: u64) {
    if n <= DC_LIMBS or level == 0 {
        write_base(b, x, n, radix, base, k, pad);
        return;
    }
    let p = pows.ptr_at(level).num();
    if n < p.d.len {
        write_dc(b, x, n, pows, level - 1, pad, radix, base, k);
        return;
    }
    let (q, nq, r, nr) = divmod_alloc(x.slice(n), p.d);
    let low = k << level;
    if pad > 0 or nq > 0 {
        write_dc(b, q, nq, pows, level - 1, if pad > low { pad - low } else { 0 }, radix, base, k);
        write_dc(b, r, nr, pows, level - 1, low, radix, base, k);
    } else {
        write_dc(b, r, nr, pows, level - 1, 0, radix, base, k);
    }
    mem.release(q);
    mem.release(r);
}

/// Append a in `radix` (2 to 36; lowercase letters, a leading `-` when
/// negative, no prefix).
pub fn write(b: *text.StrBuf, a: Num, radix: u32) {
    if radix < 2 or radix > 36 { fail("std.bigint.write: radix must be 2 to 36\n"); }
    let n = a.d.len;
    if n == 0 { b.push('0'); return; }
    if a.neg { b.push('-'); }
    if is_pow2(radix) {
        let s = radix.ctz() as u64;
        let bits = bit_length(a);
        var i = (bits + s - 1) / s;
        while i > 0 {
            i -= 1;
            let at = i * s;
            let li = at / 64;
            let bi = at % 64;
            var v = a.d[li] >> bi;
            if bi + s > 64 and li + 1 < n { v = v | (a.d[li + 1] << (64 - bi)); }
            b.push(DIGITS[v & ((1 << s) - 1)]);
        }
        return;
    }
    let (base, k) = chunk_base(radix);
    if n <= DC_LIMBS {
        write_base(b, a.d.ptr, n, radix, base, k, 0);
        return;
    }
    // pows[i] = base^(2^i), up to the first whose square exceeds a.
    var pows: mem.Vec<BigInt> = mem.Vec.new();
    var b0: [u64; 1] = [base; 1];
    pows.push(copy(Num { neg: false, d: b0[0..1] }));
    while 2 * pows.ptr_at(pows.len - 1).d.len - 1 <= n {
        let top = pows.ptr_at(pows.len - 1).num();
        pows.push(mul(top, top));
    }
    write_dc(b, a.d.ptr, n, &pows, pows.len - 1, 0, radix, base, k);
    for i in 0..pows.len { pows.ptr_at(i).free(); }
    pows.free();
}

/// Append a in decimal.
pub fn write_dec(b: *text.StrBuf, a: Num) { write(b, a, 10); }

fn digit(c: u8) -> u32 {
    if c >= '0' and c <= '9' { return (c - '0') as u32; }
    if c >= 'a' and c <= 'z' { return (c - 'a') as u32 + 10; }
    if c >= 'A' and c <= 'Z' { return (c - 'A') as u32 + 10; }
    99
}

/// Limbs for `parse_into` of `ndigits` digits in `radix`.
pub fn parse_size(ndigits: u64, radix: u32) -> u64 {
    var bits: u64 = 1;
    while ((1 as u64) << bits) < (radix as u64) { bits += 1; }
    ndigits * bits / 64 + 2
}

/// The number written with the digits `s` in `radix` (2 to 36; letters
/// in either case), or None if `s` is empty or has another character.
/// No sign, prefix, spaces or underscores: the caller handles its
/// language's syntax. `out` needs `parse_size(s.len, radix)` limbs.
pub fn parse_into(out: []u64, s: str, radix: u32) -> ?Num {
    if radix < 2 or radix > 36 { fail("std.bigint.parse: radix must be 2 to 36\n"); }
    if s.len == 0 { return None; }
    for i in 0..s.len {
        if digit(s[i]) >= radix { return None; }
    }
    let size = parse_size(s.len, radix);
    need(out, size);
    let r = out.ptr;
    for i in 0..size { r[i] = 0; }
    if is_pow2(radix) {
        let w = radix.ctz() as u64;
        var at: u64 = 0;
        var i = s.len;
        while i > 0 {
            i -= 1;
            let v = digit(s[i]) as u64;
            let li = at / 64;
            let bi = at % 64;
            r[li] = r[li] | (v << bi);
            if bi + w > 64 { r[li + 1] = r[li + 1] | (v >> (64 - bi)); }
            at += w;
        }
        return Some(view(r, size, false));
    }
    let (base, k) = chunk_base(radix);
    if s.len <= PARSE_DC * k {
        return Some(view(r, parse_base(r, s, radix, base, k), false));
    }
    // pows[i] = base^(2^i), for i up to the split of s.
    var pows: mem.Vec<BigInt> = mem.Vec.new();
    var b0: [u64; 1] = [base; 1];
    pows.push(copy(Num { neg: false, d: b0[0..1] }));
    while (k << pows.len) < s.len {
        let top = pows.ptr_at(pows.len - 1).num();
        pows.push(mul(top, top));
    }
    let n = parse_dc(r, s, &pows, radix, base, k);
    for i in 0..pows.len { pows.ptr_at(i).free(); }
    pows.free();
    Some(view(r, n, false))
}

/// r = the digits s (valid, not a power-of-two radix), one limb-sized
/// chunk at a time; r has parse_size(s.len) zeroed limbs. Returns the
/// length.
fn parse_base(r: *u64, s: str, radix: u32, base: u64, k: u64) -> u64 {
    var n: u64 = 0;
    var i: u64 = 0;
    let first = s.len % k;
    var len = if first == 0 { k } else { first };
    while i < s.len {
        var v: u64 = 0;
        var m: u64 = 1;
        for j in 0..len {
            v = v * (radix as u64) + (digit(s[i + j]) as u64);
            m *= radix as u64;
        }
        let mult = if len == k { base } else { m };
        let c = mul_1(r, r, n, mult);
        r[n] = c;
        n += 1;
        var cell: [u64; 1] = [v; 1];
        add_in(r, n, &cell[0], 1);
        n = norm(r, n);
        i += len;
        len = k;
    }
    n
}

/// Divide and conquer: the high digits times base^(2^i), plus the low
/// k 2^i digits, for the largest such split; pows[i] = base^(2^i).
fn parse_dc(r: *u64, s: str, pows: *mem.Vec<BigInt>, radix: u32, base: u64, k: u64) -> u64 {
    if s.len <= PARSE_DC * k {
        return parse_base(r, s, radix, base, k);
    }
    var i: u64 = 0;
    while (k << (i + 1)) < s.len { i += 1; }
    let split = s.len - (k << i);
    let hs = s[0..split];
    let ls = s[split..s.len];
    let th: *u64 = mem.alloc(parse_size(hs.len, radix));
    let tl: *u64 = mem.alloc(parse_size(ls.len, radix));
    let nh = parse_dc(th, hs, pows, radix, base, k);
    let nl = parse_dc(tl, ls, pows, radix, base, k);
    let p = pows.ptr_at(i).num();
    let np = p.d.len;
    let t: *u64 = mem.alloc(nh + np + nl + 1);
    if nh > 0 {
        if nh >= np { mul_mag(t, th, nh, p.d.ptr, np); } else { mul_mag(t, p.d.ptr, np, th, nh); }
    }
    let nt = max(nh + np, nl) + 1;
    add_in(t, nt, tl, nl);
    let n = norm(t, nt);
    mem.copy(r, t, n);
    mem.release(t);
    mem.release(th);
    mem.release(tl);
    n
}

// ── owned integers ──────────────────────────────────────────────────

/// An integer that owns its limbs (C heap). Copying the struct shares
/// them; `free` releases them.
pub struct BigInt { neg: bool, d: mem.Vec<u64> }

/// The view of x (valid until x changes or is freed).
pub fn BigInt.num(x: *BigInt) -> Num { Num { neg: x.neg, d: x.d.items() } }

pub fn BigInt.free(x: *BigInt) {
    x.d.free();
    x.neg = false;
}

/// Room for n limbs.
fn room(n: u64) -> mem.Vec<u64> { mem.Vec.with_capacity(if n == 0 { 1 } else { n }) }

fn space(v: *mem.Vec<u64>) -> []u64 { v.ptr.slice(v.cap) }

fn own(v: mem.Vec<u64>, r: Num) -> BigInt {
    var w = v;
    w.len = r.d.len;
    BigInt { neg: r.neg, d: w }
}

/// A copy of a.
pub fn copy(a: Num) -> BigInt {
    var v = room(a.d.len);
    mem.copy(v.ptr, a.d.ptr, a.d.len);
    v.len = a.d.len;
    BigInt { neg: a.neg, d: v }
}

pub fn of_i64(x: i64) -> BigInt {
    var v = room(1);
    own(v, from_i64(space(&v), x))
}

pub fn of_u64(x: u64) -> BigInt {
    var v = room(1);
    own(v, from_u64(space(&v), x))
}

/// The integer part of x, or None for inf and nan.
pub fn of_f64(x: f64) -> ?BigInt {
    var v = room(f64_size(x));
    let Some(r) = from_f64_into(space(&v), x) else { v.free(); return None; };
    Some(own(v, r))
}

/// Parse digits (see `parse_into`).
pub fn parse(s: str, radix: u32) -> ?BigInt {
    var v = room(parse_size(s.len, radix));
    let Some(r) = parse_into(space(&v), s, radix) else { v.free(); return None; };
    Some(own(v, r))
}

pub fn add(a: Num, b: Num) -> BigInt { var v = room(add_size(a, b)); own(v, add_into(space(&v), a, b)) }
pub fn sub(a: Num, b: Num) -> BigInt { var v = room(add_size(a, b)); own(v, sub_into(space(&v), a, b)) }
pub fn mul(a: Num, b: Num) -> BigInt { var v = room(mul_size(a, b)); own(v, mul_into(space(&v), a, b)) }
pub fn shl(a: Num, n: u64) -> BigInt { var v = room(shl_size(a, n)); own(v, shl_into(space(&v), a, n)) }
pub fn shr(a: Num, n: u64) -> BigInt { var v = room(shr_size(a, n)); own(v, shr_into(space(&v), a, n)) }
pub fn bit_and(a: Num, b: Num) -> BigInt { var v = room(bitop_size(a, b)); own(v, and_into(space(&v), a, b)) }
pub fn bit_or(a: Num, b: Num) -> BigInt { var v = room(bitop_size(a, b)); own(v, or_into(space(&v), a, b)) }
pub fn bit_xor(a: Num, b: Num) -> BigInt { var v = room(bitop_size(a, b)); own(v, xor_into(space(&v), a, b)) }
pub fn bit_not(a: Num) -> BigInt { var v = room(not_size(a)); own(v, not_into(space(&v), a)) }

/// a ** e (panics if the size does not fit a u64).
pub fn pow(a: Num, e: u64) -> BigInt {
    let Some(n) = pow_size(a, e) else { fail("std.bigint: pow result too large\n"); return copy(zero()); };
    var v = room(n);
    own(v, pow_into(space(&v), a, e))
}

/// (quotient, remainder), or None if b is zero; see `divmod_into`.
pub fn divmod(a: Num, b: Num, floor: bool) -> ?(BigInt, BigInt) {
    if b.d.len == 0 { return None; }
    var q = room(quot_size(a, b));
    var r = room(rem_size(a, b));
    let (x, y) = divmod_into(space(&q), space(&r), a, b, floor).unwrap();
    Some((own(q, x), own(r, y)))
}

/// gcd(|a|, |b|); see `gcd_into`.
pub fn gcd(a: Num, b: Num) -> BigInt { var v = room(gcd_size(a, b)); own(v, gcd_into(space(&v), a, b)) }

/// floor(sqrt(a)), or None if a is negative.
pub fn isqrt(a: Num) -> ?BigInt {
    if a.neg { return None; }
    var v = room(isqrt_size(a));
    Some(own(v, isqrt_into(space(&v), a).unwrap()))
}

/// a in `radix`, appended to `b` (see `write`).
pub fn BigInt.write(x: *BigInt, b: *text.StrBuf, radix: u32) { write(b, x.num(), radix); }

// ── integers in the GC heap ─────────────────────────────────────────

/// An integer in the GC heap: `len` limbs of `d` (which may be longer:
/// results are allocated at their size bound) and a sign.
pub object Big { neg: bool, len: u64, d: [u64] }

/// The view of b. It points into the object: keep b reachable while
/// using it.
pub fn Big.num(b: Gc<Big>) -> Num { Num { neg: b.neg, d: b.d[0..b.len] } }

/// An operand of the GC functions: a small integer (the interpreter's
/// unboxed case) or a `Gc<Big>`, so that callers need no temporary
/// object for a small operand.
pub enum Arg { Small(i64), Ref(Gc<Big>) }

/// The view of a; `buf` holds the limb of a small one.
pub fn Arg.num(a: Arg, buf: *u64) -> Num {
    match a {
        Small(x) => from_i64(buf.slice(1), x),
        Ref(b) => b.num(),
    }
}

/// A new `Big` with room for n limbs, zero.
pub fn new_big(h: *gc.Heap, n: u64) -> Gc<Big> {
    new(h, Big { neg: false, len: 0 }, n)
}

/// A copy of a in the GC heap.
pub fn gc_copy(h: *gc.Heap, a: Num) -> Gc<Big> {
    let o = new_big(h, a.d.len);
    mem.copy(o.d.ptr, a.d.ptr, a.d.len);
    o.len = a.d.len;
    o.neg = a.neg;
    o
}

fn set(o: Gc<Big>, r: Num) -> Gc<Big> {
    o.neg = r.neg;
    o.len = r.d.len;
    o
}

fn gc_bin(h: *gc.Heap, a: Arg, b: Arg, size: fn(Num, Num) -> u64, op: fn([]u64, Num, Num) -> Num) -> Gc<Big> {
    var x: u64 = 0;
    var y: u64 = 0;
    let o = new_big(h, size(a.num(&x), b.num(&y)));
    set(o, op(o.d, a.num(&x), b.num(&y)))
}

pub fn gc_add(h: *gc.Heap, a: Arg, b: Arg) -> Gc<Big> { gc_bin(h, a, b, add_size, add_into) }
pub fn gc_sub(h: *gc.Heap, a: Arg, b: Arg) -> Gc<Big> { gc_bin(h, a, b, add_size, sub_into) }
pub fn gc_mul(h: *gc.Heap, a: Arg, b: Arg) -> Gc<Big> { gc_bin(h, a, b, mul_size, mul_into) }
pub fn gc_and(h: *gc.Heap, a: Arg, b: Arg) -> Gc<Big> { gc_bin(h, a, b, bitop_size, and_into) }
pub fn gc_or(h: *gc.Heap, a: Arg, b: Arg) -> Gc<Big> { gc_bin(h, a, b, bitop_size, or_into) }
pub fn gc_xor(h: *gc.Heap, a: Arg, b: Arg) -> Gc<Big> { gc_bin(h, a, b, bitop_size, xor_into) }

pub fn gc_not(h: *gc.Heap, a: Arg) -> Gc<Big> {
    var x: u64 = 0;
    let o = new_big(h, not_size(a.num(&x)));
    set(o, not_into(o.d, a.num(&x)))
}

pub fn gc_neg(h: *gc.Heap, a: Arg) -> Gc<Big> {
    var x: u64 = 0;
    let n = a.num(&x).d.len;
    let o = new_big(h, n);
    let v = a.num(&x);
    mem.copy(o.d.ptr, v.d.ptr, n);
    set(o, neg(Num { neg: v.neg, d: o.d[0..n] }))
}

pub fn gc_shl(h: *gc.Heap, a: Arg, n: u64) -> Gc<Big> {
    var x: u64 = 0;
    let o = new_big(h, shl_size(a.num(&x), n));
    set(o, shl_into(o.d, a.num(&x), n))
}

pub fn gc_shr(h: *gc.Heap, a: Arg, n: u64) -> Gc<Big> {
    var x: u64 = 0;
    let o = new_big(h, shr_size(a.num(&x), n));
    set(o, shr_into(o.d, a.num(&x), n))
}

/// a ** e (panics if the size does not fit a u64).
pub fn gc_pow(h: *gc.Heap, a: Arg, e: u64) -> Gc<Big> {
    var x: u64 = 0;
    let Some(n) = pow_size(a.num(&x), e) else { fail("std.bigint: pow result too large\n"); return new_big(h, 0); };
    let o = new_big(h, n);
    set(o, pow_into(o.d, a.num(&x), e))
}

/// (quotient, remainder) or None if b is zero; see `divmod_into`.
pub fn gc_divmod(h: *gc.Heap, a: Arg, b: Arg, floor: bool) -> ?(Gc<Big>, Gc<Big>) {
    var x: u64 = 0;
    var y: u64 = 0;
    if b.num(&y).d.len == 0 { return None; }
    let q = new_big(h, quot_size(a.num(&x), b.num(&y)));
    let r = new_big(h, rem_size(a.num(&x), b.num(&y)));
    let (qv, rv) = divmod_into(q.d, r.d, a.num(&x), b.num(&y), floor).unwrap();
    Some((set(q, qv), set(r, rv)))
}

/// gcd(|a|, |b|); see `gcd_into`.
pub fn gc_gcd(h: *gc.Heap, a: Arg, b: Arg) -> Gc<Big> { gc_bin(h, a, b, gcd_size, gcd_into) }

/// floor(sqrt(a)), or None if a is negative.
pub fn gc_isqrt(h: *gc.Heap, a: Arg) -> ?Gc<Big> {
    var x: u64 = 0;
    if a.num(&x).neg { return None; }
    let o = new_big(h, isqrt_size(a.num(&x)));
    Some(set(o, isqrt_into(o.d, a.num(&x)).unwrap()))
}

/// The integer part of x, or None for inf and nan.
pub fn gc_from_f64(h: *gc.Heap, x: f64) -> ?Gc<Big> {
    let o = new_big(h, f64_size(x));
    let Some(r) = from_f64_into(o.d, x) else { return None; };
    Some(set(o, r))
}

/// Parse digits (see `parse_into`).
pub fn gc_parse(h: *gc.Heap, s: str, radix: u32) -> ?Gc<Big> {
    let o = new_big(h, parse_size(s.len, radix));
    let Some(r) = parse_into(o.d, s, radix) else { return None; };
    Some(set(o, r))
}

pub fn gc_of_i64(h: *gc.Heap, x: i64) -> Gc<Big> {
    let o = new_big(h, 1);
    set(o, from_i64(o.d, x))
}
