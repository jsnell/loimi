// Memory: allocation, growable vectors, arenas.

extern "C" fn malloc(n: u64) -> *u8;
extern "C" fn calloc(n: u64, size: u64) -> *u8;
extern "C" fn realloc(p: *u8, n: u64) -> *u8;
extern "C" fn free(p: *u8);
extern "C" fn memcpy(dst: *u8, src: *u8, n: u64) -> *u8;
extern "C" fn memmove(dst: *u8, src: *u8, n: u64) -> *u8;
extern "C" fn memset(dst: *u8, c: i32, n: u64) -> *u8;
extern "C" fn memcmp(a: *u8, b: *u8, n: u64) -> i32;
extern "C" fn memchr(p: *u8, c: i32, n: u64) -> ?*u8;
extern "C" fn memrchr(p: *u8, c: i32, n: u64) -> ?*u8;
extern "C" fn memmem(h: *u8, hn: u64, n: *u8, nn: u64) -> ?*u8;

// Stale-pointer detection in ASan builds (`--sanitize=address` sets
// `#[cfg(sanitize_address)]`; docs/design/safety.md section 7). ASan
// already reports a use of memory that was freed, and so of a buffer a
// `Vec` or map grew out of (its `realloc` always moves). What it cannot
// see is memory a container keeps but no longer uses: a `Vec`'s spare
// capacity after `pop`, `truncate` or `clear`, the unused tail of an
// arena chunk. std poisons that memory, so a pointer or slice still
// pointing there is reported ("use-after-poison") instead of reading a
// stale value or aliasing a later push. Other builds drop all of it at
// parse time: their IR does not change.
#[cfg(sanitize_address)]
extern "C" fn __asan_poison_memory_region(p: *u8, n: u64);
#[cfg(sanitize_address)]
extern "C" fn __asan_unpoison_memory_region(p: *u8, n: u64);

/// ASan builds: make the `n` values at `p` unaddressable until
/// `unpoison`ed (code that hands out memory it keeps, like `Vec`).
#[cfg(sanitize_address)]
#[raw]
pub fn poison<T>(p: *T, n: u64) {
    if n != 0 and size_of<T>() != 0 { __asan_poison_memory_region(p as *u8, n * size_of<T>()); }
}

/// ASan builds: make the `n` values at `p` addressable again.
#[cfg(sanitize_address)]
#[raw]
pub fn unpoison<T>(p: *T, n: u64) {
    if n != 0 and size_of<T>() != 0 { __asan_unpoison_memory_region(p as *u8, n * size_of<T>()); }
}

/// What the pointer of an empty `Vec` (capacity 0) points to: never read,
/// written or freed. `release` and `grow` know it, so code that takes
/// ownership of `v.ptr` (`mem.release(v.items().ptr)`) works for an
/// empty `Vec` too.
var EMPTY: [u64; 2] = [0; 2];

fn empty_ptr<T>() -> *T { (&EMPTY[0]) as *T }

/// Allocate `n` zeroed values of type T.
#[raw]
pub fn alloc<T>(n: u64) -> *T {
    let p = calloc(if n == 0 { 1 } else { n }, size_of<T>());
    if (p as u64) == 0 { panic_oom(); }
    p as *T
}

/// Allocate `n` zeroed values of type T, or None when out of memory
/// (or when `n` values do not fit in the address space).
#[raw]
pub fn try_alloc<T>(n: u64) -> ?*T {
    let p = calloc(if n == 0 { 1 } else { n }, size_of<T>());
    if (p as u64) == 0 { return None; }
    Some(p as *T)
}

/// Resize an allocation made with `alloc` (or the pointer of an empty
/// `Vec`).
#[raw]
pub fn grow<T>(p: *T, n: u64) -> *T {
    if p == empty_ptr<T>() { return alloc(n); }
    let q = realloc(p as *u8, n * size_of<T>());
    if (q as u64) == 0 { panic_oom(); }
    q as *T
}

/// Free an allocation made with `alloc` or `grow`. The pointer of an
/// empty `Vec` is ignored.
#[raw]
pub fn release<T>(p: *T) {
    if p != empty_ptr<T>() { free(p as *u8); }
}

#[raw]
pub fn copy<T>(dst: *T, src: *T, n: u64) {
    memmove(dst as *u8, src as *u8, n * size_of<T>());
}

extern "C" fn loimi_panic(msg: *u8, len: u64);

/// Out of memory is a panic: it aborts, unless a `rt.catch_panic` or a
/// `#[catch_panic]` export catches it.
fn panic_oom() {
    let m = "out of memory\n";
    loimi_panic(m.ptr, m.len);
}

/// A growable array. An empty one (`Vec.new()`, or after `free()`)
/// allocates nothing: its capacity is 0 and its pointer a static
/// sentinel, so creating, overwriting and dropping one costs nothing.
pub struct Vec<T> { ptr: *T, len: u64, cap: u64 }

/// An empty `Vec`; it allocates on the first push.
pub fn Vec<T>.new() -> Vec<T> { Vec { ptr: empty_ptr(), len: 0, cap: 0 } }

pub fn Vec<T>.with_capacity(n: u64) -> Vec<T> {
    if n == 0 { return Vec.new(); }
    #[cfg(sanitize_address)]
    {
        let v: Vec<T> = Vec { ptr: alloc(n), len: 0, cap: n };
        poison(v.ptr, n);
        return v;
    }
    Vec { ptr: alloc(n), len: 0, cap: n }
}

pub fn Vec<T>.reserve(v: *Vec<T>, extra: u64) {
    if v.len + extra <= v.cap { return; }
    var c = v.cap * 2;
    if c < v.len + extra { c = v.len + extra; }
    v.ptr = grow(v.ptr, c);
    v.cap = c;
    #[cfg(sanitize_address)]
    poison(v.ptr + v.len, c - v.len);
}

pub fn Vec<T>.push(v: *Vec<T>, x: T) {
    if v.len == v.cap { v.grow_one(); }
    #[cfg(sanitize_address)]
    unpoison(v.ptr + v.len, 1);
    v.ptr[v.len] = x;
    v.len += 1;
}

#[cold]
#[inline(never)]
fn Vec<T>.grow_one(v: *Vec<T>) {
    v.cap = if v.cap == 0 { 4 } else { v.cap * 2 };
    v.ptr = grow(v.ptr, v.cap);
    #[cfg(sanitize_address)]
    poison(v.ptr + v.len, v.cap - v.len);
}

pub fn Vec<T>.pop(v: *Vec<T>) -> ?T {
    if v.len == 0 { return None; }
    v.len -= 1;
    #[cfg(sanitize_address)]
    {
        let x = v.ptr[v.len];
        poison(v.ptr + v.len, 1);
        return Some(x);
    }
    Some(v.ptr[v.len])
}

pub fn Vec<T>.get(v: *Vec<T>, i: u64) -> ?T {
    if i < v.len { Some(v.ptr[i]) } else { None }
}

/// Element `i`, bounds-checked.
pub fn Vec<T>.at(v: *Vec<T>, i: u64) -> T {
    v.items()[i]
}

/// Pointer to element `i`, bounds-checked.
pub fn Vec<T>.ptr_at(v: *Vec<T>, i: u64) -> *T {
    if i >= v.len { v.items()[i]; }
    v.ptr + i
}

pub fn Vec<T>.set(v: *Vec<T>, i: u64, x: T) {
    v.items()[i] = x;
}

/// Append the values of `s`. `s` may be (part of) `v`'s own items
/// (`v.extend(v.items())`): it is read after the buffer moves.
pub fn Vec<T>.extend(v: *Vec<T>, s: []T) {
    var src = s.ptr;
    if v.len + s.len > v.cap { src = v.grow_for(s); }
    #[cfg(sanitize_address)]
    unpoison(v.ptr + v.len, s.len);
    memcpy((v.ptr + v.len) as *u8, src as *u8, s.len * size_of<T>());
    v.len += s.len;
}

/// Make room for `s` (see `extend`), and return where `s` is now: if it
/// was inside the buffer that moved, at the same index in the new one.
#[cold]
#[inline(never)]
fn Vec<T>.grow_for(v: *Vec<T>, s: []T) -> *T {
    let base = v.ptr as u64;
    let at = s.ptr as u64;
    let inside = size_of<T>() != 0 and at >= base and at < base + v.len * size_of<T>();
    v.reserve(s.len);
    if inside { v.ptr + ((at - base) / size_of<T>()) } else { s.ptr }
}

/// A `Vec` of `n` copies of `x`.
pub fn Vec<T>.filled(n: u64, x: T) -> Vec<T> {
    var v: Vec<T> = Vec.with_capacity(n);
    #[cfg(sanitize_address)]
    unpoison(v.ptr, n);
    for i in 0..n { v.ptr[i] = x; }
    v.len = n;
    v
}

pub fn Vec<T>.last(v: *Vec<T>) -> ?T {
    if v.len == 0 { None } else { Some(v.ptr[v.len - 1]) }
}

pub fn Vec<T>.items(v: *Vec<T>) -> []T { v.ptr.slice(v.len) }

pub fn Vec<T>.truncate(v: *Vec<T>, n: u64) {
    if n < v.len {
        #[cfg(sanitize_address)]
        poison(v.ptr + n, v.len - n);
        v.len = n;
    }
}

pub fn Vec<T>.clear(v: *Vec<T>) {
    #[cfg(sanitize_address)]
    poison(v.ptr, v.len);
    v.len = 0;
}

/// Free the elements' memory. The `Vec` is then empty, and can be used
/// (or freed) again.
pub fn Vec<T>.free(v: *Vec<T>) {
    if v.cap != 0 { free(v.ptr as *u8); }
    v.ptr = empty_ptr();
    v.len = 0;
    v.cap = 0;
}

/// Sort the elements, stably, by `cmp(a, b)`: negative if `a` goes first,
/// positive if `b` does, 0 if they are equal. The comparator may capture
/// locals: `ids.sort_by(|a, b| names.at(*a).cmp(names.at(*b)))`.
pub fn Vec<T>.sort_by(v: *Vec<T>, cmp: block fn(*T, *T) -> i32) {
    sort_by(v.ptr, v.len, cmp);
}

/// Sort `n` values at `p` stably by `cmp` (see `Vec.sort_by`): insertion
/// sort for runs of 16, then a bottom-up merge sort through a buffer of
/// `n` values.
#[raw]
pub fn sort_by<T>(p: *T, n: u64, cmp: block fn(*T, *T) -> i32) {
    let run: u64 = 16;
    var lo: u64 = 0;
    while lo < n {
        let hi = if lo + run < n { lo + run } else { n };
        insertion_sort(p, lo, hi, cmp);
        lo = hi;
    }
    if n <= run { return; }
    let tmp: *T = alloc(n);
    var src = p;
    var dst = tmp;
    var w = run;
    while w < n {
        var l: u64 = 0;
        while l < n {
            let mid = if l + w < n { l + w } else { n };
            let hi = if l + 2 * w < n { l + 2 * w } else { n };
            merge_runs(src, dst, l, mid, hi, cmp);
            l = hi;
        }
        let t = src;
        src = dst;
        dst = t;
        w *= 2;
    }
    if src != p { copy(p, src, n); }
    release(tmp);
}

/// Sort the elements stably by `less(a, b)` ("does `a` go before `b`"), a
/// comparator that may fail and may run guest code (see `try_sort_by`).
pub fn Vec<T>.try_sort_by<E>(v: *Vec<T>, less: block fn(*T, *T) -> Result<bool, E> uses reenter) -> Result<(), E> uses reenter {
    try_sort_by(v.ptr, v.len, less)
}

/// Sort `n` values at `p` stably by `less(a, b)`: whether `a` goes before
/// `b`. The comparator may fail (the first `Err` stops the sort and is
/// returned, with `p` unchanged) and may collect or call guest code
/// (`uses reenter`). It is given pointers into `p`, which keeps every
/// element in place while comparing, so elements that `p` keeps reachable
/// for the collector (a guest list's items) stay reachable: the sort
/// orders indices (a bottom-up merge sort, insertion sort for runs of
/// 16), then permutes `p` once, without calls. `p` must stay valid and
/// unchanged during the sort: if guest code could change it, sort a copy.
#[raw]
pub fn try_sort_by<T, E>(p: *T, n: u64, less: block fn(*T, *T) -> Result<bool, E> uses reenter) -> Result<(), E> uses reenter {
    if n < 2 { return Ok(()); }
    var idx: *u64 = alloc(n);
    var tmp: *u64 = alloc(n);
    for i in 0..n { idx[i] = i; }
    let sorted = match sort_indices<T, E>(p, n, idx, tmp, less) {
        Ok(s) => s,
        Err(e) => {
            release(idx);
            release(tmp);
            return Err(e);
        }
    };
    let vals: *T = alloc(n);
    copy(vals, p, n);
    for i in 0..n { p[i] = vals[sorted[i]]; }
    release(vals);
    release(idx);
    release(tmp);
    Ok(())
}

/// The merge sort of `try_sort_by` over indices into `p`; the result is
/// `idx` or `tmp`, whichever holds the last pass.
fn sort_indices<T, E>(p: *T, n: u64, idx: *u64, tmp: *u64, less: block fn(*T, *T) -> Result<bool, E> uses reenter) -> Result<*u64, E> uses reenter {
    let run: u64 = 16;
    var lo: u64 = 0;
    while lo < n {
        let hi = if lo + run < n { lo + run } else { n };
        var i = lo + 1;
        while i < hi {
            let x = idx[i];
            var j = i;
            while j > lo and less(p + x, p + idx[j - 1])? {
                idx[j] = idx[j - 1];
                j -= 1;
            }
            idx[j] = x;
            i += 1;
        }
        lo = hi;
    }
    var src = idx;
    var dst = tmp;
    var w = run;
    while w < n {
        var l: u64 = 0;
        while l < n {
            let mid = if l + w < n { l + w } else { n };
            let hi = if l + 2 * w < n { l + 2 * w } else { n };
            var i = l;
            var j = mid;
            var k = l;
            while k < hi {
                // Take from the right run only if it is strictly less: stable.
                if i < mid and (j >= hi or !less(p + src[j], p + src[i])?) {
                    dst[k] = src[i];
                    i += 1;
                } else {
                    dst[k] = src[j];
                    j += 1;
                }
                k += 1;
            }
            l = hi;
        }
        let t = src;
        src = dst;
        dst = t;
        w *= 2;
    }
    Ok(src)
}

fn insertion_sort<T>(p: *T, lo: u64, hi: u64, cmp: block fn(*T, *T) -> i32) {
    var i = lo + 1;
    while i < hi {
        let x = p[i];
        var j = i;
        while j > lo and cmp(&x, p + (j - 1)) < 0 {
            p[j] = p[j - 1];
            j -= 1;
        }
        p[j] = x;
        i += 1;
    }
}

/// Merge the sorted runs `src[lo..mid]` and `src[mid..hi]` into `dst[lo..hi]`.
fn merge_runs<T>(src: *T, dst: *T, lo: u64, mid: u64, hi: u64, cmp: block fn(*T, *T) -> i32) {
    var i = lo;
    var j = mid;
    var k = lo;
    while k < hi {
        if i < mid and (j >= hi or cmp(src + i, src + j) <= 0) {
            dst[k] = src[i];
            i += 1;
        } else {
            dst[k] = src[j];
            j += 1;
        }
        k += 1;
    }
}

/// Index of the first byte `c` in `s` (`memchr`).
pub fn find_byte(s: []u8, c: u8) -> ?u64 {
    if s.len == 0 { return None; }
    match memchr(s.ptr, c as i32, s.len) {
        Some(p) => Some((p as u64) - (s.ptr as u64)),
        None => None,
    }
}

/// Index of the last byte `c` in `s` (`memrchr`).
pub fn rfind_byte(s: []u8, c: u8) -> ?u64 {
    if s.len == 0 { return None; }
    match memrchr(s.ptr, c as i32, s.len) {
        Some(p) => Some((p as u64) - (s.ptr as u64)),
        None => None,
    }
}

/// Index of the first occurrence of `needle` in `s` (`memmem`); an
/// empty needle is found at 0.
pub fn find_bytes(s: []u8, needle: []u8) -> ?u64 {
    if needle.len == 0 { return Some(0); }
    if s.len < needle.len { return None; }
    match memmem(s.ptr, s.len, needle.ptr, needle.len) {
        Some(p) => Some((p as u64) - (s.ptr as u64)),
        None => None,
    }
}

/// Compare byte strings lexicographically (`memcmp`, then the shorter
/// first): -1, 0 or 1.
pub fn compare_bytes(a: []u8, b: []u8) -> i32 {
    let n = if a.len < b.len { a.len } else { b.len };
    let r = if n == 0 { 0 } else { memcmp(a.ptr, b.ptr, n) };
    if r < 0 { return -1; }
    if r > 0 { return 1; }
    if a.len < b.len { -1 } else if a.len > b.len { 1 } else { 0 }
}

/// Whether `a` and `b` hold the same bytes (`a.eq(b)` with `std.hash`).
pub fn equal_bytes(a: []u8, b: []u8) -> bool {
    a.len == b.len and (a.len == 0 or memcmp(a.ptr, b.ptr, a.len) == 0)
}

/// Bump allocator: allocations are freed all at once.
pub struct Arena { chunk: *u8, used: u64, size: u64, chunks: Vec<*u8> }

pub fn Arena.new() -> Arena {
    #[cfg(sanitize_address)]
    {
        let a = Arena { chunk: malloc(65536), used: 0, size: 65536, chunks: Vec.new() };
        poison(a.chunk, 65536);
        return a;
    }
    Arena { chunk: malloc(65536), used: 0, size: 65536, chunks: Vec.new() }
}

#[raw]
pub fn Arena.alloc_bytes(a: *Arena, n: u64, align: u64) -> *u8 {
    var off = (a.used + align - 1) & (0 -% align);
    if off + n > a.size {
        a.chunks.push(a.chunk);
        let sz = if n + align > 65536 { n + align } else { 65536 };
        a.chunk = malloc(sz);
        a.size = sz;
        off = 0;
        #[cfg(sanitize_address)]
        poison(a.chunk, sz);
    }
    a.used = off + n;
    #[cfg(sanitize_address)]
    unpoison(a.chunk + off, n);
    a.chunk + off
}

/// Copy a string into the arena.
pub fn Arena.str(a: *Arena, s: str) -> str {
    let p = a.alloc_bytes(s.len, 1);
    memcpy(p, s.ptr, s.len);
    p.slice(s.len)
}

/// Free every allocation. The arena is then empty, and can be used (or
/// freed) again: its next allocation starts a new chunk.
pub fn Arena.free(a: *Arena) {
    let none = empty_ptr<u8>();
    for i in 0..a.chunks.len {
        let c = a.chunks.at(i);
        if c != none { free(c); }
    }
    if a.chunk != none { free(a.chunk); }
    a.chunks.free();
    // No chunk: the next `alloc_bytes` takes its slow path, which keeps
    // this sentinel in `chunks` (skipped above) and mallocs a chunk.
    a.chunk = none;
    a.used = 0;
    a.size = 0;
}

/// Arena memory is freed all at once (`free`): giving back one
/// allocation does nothing. (So `c.free(&arena)` is allowed on a closure
/// made with `new(&arena, ..)`, and generic code can free either kind.)
pub fn Arena.free_bytes(a: *Arena, p: *u8) {}

/// An allocator on the C heap whose allocations are freed one by one:
/// escaping closures made with `new(&m, |..| ..)` that `c.free(&m)`
/// gives back. `live` counts the allocations not freed yet.
pub struct Malloc { live: u64 }

pub fn Malloc.new() -> Malloc { Malloc { live: 0 } }

#[raw]
pub fn Malloc.alloc_bytes(m: *Malloc, n: u64, align: u64) -> *u8 {
    if align > 16 {
        let msg = "Malloc.alloc_bytes: alignment over 16\n";
        loimi_panic(msg.ptr, msg.len);
    }
    let p = malloc(if n == 0 { 1 } else { n });
    if (p as u64) == 0 { panic_oom(); }
    m.live += 1;
    p
}

/// Free an allocation of `alloc_bytes`.
#[raw]
pub fn Malloc.free_bytes(m: *Malloc, p: *u8) {
    m.live -= 1;
    free(p);
}
