// Parsing helpers: a Pratt (precedence-climbing) expression parser driven
// by a table of binding powers, in two forms:
//   - `Parser<P, K, E, X>`: the hooks are methods of the user's parser
//     state `P`, which implements the trait `Hooks<K, E, X>`. Calls are
//     direct (and inlinable), and `before_rhs` and `led` have defaults.
//   - `Pratt<P, K, E, X>`: the hooks are function pointers stored in the
//     table, each taking a `*P`.
// Both share the binding-power rules below.
//
// Type parameters, used throughout:
//   P  the user's parser state (the hooks receive a `*P`)
//   K  the token kind: an enum without payloads (it is used as a table
//      index through `k as u64`)
//   E  the expression result: an AST node, an expression descriptor as in
//      a single-pass compiler, or a value for an evaluator
//   X  the error type
//
// Hooks have no effects (`fn(*P) -> K`, not `fn(*P) -> K uses gc`), so
// `parse` has none either and can be called from any function. A hook may
// allocate (allocation never collects) but cannot collect or call guest
// code; collect between parses, from the caller. Effectful hooks would
// force `uses gc` on `parse` and every caller, and a shadow-stack frame at
// every hook call when `E` is traced.
//
// Binding powers: an infix operator has a left power and a right power.
// The operator binds if its left power is greater than the current
// minimum, and its right operand is parsed with the right power as the
// new minimum. Equal powers make the operator left-associative; a right
// power one lower makes it right-associative (`infix_left`, `infix_right`).
// Powers must be at least 1; 0 means "not an operator". A prefix operator
// parses its operand with its own power, so unary minus at 12 binds
// tighter than `*` at 10 but looser than right-associative `^` at 14:
// `-x ^ 2` is `-(x ^ 2)`, as in Lua.
//
// Operators that are not "lhs op rhs" get a `led` hook (Pratt's "left
// denotation"): when the operator binds, the driver consumes it and calls
// the hook with the left operand, and the hook parses the rest itself and
// returns the combined expression. That covers
//   - mixfix: `c ? a : b` (parse `a`, expect `:`, parse `b`),
//   - postfix: `x!`, `x++` (parse nothing),
//   - right-hand sides with their own grammar: `x = rhs` (check that the
//     left operand is a target), `x => body` (turn the left operand into
//     a parameter list), `a[i]`, `f(args)`, `obj.field`.
// A hook parses an operand with `pr.parse(p, bp)`, typically at the
// operator's right power (`pr.infix_of(k).right`), reaching the table
// through its parser state.

import std.mem;

/// The binding powers of an infix operator.
pub struct Prec { left: u32, right: u32 }

/// An operator table plus the hooks the driver calls.
pub struct Pratt<P, K, E, X> {
    /// Infix binding powers, indexed by `kind as u64`.
    infix_bp: mem.Vec<Prec>,
    /// Prefix binding powers, indexed by `kind as u64` (0: not prefix).
    prefix_bp: mem.Vec<u32>,
    /// The kind of the current token.
    peek: fn(*P) -> K,
    /// Consume the current token.
    advance: fn(*P) -> Result<(), X>,
    /// Parse an operand that does not start with a prefix operator: a
    /// literal, a name, a parenthesized expression, and any postfix
    /// suffixes (calls, indexing, field access).
    atom: fn(*P) -> Result<E, X>,
    /// Combine a prefix operator (already consumed) with its operand.
    unary: fn(*P, K, E) -> Result<E, X>,
    /// Combine `lhs op rhs`.
    binary: fn(*P, K, E, E) -> Result<E, X>,
    /// Optional: called after an infix operator is consumed and before its
    /// right operand is parsed, with the left operand; returns the left
    /// operand to use. Single-pass compilers use this to put the left
    /// operand in a register, or to emit the jump of `and`/`or`.
    before_rhs: ?fn(*P, K, E) -> Result<E, X>,
    /// Per-kind custom infix hooks (`led`), indexed by `kind as u64`.
    leds: mem.Vec<?fn(*P, K, E) -> Result<E, X>>,
}

/// A parser with no operators yet. `unary` is only called for kinds given
/// a prefix power with `prefix`.
pub fn Pratt<P, K, E, X>.new(
    peek: fn(*P) -> K,
    advance: fn(*P) -> Result<(), X>,
    atom: fn(*P) -> Result<E, X>,
    unary: fn(*P, K, E) -> Result<E, X>,
    binary: fn(*P, K, E, E) -> Result<E, X>,
) -> Pratt<P, K, E, X> {
    Pratt {
        infix_bp: mem.Vec.new(), prefix_bp: mem.Vec.new(),
        peek: peek, advance: advance, atom: atom, unary: unary, binary: binary, before_rhs: None,
        leds: mem.Vec.new(),
    }
}

/// Make `kind` an infix operator with the given binding powers.
pub fn Pratt<P, K, E, X>.infix(pr: *Pratt<P, K, E, X>, kind: K, left: u32, right: u32) {
    let i = kind as u64;
    while pr.infix_bp.len <= i { pr.infix_bp.push(Prec { left: 0, right: 0 }); }
    pr.infix_bp.set(i, Prec { left: left, right: right });
}

/// A left-associative infix operator: `a - b - c` is `(a - b) - c`.
pub fn Pratt<P, K, E, X>.infix_left(pr: *Pratt<P, K, E, X>, kind: K, bp: u32) { pr.infix(kind, bp, bp); }

/// A right-associative infix operator (bp >= 2): `a ^ b ^ c` is `a ^ (b ^ c)`.
pub fn Pratt<P, K, E, X>.infix_right(pr: *Pratt<P, K, E, X>, kind: K, bp: u32) { pr.infix(kind, bp, bp - 1); }

/// Make `kind` a custom infix operator with left power `left`: when it
/// binds, it is consumed and `led(p, kind, lhs)` parses the rest and
/// returns the result (`binary` and `before_rhs` are not called). `right`
/// is only recorded, for the hook to parse an operand with
/// `pr.parse(p, pr.infix_of(kind).right)`: for a mixfix or right-hand
/// side, the power that gives the associativity wanted (`left - 1` for
/// right-associative `?:` and `=`); 0 for a postfix operator.
pub fn Pratt<P, K, E, X>.led(pr: *Pratt<P, K, E, X>, kind: K, left: u32, right: u32, led: fn(*P, K, E) -> Result<E, X>) {
    pr.infix(kind, left, right);
    let i = kind as u64;
    while pr.leds.len <= i { pr.leds.push(None); }
    pr.leds.set(i, Some(led));
}

/// Make `kind` a prefix operator whose operand is parsed at power `bp`.
pub fn Pratt<P, K, E, X>.prefix(pr: *Pratt<P, K, E, X>, kind: K, bp: u32) {
    let i = kind as u64;
    while pr.prefix_bp.len <= i { pr.prefix_bp.push(0); }
    pr.prefix_bp.set(i, bp);
}

/// The infix powers of `kind` (left 0 if it is not an infix operator).
pub fn Pratt<P, K, E, X>.infix_of(pr: *Pratt<P, K, E, X>, kind: K) -> Prec {
    let i = kind as u64;
    if i < pr.infix_bp.len { pr.infix_bp.at(i) } else { Prec { left: 0, right: 0 } }
}

/// The prefix power of `kind` (0 if it is not a prefix operator).
pub fn Pratt<P, K, E, X>.prefix_of(pr: *Pratt<P, K, E, X>, kind: K) -> u32 {
    let i = kind as u64;
    if i < pr.prefix_bp.len { pr.prefix_bp.at(i) } else { 0 }
}

/// Parse an expression whose operators all bind tighter than `min_bp`.
/// Use 0 for a full expression. Hooks may call this recursively (for
/// example for a parenthesized expression in `atom`).
pub fn Pratt<P, K, E, X>.parse(pr: *Pratt<P, K, E, X>, p: *P, min_bp: u32) -> Result<E, X> {
    let first = pr.peek(p);
    let ubp = pr.prefix_of(first);
    var lhs: E = if ubp > 0 {
        pr.advance(p)?;
        let operand = pr.parse(p, ubp)?;
        pr.unary(p, first, operand)?
    } else {
        pr.atom(p)?
    };
    loop {
        let op = pr.peek(p);
        let b = pr.infix_of(op);
        if b.left <= min_bp { break; }
        pr.advance(p)?;
        let i = op as u64;
        if i < pr.leds.len and let Some(led) = pr.leds.at(i) {
            lhs = led(p, op, lhs)?;
            continue;
        }
        if let Some(h) = pr.before_rhs { lhs = h(p, op, lhs)?; }
        let rhs = pr.parse(p, b.right)?;
        lhs = pr.binary(p, op, lhs, rhs)?;
    }
    Ok(lhs)
}

/// Parse a full expression (`parse(p, 0)`).
pub fn Pratt<P, K, E, X>.expr(pr: *Pratt<P, K, E, X>, p: *P) -> Result<E, X> { pr.parse(p, 0) }

pub fn Pratt<P, K, E, X>.free(pr: *Pratt<P, K, E, X>) {
    pr.infix_bp.free();
    pr.prefix_bp.free();
    pr.leds.free();
}

// ── Parser: the hooks as a trait ────────────────────────────────────────

/// The hooks of a parser state for `Parser<Self, K, E, X>`: the same
/// roles as `Pratt`'s function pointers, as methods of the state.
pub trait Hooks<K, E, X> {
    /// The kind of the current token.
    fn peek(p: *Self) -> K;
    /// Consume the current token.
    fn advance(p: *Self) -> Result<(), X>;
    /// An operand that does not start with a prefix operator.
    fn atom(p: *Self) -> Result<E, X>;
    /// Combine a prefix operator (already consumed) with its operand.
    fn unary(p: *Self, op: K, operand: E) -> Result<E, X>;
    /// Combine `lhs op rhs`.
    fn binary(p: *Self, op: K, lhs: E, rhs: E) -> Result<E, X>;
    /// After an infix operator is consumed, before its right operand is
    /// parsed; returns the left operand to use. By default, unchanged.
    fn before_rhs(p: *Self, op: K, lhs: E) -> Result<E, X> { Ok(lhs) }
    /// A custom infix operator made with `Parser.led` (consumed): parse
    /// the rest and return the combined expression. Only called for kinds
    /// registered with `led`; the default traps.
    fn led(p: *Self, op: K, lhs: E) -> Result<E, X> { trap() }
}

/// An operator table for a parser state `P` with hooks `Hooks<K, E, X>`.
pub struct Parser<P: Hooks<K, E, X>, K, E, X> {
    infix_bp: mem.Vec<Prec>,
    prefix_bp: mem.Vec<u32>,
    /// Kinds whose infix form is a `led` hook.
    is_led: mem.Vec<bool>,
}

pub fn Parser<P, K, E, X>.new() -> Parser<P, K, E, X> {
    Parser { infix_bp: mem.Vec.new(), prefix_bp: mem.Vec.new(), is_led: mem.Vec.new() }
}

/// Make `kind` an infix operator with the given binding powers.
pub fn Parser<P, K, E, X>.infix(pr: *Parser<P, K, E, X>, kind: K, left: u32, right: u32) {
    let i = kind as u64;
    while pr.infix_bp.len <= i { pr.infix_bp.push(Prec { left: 0, right: 0 }); }
    pr.infix_bp.set(i, Prec { left: left, right: right });
}

/// A left-associative infix operator.
pub fn Parser<P, K, E, X>.infix_left(pr: *Parser<P, K, E, X>, kind: K, bp: u32) { pr.infix(kind, bp, bp); }

/// A right-associative infix operator (bp >= 2).
pub fn Parser<P, K, E, X>.infix_right(pr: *Parser<P, K, E, X>, kind: K, bp: u32) { pr.infix(kind, bp, bp - 1); }

/// Make `kind` a custom infix operator with left power `left`: when it
/// binds, it is consumed and `p.led(kind, lhs)` parses the rest
/// (`binary` and `before_rhs` are not called). `right` is recorded for
/// the hook (`pr.infix_of(kind).right`), as for `Pratt.led`.
pub fn Parser<P, K, E, X>.led(pr: *Parser<P, K, E, X>, kind: K, left: u32, right: u32) {
    pr.infix(kind, left, right);
    let i = kind as u64;
    while pr.is_led.len <= i { pr.is_led.push(false); }
    pr.is_led.set(i, true);
}

/// Make `kind` a prefix operator whose operand is parsed at power `bp`.
pub fn Parser<P, K, E, X>.prefix(pr: *Parser<P, K, E, X>, kind: K, bp: u32) {
    let i = kind as u64;
    while pr.prefix_bp.len <= i { pr.prefix_bp.push(0); }
    pr.prefix_bp.set(i, bp);
}

/// The infix powers of `kind` (left 0 if it is not an infix operator).
pub fn Parser<P, K, E, X>.infix_of(pr: *Parser<P, K, E, X>, kind: K) -> Prec {
    let i = kind as u64;
    if i < pr.infix_bp.len { pr.infix_bp.at(i) } else { Prec { left: 0, right: 0 } }
}

/// The prefix power of `kind` (0 if it is not a prefix operator).
pub fn Parser<P, K, E, X>.prefix_of(pr: *Parser<P, K, E, X>, kind: K) -> u32 {
    let i = kind as u64;
    if i < pr.prefix_bp.len { pr.prefix_bp.at(i) } else { 0 }
}

/// Parse an expression whose operators all bind tighter than `min_bp`
/// (0 for a full expression). Hooks may call this recursively.
pub fn Parser<P, K, E, X>.parse(pr: *Parser<P, K, E, X>, p: *P, min_bp: u32) -> Result<E, X> {
    let first = p.peek();
    let ubp = pr.prefix_of(first);
    var lhs: E = if ubp > 0 {
        p.advance()?;
        let operand = pr.parse(p, ubp)?;
        p.unary(first, operand)?
    } else {
        p.atom()?
    };
    loop {
        let op = p.peek();
        let b = pr.infix_of(op);
        if b.left <= min_bp { break; }
        p.advance()?;
        let i = op as u64;
        if i < pr.is_led.len and pr.is_led.at(i) {
            lhs = p.led(op, lhs)?;
            continue;
        }
        lhs = p.before_rhs(op, lhs)?;
        let rhs = pr.parse(p, b.right)?;
        lhs = p.binary(op, lhs, rhs)?;
    }
    Ok(lhs)
}

/// Parse a full expression (`parse(p, 0)`).
pub fn Parser<P, K, E, X>.expr(pr: *Parser<P, K, E, X>, p: *P) -> Result<E, X> { pr.parse(p, 0) }

pub fn Parser<P, K, E, X>.free(pr: *Parser<P, K, E, X>) {
    pr.infix_bp.free();
    pr.prefix_bp.free();
    pr.is_led.free();
}
