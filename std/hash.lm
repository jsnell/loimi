// Hashing and equality for map keys.

import std.mem;

/// Mix a 64-bit value (from splitmix64).
pub fn mix(x: u64) -> u64 {
    var z = x +% 0x9E3779B97F4A7C15;
    z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) *% 0x94D049BB133111EB;
    z ^ (z >> 31)
}

/// Hash a byte string (FNV-1a, then mixed).
pub fn bytes(s: str) -> u64 {
    var h: u64 = 0xCBF29CE484222325;
    for i in 0..s.len {
        h = (h ^ s[i] as u64) *% 0x100000001B3;
    }
    mix(h)
}

pub fn u64.hash(x: u64) -> u64 { mix(x) }
pub fn i64.hash(x: i64) -> u64 { mix(x as u64) }
pub fn u32.hash(x: u32) -> u64 { mix(x as u64) }
pub fn i32.hash(x: i32) -> u64 { mix(x as u64) }
pub fn str.hash(s: str) -> u64 { bytes(s) }

pub fn u64.eq(a: u64, b: u64) -> bool { a == b }
pub fn i64.eq(a: i64, b: i64) -> bool { a == b }
pub fn u32.eq(a: u32, b: u32) -> bool { a == b }
pub fn i32.eq(a: i32, b: i32) -> bool { a == b }
pub fn str.eq(a: str, b: str) -> bool {
    a.len == b.len and mem.memcmp(a.ptr, b.ptr, a.len) == 0
}
