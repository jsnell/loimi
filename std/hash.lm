// Hashing and equality for map keys.

#![safe]

import std.mem;

/// Map keys: `HashMap<K: Hash, V>`. A type implements it by defining the
/// methods `fn T.hash(k: T) -> u64` and `fn T.eq(a: T, b: T) -> bool` and
/// declaring `impl hash.Hash for T;`.
pub trait Hash {
    fn hash(k: Self) -> u64;
    fn eq(a: Self, b: Self) -> bool;
}

impl Hash for u64;
impl Hash for i64;
impl Hash for u32;
impl Hash for i32;
impl Hash for str;

/// Mix a 64-bit value (from splitmix64).
pub fn mix(x: u64) -> u64 {
    var z = x +% 0x9E3779B97F4A7C15;
    z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) *% 0x94D049BB133111EB;
    z ^ (z >> 31)
}

const WK: u64 = 0x9FB21C651E98DF25;

/// Hash a byte string: eight bytes per multiply, then mixed. Strings of
/// 8 bytes or more hash every whole word and then the last 8 bytes
/// (overlapping the previous word when the length is not a multiple of
/// 8); shorter ones read two overlapping 4-byte words, or the first,
/// middle and last bytes. The length is part of the seed, so the
/// overlaps cannot make strings of different lengths collide by
/// construction. A string-interning interpreter hashes every string it
/// makes, so this is on the hot path of string building
/// (bench/mini/RESULTS.md); byte-at-a-time FNV-1a took 4 cycles a byte.
pub fn bytes(s: str) -> u64 {
    let n = s.len;
    var h: u64 = 0xCBF29CE484222325 ^ (n *% WK);
    // unsafe: every read is of bytes p[0..n], unaligned (align 1)
    unsafe {
        let p = s.ptr;
        if n >= 8 {
            var i: u64 = 0;
            while i + 8 < n {
                let x = (h ^ ((p + i) as *u64).read_unaligned()) *% WK;
                h = (x << 29) | (x >> 35);
                i += 8;
            }
            h = (h ^ ((p + (n - 8)) as *u64).read_unaligned()) *% WK;
        } else if n >= 4 {
            let a = (p as *u32).read_unaligned() as u64;
            let b = ((p + (n - 4)) as *u32).read_unaligned() as u64;
            h = (h ^ ((a << 32) | b)) *% WK;
        } else if n > 0 {
            let a = p[0] as u64;
            let b = p[n / 2] as u64;
            let c = p[n - 1] as u64;
            h = (h ^ ((a << 16) | (b << 8) | c)) *% WK;
        }
    }
    mix(h)
}

pub fn u64.hash(x: u64) -> u64 { mix(x) }
pub fn i64.hash(x: i64) -> u64 { mix(x as u64) }
pub fn u32.hash(x: u32) -> u64 { mix(x as u64) }
pub fn i32.hash(x: i32) -> u64 { mix(x as u64) }
pub fn str.hash(s: str) -> u64 { bytes(s) }

pub fn u64.eq(a: u64, b: u64) -> bool { a == b }
pub fn i64.eq(a: i64, b: i64) -> bool { a == b }
pub fn u32.eq(a: u32, b: u32) -> bool { a == b }
pub fn i32.eq(a: i32, b: i32) -> bool { a == b }
pub fn str.eq(a: str, b: str) -> bool { mem.equal_bytes(a, b) }
