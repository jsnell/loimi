// Strings: building, comparison, parsing, interning.

import std.mem;
import std.hash;

extern "C" fn snprintf(buf: *u8, n: u64, fmt: *u8, ...) -> i32;
extern "C" fn strtod(s: *u8, end: **u8) -> f64;

/// A growable byte string.
pub struct StrBuf { bytes: mem.Vec<u8> }

pub fn StrBuf.new() -> StrBuf { StrBuf { bytes: mem.Vec.new() } }

pub fn StrBuf.push(b: *StrBuf, c: u8) { b.bytes.push(c); }

pub fn StrBuf.push_str(b: *StrBuf, s: str) {
    b.bytes.reserve(s.len);
    mem.memcpy(b.bytes.ptr + b.bytes.len, s.ptr, s.len);
    b.bytes.len += s.len;
}

pub fn StrBuf.push_int(b: *StrBuf, x: i64) {
    var buf: [u8; 24] = [0; 24];
    var i: u64 = 24;
    var u: u64 = if x < 0 { 0 -% (x as u64) } else { x as u64 };
    loop {
        i -= 1;
        buf[i] = '0' + (u % 10) as u8;
        u /= 10;
        if u == 0 { break; }
    }
    if x < 0 { i -= 1; buf[i] = '-'; }
    b.push_str(buf[i..24]);
}

/// Shortest representation that reads back as the same double ("%.17g"
/// trimmed: tries increasing precision).
pub fn StrBuf.push_f64(b: *StrBuf, x: f64) {
    var buf: [u8; 40] = [0; 40];
    var prec = 1;
    var n: i32 = 0;
    while prec <= 17 {
        n = snprintf(&buf[0], 40, "%.*g\0".ptr, prec, x);
        let back = strtod(&buf[0], 0 as **u8);
        if back == x or x != x { break; }
        prec += 1;
    }
    b.push_str(buf[0..n as u64]);
}

pub fn StrBuf.as_str(b: *StrBuf) -> str { b.bytes.items() }

/// Length in bytes.
pub fn StrBuf.len(b: *StrBuf) -> u64 { b.bytes.len }

pub fn StrBuf.clear(b: *StrBuf) { b.bytes.clear(); }

pub fn StrBuf.free(b: *StrBuf) { b.bytes.free(); }

pub fn starts_with(s: str, prefix: str) -> bool {
    s.len >= prefix.len and s[0..prefix.len].eq(prefix)
}

pub fn find(s: str, c: u8) -> ?u64 {
    for i in 0..s.len {
        if s[i] == c { return Some(i); }
    }
    None
}

pub fn is_digit(c: u8) -> bool { c >= '0' and c <= '9' }
pub fn is_alpha(c: u8) -> bool { (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' }
pub fn is_space(c: u8) -> bool { c == ' ' or c == '\t' or c == '\n' or c == '\r' }

/// Parse a decimal integer (optional sign). None on any other character or overflow.
pub fn parse_int(s: str) -> ?i64 {
    if s.len == 0 { return None; }
    var i: u64 = 0;
    let neg = s[0] == '-';
    if neg or s[0] == '+' { i = 1; }
    if i == s.len { return None; }
    var v: i64 = 0;
    while i < s.len {
        let c = s[i];
        if !is_digit(c) { return None; }
        v = v.mul_checked(10)?.add_checked((c - '0') as i64)?;
        i += 1;
    }
    Some(if neg { 0 - v } else { v })
}

/// Parse a floating-point number (C syntax).
pub fn parse_f64(s: str) -> ?f64 {
    if s.len == 0 or s.len > 63 { return None; }
    var buf: [u8; 64] = [0; 64];
    mem.memcpy(&buf[0], s.ptr, s.len);
    var end: *u8 = &buf[0];
    let v = strtod(&buf[0], &end);
    if (end as u64) - (&buf[0] as u64) != s.len { return None; }
    Some(v)
}

/// Interned strings: equal strings get equal ids (0, 1, 2, ...).
///
/// An open-addressing table of one word per slot, at most half full: the
/// id + 1 in the low half and the top 32 bits of the string's hash in
/// the high half, so a probe compares bytes only when the hashes agree.
pub struct Interner { slots: *u64, mask: u64, names: mem.Vec<str>, arena: mem.Arena }

pub fn Interner.new() -> Interner {
    Interner { slots: mem.alloc(64), mask: 63, names: mem.Vec.new(), arena: mem.Arena.new() }
}

/// The id of `s`, if it has one.
pub fn Interner.find(it: *Interner, s: str) -> ?u32 {
    let h = hash.bytes(s);
    let tag = h >> 32;
    var i = h & it.mask;
    loop {
        let w = it.slots[i];
        if w == 0 { return None; }
        if w >> 32 == tag {
            let id = (w & 0xFFFFFFFF) - 1;
            if it.names.at(id).eq(s) { return Some(id as u32); }
        }
        i = (i + 1) & it.mask;
    }
}

pub fn Interner.intern(it: *Interner, s: str) -> u32 {
    let h = hash.bytes(s);
    let tag = h >> 32;
    var i = h & it.mask;
    loop {
        let w = it.slots[i];
        if w == 0 { break; }
        if w >> 32 == tag {
            let id = (w & 0xFFFFFFFF) - 1;
            if it.names.at(id).eq(s) { return id as u32; }
        }
        i = (i + 1) & it.mask;
    }
    let owned = it.arena.str(s);
    let id = it.names.len;
    it.names.push(owned);
    it.slots[i] = (tag << 32) | (id + 1);
    if (id + 1) * 2 > it.mask { it.grow(); }
    id as u32
}

fn Interner.grow(it: *Interner) {
    let old = it.slots;
    let n = it.mask + 1;
    it.mask = n * 2 - 1;
    it.slots = mem.alloc(n * 2);
    for j in 0..n {
        let w = old[j];
        if w == 0 { continue; }
        let h = hash.bytes(it.names.at((w & 0xFFFFFFFF) - 1));
        var i = h & it.mask;
        while it.slots[i] != 0 { i = (i + 1) & it.mask; }
        it.slots[i] = w;
    }
    mem.release(old);
}

pub fn Interner.name(it: *Interner, id: u32) -> str { it.names.at(id as u64) }
