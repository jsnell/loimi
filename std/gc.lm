// Garbage-collected heap: precise, non-moving mark-sweep.
//
// Small objects (header included, up to 512 bytes) come from size-class
// free lists carved out of 64 KiB chunks; sweeping walks the chunks and
// rebuilds the free lists. Larger objects are calloc'd and kept on a list.
//
// Objects are allocated with `new(heap, Obj { .. })`. Allocation never
// collects; collection happens only in functions that `use gc`
// (`collect`, `maybe_collect`), so the compiler knows every place where
// roots must be visible. Roots are:
//   - traced locals of functions on the call stack at a `uses gc` call
//     (the compiler registers them in shadow-stack frames),
//   - scanners added with `Heap.add_scanner` (for example the VM stack).
// The compiler generates the tracing of each object type (including
// pointers inside NaN-boxed values) as `loimi_trace_object`.

import std.mem;

extern "C" fn loimi_trace_object(h: *Heap, obj: *u8, tid: u32);
extern "C" fn loimi_shadow_top() -> *ShadowFrame;
extern "C" fn calloc(n: u64, size: u64) -> *u8;
extern "C" fn free(p: *u8);
extern "C" fn write(fd: i32, buf: *u8, n: u64) -> i64;
extern "C" fn abort();

const HEADER: u64 = 24;
/// Size classes are multiples of 16 bytes, header included: class c holds
/// objects of up to 16 * c bytes, for c in 1..NCLASS.
const NCLASS: u64 = 33;
const CHUNK: u64 = 65536;
/// The `tid` of a free small-object slot.
const FREE: u16 = 0xFFFF;

/// Lives just before every object. `next` links large objects (and free
/// small slots); `size` is the slot size.
struct Header { next: *Header, size: u32, tid: u16, mark: u8, flags: u8, len: u64 }

/// A chunk of `n` small-object slots of `size` bytes each.
struct Chunk { base: *u8, size: u64, n: u64 }

/// Shadow-stack frame written by compiled code; entries follow `n`.
pub struct ShadowFrame { prev: *ShadowFrame, n: u64 }
struct ShadowEntry { slot: *u8, mark: fn(*Heap, *u8) }

struct Scanner { data: *u8, scan: fn(*Heap, *u8) }

pub struct Heap {
    /// Large objects.
    objects: *Header,
    /// Free small slots per size class.
    free: [*Header; 33],
    chunks: mem.Vec<Chunk>,
    /// Called after marking, before sweeping (for weak tables).
    sweepers: mem.Vec<Scanner>,
    count: u64,
    live_bytes: u64,
    allocated: u64,
    threshold: u64,
    min_heap: u64,
    stack: mem.Vec<*u8>,
    scanners: mem.Vec<Scanner>,
    collections: u64,
    freed: u64,
    stress: bool,
}

pub fn Heap.new() -> Heap {
    Heap {
        objects: 0 as *Header,
        free: [0 as *Header; 33],
        chunks: mem.Vec.new(),
        sweepers: mem.Vec.new(),
        count: 0,
        live_bytes: 0,
        allocated: 0,
        threshold: 1 << 20,
        min_heap: 1 << 20,
        stack: mem.Vec.new(),
        scanners: mem.Vec.new(),
        collections: 0,
        freed: 0,
        stress: false,
    }
}

/// Called by compiled code for `new`. The object is zeroed.
pub fn alloc(h: *Heap, size: u64, tid: u32, n: u64) -> *u8 {
    let c = (HEADER + size + 15) >> 4;
    if c < NCLASS {
        let hd = h.free[c];
        if (hd as u64) != 0 {
            h.free[c] = hd.next;
            hd.tid = tid as u16;
            hd.len = n;
            h.count += 1;
            h.allocated += c << 4;
            let p = hd as *u8 + HEADER;
            mem.memset(p, 0, size);
            return p;
        }
    }
    alloc_slow(h, size, tid, n)
}

#[inline(never)]
fn alloc_slow(h: *Heap, size: u64, tid: u32, n: u64) -> *u8 {
    let c = (HEADER + size + 15) >> 4;
    if c < NCLASS {
        add_chunk(h, c);
        return alloc(h, size, tid, n);
    }
    let p = calloc(1, HEADER + size);
    if (p as u64) == 0 { oom(); }
    let hd = p as *Header;
    hd.next = h.objects;
    hd.size = (HEADER + size) as u32;
    hd.tid = tid as u16;
    hd.len = n;
    h.objects = hd;
    h.count += 1;
    h.allocated += HEADER + size;
    p + HEADER
}

fn oom() {
    let m = "out of memory\n";
    write(2, m.ptr, m.len);
    abort();
}

/// Carve a new chunk into free slots of class `c`.
fn add_chunk(h: *Heap, c: u64) {
    let size = c << 4;
    let n = CHUNK / size;
    let base = calloc(1, n * size);
    if (base as u64) == 0 { oom(); }
    h.chunks.push(Chunk { base: base, size: size, n: n });
    var i = n;
    while i > 0 {
        i -= 1;
        let hd = (base + i * size) as *Header;
        hd.size = size as u32;
        hd.tid = FREE;
        hd.next = h.free[c];
        h.free[c] = hd;
    }
}

/// Whether the object at `p` survived marking. Meaningful only in a
/// sweeper (see `add_sweeper`).
pub fn is_marked(p: *u8) -> bool {
    let hd = (p - HEADER) as *Header;
    hd.mark != 0
}

/// Mark the object at `p` (null is ignored). Called by generated tracing code.
pub fn mark_ptr(h: *Heap, p: *u8) {
    if (p as u64) == 0 { return; }
    let hd = (p - HEADER) as *Header;
    if hd.mark != 0 { return; }
    hd.mark = 1;
    h.stack.push(p);
}

/// Register a root scanner: `scan(heap, data)` must `gc_mark` every
/// reference it owns.
pub fn Heap.add_scanner(h: *Heap, data: *u8, scan: fn(*Heap, *u8)) {
    h.scanners.push(Scanner { data: data, scan: scan });
}

/// Register a sweeper: `sweep(heap, data)` runs after marking and before
/// sweeping, and may drop references to unmarked objects (`is_marked`),
/// which makes them weak.
pub fn Heap.add_sweeper(h: *Heap, data: *u8, sweep: fn(*Heap, *u8)) {
    h.sweepers.push(Scanner { data: data, scan: sweep });
}

fn drain(h: *Heap) {
    while let Some(p) = h.stack.pop() {
        let hd = (p - HEADER) as *Header;
        loimi_trace_object(h, p, hd.tid as u32);
    }
}

/// Run a full collection.
pub fn collect(h: *Heap) uses gc {
    for i in 0..h.scanners.len {
        let s = h.scanners.at(i);
        s.scan(h, s.data);
    }
    var fr = loimi_shadow_top();
    while (fr as u64) != 0 {
        let entries = (fr as *u8 + 16) as *ShadowEntry;
        for i in 0..fr.n {
            let e = entries + i;
            e.mark(h, e.slot);
        }
        fr = fr.prev;
    }
    drain(h);
    for i in 0..h.sweepers.len {
        let s = h.sweepers.at(i);
        s.scan(h, s.data);
    }
    // Sweep the small objects, rebuilding the free lists in address order.
    var live: u64 = 0;
    var kept: u64 = 0;
    var freed: u64 = 0;
    for c in 0..NCLASS { h.free[c] = 0 as *Header; }
    var ci = h.chunks.len;
    while ci > 0 {
        ci -= 1;
        let ch = h.chunks.at(ci);
        let c = ch.size >> 4;
        var head = h.free[c];
        var i = ch.n;
        while i > 0 {
            i -= 1;
            let hd = (ch.base + i * ch.size) as *Header;
            if hd.tid != FREE {
                if hd.mark != 0 {
                    hd.mark = 0;
                    kept += 1;
                    live += ch.size;
                    continue;
                }
                hd.tid = FREE;
                freed += 1;
            }
            hd.next = head;
            head = hd;
        }
        h.free[c] = head;
    }
    // Large objects.
    var link: **Header = &h.objects;
    var cur = h.objects;
    while (cur as u64) != 0 {
        let next = cur.next;
        if cur.mark != 0 {
            cur.mark = 0;
            live += cur.size as u64;
            kept += 1;
            link = &cur.next;
        } else {
            *link = next;
            freed += 1;
            free(cur as *u8);
        }
        cur = next;
    }
    h.freed += freed;
    h.count = kept;
    h.live_bytes = live;
    h.allocated = 0;
    h.threshold = if h.stress { 0 } else if live > h.min_heap { live } else { h.min_heap };
    h.collections += 1;
}

/// Stress mode: collect at every safepoint (finds missing roots quickly).
pub fn Heap.set_stress(h: *Heap, on: bool) {
    h.stress = on;
    h.threshold = if on { 0 } else { h.min_heap };
}

/// Collect if enough has been allocated since the last collection.
pub fn maybe_collect(h: *Heap) uses gc {
    if h.allocated > h.threshold or h.stress {
        collect(h);
    }
}

/// Free every object (no finalizers run).
pub fn Heap.free(h: *Heap) {
    var cur = h.objects;
    while (cur as u64) != 0 {
        let next = cur.next;
        free(cur as *u8);
        cur = next;
    }
    h.objects = 0 as *Header;
    for i in 0..h.chunks.len { free(h.chunks.at(i).base); }
    h.chunks.free();
    for c in 0..NCLASS { h.free[c] = 0 as *Header; }
    h.count = 0;
    h.stack.free();
    h.scanners.free();
    h.sweepers.free();
}
