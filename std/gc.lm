// Garbage-collected heap: precise, non-moving mark-sweep, optionally
// generational (sticky mark bits).
//
// Small objects (header included, up to 512 bytes, in size classes of 16
// bytes) live in 64 KiB chunks of one size class each, aligned to their
// size (carved out of 2 MiB segments, aligned so that they can be huge
// pages). The start of a chunk is its header, which points at the heap's
// remembered set, so a write barrier finds it from an object's address
// alone, then a mark bitmap with a bit per 16-byte granule. Marking sets
// the bits of a small object's granules; nothing is swept: per size
// class, the allocator bump-allocates through runs of clear bits, which
// it finds from the bitmaps in chunk order (`refill`), and chunks with
// no marked object go to a pool that any class takes from. Larger
// objects are calloc'd, with the same remembered-set pointer just before
// their header, and kept in a vector.
//
// Objects are allocated with `new(heap, Obj { .. })`. Allocation never
// collects; collection happens only in functions that `use gc`
// (`collect`, `maybe_collect`), so the compiler knows every place where
// roots must be visible. Roots are:
//   - traced locals of functions on the call stack at a `uses gc` call
//     (the compiler registers them in shadow-stack frames),
//   - scanners added with `Heap.add_scanner` (for example the VM stack).
// The compiler generates the tracing of each object type (including
// pointers inside NaN-boxed values) as `loimi_trace_object`.
//
// Generational mode (`Heap.set_generational`), non-moving with sticky
// mark bits: an object is *old* once it survived a collection (a large
// object: two), and old objects keep their mark. A minor collection marks
// from the roots and the remembered set and treats marked (old) objects
// as done (their mark bits stay set). A major collection flips the mark
// epoch, which unmarks every object, clears the bitmaps, and runs a full
// mark. (A non-generational heap's collections are all major.) The write
// barrier keeps the invariant that an old
// object not in the remembered set points to no young object: the
// compiler calls `barrier(obj)` after every store of a traced value
// (`Gc`, a `value` type with references, a struct or option holding
// them) into a field or trailing-array element of an object reached
// through a `Gc`; code that stores through a raw pointer into an object
// calls `write_barrier(h, obj)` itself. Old objects carry the LOG flag
// until they are logged, so the barrier is one byte test:
//
//     if hd.flags & LOG != 0 { remember(obj) }   // rare: once per object per cycle
//
// Weak references (`Weak<T>`) and ephemeron tables (`Ephemerons<K, V>`)
// are cleared after marking; sweepers (`Heap.add_sweeper`) run after them.

import std.mem;
import std.io;
import std.hash;

extern "C" fn loimi_trace_object(h: *Heap, obj: *u8, tid: u32);
extern "C" fn loimi_shadow_top() -> *ShadowFrame;
extern "C" fn loimi_type_name(tid: u32) -> str;
extern "C" fn calloc(n: u64, size: u64) -> *u8;
extern "C" fn free(p: *u8);
extern "C" fn mmap(addr: *u8, len: u64, prot: i32, flags: i32, fd: i32, off: i64) -> *u8;
extern "C" fn munmap(addr: *u8, len: u64) -> i32;
extern "C" fn madvise(addr: *u8, len: u64, advice: i32) -> i32;
extern "C" fn write(fd: i32, buf: *u8, n: u64) -> i64;
extern "C" fn abort();
extern "C" fn getenv(name: *u8) -> *u8;
extern "C" fn clock_gettime(clk: i32, ts: *Timespec) -> i32;

struct Timespec { sec: i64, nsec: i64 }

fn now_ns() -> u64 {
    var ts = Timespec { sec: 0, nsec: 0 };
    clock_gettime(1, &ts);
    (ts.sec * 1000000000 + ts.nsec) as u64
}

const HEADER: u64 = 16;
/// The largest small object, header included; sizes are rounded up to a
/// multiple of 16 bytes (a granule). Larger objects are calloc'd.
const MAX_SMALL: u64 = 512;
/// Size classes: class c holds objects of 16 * c bytes, header included,
/// for c in 1..NCLASS.
const NCLASS: u64 = 33;
const CHUNK: u64 = 65536;
/// Chunks are carved out of segments of this many (2 MiB, mapped aligned
/// to their size: a transparent huge page each. With 1 MiB segments from
/// `posix_memalign`, which the kernel backs with 4 KiB pages, MiniJS's
/// richards ran 7% slower than with chunks in the brk heap.)
const SEG_CHUNKS: u64 = 32;
const SEG: u64 = 2097152;
/// Each chunk's mark bitmap, one bit per 16-byte granule of the chunk
/// (GRANULES bits in BM_WORDS words), follows its `ChunkHead`: a marked
/// small object has the bits of all its granules set. The allocator
/// allocates in the runs of clear bits (`refill`); nothing is swept.
const BITMAP: u64 = 16;
const BM_WORDS: u64 = 64;
const GRANULES: u64 = 4096;
/// The first granule after the chunk head and the bitmap.
const FIRST_GRANULE: u64 = 33;
const ONES: u64 = 0xFFFFFFFFFFFFFFFF;

/// Header flag: the object is old and not in the remembered set, so a
/// store into it must log it (`barrier`). Set only in generational mode.
const LOG: u8 = 1;
/// Header flag: a large object (calloc'd, remembered-set pointer before
/// the header).
const LARGE: u8 = 2;
/// Header flag: the large object survived a minor collection
/// (generational mode); it is promoted when it survives the next one.
/// Small objects are promoted when they first survive.
const AGED: u8 = 4;
/// Header flag: the object is in the remembered set (so `remember` does
/// not add it twice). An object stays there, with LOG set again, while
/// it points to young objects that survived a minor collection.
const INRS: u8 = 8;
/// The mark byte's values: 0 unmarked, 1 or 2 the epoch (old, or marked
/// in a major collection), YOUNG0..=YOUNG1 a young survivor of the last
/// minor collection (a new value each time), and NO_YOUNG none (the young
/// mark of a major collection, which promotes every survivor).
const YOUNG0: u8 = 3;
const YOUNG1: u8 = 254;
const NO_YOUNG: u8 = 255;

/// Lives just before every object (16 bytes, so a pair of two words takes
/// 32 bytes). `size` is the object's size with the header, rounded up to
/// 16 bytes; `len` is the length of the trailing array (compiled code
/// reads it at object - 8).
struct Header { size: u32, tid: u16, mark: u8, flags: u8, len: u64 }

/// A 64 KiB chunk at `base` (aligned to its size): the `ChunkHead`, the
/// mark bitmap, then objects of size class `class` from granule `start`
/// on, every 16 * `class` bytes. `start` varies from chunk to chunk (cache
/// coloring: with every chunk aligned alike, objects at the same place in
/// different chunks would compete for the same cache sets). `next` links
/// the chunks of a class, or the empty chunks (index + 1; 0 ends the
/// list).
struct Chunk { base: *u8, start: u64, class: u64, next: u64 }

/// At the start of each chunk (and 16 bytes before a large object's
/// header): where the write barrier logs objects.
struct ChunkHead { rs: *RemSet, pad: u64 }

/// The remembered set: old objects stored into since the last collection.
/// Allocated separately so its address stays fixed when the `Heap`
/// struct is moved.
/// `epoch` is the value of a set mark (see `Heap.epoch`), here so that
/// `is_marked` finds it from an object's address. `missed`: objects the
/// write barrier logged without adding them, because `objs` was full (it
/// makes no calls, so it cannot grow the vector); if any, the next
/// collection is a major one, which needs no remembered set, and the set
/// gets more room after it.
struct RemSet { objs: mem.Vec<*u8>, epoch: u8, young: u8, missed: u64 }

/// The least free room in the remembered set after a collection.
const RS_MIN: u64 = 256;

/// Shadow-stack frame written by compiled code; entries follow `n`.
pub struct ShadowFrame { prev: *ShadowFrame, n: u64 }
struct ShadowEntry { slot: *u8, mark: fn(*Heap, *u8) }

struct Scanner { data: *u8, scan: fn(*Heap, *u8) }

/// A registered ephemeron table: `mark` marks the values of entries whose
/// key is marked and returns whether it marked anything new; `sweep`
/// drops the entries whose key died.
struct EphHook { data: *u8, mark: fn(*Heap, *u8) -> bool, sweep: fn(*Heap, *u8) }

pub struct Heap {
    /// Large objects; those before `large_old` are old (generational mode).
    large: mem.Vec<*Header>,
    large_old: u64,
    /// Per size class, the run of free memory the allocator bumps
    /// through: the next object goes at `cur`, up to `lim`.
    cur: [*u8; 33],
    lim: [*u8; 33],
    /// Per size class, the chunk where `refill` looks for the next run
    /// (index + 1; 0: none left), and the granule there.
    avail: [u64; 33],
    scan_g: [u64; 33],
    /// The chunks with no marked object after the last collection, which
    /// any size class may take (index + 1; 0: none).
    pool: u64,
    chunks: mem.Vec<Chunk>,
    /// Raw segment allocations, and the next unused chunk of the last one.
    segments: mem.Vec<*u8>,
    seg_next: *u8,
    seg_left: u64,
    rs: *RemSet,
    /// Called after marking, before sweeping (for weak tables).
    sweepers: mem.Vec<Scanner>,
    ephemerons: mem.Vec<EphHook>,
    /// Live `Weak` objects (some may have died since the last collection).
    weaks: mem.Vec<*u8>,
    count: u64,
    /// Bytes in live objects after the last collection (in generational
    /// mode: the old generation).
    live_bytes: u64,
    allocated: u64,
    /// Collect when `allocated` exceeds this (set after each collection
    /// from `growth` and `min_heap`; in generational mode, the nursery).
    threshold: u64,
    /// The smallest allocation budget between collections, in bytes.
    min_heap: u64,
    /// The allocation budget after a collection, in percent of the live
    /// bytes: 100 (the default) collects again after allocating as much
    /// as survived, so the heap peaks at about twice the live data; 200
    /// lets it reach three times, and halves the number of collections.
    growth: u64,
    /// The largest allocation budget between collections (0: no limit),
    /// so a large growth factor does not multiply a large heap.
    max_budget: u64,
    stack: mem.Vec<*u8>,
    scanners: mem.Vec<Scanner>,
    collections: u64,
    /// Of `collections`, the minor ones.
    minors: u64,
    freed: u64,
    stress: bool,
    /// Generational mode (see the top of this file).
    gen: bool,
    /// Live objects may carry mark bits (after a generational collection).
    sticky: bool,
    /// The collection in progress is minor.
    minor: bool,
    /// The next collection must be major.
    want_major: bool,
    /// Cap on the allocation budget between minor collections (0: none).
    nursery: u64,
    /// Major collection once the old generation exceeds this.
    major_limit: u64,
    /// Live bytes after the last full collection (the nursery's budget is
    /// computed from them, not from the old generation, which also holds
    /// promoted objects that have died since).
    major_live: u64,
    /// Check the barrier invariant at every collection (`set_verify`).
    verify: bool,
    /// Checks `mark_ptr` makes on objects it has not marked yet, 0
    /// normally: VERIFYING (`verify_heap`) or OWN_ONLY (the shadow-stack
    /// walk, which may see other heaps' objects).
    checks: u8,
    vparent: *u8,
    /// Print a line per collection to stderr (`LOIMI_GC_STATS` set).
    stats: bool,
    mark_ns: u64,
    sweep_ns: u64,
    /// Free for the embedder (for example, runtime data that allocation
    /// helpers need but that is not passed to them).
    user: *u8,
    // Fields added for the generational mode's epochs and aging (after
    // the others, so that their offsets stay put).
    /// The mark byte of a marked object (1 or 2). Every major collection
    /// flips it instead of clearing every mark first: the objects alive
    /// after the last collection are unmarked (0) or marked with the
    /// current epoch, so after the flip all are unmarked. (Dead objects
    /// keep whatever mark they had, but nothing reaches them, and their
    /// mark bits are clear.)
    epoch: u8,
    /// Flags that marking sets: LOG in a generational heap (a survivor is
    /// old), else none.
    mark_flags: u8,
    /// Bytes marked with the epoch in the collection in progress (in a
    /// minor collection, the objects promoted).
    marked: u64,
    /// The mark of young survivors: of the minor collection in progress,
    /// or since the last one (NO_YOUNG after a major collection).
    young: u8,
    /// The mark an unmarked object gets when it was not AGED: `young` in
    /// a minor collection, else the epoch.
    first_mark: u8,
    /// Set by `mark_ptr` when a reference leads to a young survivor.
    young_ref: bool,
    /// Spare vector for rebuilding the remembered set.
    rs_tmp: mem.Vec<*u8>,
    /// Time in `refill` (finding runs of free granules).
    lazy_ns: u64,
    /// Objects marked in the collection in progress: with the epoch, and
    /// with a young mark.
    nold: u64,
    nyoung: u64,
    /// Objects marked with the epoch (old, in a generational heap).
    old_count: u64,
    /// `--gc-check-roots`: a bit per granule of each chunk (BM_WORDS
    /// words per chunk, by chunk index) set where an object starts.
    starts: mem.Vec<u64>,
}

pub fn Heap.new() -> Heap {
    let rs: *RemSet = mem.alloc(1);
    rs.objs = mem.Vec.new();
    rs.epoch = 1;
    rs.young = NO_YOUNG;
    rs.missed = 0;
    Heap {
        large: mem.Vec.new(),
        large_old: 0,
        cur: [0 as *u8; 33],
        lim: [0 as *u8; 33],
        avail: [0; 33],
        scan_g: [0; 33],
        pool: 0,
        chunks: mem.Vec.new(),
        segments: mem.Vec.new(),
        seg_next: 0 as *u8,
        seg_left: 0,
        rs: rs,
        epoch: 1,
        mark_flags: 0,
        marked: 0,
        young: NO_YOUNG,
        first_mark: 1,
        young_ref: false,
        rs_tmp: mem.Vec.new(),
        sweepers: mem.Vec.new(),
        ephemerons: mem.Vec.new(),
        weaks: mem.Vec.new(),
        count: 0,
        live_bytes: 0,
        allocated: 0,
        threshold: 1 << 20,
        min_heap: 1 << 20,
        growth: 100,
        max_budget: 0,
        stack: mem.Vec.new(),
        scanners: mem.Vec.new(),
        collections: 0,
        minors: 0,
        freed: 0,
        stress: false,
        gen: false,
        sticky: false,
        minor: false,
        want_major: false,
        nursery: 0,
        major_limit: 0,
        major_live: 0,
        verify: false,
        checks: 0,
        vparent: 0 as *u8,
        stats: (getenv("LOIMI_GC_STATS\0".ptr) as u64) != 0,
        mark_ns: 0,
        sweep_ns: 0,
        lazy_ns: 0,
        nold: 0,
        nyoung: 0,
        old_count: 0,
        starts: mem.Vec.new(),
        user: 0 as *u8,
    }
}

/// Called by compiled code for `new`. The object is zeroed.
pub fn alloc(h: *Heap, size: u64, tid: u32, n: u64) -> *u8 {
    let c = (HEADER + size + 15) >> 4;
    if c >= NCLASS { return alloc_large(h, size, tid, n); }
    let sz = c << 4;
    var hd = h.cur[c];
    if (h.lim[c] as u64) - (hd as u64) < sz { hd = refill(h, c); }
    h.cur[c] = hd + sz;
    // size, tid, mark and flags in one store, on the path after the
    // refill: the flags are 0 (young), which lets LLVM drop the write
    // barriers of stores into the new object that follow.
    *(hd as *u64) = sz | (((tid & 0xFFFF) as u64) << 32);
    (hd as *Header).len = n;
    h.count += 1;
    h.allocated += sz;
    let p = hd + HEADER;
    mem.memset(p, 0, size);
    p
}

/// Called by compiled code for `try_new`: `alloc` without its refill, so
/// that it makes no call (in a tail-call handler, a call anywhere gives
/// the handler a stack frame on every execution). Null if the current run
/// of free memory is too short; `make_room` refills it. Large objects
/// (over 496 bytes with the header) are allocated as by `alloc` (a call),
/// and a trailing array's zeroing is a `memset` call unless its length is
/// a constant.
#[inline]
pub fn try_alloc(h: *Heap, size: u64, tid: u32, n: u64) -> *u8 {
    let c = (HEADER + size + 15) >> 4;
    if c >= NCLASS { return alloc_large(h, size, tid, n); }
    let sz = c << 4;
    let hd = h.cur[c];
    if (h.lim[c] as u64) - (hd as u64) < sz { return 0 as *u8; }
    h.cur[c] = hd + sz;
    *(hd as *u64) = sz | (((tid & 0xFFFF) as u64) << 32);
    (hd as *Header).len = n;
    h.count += 1;
    h.allocated += sz;
    let p = hd + HEADER;
    mem.memset(p, 0, size);
    p
}

/// Make the next allocation of `size` bytes (`size_of<T>()`, plus the
/// trailing array's bytes) take the allocator's fast path, so that
/// `try_new` succeeds. Never collects. The slow path of `try_new` in a
/// handler:
///
///     let Some(c) = try_new(h, Cons { .. }) else cold { gc.make_room(h, size_of<Cons>()); redo };
#[inline(never)]
pub fn make_room(h: *Heap, size: u64) {
    let c = (HEADER + size + 15) >> 4;
    if c < NCLASS and (h.lim[c] as u64) - (h.cur[c] as u64) < (c << 4) { refill(h, c); }
}

/// The first granule at or after `g` whose bit in `bm` is set (`set`) or
/// clear; GRANULES if none.
#[inline]
fn next_bit(bm: *u64, g: u64, set: bool) -> u64 {
    if g >= GRANULES { return GRANULES; }
    let flip = if set { 0 } else { ONES };
    var w = g >> 6;
    var x = (bm[w] ^ flip) & (ONES << (g & 63));
    while x == 0 {
        w += 1;
        if w == BM_WORDS { return GRANULES; }
        x = bm[w] ^ flip;
    }
    (w << 6) + x.ctz()
}

/// Make the next run of free memory (granules with clear mark bits) in
/// a chunk of size class `c` the class's run, taking an empty chunk (or a
/// new one) when the class's chunks have none left; returns its start.
/// After each collection a class takes its chunks' runs in chunk order.
/// (A run in a chunk of the class starts and ends at object boundaries:
/// dead objects' bits are clear and live ones' set.)
#[inline(never)]
fn refill(h: *Heap, c: u64) -> *u8 {
    let ts = if h.stats { now_ns() } else { 0 };
    let sz = c << 4;
    loop {
        if h.avail[c] == 0 {
            if h.pool == 0 {
                add_chunk(h);
                h.avail[c] = h.chunks.len;
            } else {
                h.avail[c] = h.pool;
                h.pool = h.chunks.at(h.pool - 1).next;
            }
            let nc = h.chunks.ptr_at(h.avail[c] - 1);
            nc.class = c;
            nc.next = 0;
            h.scan_g[c] = 0;
        }
        let ch = h.chunks.at(h.avail[c] - 1);
        let bm = (ch.base + BITMAP) as *u64;
        var g = if h.scan_g[c] < ch.start { ch.start } else { h.scan_g[c] };
        while g < GRANULES {
            let a = next_bit(bm, g, false);
            if a >= GRANULES { break; }
            let b = next_bit(bm, a + 1, true);
            g = b;
            if ((b - a) << 4) >= sz {
                h.scan_g[c] = b;
                h.cur[c] = ch.base + (a << 4);
                h.lim[c] = ch.base + (b << 4);
                if h.stats { h.lazy_ns += now_ns() - ts; }
                return h.cur[c];
            }
        }
        h.avail[c] = ch.next;
        h.scan_g[c] = 0;
    }
}

/// After marking: reset the allocator's runs, and relink the chunks, in
/// index order, per size class, except those with no marked object,
/// which go to the empty chunks that any class can take.
fn relink_chunks(h: *Heap) {
    var tail: [u64; 33] = [0; 33];
    var ptail: u64 = 0;
    h.pool = 0;
    for c in 0..NCLASS {
        h.cur[c] = 0 as *u8;
        h.lim[c] = 0 as *u8;
        h.avail[c] = 0;
        h.scan_g[c] = 0;
    }
    for ci in 0..h.chunks.len {
        let ch = h.chunks.ptr_at(ci);
        ch.next = 0;
        let bm = (ch.base + BITMAP) as *u64;
        var any: u64 = 0;
        for w in 0..BM_WORDS { any = any | bm[w]; }
        if any == 0 {
            if ptail == 0 { h.pool = ci + 1; } else { h.chunks.ptr_at(ptail - 1).next = ci + 1; }
            ptail = ci + 1;
        } else {
            let c = ch.class;
            if tail[c] == 0 { h.avail[c] = ci + 1; } else { h.chunks.ptr_at(tail[c] - 1).next = ci + 1; }
            tail[c] = ci + 1;
        }
    }
}

/// Set the mark bits of the granules of the small object whose header is
/// at `hd`, of `sz` bytes.
#[inline]
fn set_bits(hd: *u8, sz: u64) {
    let a = hd as u64;
    let bm = ((a & !(CHUNK - 1)) + BITMAP) as *u64;
    let g = (a & (CHUNK - 1)) >> 4;
    let n = sz >> 4;
    let w = g >> 6;
    let b = g & 63;
    if b + n <= 64 {
        bm[w] = bm[w] | ((((1 as u64) << n) - 1) << b);
    } else {
        bm[w] = bm[w] | (ONES << b);
        bm[w + 1] = bm[w + 1] | (((1 as u64) << (b + n - 64)) - 1);
    }
}

/// Clear every chunk's mark bitmap (before a full collection).
fn clear_bitmaps(h: *Heap) {
    for ci in 0..h.chunks.len {
        mem.memset(h.chunks.at(ci).base + BITMAP, 0, BM_WORDS * 8);
    }
}

/// The headers of the small objects whose mark bits are set (in a
/// generational heap between collections: the old ones), chunk by chunk:
/// `var it = MarkedIter.new(h); while let Some(hd) = it.next() { .. }`.
struct MarkedIter { h: *Heap, ci: u64, g: u64 }

fn MarkedIter.new(h: *Heap) -> MarkedIter { MarkedIter { h: h, ci: 0, g: 0 } }

fn MarkedIter.next(it: *MarkedIter) -> ?*Header {
    while it.ci < it.h.chunks.len {
        let ch = it.h.chunks.at(it.ci);
        let bm = (ch.base + BITMAP) as *u64;
        let g = next_bit(bm, if it.g < ch.start { ch.start } else { it.g }, true);
        if g < GRANULES {
            let hd = (ch.base + (g << 4)) as *Header;
            it.g = g + ((hd.size as u64) >> 4);
            return Some(hd);
        }
        it.ci += 1;
        it.g = 0;
    }
    None
}

#[inline(never)]
fn alloc_large(h: *Heap, size: u64, tid: u32, n: u64) -> *u8 {
    let p = calloc(1, 16 + HEADER + size);
    if (p as u64) == 0 { oom(); }
    let head = p as *ChunkHead;
    head.rs = h.rs;
    let hd = (p + 16) as *Header;
    hd.size = (HEADER + size) as u32;
    hd.tid = tid as u16;
    hd.flags = LARGE;
    hd.len = n;
    h.large.push(hd);
    h.count += 1;
    h.allocated += HEADER + size;
    p + 16 + HEADER
}

fn oom() {
    let m = "out of memory\n";
    write(2, m.ptr, m.len);
    abort();
}

/// A fresh segment of SEG bytes aligned to SEG (zeroed, from mmap).
fn new_segment() -> *u8 {
    // PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS.
    let raw = mmap(0 as *u8, 2 * SEG, 3, 0x22, -1, 0);
    if (raw as i64) == -1 { oom(); }
    let a = raw as u64;
    let start = (a + SEG - 1) & !(SEG - 1);
    if start > a { munmap(raw, start - a); }
    let end = a + 2 * SEG;
    if end > start + SEG { munmap((start + SEG) as *u8, end - start - SEG); }
    let seg = start as *u8;
    madvise(seg, SEG, 14);   // MADV_HUGEPAGE
    seg
}

/// A new chunk (all free: a fresh segment is zeroed), at the end of the
/// chunk list.
fn add_chunk(h: *Heap) {
    if h.seg_left == 0 {
        let seg = new_segment();
        h.segments.push(seg);
        h.seg_next = seg;
        h.seg_left = SEG_CHUNKS;
    }
    let base = h.seg_next;
    h.seg_next = base + CHUNK;
    h.seg_left -= 1;
    let head = base as *ChunkHead;
    head.rs = h.rs;
    head.pad = 0;
    let start = FIRST_GRANULE + ((h.chunks.len * 37 + 11) % 64) * 4;
    h.chunks.push(Chunk { base: base, start: start, class: 0, next: 0 });
}

/// Whether the object at `p` survived marking. Meaningful only in a
/// sweeper (see `add_sweeper`). In a minor collection, old objects count
/// as marked. `h.is_marked(p)` is the same, faster.
pub fn is_marked(p: *u8) -> bool {
    let hd = (p - HEADER) as *Header;
    let rs = head_of(p).rs;
    hd.mark == rs.epoch or hd.mark == rs.young
}

/// Whether the object at `p`, in heap `h`, survived marking (see the
/// free function `is_marked`).
#[inline]
pub fn Heap.is_marked(h: *Heap, p: *u8) -> bool {
    let hd = (p - HEADER) as *Header;
    hd.mark == h.epoch or hd.mark == h.young
}

/// The `ChunkHead` of the chunk holding `obj` (or of a large object).
#[inline]
fn head_of(obj: *u8) -> *ChunkHead {
    let hd = (obj - HEADER) as *Header;
    if (hd.flags & LARGE) != 0 {
        (obj - HEADER - 16) as *ChunkHead
    } else {
        ((obj as u64) & !(CHUNK - 1)) as *ChunkHead
    }
}

/// Whether the collection in progress is a minor one (for sweepers that
/// can skip work: only objects allocated since the last collection die).
pub fn Heap.is_minor(h: *Heap) -> bool { h.minor }

/// Mark the object at `p` (null is ignored). Called by generated tracing code.
pub fn mark_ptr(h: *Heap, p: *u8) {
    if (p as u64) == 0 { return; }
    let hd = (p - HEADER) as *Header;
    let ep = h.epoch;
    let m = hd.mark;
    if m == ep { return; }
    if unlikely(h.checks != 0) {
        if !mark_check(h, p) { return; }
    }
    if m == h.young {
        h.young_ref = true;
        return;
    }
    // Unmarked. In a minor collection a young large object surviving for
    // the first time stays young (AGED); one that survived before, and
    // every small object, is promoted. (Aging small objects too traced
    // the survivors of programs with growing live data twice: Scheme's
    // nboyer, earley and mperm ran 5-8% slower.) A major collection
    // promotes every survivor.
    let nm = if (hd.flags & (AGED | LARGE)) != LARGE { ep } else { h.first_mark };
    hd.mark = nm;
    if nm == ep {
        let f = hd.flags;
        hd.flags = f | h.mark_flags;
        let sz = hd.size as u64;
        h.marked += sz;
        h.nold += 1;
        if (f & LARGE) == 0 { set_bits(hd as *u8, sz); }
    } else {
        hd.flags = hd.flags | AGED;
        h.young_ref = true;
        h.nyoung += 1;
    }
    h.stack.push(p);
}

// ── write barrier ───────────────────────────────────────────────────────

/// The write barrier, called by compiled code after storing a traced
/// value into the object at `obj`.
#[raw]
#[inline]
pub fn barrier(obj: *u8) {
    let hd = (obj - HEADER) as *Header;
    if unlikely((hd.flags & LOG) != 0) { log_obj(obj); }
}

/// The barrier's slow path, `remember` without calls: a call anywhere in a
/// tail-call handler gives it a stack frame on every execution (lowering.md
/// section 3), and this path is rare. When the remembered set is full it
/// only clears LOG and counts the object in `missed`, which makes the next collection a
/// major one (that marking sets LOG again on the survivors).
#[inline]
fn log_obj(obj: *u8) {
    let hd = (obj - HEADER) as *Header;
    let f = hd.flags & !LOG;
    if (f & INRS) != 0 {
        hd.flags = f;
        return;
    }
    let rs = head_of(obj).rs;
    let n = rs.objs.len;
    if n < rs.objs.cap {
        #[cfg(sanitize_address)]
        mem.unpoison(rs.objs.ptr + n, 1);
        rs.objs.ptr[n] = obj;
        rs.objs.len = n + 1;
        hd.flags = f | INRS;
    } else {
        rs.missed += 1;
        hd.flags = f;
    }
}

/// The write barrier for stores that bypass the compiler's: after storing
/// a GC reference through a raw pointer into the object at `obj` (into a
/// field or its trailing array), call `write_barrier(h, obj)` with that
/// object (not an interior pointer). Without it a generational heap can
/// free the stored object while it is still referenced. Free in a
/// non-generational heap except for one byte test.
#[raw]
#[inline]
pub fn write_barrier(h: *Heap, obj: *u8) {
    let hd = (obj - HEADER) as *Header;
    if unlikely((hd.flags & LOG) != 0) { log_obj(obj); }
}

/// Whether a store into `obj` would need logging (old and not logged).
/// For barriers that log more than the object itself (`remember`).
#[inline]
pub fn needs_barrier(obj: *u8) -> bool {
    let hd = (obj - HEADER) as *Header;
    (hd.flags & LOG) != 0
}

/// Add `obj` to its heap's remembered set: a minor collection traces it.
#[inline(never)]
pub fn remember(obj: *u8) {
    let hd = (obj - HEADER) as *Header;
    if (hd.flags & LOG) == 0 { return; }
    hd.flags = hd.flags & !LOG;
    if (hd.flags & INRS) != 0 { return; }
    hd.flags = hd.flags | INRS;
    head_of(obj).rs.objs.push(obj);
}

// ── hooks ───────────────────────────────────────────────────────────────

/// Register a root scanner: `scan(heap, data)` must `gc_mark` every
/// reference it owns. Scanners (and sweepers) run during a collection, so
/// they must not collect: their type has no effects, and a `uses gc`
/// function cannot be registered.
pub fn Heap.add_scanner(h: *Heap, data: *u8, scan: fn(*Heap, *u8)) {
    h.scanners.push(Scanner { data: data, scan: scan });
}

/// Register a sweeper: `sweep(heap, data)` runs after marking and before
/// sweeping, and may drop references to unmarked objects (`is_marked`),
/// which makes them weak.
pub fn Heap.add_sweeper(h: *Heap, data: *u8, sweep: fn(*Heap, *u8)) {
    h.sweepers.push(Scanner { data: data, scan: sweep });
}

fn drain(h: *Heap) {
    while let Some(p) = h.stack.pop() {
        let hd = (p - HEADER) as *Header;
        if h.minor and hd.mark == h.epoch {
            // Promoted in this minor collection: if it points to young
            // survivors, it goes into the remembered set.
            h.young_ref = false;
            loimi_trace_object(h, p, hd.tid as u32);
            if h.young_ref and (hd.flags & INRS) == 0 {
                hd.flags = hd.flags | INRS;
                h.rs.objs.push(p);
            }
        } else {
            loimi_trace_object(h, p, hd.tid as u32);
        }
    }
}

// ── collection ──────────────────────────────────────────────────────────

/// Run a collection: a full one, or in generational mode a minor one
/// unless the old generation has outgrown its budget.
pub fn collect(h: *Heap) uses gc {
    let t0 = if h.stats { now_ns() } else { 0 };
    if h.verify and h.sticky { verify_heap(h); }
    let minor = h.gen and h.sticky and !h.want_major and h.rs.missed == 0;
    if !minor {
        // A major collection: flip the epoch, which unmarks every object
        // (dead objects keep their old marks, but nothing reaches them),
        // and clear the mark bitmaps. A heap that was generational first
        // drops its old objects' LOG flags.
        if h.sticky and !h.gen { clear_marks(h); }
        new_epoch(h);
        clear_bitmaps(h);
    }
    let rs_n = h.rs.objs.len;
    let before = h.count;
    h.nold = 0;
    h.nyoung = 0;
    h.marked = 0;
    h.mark_flags = if h.gen { LOG } else { 0 };
    h.minor = minor;
    if minor {
        // A new young mark: the young survivors of the last minor
        // collection count as unmarked.
        h.young = if h.young >= YOUNG1 { YOUNG0 } else { h.young + 1 };
        h.first_mark = h.young;
        h.rs.young = h.young;
        // Old objects stored into: trace them, and log them again on the
        // next store. Those that point to young survivors stay in the
        // set (with LOG set: a store must still log the objects that an
        // interpreter logs together with them, `remember`).
        let rs = h.rs;
        let old = rs.objs;
        rs.objs = h.rs_tmp;
        rs.objs.clear();
        for i in 0..old.len {
            let p = old.at(i);
            let hd = (p - HEADER) as *Header;
            h.young_ref = false;
            loimi_trace_object(h, p, hd.tid as u32);
            hd.flags = hd.flags | LOG;
            if h.young_ref {
                rs.objs.push(p);
            } else {
                hd.flags = hd.flags & !INRS;
            }
        }
        h.rs_tmp = old;
    } else {
        h.young = NO_YOUNG;
        h.first_mark = h.epoch;
        h.rs.young = NO_YOUNG;
        h.rs.objs.clear();
    }
    for i in 0..h.scanners.len {
        let s = h.scanners.at(i);
        s.scan(h, s.data);
    }
    // The shadow stack is the thread's, shared by every heap used on
    // it: in a nested run into another heap, its frames hold that heap's
    // objects too, which must keep their marks.
    h.checks = OWN_ONLY;
    var fr = loimi_shadow_top();
    while (fr as u64) != 0 {
        let entries = (fr as *u8 + 16) as *ShadowEntry;
        for i in 0..fr.n {
            let e = entries + i;
            e.mark(h, e.slot);
        }
        fr = fr.prev;
    }
    h.checks = 0;
    drain(h);
    // Ephemerons: mark the values of entries with marked keys until
    // nothing new is marked.
    loop {
        for i in 0..h.ephemerons.len {
            let e = h.ephemerons.at(i);
            e.mark(h, e.data);
        }
        if h.stack.len == 0 { break; }
        drain(h);
    }
    for i in 0..h.ephemerons.len {
        let e = h.ephemerons.at(i);
        e.sweep(h, e.data);
    }
    clear_weaks(h);
    for i in 0..h.sweepers.len {
        let s = h.sweepers.at(i);
        s.scan(h, s.data);
    }
    let t1 = if h.stats { now_ns() } else { 0 };
    let keep = h.gen;
    let ep = h.epoch;
    // Small objects: nothing to sweep. Their mark bits are set, and the
    // allocator takes the runs of clear bits, from the first chunk on.
    relink_chunks(h);
    // Large objects (in a minor collection, the young ones).
    let first = if minor { h.large_old } else { 0 };
    let yg = h.young;
    var out = first;
    for i in first..h.large.len {
        let cur = h.large.at(i);
        if cur.mark == ep or cur.mark == yg {
            h.large.set(out, cur);
            out += 1;
        } else {
            free(cur as *u8 - 16);
        }
    }
    h.large.truncate(out);
    // Move the promoted ones (the rest stay young) to the old part.
    var nold = first;
    if minor {
        for i in first..out {
            let cur = h.large.at(i);
            if cur.mark == ep {
                h.large.set(i, h.large.at(nold));
                h.large.set(nold, cur);
                nold += 1;
            }
        }
    } else {
        nold = out;
    }
    h.large_old = if keep { nold } else { 0 };
    // Objects known to be alive: in a minor collection the old ones and
    // the young survivors (dead old objects are found by the next major
    // collection).
    if minor {
        h.count = h.old_count + h.nold + h.nyoung;
        h.old_count += h.nold;
    } else {
        h.count = h.nold + h.nyoung;
        h.old_count = h.nold;
    }
    h.freed += before - h.count;
    h.allocated = 0;
    h.collections += 1;
    h.sticky = keep;
    let live = h.marked;
    if minor {
        h.minors += 1;
        // Every object marked in a minor collection was young.
        h.live_bytes += h.marked;
        if h.live_bytes > h.major_limit { h.want_major = true; }
    } else {
        h.live_bytes = live;
        h.want_major = false;
        h.major_limit = live + budget(h, live);
        h.major_live = live;
    }
    h.minor = false;
    // Room for the barrier to log objects without growing the set: twice
    // what was logged since the last collection.
    if h.gen {
        let want = 2 * (rs_n + h.rs.missed);
        h.rs.objs.reserve(if want > RS_MIN { want } else { RS_MIN });
    }
    h.rs.missed = 0;
    // Verify mode: fill the free runs with 0x01 bytes, so that a dangling
    // reference reads a header of 0x01 bytes (`verify_fail`). Every small
    // survivor is marked (a minor collection promotes them), so a clear
    // bit is free memory.
    if h.verify { poison_free(h); }
    // In stress mode a generational heap still runs a major collection
    // now and then, so both kinds are exercised.
    if h.stress and h.gen and h.collections % 8 == 7 { h.want_major = true; }
    h.threshold = next_threshold(h);
    if h.stats {
        let t2 = now_ns();
        h.mark_ns += t1 - t0;
        h.sweep_ns += t2 - t1;
        io.eprint(if minor { "gc minor " } else { "gc major " });
        io.eprint_int(h.collections as i64);
        io.eprint(" live ");
        io.eprint_int((h.live_bytes >> 10) as i64);
        io.eprint("K rs ");
        io.eprint_int(rs_n as i64);
        io.eprint(" mark ");
        io.eprint_int(((t1 - t0) / 1000) as i64);
        io.eprint("us sweep ");
        io.eprint_int(((t2 - t1) / 1000) as i64);
        io.eprint("us total mark ");
        io.eprint_int((h.mark_ns / 1000000) as i64);
        io.eprint("ms sweep ");
        io.eprint_int((h.sweep_ns / 1000000) as i64);
        io.eprint("ms lazy sweep ");
        io.eprint_int((h.lazy_ns / 1000000) as i64);
        io.eprintln("ms");
    }
}

/// Before a major collection: flip the epoch, which
/// unmarks every object, and forget the remembered set. (Old objects keep
/// their LOG flag; marking sets it again on the survivors.)
fn new_epoch(h: *Heap) {
    h.epoch = 3 - h.epoch;
    h.rs.epoch = h.epoch;
    h.large_old = 0;
    for i in 0..h.rs.objs.len {
        let hd = (h.rs.objs.at(i) - HEADER) as *Header;
        hd.flags = hd.flags & !INRS;
    }
    h.rs.objs.clear();
    h.sticky = false;
}

/// Fill every run of free granules (clear mark bits) with 0x01 bytes.
fn poison_free(h: *Heap) {
    for ci in 0..h.chunks.len {
        let ch = h.chunks.at(ci);
        let bm = (ch.base + BITMAP) as *u64;
        var g = ch.start;
        while g < GRANULES {
            let a = next_bit(bm, g, false);
            if a >= GRANULES { break; }
            let b = next_bit(bm, a + 1, true);
            mem.memset(ch.base + (a << 4), 1, (b - a) << 4);
            g = b;
        }
    }
}

/// Before a full collection of a heap that was generational: clear the
/// flags of the old objects (LOG, INRS, AGED), and forget the remembered
/// set. (`new_epoch` then unmarks them.)
fn clear_marks(h: *Heap) {
    var it = MarkedIter.new(h);
    while let Some(hd) = it.next() { hd.flags = 0; }
    for i in 0..h.large.len {
        let cur = h.large.at(i);
        cur.flags = LARGE;
    }
    h.large_old = 0;
    h.rs.objs.clear();
    h.sticky = false;
}

/// The allocation budget until the next collection.
fn next_threshold(h: *Heap) -> u64 {
    if h.stress {
        // With verify on, a generational heap under stress collects after
        // 0 to 4 KiB of allocation (varying), not at every safepoint:
        // objects must stay young across a few safepoints for stores into
        // old objects to exercise the write barrier.
        if !(h.gen and h.verify) { return 0; }
        return (eph_hash(h.collections) & 4095) as u64;
    }
    if !h.gen { return budget(h, h.live_bytes); }
    // The nursery is the growth budget, or less if capped (`set_nursery`).
    let b = budget(h, h.major_live);
    if h.nursery != 0 and h.nursery < b { h.nursery } else { b }
}

/// Bytes that may be allocated after a collection that left `live` bytes.
fn budget(h: *Heap, live: u64) -> u64 {
    var b = live / 100 * h.growth + live % 100 * h.growth / 100;
    if h.max_budget != 0 and b > h.max_budget { b = h.max_budget; }
    if b > h.min_heap { b } else { h.min_heap }
}

/// Set the growth policy: after a collection, allocate `percent` percent
/// of the live bytes (at least `min_heap` bytes) before the next one.
/// Takes effect now for the current budget too. In generational mode it
/// sets when a major collection runs: once the old generation has grown
/// by that much since the last one.
pub fn Heap.set_growth(h: *Heap, percent: u64, min_heap: u64) {
    h.growth = percent;
    h.min_heap = min_heap;
    h.major_limit = h.live_bytes + budget(h, h.live_bytes);
    h.threshold = next_threshold(h);
}

/// Limit the allocation budget between collections to `bytes` (0: no
/// limit; `min_heap` still applies). With a large growth factor this
/// bounds the heap at the live data plus `bytes`, rather than a multiple
/// of the live data. Takes effect now for the current budget too.
pub fn Heap.set_max_budget(h: *Heap, bytes: u64) {
    h.max_budget = bytes;
    h.major_limit = h.live_bytes + budget(h, h.live_bytes);
    h.threshold = next_threshold(h);
}

/// Stress mode: collect at every safepoint (finds missing roots quickly).
pub fn Heap.set_stress(h: *Heap, on: bool) {
    h.stress = on;
    h.threshold = next_threshold(h);
}

/// Generational mode: collections are minor (young objects only) until
/// the old generation has grown by the growth budget (`set_growth`),
/// then major. Stores of references into objects through raw pointers
/// need `write_barrier`. Can be switched at any time.
pub fn Heap.set_generational(h: *Heap, on: bool) {
    h.gen = on;
    if on {
        h.rs.objs.reserve(h.rs.objs.len + RS_MIN);
        h.major_live = h.live_bytes;
        h.major_limit = h.live_bytes + budget(h, h.live_bytes);
    } else {
        h.want_major = false;
    }
    h.threshold = next_threshold(h);
}

/// Cap the allocation budget between minor collections at `bytes` (0, the
/// default: no cap, the same budget as between full collections, from
/// `set_growth`). A small nursery shortens minor pauses but promotes more
/// short-lived objects, which then wait for a major collection.
pub fn Heap.set_nursery(h: *Heap, bytes: u64) {
    h.nursery = bytes;
    h.threshold = next_threshold(h);
}

/// Verify mode, for generational heaps: at the start of every collection
/// check every old object's references: each must point to an allocated
/// object, and unless the object is in the remembered set, to an old one.
/// A violation (a missing write barrier, or a dangling reference) prints
/// the two objects' type ids and aborts. Costs a heap walk per collection;
/// meant for tests, with `set_stress`.
pub fn Heap.set_verify(h: *Heap, on: bool) {
    h.verify = on;
    h.threshold = next_threshold(h);
}

/// Collect if enough has been allocated since the last collection.
pub fn maybe_collect(h: *Heap) uses gc {
    if h.allocated > h.threshold or (h.stress and !(h.gen and h.verify)) {
        collect(h);
    }
}

// ── verification ────────────────────────────────────────────────────────

fn verify_heap(h: *Heap) {
    h.checks = VERIFYING;
    var it = MarkedIter.new(h);
    while let Some(hd) = it.next() {
        if hd.mark == h.epoch and (hd.flags & (LOG | INRS)) == LOG {
            let p = hd as *u8 + HEADER;
            h.vparent = p;
            loimi_trace_object(h, p, hd.tid as u32);
        }
    }
    for i in 0..h.large.len {
        let hd = h.large.at(i);
        if hd.mark == h.epoch and (hd.flags & (LOG | INRS)) == LOG {
            let p = hd as *u8 + HEADER;
            h.vparent = p;
            loimi_trace_object(h, p, hd.tid as u32);
        }
    }
    h.checks = 0;
}

/// `Heap.checks`.
const VERIFYING: u8 = 1;
const OWN_ONLY: u8 = 2;

/// For `mark_ptr` with `h.checks` set: whether to mark the unmarked
/// object at `p`.
#[cold]
fn mark_check(h: *Heap, p: *u8) -> bool {
    if h.checks == VERIFYING { verify_fail(h, p); }
    head_of(p).rs == h.rs
}

#[cold]
fn verify_fail(h: *Heap, p: *u8) {
    let hp = (h.vparent - HEADER) as *Header;
    let hd = (p - HEADER) as *Header;
    io.eprint("gc verify: old object of type ");
    io.eprint(loimi_type_name(hp.tid as u32));
    if hd.size == 0x01010101 {
        io.eprintln(" points to a freed object");
    } else {
        io.eprint(" points to a young object of type ");
        io.eprint(loimi_type_name(hd.tid as u32));
        io.eprintln(" but is not in the remembered set: missing write barrier");
    }
    abort();
}

// ── weak references ─────────────────────────────────────────────────────

/// A weak reference: does not keep its target alive, and reads as None
/// once the target has died. Make one with `Heap.new_weak`; the heap
/// clears it in the collection that frees the target.
pub object Weak<T> { addr: u64 }

/// A weak reference to `x`.
pub fn Heap.new_weak<T>(h: *Heap, x: Gc<T>) -> Gc<Weak<T>> {
    let w: Gc<Weak<T>> = new(h, Weak { addr: x as u64 });
    h.weaks.push(w as *u8);
    w
}

/// The target, or None if it died.
pub fn Weak<T>.get(w: Gc<Weak<T>>) -> ?Gc<T> {
    if w.addr == 0 { return None; }
    Some(unsafe { w.addr as Gc<T> })
}

/// Point `w` at `x` (or at nothing).
pub fn Weak<T>.set(w: Gc<Weak<T>>, x: ?Gc<T>) {
    w.addr = if let Some(o) = x { o as u64 } else { 0 };
}

/// Drop dead weak references from the registry and clear the live ones
/// whose target died.
fn clear_weaks(h: *Heap) {
    var out: u64 = 0;
    for i in 0..h.weaks.len {
        let p = h.weaks.at(i);
        if !h.is_marked(p) { continue; }
        let a = p as *u64;
        if *a != 0 and !h.is_marked(*a as *u8) { *a = 0; }
        h.weaks.set(out, p);
        out += 1;
    }
    h.weaks.truncate(out);
}

// ── ephemerons ──────────────────────────────────────────────────────────

/// An ephemeron table: a map from objects (by identity) to values of a
/// traced type V, where an entry keeps its value alive only while its key
/// is alive by other paths, and is dropped when the key dies. (A plain
/// map from keys to values would keep every value, and so every key the
/// values reference, alive.) The basis for JavaScript's WeakMap and Lua's
/// tables with weak keys.
///
/// The table lives in host memory: create it with `Ephemerons.new(h)`,
/// which registers it with the heap, and release it with `free`. Lookups
/// are by address (the heap does not move objects).
pub struct Ephemerons<K, V> {
    heap: *Heap,
    /// Open addressing: key addresses (0 empty, 1 deleted) and values.
    keys: *u64,
    vals: *V,
    cap: u64,
    used: u64,
    live: u64,
}

const EPH_DEL: u64 = 1;

fn eph_hash(a: u64) -> u64 {
    var z = a;
    z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) *% 0x94D049BB133111EB;
    z ^ (z >> 31)
}

/// A new, empty table registered with `h`.
pub fn Ephemerons<K, V>.new(h: *Heap) -> *Ephemerons<K, V> {
    let t: *Ephemerons<K, V> = mem.alloc(1);
    t.heap = h;
    t.cap = 8;
    t.keys = mem.alloc(8);
    t.vals = mem.alloc(8);
    t.used = 0;
    t.live = 0;
    h.ephemerons.push(EphHook { data: t as *u8, mark: eph_mark<K, V>, sweep: eph_sweep<K, V> });
    t
}

/// Unregister the table and free it.
pub fn Ephemerons<K, V>.free(t: *Ephemerons<K, V>) {
    let h = t.heap;
    var out: u64 = 0;
    for i in 0..h.ephemerons.len {
        let e = h.ephemerons.at(i);
        if e.data != t as *u8 {
            h.ephemerons.set(out, e);
            out += 1;
        }
    }
    h.ephemerons.truncate(out);
    mem.release(t.keys);
    mem.release(t.vals);
    mem.release(t);
}

/// Number of entries (including those whose key died since the last
/// collection).
pub fn Ephemerons<K, V>.len(t: *Ephemerons<K, V>) -> u64 { t.live }

fn Ephemerons<K, V>.slot(t: *Ephemerons<K, V>, a: u64) -> ?u64 {
    let mask = t.cap - 1;
    var i = eph_hash(a) & mask;
    loop {
        let k = t.keys[i];
        if k == a { return Some(i); }
        if k == 0 { return None; }
        i = (i + 1) & mask;
    }
}

/// The value for key `k`.
pub fn Ephemerons<K, V>.get(t: *Ephemerons<K, V>, k: Gc<K>) -> ?V {
    if let Some(i) = t.slot(k as u64) { Some(t.vals[i]) } else { None }
}

/// Set the value for key `k`.
pub fn Ephemerons<K, V>.set(t: *Ephemerons<K, V>, k: Gc<K>, v: V) {
    let a = k as u64;
    if let Some(i) = t.slot(a) {
        t.vals[i] = v;
        return;
    }
    if (t.used + 1) * 4 > t.cap * 3 {
        eph_resize(t, if (t.live + 1) * 2 > t.cap { t.cap * 2 } else { t.cap });
    }
    let mask = t.cap - 1;
    var i = eph_hash(a) & mask;
    while t.keys[i] > EPH_DEL { i = (i + 1) & mask; }
    if t.keys[i] == 0 { t.used += 1; }
    t.keys[i] = a;
    t.vals[i] = v;
    t.live += 1;
}
/// Remove the entry for `k`, if any.
#[shrinks(t)]
pub fn Ephemerons<K, V>.remove(t: *Ephemerons<K, V>, k: Gc<K>) {
    if let Some(i) = t.slot(k as u64) {
        t.keys[i] = EPH_DEL;
        t.live -= 1;
    }
}

fn eph_resize<K, V>(t: *Ephemerons<K, V>, cap: u64) {
    let ok = t.keys;
    let ov = t.vals;
    let n = t.cap;
    t.keys = mem.alloc(cap);
    t.vals = mem.alloc(cap);
    t.cap = cap;
    t.used = 0;
    let mask = cap - 1;
    for j in 0..n {
        let a = ok[j];
        if a > EPH_DEL {
            var i = eph_hash(a) & mask;
            while t.keys[i] != 0 { i = (i + 1) & mask; }
            t.keys[i] = a;
            t.vals[i] = ov[j];
            t.used += 1;
        }
    }
    mem.release(ok);
    mem.release(ov);
}

/// Mark the values of entries whose key is marked.
fn eph_mark<K, V>(h: *Heap, data: *u8) -> bool {
    let t = data as *Ephemerons<K, V>;
    let before = h.stack.len;
    for i in 0..t.cap {
        let a = t.keys[i];
        if a > EPH_DEL and h.is_marked(a as *u8) { gc_mark(h, t.vals[i]); }
    }
    h.stack.len != before
}

/// Drop the entries whose key died.
fn eph_sweep<K, V>(h: *Heap, data: *u8) {
    let t = data as *Ephemerons<K, V>;
    for i in 0..t.cap {
        let a = t.keys[i];
        if a > EPH_DEL and !h.is_marked(a as *u8) {
            t.keys[i] = EPH_DEL;
            t.live -= 1;
        }
    }
}

/// Free every object, after running the free hooks (`on_free`) of those
/// that have one.
pub fn Heap.free(h: *Heap) {
    release_hooks(h);
    for i in 0..h.large.len { free(h.large.at(i) as *u8 - 16); }
    h.large.free();
    for i in 0..h.segments.len { munmap(h.segments.at(i), SEG); }
    h.segments.free();
    h.chunks.free();
    for c in 0..NCLASS {
        h.cur[c] = 0 as *u8;
        h.lim[c] = 0 as *u8;
        h.avail[c] = 0;
    }
    h.pool = 0;
    h.old_count = 0;
    h.starts.free();
    h.seg_left = 0;
    h.count = 0;
    h.stack.free();
    h.scanners.free();
    h.sweepers.free();
    h.ephemerons.free();
    h.weaks.free();
    h.rs.objs.free();
    h.rs_tmp.free();
    mem.release(h.rs);
}

// ── weak intern tables ──────────────────────────────────────────────────

/// A weak intern table for strings in the GC heap: `intern(s)` returns the
/// one live string object with contents `s` (made if there is none), so
/// that equal strings are the same object and string equality is a
/// pointer compare. Entries are weak: a string that nothing else
/// references dies in the next collection and leaves the table (the next
/// `intern` of the same contents makes a new object, at a new or reused
/// address).
///
/// The string type X is the interpreter's own object, with at least the
/// fields `hash: u64` (set by `make` to the hash it is given) and
/// `data: [u8]`; `make(h, s, hash)` allocates one (`gc.new_str` for the
/// ready-made `gc.Str`):
///
///     object LStr { hash: u64, data: [u8] }
///     fn new_lstr(h: *gc.Heap, s: str, hv: u64) -> Gc<LStr> {
///         let o = new(h, LStr { hash: hv }, s.len);
///         mem.memcpy(o.data.ptr, s.ptr, s.len);
///         o
///     }
///     let strings = gc.WeakInterner.new(&heap, new_lstr);
///     let a = strings.intern("abc");      // never collects
///
/// Keys. A string's address is not a stable key on its own: once the
/// string dies, another object may get its address. `key(x)` pins `x`
/// (it stays alive, and in the table, for the table's lifetime) and
/// returns its address, which then names the contents for good: use it
/// for std.obj property keys and other side tables keyed by name.
///
/// The table lives in host memory: `new` registers it with the heap
/// (a sweeper, and a scanner for the pinned strings); `free` releases it.
pub struct WeakInterner<X> {
    heap: *Heap,
    make: fn(*Heap, str, u64) -> Gc<X>,
    /// Open addressing over addresses: 0 empty, 1 deleted; PIN set on
    /// pinned entries.
    slots: *u64,
    cap: u64,
    /// Non-empty slots (live and deleted), live entries.
    used: u64,
    live: u64,
    /// The pinned strings' addresses, for the scanner.
    pinned: mem.Vec<u64>,
}

const WI_DEL: u64 = 1;
const WI_PIN: u64 = 0x8000000000000000;
const WI_ADDR: u64 = 0x7FFFFFFFFFFFFFFF;

/// A ready-made GC string for `WeakInterner` (`gc.new_str` makes one).
pub object Str { hash: u64, data: [u8] }

/// The `make` function for `WeakInterner<gc.Str>`.
pub fn new_str(h: *Heap, s: str, hv: u64) -> Gc<Str> {
    let o = new(h, Str { hash: hv }, s.len);
    mem.memcpy(o.data.ptr, s.ptr, s.len);
    o
}

/// A new, empty table registered with `h`.
pub fn WeakInterner<X>.new(h: *Heap, make: fn(*Heap, str, u64) -> Gc<X>) -> *WeakInterner<X> {
    let t: *WeakInterner<X> = mem.alloc(1);
    *t = WeakInterner { heap: h, make: make, slots: mem.alloc(64), cap: 64, used: 0, live: 0, pinned: mem.Vec.new() };
    h.add_scanner(t as *u8, wi_scan<X>);
    h.add_sweeper(t as *u8, wi_sweep<X>);
    t
}

/// Unregister the table and free it (the strings stay in the heap).
pub fn WeakInterner<X>.free(t: *WeakInterner<X>) {
    let h = t.heap;
    unregister(&h.scanners, t as *u8);
    unregister(&h.sweepers, t as *u8);
    mem.release(t.slots);
    t.pinned.free();
    mem.release(t);
}

fn unregister(v: *mem.Vec<Scanner>, data: *u8) {
    var out: u64 = 0;
    for i in 0..v.len {
        let e = v.at(i);
        if e.data != data {
            v.set(out, e);
            out += 1;
        }
    }
    v.truncate(out);
}

/// Live strings (including those that died since the last collection).
pub fn WeakInterner<X>.len(t: *WeakInterner<X>) -> u64 { t.live }

fn wi_obj<X>(a: u64) -> Gc<X> { unsafe { (a & WI_ADDR) as Gc<X> } }

/// The string with contents `s`, if there is one.
pub fn WeakInterner<X>.find(t: *WeakInterner<X>, s: str) -> ?Gc<X> {
    let hv = hash.bytes(s);
    let mask = t.cap - 1;
    var i = hv & mask;
    loop {
        let a = t.slots[i];
        if a == 0 { return None; }
        if a != WI_DEL {
            let x = wi_obj<X>(a);
            if x.hash == hv and x.data.eq(s) { return Some(x); }
        }
        i = (i + 1) & mask;
    }
}

/// The string with contents `s`, made if there is none. Allocates but
/// never collects.
pub fn WeakInterner<X>.intern(t: *WeakInterner<X>, s: str) -> Gc<X> {
    let hv = hash.bytes(s);
    let mask = t.cap - 1;
    var i = hv & mask;
    var free = NO_SLOT;
    loop {
        let a = t.slots[i];
        if a == 0 { break; }
        if a == WI_DEL {
            if free == NO_SLOT { free = i; }
        } else {
            let x = wi_obj<X>(a);
            if x.hash == hv and x.data.eq(s) { return x; }
        }
        i = (i + 1) & mask;
    }
    let x = (t.make)(t.heap, s, hv);
    if free != NO_SLOT {
        t.slots[free] = x as u64;
    } else {
        t.slots[i] = x as u64;
        t.used += 1;
    }
    t.live += 1;
    if t.used * 2 > t.cap { wi_resize(t); }
    x
}

const NO_SLOT: u64 = 0xFFFFFFFFFFFFFFFF;

/// Pin `x` (a string from this table) and return its address: a key that
/// names `x`'s contents for the table's lifetime.
pub fn WeakInterner<X>.key(t: *WeakInterner<X>, x: Gc<X>) -> u64 {
    let a = x as u64;
    let mask = t.cap - 1;
    var i = x.hash & mask;
    loop {
        let w = t.slots[i];
        if w == 0 { abort_msg("std.gc: WeakInterner.key of a string that is not in the table"); }
        if w & WI_ADDR == a {
            if w & WI_PIN == 0 {
                t.slots[i] = w | WI_PIN;
                t.pinned.push(a);
            }
            return a;
        }
        i = (i + 1) & mask;
    }
}

/// Whether `x` is pinned (`key`).
pub fn WeakInterner<X>.is_pinned(t: *WeakInterner<X>, x: Gc<X>) -> bool {
    let a = x as u64;
    let mask = t.cap - 1;
    var i = x.hash & mask;
    loop {
        let w = t.slots[i];
        if w == 0 { return false; }
        if w & WI_ADDR == a { return w & WI_PIN != 0; }
        i = (i + 1) & mask;
    }
}

fn abort_msg(m: str) {
    write(2, m.ptr, m.len);
    write(2, "\n".ptr, 1);
    abort();
}

/// Rehash without deleted slots, growing if more than a quarter full.
fn wi_resize<X>(t: *WeakInterner<X>) {
    var cap = t.cap;
    while t.live * 4 > cap { cap *= 2; }
    let old = t.slots;
    let n = t.cap;
    t.slots = mem.alloc(cap);
    t.cap = cap;
    t.used = 0;
    let mask = cap - 1;
    for j in 0..n {
        let w = old[j];
        if w > WI_DEL {
            var i = wi_obj<X>(w).hash & mask;
            while t.slots[i] != 0 { i = (i + 1) & mask; }
            t.slots[i] = w;
            t.used += 1;
        }
    }
    mem.release(old);
}

/// Mark the pinned strings.
fn wi_scan<X>(h: *Heap, data: *u8) {
    let t = data as *WeakInterner<X>;
    for i in 0..t.pinned.len { mark_ptr(h, t.pinned.at(i) as *u8); }
}

/// Drop the strings that died.
fn wi_sweep<X>(h: *Heap, data: *u8) {
    let t = data as *WeakInterner<X>;
    for i in 0..t.cap {
        let w = t.slots[i];
        if w > WI_DEL and !h.is_marked((w & WI_ADDR) as *u8) {
            t.slots[i] = WI_DEL;
            t.live -= 1;
        }
    }
}

// ── free hooks ──────────────────────────────────────────────────────────
//
// `h.on_free(obj, f)`: when the collector finds `obj` dead, it calls
// `f(obj)` once, before the object's memory is reused. The hook is for
// releasing what the object owns outside the heap (`mem.alloc`'d
// buffers, file descriptors). It runs inside the collection, after
// marking, weak references and ephemerons (so no `Weak` reaches the
// object any more), before the other sweepers. It must not allocate
// in the heap, collect, register or remove hooks, or store `obj`
// anywhere (no resurrection), and it should read only the object's own
// fields that are not references: the objects it references may be dead
// too. The hooks of objects dying in the same collection run in no
// particular order. `Heap.free` runs the hooks of every object still
// registered, dead or alive.
//
// The registry is a sweeper's data, so heaps that never register a hook
// pay nothing; in a minor collection only the entries of young objects
// are looked at. These functions are emitted only where used
// (src/codegen.rs, `is_lazy`).

struct FreeHook { obj: *u8, f: fn(*u8) }

/// Registered hooks; those before `old` are of old objects (generational
/// mode), which a minor collection skips.
struct FreeHooks { hooks: mem.Vec<FreeHook>, old: u64 }

/// Call `f(obj)` when `obj` dies (see above). Register it once per object.
pub fn Heap.on_free(h: *Heap, obj: *u8, f: fn(*u8)) {
    let r = free_hooks(h);
    r.hooks.push(FreeHook { obj: obj, f: f });
}

/// `on_free` for an object of a known type: call `f(obj)` when `obj`
/// dies, under the same rules (no allocation, no resurrection: do not
/// store `obj`; read only its fields that are not references).
pub fn Heap.on_free_gc<T>(h: *Heap, obj: Gc<T>, f: fn(Gc<T>)) {
    // `fn(Gc<T>)` and `fn(*u8)` take the same argument (the object's
    // address): register `f` as the latter.
    var g: fn(*u8) = no_free_hook;
    unsafe { *(&g as *fn(Gc<T>)) = f; }
    h.on_free(obj as *u8, g);
}

fn no_free_hook(p: *u8) {}

/// The heap's hook registry, made (and registered as the first sweeper,
/// so that it runs before sweepers that overwrite dead objects, like
/// `rootck_poison`) on first use.
fn free_hooks(h: *Heap) -> *FreeHooks {
    for i in 0..h.sweepers.len {
        let s = h.sweepers.at(i);
        if s.scan == run_free_hooks { return s.data as *FreeHooks; }
    }
    let r: *FreeHooks = mem.alloc(1);
    r.hooks = mem.Vec.new();
    r.old = 0;
    h.sweepers.push(Scanner { data: r as *u8, scan: run_free_hooks });
    var i = h.sweepers.len - 1;
    while i > 0 {
        h.sweepers.set(i, h.sweepers.at(i - 1));
        i -= 1;
    }
    h.sweepers.set(0, Scanner { data: r as *u8, scan: run_free_hooks });
    r
}

/// The sweeper: run the hooks of the objects that died, drop them, and
/// move the entries of objects that became old before `old`.
fn run_free_hooks(h: *Heap, data: *u8) {
    let r = data as *FreeHooks;
    let first = if h.minor { r.old } else { 0 };
    var out = first;
    for i in first..r.hooks.len {
        let e = r.hooks.at(i);
        if h.is_marked(e.obj) {
            r.hooks.set(out, e);
            out += 1;
        } else {
            (e.f)(e.obj);
        }
    }
    r.hooks.truncate(out);
    var nold: u64 = 0;
    if h.gen {
        nold = first;
        for i in first..out {
            let e = r.hooks.at(i);
            if ((e.obj - HEADER) as *Header).mark == h.epoch {
                r.hooks.set(i, r.hooks.at(nold));
                r.hooks.set(nold, e);
                nold += 1;
            }
        }
    }
    r.old = nold;
}

// ── dirty pinning ───────────────────────────────────────────────────────
//
// `h.pin_dirty(obj)` .. `h.unpin_dirty(obj)`: while pinned, the object is
// a root, and every collection traces it, minor ones included, as if it
// were always in the remembered set. Stores into it then need no write
// barrier, and verify mode does not check it: for an object that the
// mutator writes through raw pointers in a hot loop (a register file or
// stack that is a GC object). `unpin_dirty` puts an old object into the
// remembered set, for the stores made since the last collection. Pins
// nest (pin twice, unpin twice). Each collection traces the whole
// object; use a `#[trace(f)]` hook to trace only its live part.
// Emitted only where used (src/codegen.rs, `is_lazy`).

struct Pinned { objs: mem.Vec<*u8> }

/// Pin `obj` (see above).
pub fn Heap.pin_dirty(h: *Heap, obj: *u8) {
    let r = pinned(h);
    r.objs.push(obj);
    if h.gen {
        // As if remembered: the barrier and verify mode skip it.
        let hd = (obj - HEADER) as *Header;
        hd.flags = (hd.flags & !LOG) | INRS;
    }
}

/// Undo one `pin_dirty(obj)`.
pub fn Heap.unpin_dirty(h: *Heap, obj: *u8) {
    let r = pinned(h);
    var i = r.objs.len;
    while i > 0 {
        i -= 1;
        if r.objs.at(i) == obj {
            r.objs.set(i, r.objs.at(r.objs.len - 1));
            r.objs.truncate(r.objs.len - 1);
            break;
        }
    }
    for j in 0..r.objs.len {
        if r.objs.at(j) == obj { return; }
    }
    if !h.gen { return; }
    let hd = (obj - HEADER) as *Header;
    if hd.mark == h.epoch {
        // Old: stores since the last collection had no barrier.
        hd.flags = (hd.flags & !LOG) | INRS;
        h.rs.objs.push(obj);
    } else {
        hd.flags = hd.flags & !INRS;
    }
}

/// Whether `obj` is pinned.
pub fn Heap.is_pinned_dirty(h: *Heap, obj: *u8) -> bool {
    let r = pinned(h);
    for j in 0..r.objs.len {
        if r.objs.at(j) == obj { return true; }
    }
    false
}

fn pinned(h: *Heap) -> *Pinned {
    for i in 0..h.scanners.len {
        let s = h.scanners.at(i);
        if s.scan == scan_pinned { return s.data as *Pinned; }
    }
    let r: *Pinned = mem.alloc(1);
    r.objs = mem.Vec.new();
    h.add_scanner(r as *u8, scan_pinned);
    r
}

/// The scanner: mark the pinned objects, and trace the old ones in a minor
/// collection (marking stops at them). Their flags say "remembered" again
/// (the remembered set's processing, or a major collection, may have
/// cleared INRS, and marking sets LOG).
fn scan_pinned(h: *Heap, data: *u8) {
    let r = data as *Pinned;
    for i in 0..r.objs.len {
        let p = r.objs.at(i);
        let hd = (p - HEADER) as *Header;
        if h.minor and hd.mark == h.epoch {
            loimi_trace_object(h, p, hd.tid as u32);
        } else {
            mark_ptr(h, p);
        }
        if h.gen { hd.flags = (hd.flags & !LOG) | INRS; }
    }
}

/// For `Heap.free`: run every registered free hook and release the
/// registries.
fn release_hooks(h: *Heap) {
    for i in 0..h.sweepers.len {
        let s = h.sweepers.at(i);
        if s.scan == run_free_hooks {
            let r = s.data as *FreeHooks;
            for j in 0..r.hooks.len {
                let e = r.hooks.at(j);
                (e.f)(e.obj);
            }
            r.hooks.free();
            mem.release(r);
        }
    }
    for i in 0..h.scanners.len {
        let s = h.scanners.at(i);
        if s.scan == scan_pinned {
            let r = s.data as *Pinned;
            r.objs.free();
            mem.release(r);
        }
    }
}

// ── other threads' roots (std.gil) ──────────────────────────────────────

/// Mark from the shadow-stack frames from `top` down: those of another
/// thread that shares this heap, saved when it released the heap
/// (`std.gil`). As for the collecting thread's own frames (`collect`),
/// only this heap's objects are marked. Emitted only where used.
pub fn mark_shadow_stack(h: *Heap, top: *ShadowFrame) {
    let saved = h.checks;
    h.checks = OWN_ONLY;
    var fr = top;
    while (fr as u64) != 0 {
        let entries = (fr as *u8 + 16) as *ShadowEntry;
        for i in 0..fr.n {
            let e = entries + i;
            e.mark(h, e.slot);
        }
        fr = fr.prev;
    }
    h.checks = saved;
}

/// This thread's shadow-stack top: the innermost frame of GC roots that
/// compiled code has linked. Emitted only where used.
pub fn shadow_top() -> *ShadowFrame { loimi_shadow_top() }

// ── checked roots (`loimi build --gc-check-roots`) ──────────────────────
//
// Built with `--gc-check-roots`, generated code marks every reference
// (shadow-stack roots, copies of vm state, `gc_mark` in scanners, fields
// traced by `loimi_trace_object`) through `rootck_mark` instead of
// `mark_ptr`: the reference must be null, or the start of an allocated
// object in one of this heap's chunks or among its large objects, before
// its header is read. Anything else (stack garbage in a slot listed too
// early, a pointer to an object freed while it was not rooted) aborts
// with the reference and what held it: the root's slot, its frame (the
// function, call site and the frame's roots) and the frame's depth on
// the shadow stack; or the object or `gc_mark` call. The compiler also
// fills traced locals' slots with 0x01 bytes where they are unassigned
// (on entry, and when their scope ends), and the first check of a
// non-generational heap installs a sweeper that fills the objects about
// to be freed with 0x01 bytes, so that a use after free reads garbage
// instead of the old values. These functions are emitted only in that
// mode (src/codegen.rs, `is_lazy`), so other builds' IR is unchanged.
// Every heap whose objects the shadow stack holds must be the heap being
// collected: references into another heap are reported too.

extern "C" fn loimi_rootck_what() -> str;
extern "C" fn loimi_rootck_kind() -> i64;
extern "C" fn loimi_rootck_idx() -> i64;
extern "C" fn loimi_rootck_info() -> u64;

/// `mark_ptr` with the checks of `--gc-check-roots`.
pub fn rootck_mark(h: *Heap, p: *u8) {
    if (p as u64) == 0 { return; }
    let why = rootck_check(h, p);
    if why != 0 { rootck_fail(h, p, why); }
    rootck_install(h);
    mark_ptr(h, p);
}

/// `alloc` for `new` in `--gc-check-roots` builds.
pub fn rootck_alloc(h: *Heap, size: u64, tid: u32, n: u64) -> *u8 {
    rootck_install(h);
    let p = alloc(h, size, tid, n);
    let hd = (p - HEADER) as *Header;
    if (hd.flags & LARGE) == 0 {
        // Record the start (and that no other object starts inside it).
        let ci = rootck_chunk(h, p as u64);
        while h.starts.len < h.chunks.len * BM_WORDS { h.starts.push(0); }
        let bm = h.starts.ptr + ci * BM_WORDS;
        let g = ((hd as u64) & (CHUNK - 1)) >> 4;
        for i in 0..(hd.size as u64) >> 4 {
            let k = g + i;
            bm[k >> 6] = bm[k >> 6] & !((1 as u64) << (k & 63));
        }
        bm[g >> 6] = bm[g >> 6] | ((1 as u64) << (g & 63));
    }
    p
}

/// The index of the chunk holding address `a` (a small object of `h`).
fn rootck_chunk(h: *Heap, a: u64) -> u64 {
    for si in 0..h.segments.len {
        let seg = h.segments.ptr[si] as u64;
        if a >= seg and a < seg + SEG { return si * SEG_CHUNKS + (a - seg) / CHUNK; }
    }
    abort_msg("gc check-roots: allocation outside the heap");
    0
}

/// 0 if `p` is the start of an allocated object of `h`, else why not.
pub fn rootck_check(h: *Heap, p: *u8) -> u64 {
    let a = p as u64;
    if a == 0x0101010101010101 { return 7; }
    if (a & 15) != 0 { return 1; }
    for si in 0..h.segments.len {
        let seg = h.segments.ptr[si] as u64;
        if a >= seg and a < seg + SEG {
            let ci = si * SEG_CHUNKS + (a - seg) / CHUNK;
            if ci >= h.chunks.len { return 3; }
            let ch = h.chunks.ptr + ci;
            let base = ch.base as u64;
            if base != seg + ((a - seg) & !(CHUNK - 1)) { return 6; }
            let g = (a - HEADER - base) >> 4;
            if a < base + HEADER or g < ch.start { return 4; }
            let hd = (a - HEADER) as *Header;
            if ci * BM_WORDS >= h.starts.len or (h.starts.ptr[ci * BM_WORDS + (g >> 6)] & ((1 as u64) << (g & 63))) == 0 {
                return if hd.size == 0x01010101 { 5 } else { 4 };
            }
            return 0;
        }
    }
    for i in 0..h.large.len {
        if (h.large.ptr[i] as u64) + HEADER == a { return 0; }
    }
    2
}

#[cold]
pub fn rootck_fail(h: *Heap, p: *u8, why: u64) {
    io.eprint("gc check-roots: bad reference 0x");
    rootck_hex(p as u64);
    io.eprint(": ");
    io.eprintln(if why == 1 {
        "misaligned"
    } else if why == 2 {
        "not in this heap"
    } else if why == 3 {
        "in a part of a segment not yet used"
    } else if why == 4 {
        "not the start of an object"
    } else if why == 5 {
        "a freed object"
    } else if why == 7 {
        "0x01 bytes: an unassigned slot, or read from a freed object"
    } else {
        "chunk table mismatch"
    });
    let k = loimi_rootck_kind();
    let idx = loimi_rootck_idx();
    if k == 0 {
        io.eprint("  root #");
        io.eprint_int(idx);
        io.eprint(" of shadow-stack frame #");
        io.eprint_int(rootck_depth());
        io.eprintln(" (0: the innermost) of");
        io.eprint("  ");
    } else if k == 1 {
        io.eprint("  in the object at 0x");
        rootck_hex(idx as u64);
        io.eprint(", ");
    } else if k == 2 {
        io.eprint("  ");
    } else {
        io.eprint("  (unknown source)");
    }
    io.eprintln(loimi_rootck_what());
    abort();
}

/// The depth on the shadow stack of the frame being scanned.
pub fn rootck_depth() -> i64 {
    let info = loimi_rootck_info();
    var fr = loimi_shadow_top();
    var d: i64 = 0;
    while (fr as u64) != 0 {
        let entries = (fr as *u8 + 16) as *ShadowEntry;
        if fr.n > 0 and (entries.slot as u64) == info { return d; }
        d += 1;
        fr = fr.prev;
    }
    -1
}

pub fn rootck_hex(x: u64) {
    var buf: [u8; 16] = [0; 16];
    for i in 0..16 {
        let d = (x >> ((15 - i) * 4)) & 15;
        buf[i] = if d < 10 { (d + 48) as u8 } else { (d + 87) as u8 };
    }
    write(2, &buf[0], 16);
}

/// Install `rootck_poison` as a sweeper of `h` (once; not in a
/// generational heap, whose unmarked objects are not all dead).
pub fn rootck_install(h: *Heap) {
    if h.gen { return; }
    let tag = h.rs as *u8;
    for i in 0..h.sweepers.len {
        if h.sweepers.ptr[i].data == tag { return; }
    }
    h.add_sweeper(tag, rootck_poison);
}

/// Fill the objects this collection frees with 0x01 bytes.
pub fn rootck_poison(h: *Heap, data: *u8) {
    if h.gen { return; }
    // Forget the starts of the dead objects, and poison them.
    for ci in 0..h.chunks.len {
        if ci * BM_WORDS >= h.starts.len { break; }
        let bm = (h.chunks.at(ci).base + BITMAP) as *u64;
        for w in 0..BM_WORDS {
            h.starts.ptr[ci * BM_WORDS + w] = h.starts.ptr[ci * BM_WORDS + w] & bm[w];
        }
    }
    poison_free(h);
    for i in 0..h.large.len {
        let hd = h.large.ptr[i];
        if hd.mark != h.epoch { mem.memset(hd as *u8 + HEADER, 1, hd.size as u64 - HEADER); }
    }
}
