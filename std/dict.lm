// An insertion-ordered hash table in the GC heap: guest dicts.
//
// The same layout and probing as `std.map.OrderedMap` (CPython's compact
// dict: an index table of u32 slots over a dense array of entries in
// insertion order, each entry keeping its hash), with the index and the
// entries in GC objects, so keys and values may be traced (`Value`,
// `Gc<T>`). A `Dict` is itself a GC object: a guest dict can be one, or
// hold one. Removed entries are zeroed, so they keep nothing alive.
//
// Lookups come in three forms:
//   - `get`/`insert`/`remove`/`contains`, through `hash.Hash` on K;
//   - `find_by(hash, eq)`, for a hash and an equality of the caller's
//     that cannot fail or run guest code (a string's cached hash, a
//     pointer compare first);
//   - `find_with(hash, eq)`, for an equality that can fail and run guest
//     code (`__eq__`), which may change the dict: the lookup starts over
//     when `version` changed during an `eq` call (CPython's rule).
// Entry indices (from `find_by`, `next`, `insert_new`) are stable until
// the dict is compacted; `version` changes on every insertion of a new
// key, removal, compaction and `clear` (not on value updates), so an
// inline cache can hold an entry index and check the key at it, or hold
// the version. Functions that may allocate take the heap; like `new`,
// they never collect, so `insert` can run in a handler's fast path.
//
// A `#![safe]` module (language.md section 1.3). A dict's fields hold no
// raw pointers, so any module may write them (and the index slots):
// nothing here relies on `mask`, `used` or the slots being consistent
// for memory safety. Probing goes over the trailing arrays as slices,
// masked by the index's own length and bounds-checked against the
// entries' real length; inconsistent fields can make a probe panic or
// never end, not reach outside the tables. The `unsafe` blocks are
// zeroing whole entries and reading a key's bytes. Stores through the
// trailing arrays passed as slices (`rebuild_in`, `zero`) get the write
// barrier from the compiler, after the call (src/objref.rs).
// Entry-index methods (`key`, `value`, `hash_at`, `set_value`) take any
// index below the entries' capacity: an entry that is dead or not yet
// used reads as zero bytes, as a fresh trailing array does; `remove_at`
// panics unless the entry is live.

#![safe]

import std.gc;
import std.mem;
import std.hash;
import std.map;
import std.map.{Entry};
import std.rt;

/// The index table: u32 slots, `map.SLOT_EMPTY`, `map.SLOT_DELETED`, or
/// entry + `map.SLOT_BASE`.
pub object DictIndex { s: [u32] }

/// The entries, in insertion order (`used` of them in use).
pub object DictEntries<K, V> { e: [Entry<K, V>] }

// ── the unsafe parts ─────────────────────────────────────────────────

/// Zero the elements of `s`: dead entries and a cleared index become what
/// a fresh trailing array holds (zero bytes, as `new` makes them).
fn zero<T>(s: []T) {
    // unsafe: memset writes exactly the s.len * size_of<T>() bytes of `s`.
    unsafe { mem.memset(s.ptr as *u8, 0, s.len * size_of<T>()); }
}

/// Whether the key bytes at `k` are not all zero (a live entry).
#[inline(always)]
fn key_live<K>(k: *K) -> bool {
    // unsafe: reads only the size_of<K>() bytes of the one K at `k` (as u64
    // words when the size is a multiple of 8).
    unsafe {
        if size_of<K>() % 8 == 0 {
            let w = k as *u64;
            for i in 0..size_of<K>() / 8 { if w[i] != 0 { return true; } }
            return false;
        }
        let b = k as *u8;
        for i in 0..size_of<K>() { if b[i] != 0 { return true; } }
        false
    }
}

#[cold]
#[inline(never)]
fn bad_entry() -> never {
    rt.panic("dict: not a live entry index\n");
}

// ── probing over the tables as slices ───────────────────────────────
//
// `map.probe_*`'s CPython-style probing, with the index and the entries
// as bounds-checked slices (so the fields and the slots need not be
// right for memory safety). The probes mask by the index's own length
// (a power of two: `mask + 1`), so LLVM drops the bounds checks of slot
// reads; entry reads keep theirs (one compare per candidate).

#[cold]
#[inline(never)]
fn bad_index() -> never {
    rt.panic("dict: empty index table\n");
}

/// The mask of the index `idx` (its length minus one).
#[inline(always)]
fn mask_of(idx: []u32) -> u64 {
    if idx.len == 0 { bad_index(); }
    idx.len - 1
}

/// The entry of stored hash `hash` whose key `eq` accepts.
#[inline]
fn find_in<K, V>(idx: []u32, ents: []Entry<K, V>, hash: u64, eq: block fn(K) -> bool) -> ?u64 {
    let mask = mask_of(idx);
    var i = hash & mask;
    var perturb = hash;
    loop {
        let s = idx[i];
        if s == map.SLOT_EMPTY { return None; }
        if s >= map.SLOT_BASE {
            let e = (s - map.SLOT_BASE) as u64;
            let p = &ents[e];
            if p.hash == hash and eq(p.key) { return Some(e); }
        }
        perturb = perturb >> 5;
        i = (i * 5 + 1 + perturb) & mask;
    }
}

/// One probe for find-or-insert: `(e, true)` if `eq` accepts the key of
/// entry `e`, else `(slot, false)` with the first empty or deleted index
/// slot on the path, where the key goes.
#[inline]
fn lookup_in<K, V>(idx: []u32, ents: []Entry<K, V>, hash: u64, eq: block fn(K) -> bool) -> (u64, bool) {
    let mask = mask_of(idx);
    var i = hash & mask;
    var perturb = hash;
    var free: u64 = 0xffffffffffffffff;
    loop {
        let s = idx[i];
        if s == map.SLOT_EMPTY { return (if free == 0xffffffffffffffff { i } else { free }, false); }
        if s >= map.SLOT_BASE {
            let e = (s - map.SLOT_BASE) as u64;
            let p = &ents[e];
            if p.hash == hash and eq(p.key) { return (e, true); }
        } else if free == 0xffffffffffffffff {
            free = i;
        }
        perturb = perturb >> 5;
        i = (i * 5 + 1 + perturb) & mask;
    }
}

/// Point the first empty or deleted slot on `hash`'s probe path at entry `e`.
#[inline]
fn put_in(idx: []u32, hash: u64, e: u64) {
    let mask = mask_of(idx);
    var i = hash & mask;
    var perturb = hash;
    loop {
        if idx[i] < map.SLOT_BASE { idx[i] = (e as u32) + map.SLOT_BASE; return; }
        perturb = perturb >> 5;
        i = (i * 5 + 1 + perturb) & mask;
    }
}

/// The index slot that holds entry `e` (whose stored hash is `hash`).
fn slot_of(idx: []u32, hash: u64, e: u64) -> u64 {
    let want = (e as u32) + map.SLOT_BASE;
    let mask = mask_of(idx);
    var i = hash & mask;
    var perturb = hash;
    loop {
        if idx[i] == want { return i; }
        perturb = perturb >> 5;
        i = (i * 5 + 1 + perturb) & mask;
    }
}

/// Copy the live entries of `src` to `dst` (in order) and index them in
/// `idx` (all slots empty). Returns how many. The compiler runs the
/// write barrier on `dst`'s object after the call.
fn rebuild_in<K, V>(idx: []u32, dst: []Entry<K, V>, src: []Entry<K, V>) -> u64 {
    var j: u64 = 0;
    for i in 0..src.len {
        let p = &src[i];
        if p.hash != map.DEAD {
            dst[j] = *p;
            put_in(idx, p.hash, j);
            j += 1;
        }
    }
    j
}

pub object Dict<K: hash.Hash, V> {
    /// Live entries.
    len: u64,
    /// Entries in use, dead ones included.
    used: u64,
    mask: u64,
    version: u64,
    index: Gc<DictIndex>,
    ents: Gc<DictEntries<K, V>>,
    /// Entries given back by `pop_last` since the last rebuild: their
    /// index slots stay deleted, so they still count against the room.
    popped: u64,
}

/// A dict with room for `n` entries before it resizes.
pub fn Dict<K, V>.new(h: *gc.Heap, n: u64) -> Gc<Dict<K, V>> {
    let sz = map.index_size_for<K>(n);
    let index = new(h, DictIndex {}, sz);
    let ents: Gc<DictEntries<K, V>> = new(h, DictEntries {}, map.usable_for<K>(sz));
    new(h, Dict { len: 0, used: 0, mask: sz - 1, version: 0, index: index, ents: ents, popped: 0 })
}

/// Resize (and compact) for `n` live entries.
#[cold]
#[inline(never)]
fn Dict<K, V>.resize(d: Gc<Dict<K, V>>, h: *gc.Heap, n: u64) {
    let sz = map.index_size_for<K>(n);
    let index = new(h, DictIndex {}, sz);
    let ents: Gc<DictEntries<K, V>> = new(h, DictEntries {}, map.usable_for<K>(sz));
    // The compiler runs the barrier on `ents` after the copy.
    d.used = rebuild_in(index.s, ents.e, d.ents.e[0..d.used]);
    d.index = index;
    d.ents = ents;
    d.mask = sz - 1;
    d.popped = 0;
    d.version += 1;
}

/// The entry index of the key with hash `hv` that `eq` accepts. `eq` gets
/// a copy of each candidate key whose hash matches, and must not change
/// the dict.
#[inline]
pub fn Dict<K, V>.find_by(d: Gc<Dict<K, V>>, hv: u64, eq: block fn(K) -> bool) -> ?u64 {
    find_in(d.index.s, d.ents.e, map.stored_hash<K>(hv), eq)
}

/// `find_by` for an `eq` that can fail and run guest code, which may
/// change this dict (see `map.OrderedMap.find_with`): after each `eq`
/// call the lookup starts over if `version` changed. An `eq` that changes
/// the dict on every call makes the lookup loop forever, as in CPython.
pub fn Dict<K, V>.find_with<E>(d: Gc<Dict<K, V>>, hv: u64, eq: block fn(K) -> Result<bool, E> uses reenter) -> Result<?u64, E> uses reenter {
    let hash = map.stored_hash<K>(hv);
    loop {
        let ver = d.version;
        var i = hash & d.mask;
        var perturb = hash;
        var restart = false;
        loop {
            let s = d.index.s[i];
            if s == map.SLOT_EMPTY { break; }
            if s >= map.SLOT_BASE {
                let e = (s - map.SLOT_BASE) as u64;
                let p = &d.ents.e[e];
                if p.hash == hash {
                    let k = p.key;
                    let same = eq(k)?;
                    if d.version != ver { restart = true; break; }
                    if same { return Ok(Some(e)); }
                }
            }
            perturb = perturb >> 5;
            i = (i * 5 + 1 + perturb) & d.mask;
        }
        if !restart { return Ok(None); }
    }
}

/// Whether `insert_new` would not resize.
#[inline]
pub fn Dict<K, V>.has_room(d: Gc<Dict<K, V>>) -> bool { d.used + d.popped < d.ents.e.len }

/// Append a new entry for a key the caller knows is absent, if there is
/// room without resizing (`has_room`); its index, else None. Does not
/// allocate.
pub fn Dict<K, V>.try_insert_new(d: Gc<Dict<K, V>>, hv: u64, key: K, value: V) -> ?u64 {
    if d.used + d.popped >= d.ents.e.len { return None; }
    let hs = map.stored_hash<K>(hv);
    let e = d.used;
    d.ents.e[e] = Entry { hash: hs, key: key, value: value };
    put_in(d.index.s, hs, e);
    d.used = e + 1;
    d.len += 1;
    d.version += 1;
    Some(e)
}

/// Append a new entry for a key the caller knows is absent; its index.
pub fn Dict<K, V>.insert_new(d: Gc<Dict<K, V>>, h: *gc.Heap, hv: u64, key: K, value: V) -> u64 {
    if d.used + d.popped >= d.ents.e.len { d.resize(h, d.len * 2 + 1); }
    d.try_insert_new(hv, key, value).unwrap()
}

/// Entry `e` := (hash, key, value), indexed at `slot`.
#[inline(always)]
fn Dict<K, V>.place(d: Gc<Dict<K, V>>, slot: u64, hs: u64, key: K, value: V) -> u64 {
    let e = d.used;
    d.ents.e[e] = Entry { hash: hs, key: key, value: value };
    d.index.s[slot] = (e as u32) + map.SLOT_BASE;
    d.used = e + 1;
    d.len += 1;
    d.version += 1;
    e
}

/// Insert or replace in one probe, with the caller's hash and equality
/// (as `find_by`). Returns the entry index and whether the key was new.
pub fn Dict<K, V>.put_by(d: Gc<Dict<K, V>>, h: *gc.Heap, hv: u64, key: K, value: V, eq: block fn(K) -> bool) -> (u64, bool) {
    let hs = map.stored_hash<K>(hv);
    let (r, found) = lookup_in(d.index.s, d.ents.e, hs, eq);
    if found {
        d.ents.e[r].value = value;
        return (r, false);
    }
    if d.used + d.popped < d.ents.e.len { return (d.place(r, hs, key, value), true); }
    (d.insert_new(h, hv, key, value), true)
}

/// Insert a key that `eq` finds absent, in one probe, if the dict has
/// room without resizing: the new entry's index; None if the key is
/// present or the dict is full (nothing done). Does not allocate.
pub fn Dict<K, V>.try_add_by(d: Gc<Dict<K, V>>, hv: u64, key: K, value: V, eq: block fn(K) -> bool) -> ?u64 {
    if d.used + d.popped >= d.ents.e.len { return None; }
    let hs = map.stored_hash<K>(hv);
    let (r, found) = lookup_in(d.index.s, d.ents.e, hs, eq);
    if found { return None; }
    Some(d.place(r, hs, key, value))
}

/// Key, value and stored hash of entry `e` (a live entry index).
#[inline]
pub fn Dict<K, V>.key(d: Gc<Dict<K, V>>, e: u64) -> K { d.ents.e[e].key }
#[inline]
pub fn Dict<K, V>.value(d: Gc<Dict<K, V>>, e: u64) -> V { d.ents.e[e].value }
#[inline]
pub fn Dict<K, V>.hash_at(d: Gc<Dict<K, V>>, e: u64) -> u64 { d.ents.e[e].hash }
#[inline]
pub fn Dict<K, V>.set_value(d: Gc<Dict<K, V>>, e: u64, value: V) { d.ents.e[e].value = value; }

/// Whether entry index `e` is a live entry.
pub fn Dict<K, V>.is_live(d: Gc<Dict<K, V>>, e: u64) -> bool {
    e < d.used and d.ents.e[e].hash != map.DEAD
}

/// Remove the live entry `e` (panics if it is not one).
pub fn Dict<K, V>.remove_at(d: Gc<Dict<K, V>>, e: u64) {
    if !d.is_live(e) { bad_entry(); }
    let idx = d.index.s;
    let ents = d.ents.e;
    let hs = ents[e].hash;
    idx[slot_of(idx, hs, e)] = map.SLOT_DELETED;
    // Zeroed, the entry keeps nothing alive.
    zero(d.ents.e[e..e + 1]);
    ents[e].hash = map.DEAD;
    d.len -= 1;
    d.version += 1;
}

pub fn Dict<K, V>.get(d: Gc<Dict<K, V>>, key: K) -> ?V {
    let Some(e) = d.find_by(key.hash(), |k| k.eq(key)) else { return None; };
    Some(d.ents.e[e].value)
}

pub fn Dict<K, V>.contains(d: Gc<Dict<K, V>>, key: K) -> bool {
    d.find_by(key.hash(), |k| k.eq(key)).is_some()
}

/// Insert or replace (a replaced key keeps its place). True if the key was new.
pub fn Dict<K, V>.insert(d: Gc<Dict<K, V>>, h: *gc.Heap, key: K, value: V) -> bool {
    d.put_by(h, key.hash(), key, value, |k| k.eq(key)).1
}

/// Remove `key`; its value if it was present.
pub fn Dict<K, V>.remove(d: Gc<Dict<K, V>>, key: K) -> ?V {
    let Some(e) = d.find_by(key.hash(), |k| k.eq(key)) else { return None; };
    let v = d.ents.e[e].value;
    d.remove_at(e);
    Some(v)
}

/// Remove and return the last entry in insertion order.
pub fn Dict<K, V>.pop_last(d: Gc<Dict<K, V>>) -> ?(K, V) {
    // Entries given back stay counted (their index slots are deleted,
    // not empty): without that, popping and inserting in turn would fill
    // the index with deleted slots and a probe would never end.
    let was = d.used;
    while d.used > 0 and d.ents.e[d.used - 1].hash == map.DEAD { d.used -= 1; }
    if d.used == 0 { d.popped += was; return None; }
    let e = d.used - 1;
    let r = (d.ents.e[e].key, d.ents.e[e].value);
    d.remove_at(e);
    d.used = e;
    d.popped += was - e;
    Some(r)
}

/// Iteration in insertion order, by entry index:
/// `var i: u64 = 0; while let Some(e) = d.next(&i) { .. d.key(e), d.value(e) .. }`.
/// Safe across allocation and guest code: a change of `version` tells
/// the caller that the dict changed (Python's "changed size during
/// iteration").
pub fn Dict<K, V>.next(d: Gc<Dict<K, V>>, at: *u64) -> ?u64 {
    while *at < d.used {
        let e = *at;
        *at += 1;
        if d.ents.e[e].hash != map.DEAD { return Some(e); }
    }
    None
}

/// Remove every entry, keeping the tables (cleared, so they keep nothing alive).
pub fn Dict<K, V>.clear(d: Gc<Dict<K, V>>) {
    zero(d.index.s);
    zero(d.ents.e[0..d.used]);
    d.used = 0;
    d.len = 0;
    d.popped = 0;
    d.version += 1;
}

/// A new dict with the live entries of `d`, in order (compacted).
pub fn Dict<K, V>.copy(d: Gc<Dict<K, V>>, h: *gc.Heap) -> Gc<Dict<K, V>> {
    let r: Gc<Dict<K, V>> = Dict.new(h, d.len);
    r.used = rebuild_in(r.index.s, r.ents.e, d.ents.e[0..d.used]);
    r.len = r.used;
    r
}

// ── KeyDict: keys that carry their hash (no stored hash) ─────────────
//
// CPython's "unicode keys" layout: when every key caches its own hash (an
// interned attribute name, a string object with its hash in a field), an
// entry is just (key, value), 16 bytes for `Value` keys instead of 24,
// and resizing, removal and `copy` ask the key for its hash. The index,
// probing, entry indices, `version` and the GC behavior are `Dict`'s.
// A removed entry is zeroed and is told apart by its all-zero key bytes:
// a live key must never be all zero bits (a `Value` string is a tagged
// pointer). Lookups have no stored hash to filter candidates by, so `eq`
// sees every live key on the probe path: test identity first, then the
// candidate's cached hash, then the contents.

/// Keys of a `KeyDict`: `cached_hash` is the hash callers pass to
/// `find_by` & co. for that key, read from the key (it must not fail or
/// run guest code; computing and caching it on first use is fine).
pub trait CachedHash {
    fn cached_hash(k: Self) -> u64;
    fn eq(a: Self, b: Self) -> bool;
}

/// One entry of a `KeyDict`: no hash.
pub struct KeyEntry<K, V> { key: K, value: V }

/// The entries of a `KeyDict`, in insertion order.
pub object KeyEntries<K, V> { e: [KeyEntry<K, V>] }

pub object KeyDict<K: CachedHash, V> {
    /// Live entries.
    len: u64,
    /// Entries in use, dead ones included.
    used: u64,
    mask: u64,
    version: u64,
    index: Gc<DictIndex>,
    ents: Gc<KeyEntries<K, V>>,
    /// As `Dict.popped`.
    popped: u64,
}

/// The stored hash of entry `p`'s key.
#[inline(always)]
fn key_hash<K: CachedHash, V>(p: *KeyEntry<K, V>) -> u64 { map.stored_hash<K>(p.key.cached_hash()) }

/// `find_in` without stored hashes.
#[inline]
fn key_find_in<K, V>(idx: []u32, ents: []KeyEntry<K, V>, hash: u64, eq: block fn(K) -> bool) -> ?u64 {
    let mask = mask_of(idx);
    var i = hash & mask;
    var perturb = hash;
    loop {
        let s = idx[i];
        if s == map.SLOT_EMPTY { return None; }
        if s >= map.SLOT_BASE {
            let e = (s - map.SLOT_BASE) as u64;
            if eq(ents[e].key) { return Some(e); }
        }
        perturb = perturb >> 5;
        i = (i * 5 + 1 + perturb) & mask;
    }
}

/// `lookup_in` without stored hashes: `(e, true)` for the entry `eq`
/// accepts, else `(slot, false)` where the key goes.
#[inline]
fn key_lookup_in<K, V>(idx: []u32, ents: []KeyEntry<K, V>, hash: u64, eq: block fn(K) -> bool) -> (u64, bool) {
    let mask = mask_of(idx);
    var i = hash & mask;
    var perturb = hash;
    var free: u64 = 0xffffffffffffffff;
    loop {
        let s = idx[i];
        if s == map.SLOT_EMPTY { return (if free == 0xffffffffffffffff { i } else { free }, false); }
        if s >= map.SLOT_BASE {
            let e = (s - map.SLOT_BASE) as u64;
            if eq(ents[e].key) { return (e, true); }
        } else if free == 0xffffffffffffffff {
            free = i;
        }
        perturb = perturb >> 5;
        i = (i * 5 + 1 + perturb) & mask;
    }
}

/// `rebuild_in`, with each key's hash from the key.
fn key_rebuild_in<K: CachedHash, V>(idx: []u32, dst: []KeyEntry<K, V>, src: []KeyEntry<K, V>) -> u64 {
    var j: u64 = 0;
    for i in 0..src.len {
        let p = &src[i];
        if key_live<K>(&p.key) {
            dst[j] = *p;
            put_in(idx, key_hash(p), j);
            j += 1;
        }
    }
    j
}

/// A dict with room for `n` entries before it resizes.
pub fn KeyDict<K, V>.new(h: *gc.Heap, n: u64) -> Gc<KeyDict<K, V>> {
    let sz = map.index_size_for<K>(n);
    let index = new(h, DictIndex {}, sz);
    let ents: Gc<KeyEntries<K, V>> = new(h, KeyEntries {}, map.usable_for<K>(sz));
    new(h, KeyDict { len: 0, used: 0, mask: sz - 1, version: 0, index: index, ents: ents, popped: 0 })
}

/// Resize (and compact) for `n` live entries.
#[cold]
#[inline(never)]
fn KeyDict<K, V>.resize(d: Gc<KeyDict<K, V>>, h: *gc.Heap, n: u64) {
    let sz = map.index_size_for<K>(n);
    let index = new(h, DictIndex {}, sz);
    let ents: Gc<KeyEntries<K, V>> = new(h, KeyEntries {}, map.usable_for<K>(sz));
    // The compiler runs the barrier on `ents` after the copy.
    d.used = key_rebuild_in(index.s, ents.e, d.ents.e[0..d.used]);
    d.index = index;
    d.ents = ents;
    d.mask = sz - 1;
    d.popped = 0;
    d.version += 1;
}

/// The entry index of the key with hash `hv` that `eq` accepts. `eq` gets
/// a copy of each live key on the probe path (no hash filter), and must
/// not change the dict.
#[inline]
pub fn KeyDict<K, V>.find_by(d: Gc<KeyDict<K, V>>, hv: u64, eq: block fn(K) -> bool) -> ?u64 {
    key_find_in(d.index.s, d.ents.e, map.stored_hash<K>(hv), eq)
}

/// `Dict.find_with`: an `eq` that can fail and run guest code; after each
/// `eq` call the lookup starts over if `version` changed.
pub fn KeyDict<K, V>.find_with<E>(d: Gc<KeyDict<K, V>>, hv: u64, eq: block fn(K) -> Result<bool, E> uses reenter) -> Result<?u64, E> uses reenter {
    let hash = map.stored_hash<K>(hv);
    loop {
        let ver = d.version;
        var i = hash & d.mask;
        var perturb = hash;
        var restart = false;
        loop {
            let s = d.index.s[i];
            if s == map.SLOT_EMPTY { break; }
            if s >= map.SLOT_BASE {
                let e = (s - map.SLOT_BASE) as u64;
                let k = d.ents.e[e].key;
                let same = eq(k)?;
                if d.version != ver { restart = true; break; }
                if same { return Ok(Some(e)); }
            }
            perturb = perturb >> 5;
            i = (i * 5 + 1 + perturb) & d.mask;
        }
        if !restart { return Ok(None); }
    }
}

/// Whether `insert_new` would not resize.
#[inline]
pub fn KeyDict<K, V>.has_room(d: Gc<KeyDict<K, V>>) -> bool { d.used + d.popped < d.ents.e.len }

/// Append a new entry for a key the caller knows is absent, if there is
/// room without resizing; its index, else None. Does not allocate.
pub fn KeyDict<K, V>.try_insert_new(d: Gc<KeyDict<K, V>>, hv: u64, key: K, value: V) -> ?u64 {
    if d.used + d.popped >= d.ents.e.len { return None; }
    let e = d.used;
    d.ents.e[e] = KeyEntry { key: key, value: value };
    put_in(d.index.s, map.stored_hash<K>(hv), e);
    d.used = e + 1;
    d.len += 1;
    d.version += 1;
    Some(e)
}

/// Append a new entry for a key the caller knows is absent; its index.
pub fn KeyDict<K, V>.insert_new(d: Gc<KeyDict<K, V>>, h: *gc.Heap, hv: u64, key: K, value: V) -> u64 {
    if d.used + d.popped >= d.ents.e.len { d.resize(h, d.len * 2 + 1); }
    d.try_insert_new(hv, key, value).unwrap()
}

/// Entry `e` := (key, value), indexed at `slot`.
#[inline(always)]
fn KeyDict<K, V>.place(d: Gc<KeyDict<K, V>>, slot: u64, key: K, value: V) -> u64 {
    let e = d.used;
    d.ents.e[e] = KeyEntry { key: key, value: value };
    d.index.s[slot] = (e as u32) + map.SLOT_BASE;
    d.used = e + 1;
    d.len += 1;
    d.version += 1;
    e
}

/// Insert or replace in one probe (as `Dict.put_by`). Returns the entry
/// index and whether the key was new.
pub fn KeyDict<K, V>.put_by(d: Gc<KeyDict<K, V>>, h: *gc.Heap, hv: u64, key: K, value: V, eq: block fn(K) -> bool) -> (u64, bool) {
    let (r, found) = key_lookup_in(d.index.s, d.ents.e, map.stored_hash<K>(hv), eq);
    if found {
        d.ents.e[r].value = value;
        return (r, false);
    }
    if d.used + d.popped < d.ents.e.len { return (d.place(r, key, value), true); }
    (d.insert_new(h, hv, key, value), true)
}

/// Insert a key that `eq` finds absent, in one probe, if the dict has
/// room without resizing (as `Dict.try_add_by`). Does not allocate.
pub fn KeyDict<K, V>.try_add_by(d: Gc<KeyDict<K, V>>, hv: u64, key: K, value: V, eq: block fn(K) -> bool) -> ?u64 {
    if d.used + d.popped >= d.ents.e.len { return None; }
    let (r, found) = key_lookup_in(d.index.s, d.ents.e, map.stored_hash<K>(hv), eq);
    if found { return None; }
    Some(d.place(r, key, value))
}

/// Key, value and (stored) hash of entry `e` (a live entry index).
#[inline]
pub fn KeyDict<K, V>.key(d: Gc<KeyDict<K, V>>, e: u64) -> K { d.ents.e[e].key }
#[inline]
pub fn KeyDict<K, V>.value(d: Gc<KeyDict<K, V>>, e: u64) -> V { d.ents.e[e].value }
#[inline]
pub fn KeyDict<K, V>.hash_at(d: Gc<KeyDict<K, V>>, e: u64) -> u64 { key_hash(&d.ents.e[e]) }
#[inline]
pub fn KeyDict<K, V>.set_value(d: Gc<KeyDict<K, V>>, e: u64, value: V) { d.ents.e[e].value = value; }

/// Whether entry index `e` is a live entry.
pub fn KeyDict<K, V>.is_live(d: Gc<KeyDict<K, V>>, e: u64) -> bool {
    e < d.used and key_live<K>(&d.ents.e[e].key)
}

/// Remove the live entry `e` (panics if it is not one).
pub fn KeyDict<K, V>.remove_at(d: Gc<KeyDict<K, V>>, e: u64) {
    if !d.is_live(e) { bad_entry(); }
    let idx = d.index.s;
    let ents = d.ents.e;
    idx[slot_of(idx, key_hash(&ents[e]), e)] = map.SLOT_DELETED;
    // Zeroed (all-zero key bytes: dead), the entry keeps nothing alive.
    zero(d.ents.e[e..e + 1]);
    d.len -= 1;
    d.version += 1;
}

pub fn KeyDict<K, V>.get(d: Gc<KeyDict<K, V>>, key: K) -> ?V {
    let Some(e) = d.find_by(key.cached_hash(), |k| k.eq(key)) else { return None; };
    Some(d.ents.e[e].value)
}

pub fn KeyDict<K, V>.contains(d: Gc<KeyDict<K, V>>, key: K) -> bool {
    d.find_by(key.cached_hash(), |k| k.eq(key)).is_some()
}

/// Insert or replace (a replaced key keeps its place). True if the key was new.
pub fn KeyDict<K, V>.insert(d: Gc<KeyDict<K, V>>, h: *gc.Heap, key: K, value: V) -> bool {
    d.put_by(h, key.cached_hash(), key, value, |k| k.eq(key)).1
}

/// Remove `key`; its value if it was present.
pub fn KeyDict<K, V>.remove(d: Gc<KeyDict<K, V>>, key: K) -> ?V {
    let Some(e) = d.find_by(key.cached_hash(), |k| k.eq(key)) else { return None; };
    let v = d.ents.e[e].value;
    d.remove_at(e);
    Some(v)
}

/// Remove and return the last entry in insertion order.
pub fn KeyDict<K, V>.pop_last(d: Gc<KeyDict<K, V>>) -> ?(K, V) {
    // Entries given back stay counted (their index slots are deleted,
    // not empty): without that, popping and inserting in turn would fill
    // the index with deleted slots and a probe would never end.
    let was = d.used;
    while d.used > 0 and !key_live<K>(&d.ents.e[d.used - 1].key) { d.used -= 1; }
    if d.used == 0 { d.popped += was; return None; }
    let e = d.used - 1;
    let r = (d.ents.e[e].key, d.ents.e[e].value);
    d.remove_at(e);
    d.used = e;
    d.popped += was - e;
    Some(r)
}

/// Iteration in insertion order, by entry index (as `Dict.next`).
pub fn KeyDict<K, V>.next(d: Gc<KeyDict<K, V>>, at: *u64) -> ?u64 {
    while *at < d.used {
        let e = *at;
        *at += 1;
        if key_live<K>(&d.ents.e[e].key) { return Some(e); }
    }
    None
}

/// Remove every entry, keeping the tables (cleared, so they keep nothing alive).
pub fn KeyDict<K, V>.clear(d: Gc<KeyDict<K, V>>) {
    zero(d.index.s);
    zero(d.ents.e[0..d.used]);
    d.used = 0;
    d.len = 0;
    d.popped = 0;
    d.version += 1;
}

/// A new dict with the live entries of `d`, in order (compacted).
pub fn KeyDict<K, V>.copy(d: Gc<KeyDict<K, V>>, h: *gc.Heap) -> Gc<KeyDict<K, V>> {
    let r: Gc<KeyDict<K, V>> = KeyDict.new(h, d.len);
    r.used = key_rebuild_in(r.index.s, r.ents.e, d.ents.e[0..d.used]);
    r.len = r.used;
    r
}
