// An insertion-ordered hash table in the GC heap: guest dicts.
//
// The same layout and probing as `std.map.OrderedMap` (CPython's compact
// dict: an index table of u32 slots over a dense array of entries in
// insertion order, each entry keeping its hash), with the index and the
// entries in GC objects, so keys and values may be traced (`Value`,
// `Gc<T>`). A `Dict` is itself a GC object: a guest dict can be one, or
// hold one. Removed entries are zeroed, so they keep nothing alive.
//
// Lookups come in three forms:
//   - `get`/`insert`/`remove`/`contains`, through `hash.Hash` on K;
//   - `find_by(hash, eq)`, for a hash and an equality of the caller's
//     that cannot fail or run guest code (a string's cached hash, a
//     pointer compare first);
//   - `find_with(hash, eq)`, for an equality that can fail and run guest
//     code (`__eq__`), which may change the dict: the lookup starts over
//     when `version` changed during an `eq` call (CPython's rule).
// Entry indices (from `find_by`, `next`, `insert_new`) are stable until
// the dict is compacted; `version` changes on every insertion of a new
// key, removal, compaction and `clear` (not on value updates), so an
// inline cache can hold an entry index and check the key at it, or hold
// the version.

import std.gc;
import std.mem;
import std.hash;
import std.map;
import std.map.{Entry};

/// The index table: u32 slots, `map.SLOT_EMPTY`, `map.SLOT_DELETED`, or
/// entry + `map.SLOT_BASE`.
pub object DictIndex { s: [u32] }

/// The entries, in insertion order (`used` of them in use).
pub object DictEntries<K, V> { e: [Entry<K, V>] }

pub object Dict<K: hash.Hash, V> {
    /// Live entries.
    len: u64,
    /// Entries in use, dead ones included.
    used: u64,
    mask: u64,
    version: u64,
    index: Gc<DictIndex>,
    ents: Gc<DictEntries<K, V>>,
}

/// A dict with room for `n` entries before it resizes.
pub fn Dict<K, V>.new(h: *gc.Heap, n: u64) -> Gc<Dict<K, V>> uses gc {
    let sz = map.index_size_for<K>(n);
    let index = new(h, DictIndex {}, sz);
    let ents: Gc<DictEntries<K, V>> = new(h, DictEntries {}, map.usable_for<K>(sz));
    new(h, Dict { len: 0, used: 0, mask: sz - 1, version: 0, index: index, ents: ents })
}

/// Resize (and compact) for `n` live entries.
#[cold]
#[inline(never)]
fn Dict<K, V>.resize(d: Gc<Dict<K, V>>, h: *gc.Heap, n: u64) uses gc {
    let sz = map.index_size_for<K>(n);
    let index = new(h, DictIndex {}, sz);
    let ents: Gc<DictEntries<K, V>> = new(h, DictEntries {}, map.usable_for<K>(sz));
    // No allocation from here on: the raw copies below go into objects
    // that are young unless a generational heap promoted them, hence the
    // barrier after.
    d.used = map.probe_rebuild(index.s.ptr, sz - 1, ents.e.ptr, d.ents.e.ptr, d.used);
    gc.write_barrier(h, ents as *u8);
    d.index = index;
    d.ents = ents;
    d.mask = sz - 1;
    d.version += 1;
}

/// The entry index of the key with hash `hv` that `eq` accepts. `eq` gets
/// a copy of each candidate key whose hash matches, and must not change
/// the dict.
#[inline]
pub fn Dict<K, V>.find_by(d: Gc<Dict<K, V>>, hv: u64, eq: block fn(K) -> bool) -> ?u64 {
    map.probe_find(d.index.s.ptr, d.mask, d.ents.e.ptr, map.stored_hash<K>(hv), eq)
}

/// `find_by` for an `eq` that can fail and run guest code, which may
/// change this dict (see `map.OrderedMap.find_with`): after each `eq`
/// call the lookup starts over if `version` changed. An `eq` that changes
/// the dict on every call makes the lookup loop forever, as in CPython.
pub fn Dict<K, V>.find_with<E>(d: Gc<Dict<K, V>>, hv: u64, eq: block fn(K) -> Result<bool, E> uses reenter) -> Result<?u64, E> uses reenter {
    map.probe_find_with<K, V, E>(map.stored_hash<K>(hv), || (d.index.s.ptr, d.mask, d.ents.e.ptr, d.version), eq)
}

/// Whether `insert_new` would not resize.
#[inline]
pub fn Dict<K, V>.has_room(d: Gc<Dict<K, V>>) -> bool { d.used < d.ents.e.len }

/// Append a new entry for a key the caller knows is absent, if there is
/// room without resizing (`has_room`); its index, else None. Does not
/// allocate.
pub fn Dict<K, V>.try_insert_new(d: Gc<Dict<K, V>>, hv: u64, key: K, value: V) -> ?u64 {
    if d.used >= d.ents.e.len { return None; }
    let hs = map.stored_hash<K>(hv);
    let e = d.used;
    d.ents.e[e] = Entry { hash: hs, key: key, value: value };
    map.probe_put<K>(d.index.s.ptr, d.mask, hs, e);
    d.used = e + 1;
    d.len += 1;
    d.version += 1;
    Some(e)
}

/// Append a new entry for a key the caller knows is absent; its index.
pub fn Dict<K, V>.insert_new(d: Gc<Dict<K, V>>, h: *gc.Heap, hv: u64, key: K, value: V) -> u64 uses gc {
    if d.used >= d.ents.e.len { d.resize(h, d.len * 2 + 1); }
    d.try_insert_new(hv, key, value).unwrap()
}

/// Key, value and stored hash of entry `e` (a live entry index).
#[inline]
pub fn Dict<K, V>.key(d: Gc<Dict<K, V>>, e: u64) -> K { d.ents.e[e].key }
#[inline]
pub fn Dict<K, V>.value(d: Gc<Dict<K, V>>, e: u64) -> V { d.ents.e[e].value }
#[inline]
pub fn Dict<K, V>.hash_at(d: Gc<Dict<K, V>>, e: u64) -> u64 { d.ents.e[e].hash }
#[inline]
pub fn Dict<K, V>.set_value(d: Gc<Dict<K, V>>, e: u64, value: V) { d.ents.e[e].value = value; }

/// Whether entry index `e` is a live entry.
pub fn Dict<K, V>.is_live(d: Gc<Dict<K, V>>, e: u64) -> bool {
    e < d.used and d.ents.e[e].hash != map.DEAD
}

/// Remove the live entry `e`.
pub fn Dict<K, V>.remove_at(d: Gc<Dict<K, V>>, e: u64) {
    if e >= d.used { d.ents.e[e]; }
    map.probe_kill(d.index.s.ptr, d.mask, d.ents.e.ptr, e);
    d.len -= 1;
    d.version += 1;
}

pub fn Dict<K, V>.get(d: Gc<Dict<K, V>>, key: K) -> ?V {
    let Some(e) = d.find_by(key.hash(), |k| k.eq(key)) else { return None; };
    Some(d.ents.e[e].value)
}

pub fn Dict<K, V>.contains(d: Gc<Dict<K, V>>, key: K) -> bool {
    d.find_by(key.hash(), |k| k.eq(key)).is_some()
}

/// Insert or replace (a replaced key keeps its place). True if the key was new.
pub fn Dict<K, V>.insert(d: Gc<Dict<K, V>>, h: *gc.Heap, key: K, value: V) -> bool uses gc {
    let hv = key.hash();
    if let Some(e) = d.find_by(hv, |k| k.eq(key)) {
        d.ents.e[e].value = value;
        return false;
    }
    d.insert_new(h, hv, key, value);
    true
}

/// Remove `key`; its value if it was present.
pub fn Dict<K, V>.remove(d: Gc<Dict<K, V>>, key: K) -> ?V {
    let Some(e) = d.find_by(key.hash(), |k| k.eq(key)) else { return None; };
    let v = d.ents.e[e].value;
    d.remove_at(e);
    Some(v)
}

/// Remove and return the last entry in insertion order.
pub fn Dict<K, V>.pop_last(d: Gc<Dict<K, V>>) -> ?(K, V) {
    while d.used > 0 and d.ents.e[d.used - 1].hash == map.DEAD { d.used -= 1; }
    if d.used == 0 { return None; }
    let e = d.used - 1;
    let r = (d.ents.e[e].key, d.ents.e[e].value);
    d.remove_at(e);
    d.used = e;
    Some(r)
}

/// Iteration in insertion order, by entry index:
/// `var i: u64 = 0; while let Some(e) = d.next(&i) { .. d.key(e), d.value(e) .. }`.
/// Safe across allocation and guest code: a change of `version` tells
/// the caller that the dict changed (Python's "changed size during
/// iteration").
pub fn Dict<K, V>.next(d: Gc<Dict<K, V>>, at: *u64) -> ?u64 {
    while *at < d.used {
        let e = *at;
        *at += 1;
        if d.ents.e[e].hash != map.DEAD { return Some(e); }
    }
    None
}

/// Remove every entry, keeping the tables (cleared, so they keep nothing alive).
pub fn Dict<K, V>.clear(d: Gc<Dict<K, V>>) {
    mem.memset(d.index.s.ptr as *u8, 0, d.index.s.len * 4);
    mem.memset(d.ents.e.ptr as *u8, 0, d.used * size_of<Entry<K, V>>());
    d.used = 0;
    d.len = 0;
    d.version += 1;
}

/// A new dict with the live entries of `d`, in order (compacted).
pub fn Dict<K, V>.copy(d: Gc<Dict<K, V>>, h: *gc.Heap) -> Gc<Dict<K, V>> uses gc {
    let r: Gc<Dict<K, V>> = Dict.new(h, d.len);
    r.used = map.probe_rebuild(r.index.s.ptr, r.mask, r.ents.e.ptr, d.ents.e.ptr, d.used);
    r.len = r.used;
    gc.write_barrier(h, r.ents as *u8);
    r
}
