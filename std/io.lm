// Minimal I/O on top of libc.

extern "C" fn write(fd: i32, buf: *u8, n: u64) -> i64;
extern "C" fn snprintf(buf: *u8, n: u64, fmt: *u8, ...) -> i32;

pub fn print(s: str) {
    write(1, s.ptr, s.len);
}

pub fn println(s: str) {
    write(1, s.ptr, s.len);
    write(1, "\n".ptr, 1);
}

pub fn eprint(s: str) {
    write(2, s.ptr, s.len);
}

pub fn eprintln(s: str) {
    write(2, s.ptr, s.len);
    write(2, "\n".ptr, 1);
}

pub fn print_int(x: i64) { write_int(1, x); }
pub fn print_f64(x: f64) { write_f64(1, x); }

/// `print_int` and `print_f64` on stderr.
pub fn eprint_int(x: i64) { write_int(2, x); }
pub fn eprint_f64(x: f64) { write_f64(2, x); }

fn write_int(fd: i32, x: i64) {
    var buf: [u8; 24];
    var i: u64 = 24;
    var u: u64 = if x < 0 { 0 -% (x as u64) } else { x as u64 };
    loop {
        i -= 1;
        buf[i] = '0' + (u % 10) as u8;
        u /= 10;
        if u == 0 { break; }
    }
    if x < 0 {
        i -= 1;
        buf[i] = '-';
    }
    write(fd, &buf[i], 24 - i);
}

fn write_f64(fd: i32, x: f64) {
    var buf: [u8; 64];
    let n = snprintf(&buf[0], 64, "%.14g\0".ptr, x);
    write(fd, &buf[0], n as u64);
}

pub fn print_bool(b: bool) {
    print(if b { "true" } else { "false" });
}

extern "C" fn fopen(path: *u8, mode: *u8) -> *u8;
extern "C" fn fclose(f: *u8) -> i32;
extern "C" fn fread(buf: *u8, size: u64, n: u64, f: *u8) -> u64;
extern "C" fn fseek(f: *u8, off: i64, whence: i32) -> i32;
extern "C" fn ftell(f: *u8) -> i64;
extern "C" fn malloc(n: u64) -> *u8;
extern "C" fn free(p: *u8);
extern "C" fn memcpy(dst: *u8, src: *u8, n: u64) -> *u8;

/// Read a whole file. The returned string is heap-allocated: release it
/// with `free_file`.
pub fn read_file(path: str) -> ?str {
    let cpath = malloc(path.len + 1);
    memcpy(cpath, path.ptr, path.len);
    cpath[path.len] = 0;
    let f = fopen(cpath, "rb\0".ptr);
    free(cpath);
    if (f as u64) == 0 { return None; }
    fseek(f, 0, 2);
    let n = ftell(f);
    fseek(f, 0, 0);
    if n < 0 { fclose(f); return None; }
    let buf = malloc(n as u64 + 1);
    let got = fread(buf, 1, n as u64, f);
    fclose(f);
    Some(buf.slice(got))
}

/// Release a string returned by `read_file`.
pub fn free_file(s: str) { free(s.ptr); }

// ── Out: buffered output ────────────────────────────────────────────────

/// A buffered writer on a file descriptor: `print` copies into the
/// buffer and writes it out (one `write(2)`) when it is full; `flush`
/// writes what is buffered. Nothing is written at exit by itself:
/// `flush` (or `free`) before the program ends, and before writing to the
/// same terminal another way (`io.eprint` for an error message, or
/// `io.print`), or the output comes out of order.
pub struct Out { fd: i32, buf: *u8, len: u64, cap: u64 }

/// A writer on stdout with a 64 KiB buffer.
pub fn Out.stdout() -> Out { Out.new(1, 65536) }

/// A writer on `fd` with a buffer of `cap` bytes (at least 1).
pub fn Out.new(fd: i32, cap: u64) -> Out {
    let c = if cap == 0 { 1 } else { cap };
    Out { fd: fd, buf: malloc(c), len: 0, cap: c }
}

fn write_all(fd: i32, p: *u8, n: u64) {
    var off: u64 = 0;
    while off < n {
        let w = write(fd, p + off, n - off);
        if w <= 0 { return; }
        off += w as u64;
    }
}

/// Write out what is buffered.
pub fn Out.flush(o: *Out) {
    if o.len > 0 { write_all(o.fd, o.buf, o.len); o.len = 0; }
}

/// Buffer `s`; a string that does not fit in an empty buffer is
/// written directly.
pub fn Out.print(o: *Out, s: str) {
    if o.len + s.len > o.cap {
        o.flush();
        if s.len >= o.cap { write_all(o.fd, s.ptr, s.len); return; }
    }
    memcpy(o.buf + o.len, s.ptr, s.len);
    o.len += s.len;
}

pub fn Out.println(o: *Out, s: str) { o.print(s); o.byte('\n'); }

/// Buffer one byte.
pub fn Out.byte(o: *Out, c: u8) {
    if o.len == o.cap { o.flush(); }
    o.buf[o.len] = c;
    o.len += 1;
}

pub fn Out.print_int(o: *Out, x: i64) {
    var buf: [u8; 24];
    var i: u64 = 24;
    var u: u64 = if x < 0 { 0 -% (x as u64) } else { x as u64 };
    loop {
        i -= 1;
        buf[i] = '0' + (u % 10) as u8;
        u /= 10;
        if u == 0 { break; }
    }
    if x < 0 { i -= 1; buf[i] = '-'; }
    o.print((&buf[i]).slice(24 - i));
}

/// `%.14g`, as `io.print_f64`.
pub fn Out.print_f64(o: *Out, x: f64) {
    var buf: [u8; 64];
    let n = snprintf(&buf[0], 64, "%.14g\0".ptr, x);
    o.print((&buf[0]).slice(n as u64));
}

pub fn Out.print_bool(o: *Out, b: bool) { o.print(if b { "true" } else { "false" }); }

/// The number of bytes buffered.
pub fn Out.buffered(o: *Out) -> u64 { o.len }

/// Flush and release the buffer.
pub fn Out.free(o: *Out) {
    o.flush();
    free(o.buf);
    o.buf = 0 as *u8;
    o.cap = 0;
    o.len = 0;
}
