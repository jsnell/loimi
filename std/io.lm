// Minimal I/O on top of libc.

extern "C" fn write(fd: i32, buf: *u8, n: u64) -> i64;
extern "C" fn snprintf(buf: *u8, n: u64, fmt: *u8, ...) -> i32;

pub fn print(s: str) {
    write(1, s.ptr, s.len);
}

pub fn println(s: str) {
    write(1, s.ptr, s.len);
    write(1, "\n".ptr, 1);
}

pub fn eprint(s: str) {
    write(2, s.ptr, s.len);
}

pub fn eprintln(s: str) {
    write(2, s.ptr, s.len);
    write(2, "\n".ptr, 1);
}

pub fn print_int(x: i64) {
    var buf: [u8; 24];
    var i: u64 = 24;
    var u: u64 = if x < 0 { 0 -% (x as u64) } else { x as u64 };
    loop {
        i -= 1;
        buf[i] = '0' + (u % 10) as u8;
        u /= 10;
        if u == 0 { break; }
    }
    if x < 0 {
        i -= 1;
        buf[i] = '-';
    }
    print(buf[i..24]);
}

pub fn print_f64(x: f64) {
    var buf: [u8; 64];
    let n = snprintf(&buf[0], 64, "%.14g\0".ptr, x);
    print(buf[0..n as u64]);
}

pub fn print_bool(b: bool) {
    print(if b { "true" } else { "false" });
}

extern "C" fn fopen(path: *u8, mode: *u8) -> *u8;
extern "C" fn fclose(f: *u8) -> i32;
extern "C" fn fread(buf: *u8, size: u64, n: u64, f: *u8) -> u64;
extern "C" fn fseek(f: *u8, off: i64, whence: i32) -> i32;
extern "C" fn ftell(f: *u8) -> i64;
extern "C" fn malloc(n: u64) -> *u8;
extern "C" fn free(p: *u8);
extern "C" fn memcpy(dst: *u8, src: *u8, n: u64) -> *u8;

/// Read a whole file. The returned string is heap-allocated.
pub fn read_file(path: str) -> ?str {
    let cpath = malloc(path.len + 1);
    memcpy(cpath, path.ptr, path.len);
    cpath[path.len] = 0;
    let f = fopen(cpath, "rb\0".ptr);
    free(cpath);
    if (f as u64) == 0 { return None; }
    fseek(f, 0, 2);
    let n = ftell(f);
    fseek(f, 0, 0);
    if n < 0 { fclose(f); return None; }
    let buf = malloc(n as u64 + 1);
    let got = fread(buf, 1, n as u64, f);
    fclose(f);
    Some(buf.slice(got))
}
