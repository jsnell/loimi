// Runtime control for libraries: recovering from errors without exiting.
//
// A standalone interpreter can report a syntax error and exit; one that
// is embedded in a host program must return to the host instead, even
// from deep inside a recursive-descent parser that has no error path.
// `protect` and `throw` are that escape hatch (setjmp/longjmp underneath):
//
//     fn parse_job(data: *u8) { ... throw() ... }
//     if !rt.protect(parse_job, &job as *u8) { /* it threw */ }
//
// `throw` returns straight to the innermost `protect` on this thread.
// The frames in between are abandoned: their `defer`s do not run and what
// they allocated with `mem.alloc` leaks, so throw from code whose state
// can be dropped (a parser's tables, for example). The protected function
// has type `fn(*u8)` without effects, so it cannot collect, and no GC
// roots are lost when its frames are skipped.
//
// Panics (a failed bounds check, `unwrap` of None, an overflow check,
// `trap()` in a library, `rt.panic`, `mem.alloc` out of memory) normally
// print a message and abort. `catch_panic` and the `#[catch_panic(v)]`
// attribute on an `export "C"` function catch them instead, so that a
// library returns an error to its host (docs/language.md §10.1 says what
// state is left behind).

import std.mem;

extern "C" fn loimi_protect(f: fn(*u8), data: *u8) -> i32;
extern "C" fn loimi_throw();
extern "C" fn loimi_catch_panic(f: fn(*u8), data: *u8) -> i32;
extern "C" fn loimi_panic(msg: *u8, len: u64);
extern "C" fn loimi_panic_msg_ptr() -> *u8;
extern "C" fn loimi_panic_msg_len() -> u64;

/// Run `f(data)`. True if it returned, false if it (or anything it
/// called) called `throw`.
pub fn protect(f: fn(*u8), data: *u8) -> bool {
    loimi_protect(f, data) != 0
}

/// Unwind to the innermost `protect` on this thread. Panics if there is
/// none.
pub fn throw() -> never {
    loimi_throw();
    unreachable
}

/// Run `f(data)`. True if it returned, false if it panicked: the panic
/// unwound to here instead of aborting (see `panic_message`). `throw`
/// passes through to an enclosing `protect`.
pub fn catch_panic(f: fn(*u8), data: *u8) -> bool {
    loimi_catch_panic(f, data) != 0
}

/// Panic with `msg`: unwind to the innermost `catch_panic` or
/// `#[catch_panic]` export on this thread, or print `msg` and abort.
/// The catch keeps a copy of `msg` (its first 512 bytes), so it may be
/// built in a buffer that the unwinding abandons.
pub fn panic(msg: str) -> never {
    loimi_panic(msg.ptr, msg.len);
    unreachable
}

/// The message of the last panic caught on this thread, without the
/// trailing newline ("lib.lm:12:5: index out of bounds"); empty if none
/// was. Valid until the next `rt.panic` caught on this thread (the
/// panics the compiler generates have static messages).
pub fn panic_message() -> str {
    let p = loimi_panic_msg_ptr();
    var n = loimi_panic_msg_len();
    if n == 0 { return ""; }
    if p[n - 1] == 10 { n -= 1; }
    p.slice(n)
}

// ── Value stacks ─────────────────────────────────────────────────────

/// A vm's value stack (its register windows) with a high-water mark, so
/// that calls need not clear their registers for the collector.
///
/// - Every slot below `hw` holds a value the root scanner may read: a
///   live register, or a stale one from a finished call whose object no
///   collection has freed.
/// - Slots from `hw` up to `fresh` hold values that refer to no freed
///   object: cleared ones, or ones written above the mark since the last
///   collection.
/// - Slots from `fresh` up have never been written.
///
/// A call whose window ends above the mark takes the slow path
/// (`raise`): it clears the never-written slots its window needs (and
/// `SLACK` more) and raises the mark to `fresh`. The root scanner, having
/// marked every live window, clears the stale slots above them and
/// lowers the mark (`lower`). So a call checks one compare, against the
/// mark, in place of the compare against the end, and clears nothing;
/// after a collection, the first deeper call moves the mark back up
/// without clearing.
///
/// It needs the interpreter to write every register before it reads
/// it, and the scanner to find every live window. It does not move (no
/// `grow`): allocate what the guest may use; `mem.alloc` zeroes, so
/// untouched pages cost nothing.
pub struct ValueStack<T> {
    base: *T,
    end: *T,
    hw: *T,
    fresh: *T,
    fill: T,
}

/// Never-written slots cleared past a window that raises the mark.
pub const SLACK: u64 = 256;

/// A stack of `n` slots; `fill` is what cleared slots hold (a value the
/// collector ignores, such as nil).
pub fn ValueStack<T>.new(n: u64, fill: T) -> ValueStack<T> {
    let p = mem.alloc<T>(n);
    ValueStack { base: p, end: p + n, hw: p, fresh: p, fill: fill }
}

pub fn ValueStack<T>.free(s: *ValueStack<T>) {
    mem.release(s.base);
}

/// Whether the slots below `top` are readable already: one compare
/// against the mark. A handler's hot path checks this and calls `raise`
/// from a `cold` block that ends in `redo`, so that the handler needs no
/// stack frame for the call:
///
///     if !ctx.stack.fits(top) { cold { if !ctx.stack.raise(top) { raise overflow } redo } }
#[inline]
pub fn ValueStack<T>.fits(s: *ValueStack<T>, top: *T) -> bool { top <= s.hw }

/// Make the slots below `top` readable: `fits`, else `raise`. For slow
/// paths (a call to `raise` makes the caller keep a stack frame).
#[inline]
pub fn ValueStack<T>.ensure(s: *ValueStack<T>, top: *T) -> bool {
    if top <= s.hw { return true; }
    s.raise(top)
}

/// The slow path of `ensure`: false if `top` is past the end; else clear
/// the never-written slots below `top` (and up to `SLACK` more) and
/// raise the mark to the last cleared slot.
#[cold]
pub fn ValueStack<T>.raise(s: *ValueStack<T>, top: *T) -> bool {
    if top > s.end { return false; }
    if top > s.fresh {
        let room = (s.end as u64 - top as u64) / size_of<T>();
        let to = top + (if room < SLACK { room } else { SLACK }) as i64;
        var p = s.fresh;
        while p < to { *p = s.fill; p = p + 1; }
        s.fresh = to;
    }
    s.hw = s.fresh;
    true
}

/// For the root scanner, after it marked every live window: `top` is
/// the end of the live windows. Clear the slots from there to the mark
/// (this collection may free what they hold) and lower the mark.
pub fn ValueStack<T>.lower(s: *ValueStack<T>, top: *T) {
    var p = top;
    while p < s.hw { *p = s.fill; p = p + 1; }
    if top < s.hw { s.hw = top; }
}
