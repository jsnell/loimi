+/* wasm32-wasi: milliseconds from clock_gettime(CLOCK_MONOTONIC), which
+   wasi-libc implements with the WASI clock_time_get import (clock() would
+   need the emulated process clocks library). */
+#include <time.h>
+static clock_t
+wasi_now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (clock_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+#define NSECS_PER_SEC              1000
